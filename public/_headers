# Cloudflare Pages のヘッダ設定（このファイルは配信されず、設定として読まれる）
# 構文: https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin

# Astro がハッシュ付きファイル名で出力する資産。内容が変われば名前も変わるので
# 永続キャッシュしてよい。
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Pagefind の検索インデックス。記事を足すとファイル名が変わるので長めに持たせる。
/pagefind/*
  Cache-Control: public, max-age=604800

/images/*
  Cache-Control: public, max-age=604800

/favicon.svg
  Cache-Control: public, max-age=604800

# HTML には Cache-Control を書いていない。Cloudflare Pages は既定で
# must-revalidate を付けるため、記事を更新すれば次のアクセスで反映される。
# （このサイトは末尾スラッシュ運用なので `/*.html` のような指定は当たらない）
