{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "atlasez-reports-local",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-04",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "REPORTS",
      "database_name": "atlasez-reports-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "preview_database_id": "atlasez-reports-local",
    },
  ],
}
