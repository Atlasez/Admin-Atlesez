{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "articleId": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "locale": {
      "type": "string",
      "enum": [
        "ja",
        "en"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "subject": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "category": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "concepts": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+\\.[a-z0-9-]+\\.[a-z0-9-]+$"
          },
          "anchor": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ]
      }
    },
    "prerequisites": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+\\.[a-z0-9-]+\\.[a-z0-9-]+$"
      }
    },
    "related": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+\\.[a-z0-9-]+\\.[a-z0-9-]+$"
      }
    },
    "authors": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reviewers": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "in-review",
        "published"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "introductory",
        "basic",
        "intermediate",
        "advanced"
      ]
    },
    "estimatedMinutes": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "tags": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "aliases": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exerciseIds": {
      "default": {
        "pre": [],
        "post": []
      },
      "type": "object",
      "properties": {
        "pre": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "post": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "references": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "title"
        ]
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "articleId",
    "locale",
    "title",
    "slug",
    "subject",
    "category",
    "concepts",
    "authors",
    "status",
    "createdAt",
    "updatedAt",
    "summary",
    "difficulty",
    "estimatedMinutes"
  ]
}