---
import SettingsMenu from "./SettingsMenu.astro";

interface Props {
  current?: "portal" | "action-center" | "atlas" | "semi-platform" | "student-council" | "thinking-cafe" | "editor" | "articles" | "workspace" | "member-profile" | "member-profile-edit" | "member-tasks" | "member-calendar" | "profile-requests" | "project-profile-requests" | "operations" | "progress" | "calendar" | "genres" | "review" | "reports" | "analytics" | "permissions" | "guide" | "rules" | "applications" | "application-interview" | "introductions" | "secretariat" | "co-working" | "management" | "procedures" | "member-management" | "genre-roles" | "operations-statistics" | "publication-runs" | "onboarding-demo" | "update-history" | "audit-log";
  site?: "portal" | "atlas" | "semi-platform" | "student-council" | "thinking-cafe" | "secretariat";
}
const { current: requestedCurrent, site: requestedSite } = Astro.props;
const normalizedPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const requestedProject = Astro.url.searchParams.get("project");
type SiteKey = "portal" | "atlas" | "semi-platform" | "student-council" | "thinking-cafe" | "secretariat";
const siteForProject = (project: string | null): SiteKey => project === "secretariat" ? "secretariat" : project === "seminar-platform" ? "semi-platform" : project === "student-council-exchange" ? "student-council" : project === "thinking-cafe" ? "thinking-cafe" : project === "portal" ? "portal" : "atlas";
const operationProject = ["secretariat", "seminar-platform", "student-council-exchange", "thinking-cafe"].includes(requestedProject ?? "") ? requestedProject! : "atlas";
const querySite = siteForProject(requestedProject);
const portalRoutes = new Set(["/admin/portal", "/admin/action-center", "/admin/member-profile", "/admin/member-profile/edit", "/admin/member-tasks", "/admin/member-calendar"]);
const routeSite: SiteKey = portalRoutes.has(normalizedPath)
  ? "portal"
  : normalizedPath === "/admin/profile-requests" || normalizedPath === "/admin/secretariat"
    ? "secretariat"
    : normalizedPath === "/admin/semi-platform"
      ? "semi-platform"
      : normalizedPath === "/admin/student-council"
        ? "student-council"
        : normalizedPath === "/admin/thinking-cafe"
          ? "thinking-cafe"
          : ["/admin/operations", "/admin/progress", "/admin/calendar", "/admin/co-working"].includes(normalizedPath)
            ? siteForProject(operationProject)
            : querySite;
const routeCurrent = normalizedPath === "/admin/portal"
  ? "portal"
  : normalizedPath === "/admin/action-center"
    ? "action-center"
  : normalizedPath === "/admin/atlas"
    ? "atlas"
    : normalizedPath === "/admin/secretariat"
      ? "secretariat"
      : normalizedPath === "/admin/semi-platform"
        ? "semi-platform"
        : normalizedPath === "/admin/student-council"
          ? "student-council"
        : normalizedPath === "/admin/thinking-cafe"
          ? "thinking-cafe"
        : normalizedPath === "/admin/articles"
          ? "articles"
          : normalizedPath === "/admin/editor"
            ? "editor"
              : normalizedPath === "/admin/workspace"
                ? "workspace"
              : normalizedPath === "/admin/genres"
                ? "genres"
              : normalizedPath === "/admin/manage"
                ? "management"
              : normalizedPath === "/admin/procedures"
                ? "procedures"
              : normalizedPath === "/admin/member-management"
                ? "member-management"
              : normalizedPath === "/admin/genre-roles"
                ? "genre-roles"
              : normalizedPath === "/admin/operations-statistics"
                ? "operations-statistics"
              : normalizedPath === "/admin/publication-runs"
                ? "publication-runs"
              : normalizedPath === "/admin/calendar"
                ? "calendar"
              : normalizedPath === "/admin/operations"
                ? "operations"
                : normalizedPath === "/admin/progress"
                  ? "progress"
                : normalizedPath === "/admin/co-working"
                  ? "co-working"
                  : normalizedPath === "/admin/review"
                    ? "review"
                    : normalizedPath === "/admin/reports"
                      ? "reports"
                      : normalizedPath === "/admin/analytics"
                        ? "analytics"
                      : normalizedPath === "/admin/permissions"
                        ? "permissions"
                          : normalizedPath === "/admin/guide"
                          ? "guide"
                          : normalizedPath === "/admin/update-history"
                            ? "update-history"
                          : normalizedPath === "/admin/audit-log"
                            ? "audit-log"
                          : normalizedPath === "/admin/rules"
                            ? "rules"
                          : normalizedPath === "/admin/onboarding-demo"
                            ? "onboarding-demo"
                          : normalizedPath === "/admin/applications"
                            ? "applications"
                          : normalizedPath === "/admin/application-interview"
                            ? "application-interview"
                            : normalizedPath === "/admin/introductions"
                              ? "introductions"
                              : normalizedPath === "/admin/member-profile"
                                ? "member-profile"
                              : normalizedPath === "/admin/member-profile/edit"
                                ? "member-profile-edit"
                                : normalizedPath === "/admin/member-tasks"
                                  ? "member-tasks"
                                  : normalizedPath === "/admin/member-calendar"
                                    ? "member-calendar"
                                    : normalizedPath === "/admin/profile-requests"
                                      ? "profile-requests"
                                      : normalizedPath === "/admin/project-profile-requests"
                                        ? "project-profile-requests"
                                      : "atlas";
const current = requestedCurrent ?? routeCurrent;
const site = requestedSite ?? routeSite;
// UIでは短いサイトキーを保ちつつ、D1では参加者が存在する正規slugを使う。
const projectSlug = site === "secretariat" ? "secretariat" : site === "semi-platform" ? "seminar-platform" : site === "student-council" ? "student-council-exchange" : site === "thinking-cafe" ? "thinking-cafe" : "atlas";
const homePath = site === "portal" ? "/admin/portal/" : site === "secretariat" ? "/admin/secretariat/" : site === "semi-platform" ? "/admin/semi-platform/" : site === "student-council" ? "/admin/student-council/" : site === "thinking-cafe" ? "/admin/thinking-cafe/" : "/admin/atlas/";
const brandLabel = site === "portal" ? "Atlasezメンバー用サイト" : site === "secretariat" ? "Atlasez運営事務局" : site === "semi-platform" ? "ゼミプラットフォーム" : site === "student-council" ? "日本生徒会協会" : site === "thinking-cafe" ? "考えるカフェ" : "学習サイト「アトラス」運営用サイト";
const pageLabel = ({
  portal: "Atlasezメンバー用サイト",
  "action-center": "アクションセンター",
  atlas: "学習サイトHome",
  "semi-platform": "ゼミプラットフォームHome",
  "student-council": "日本生徒会協会Home",
  "thinking-cafe": "考えるカフェHome",
  secretariat: "運営事務局Home",
  editor: "記事編集",
  articles: "編集・フィードバック",
  workspace: "マイページ",
  "member-profile": "マイページ",
  "member-profile-edit": "プロフィール編集",
  "member-tasks": "タスク管理",
  "member-calendar": "カレンダー",
  "profile-requests": "メンバー情報の承認",
  "project-profile-requests": "運営内自己紹介の承認",
  operations: "タスク管理",
  progress: "進捗報告",
  calendar: "カレンダー",
  genres: "各ジャンル概要",
  review: "フィードバック一覧",
  reports: "問題報告",
  analytics: "学習サイト閲覧統計",
  permissions: "運営者・担当管理",
  guide: "作業の進め方",
  rules: "規則",
  "onboarding-demo": "オンボーディング紹介",
  applications: "運営参加応募",
  "application-interview": "面談メモ",
  introductions: "運営内自己紹介",
  "co-working": "同時作業会",
  management: "管理トップ",
  procedures: "諸手続き",
  "member-management": "運営メンバー管理",
  "genre-roles": "ジャンル・役割管理",
  "operations-statistics": "運営メンバー統計",
  "publication-runs": "公開処理の状況",
  "update-history": "アップデート履歴",
  "audit-log": "操作履歴",
} as Record<NonNullable<Props["current"]>, string>)[current];
const projectHome = new Set<NonNullable<Props["current"]>>(["atlas", "semi-platform", "student-council", "thinking-cafe", "secretariat"]);
---
<header class="admin-nav" data-admin-nav data-current-site={site} data-current-slug={projectSlug} transition:persist="admin-nav">
  <a class="admin-nav-brand-logo" href={homePath} aria-label={`${brandLabel}のトップへ戻る`}><img src="/images/atlasez-logo.png" alt="" width="34" height="34" /></a>
  <div class="admin-project-switcher" data-project-switcher data-current-site={site} data-current-slug={projectSlug}>
    <div class="admin-project-switcher-content">
    <a class="admin-project-switcher-title" href={homePath} data-project-current-link data-admin-i18n data-admin-ja={brandLabel} data-admin-en={site === "portal" ? "Atlasez member site" : site === "secretariat" ? "Atlasez Secretariat" : site === "semi-platform" ? "Seminar platform" : site === "student-council" ? "Japan Student Council Association" : site === "thinking-cafe" ? "Thinking Cafe" : "Atlas learning site operations"}>{brandLabel}</a>
    </div>
  </div>
  <button type="button" class="admin-menu-toggle" data-admin-menu-toggle aria-expanded="false" aria-controls="admin-primary-nav"><span aria-hidden="true">☰</span><span>メニュー</span></button>
  <nav id="admin-primary-nav" aria-label="運営用サイトメニュー">
      <a class="admin-action-center-link" href="/admin/action-center/" data-admin-page="action-center" aria-current={current === "action-center" ? "page" : undefined} aria-label="アクションセンター" title="アクションセンター"><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M3 4.5h10M3 8h7M3 11.5h5" /></svg><span>対応</span></a>
      <a href="/admin/member-tasks/" data-admin-site="portal" data-admin-page="member-tasks" hidden={site !== "portal"} aria-current={current === "member-tasks" ? "page" : undefined}>タスク管理</a>
      <a href="/admin/member-calendar/" data-admin-site="portal" data-admin-page="member-calendar" hidden={site !== "portal"} aria-current={current === "member-calendar" ? "page" : undefined}>カレンダー</a>
      <a href="/admin/member-profile/" data-admin-site="portal" data-admin-page="member-profile" hidden={site !== "portal"} aria-current={current === "member-profile" ? "page" : undefined}>マイページ</a>
      <a href="/admin/articles/" data-admin-site="atlas" data-admin-page="articles" hidden={site !== "atlas"} aria-current={current === "articles" && site === "atlas" ? "page" : undefined}>編集・フィードバック</a>
      <a href="/admin/operations/?project=atlas" data-admin-site="atlas" data-admin-page="operations" hidden={site !== "atlas"} aria-current={current === "operations" && site === "atlas" ? "page" : undefined}>タスク管理</a>
      <a href="/admin/calendar/?project=atlas" data-admin-site="atlas" data-admin-page="calendar" hidden={site !== "atlas"} aria-current={current === "calendar" && site === "atlas" ? "page" : undefined}>カレンダー</a>
      <a href="/admin/operations/?project=secretariat" data-admin-site="secretariat" data-admin-page="operations" hidden={site !== "secretariat"} aria-current={current === "operations" && site === "secretariat" ? "page" : undefined}>事務局タスク管理</a>
      <a href="/admin/calendar/?project=secretariat" data-admin-site="secretariat" data-admin-page="calendar" hidden={site !== "secretariat"} aria-current={current === "calendar" && site === "secretariat" ? "page" : undefined}>事務局カレンダー</a>
      <a href="/admin/profile-requests/" data-admin-site="secretariat" data-admin-page="profile-requests" hidden={site !== "secretariat"} aria-current={current === "profile-requests" && site === "secretariat" ? "page" : undefined}>メンバー情報の承認</a>
      <a href="/admin/operations/?project=seminar-platform" data-admin-site="semi-platform" data-admin-page="operations" hidden={site !== "semi-platform"} aria-current={current === "operations" && site === "semi-platform" ? "page" : undefined}>ゼミ・タスク管理</a>
      <a href="/admin/calendar/?project=seminar-platform" data-admin-site="semi-platform" data-admin-page="calendar" hidden={site !== "semi-platform"} aria-current={current === "calendar" && site === "semi-platform" ? "page" : undefined}>ゼミ・カレンダー</a>
      <a href="/admin/operations/?project=student-council-exchange" data-admin-site="student-council" data-admin-page="operations" hidden={site !== "student-council"} aria-current={current === "operations" && site === "student-council" ? "page" : undefined}>生徒会タスク管理</a>
      <a href="/admin/calendar/?project=student-council-exchange" data-admin-site="student-council" data-admin-page="calendar" hidden={site !== "student-council"} aria-current={current === "calendar" && site === "student-council" ? "page" : undefined}>生徒会カレンダー</a>
      <a href="/admin/operations/?project=thinking-cafe" data-admin-site="thinking-cafe" data-admin-page="operations" hidden={site !== "thinking-cafe"} aria-current={current === "operations" && site === "thinking-cafe" ? "page" : undefined}>カフェ・タスク管理</a>
      <a href="/admin/calendar/?project=thinking-cafe" data-admin-site="thinking-cafe" data-admin-page="calendar" hidden={site !== "thinking-cafe"} aria-current={current === "calendar" && site === "thinking-cafe" ? "page" : undefined}>カフェ・カレンダー</a>
    <a class="admin-management-link" href={`/admin/manage/?project=${projectSlug}`} hidden={site === "portal"} data-admin-project-link="manage" data-admin-site={site} data-admin-page="management" aria-current={current === "management" ? "page" : undefined}>管理</a>
  </nav>
  <div class="admin-account" data-admin-account hidden>
    <button type="button" class="admin-command-button" data-admin-command aria-haspopup="dialog" aria-controls="admin-command-dialog"><kbd>⌘ K</kbd><span>操作を検索</span></button>
    <SettingsMenu locale="ja" />
    <button type="button" class="admin-notifications" data-admin-notifications aria-expanded="false" aria-controls="admin-notification-panel" aria-haspopup="dialog" aria-label="通知を開く"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M18 9a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4" /></svg><span data-admin-notification-count hidden>0</span></button>
    <div id="admin-notification-panel" class="admin-notification-panel" data-admin-notification-panel role="dialog" aria-labelledby="admin-notification-heading" hidden><div class="notification-panel-heading"><strong id="admin-notification-heading">通知</strong><button type="button" class="mark-all-read" data-mark-all-notifications-read>すべて既読</button><button type="button" data-close-notifications aria-label="通知を閉じる">×</button></div><div data-admin-notification-list aria-live="polite"><span class="admin-notification-loading">通知を確認しています…</span></div></div>
    <a class="admin-account-profile" data-admin-account-profile href={site === "portal" ? "/admin/member-profile/" : `/admin/workspace/?project=${projectSlug}`} aria-label="マイページを開く">
      <span class="admin-account-avatar" data-admin-account-avatar aria-hidden="true"><img data-admin-account-image alt="" hidden /><span data-admin-account-fallback>A</span></span>
      <span class="admin-account-email" data-admin-account-email>アカウント</span>
    </a>
    <form method="post" action="/auth/logout">
      <button type="submit" class="admin-logout">ログアウト</button>
    </form>
  </div>
  <dialog class="admin-command-dialog" id="admin-command-dialog" data-admin-command-dialog aria-labelledby="admin-command-heading">
    <form method="dialog" class="admin-command-inner">
      <div class="admin-command-head"><h2 id="admin-command-heading">操作を検索</h2><button type="submit" class="admin-command-close" aria-label="操作検索を閉じる">×</button></div>
      <label class="admin-command-search"><span aria-hidden="true">⌕</span><input type="search" data-admin-command-input placeholder="記事・タスク・操作を検索" autocomplete="off" /><kbd>Esc</kbd></label>
      <div class="admin-command-list" data-admin-command-list role="listbox" aria-label="検索結果"></div>
      <p class="admin-command-hint"><kbd>↑</kbd><kbd>↓</kbd>で移動 <kbd>Enter</kbd>で開く</p>
    </form>
  </dialog>
</header>
<nav class="admin-breadcrumbs" data-admin-breadcrumbs aria-label="パンくず" hidden={site === "portal"} transition:persist="admin-breadcrumbs"><a href="/admin/portal/">Atlasezメンバー用サイト</a><span aria-hidden="true">›</span>{projectHome.has(current) ? <span aria-current="page">{brandLabel}</span> : <><a href={homePath}>{brandLabel}</a><span aria-hidden="true">›</span><span aria-current="page">{pageLabel}</span></>}</nav>
<script>
  import { navigate } from "astro:transitions/client";

  (() => {
    const preferencesKey = 'atlasez-prefs';
    const languageKey = 'atlasez-admin-language';
    type AdminLanguage = 'ja' | 'en';
    const readPreferences = (): Record<string, string> => {
      try { return JSON.parse(localStorage.getItem(preferencesKey) ?? '{}') as Record<string, string>; } catch { return {}; }
    };
    const currentLanguage = (): AdminLanguage => {
      const preferences = readPreferences();
      return preferences.lang === 'eng' || preferences.lang === 'en' || localStorage.getItem(languageKey) === 'en' ? 'en' : 'ja';
    };
    const languageText = (element: HTMLElement, language: AdminLanguage) => element.dataset[language === 'ja' ? 'adminJa' : 'adminEn'] ?? element.textContent ?? '';
    const applyLanguage = (language: AdminLanguage) => {
      document.documentElement.lang = language;
      document.querySelectorAll<HTMLElement>('[data-admin-i18n]').forEach((element) => { element.textContent = languageText(element, language); });
      document.querySelectorAll<HTMLSelectElement>('[data-admin-language]').forEach((select) => { select.value = language; });
      document.querySelectorAll<HTMLButtonElement>('[data-project-previous]').forEach((button) => button.setAttribute('aria-label', language === 'ja' ? '前のプロジェクト' : 'Previous project'));
      document.querySelectorAll<HTMLButtonElement>('[data-project-next]').forEach((button) => button.setAttribute('aria-label', language === 'ja' ? '次のプロジェクト' : 'Next project'));
    };
    const applyTheme = (mode: string | undefined, persist = false) => {
      const normalized = mode === 'black' ? 'black' : mode === 'dark' ? 'dark' : '';
      document.documentElement.dataset.prefBg = normalized ? 'dark' : '';
      if (normalized === 'black') document.documentElement.dataset.prefMode = 'black';
      else document.documentElement.removeAttribute('data-pref-mode');
      const preferences = readPreferences();
      if (persist) { if (normalized) preferences.bg = normalized; else delete preferences.bg; localStorage.setItem(preferencesKey, JSON.stringify(preferences)); }
    };
    applyTheme(readPreferences().bg);
    applyLanguage(currentLanguage());

    type RouteState = { site: 'portal' | 'atlas' | 'semi-platform' | 'student-council' | 'thinking-cafe' | 'secretariat'; slug: string; current: string; home: string; label: string };
    const pageLabels: Record<string, string> = { articles: '編集・フィードバック', editor: '記事編集', developer: '開発者モード', workspace: 'マイページ', 'member-profile': 'マイページ', 'member-profile/edit': 'プロフィール編集', 'member-profile-edit': 'プロフィール編集', 'member-tasks': 'タスク管理', 'member-calendar': 'カレンダー', 'profile-requests': 'メンバー情報の承認', 'project-profile-requests': '運営内自己紹介の承認', operations: 'タスク管理', progress: '進捗報告', calendar: 'カレンダー', genres: '各ジャンル概要', management: '管理トップ', procedures: '諸手続き', 'member-management': '運営メンバー管理', 'genre-roles': 'ジャンル・役割管理', 'operations-statistics': '運営メンバー統計', 'co-working': '同時作業会', reports: '問題報告', analytics: '学習サイト閲覧統計', permissions: '運営者・担当管理', guide: '作業の進め方', rules: '規則', applications: '運営参加応募', 'application-interview': '面談メモ', introductions: '運営内自己紹介', review: 'フィードバック一覧', 'onboarding-demo': 'オンボーディング紹介' };
    const slugForSite = (site: RouteState['site']) => site === 'secretariat' ? 'secretariat' : site === 'semi-platform' ? 'seminar-platform' : site === 'student-council' ? 'student-council-exchange' : site === 'thinking-cafe' ? 'thinking-cafe' : 'atlas';
    const homeForSite = (site: RouteState['site']) => site === 'portal' ? '/admin/portal/' : site === 'secretariat' ? '/admin/secretariat/' : site === 'semi-platform' ? '/admin/semi-platform/' : site === 'student-council' ? '/admin/student-council/' : site === 'thinking-cafe' ? '/admin/thinking-cafe/' : '/admin/atlas/';
    const labelForSite = (site: RouteState['site']) => site === 'portal' ? 'Atlasezメンバー用サイト' : site === 'secretariat' ? 'Atlasez運営事務局' : site === 'semi-platform' ? 'ゼミプラットフォーム' : site === 'student-council' ? '日本生徒会協会' : site === 'thinking-cafe' ? '考えるカフェ' : '学習サイト「アトラス」運営用サイト';
    const readRouteState = (): RouteState => {
      const path = window.location.pathname.replace(/\/$/, '') || '/';
      const project = new URLSearchParams(window.location.search).get('project');
      const site: RouteState['site'] = ['/admin/portal', '/admin/member-profile', '/admin/member-profile/edit', '/admin/member-tasks', '/admin/member-calendar'].includes(path) || project === 'portal' ? 'portal' : path === '/admin/secretariat' || path === '/admin/profile-requests' || project === 'secretariat' ? 'secretariat' : path === '/admin/semi-platform' || project === 'seminar-platform' ? 'semi-platform' : path === '/admin/student-council' || project === 'student-council-exchange' ? 'student-council' : path === '/admin/thinking-cafe' || project === 'thinking-cafe' ? 'thinking-cafe' : 'atlas';
      const slug = slugForSite(site);
      const current = path === '/admin/portal' ? 'portal' : path === '/admin/atlas' ? 'atlas' : path === '/admin/secretariat' ? 'secretariat' : path === '/admin/semi-platform' ? 'semi-platform' : path === '/admin/student-council' ? 'student-council' : path === '/admin/thinking-cafe' ? 'thinking-cafe' : path === '/admin/manage' ? 'management' : path.slice('/admin/'.length) || 'atlas';
      return { site, slug, current, home: homeForSite(site), label: labelForSite(site) };
    };
    const syncRouteChrome = () => {
      const state = readRouteState();
      const nav = document.querySelector<HTMLElement>('[data-admin-nav]');
      const primaryNav = document.querySelector<HTMLElement>('#admin-primary-nav');
      const menuToggle = document.querySelector<HTMLButtonElement>('[data-admin-menu-toggle]');
      const breadcrumbs = document.querySelector<HTMLElement>('[data-admin-breadcrumbs]');
      const title = document.querySelector<HTMLAnchorElement>('[data-project-current-link]');
      const switcher = document.querySelector<HTMLElement>('[data-project-switcher]');
      const accountProfile = document.querySelector<HTMLAnchorElement>('[data-admin-account-profile]');
      nav?.setAttribute('data-current-site', state.site);
      nav?.setAttribute('data-current-slug', state.slug);
      switcher?.setAttribute('data-current-site', state.site);
      switcher?.setAttribute('data-current-slug', state.slug);
      document.querySelectorAll<HTMLAnchorElement>('[data-admin-project-link]').forEach((link) => {
        const isManagementLink = link.dataset.adminProjectLink === 'manage';
        if (isManagementLink && state.site === 'portal') {
          // メンバー用サイトには運営管理への導線を表示しない。ClientRouterの
          // persistent navでも、ポータルへ戻った瞬間に再表示されないようにする。
          link.dataset.adminSite = 'restricted';
          link.hidden = true;
          link.setAttribute('aria-hidden', 'true');
          link.tabIndex = -1;
          return;
        }
        link.removeAttribute('aria-hidden');
        link.removeAttribute('tabindex');
        link.dataset.adminSite = state.site;
        link.href = `/admin/${link.dataset.adminProjectLink}/?project=${encodeURIComponent(state.slug)}`;
      });
      if (accountProfile) accountProfile.href = state.site === 'portal' ? '/admin/member-profile/' : `/admin/workspace/?project=${encodeURIComponent(state.slug)}`;
      if (primaryNav) primaryNav.hidden = false;
      if (menuToggle) { menuToggle.hidden = false; menuToggle.setAttribute('aria-expanded', 'false'); }
      primaryNav?.classList.remove('is-open');
      document.querySelectorAll<HTMLElement>('[data-admin-site]').forEach((link) => { link.hidden = link.dataset.adminSite !== state.site; });
      document.querySelectorAll<HTMLElement>('[data-admin-page]').forEach((link) => { link.setAttribute('aria-current', link.dataset.adminPage === state.current && link.closest('[data-admin-site]')?.getAttribute('data-admin-site') === state.site ? 'page' : 'false'); });
      if (title) { title.href = state.home; title.dataset.adminJa = state.label; title.textContent = currentLanguage() === 'ja' ? state.label : state.site === 'portal' ? 'Atlasez member site' : state.site === 'secretariat' ? 'Atlasez Secretariat' : state.site === 'semi-platform' ? 'Seminar platform' : state.site === 'student-council' ? 'Japan Student Council Association' : state.site === 'thinking-cafe' ? 'Thinking Cafe' : 'Atlas learning site operations'; }
      const logo = document.querySelector<HTMLAnchorElement>('.admin-nav-brand-logo');
      if (logo) logo.href = state.home;
      if (breadcrumbs) {
        breadcrumbs.hidden = state.site === 'portal';
        breadcrumbs.innerHTML = state.site === 'portal' ? '' : `<a href="/admin/portal/">Atlasezメンバー用サイト</a><span aria-hidden="true">›</span><a href="${state.home}">${state.label}</a>${['atlas', 'semi-platform', 'student-council', 'thinking-cafe', 'secretariat'].includes(state.current) ? '' : `<span aria-hidden="true">›</span><span aria-current="page">${pageLabels[state.current] ?? state.current}</span>`}`;
      }
    };
    syncRouteChrome();
    const applyManagerVisibility = (isManager: boolean, managerProjects: string[] = []) => {
      const state = readRouteState();
      document.querySelectorAll<HTMLElement>('[data-manager-only]').forEach((item) => { item.hidden = !isManager || item.dataset.adminSite !== state.site; });
      const managesCurrentProject = isManager || managerProjects.includes(state.slug) || (state.slug === 'seminar-platform' && managerProjects.includes('semi-platform'));
      document.querySelectorAll<HTMLElement>('[data-project-manager-only]').forEach((item) => { item.hidden = !managesCurrentProject || item.dataset.adminSite !== state.site; });
      document.querySelectorAll<HTMLElement>('[data-developer-only]').forEach((item) => {
        item.hidden = !(isManager || managerProjects.length > 0) || item.dataset.adminSite !== state.site;
      });
    };
    type AuthStatus = { email?: string; isManager?: boolean; managerProjects?: string[]; error?: string };
    type AuthStatusResult = { ok: boolean; status: number; contentType: string; data: AuthStatus };
    let authStatusRequest: Promise<AuthStatusResult> | null = null;
    let authStatusCache: { value: AuthStatusResult; expiresAt: number } | null = null;
    const fetchAuthStatus = () => {
      if (authStatusCache && authStatusCache.expiresAt > Date.now()) return Promise.resolve(authStatusCache.value);
      if (!authStatusRequest) {
        const request = fetch('/api/admin/auth-status', { credentials: 'same-origin', cache: 'no-store' })
          .then(async (response) => {
            const contentType = response.headers.get('content-type') ?? '';
            const data = contentType.includes('application/json') ? await response.json() as AuthStatus : {};
            return { ok: response.ok, status: response.status, contentType, data };
          })
          .catch(() => ({ ok: false, status: 0, contentType: '', data: {} }));
        authStatusRequest = request.then((result) => {
          // Both the manager visibility and account widgets need the same
          // response during startup. Keep it briefly without changing the
          // existing no-store request or longer-term permission freshness.
          if (result.ok || result.status === 401) authStatusCache = { value: result, expiresAt: Date.now() + 1_000 };
          return result;
        }).finally(() => { authStatusRequest = null; });
      }
      return authStatusRequest;
    };
    const refreshManagerVisibility = async () => {
      // 遷移後も保持されるナビの権限表示を、毎回サーバーの最新状態へ戻す。
      // 取得に失敗したときは安全側（非表示）にし、次の再試行で復元する。
      const requestId = String((Number(document.documentElement.dataset.adminNavRequest) || 0) + 1);
      document.documentElement.dataset.adminNavRequest = requestId;
      applyManagerVisibility(false);
      try {
        const response = await fetchAuthStatus();
        if (requestId !== document.documentElement.dataset.adminNavRequest || !response.contentType.includes('application/json') || !response.ok) return;
        const status = response.data;
        if (requestId !== document.documentElement.dataset.adminNavRequest) return;
        applyManagerVisibility(status.isManager === true, status.managerProjects ?? []);
      } catch {
        // 権限UIの更新失敗だけでページ全体を止めない。次のpage-loadで再試行する。
      }
    };
    if (document.documentElement.dataset.adminNavLifecycleBound !== 'true') {
      document.documentElement.dataset.adminNavLifecycleBound = 'true';
      window.addEventListener('atlasez-lang-change', () => { applyLanguage(currentLanguage()); syncRouteChrome(); void refreshManagerVisibility(); });
      document.addEventListener('astro:after-swap', () => { applyTheme(readPreferences().bg); applyLanguage(currentLanguage()); syncRouteChrome(); void refreshManagerVisibility(); });
      document.addEventListener('astro:page-load', () => { syncRouteChrome(); void refreshManagerVisibility(); });
    }
    void refreshManagerVisibility();

    const account = document.querySelector<HTMLElement>('[data-admin-account]');
    if (account && account.dataset.loaded !== 'true') {
      account.dataset.loaded = 'true';
      const email = account.querySelector<HTMLElement>('[data-admin-account-email]');
      const avatar = account.querySelector<HTMLElement>('[data-admin-account-avatar]');
      const avatarImage = account.querySelector<HTMLImageElement>('[data-admin-account-image]');
      const avatarFallback = account.querySelector<HTMLElement>('[data-admin-account-fallback]');
      const notificationButton = document.querySelector<HTMLButtonElement>('[data-admin-notifications]');
      const notificationPanel = document.querySelector<HTMLElement>('[data-admin-notification-panel]');
      const notificationList = document.querySelector<HTMLElement>('[data-admin-notification-list]');
      const notificationCount = document.querySelector<HTMLElement>('[data-admin-notification-count]');
      const closeNotifications = document.querySelector<HTMLButtonElement>('[data-close-notifications]');
      const markAllRead = document.querySelector<HTMLButtonElement>('[data-mark-all-notifications-read]');
      const menuToggle = document.querySelector<HTMLButtonElement>('[data-admin-menu-toggle]');
      const primaryNav = document.querySelector<HTMLElement>('#admin-primary-nav');
      let notifications: Array<{ id: string; title: string; detail: string; href: string; kind?: string; updatedAt?: string; read?: boolean }> = [];
      const escape = (value: string) => value.replace(/[&<>"]/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[character] ?? character);
      const formatNotificationTime = (value?: string) => value ? new Intl.DateTimeFormat('ja-JP', { dateStyle: 'medium', timeStyle: 'short' }).format(new Date(value)) : '';
      const profileCacheKey = 'atlasez-admin-profile-cache';
      type CachedProfile = { email?: string; display_name?: string; avatar_url?: string };
      type ProfileResponse = { profile?: { display_name?: string; avatar_url?: string }; profileChangeRequest?: { status?: string; proposed_display_name?: string } };
      const readCachedProfile = (): CachedProfile | null => {
        try {
          const cached = sessionStorage.getItem(profileCacheKey);
          return cached ? JSON.parse(cached) as CachedProfile : null;
        } catch { return null; }
      };
      const applyProfile = (profile: CachedProfile, fallbackEmail = '') => {
        const image = profile.avatar_url?.trim() ?? '';
        if (avatar) { avatar.style.backgroundImage = ''; avatar.classList.toggle('has-image', Boolean(image)); }
        if (avatarFallback) { avatarFallback.hidden = Boolean(image); avatarFallback.textContent = (fallbackEmail[0] ?? 'A').toUpperCase(); }
        if (avatarImage) {
          avatarImage.hidden = !image;
          avatarImage.onerror = () => { avatarImage.hidden = true; avatarImage.removeAttribute('src'); if (avatarFallback) avatarFallback.hidden = false; };
          if (image) avatarImage.src = image; else avatarImage.removeAttribute('src');
        }
        if (email) email.textContent = profile.display_name?.trim() || 'アカウント';
      };
      const cachedProfile = readCachedProfile();
      if (cachedProfile) applyProfile(cachedProfile);
      const loadAccount = async () => {
        try {
          const statusResponse = await fetchAuthStatus();
          if (statusResponse.status === 401) {
            const returnTo = `${window.location.pathname}${window.location.search}${window.location.hash}`;
            window.location.assign(`/auth/google/login?returnTo=${encodeURIComponent(returnTo)}`);
            return;
          }
          if (!statusResponse.contentType.includes('application/json')) throw new Error('認証状態を確認できません。ページを再読み込みしてください。');
          const status = statusResponse.data;
          if (!statusResponse.ok || !status.email) throw new Error(status.error ?? 'ログイン情報を取得できませんでした');
          if (email) { email.title = status.email; }
          const cachedForAccount = cachedProfile?.email === status.email ? cachedProfile : null;
          if (cachedProfile && !cachedForAccount) {
            try { sessionStorage.removeItem(profileCacheKey); } catch { /* storage may be unavailable */ }
            applyProfile({}, status.email);
          } else if (!cachedProfile) applyProfile({}, status.email);
          try {
            const profileResponse = await fetch('/api/admin/profile', { credentials: 'same-origin', cache: 'no-store' });
            if (profileResponse.ok) {
              const profile = await profileResponse.json() as ProfileResponse;
              const pendingName = profile.profileChangeRequest?.status === 'pending' ? profile.profileChangeRequest.proposed_display_name?.trim() : '';
              const nextProfile = { ...(profile.profile ?? {}), ...(pendingName ? { display_name: pendingName } : {}), email: status.email };
              applyProfile(nextProfile, status.email);
              try { sessionStorage.setItem(profileCacheKey, JSON.stringify(nextProfile)); } catch { /* storage may be unavailable */ }
            }
          } catch { /* アカウント表示はメールアドレスだけでも利用できます */ }
        } catch (error) {
          if (email) {
            if (!cachedProfile?.display_name) email.textContent = 'アカウント';
            email.title = error instanceof Error ? error.message : 'ログイン情報を取得できませんでした';
          }
        } finally { account.hidden = false; }
      };
      document.addEventListener('atlasez-profile-updated', () => { void loadAccount(); });
      const loadNotifications = async () => {
        if (!notificationList) return;
        try {
          const response = await fetch('/api/admin/notifications', { credentials: 'same-origin', cache: 'no-store' });
          const contentType = response.headers.get('content-type') ?? '';
          if (!response.ok || !contentType.includes('application/json')) throw new Error('notification request failed');
          const data = await response.json() as { notifications?: typeof notifications };
          if (!Array.isArray(data.notifications)) throw new Error('invalid notification response');
          notifications = data.notifications;
          const unreadCount = notifications.filter((item) => !item.read).length;
          if (notificationCount) { notificationCount.textContent = unreadCount > 99 ? "99+" : String(unreadCount); notificationCount.hidden = unreadCount === 0; }
          if (markAllRead) markAllRead.hidden = unreadCount === 0;
          const kindLabel = (kind: string) => ({ comment: 'コメント', mention: 'メンション', review: 'フィードバック依頼', 'feedback-request': 'フィードバック依頼', 'task-request': 'タスク依頼', application: '応募', approved: 'フィードバック完了', published: '公開', 'publication-ready': '公開準備完了' } as Record<string, string>)[kind] ?? '記事';
          notificationList.innerHTML = notifications.length ? notifications.map((item) => `<div class="admin-notification-item${item.read ? ' is-read' : ''}"><a href="${item.href}" data-open-notification="${escape(item.id)}"><span class="notification-kind">${escape(kindLabel((item as any).kind))}</span><b>${escape(item.title)}</b><small>${escape(item.detail)}</small><time datetime="${escape(item.updatedAt ?? '')}">${escape(formatNotificationTime(item.updatedAt))}</time></a>${item.read ? '<span class="notification-read-label">既読</span>' : `<button type="button" data-read-notification="${escape(item.id)}">既読にする</button>`}</div>`).join('') : '<span class="admin-notification-empty">通知はまだありません。</span>';
        } catch {
          notifications = [];
          if (notificationCount) notificationCount.hidden = true;
          if (markAllRead) markAllRead.hidden = true;
          notificationList.innerHTML = '<span class="admin-notification-empty" role="status">通知を取得できませんでした。時間をおいて再度お試しください。</span>';
        }
      };
      const setNotificationPanelOpen = (open: boolean, restoreFocus = false) => {
        if (!notificationButton || !notificationPanel) return;
        const wasOpen = !notificationPanel.hidden;
        notificationPanel.hidden = !open;
        notificationButton.setAttribute('aria-expanded', String(open));
        notificationButton.setAttribute('aria-label', open ? '通知を閉じる' : '通知を開く');
        if (!open && wasOpen && restoreFocus) notificationButton.focus();
      };
      notificationButton?.addEventListener('click', () => { setNotificationPanelOpen(Boolean(notificationPanel?.hidden)); });
      closeNotifications?.addEventListener('click', () => { setNotificationPanelOpen(false, true); });
      menuToggle?.addEventListener('click', () => { const open = !primaryNav?.classList.contains('is-open'); primaryNav?.classList.toggle('is-open', open); menuToggle.setAttribute('aria-expanded', String(open)); });
      const closeNotificationsOnOutsidePointer = (event: Event) => {
        if (!notificationPanel || notificationPanel.hidden || !(event.target instanceof Node)) return;
        if (notificationPanel.contains(event.target) || notificationButton?.contains(event.target)) return;
        setNotificationPanelOpen(false);
      };
      document.addEventListener('pointerdown', closeNotificationsOnOutsidePointer, true);
      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;
        setNotificationPanelOpen(false, true);
      });
      document.addEventListener('astro:before-swap', () => { setNotificationPanelOpen(false); });
      const markRead = async (ids: string[]) => {
        if (!ids.length) return;
        const response = await fetch('/api/admin/notifications/read', { method: 'POST', credentials: 'same-origin', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ ids }) });
        if (!response.ok) throw new Error('通知を既読にできませんでした。');
        await loadNotifications();
      };
      notificationList?.addEventListener('click', (event) => {
        const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-read-notification]');
        if (button) { event.preventDefault(); void markRead([button.dataset.readNotification ?? '']).catch(() => { notificationList.textContent = '通知を既読にできませんでした'; }); }
        const link = (event.target as HTMLElement).closest<HTMLAnchorElement>('[data-open-notification]');
        if (link && !link.dataset.opened) {
          event.preventDefault();
          link.dataset.opened = 'true';
          void markRead([link.dataset.openNotification ?? '']).catch(() => undefined).finally(() => { void navigate(link.href); });
        }
      });
      markAllRead?.addEventListener('click', () => { void markRead(notifications.filter((item) => !item.read).map((item) => item.id)).catch(() => { if (notificationList) notificationList.textContent = '通知を既読にできませんでした'; }); });
      void loadNotifications();
      // ベルの未読件数を開き直さなくても更新できるよう、短い間隔で再確認します。
      window.setInterval(() => { void loadNotifications(); }, 60_000);
      void loadAccount();
    }
  })();
</script>
