---
interface Props { current: "editor" | "reports" | "guide"; }
const { current } = Astro.props;
---
<header class="admin-nav">
  <a class="admin-nav-brand" href="/atlas/ja/"><img src="/images/atlasez-logo.png" alt="" width="34" height="34" />アトラス <span>運営用サイト</span></a>
  <nav aria-label="運営用サイトメニュー">
    <a href="/admin/editor" aria-current={current === "editor" ? "page" : undefined}>記事編集</a>
    <a href="/admin/reports" aria-current={current === "reports" ? "page" : undefined}>問題報告・統計</a>
    <a href="/admin/guide" aria-current={current === "guide" ? "page" : undefined}>作業の進め方</a>
    <button type="button" data-theme-toggle aria-pressed="false">ダーク表示</button>
  </nav>
</header>
<script is:inline>
  const themeButtons = document.querySelectorAll('[data-theme-toggle]');
  const applyAdminTheme = (dark) => { document.documentElement.dataset.prefBg = dark ? 'dark' : ''; themeButtons.forEach((button) => { button.setAttribute('aria-pressed', String(dark)); button.textContent = dark ? 'ライト表示' : 'ダーク表示'; }); localStorage.setItem('atlasez-editor-theme', dark ? 'dark' : 'light'); };
  applyAdminTheme(localStorage.getItem('atlasez-editor-theme') === 'dark');
  themeButtons.forEach((button) => button.addEventListener('click', () => applyAdminTheme(document.documentElement.dataset.prefBg !== 'dark')));
</script>
<style>
  .admin-nav { align-items:center; border-bottom:1px solid var(--border-default); box-sizing:border-box; display:flex; justify-content:space-between; left:50%; min-height:4.15rem; padding:0 max(1rem, calc((100vw - 1500px) / 2)); position:relative; transform:translateX(-50%); width:100vw; }.admin-nav-brand { align-items:center; color:var(--accent-primary); display:flex; font-size:1.15rem; font-weight:700; gap:.45rem; text-decoration:none; }.admin-nav-brand span { border-left:1px solid var(--border-default); color:var(--text-primary); font-size:.8rem; margin-left:.1rem; padding-left:.55rem; }.admin-nav nav { display:flex; min-height:4.15rem; }.admin-nav nav a,.admin-nav nav button { align-items:center; background:transparent; border:0; border-bottom:3px solid transparent; color:var(--text-primary); cursor:pointer; display:flex; font:inherit; font-size:.84rem; padding:0 .65rem; text-decoration:none; }.admin-nav nav a[aria-current="page"],.admin-nav nav a:hover,.admin-nav nav button:hover { border-bottom-color:var(--accent-primary); color:var(--accent-primary); } @media(max-width:560px){.admin-nav{align-items:start;display:grid;padding: .4rem .8rem 0}.admin-nav nav{min-height:2.8rem}.admin-nav nav a,.admin-nav nav button{font-size:.74rem;padding:0 .35rem}}
</style>
