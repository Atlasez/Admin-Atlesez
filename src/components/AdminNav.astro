---
import SettingsMenu from "./SettingsMenu.astro";
import UiLanguage from "./UiLanguage.astro";

interface Props { current: "portal" | "global" | "seminar" | "secretariat" | "atlas" | "editor" | "articles" | "workspace" | "operations" | "review" | "reports" | "permissions" | "guide" | "applications" | "introductions"; }
const { current } = Astro.props;
const projectNavigation = !["portal", "global", "seminar", "secretariat"].includes(current);
const profileHref = current === "seminar" ? "/admin/projects/seminar-platform/workspace/" : current === "secretariat" ? "/admin/projects/secretariat/workspace/" : projectNavigation ? "/admin/projects/atlas/workspace/" : "/admin/workspace/";
const atlasProject = projectNavigation;
const homeHref = atlasProject ? "/admin/atlas/" : "/admin/portal/";
const homeLabel = atlasProject ? "学習サイト「アトラス」運営用サイト" : "メンバー用サイト";
// メンバー用トップ／共通プロフィールでは、ロゴ自体がホームへの導線になるため
// 同じ行に「Home」を重ねて表示しない。プロジェクト画面では戻り先として残す。
const showHomeNav = current !== "portal" && current !== "global";
---
<UiLanguage />
<header class="admin-nav">
  <a class="admin-nav-brand" href={homeHref} data-astro-reload aria-label={`${homeLabel}のHomeへ戻る`}><img src="/images/atlasez-logo.png" alt="" width="34" height="34" /><span class="admin-brand-text">{homeLabel}</span></a>
  <button type="button" class="admin-menu-toggle" data-admin-menu-toggle aria-expanded="false" aria-controls="admin-primary-nav"><span aria-hidden="true">☰</span><span>メニュー</span></button>
  <nav id="admin-primary-nav" aria-label={`${homeLabel}メニュー`}>
    {showHomeNav && <a href={homeHref} data-astro-reload aria-current={current === "atlas" ? "page" : undefined}>Home</a>}
    {projectNavigation && <>
      <a href="/admin/articles" data-astro-reload aria-current={current === "articles" ? "page" : undefined}>編集・査読</a>
      <a href="/admin/operations" data-astro-reload aria-current={current === "operations" ? "page" : undefined}>進捗・ToDo・日程</a>
    </>}
    {projectNavigation && <details class="admin-management-menu" data-management-menu>
      <summary>管理 <span aria-hidden="true">⌄</span></summary>
      <div>
        <a href="/admin/permissions" data-manager-only hidden data-astro-reload aria-current={current === "permissions" ? "page" : undefined}>運営者・担当管理</a>
        <a href="/admin/reports" data-astro-reload aria-current={current === "reports" ? "page" : undefined}>問題報告・統計</a>
        <a href="/admin/guide" data-astro-reload aria-current={current === "guide" ? "page" : undefined}>作業の進め方</a>
        <a href="/admin/introductions" data-astro-reload aria-current={current === "introductions" ? "page" : undefined}>運営内自己紹介</a>
        <a href="/admin/applications" data-manager-only hidden data-astro-reload aria-current={current === "applications" ? "page" : undefined}>応募管理</a>
      </div>
    </details>}
  </nav>
  <div class="admin-account is-loading" data-admin-account data-account-loading="true" aria-busy="true">
    <SettingsMenu locale="ja" />
    {projectNavigation && <>
      <button type="button" class="admin-notifications" data-admin-notifications aria-expanded="false" aria-label="学習サイトの通知を開く"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M18 9a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4" /></svg><span data-admin-notification-count hidden>0</span></button>
      <div class="admin-notification-panel" data-admin-notification-panel hidden><div class="notification-panel-heading"><strong>学習サイトの通知</strong><button type="button" class="mark-all-read" data-mark-all-notifications-read>すべて既読</button><button type="button" data-close-notifications aria-label="通知を閉じる">×</button></div><div data-admin-notification-list><span class="admin-notification-loading">通知を確認しています…</span></div><button type="button" class="notification-retry" data-notification-retry hidden>再読み込み</button></div>
    </>}
    <a class="admin-account-profile" href={profileHref} data-astro-reload aria-label="プロフィールを開く">
      <span class="admin-account-avatar admin-account-avatar--skeleton" data-admin-account-avatar aria-hidden="true"><img data-admin-account-image alt="" hidden /><span data-admin-account-fallback>•••</span></span>
      <span class="admin-account-email" data-admin-account-email>読み込み中…</span>
    </a>
    <form method="post" action="/auth/logout">
      <button type="submit" class="admin-logout">ログアウト</button>
    </form>
  </div>
</header>
<script>
  (() => {
    const storageKey = 'atlasez-editor-theme';
    const applyTheme = (dark: boolean, persist = false) => {
      document.documentElement.dataset.prefBg = dark ? 'dark' : '';
      document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
        button.setAttribute('aria-pressed', String(dark));
        button.setAttribute('aria-label', dark ? 'ライトモードへ切り替え' : 'ダークモードへ切り替え');
        button.textContent = dark ? '☀ ライトモード' : '☾ ダークモード';
      });
      if (persist) localStorage.setItem(storageKey, dark ? 'dark' : 'light');
    };
    let notificationTimer: number | undefined;
    const initializeAdminNav = () => {
    applyTheme(localStorage.getItem(storageKey) === 'dark');
    document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
      button.addEventListener('click', () => applyTheme(document.documentElement.dataset.prefBg !== 'dark', true));
    });
      const account = document.querySelector<HTMLElement>('[data-admin-account]');
      if (account && account.dataset.loaded !== 'true') {
        account.dataset.loaded = 'true';
      type AccountSnapshot = { email: string; displayName: string; avatarUrl: string };
      const accountCacheKey = 'atlasez-admin-account-v1';
      const email = account.querySelector<HTMLElement>('[data-admin-account-email]');
      const avatar = account.querySelector<HTMLElement>('[data-admin-account-avatar]');
      const avatarImage = account.querySelector<HTMLImageElement>('[data-admin-account-image]');
      const avatarFallback = account.querySelector<HTMLElement>('[data-admin-account-fallback]');
      const notificationButton = document.querySelector<HTMLButtonElement>('[data-admin-notifications]');
      const notificationPanel = document.querySelector<HTMLElement>('[data-admin-notification-panel]');
      const notificationList = document.querySelector<HTMLElement>('[data-admin-notification-list]');
      const notificationCount = document.querySelector<HTMLElement>('[data-admin-notification-count]');
      const closeNotifications = document.querySelector<HTMLButtonElement>('[data-close-notifications]');
      const markAllRead = document.querySelector<HTMLButtonElement>('[data-mark-all-notifications-read]');
      const menuToggle = document.querySelector<HTMLButtonElement>('[data-admin-menu-toggle]');
      const primaryNav = document.querySelector<HTMLElement>('#admin-primary-nav');
      const managementMenu = document.querySelector<HTMLDetailsElement>('[data-management-menu]');
      const notificationRetry = document.querySelector<HTMLButtonElement>('[data-notification-retry]');
      const showAdminError = (message: string) => { document.documentElement.dataset.adminErrorMessage = message; window.dispatchEvent(new CustomEvent('atlasez-admin-error', { detail: { message } })); };
      const closeManagementMenu = () => { if (managementMenu) managementMenu.open = false; };
      const readAccountCache = (): AccountSnapshot | null => {
        try {
          const cached = JSON.parse(sessionStorage.getItem(accountCacheKey) ?? 'null') as Partial<AccountSnapshot> | null;
          if (!cached || typeof cached.email !== 'string' || !cached.email) return null;
          return { email: cached.email, displayName: typeof cached.displayName === 'string' ? cached.displayName : '', avatarUrl: typeof cached.avatarUrl === 'string' ? cached.avatarUrl : '' };
        } catch { return null; }
      };
      const writeAccountCache = (snapshot: AccountSnapshot) => {
        try { sessionStorage.setItem(accountCacheKey, JSON.stringify(snapshot)); } catch { /* 容量制限時も画面表示は継続する */ }
      };
      const clearAccountCache = () => { try { sessionStorage.removeItem(accountCacheKey); } catch { /* ignore */ } };
      const anonymousMemberLabel = (value: string) => {
        const normalized = value.trim().toLowerCase();
        let hash = 2166136261;
        for (const character of normalized) { hash ^= character.codePointAt(0) ?? 0; hash = Math.imul(hash, 16777619); }
        return String((hash >>> 0) % 9000 + 1000);
      };
      const applyAccountSnapshot = (snapshot: AccountSnapshot) => {
        const displayName = snapshot.displayName.trim();
        const label = !displayName || displayName === '表示名未設定' ? anonymousMemberLabel(snapshot.email) : displayName;
        if (email) { email.textContent = label; email.title = snapshot.email; }
        if (avatarFallback) avatarFallback.textContent = (label[0] || snapshot.email[0] || 'A').toUpperCase();
        avatar?.classList.remove('admin-account-avatar--skeleton');
        if (avatarImage) {
          if (snapshot.avatarUrl) {
            const sameImage = avatarImage.getAttribute('src') === snapshot.avatarUrl;
            const revealImage = () => { avatarImage!.hidden = false; if (avatarFallback) avatarFallback.hidden = true; };
            avatarImage.onload = revealImage;
            avatarImage.onerror = () => { avatarImage!.hidden = true; if (avatarFallback) avatarFallback.hidden = false; };
            if (!sameImage) avatarImage.src = snapshot.avatarUrl;
            if (avatarImage.complete && avatarImage.naturalWidth > 0) revealImage();
            else { avatarImage.hidden = true; if (avatarFallback) avatarFallback.hidden = false; }
          } else {
            avatarImage.onload = null;
            avatarImage.onerror = null;
            avatarImage.hidden = true;
            avatarImage.removeAttribute('src');
            if (avatarFallback) avatarFallback.hidden = false;
          }
        }
        account.hidden = false;
        account.classList.remove('is-loading');
        account.removeAttribute('aria-busy');
        account.removeAttribute('data-account-loading');
      };
      let cachedAccount = readAccountCache();
      if (cachedAccount) applyAccountSnapshot(cachedAccount);
      let notifications: Array<{ id: string; title: string; detail: string; href: string; kind?: string; updatedAt?: string; read?: boolean }> = [];
      const escape = (value: string) => value.replace(/[&<>"]/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[character] ?? character);
      const formatNotificationTime = (value?: string) => value ? new Intl.DateTimeFormat('ja-JP', { dateStyle: 'medium', timeStyle: 'short' }).format(new Date(value)) : '';
      const loadAccount = async () => {
        try {
          const statusResponse = await fetch('/api/admin/auth-status', { credentials: 'same-origin', cache: 'no-store' });
          const statusType = statusResponse.headers.get('content-type') ?? '';
          if (!statusType.includes('application/json')) throw new Error('認証状態を確認できません。ページを再読み込みしてください。');
          const status = await statusResponse.json() as { email?: string; isManager?: boolean; error?: string };
          if (!statusResponse.ok || !status.email) throw new Error(status.error ?? 'ログイン情報を取得できませんでした');
          document.querySelectorAll<HTMLElement>('[data-manager-only]').forEach((item) => { item.hidden = !status.isManager; });
          if (cachedAccount?.email !== status.email) cachedAccount = null;
          if (cachedAccount) applyAccountSnapshot(cachedAccount);
          else if (email) email.title = status.email;
          try {
            const profileResponse = await fetch('/api/admin/profile', { credentials: 'same-origin', cache: 'no-store' });
            const profileType = profileResponse.headers.get('content-type') ?? '';
            if (profileResponse.ok && profileType.includes('application/json')) {
              const profile = await profileResponse.json() as { profile?: { display_name?: string; avatar_url?: string } };
              const image = profile.profile?.avatar_url;
              const snapshot = { email: status.email, displayName: profile.profile?.display_name?.trim() || '', avatarUrl: image || '' };
              cachedAccount = snapshot;
              applyAccountSnapshot(snapshot);
              writeAccountCache(snapshot);
            } else if (!cachedAccount) {
              applyAccountSnapshot({ email: status.email, displayName: '', avatarUrl: '' });
            }
          } catch {
            if (!cachedAccount) applyAccountSnapshot({ email: status.email, displayName: '', avatarUrl: '' });
          }
        } catch (error) {
          clearAccountCache();
          cachedAccount = null;
          if (email) {
            email.textContent = '読み込み失敗';
            email.title = error instanceof Error ? error.message : 'ログイン情報を取得できませんでした';
          }
          account.classList.remove('is-loading');
          account.removeAttribute('aria-busy');
          account.removeAttribute('data-account-loading');
          avatar?.classList.remove('admin-account-avatar--skeleton');
          if (avatarImage) { avatarImage.hidden = true; avatarImage.removeAttribute('src'); }
          if (avatarFallback) { avatarFallback.hidden = false; avatarFallback.textContent = '?'; }
          showAdminError(error instanceof Error ? error.message : 'ログイン情報を取得できませんでした。');
        } finally { account.hidden = false; }
      };
      document.addEventListener('atlasez-profile-updated', (event) => {
        const detail = event instanceof CustomEvent ? event.detail as { avatarUrl?: unknown } : undefined;
        // 保存直後はAPI再取得を待たず、同じタブのヘッダーへ新しい画像を反映する。
        if (cachedAccount && typeof detail?.avatarUrl === 'string') {
          cachedAccount = { ...cachedAccount, avatarUrl: detail.avatarUrl };
          writeAccountCache(cachedAccount);
          applyAccountSnapshot(cachedAccount);
        }
        void loadAccount();
      });
      const loadNotifications = async () => {
        if (!notificationList) return;
        if (notificationRetry) notificationRetry.hidden = true;
        try {
          const response = await fetch('/api/admin/notifications', { credentials: 'same-origin', cache: 'no-store' });
          const contentType = response.headers.get('content-type') ?? '';
          if (!contentType.includes('application/json')) throw new Error('通知の応答を読み取れませんでした。');
          const data = await response.json() as { notifications?: typeof notifications; error?: string };
          if (!response.ok) throw new Error(data.error ?? '通知を取得できませんでした。');
          notifications = data.notifications ?? [];
          const unreadCount = notifications.filter((item) => !item.read).length;
          if (notificationCount) { notificationCount.textContent = unreadCount > 99 ? "99+" : String(unreadCount); notificationCount.hidden = unreadCount === 0; }
          if (markAllRead) markAllRead.hidden = unreadCount === 0;
          const kindLabel = (kind: string) => ({ comment: 'コメント', review: '査読依頼', approved: '査読完了', published: '公開', task: 'ToDo' } as Record<string, string>)[kind] ?? '記事';
          notificationList.innerHTML = notifications.length ? notifications.map((item) => `<div class="admin-notification-item${item.read ? ' is-read' : ''}"><a href="${item.href}" data-astro-reload data-open-notification="${escape(item.id)}"><span class="notification-kind">${escape(kindLabel((item as any).kind))}</span><b>${escape(item.title)}</b><small>${escape(item.detail)}</small><time datetime="${escape(item.updatedAt ?? '')}">${escape(formatNotificationTime(item.updatedAt))}</time></a>${item.read ? '<span class="notification-read">確認済み</span>' : `<button type="button" data-read-notification="${escape(item.id)}">既読にする</button>`}</div>`).join('') : '<span class="admin-notification-empty">通知はありません。</span>';
        } catch (error) {
          notificationList.textContent = error instanceof Error ? error.message : '通知を取得できませんでした。';
          if (notificationRetry) notificationRetry.hidden = false;
          showAdminError(error instanceof Error ? error.message : '通知を取得できませんでした。');
        }
      };
      notificationButton?.addEventListener('click', () => {
        const open = !notificationPanel?.hidden;
        if (notificationPanel) {
          notificationPanel.hidden = open;
          if (!open) notificationPanel.scrollTop = 0;
        }
        notificationButton.setAttribute('aria-expanded', String(!open));
      });
      closeNotifications?.addEventListener('click', () => { if (notificationPanel) notificationPanel.hidden = true; notificationButton?.setAttribute('aria-expanded', 'false'); });
      menuToggle?.addEventListener('click', () => { const open = !primaryNav?.classList.contains('is-open'); primaryNav?.classList.toggle('is-open', open); menuToggle.setAttribute('aria-expanded', String(open)); });
      notificationRetry?.addEventListener('click', () => { void loadNotifications(); });
      document.addEventListener('click', (event) => {
        const target = event.target as Node;
        if (managementMenu && !managementMenu.contains(target)) closeManagementMenu();
        if (primaryNav?.classList.contains('is-open') && !primaryNav.contains(target) && target !== menuToggle) {
          primaryNav.classList.remove('is-open');
          menuToggle?.setAttribute('aria-expanded', 'false');
        }
        const navigation = (event.target as HTMLElement).closest('a[data-astro-reload]');
        if (navigation) closeManagementMenu();
      });
      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;
        closeManagementMenu();
        if (notificationPanel && !notificationPanel.hidden) { notificationPanel.hidden = true; notificationButton?.setAttribute('aria-expanded', 'false'); }
        primaryNav?.classList.remove('is-open');
        menuToggle?.setAttribute('aria-expanded', 'false');
      });
      const markRead = async (ids: string[]) => {
        if (!ids.length) return;
        const response = await fetch('/api/admin/notifications/read', { method: 'POST', credentials: 'same-origin', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ ids }) });
        if (!response.ok) throw new Error('通知を既読にできませんでした。');
        await loadNotifications();
      };
      notificationList?.addEventListener('click', (event) => {
        const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-read-notification]');
        if (button) { event.preventDefault(); void markRead([button.dataset.readNotification ?? '']).catch(() => { notificationList.textContent = '通知を既読にできませんでした'; }); }
        const link = (event.target as HTMLElement).closest<HTMLAnchorElement>('[data-open-notification]');
        if (link && !link.dataset.opened) {
          event.preventDefault();
          link.dataset.opened = 'true';
          void markRead([link.dataset.openNotification ?? '']).catch(() => undefined).finally(() => { window.location.assign(link.href); });
        }
      });
      markAllRead?.addEventListener('click', () => { void markRead(notifications.filter((item) => !item.read).map((item) => item.id)).catch(() => { if (notificationList) notificationList.textContent = '通知を既読にできませんでした'; }); });
      void loadNotifications();
      // ベルの未読件数を開き直さなくても更新できるよう、短い間隔で再確認します。
      if (notificationTimer === undefined) notificationTimer = window.setInterval(() => { void loadNotifications(); }, 60_000);
      void loadAccount();
    }
    };
    document.addEventListener('astro:page-load', initializeAdminNav);
    initializeAdminNav();
  })();
</script>
<style>
  .admin-nav{align-items:center;border-bottom:1px solid var(--border-default);box-sizing:border-box;display:flex;gap:.65rem;left:50%;min-height:4.15rem;padding:0 max(1rem,calc((100vw - 1500px)/2));position:relative;transform:translateX(-50%);width:100vw}.admin-nav-brand{align-items:center;color:var(--accent-primary);display:flex;flex:0 0 auto;font-size:1.15rem;font-weight:700;gap:.45rem;text-decoration:none}.admin-nav-brand span{border-left:1px solid var(--border-default);color:var(--text-primary);font-size:.8rem;margin-left:.1rem;padding-left:.55rem}.admin-menu-toggle{display:none}.admin-nav nav{align-items:stretch;display:flex;flex:1 1 auto;min-height:4.15rem;min-width:0}.admin-nav nav>a{align-items:center;border-bottom:3px solid transparent;color:var(--text-primary);display:flex;flex:0 0 auto;font:inherit;font-size:.84rem;padding:0 .62rem;text-decoration:none}.admin-nav nav>a[aria-current="page"],.admin-nav nav>a:hover{border-bottom-color:var(--accent-primary);color:var(--accent-primary)}.admin-management-menu{align-items:center;display:flex;position:relative}.admin-management-menu summary{align-items:center;color:var(--text-secondary);cursor:pointer;display:flex;font-size:.84rem;gap:.28rem;height:100%;list-style:none;padding:0 .6rem;white-space:nowrap}.admin-management-menu summary::-webkit-details-marker{display:none}.admin-management-menu[open] summary,.admin-management-menu summary:hover{color:var(--accent-primary)}.admin-management-menu>div{background:var(--background-primary);border:1px solid var(--border-default);box-shadow:0 .8rem 2rem #001a2c1c;display:grid;min-width:11rem;padding:.35rem;position:absolute;top:3.3rem;z-index:30}.admin-management-menu>div a{border:0!important;color:var(--text-primary);font-size:.78rem;padding:.55rem .6rem;text-decoration:none}.admin-management-menu>div a:hover,.admin-management-menu>div a[aria-current="page"]{background:var(--background-secondary);color:var(--accent-primary)}.admin-account{align-items:center;display:flex;f