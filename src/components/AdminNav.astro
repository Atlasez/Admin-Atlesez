---
import SettingsMenu from "./SettingsMenu.astro";

interface Props {
  current?: "portal" | "atlas" | "semi-platform" | "editor" | "articles" | "workspace" | "operations" | "review" | "reports" | "permissions" | "guide" | "applications" | "introductions" | "secretariat" | "co-working";
  site?: "portal" | "atlas" | "semi-platform" | "secretariat";
}
const { current: requestedCurrent, site: requestedSite } = Astro.props;
const normalizedPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const requestedProject = Astro.url.searchParams.get("project");
const operationProject = requestedProject === "secretariat" || requestedProject === "seminar-platform" ? requestedProject : "atlas";
const querySite = requestedProject === "secretariat" ? "secretariat" : requestedProject === "seminar-platform" ? "semi-platform" : "atlas";
const routeSite = normalizedPath === "/admin/portal"
  ? "portal"
  : normalizedPath === "/admin/secretariat"
    ? "secretariat"
    : normalizedPath === "/admin/semi-platform"
      ? "semi-platform"
      : normalizedPath === "/admin/operations" || normalizedPath === "/admin/co-working"
        ? operationProject === "seminar-platform" ? "semi-platform" : operationProject
        : normalizedPath === "/admin/secretariat" ? "secretariat" : normalizedPath === "/admin/semi-platform" ? "semi-platform" : querySite;
const routeCurrent = normalizedPath === "/admin/portal"
  ? "portal"
  : normalizedPath === "/admin/atlas"
    ? "atlas"
    : normalizedPath === "/admin/secretariat"
      ? "secretariat"
      : normalizedPath === "/admin/semi-platform"
        ? "semi-platform"
        : normalizedPath === "/admin/articles"
          ? "articles"
          : normalizedPath === "/admin/editor"
            ? "editor"
            : normalizedPath === "/admin/workspace"
              ? "workspace"
              : normalizedPath === "/admin/operations"
                ? "operations"
                : normalizedPath === "/admin/co-working"
                  ? "co-working"
                  : normalizedPath === "/admin/review"
                    ? "review"
                    : normalizedPath === "/admin/reports"
                      ? "reports"
                      : normalizedPath === "/admin/permissions"
                        ? "permissions"
                        : normalizedPath === "/admin/guide"
                          ? "guide"
                          : normalizedPath === "/admin/applications"
                            ? "applications"
                            : normalizedPath === "/admin/introductions"
                              ? "introductions"
                              : "atlas";
const current = requestedCurrent ?? routeCurrent;
const site = requestedSite ?? routeSite;
// UIでは短いサイトキーを保ちつつ、D1では参加者が存在する正規slugを使う。
const projectSlug = site === "secretariat" ? "secretariat" : site === "semi-platform" ? "seminar-platform" : "atlas";
const homePath = site === "portal" ? "/admin/portal/" : site === "secretariat" ? "/admin/secretariat/" : site === "semi-platform" ? "/admin/semi-platform/" : "/admin/atlas/";
const brandLabel = site === "portal" ? "Atlasezメンバー用サイト" : site === "secretariat" ? "Atlasez運営事務局" : site === "semi-platform" ? "ゼミプラットフォーム" : "学習サイト「アトラス」運営用サイト";
const pageLabel = ({
  portal: "Atlasezメンバー用サイト",
  atlas: "学習サイトHome",
  "semi-platform": "ゼミプラットフォームHome",
  secretariat: "運営事務局Home",
  editor: "記事編集",
  articles: "編集・査読",
  workspace: "マイページ",
  operations: "進捗・ToDo・日程",
  review: "査読スペース",
  reports: "問題報告・統計",
  permissions: "運営者・担当管理",
  guide: "作業の進め方",
  applications: "運営参加応募",
  introductions: "運営内自己紹介",
  "co-working": "同時作業会",
} as Record<NonNullable<Props["current"]>, string>)[current];
const projectHome = new Set<NonNullable<Props["current"]>>(["atlas", "semi-platform", "secretariat"]);
---
<header class="admin-nav" data-admin-nav data-current-site={site} data-current-slug={projectSlug} transition:persist="admin-nav">
  <a class="admin-nav-brand-logo" href={homePath} aria-label={`${brandLabel}のトップへ戻る`}><img src="/images/atlasez-logo.png" alt="" width="34" height="34" /></a>
  <div class="admin-project-switcher" data-project-switcher data-current-site={site} data-current-slug={projectSlug}>
    <button type="button" class="admin-project-switcher-button" data-project-previous aria-label="前のプロジェクト">‹</button>
    <div class="admin-project-switcher-content">
      <a class="admin-project-switcher-title" href={homePath} data-project-current-link data-admin-i18n data-admin-ja={brandLabel} data-admin-en={site === "portal" ? "Atlasez member site" : site === "secretariat" ? "Atlasez Secretariat" : site === "semi-platform" ? "Seminar platform" : "Atlas learning site operations"}>{brandLabel}</a>
      <span class="admin-project-switcher-dots" data-project-dots></span>
    </div>
    <button type="button" class="admin-project-switcher-button" data-project-next aria-label="次のプロジェクト">›</button>
  </div>
  <button type="button" class="admin-menu-toggle" data-admin-menu-toggle aria-expanded="false" aria-controls="admin-primary-nav" hidden={site === "portal"}><span aria-hidden="true">☰</span><span>メニュー</span></button>
  <nav id="admin-primary-nav" aria-label="運営用サイトメニュー" hidden={site === "portal"}>
      <a href="/admin/articles/" data-admin-site="atlas" data-admin-page="articles" aria-current={current === "articles" && site === "atlas" ? "page" : undefined}>編集・査読</a>
      <a href="/admin/operations/?project=atlas" data-admin-site="atlas" data-admin-page="operations" aria-current={current === "operations" && site === "atlas" ? "page" : undefined}>進捗・ToDo・日程</a>
      <a href="/admin/co-working/?project=atlas" data-admin-site="atlas" data-admin-page="co-working" aria-current={current === "co-working" && site === "atlas" ? "page" : undefined}>同時作業会</a>
      <a href="/admin/operations/?project=secretariat" data-admin-site="secretariat" data-admin-page="operations" aria-current={current === "operations" && site === "secretariat" ? "page" : undefined}>事務局ToDo・日程</a>
      <a href="/admin/co-working/?project=secretariat" data-admin-site="secretariat" data-admin-page="co-working" aria-current={current === "co-working" && site === "secretariat" ? "page" : undefined}>事務局の日程・交流</a>
      <a href="/admin/operations/?project=seminar-platform" data-admin-site="semi-platform" data-admin-page="operations" aria-current={current === "operations" && site === "semi-platform" ? "page" : undefined}>ゼミ運営・ToDo</a>
      <a href="/admin/co-working/?project=seminar-platform" data-admin-site="semi-platform" data-admin-page="co-working" aria-current={current === "co-working" && site === "semi-platform" ? "page" : undefined}>ゼミ日程・交流</a>
    <details class="admin-management-menu" open={(["reports", "permissions", "guide", "applications", "introductions"] as string[]).includes(current)}>
      <summary>管理 <span aria-hidden="true">⌄</span></summary>
      <div>
        <a href={`/admin/permissions/?project=${projectSlug}`} data-manager-only hidden data-admin-page="permissions" aria-current={current === "permissions" ? "page" : undefined}>運営者・担当管理</a>
        <a href={`/admin/reports/?project=${projectSlug}`} data-admin-page="reports" aria-current={current === "reports" ? "page" : undefined}>問題報告・統計</a>
        <a href={`/admin/guide/?project=${projectSlug}`} data-admin-page="guide" aria-current={current === "guide" ? "page" : undefined}>作業の進め方</a>
        <a href={`/admin/introductions/?project=${projectSlug}`} data-admin-page="introductions" aria-current={current === "introductions" ? "page" : undefined}>運営内自己紹介</a>
        <a href={`/admin/applications/?project=${projectSlug}`} data-manager-only hidden data-admin-page="applications" aria-current={current === "applications" ? "page" : undefined}>応募管理</a>
      </div>
    </details>
  </nav>
  <div class="admin-account" data-admin-account hidden>
    <SettingsMenu locale="ja" />
    <button type="button" class="admin-notifications" data-admin-notifications aria-expanded="false" aria-label="通知を開く"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M18 9a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4" /></svg><span data-admin-notification-count hidden>0</span></button>
    <div class="admin-notification-panel" data-admin-notification-panel hidden><div class="notification-panel-heading"><strong>通知</strong><button type="button" class="mark-all-read" data-mark-all-notifications-read>すべて既読</button><button type="button" data-close-notifications aria-label="通知を閉じる">×</button></div><div data-admin-notification-list><span class="admin-notification-loading">通知を確認しています…</span></div></div>
    <a class="admin-account-profile" href="/admin/workspace/" aria-label="マイページを開く">
      <span class="admin-account-avatar" data-admin-account-avatar aria-hidden="true"><img data-admin-account-image alt="" hidden /><span data-admin-account-fallback>A</span></span>
      <span class="admin-account-email" data-admin-account-email>アカウント</span>
    </a>
    <form method="post" action="/auth/logout">
      <button type="submit" class="admin-logout">ログアウト</button>
    </form>
  </div>
</header>
<nav class="admin-breadcrumbs" data-admin-breadcrumbs aria-label="パンくず" hidden={site === "portal"} transition:persist="admin-breadcrumbs"><a href="/admin/portal/">Atlasezメンバー用サイト</a><span aria-hidden="true">›</span>{projectHome.has(current) ? <span aria-current="page">{brandLabel}</span> : <><a href={homePath}>{brandLabel}</a><span aria-hidden="true">›</span><span aria-current="page">{pageLabel}</span></>}</nav>
<script>
  import { navigate } from "astro:transitions/client";

  (() => {
    const preferencesKey = 'atlasez-prefs';
    const languageKey = 'atlasez-admin-language';
    type AdminLanguage = 'ja' | 'en';
    const readPreferences = (): Record<string, string> => {
      try { return JSON.parse(localStorage.getItem(preferencesKey) ?? '{}') as Record<string, string>; } catch { return {}; }
    };
    const currentLanguage = (): AdminLanguage => {
      const preferences = readPreferences();
      return preferences.lang === 'eng' || preferences.lang === 'en' || localStorage.getItem(languageKey) === 'en' ? 'en' : 'ja';
    };
    const languageText = (element: HTMLElement, language: AdminLanguage) => element.dataset[language === 'ja' ? 'adminJa' : 'adminEn'] ?? element.textContent ?? '';
    const applyLanguage = (language: AdminLanguage) => {
      document.documentElement.lang = language;
      document.querySelectorAll<HTMLElement>('[data-admin-i18n]').forEach((element) => { element.textContent = languageText(element, language); });
      document.querySelectorAll<HTMLSelectElement>('[data-admin-language]').forEach((select) => { select.value = language; });
      document.querySelectorAll<HTMLButtonElement>('[data-project-previous]').forEach((button) => button.setAttribute('aria-label', language === 'ja' ? '前のプロジェクト' : 'Previous project'));
      document.querySelectorAll<HTMLButtonElement>('[data-project-next]').forEach((button) => button.setAttribute('aria-label', language === 'ja' ? '次のプロジェクト' : 'Next project'));
    };
    const applyTheme = (dark: boolean, persist = false) => {
      document.documentElement.dataset.prefBg = dark ? 'dark' : '';
      const preferences = readPreferences();
      if (persist) { if (dark) preferences.bg = 'dark'; else delete preferences.bg; localStorage.setItem(preferencesKey, JSON.stringify(preferences)); }
    };
    applyTheme(readPreferences().bg === 'dark');
    applyLanguage(currentLanguage());

    type RouteState = { site: 'portal' | 'atlas' | 'semi-platform' | 'secretariat'; slug: string; current: string; home: string; label: string };
    const pageLabels: Record<string, string> = { articles: '編集・査読', editor: '記事編集', workspace: 'マイページ', operations: '進捗・ToDo・日程', 'co-working': '同時作業会', reports: '問題報告・統計', permissions: '運営者・担当管理', guide: '作業の進め方', applications: '運営参加応募', introductions: '運営内自己紹介', review: '査読スペース' };
    const readRouteState = (): RouteState => {
      const path = window.location.pathname.replace(/\/$/, '') || '/';
      const project = new URLSearchParams(window.location.search).get('project');
      const site = path === '/admin/portal' ? 'portal' : project === 'secretariat' || path === '/admin/secretariat' ? 'secretariat' : project === 'seminar-platform' || path === '/admin/semi-platform' ? 'semi-platform' : 'atlas';
      const slug = site === 'secretariat' ? 'secretariat' : site === 'semi-platform' ? 'seminar-platform' : 'atlas';
      const labels: Record<RouteState['site'], string> = { portal: 'Atlasezメンバー用サイト', atlas: '学習サイト「アトラス」運営用サイト', 'semi-platform': 'ゼミプラットフォーム', secretariat: 'Atlasez運営事務局' };
      const current = path === '/admin/portal' ? 'portal' : path === '/admin/atlas' ? 'atlas' : path === '/admin/secretariat' ? 'secretariat' : path === '/admin/semi-platform' ? 'semi-platform' : path.slice('/admin/'.length) || 'atlas';
      return { site, slug, current, home: site === 'portal' ? '/admin/portal/' : site === 'secretariat' ? '/admin/secretariat/' : site === 'semi-platform' ? '/admin/semi-platform/' : '/admin/atlas/', label: labels[site] };
    };
    const syncRouteChrome = () => {
      const state = readRouteState();
      const nav = document.querySelector<HTMLElement>('[data-admin-nav]');
      const primaryNav = document.querySelector<HTMLElement>('#admin-primary-nav');
      const menuToggle = document.querySelector<HTMLButtonElement>('[data-admin-menu-toggle]');
      const breadcrumbs = document.querySelector<HTMLElement>('[data-admin-breadcrumbs]');
      const title = document.querySelector<HTMLAnchorElement>('[data-project-current-link]');
      const switcher = document.querySelector<HTMLElement>('[data-project-switcher]');
      nav?.setAttribute('data-current-site', state.site);
      nav?.setAttribute('data-current-slug', state.slug);
      switcher?.setAttribute('data-current-site', state.site);
      switcher?.setAttribute('data-current-slug', state.slug);
      if (primaryNav) primaryNav.hidden = state.site === 'portal';
      if (menuToggle) { menuToggle.hidden = state.site === 'portal'; menuToggle.setAttribute('aria-expanded', 'false'); }
      primaryNav?.classList.remove('is-open');
      document.querySelectorAll<HTMLElement>('[data-admin-site]').forEach((link) => { link.hidden = link.dataset.adminSite !== state.site; });
      document.querySelectorAll<HTMLElement>('[data-admin-page]').forEach((link) => { link.setAttribute('aria-current', link.dataset.adminPage === state.current && link.closest('[data-admin-site]')?.getAttribute('data-admin-site') === state.site ? 'page' : 'false'); });
      document.querySelectorAll<HTMLDetailsElement>('.admin-management-menu').forEach((menu) => { menu.open = ['reports', 'permissions', 'guide', 'applications', 'introductions'].includes(state.current); });
      if (title) { title.href = state.home; title.dataset.adminJa = state.label; title.textContent = currentLanguage() === 'ja' ? state.label : state.site === 'portal' ? 'Atlasez member site' : state.site === 'secretariat' ? 'Atlasez Secretariat' : state.site === 'semi-platform' ? 'Seminar platform' : 'Atlas learning site operations'; }
      const logo = document.querySelector<HTMLAnchorElement>('.admin-nav-brand-logo');
      if (logo) logo.href = state.home;
      if (breadcrumbs) {
        breadcrumbs.hidden = state.site === 'portal';
        breadcrumbs.innerHTML = state.site === 'portal' ? '' : `<a href="/admin/portal/">Atlasezメンバー用サイト</a><span aria-hidden="true">›</span><a href="${state.home}">${state.label}</a>${['atlas', 'semi-platform', 'secretariat'].includes(state.current) ? '' : `<span aria-hidden="true">›</span><span aria-current="page">${pageLabels[state.current] ?? state.current}</span>`}`;
      }
    };
    syncRouteChrome();
    window.addEventListener('atlasez-lang-change', () => { applyLanguage(currentLanguage()); syncRouteChrome(); });
    document.addEventListener('astro:after-swap', () => { applyTheme(readPreferences().bg === 'dark'); applyLanguage(currentLanguage()); syncRouteChrome(); });

    const switcher = document.querySelector<HTMLElement>('[data-project-switcher]');
    if (switcher) {
      type ProjectSlide = { key: string; label: string; href: string };
      const initialSite = switcher.dataset.currentSite ?? 'portal';
      const initialSlug = switcher.dataset.currentSlug ?? 'atlas';
      const slides: ProjectSlide[] = [
        { key: 'portal', label: 'Atlasezメンバー用サイト', href: '/admin/portal/' },
        { key: 'atlas', label: '学習サイト「アトラス」運営用サイト', href: '/admin/atlas/' },
        { key: 'semi-platform', label: 'ゼミプラットフォーム', href: '/admin/semi-platform/' },
        { key: 'secretariat', label: 'Atlasez運営事務局', href: '/admin/secretariat/' },
      ];
      const appendMemberProjects = async () => {
        try {
          const response = await fetch('/api/admin/portal', { credentials: 'same-origin', cache: 'no-store' });
          if (!response.ok) return;
          const data = await response.json() as { projects?: Array<{ slug: string; name: string; description?: string }> };
          for (const project of data.projects ?? []) {
            if (!project.slug || project.slug === 'seminar-platform' || slides.some((slide) => slide.key === project.slug)) continue;
            slides.push({ key: project.slug, label: project.name, href: `/admin/portal/?project=${encodeURIComponent(project.slug)}` });
          }
        } catch { /* 未ログイン時は既定の3つだけ表示します。 */ }
      };
      const title = switcher.querySelector<HTMLAnchorElement>('[data-project-current-link]');
      const dots = switcher.querySelector<HTMLElement>('[data-project-dots]');
      const escapeHtml = (value: string) => value.replace(/[&<>"']/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[character] ?? character);
      const initialKey = initialSite === 'portal' ? 'portal' : initialSite === 'semi-platform' ? 'semi-platform' : initialSlug;
      let index = Math.max(0, slides.findIndex((slide) => slide.key === initialKey));
      const renderSwitcher = (animate = false) => {
        const slide = slides[index];
        if (!slide || !title || !dots) return;
        if (animate) { switcher.classList.remove('is-changing'); requestAnimationFrame(() => switcher.classList.add('is-changing')); }
        const language = currentLanguage();
        title.href = slide.href;
        title.textContent = slide.key === 'portal' ? (language === 'ja' ? slide.label : 'Atlasez member site') : slide.key === 'atlas' ? (language === 'ja' ? slide.label : 'Atlas learning site operations') : slide.key === 'semi-platform' ? (language === 'ja' ? slide.label : 'Seminar platform') : slide.key === 'secretariat' ? (language === 'ja' ? slide.label : 'Atlasez Secretariat') : slide.label;
        title.setAttribute('aria-label', language === 'ja' ? `${title.textContent}へ移動` : `Open ${title.textContent}`);
        dots.innerHTML = slides.map((item, itemIndex) => `<a class="admin-project-dot${itemIndex === index ? ' is-active' : ''}" href="${escapeHtml(item.href)}" data-project-index="${itemIndex}" aria-label="${escapeHtml(language === 'ja' ? `${item.label}へ移動` : `Open ${item.label}`)}" aria-current="${itemIndex === index ? 'true' : 'false'}"></a>`).join('');
      };
      const navigateSlide = (nextIndex: number) => { index = (nextIndex + slides.length) % slides.length; const slide = slides[index]; if (slide) void navigate(slide.href); };
      switcher.querySelector<HTMLButtonElement>('[data-project-previous]')?.addEventListener('click', () => navigateSlide(index - 1));
      switcher.querySelector<HTMLButtonElement>('[data-project-next]')?.addEventListener('click', () => navigateSlide(index + 1));
      document.addEventListener('atlasez-admin-language-change', () => renderSwitcher());
      document.addEventListener('astro:after-swap', () => {
        const state = readRouteState();
        const key = state.site === 'portal' ? 'portal' : state.slug;
        const nextIndex = slides.findIndex((slide) => slide.key === key);
        if (nextIndex >= 0) index = nextIndex;
        renderSwitcher();
      });
      renderSwitcher();
      void appendMemberProjects().then(() => renderSwitcher());
    }
    const account = document.querySelector<HTMLElement>('[data-admin-account]');
    if (account && account.dataset.loaded !== 'true') {
      account.dataset.loaded = 'true';
      const email = account.querySelector<HTMLElement>('[data-admin-account-email]');
      const avatar = account.querySelector<HTMLElement>('[data-admin-account-avatar]');
      const avatarImage = account.querySelector<HTMLImageElement>('[data-admin-account-image]');
      const avatarFallback = account.querySelector<HTMLElement>('[data-admin-account-fallback]');
      const notificationButton = document.querySelector<HTMLButtonElement>('[data-admin-notifications]');
      const notificationPanel = document.querySelector<HTMLElement>('[data-admin-notification-panel]');
      const notificationList = document.querySelector<HTMLElement>('[data-admin-notification-list]');
      const notificationCount = document.querySelector<HTMLElement>('[data-admin-notification-count]');
      const closeNotifications = document.querySelector<HTMLButtonElement>('[data-close-notifications]');
      const markAllRead = document.querySelector<HTMLButtonElement>('[data-mark-all-notifications-read]');
      const menuToggle = document.querySelector<HTMLButtonElement>('[data-admin-menu-toggle]');
      const primaryNav = document.querySelector<HTMLElement>('#admin-primary-nav');
      let notifications: Array<{ id: string; title: string; detail: string; href: string; kind?: string; updatedAt?: string; read?: boolean }> = [];
      const escape = (value: string) => value.replace(/[&<>"]/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[character] ?? character);
      const formatNotificationTime = (value?: string) => value ? new Intl.DateTimeFormat('ja-JP', { dateStyle: 'medium', timeStyle: 'short' }).format(new Date(value)) : '';
      const profileCacheKey = 'atlasez-admin-profile-cache';
      type CachedProfile = { email?: string; display_name?: string; avatar_url?: string };
      const readCachedProfile = (): CachedProfile | null => {
        try {
          const cached = sessionStorage.getItem(profileCacheKey);
          return cached ? JSON.parse(cached) as CachedProfile : null;
        } catch { return null; }
      };
      const applyProfile = (profile: CachedProfile, fallbackEmail = '') => {
        const image = profile.avatar_url?.trim() ?? '';
        if (avatar) { avatar.style.backgroundImage = ''; avatar.classList.toggle('has-image', Boolean(image)); }
        if (avatarFallback) { avatarFallback.hidden = Boolean(image); avatarFallback.textContent = (fallbackEmail[0] ?? 'A').toUpperCase(); }
        if (avatarImage) {
          avatarImage.hidden = !image;
          avatarImage.onerror = () => { avatarImage.hidden = true; avatarImage.removeAttribute('src'); if (avatarFallback) avatarFallback.hidden = false; };
          if (image) avatarImage.src = image; else avatarImage.removeAttribute('src');
        }
        if (email) email.textContent = profile.display_name?.trim() || 'アカウント';
      };
      const cachedProfile = readCachedProfile();
      if (cachedProfile) applyProfile(cachedProfile);
      const loadAccount = async () => {
        try {
          const statusResponse = await fetch('/api/admin/auth-status', { credentials: 'same-origin', cache: 'no-store' });
          const statusType = statusResponse.headers.get('content-type') ?? '';
          if (!statusType.includes('application/json')) throw new Error('認証状態を確認できません。ページを再読み込みしてください。');
          const status = await statusResponse.json() as { email?: string; isManager?: boolean; error?: string };
          if (!statusResponse.ok || !status.email) throw new Error(status.error ?? 'ログイン情報を取得できませんでした');
          document.querySelectorAll<HTMLElement>('[data-manager-only]').forEach((item) => { item.hidden = !status.isManager; });
          if (email) { email.title = status.email; }
          const cachedForAccount = cachedProfile?.email === status.email ? cachedProfile : null;
          if (cachedProfile && !cachedForAccount) {
            try { sessionStorage.removeItem(profileCacheKey); } catch { /* storage may be unavailable */ }
            applyProfile({}, status.email);
          } else if (!cachedProfile) applyProfile({}, status.email);
          try {
            const profileResponse = await fetch('/api/admin/profile', { credentials: 'same-origin', cache: 'no-store' });
            if (profileResponse.ok) {
              const profile = await profileResponse.json() as { profile?: { display_name?: string; avatar_url?: string } };
              const nextProfile = { ...(profile.profile ?? {}), email: status.email };
              applyProfile(nextProfile, status.email);
              try { sessionStorage.setItem(profileCacheKey, JSON.stringify(nextProfile)); } catch { /* storage may be unavailable */ }
            }
          } catch { /* アカウント表示はメールアドレスだけでも利用できます */ }
        } catch (error) {
          if (email) {
            if (!cachedProfile?.display_name) email.textContent = 'アカウント';
            email.title = error instanceof Error ? error.message : 'ログイン情報を取得できませんでした';
          }
        } finally { account.hidden = false; }
      };
      document.addEventListener('atlasez-profile-updated', () => { void loadAccount(); });
      const loadNotifications = async () => {
        if (!notificationList) return;
        try {
          const response = await fetch('/api/admin/notifications', { credentials: 'same-origin', cache: 'no-store' });
          const data = await response.json() as { notifications?: typeof notifications };
          notifications = data.notifications ?? [];
          const unreadCount = notifications.filter((item) => !item.read).length;
          if (notificationCount) { notificationCount.textContent = unreadCount > 99 ? "99+" : String(unreadCount); notificationCount.hidden = unreadCount === 0; }
          if (markAllRead) markAllRead.hidden = unreadCount === 0;
          const kindLabel = (kind: string) => ({ comment: 'コメント', review: '査読依頼', approved: '査読完了', published: '公開' } as Record<string, string>)[kind] ?? '記事';
          const unreadNotifications = notifications.filter((item) => !item.read);
          notificationList.innerHTML = unreadNotifications.length ? unreadNotifications.map((item) => `<div class="admin-notification-item"><a href="${item.href}" data-open-notification="${escape(item.id)}"><span class="notification-kind">${escape(kindLabel((item as any).kind))}</span><b>${escape(item.title)}</b><small>${escape(item.detail)}</small><time datetime="${escape(item.updatedAt ?? '')}">${escape(formatNotificationTime(item.updatedAt))}</time></a><button type="button" data-read-notification="${escape(item.id)}">既読にする</button></div>`).join('') : '<span class="admin-notification-empty">あなたの記事に関する新しい通知はありません。</span>';
        } catch { notificationList.textContent = '通知を取得できませんでした'; }
      };
      notificationButton?.addEventListener('click', () => { const open = !notificationPanel?.hidden; if (notificationPanel) notificationPanel.hidden = open; notificationButton.setAttribute('aria-expanded', String(!open)); });
      closeNotifications?.addEventListener('click', () => { if (notificationPanel) notificationPanel.hidden = true; notificationButton?.setAttribute('aria-expanded', 'false'); });
      menuToggle?.addEventListener('click', () => { const open = !primaryNav?.classList.contains('is-open'); primaryNav?.classList.toggle('is-open', open); menuToggle.setAttribute('aria-expanded', String(open)); });
      const markRead = async (ids: string[]) => {
        if (!ids.length) return;
        const response = await fetch('/api/admin/notifications/read', { method: 'POST', credentials: 'same-origin', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ ids }) });
        if (!response.ok) throw new Error('通知を既読にできませんでした。');
        await loadNotifications();
      };
      notificationList?.addEventListener('click', (event) => {
        const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-read-notification]');
        if (button) { event.preventDefault(); void markRead([button.dataset.readNotification ?? '']).catch(() => { notificationList.textContent = '通知を既読にできませんでした'; }); }
        const link = (event.target as HTMLElement).closest<HTMLAnchorElement>('[data-open-notification]');
        if (link && !link.dataset.opened) {
          event.preventDefault();
          link.dataset.opened = 'true';
          void markRead([link.dataset.openNotification ?? '']).catch(() => undefined).finally(() => { void navigate(link.href); });
        }
      });
      markAllRead?.addEventListener('click', () => { void markRead(notifications.filter((item) => !item.read).map((item) => item.id)).catch(() => { if (notificationList) notificationList.textContent = '通知を既読にできませんでした'; }); });
      void loadNotifications();
      // ベルの未読件数を開き直さなくても更新できるよう、短い間隔で再確認します。
      window.setInterval(() => { void loadNotifications(); }, 60_000);
      void loadAccount();
    }
  })();
</script>
