---
/** 未記録・読んだ・理解したを1本の3段階スライダーで記録する。 */
import { t, type Locale } from "../lib/i18n";
import { HISTORY_STAGES } from "../lib/history";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<div
  class="history-group"
  role="group"
  aria-label={t(locale, "learningRecord")}
>
  <div
    class="history-stage-control"
    data-history-stage-control
    data-state="none"
  >
    <button
      type="button"
      class="history-stage-toggle"
      data-history-stage-toggle
      data-state="none"
      data-label-none={t(locale, "stateUnrecorded")}
      data-label-read={t(locale, "markRead")}
      data-label-understood={t(locale, "markUnderstood")}
      role="slider"
      aria-label={t(locale, "learningRecord")}
      aria-valuemin="0"
      aria-valuemax={HISTORY_STAGES.length}
      aria-valuenow="0"
      aria-valuetext={t(locale, "stateUnrecorded")}
    >
      <span class="history-stage-track" aria-hidden="true">
        <span class="history-stage-position" />
        <span class="history-stage-position" />
        <span class="history-stage-position" />
        <span class="history-stage-thumb" />
      </span>
    </button>
    <span class="history-stage-labels" aria-hidden="true">
      <span>{t(locale, "stateUnrecorded")}</span>
      {HISTORY_STAGES.map((stage) => <span>{t(locale, stage.labelKey)}</span>)}
    </span>
  </div>
</div>

<style>
  .history-group {
    display: inline-flex;
    flex-direction: column;
    align-items: stretch;
  }
  .history-stage-control {
    width: 7.5rem;
  }
  .history-stage-toggle {
    display: block;
    width: 100%;
    height: 1.9rem;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--text-secondary);
    font: inherit;
    cursor: pointer;
    touch-action: manipulation;
  }
  .history-stage-toggle:hover .history-stage-track {
    border-color: var(--accent-primary);
  }
  .history-stage-toggle:focus-visible {
    outline: 3px solid var(--focus-ring);
    outline-offset: 2px;
  }
  .history-stage-track {
    --history-thumb-size: 1.15rem;
    --history-thumb-inset: 0.18rem;
    --history-edge-center: calc(
      var(--history-thumb-inset) + var(--history-thumb-size) / 2
    );
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: var(--background-secondary);
    transition:
      border-color 0.05s linear,
      background-color 0.05s linear;
  }
  .history-stage-position {
    position: absolute;
    top: 50%;
    width: 0.28rem;
    height: 0.28rem;
    border-radius: 50%;
    background: var(--text-secondary);
    opacity: 0.38;
    transform: translate(-50%, -50%);
  }
  .history-stage-position:nth-child(1) {
    left: var(--history-edge-center);
  }
  .history-stage-position:nth-child(2) {
    left: 50%;
  }
  .history-stage-position:nth-child(3) {
    left: calc(100% - var(--history-edge-center));
  }
  .history-stage-thumb {
    position: absolute;
    z-index: 1;
    top: 50%;
    left: var(--history-thumb-inset);
    width: var(--history-thumb-size);
    height: var(--history-thumb-size);
    border: 1px solid color-mix(in srgb, var(--text-primary) 18%, transparent);
    border-radius: 50%;
    background: var(--background-primary);
    box-shadow: 0 1px 3px color-mix(in srgb, var(--text-primary) 24%, transparent);
    transform: translateY(-50%);
    /* 青い塗りつぶしと同じタイミングでレバーを移動させる。 */
    transition: left 0.05s linear;
  }
  .history-stage-toggle[data-state="read"] .history-stage-track {
    border-color: var(--accent-primary);
    background: linear-gradient(
      to right,
      var(--accent-primary) 0 50%,
      var(--background-secondary) 50% 100%
    );
  }
  .history-stage-toggle[data-state="understood"] .history-stage-track {
    border-color: var(--accent-primary);
    background: var(--accent-primary);
  }
  .history-stage-toggle[data-state="read"]
    .history-stage-position:nth-child(-n + 2),
  .history-stage-toggle[data-state="understood"] .history-stage-position {
    background: var(--on-accent);
    opacity: 1;
  }
  .history-stage-toggle[data-state="read"] .history-stage-thumb {
    left: calc(50% - var(--history-thumb-size) / 2);
  }
  .history-stage-toggle[data-state="understood"] .history-stage-thumb {
    left: calc(
      100% - var(--history-thumb-size) - var(--history-thumb-inset)
    );
  }
  .history-stage-labels {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.1rem;
    margin-top: 0.18rem;
    font-size: calc(0.61rem * var(--text-scale));
    line-height: 1.25;
    text-align: center;
  }
  .history-stage-control[data-state="none"]
    .history-stage-labels
    > :nth-child(1),
  .history-stage-control[data-state="read"]
    .history-stage-labels
    > :nth-child(2),
  .history-stage-control[data-state="understood"]
    .history-stage-labels
    > :nth-child(3) {
    color: var(--accent-primary);
    font-weight: 700;
  }
  @media (max-width: 767px) {
    .history-group {
      width: min(7.5rem, 100%);
    }
    .history-stage-control {
      width: 100%;
    }
  }
</style>
