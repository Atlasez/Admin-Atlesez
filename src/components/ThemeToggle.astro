---
interface Props { locale?: "ja" | "en" }
const { locale = "ja" } = Astro.props;
---

<button
  type="button"
  class="theme-toggle"
  data-theme-toggle
  aria-pressed="false"
  aria-label={locale === "ja" ? "ダークモードに切り替える" : "Switch to dark mode"}
>
  <span data-theme-label>{locale === "ja" ? "ダーク表示" : "Dark mode"}</span>
</button>

<script>
  const root = document.documentElement;
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]");

  function updateThemeButtons(): void {
    const mode = root.dataset.prefMode === "black"
      ? "black"
      : root.dataset.prefBg === "dark" ? "dark" : "default";
    buttons.forEach((button) => {
      const label = button.querySelector<HTMLElement>("[data-theme-label]");
      button.dataset.themeMode = mode;
      button.setAttribute("aria-pressed", String(mode !== "default"));
      button.setAttribute(
        "aria-label",
        document.documentElement.lang === "ja"
          ? mode === "default" ? "ダークモードに切り替える" : mode === "dark" ? "ブラックモードに切り替える" : "ライトモードに切り替える"
          : mode === "default" ? "Switch to dark mode" : mode === "dark" ? "Switch to black mode" : "Switch to light mode",
      );
      if (label) label.textContent = document.documentElement.lang === "ja"
        ? mode === "default" ? "ダーク表示" : mode === "dark" ? "ブラック表示" : "ライト表示"
        : mode === "default" ? "Dark mode" : mode === "dark" ? "Black mode" : "Light mode";
    });
  }

  buttons.forEach((button) => button.addEventListener("click", () => {
    let prefs: Record<string, string> = {};
    try { prefs = JSON.parse(localStorage.getItem("atlasez-prefs") ?? "{}"); } catch { /* ignore */ }
    const current = root.dataset.prefMode === "black"
      ? "black"
      : root.dataset.prefBg === "dark" ? "dark" : "default";
    const next = current === "default" ? "dark" : current === "dark" ? "black" : "default";
    if (next === "default") {
      delete root.dataset.prefBg;
      delete root.dataset.prefMode;
      delete prefs.bg;
    } else if (next === "black") {
      root.dataset.prefBg = "dark";
      root.dataset.prefMode = "black";
      prefs.bg = "black";
    } else {
      root.dataset.prefBg = "dark";
      delete root.dataset.prefMode;
      prefs.bg = "dark";
    }
    localStorage.setItem("atlasez-prefs", JSON.stringify(prefs));
    updateThemeButtons();
    window.dispatchEvent(new CustomEvent("atlasez-theme-change"));
    window.dispatchEvent(new CustomEvent("atlas-theme-change"));
  }));
  updateThemeButtons();
  window.addEventListener("storage", updateThemeButtons);
  window.addEventListener("atlasez-theme-change", updateThemeButtons);
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--touch-target);
    padding: 0 var(--space-2);
    border: 1px solid var(--border-default);
    border-radius: var(--radius);
    color: var(--text-primary);
    background: var(--background-primary);
    font: inherit;
    font-size: calc(0.85rem * var(--text-scale));
    cursor: pointer;
  }
  .theme-toggle:hover { border-color: var(--accent-primary); color: var(--accent-primary); }
</style>
