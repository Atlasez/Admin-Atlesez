---
/**
 * 記事の難易度と推定学習時間のバッジ。
 *
 * どちらも記事frontmatterの必須項目で全記事に入っている。読者が一覧で最初に
 * 知りたいのは「自分に読めるか」「どれくらいかかるか」なので、記事ページと
 * 一覧の両方で同じ見た目にする。
 *
 * 難易度は色だけで区別しない（WCAG 1.4.1）。ラベル文字列そのものが情報を持ち、
 * 色は補助にとどめる。
 */
import { t, difficultyLabel, type Locale } from "../lib/i18n";

interface Props {
  locale: Locale;
  difficulty: string;
  estimatedMinutes: number;
}

const { locale, difficulty, estimatedMinutes } = Astro.props;
---

<span class:list={["badge", "badge-difficulty", `difficulty-${difficulty}`]}>
  {t(locale, "difficulty")}: {difficultyLabel(locale, difficulty)}
</span>
<span class="badge">
  {t(locale, "estimatedMinutes")}: {estimatedMinutes}{t(locale, "minutes")}
</span>

<style>
  /* 色は補助。文字だけでも難易度が分かるようにしてある */
  .badge-difficulty {
    border-left: 3px solid var(--border-default);
  }
  .difficulty-introductory {
    border-left-color: var(--accent-primary);
  }
  .difficulty-basic {
    border-left-color: var(--accent-primary);
  }
  .difficulty-intermediate {
    border-left-color: var(--text-secondary);
  }
  .difficulty-advanced {
    border-left-color: var(--text-primary);
  }
</style>
