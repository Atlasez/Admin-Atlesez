---
/**
 * ヘッダーの「表示設定」。
 *
 * ダーク表示の切り替えと、文字サイズ・行間・フォント・コントラストの設定を
 * 1 つのボタンにまとめる。押すと両方が同時に開く（中では折りたたまない）。
 * 見た目に関する操作をここだけで完結させるためのもの。
 */
import A11ySettings from "./A11ySettings.astro";

interface Props {
  locale?: "ja" | "en";
}
const { locale = "ja" } = Astro.props;
const title = locale === "ja" ? "表示設定" : "Display settings";
const close = locale === "ja" ? "閉じる" : "Close";
---

<details class="settings-menu" data-settings-menu>
  <summary>
    <span class="settings-text">{title}</span>
  </summary>
  <div class="settings-panel">
    {/*
      明暗の切り替えは A11ySettings の「背景」（白／低刺激色／暗色）と
      重なるので置かない。設定の入口をひとつに絞る。
    */}
    <A11ySettings locale={locale} bare />
    <button type="button" class="settings-close" data-settings-close>
      {close}
    </button>
  </div>
</details>

<style>
  .settings-menu {
    position: relative;
    z-index: 210;
    border: 0;
    border-radius: 0;
  }
  .settings-menu > summary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: var(--touch-target);
    padding: 0 var(--space-2);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--background-primary);
    color: var(--text-primary);
    font-size: calc(0.9rem * var(--text-scale));
    cursor: pointer;
    list-style: none;
    white-space: nowrap;
  }
  .settings-menu > summary::-webkit-details-marker {
    display: none;
  }
  .settings-menu > summary::before {
    content: "Aa";
    color: var(--accent-primary);
    font-size: calc(1.05rem * var(--text-scale));
    font-weight: 700;
    letter-spacing: -0.04em;
  }
  .settings-menu > summary::after {
    content: "";
    width: 0;
    height: 0;
    margin-left: 2px;
    border-inline: 0.32rem solid transparent;
    border-top: 0.46rem solid currentColor;
  }
  .settings-menu[open] > summary::after {
    transform: rotate(180deg);
  }
  .settings-menu > summary:hover {
    border-color: var(--accent-primary);
    color: var(--accent-primary);
  }
  .settings-panel {
    position: absolute;
    right: 0;
    z-index: 220;
    width: 18rem;
    max-width: min(20rem, calc(100vw - 2 * var(--space-3)));
    margin-top: var(--space-1);
    padding: var(--space-3);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--background-primary);
    box-shadow: 0 6px 24px rgb(0 0 0 / 18%);
  }
  .settings-close {
    display: none;
  }

  /*
   * スマホでは吹き出しが画面からはみ出すので、画面下から出るシートにする。
   * 指の届きやすい下側に置き、閉じるボタンを明示する。
   */
  @media (max-width: 767px) {
    .settings-menu[open] > summary {
      border-color: var(--accent-primary);
      color: var(--accent-primary);
    }
    .settings-panel {
      position: fixed;
      inset: auto 0 0 0;
      width: auto;
      max-width: none;
      margin: 0;
      max-height: 80vh;
      overflow-y: auto;
      border-width: 1px 0 0;
      border-radius: var(--radius) var(--radius) 0 0;
      /* 画面下から出るシート。余白を詰めて 1 画面に収める */
      padding: var(--space-2);
      padding-bottom: max(var(--space-2), env(safe-area-inset-bottom));
      box-shadow: 0 -8px 24px rgb(0 0 0 / 22%);
    }
    .settings-close {
      display: block;
      width: 100%;
      min-height: 2.25rem;
      margin-top: var(--space-1);
      border: 1px solid var(--accent-primary);
      border-radius: var(--radius);
      background: var(--accent-primary);
      color: var(--on-accent);
      font: inherit;
      font-size: calc(0.85rem * var(--text-scale));
      font-weight: 700;
      cursor: pointer;
    }
  }
</style>

<script>
  // 外側を押す・Escape・「閉じる」で閉じる
  const menu = document.querySelector<HTMLDetailsElement>("[data-settings-menu]");
  if (menu) {
    const summary = menu.querySelector("summary");

    const close = (refocus = false) => {
      if (!menu.open) return;
      menu.open = false;
      if (refocus) summary?.focus();
    };

    document.addEventListener("click", (event) => {
      if (!menu.open) return;
      if (!(event.target instanceof Node)) return;
      if (!menu.contains(event.target)) close();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") close(true);
    });

    menu
      .querySelector("[data-settings-close]")
      ?.addEventListener("click", () => close(true));
  }
</script>
