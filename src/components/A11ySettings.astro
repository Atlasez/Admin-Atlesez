---
import { UI_LANGUAGES, UI_LANGUAGE_NAMES } from "../lib/ui-locales";
/** 表示設定パネル。localStorageに保存し、BaseHeadのinlineスクリプトが復元する */
interface Props {
  locale?: "ja" | "en";
  /**
   * true のとき <details> の外枠を付けず、設定フォームだけを描画する。
   * ヘッダーの「表示設定」ポップオーバー（SettingsMenu）から使う。
   */
  bare?: boolean;
}
const { locale = "ja", bare = false } = Astro.props;
const L =
  locale === "ja"
    ? {
        title: "表示設定",
        fontSize: "文字サイズ",
        std: "標準",
        large: "大",
        xlarge: "特大",
        contrast: "コントラスト",
        high: "高",
        bg: "背景",
        white: "白",
        soft: "低刺激色",
        dark: "暗色",
        lineHeight: "行間",
        wide: "広い",
        motion: "アニメーション",
        reduced: "軽減",
        font: "フォント",
        gothic: "標準ゴシック",
        readable: "可読性重視",
        reset: "初期設定に戻す",
      }
    : {
        title: "Display settings",
        fontSize: "Text size",
        std: "Default",
        large: "Large",
        xlarge: "X-Large",
        contrast: "Contrast",
        high: "High",
        bg: "Background",
        white: "White",
        soft: "Soft",
        dark: "Dark",
        lineHeight: "Line height",
        wide: "Wide",
        motion: "Animation",
        reduced: "Reduced",
        font: "Font",
        gothic: "Default",
        readable: "Readable",
        reset: "Reset to defaults",
      };

const groups = [
  {
    // 記事本文ではなく画面まわりの表示言語。切り替えても URL は変わらない。
    key: "lang",
    label: locale === "ja" ? "言語" : "Language",
    options: UI_LANGUAGES.map((code) => ({
      value: code,
      label: UI_LANGUAGE_NAMES[code],
    })),
  },
  {
    key: "fontSize",
    label: L.fontSize,
    options: [
      { value: "default", label: L.std },
      { value: "large", label: L.large },
      { value: "xlarge", label: L.xlarge },
    ],
  },
  {
    key: "contrast",
    label: L.contrast,
    options: [
      { value: "default", label: L.std },
      { value: "high", label: L.high },
    ],
  },
  {
    key: "bg",
    label: L.bg,
    options: [
      { value: "default", label: L.white },
      { value: "soft", label: L.soft },
      { value: "dark", label: L.dark },
    ],
  },
  {
    key: "lineHeight",
    label: L.lineHeight,
    options: [
      { value: "default", label: L.std },
      { value: "wide", label: L.wide },
    ],
  },
  {
    key: "motion",
    label: L.motion,
    options: [
      { value: "default", label: L.std },
      { value: "reduced", label: L.reduced },
    ],
  },
  {
    key: "font",
    label: L.font,
    options: [
      { value: "default", label: L.gothic },
      { value: "readable", label: L.readable },
    ],
  },
];
---

{
  bare ? (
    <form class="a11y-form" data-a11y-form>
      {groups.map((g) => (
        <fieldset>
          <legend>{g.label}</legend>
          <div class="a11y-options">
            {g.options.map((o, i) => (
              <label class="a11y-option">
                <input
                  type="radio"
                  name={g.key}
                  value={o.value}
                  checked={i === 0}
                />
                <span>{o.label}</span>
              </label>
            ))}
          </div>
        </fieldset>
      ))}
      <button type="button" class="button button-secondary" data-a11y-reset>
        {L.reset}
      </button>
    </form>
  ) : (
    <details class="a11y-settings">
      <summary>{L.title}</summary>
      <form class="details-body" data-a11y-form>
        {groups.map((g) => (
          <fieldset>
            <legend>{g.label}</legend>
            <div class="a11y-options">
              {g.options.map((o, i) => (
                <label class="a11y-option">
                  <input
                    type="radio"
                    name={g.key}
                    value={o.value}
                    checked={i === 0}
                  />
                  <span>{o.label}</span>
                </label>
              ))}
            </div>
          </fieldset>
        ))}
        <button type="button" class="button button-secondary" data-a11y-reset>
          {L.reset}
        </button>
      </form>
    </details>
  )
}

<style>
  .a11y-settings {
    font-size: calc(0.9rem * var(--text-scale));
    background: var(--background-primary);
  }
  .a11y-settings summary::before {
    content: "Aa ";
    font-weight: 700;
    color: var(--accent-primary);
    margin-right: var(--space-1);
  }
  fieldset {
    border: 0;
    padding: 0;
    margin: 0 0 var(--space-2);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    align-items: center;
  }
  legend {
    font-weight: 600;
    padding: 0;
    margin-bottom: var(--space-1);
  }
  .a11y-option {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-weight: 400;
    min-height: var(--touch-target);
  }
  .a11y-option input {
    min-height: auto;
    width: 1.1rem;
    height: 1.1rem;
  }

  /*
   * スマホでは項目数（6グループ）に対して縦が伸びすぎるので詰める。
   * 選択肢の高さは 44px から 36px に落とすが、WCAG 2.5.8 の下限 24px は
   * 十分に上回るので操作性は保たれる。
   */
  @media (max-width: 767px) {
    .a11y-settings,
    .a11y-form {
      font-size: calc(0.85rem * var(--text-scale));
    }
    fieldset {
      display: block;
      margin-bottom: var(--space-2);
    }
    legend {
      margin-bottom: var(--space-1);
      font-size: calc(0.8rem * var(--text-scale));
      color: var(--text-secondary);
    }
    /*
     * 指で押す前提の並べ方。小さな丸を狙わせず、選択肢そのものを
     * 押せる面（チップ）にして横に3つずつ並べる。
     */
    .a11y-options {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-1);
    }
    .a11y-option {
      justify-content: center;
      gap: 4px;
      min-height: var(--touch-target);
      padding: 0 var(--space-1);
      border: 1px solid var(--border-strong);
      border-radius: var(--radius);
      text-align: center;
      line-height: 1.25;
    }
    /* 選ばれている面をはっきり示す */
    .a11y-option:has(input:checked) {
      border-color: var(--accent-primary);
      background: var(--accent-subtle);
      color: var(--accent-primary);
      font-weight: 700;
    }
    .a11y-option input {
      width: 0.9rem;
      height: 0.9rem;
      flex: 0 0 auto;
    }
    /* 選択肢が2つの組は2列にして横幅を稼ぐ */
    .a11y-options:has(> :nth-child(2):last-child) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>

<script>
  const KEY = "atlasez-prefs";
  const ATTRS: Record<string, string> = {
    fontSize: "data-pref-font-size",
    contrast: "data-pref-contrast",
    bg: "data-pref-bg",
    lineHeight: "data-pref-line-height",
    motion: "data-pref-motion",
    font: "data-pref-font",
  };

  function loadPrefs(): Record<string, string> {
    try {
      return JSON.parse(localStorage.getItem(KEY) ?? "{}");
    } catch {
      return {};
    }
  }

  function apply(prefs: Record<string, string>): void {
    const d = document.documentElement;
    for (const [k, attr] of Object.entries(ATTRS)) {
      const v = prefs[k];
      if (v && v !== "default") d.setAttribute(attr, v);
      else d.removeAttribute(attr);
    }
  }

  document.querySelectorAll<HTMLFormElement>("[data-a11y-form]").forEach(
    (form) => {
      // 保存値をフォームに反映
      const prefs = loadPrefs();
      for (const [k, v] of Object.entries(prefs)) {
        const input = form.querySelector<HTMLInputElement>(
          `input[name="${k}"][value="${v}"]`,
        );
        if (input) input.checked = true;
      }
      const syncBackgroundChoice = () => {
        const value = document.documentElement.dataset.prefBg ?? "default";
        const input = form.querySelector<HTMLInputElement>(
          `input[name="bg"][value="${value}"]`,
        );
        if (input) input.checked = true;
      };
      window.addEventListener("atlasez-theme-change", syncBackgroundChoice);
      form.addEventListener("change", () => {
        const data = new FormData(form);
        const next: Record<string, string> = {};
        for (const [k, v] of data.entries()) {
          if (typeof v === "string" && v !== "default") next[k] = v;
        }
        try {
          localStorage.setItem(KEY, JSON.stringify(next));
        } catch {
          /* 保存不可でも表示には適用する */
        }
        apply(next);
        window.dispatchEvent(new CustomEvent("atlasez-theme-change"));
        // 言語は HTML 属性ではなく文字の差し替えで反映するので別に知らせる
        window.dispatchEvent(new CustomEvent("atlasez-lang-change"));
      });
      form
        .querySelector("[data-a11y-reset]")
        ?.addEventListener("click", () => {
          try {
            localStorage.removeItem(KEY);
          } catch {
            /* noop */
          }
          form
            .querySelectorAll<HTMLInputElement>('input[value="default"]')
            .forEach((i) => (i.checked = true));
          apply({});
          window.dispatchEvent(new CustomEvent("atlasez-theme-change"));
          window.dispatchEvent(new CustomEvent("atlasez-lang-change"));
        });
    },
  );
</script>
