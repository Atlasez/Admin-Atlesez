---
import {
  UI_LANGUAGES,
  UI_LANGUAGE_CHINESE_NAMES,
  UI_LANGUAGE_ENGLISH_NAMES,
  UI_LANGUAGE_JAPANESE_NAMES,
  UI_LANGUAGE_KOREAN_NAMES,
  UI_LANGUAGE_NAMES,
} from "../lib/ui-locales";
/** 表示設定パネル。localStorageに保存し、BaseHeadのinlineスクリプトが復元する */
interface Props {
  locale?: "ja" | "en";
  /**
   * true のとき <details> の外枠を付けず、設定フォームだけを描画する。
   * ヘッダーの「表示設定」ポップオーバー（SettingsMenu）から使う。
   */
  bare?: boolean;
}
const { locale = "ja", bare = false } = Astro.props;
const L =
  locale === "ja"
    ? {
        title: "表示設定",
        fontSize: "文字サイズ",
        std: "標準",
        large: "大",
        xlarge: "特大",
        contrast: "コントラスト",
        high: "高",
        bg: "背景",
        white: "白",
        soft: "低刺激色",
        dark: "暗色",
        lineHeight: "行間",
        wide: "広い",
        motion: "アニメーション",
        reduced: "軽減",
        font: "フォント",
        gothic: "標準ゴシック",
        readable: "可読性重視",
        reset: "初期設定に戻す",
      }
    : {
        title: "Display settings",
        fontSize: "Text size",
        std: "Default",
        large: "Large",
        xlarge: "X-Large",
        contrast: "Contrast",
        high: "High",
        bg: "Background",
        white: "White",
        soft: "Soft",
        dark: "Dark",
        lineHeight: "Line height",
        wide: "Wide",
        motion: "Animation",
        reduced: "Reduced",
        font: "Font",
        gothic: "Default",
        readable: "Readable",
        reset: "Reset to defaults",
      };

/**
 * 表示言語。記事本文ではなく画面まわりの文字を切り替える。URL は変わらない。
 * 今後十数言語に増える想定なので、並べずにドロップダウンで選ばせる。
 */
const languageGroup = {
  key: "lang",
  label: locale === "ja" ? "言語" : "Language",
  options: UI_LANGUAGES.map((code) => ({
    value: code,
    label: UI_LANGUAGE_NAMES[code],
    native: UI_LANGUAGE_NAMES[code],
    english: UI_LANGUAGE_ENGLISH_NAMES[code],
    japanese: UI_LANGUAGE_JAPANESE_NAMES[code],
    chinese: UI_LANGUAGE_CHINESE_NAMES[code],
    korean: UI_LANGUAGE_KOREAN_NAMES[code],
  })),
};

const groups = [
  {
    key: "fontSize",
    label: L.fontSize,
    options: [
      { value: "default", label: L.std },
      { value: "large", label: L.large },
      { value: "xlarge", label: L.xlarge },
    ],
  },
  {
    key: "contrast",
    label: L.contrast,
    options: [
      { value: "default", label: L.std },
      { value: "high", label: L.high },
    ],
  },
  {
    key: "bg",
    label: L.bg,
    options: [
      { value: "default", label: L.white },
      { value: "soft", label: L.soft },
      { value: "dark", label: L.dark },
    ],
  },
  {
    key: "lineHeight",
    label: L.lineHeight,
    options: [
      { value: "default", label: L.std },
      { value: "wide", label: L.wide },
    ],
  },
  {
    key: "motion",
    label: L.motion,
    options: [
      { value: "default", label: L.std },
      { value: "reduced", label: L.reduced },
    ],
  },
  {
    key: "font",
    label: L.font,
    options: [
      { value: "default", label: L.gothic },
      { value: "readable", label: L.readable },
    ],
  },
];
---

{
  bare ? (
    <form class="a11y-form" data-a11y-form>
      <p class="a11y-lang">
        <label class="a11y-lang-label" for="a11y-lang-bare">
          {languageGroup.label}
        </label>
        <select id="a11y-lang-bare" name={languageGroup.key}>
          {languageGroup.options.map((o) => (
            <option
              value={o.value}
              data-language-native={o.native}
              data-language-english={o.english}
                      data-language-japanese={o.japanese}
                      data-language-chinese={o.chinese}
                      data-language-korean={o.korean}
            >
              {o.label}
            </option>
          ))}
        </select>
      </p>
      {groups.map((g) => (
        <fieldset>
          <legend>{g.label}</legend>
          <div class="a11y-options">
            {g.options.map((o, i) => (
              <label class="a11y-option">
                <input
                  type="radio"
                  name={g.key}
                  value={o.value}
                  checked={i === 0}
                />
                <span>{o.label}</span>
              </label>
            ))}
          </div>
        </fieldset>
      ))}
      <button type="button" class="button button-secondary" data-a11y-reset>
        {L.reset}
      </button>
    </form>
  ) : (
    <details class="a11y-settings">
      <summary>{L.title}</summary>
      <form class="details-body" data-a11y-form>
        <p class="a11y-lang">
          <label class="a11y-lang-label" for="a11y-lang">
            {languageGroup.label}
          </label>
          <select id="a11y-lang" name={languageGroup.key}>
            {languageGroup.options.map((o) => (
              <option
                value={o.value}
                data-language-native={o.native}
              data-language-english={o.english}
                      data-language-japanese={o.japanese}
                      data-language-chinese={o.chinese}
                      data-language-korean={o.korean}
              >
                {o.label}
              </option>
            ))}
          </select>
        </p>
        {groups.map((g) => (
          <fieldset>
            <legend>{g.label}</legend>
            <div class="a11y-options">
              {g.options.map((o, i) => (
                <label class="a11y-option">
                  <input
                    type="radio"
                    name={g.key}
                    value={o.value}
                    checked={i === 0}
                  />
                  <span>{o.label}</span>
                </label>
              ))}
            </div>
          </fieldset>
        ))}
        <button type="button" class="button button-secondary" data-a11y-reset>
          {L.reset}
        </button>
      </form>
    </details>
  )
}

<style>
  .a11y-settings {
    font-size: calc(0.9rem * var(--text-scale));
    background: var(--background-primary);
  }
  .a11y-settings summary::before {
    content: "Aa ";
    font-weight: 700;
    color: var(--accent-primary);
    margin-right: var(--space-1);
  }
  .a11y-lang {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0 0 var(--space-2);
  }
  .a11y-lang-label {
    margin: 0;
    font-weight: 600;
  }
  .a11y-lang select {
    flex: 1 1 auto;
    min-width: 0;
    max-width: 12rem;
  }
  fieldset {
    border: 0;
    padding: 0;
  }
  legend {
    padding: 0;
  }
  .a11y-option {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-weight: 400;
    min-height: var(--touch-target);
  }
  .a11y-option input {
    min-height: auto;
    width: 1.1rem;
    height: 1.1rem;
  }

  /*
   * 設定は7組あるので、素直に並べると縦に伸びすぎる。
   * ラジオの丸は消して選択肢そのものを押せる面にし、
   * 見出し・面・組の間の余白を最小限にする。画面幅によらず同じ形。
   * 面の高さは 32px で、WCAG 2.5.8 の下限 24px は十分に上回る。
   */
  fieldset {
    display: block;
    margin: 0 0 var(--space-1);
  }
  legend {
    margin-bottom: 2px;
    font-size: calc(0.78rem * var(--text-scale));
    font-weight: 600;
    color: var(--text-secondary);
  }
  .a11y-options {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(4.5rem, 1fr));
    gap: 4px;
  }
  .a11y-option {
    justify-content: center;
    min-height: 2rem;
    padding: 0 4px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    text-align: center;
    line-height: 1.2;
    font-weight: 400;
  }
  .a11y-option:has(input:checked) {
    border-color: var(--accent-primary);
    background: var(--accent-subtle);
    color: var(--accent-primary);
    font-weight: 700;
  }
  /* 選択肢が2つの組は横幅を分け合う */
  .a11y-options:has(> :nth-child(2):last-child) {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  /*
   * 丸を隠せるのは :has() で選択状態を面に反映できる場合だけ。
   * 非対応のブラウザでは丸を残さないと、どれを選んでいるか分からなくなる。
   */
  @supports selector(:has(*)) {
    .a11y-option input {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
    /* キーボード操作でどこにいるか分かるようにする */
    .a11y-option:has(input:focus-visible) {
      outline: 3px solid var(--focus-ring);
      outline-offset: 1px;
    }
  }
  @supports not selector(:has(*)) {
    .a11y-option input {
      width: 0.85rem;
      height: 0.85rem;
      flex: 0 0 auto;
    }
  }
  /* 「初期設定に戻す」は控えめに、1行に収める */
  .a11y-form > .button {
    width: 100%;
    min-height: 2rem;
    margin-top: var(--space-1);
    font-size: calc(0.8rem * var(--text-scale));
  }

  /* 狭い画面では字だけさらに詰める */
  @media (max-width: 767px) {
    .a11y-settings,
    .a11y-form {
      font-size: calc(0.82rem * var(--text-scale));
    }
    legend {
      font-size: calc(0.75rem * var(--text-scale));
    }
  }
</style>

<script>
  const KEY = "atlasez-prefs";
  const ATTRS: Record<string, string> = {
    fontSize: "data-pref-font-size",
    contrast: "data-pref-contrast",
    bg: "data-pref-bg",
    lineHeight: "data-pref-line-height",
    motion: "data-pref-motion",
    font: "data-pref-font",
  };

  function loadPrefs(): Record<string, string> {
    try {
      return JSON.parse(localStorage.getItem(KEY) ?? "{}");
    } catch {
      return {};
    }
  }

  function apply(prefs: Record<string, string>): void {
    const d = document.documentElement;
    for (const [k, attr] of Object.entries(ATTRS)) {
      const v = prefs[k];
      if (v && v !== "default") d.setAttribute(attr, v);
      else d.removeAttribute(attr);
    }
  }

  /** 選択中ではない言語は、母語表記に英語名を添えて探しやすくする。 */
  function updateLanguageOptionLabels(select: HTMLSelectElement): void {
    const current = select.value;
    select.querySelectorAll<HTMLOptionElement>("option").forEach((option) => {
      const native = option.dataset.languageNative ?? option.textContent ?? "";
      const english = option.dataset.languageEnglish ?? "";
      const japanese = option.dataset.languageJapanese ?? "";
      const chinese = option.dataset.languageChinese ?? "";
      const korean = option.dataset.languageKorean ?? "";
      const suffixByLanguage: Record<string, string> = {
        ja: japanese,
        en: english,
        zh: chinese,
        ko: korean,
      };
      const suffix = suffixByLanguage[current] ?? english;
      option.textContent =
        option.value === current || !suffix || native === suffix
          ? native
          : `${native}(${suffix})`;
    });
  }

  document.querySelectorAll<HTMLFormElement>("[data-a11y-form]").forEach(
    (form) => {
      // 保存値をフォームに反映
      const prefs = loadPrefs();
      for (const [k, v] of Object.entries(prefs)) {
        const input = form.querySelector<HTMLInputElement>(
          `input[name="${k}"][value="${v}"]`,
        );
        if (input) input.checked = true;
        // 言語のようにドロップダウンで選ぶ項目
        const select = form.querySelector<HTMLSelectElement>(
          `select[name="${k}"]`,
        );
        if (select) select.value = v;
      }
      form
        .querySelectorAll<HTMLSelectElement>('select[name="lang"]')
        .forEach(updateLanguageOptionLabels);
      const syncBackgroundChoice = () => {
        const value = document.documentElement.dataset.prefBg ?? "default";
        const input = form.querySelector<HTMLInputElement>(
          `input[name="bg"][value="${value}"]`,
        );
        if (input) input.checked = true;
      };
      window.addEventListener("atlasez-theme-change", syncBackgroundChoice);
      form.addEventListener("change", () => {
        form
          .querySelectorAll<HTMLSelectElement>('select[name="lang"]')
          .forEach(updateLanguageOptionLabels);
        const data = new FormData(form);
        const next: Record<string, string> = {};
        for (const [k, v] of data.entries()) {
          if (typeof v === "string" && v !== "default") next[k] = v;
        }
        try {
          localStorage.setItem(KEY, JSON.stringify(next));
        } catch {
          /* 保存不可でも表示には適用する */
        }
        apply(next);
        window.dispatchEvent(new CustomEvent("atlasez-theme-change"));
        // 言語は HTML 属性ではなく文字の差し替えで反映するので別に知らせる
        window.dispatchEvent(new CustomEvent("atlasez-lang-change"));
      });
      form
        .querySelector("[data-a11y-reset]")
        ?.addEventListener("click", () => {
          try {
            localStorage.removeItem(KEY);
          } catch {
            /* noop */
          }
          form
            .querySelectorAll<HTMLInputElement>('input[value="default"]')
            .forEach((i) => (i.checked = true));
          form
            .querySelectorAll<HTMLSelectElement>("select")
            .forEach((sel) => {
              sel.selectedIndex = 0;
              if (sel.name === "lang") updateLanguageOptionLabels(sel);
            });
          apply({});
          window.dispatchEvent(new CustomEvent("atlasez-theme-change"));
          window.dispatchEvent(new CustomEvent("atlasez-lang-change"));
        });
    },
  );
</script>
