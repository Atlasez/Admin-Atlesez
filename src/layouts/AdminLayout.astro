---
import BaseHead from "../components/BaseHead.astro";
import AdminNav from "../components/AdminNav.astro";
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---

<!doctype html>
<html lang="ja" data-site="atlas">
  <head>
    <BaseHead title={title} description={description} noindex={true} />
  </head>
  <body>
    <ClientRouter />
    <AdminNav />
    <div class="admin-layout-main"><slot /></div>
    <script>
      import "../scripts/admin-editor-enhancements";
      import "../scripts/admin-editor-comment-images";
    </script>
  </body>
</html>
