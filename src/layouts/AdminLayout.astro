---
import BaseHead from "../components/BaseHead.astro";
import AdminNav from "../components/AdminNav.astro";
import { ClientRouter } from "astro:transitions";
import "../styles/article-content.css";

interface Props {
  title: string;
  description: string;
  darkReaderLock?: boolean;
}
const { title, description, darkReaderLock = false } = Astro.props;
---

<!doctype html>
<html lang="ja" data-site="atlas">
    <head>
      <BaseHead title={title} description={description} noindex={true} />
      {darkReaderLock && <meta name="darkreader-lock" />}
    </head>
  <body>
    <ClientRouter />
    <AdminNav />
    <div class="admin-layout-main"><slot /></div>
    <script>
      import "../scripts/admin-editor-navigation-guard";
      import "../scripts/admin-editor-comment-images";
      import "../scripts/admin-editor-preview-images";
      import "../scripts/admin-editor-realtime-cursors-yjs";
      import "../scripts/admin-editor-subject-preview";
      import "../scripts/admin-editor-math-macros";
      import "../scripts/admin-editor-collaboration-labels";
    </script>
    <script is:inline type="module" src="/admin-codemirror.js"></script>
  </body>
</html>
