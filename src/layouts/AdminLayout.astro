---
import BaseHead from "../components/BaseHead.astro";
import AdminNav from "../components/AdminNav.astro";
import { ClientRouter } from "astro:transitions";
import "../styles/article-content.css";
import "../styles/admin.css";

interface Props {
  title: string;
  description: string;
  darkReaderLock?: boolean;
}
const { title, description, darkReaderLock = false } = Astro.props;
---

<!doctype html>
<html lang="ja" data-site="atlas">
    <head>
      <BaseHead
        title={title}
        description={description}
        noindex={true}
        enableArticleEnhancements={false}
      />
      <link rel="manifest" href="/admin-manifest.webmanifest" />
      <link rel="apple-touch-icon" href="/images/atlasez-logo.png" />
      <meta name="theme-color" content="#101214" />
      <meta name="mobile-web-app-capable" content="yes" />
      <meta name="apple-mobile-web-app-capable" content="yes" />
      <meta name="apple-mobile-web-app-title" content="Atlasez運営" />
      {darkReaderLock && <meta name="darkreader-lock" />}
    </head>
  <body data-admin-shell>
    <ClientRouter />
    <AdminNav />
    <div class="admin-layout-main"><slot /></div>
    <script>
      // 仮のPWA版。オフラインキャッシュはまだ行わず、常に本番APIの
      // 最新状態と認証セッションを利用する。
      if ("serviceWorker" in navigator) {
        void navigator.serviceWorker.register("/admin-sw.js", { scope: "/admin/" });
      }

      // Native multi-selects remain the submission source of truth, while a
      // checkbox presentation makes assignment forms discoverable on touch.
      void import("../scripts/admin-multi-select");

      // Editor-only features are intentionally loaded after the editor route
      // is present. The article list and operational pages should not pay for
      // CodeMirror, Yjs, KaTeX authoring, or collaboration observers.
      const loadEditorFeatures = () => {
        if (!document.querySelector("[data-editor-workspace]")) return;

        void Promise.all([
          import("../scripts/admin-editor-navigation-guard"),
          import("../scripts/admin-editor-comment-images"),
          import("../scripts/admin-editor-preview-images"),
          import("../scripts/admin-editor-realtime-cursors-yjs"),
          import("../scripts/admin-editor-subject-preview"),
          import("../scripts/admin-editor-math-macros"),
          import("../scripts/admin-editor-collaboration-labels"),
        ]);

        if (!document.querySelector('script[data-admin-codemirror]')) {
          const script = document.createElement("script");
          script.type = "module";
          script.src = "/admin-codemirror.js";
          script.dataset.adminCodemirror = "true";
          document.head.append(script);
        }
      };

      document.addEventListener("astro:page-load", loadEditorFeatures);
      loadEditorFeatures();
    </script>
  </body>
</html>
