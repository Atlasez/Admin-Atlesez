---
/** 学習サイト「アトラス」の共通レイアウト（ロケール対応） */
import BaseHead from "../components/BaseHead.astro";
import SettingsMenu from "../components/SettingsMenu.astro";
import LangSwitch from "../components/LangSwitch.astro";
import HeaderSearch from "../components/HeaderSearch.astro";
import { withBase, atlasPath, ORG } from "../lib/site";
import { t, type Locale } from "../lib/i18n";

interface AlternateLink {
  hreflang: string;
  href: string;
}
interface Props {
  locale: Locale;
  title: string;
  description: string;
  ogType?: "website" | "article";
  alternates?: AlternateLink[];
  structuredData?: object;
  /** 言語切替リンク先（省略時は各ロケールの総合ホーム） */
  localeSwitchHrefs?: Record<string, string>;
  /** 検索エンジンにインデックスさせない（内容が空のページなど） */
  noindex?: boolean;
}
const {
  locale,
  title,
  description,
  ogType,
  alternates = [],
  structuredData,
  localeSwitchHrefs = {},
  noindex = false,
} = Astro.props;

/**
 * ナビゲーション。
 * 検索は「行き先」ではなく「操作」なので、タブから外してヘッダー上段の
 * 入力欄に移した（検索ページ自体は残っているので直接開くこともできる）。
 * 「はじめての方へ」は入口として目立たせたいので囲みスタイルにする。
 */
const nav = [
  { label: t(locale, "subjects"), href: atlasPath(locale) },
  { label: t(locale, "map"), href: atlasPath(locale, "map") },
  { label: t(locale, "bookmarks"), href: atlasPath(locale, "bookmarks") },
  { label: t(locale, "history"), href: atlasPath(locale, "history") },
  { label: t(locale, "team"), href: atlasPath(locale, "team") },
];
const guide = {
  label: t(locale, "forBeginners"),
  href: atlasPath(locale, "guide"),
};
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang={locale} data-site="atlas">
  <head>
    <BaseHead
      title={`${title} | ${t(locale, "siteName")}`}
      description={description}
      ogType={ogType}
      alternates={alternates}
      structuredData={structuredData}
      noindex={noindex}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">{t(locale, "skipToContent")}</a>
    <header class="atlas-header">
      {/* 上段: ロゴ・検索・表示設定・言語切替（見た目と横断操作をここに集約） */}
      <div class="container atlas-utility-bar">
        <a class="atlas-logo" href={atlasPath(locale)}>
          <img
            src={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/images/atlasez-logo.png`}
            alt=""
            width="40"
            height="40"
          />
          <span>{locale === "ja" ? "アトラス" : "Atlas"}</span>
        </a>
        <HeaderSearch locale={locale} />
        <div class="atlas-utility-actions">
          <SettingsMenu locale={locale} />
          <LangSwitch locale={locale} hrefs={localeSwitchHrefs} />
          <a class="org-link" href={withBase("/")} title="Atlasez">Atlasez</a>
        </div>
        <button
          class="nav-toggle button button-secondary"
          type="button"
          aria-controls="atlas-main-nav"
          aria-expanded="false"
          data-nav-toggle
        >
          {locale === "ja" ? "メニュー" : "Menu"}
        </button>
      </div>
      {/* 下段: 行き先のタブ */}
      <div class="container atlas-nav-bar">
        <nav
          id="atlas-main-nav"
          class="main-nav"
          aria-label={locale === "ja" ? "メインナビゲーション" : "Main navigation"}
          data-main-nav
        >
          <ul class="atlas-nav">
            {
              nav.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={currentPath === item.href ? "page" : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
            <li class="nav-guide">
              <a
                href={guide.href}
                aria-current={currentPath === guide.href ? "page" : undefined}
              >
                {guide.label}
              </a>
            </li>
          </ul>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="atlas-footer">
      <div class="container atlas-footer-inner">
        <div>
          <p class="atlas-footer-title">{t(locale, "siteName")}</p>
          <p>{t(locale, "siteTagline")}</p>
          <p>
            {t(locale, "operatedBy")}:
            <a href={withBase("/")}>Atlasez</a> ・
            <a href={ORG.atlasSns.x} rel="noopener noreferrer" target="_blank"
              >X (@learning_atlas)</a
            >
          </p>
          <p>
            <a href={withBase("/privacy-policy/")}>
              {locale === "ja" ? "プライバシーポリシー" : "Privacy Policy"}
            </a>
          </p>
        </div>
      </div>
      <p class="container atlas-copyright">© 2024-2026 Atlasez</p>
    </footer>
  </body>
</html>

<style>
  .atlas-header {
    border-top: 3px solid var(--accent-primary);
    border-bottom: 1px solid var(--border-default);
    background: var(--background-primary);
  }
  .atlas-utility-bar {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
    padding-block: var(--space-1);
  }
  .atlas-utility-actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-left: auto;
  }
  .atlas-nav-bar {
    border-top: 1px solid var(--border-default);
  }
  .atlas-logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 700;
    font-size: calc(1.15rem * var(--text-scale));
    color: var(--accent-primary);
    text-decoration: none;
    min-height: var(--touch-target);
  }
  .atlas-nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-toggle {
    display: none;
    margin-left: auto;
  }
  .atlas-nav a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
    padding: 0 var(--space-2);
    text-decoration: none;
    color: var(--text-primary);
    border-bottom: 2px solid transparent;
  }
  .atlas-nav a:hover,
  .atlas-nav a[aria-current="page"] {
    border-bottom-color: var(--accent-primary);
    color: var(--accent-primary);
  }
  /* 「はじめての方へ」は入口として囲みで目立たせ、右端に寄せる */
  .nav-guide {
    margin-left: auto;
    display: flex;
    align-items: center;
  }
  .nav-guide a {
    border: 1px solid var(--accent-primary);
    border-radius: var(--radius);
    border-bottom-width: 1px;
    background: var(--accent-subtle);
    color: var(--accent-primary);
    font-weight: 700;
    padding: 0 var(--space-3);
    margin-block: var(--space-1);
  }
  .nav-guide a:hover,
  .nav-guide a[aria-current="page"] {
    background: var(--accent-primary);
    color: var(--background-primary);
    border-bottom-color: var(--accent-primary);
  }
  .org-link {
    font-size: calc(0.9rem * var(--text-scale));
    color: var(--text-secondary);
  }
  main {
    min-height: 60vh;
    padding-block: var(--space-3);
  }
  .atlas-footer {
    border-top: 1px solid var(--border-default);
    background: var(--background-primary);
    padding-block: var(--space-5);
    font-size: calc(0.9rem * var(--text-scale));
  }
  .atlas-footer-inner {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--space-4);
  }
  .atlas-footer-title {
    font-weight: 700;
    margin-top: 0;
  }
  .atlas-copyright {
    margin-top: var(--space-4);
    color: var(--text-secondary);
  }
  @media (max-width: 767px) {
    .atlas-utility-bar {
      gap: var(--space-2);
    }
    .atlas-logo {
      margin-right: auto;
    }
    .atlas-utility-actions {
      margin-left: 0;
    }
    .nav-toggle {
      display: inline-flex;
      margin-left: 0;
    }
    .atlas-nav-bar {
      border-top: 0;
    }
    .main-nav {
      display: none;
      width: 100%;
      border-top: 1px solid var(--border-default);
    }
    .main-nav[data-open] {
      display: block;
    }
    .atlas-nav {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      width: 100%;
      padding-block: var(--space-1);
    }
    .atlas-nav a {
      width: 100%;
      padding-inline: var(--space-2);
    }
    .nav-guide {
      margin-left: 0;
      grid-column: 1 / -1;
    }
    .nav-guide a {
      justify-content: center;
    }
    .org-link {
      display: none;
    }
  }
</style>

<script>
  const navToggle =
    document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
  const mainNav = document.querySelector<HTMLElement>("[data-main-nav]");

  navToggle?.addEventListener("click", () => {
    if (!mainNav) return;
    const open = !mainNav.hasAttribute("data-open");
    mainNav.toggleAttribute("data-open", open);
    navToggle.setAttribute("aria-expanded", String(open));
  });
</script>
