---
import { SEMINAR_REVIEW_PATH } from "../lib/admin-routes";
import BaseHead from "../components/BaseHead.astro";
import SettingsMenu from "../components/SettingsMenu.astro";
import "../styles/seminars.css";

interface Props {
  title: string;
  page: string;
}
const { title, page } = Astro.props;
const nav = [
  { label: "ゼミ一覧", href: "https://atlasez.org/seminars/", page: "catalog" },
  { label: "参加者ページ", href: "/seminars/member/", page: "member" },
  { label: "運営ページ", href: SEMINAR_REVIEW_PATH, page: "operations" },
];
const login = `/auth/google/login?returnTo=${encodeURIComponent(Astro.url.pathname)}`;
---
<!doctype html>
<html lang="ja" data-site="org">
  <head>
    <BaseHead
      title={page === "catalog" ? `${title} | Atlasez` : `${title} | ゼミプラットフォーム`}
      description="Atlasezの自主ゼミの一覧と、企画・参加申請。"
      noindex={page !== "catalog"}
      enableArticleEnhancements={false}
    />
  </head>
  <body data-seminar-page={page}>
    <a class="skip-link" href="#main">本文へ移動</a>
    <header class="seminar-header">
      <div class="container seminar-header-inner">
        <a class="seminar-brand" href="https://atlasez.org/">
          <img src="/images/atlasez-logo.png" alt="" width="44" height="44" />
          <span>Atlasez</span>
        </a>
        <nav aria-label="ゼミプラットフォーム">
          <ul>
            {nav.map((item) => (
              <li data-seminar-operator={item.page === "operations" ? "" : undefined} hidden={item.page === "operations"}>
                <a href={item.href} aria-current={page === item.page ? "page" : undefined}>{item.label}</a>
              </li>
            ))}
          </ul>
        </nav>
        <div class="seminar-header-tools">
          <a href={login} data-seminar-login>ログイン</a>
          <span class="seminar-muted" data-seminar-account hidden>ログイン中</span>
          <SettingsMenu locale="ja" showLanguage={false} />
        </div>
      </div>
    </header>
    <main id="main" class="container seminar-shell">
      <slot />
      <noscript><p>ゼミ一覧や申請を利用するには、ブラウザーでJavaScriptを有効にしてください。</p></noscript>
    </main>
    <footer class="seminar-footer">
      <div class="container seminar-footer-inner">
        <div>
          <p class="seminar-footer-brand"><a href="https://atlasez.org/">Atlasez</a></p>
          <a href="mailto:atlasez.contact@gmail.com">atlasez.contact@gmail.com</a>
        </div>
        <nav aria-label="関連情報">
          <a href="https://atlasez.org/about/">Atlasezとは</a>
          <a href="/privacy-policy/">個人情報保護方針</a>
        </nav>
      </div>
    </footer>
    <script>
      import "../scripts/seminars/index";
    </script>
  </body>
</html>
