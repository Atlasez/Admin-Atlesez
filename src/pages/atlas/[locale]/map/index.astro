---
/**
 * 学習地図ページ。中身は総合ホームの「学習地図」タブと共通のコンポーネント。
 */
import AtlasLayout from "../../../../layouts/AtlasLayout.astro";
import Breadcrumb from "../../../../components/Breadcrumb.astro";
import LearningMap from "../../../../components/LearningMap.astro";
import { atlasPath } from "../../../../lib/site";
import { t, LOCALES, type Locale } from "../../../../lib/i18n";

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
---

<AtlasLayout
  locale={locale}
  title={t(locale, "map")}
  description={locale === "ja"
    ? "概念の前提関係をたどれる学習地図。開始地点と目的地点を選ぶと学習ルートを表示します。"
    : "A learning map of concepts and their prerequisites, with route search."}
  localeSwitchHrefs={Object.fromEntries(
    LOCALES.map((l) => [l, atlasPath(l, "map")]),
  )}
>
  <div class="container">
    <Breadcrumb
      items={[
        { label: t(locale, "breadcrumbHome"), href: atlasPath(locale) },
        { label: t(locale, "map") },
      ]}
    />
    <h1>{t(locale, "map")}</h1>
    <p class="reading">
      {
        locale === "ja"
          ? "学びたい分野と目標を選ぶと、前提から順に読む記事を表示します。概念どうしの関係を詳しく見たい場合は、その下の概念マップを開いてください。"
          : "Choose a subject and a goal to see articles in prerequisite order. Open the concept map below only when you want to explore the relationships in detail."
      }
    </p>
    <LearningMap locale={locale} />
  </div>
</AtlasLayout>
