      articleTitle: data.title ?? "",
      subject: data.subjectSlug ?? "",
      category: data.categorySlug ?? "",
      locale: data.locale ?? "ja",
    };
    const sent = new Set<string>();
    const endpoint = window.location.hostname === "mitukx.github.io"
      ? "https://atlasez-web-1.ukyoukay0.workers.dev/api/article-analytics"
      : "/api/article-analytics";
    const track = (event: "view" | "engaged" | "complete") => {
      if (sent.has(event)) return;
      sent.add(event);
      void fetch(endpoint, {
        method: "POST",
        keepalive: true,
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ ...analyticsPayload, event }),
      }).catch(() => {
        // 統計送信の失敗は記事閲覧を妨げない。
      });
    };
    track("view");
    window.setTimeout(() => {
      if (document.visibilityState === "visible") track("engaged");
    }, 15_000);
    const checkCompletion = () => {
      const threshold = analyticsArticleBody.offsetTop + analyticsArticleBody.offsetHeight * 0.9;
      if (window.scrollY + window.innerHeight >= threshold) track("complete");
    };
    window.addEventListener("scroll", checkCompletion, { passive: true });
    window.addEventListener("resize", checkCompletion);
    checkCompletion();
  }
</script>

<script>
  // 記事本文のどこまで来たかを画面上端の帯で示す
  const progressBar = document.querySelector<HTMLElement>("[data-reading-progress]");
  const articleBody = document.querySelector<HTMLElement>(".article-body");

  if (progressBar && articleBody) {
    const update = () => {
      const rect = articleBody.getBoundingClientRect();
      const total = rect.height - window.innerHeight;
      // 本文が画面より短い記事では帯を出しても意味がないので 0 のままにする
      const ratio = total <= 0 ? 0 : (-rect.top / total) * 100;
      progressBar.style.width = `${Math.min(100, Math.max(0, ratio))}%`;
    };
    update();
    window.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update);
  }

  // 現在読んでいる見出しを目次で強調する（scroll-spy）
  const links = new Map<string, HTMLAnchorElement>();
  document
    .querySelectorAll<HTMLAnchorElement>("[data-toc-link]")
    .forEach((a) => {
      const id = a.dataset.tocLink;
      if (id) links.set(id, a);
    });
  const headings = [...links.keys()]
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);

  if ("IntersectionObserver" in window && headings.length > 0) {
    let currentId: string | null = null;
    const observer = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            currentId = e.target.id;
          }
        }
        if (currentId) {
          links.forEach((a, id) => {
            if (id === currentId) a.setAttribute("aria-current", "true");
            else a.removeAttribute("aria-current");
          });
        }
      },
      { rootMargin: "0px 0px -70% 0px" },
    );
    headings.forEach((h) => observer.observe(h));
  }

  // モバイルでは目次を初期状態で閉じる
  const mq = window.matchMedia("(max-width: 1023px)");
  const details = document.querySelector<HTMLDetailsElement>(".toc-details");
  const mobileTocTrigger = document.querySelector<HTMLButtonElement>("[data-mobile-toc]");
  const syncMobileTocState = () => {
    mobileTocTrigger?.setAttribute("aria-expanded", String(details?.open ?? false));
  };
  if (details && mq.matches) details.open = false;
  syncMobileTocState();
  details?.addEventListener("toggle", syncMobileTocState);
  details?.querySelectorAll<HTMLAnchorElement>("[data-toc-link]").forEach((link) => {
    link.addEventListener("click", () => {
      if (mq.matches) {
        details.open = false;
        syncMobileTocState();
      }
    });
  });
  mobileTocTrigger?.addEventListener("click", () => {
    if (!details) return;
    details.open = !details.open;
    syncMobileTocState();
    if (details.open) {
      window.setTimeout(() => details.querySelector<HTMLAnchorElement>("a")?.focus(), 120);
    }
  });
</script>

<script>
  const reportForm = document.querySelector<HTMLFormElement>("[data-issue-report-form]");
  if (reportForm) {
    reportForm.dataset.openedAt = String(Date.now());
    const status = reportForm.querySelector<HTMLElement>("[data-issue-report-status]");
    const submit = reportForm.querySelector<HTMLButtonElement>('button[type="submit"]');
    const isJapanese = reportForm.dataset.locale === "ja";
    reportForm.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!reportForm.reportValidity()) return;

      const values = new FormData(reportForm);
      const setStatus = (message: string, state: "success" | "error" | "sending") => {
        if (!status) return;
        status.textContent = message;
        status.dataset.state = state;
      };
      submit?.setAttribute("disabled", "");
      setStatus(isJapanese ? "送信しています…" : "Sending…", "sending");
      try {
        const reportEndpoint = window.location.hostname === "mitukx.github.io"
          ? "https://atlasez-web-1.ukyoukay0.workers.dev/api/article-reports"
          : "/api/article-reports";
        const response = await fetch(reportEndpoint, {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({
            articleTitle: reportForm.dataset.articleTitle,
            articleUrl: window.location.href,
            articleId: reportForm.dataset.articleId,
            subject: reportForm.dataset.articleSubject,
            category: reportForm.dataset.articleCategory,
            locale: reportForm.dataset.locale,
            openedAt: reportForm.dataset.openedAt,
            reportType: values.get("reportType"),
            details: values.get("details"),
            contact: values.get("contact"),
            website: values.get("website"),
          }),
        });
        const contentType = response.headers.get("content-type") ?? "";
        const result = contentType.includes("application/json")
          ? (await response.json()) as { ok?: boolean; error?: string }
          : undefined;
        if (!response.ok || !result?.ok) {
          throw new Error(result?.error ?? (isJapanese
            ? "送信先に接続できませんでした。時間をおいて再度お試しください。"
            : "The report endpoint is unavailable. Please try again later."));
        }
        reportForm.reset();
        setStatus(isJapanese ? "送信しました。ご協力ありがとうございます。" : "Report sent. Thank you.", "success");
      } catch (error) {
        const message = error instanceof Error && error.message
          ? error.message
          : isJapanese ? "送信できませんでした。時間をおいて再度お試しください。" : "Could not send the report. Please try again later.";
        setStatus(message, "error");
      } finally {
        submit?.removeAttribute("disabled");
      }
    });
  }
</script>

<script>
  // 「あとで読む」と「読んだ・理解した」の状態反映とトグル
  import { toggleBookmark, isBookmarked } from "../../../../../lib/bookmarks";
  import {
    historyStateOf,
    setHistoryState,
    HISTORY_STAGES,
    type HistoryState,
  } from "../../../../../lib/history";

  const actions = document.querySelector<HTMLElement>("[data-article-actions]");
  if (actions) {
    const d = actions.dataset;
    const articleId = d.articleId ?? "";
    // 3つのボタンで同じ記事情報を使う
    const entry = {
      articleId,
      locale: d.locale ?? "",
      title: d.title ?? "",
      href: d.href ?? "",
      subject: d.subject ?? "",
      category: d.category ?? "",
      summary: d.summary ?? "",
    };

    const bookmarkBtn = actions.querySelector<HTMLButtonElement>(
      "[data-bookmark-toggle]",
    );
    if (bookmarkBtn) {
      const bd = bookmarkBtn.dataset;
      const labelEl =
        bookmarkBtn.querySelector<HTMLElement>("[data-bookmark-label]");
      const iconEl =
        bookmarkBtn.querySelector<HTMLElement>("[data-bookmark-icon]");

      const renderBookmark = (on: boolean) => {
        bookmarkBtn.setAttribute("aria-pressed", on ? "true" : "false");
        if (labelEl) {
          labelEl.textContent = on ? (bd.labelSaved ?? "") : (bd.labelSave ?? "");
        }
        if (iconEl) iconEl.textContent = on ? "★" : "☆";
      };

      renderBookmark(isBookmarked(articleId));
      bookmarkBtn.addEventListener("click", () => {
        renderBookmark(toggleBookmark(entry));
      });
    }

    const historyToggles = [
      ...document.querySelectorAll<HTMLButtonElement>(
        "[data-history-stage-toggle]",
      ),
    ];
    const historyControls = [
      ...document.querySelectorAll<HTMLElement>(
        "[data-history-stage-control]",
      ),
    ];
    const states: Array<HistoryState | null> = [
      null,
      ...HISTORY_STAGES.map((stage) => stage.id),
    ];
    const stateLabels = [
      historyToggles[0]?.dataset.labelNone ?? "",
      historyToggles[0]?.dataset.labelRead ?? "",
      historyToggles[0]?.dataset.labelUnderstood ?? "",
    ];
    const renderHistory = (state: HistoryState | null) => {
      const index = states.indexOf(state);
      historyToggles.forEach((toggle) => {
        toggle.dataset.state = state ?? "none";
        toggle.setAttribute("aria-valuenow", String(index));
        toggle.setAttribute("aria-valuetext", stateLabels[index] ?? "");
      });
      historyControls.forEach((control) => {
        control.dataset.state = state ?? "none";
      });
    };

    let currentState = historyStateOf(articleId);
    renderHistory(currentState);
    const moveTo = (index: number) => {
      const bounded = Math.max(0, Math.min(states.length - 1, index));
      currentState = setHistoryState(entry, states[bounded]);
      renderHistory(currentState);
    };
    historyToggles.forEach((historyToggle) => {
      historyToggle.addEventListener("click", (event) => {
        // ポインター操作では、触れた位置に最も近い段階へレバーを移す。
        // キーボードによる click は座標を持たないため、従来どおり1段進める。
        if (event.detail === 0) {
          const currentIndex = states.indexOf(currentState);
          moveTo((currentIndex + 1) % states.length);
          return;
        }
        const rect = historyToggle.getBoundingClientRect();
        const ratio = Math.max(
          0,
          Math.min(1, (event.clientX - rect.left) / rect.width),
        );
        moveTo(Math.round(ratio * (states.length - 1)));
      });
      historyToggle.addEventListener("keydown", (event) => {
        const currentIndex = states.indexOf(currentState);
        if (event.key === "ArrowRight" || event.key === "ArrowUp") {
          event.preventDefault();
          moveTo(currentIndex + 1);
        } else if (event.key === "ArrowLeft" || event.key === "ArrowDown") {
          event.preventDefault();
          moveTo(currentIndex - 1);
        } else if (event.key === "Home") {
          event.preventDefault();
          moveTo(0);
        } else if (event.key === "End") {
          event.preventDefault();
          moveTo(states.length - 1);
        }
      });
    });

    // 数学記事のPandoc風マークアップを、読みやすいカードと折りたたみ証明へ整える。
    // 明示的な .defi/.prop 等はそのまま尊重し、プレーンMarkdownの見出しも対象にする。
    const mathBody = document.querySelector<HTMLElement>(".article-body");
    const articleMeta = document.querySelector<HTMLElement>("[data-article-actions]");
    if (mathBody && articleMeta?.dataset.subjectSlug === "mathematics") {
      const labelToClass: Record<string, string> = { "定義": "defi", "命題": "prop", "定理": "thm", "補題": "lemma", "系": "cor", "例": "example" };
      const theoremLead = /^(定義|命題|定理|補題|系|例)\s*(?:\d+|[（(:：．。\.])/u;
      const proofLead = /^証明(?:\s|[．。\.:：]|$)/u;
      const isTheoremLead = (node: Element) => node.tagName === "P" && theoremLead.test((node.textContent ?? "").trim());
      const isProofLead = (node: Element) => node.tagName === "P" && proofLead.test((node.textContent ?? "").trim());
      const isHeading = (node: Element) => ["H2", "H3"].includes(node.tagName);
      const isDisplayMath = (node: Element) => node.matches(".katex-display,mjx-container[display=\"true\"]");
      const isMathBlock = (node: Element) => node.matches(
        ".defi,.prop,.thm,.lemma,.cor,.example,.math-definition,.math-theorem,.proof,.proof-details,.folding,.supp,.supp-details",
      );
      const isProofNode = (node: Element) => node.matches(".proof") || isProofLead(node);
      const legacyDetails = (node: HTMLElement) => {
        const isSupplement = node.classList.contains("supp");
        const details = document.createElement("details");
        details.className = isSupplement ? "supp-details" : "folding";
        const explicitSummary = node.dataset.summary || node.dataset.title;
        const first = node.firstElementChild;
        let summary: HTMLElement;
        if (first?.tagName === "SUMMARY") {
          summary = first as HTMLElement;
          first.remove();
        } else {
          summary = document.createElement("summary");
          summary.className = isSupplement ? "supp-details-summary" : "folding-summary";
          const title = explicitSummary
            || (first?.matches(".folding-title,.supp-title,h4") ? first.textContent?.trim() : "")
            || (isSupplement ? "補足." : "折りたたみ");
          summary.textContent = title;
          if (first?.matches(".folding-title,.supp-title,h4")) first.remove();
        }
        const inner = document.createElement("div");
        inner.className = isSupplement ? "supp-details-inner" : "folding-content";
        while (node.firstChild) inner.append(node.firstChild);
        details.append(summary, inner);
        node.replaceWith(details);
        return details;
      };
      // 旧 Pandoc 原稿では折りたたみが div.folding / div.supp として
      // 保存されていた。CSS だけでは div の中身は開閉できず、変換時に
      // 取りこぼされることがあるため、本文を移動して details に昇格する。
      [...mathBody.querySelectorAll<HTMLElement>("div.folding,div.supp")].forEach((node) => {
        if (node.closest("details.folding,details.supp-details")) return;
        legacyDetails(node);
      });
      const addTheoremLabel = (wrapper: HTMLElement) => {
        const paragraph = wrapper.querySelector<HTMLElement>(":scope > p");
        if (!paragraph || paragraph.querySelector(":scope > .thmtitle")) return;
        const firstElement = paragraph.firstElementChild;
        if (firstElement?.matches("strong,b")) {
          const label = firstElement.textContent?.trim() ?? "";
          if (/^(定義|命題|定理|補題|系|例)/u.test(label)) {
            const title = document.createElement("span");
            title.className = "thmtitle";
            title.textContent = label;
            firstElement.replaceWith(title);
            return;
          }
        }
        const firstText = [...paragraph.childNodes].find((child) => child.nodeType === Node.TEXT_NODE && (child.textContent ?? "").trim());
        if (!firstText) return;
        const labelMatch = (firstText.textContent ?? "").match(/^(\s*(?:定義|命題|定理|補題|系|例)\s*(?:\d+\s*)?(?:[（(][^）)]*[）)])?\s*[.．。:：]?\s*)/u);
        if (!labelMatch) return;
        const label = labelMatch[1];
        const rest = (firstText.textContent ?? "").slice(label.length);
        const title = document.createElement("span");
        title.className = "thmtitle";
        title.textContent = label.trim();
        firstText.parentNode?.insertBefore(title, firstText);
        firstText.textContent = rest;
      };
      const topLevel = () => [...mathBody.children] as HTMLElement[];
      for (const node of topLevel()) {
        if (node.tagName !== "P" || node.closest(".defi,.prop,.thm,.lemma,.cor,.example,.proof-details")) continue;
        const text = (node.textContent ?? "").trim();
        const match = Object.keys(labelToClass).find((label) => text.startsWith(label) && theoremLead.test(text));
        if (!match) continue;
        const wrapper = document.createElement("div");
        wrapper.className = labelToClass[match] ?? "math-theorem";
        node.replaceWith(wrapper);
        wrapper.append(node);
        addTheoremLabel(wrapper);
        let next = wrapper.nextElementSibling;
        let sawDisplayMath = false;
        while (next) {
          if (isHeading(next) || isMathBlock(next) || isTheoremLead(next) || isProofLead(next)) break;
          if (isDisplayMath(next)) {
            const following = next.nextElementSibling;
            wrapper.append(next);
            next = following;
            sawDisplayMath = true;
            continue;
          }
          if (next.tagName === "OL" || next.tagName === "UL") {
            const following = next.nextElementSibling;
            wrapper.append(next);
            next = following;
            continue;
          }
          // remark-math places a display equation between two paragraphs.
          // Keep the continuation paragraph in the same card so text is not
          // visually separated from its definition or theorem.
          if (sawDisplayMath && next.tagName === "P") wrapper.append(next);
          break;
        }
      }
      const removeProofLabel = (container: Element) => {
        const strong = container.querySelector(":scope > strong");
        if (strong && proofLead.test((strong.textContent ?? "").trim())) {
          strong.remove();
          return;
        }
        const firstText = [...container.childNodes].find((child) => child.nodeType === Node.TEXT_NODE && (child.textContent ?? "").trim());
        if (firstText) firstText.textContent = (firstText.textContent ?? "").replace(/^証明[。\.\s]*/u, "");
      };
      for (const node of topLevel()) {
        if (!isProofNode(node)) continue;
        const details = document.createElement("details");
        // `folding` は旧記事CSSが想定していた共通クラス。証明も同じ
        // details/summary の折りたたみとして扱い、既存のCSSを失わない。
        details.className = "proof-details folding";
        const summary = document.createElement("summary");
        summary.textContent = "証明.";
        const inner = document.createElement("div");
        inner.className = "proof-details-inner folding-content";
        node.parentNode?.insertBefore(details, node);
        details.append(summary, inner);
        if (node.matches(".proof")) {
          while (node.firstChild) inner.append(node.firstChild);
          removeProofLabel(inner);
          node.remove();
        } else {
          removeProofLabel(node);
          inner.append(node);
        }
        let next = details.nextElementSibling;
        while (next && !isHeading(next) && !isMathBlock(next) && !isTheoremLead(next) && !isProofNode(next)) {
          const following = next.nextElementSibling;
          inner.append(next);
          next = following;
        }
      }
      const proofToggle = document.querySelector<HTMLButtonElement>("[data-proof-toggle]");
      const proofs = [...mathBody.querySelectorAll<HTMLDetailsElement>("details.proof-details")];
      if (proofToggle && proofs.length > 0) {
        proofToggle.hidden = false;
        proofToggle.addEventListener("click", () => {
          const expand = proofs.some((proof) => !proof.open);
          proofs.forEach((proof) => { proof.open = expand; });
          proofToggle.textContent = expand ? "証明を閉じる" : "証明を展開";
          proofToggle.setAttribute("aria-expanded", String(expand));
        });
      }

      // 定義・命題・定理などは Markdown の見出しではなく本文の段落から
      // 自動生成されるため、変換後のカードにも目次リンクを追加する。
      // `.thmtitle` は数式を含む見出し文字列を MathJax が置き換える前に
      // 保存しているので、目次から数式だけが消えることも防げる。
      const tocList = document.querySelector<HTMLOListElement>(".toc-list");
      const theoremCards = [...mathBody.children].filter((node): node is HTMLElement =>
        node instanceof HTMLElement && node.matches(".defi,.prop,.thm,.lemma,.cor,.example,.math-definition,.math-theorem"),
      );
      const tocHeadingItems = new Map<string, HTMLLIElement>();
      tocList?.querySelectorAll<HTMLAnchorElement>("a[data-toc-link]").forEach((link) => {
        const item = link.closest("li");
        if (item instanceof HTMLLIElement && link.dataset.tocLink) {
          tocHeadingItems.set(link.dataset.tocLink, item);
        }
      });
      const tocSubLists = new Map<string, HTMLOListElement>();
      theoremCards.forEach((card, index) => {
        const id = `math-block-${index + 1}`;
        card.id = id;
        if (!tocList || tocList.querySelector(`[data-math-toc="${id}"]`)) return;
        const title = card.querySelector<HTMLElement>(":scope > p > .thmtitle")?.textContent?.trim()
          || card.querySelector<HTMLElement>(":scope > .thmtitle")?.textContent?.trim()
          || (card.textContent ?? "").trim().split(/\n/u)[0]?.slice(0, 120)
          || "数学の定理・定義";
        const item = document.createElement("li");
        const previousHeading = (() => {
          let sibling = card.previousElementSibling;
          while (sibling) {
            if (isHeading(sibling)) return sibling;
            sibling = sibling.previousElementSibling;
          }
          return null;
        })();
        const headingId = previousHeading?.id ?? "";
        const headingItem = headingId ? tocHeadingItems.get(headingId) : undefined;
        const headingDepth = previousHeading?.tagName === "H3" ? 4 : 3;
        item.className = `toc-depth-${headingDepth} math-toc-entry`;
        item.dataset.mathToc = id;
        const link = document.createElement("a");
        link.href = `#${id}`;
        link.dataset.tocLink = id;
        link.textContent = title;
        item.append(link);
        if (!headingItem) {
          tocList.append(item);
          return;
        }
        let subList = headingId ? tocSubLists.get(headingId) : undefined;
        if (!subList) {
          subList = document.createElement("ol");
          subList.className = "math-toc-sublist";
          headingItem.append(subList);
          if (headingId) tocSubLists.set(headingId, subList);
        }
        subList.append(item);
      });
    }
  }
</script>
