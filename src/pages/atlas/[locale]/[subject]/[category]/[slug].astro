---
/** 個別記事ページ */
import { render } from "astro:content";
import AtlasLayout from "../../../../../layouts/AtlasLayout.astro";
import Breadcrumb from "../../../../../components/Breadcrumb.astro";
import HistoryStageControl from "../../../../../components/HistoryStageControl.astro";
import { atlasPath, articlePath, formatDate } from "../../../../../lib/site";
import {
  t,
  LOCALES,
  localizedName,
  localeNames,
  type Locale,
} from "../../../../../lib/i18n";
import {
  getPublishedArticles,
  getPublishedSubjects,
  getConcepts,
  indexArticlesByConcept,
  prerequisiteArticles,
  relatedArticles,
  nextArticles,
  translationArticles,
} from "../../../../../lib/content";
import { buildArticleStatementIndex } from "../../../../../lib/article-reference-index.mjs";
import {
  articleReferenceAnchor,
  formatArticleReference,
} from "../../../../../lib/article-references.mjs";
import { ORG } from "../../../../../lib/site";
import "katex/dist/katex.min.css";

export async function getStaticPaths() {
  const articles = await getPublishedArticles();
  return articles.map((a) => ({
    params: {
      locale: a.data.locale,
      subject: a.data.subject,
      category: a.data.category,
      slug: a.data.slug,
    },
    props: { entry: a },
  }));
}

const { entry } = Astro.props;
const locale = entry.data.locale as Locale;
const { Content, headings } = await render(entry);

const { map } = await getConcepts();
const sameLocale = await getPublishedArticles(locale);
const all = await getPublishedArticles();
const byConcept = indexArticlesByConcept(sameLocale);

const statementIndex = buildArticleStatementIndex(all).map((statement) => ({
  ...statement,
  href: articlePath(
    statement.locale,
    statement.subject,
    statement.category,
    statement.slug,
  ),
}));
const serializedStatementIndex = JSON.stringify(statementIndex).replace(
  /</g,
  "\\u003c",
);
const serializedReferenceIndex = JSON.stringify(
  entry.data.references.flatMap((reference, index) =>
    reference.id ? [{ id: reference.id, number: index + 1 }] : [],
  ),
).replace(/</g, "\\u003c");

const prereqs = prerequisiteArticles(entry, map, byConcept);
const related = relatedArticles(entry, map, byConcept);
const next = nextArticles(entry, map, byConcept, sameLocale);
const translations = translationArticles(entry, all);

const subjects = await getPublishedSubjects();
const subject = subjects.find((s) => s.data.slug === entry.data.subject);
const category = subject?.data.categories.find(
  (c) => c.slug === entry.data.category,
);
const subjectName = subject
  ? localizedName(subject.data.name, locale)
  : entry.data.subject;
const categoryName = category
  ? localizedName(category.name, locale)
  : entry.data.category;

/**
 * 目次は h3 まで拾う。ただし漢字記事の「【一字】」「【熟語】」のように
 * どのセクションにも同じ名前で現れる構造ラベルは、並べても道しるべにならず
 * 目次を埋めてしまうだけなので除く。
 */
const isStructuralLabel = (text: string) => /^【.+】$/u.test(text.trim());
const toc = headings.filter(
  (h) => h.depth <= 3 && !(h.depth === 3 && isStructuralLabel(h.text)),
);

/** 言語切替: 対応記事があればそこへ、なければ各言語の総合ホームへ */
const localeSwitchHrefs: Record<string, string> = {};
for (const l of LOCALES) {
  if (l === locale) continue;
  const targets = translations.get(l);
  if (targets && targets.length > 0 && targets[0]) {
    const tgt = targets[0];
    localeSwitchHrefs[l] = articlePath(
      l,
      tgt.data.subject,
      tgt.data.category,
      tgt.data.slug,
    );
  }
}

const alternates = [...translations.entries()].flatMap(([l, arts]) =>
  arts.length > 0 && arts[0]
    ? [
        {
          hreflang: l,
          href: new URL(
            articlePath(
              l,
              arts[0].data.subject,
              arts[0].data.category,
              arts[0].data.slug,
            ),
            Astro.site,
          ).href,
        },
      ]
    : [],
);

const conceptNames = entry.data.concepts.map((c) => {
  const node = map.get(c.id);
  return { id: c.id, name: node ? localizedName(node.name, locale) : c.id };
});
const tocLabel = (text: string) =>
  text
    // 目次の文字列はMarkdown由来の生テキストなので、数式を再解釈させない。
    // `$G$` が描画環境によって「GGG」のように崩れるのを避ける。
    .replace(/\$([^$]+)\$/g, "$1")
    .replace(/\\(?:mathrm|mathbb|operatorname|mathop|text)\{([^}]+)\}/g, "$1")
    .replace(/\\[a-zA-Z]+/g, "")
    .replace(/[{}]/g, "");

const historyUrl = `${ORG.githubRepo}/commits/main/src/content/articles/${entry.id}.md`;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: entry.data.title,
  description: entry.data.summary,
  inLanguage: locale,
  dateModified: entry.data.updatedAt.toISOString(),
  datePublished: entry.data.createdAt.toISOString(),
  // frontmatter の authors は "atlas-math-team" のような内部IDなので、
  // 人名として出さず団体を著者にする。
  author: { "@type": "Organization", name: "Atlasez" },
  publisher: { "@type": "Organization", name: "Atlasez" },
};

---

<AtlasLayout
  locale={locale}
  title={entry.data.title}
  description={entry.data.summary}
  ogType="article"
  alternates={alternates}
  structuredData={structuredData}
  localeSwitchHrefs={localeSwitchHrefs}
>
  {/* 記事のどこまで読んだかを示す帯。装飾なので支援技術からは隠す */}
  <div class="reading-progress" aria-hidden="true">
    <div class="reading-progress-bar" data-reading-progress></div>
  </div>

  <div
    class={`container article-layout${toc.length === 0 ? " article-layout-no-toc" : ""}`}
  >
    {/* 左: 記事内目次（デスクトップは固定、モバイルは折り畳み） */}
    {
      toc.length > 0 && (
        <>
          <nav class="article-toc" id="article-toc" aria-label={t(locale, "toc")}>
            <details class="toc-details" open>
              <summary>{t(locale, "toc")}</summary>
              <ol class="details-body toc-list">
                {
                  toc.map((h) => (
                    <li class={`toc-depth-${h.depth}`}>
                      <a href={`#${h.slug}`} data-toc-link={h.slug}>
                        {tocLabel(h.text)}
                      </a>
                    </li>
                  ))
                }
              </ol>
            </details>
          </nav>
          <button type="button" class="mobile-toc-trigger" data-mobile-toc>
            {t(locale, "toc")}
          </button>
        </>
      )
    }

    {/* 中央: 本文（Pagefindの検索対象） */}
    <article class="article-main" data-pagefind-body>
      <Breadcrumb
        items={[
          { label: t(locale, "breadcrumbHome"), href: atlasPath(locale) },
          { label: subjectName, href: atlasPath(locale, entry.data.subject) },
          {
            label: categoryName,
            href: atlasPath(locale, entry.data.subject, entry.data.category),
          },
          { label: entry.data.title },
        ]}
      />
      <div class="visually-hidden">
        {/* Pagefind用のフィルタ・メタデータ（検索の絞り込みに使用） */}
        <span data-pagefind-filter="subject">{subjectName}</span>
        <span data-pagefind-filter="category">{categoryName}</span>
        <span data-pagefind-filter="locale">{localeNames[locale]}</span>
        <span data-pagefind-meta="summary">{entry.data.summary}</span>
        {entry.data.aliases.map((al) => <span>{al}</span>)}
        {entry.data.tags.map((tag) => <span>{tag}</span>)}
        {entry.data.concepts.map((c) => <span>{c.id}</span>)}
      </div>
      {
        conceptNames.length > 0 && (
          <section
            class="article-concept-nodes"
            aria-label={locale === "ja" ? "この記事の主要概念" : "Main concepts in this article"}
          >
            <span>{locale === "ja" ? "主要概念" : "Main concepts"}</span>
            <div>
              {
                conceptNames.map((concept) => (
                  <a
                    href={`${atlasPath(locale, "map")}?subject=${encodeURIComponent(entry.data.subject)}&category=${encodeURIComponent(`${entry.data.subject}/${entry.data.category}`)}&selected=${encodeURIComponent(concept.id)}`}
                  >
                    {concept.name}
                  </a>
                ))
              }
            </div>
          </section>
        )
      }
      <header class="article-header">
        <h1 id="article-title">{entry.data.title}</h1>
        {/* 要約は本文冒頭と重複しがちなので記事ページでは出さない。
            一覧ページ・検索結果・meta description では引き続き使う。 */}
        <p class="article-badges">
          <span class="badge">
            {t(locale, "updatedAt")}:
            <time datetime={entry.data.updatedAt.toISOString().slice(0, 10)}>
              {formatDate(entry.data.updatedAt, locale)}
            </time>
          </span>
        </p>
        {/* 「あとで読む」= これから読むもの / 「読んだ・理解した」= 済んだもの */}
        <div
          class="article-actions"
          data-article-actions
          data-article-id={entry.data.articleId}
          data-locale={locale}
          data-title={entry.data.title}
          data-href={articlePath(
            locale,
            entry.data.subject,
            entry.data.category,
            entry.data.slug,
          )}
          data-subject={subjectName}
          data-category={categoryName}
          data-subject-slug={entry.data.subject}
          data-category-slug={entry.data.category}
          data-summary={entry.data.summary}
        >
          <button
            type="button"
            class="bookmark-btn"
            data-bookmark-toggle
            data-label-save={t(locale, "saveForLater")}
            data-label-saved={t(locale, "saved")}
            aria-pressed="false"
          >
            <span data-bookmark-icon aria-hidden="true">☆</span>
            <span data-bookmark-label>{t(locale, "saveForLater")}</span>
          </button>
          <HistoryStageControl locale={locale} />
        </div>
        {
          [...translations.entries()].length > 0 && (
            <p class="translation-info">
              {t(locale, "availableIn")}:
              {[...translations.entries()].map(([l, arts]) => (
                <span class="translation-links">
                  {arts.map((a2) => (
                    <a
                      href={articlePath(
                        l,
                        a2.data.subject,
                        a2.data.category,
                        a2.data.slug,
                      )}
                      hreflang={l}
                      lang={l}
                    >
                      {localeNames[l]}: {a2.data.title}
                    </a>
                  ))}
                </span>
              ))}
            </p>
          )
        }
      </header>

      <script
        type="application/json"
        data-article-statement-index
        set:html={serializedStatementIndex}
      />
      <script
        type="application/json"
        data-article-reference-index
        set:html={serializedReferenceIndex}
      />

      {
        entry.data.exerciseIds.pre.length > 0 && (
          <div class="article-exercise" role="note">
            <span class="badge">
              {t(locale, "preExercise")}（{t(locale, "preparing")}）
            </span>
          </div>
        )
      }

      <div class="article-body reading">
        <Content />
      </div>

      <div class="article-bottom-history">
        <HistoryStageControl locale={locale} />
      </div>

      {
        entry.data.exerciseIds.post.length > 0 && (
          <div class="article-exercise" role="note">
            <span class="badge">
              {t(locale, "postExercise")}（{t(locale, "preparing")}）
            </span>
          </div>
        )
      }

      <section aria-labelledby="refs-heading" class="article-refs">
        <h2 id="refs-heading">{t(locale, "references")}</h2>
        {
          entry.data.references.length > 0 ? (
            <ol>
              {entry.data.references.map((r) => (
                <li
                  id={r.id ? articleReferenceAnchor(r.id) : undefined}
                  data-reference-id={r.id}
                >
                  {r.url ? (
                    <a href={r.url} rel="noopener noreferrer" target="_blank">
                      {formatArticleReference(r)}
                    </a>
                  ) : (
                    formatArticleReference(r)
                  )}
                  {r.note ? <small> {r.note}</small> : null}
                </li>
              ))}
            </ol>
          ) : (
            <p class="reference-status">
              {locale === "ja"
                ? "この記事には参考文献がまだ登録されていません。内容を検証する際は、記事下部の報告リンクをご利用ください。"
                : "No references have been registered for this article yet."}
            </p>
          )
        }
      </section>

      {
        toc.length > 2 && (
          <p class="back-to-toc">
            <a href="#article-toc">
              {locale === "ja" ? "↑ 目次へ戻る" : "↑ Back to contents"}
            </a>
          </p>
        )
      }

      <footer class="article-footer">
        <div class="article-footer-links">
          <section class="issue-report" aria-labelledby="issue-report-heading">
            <h2 id="issue-report-heading">{t(locale, "reportIssue")}</h2>
            <p class="issue-report-note">
              {locale === "ja"
                ? "記事名・URLは自動で添付されます。誤りや改善案をこの画面からお送りください。"
                : "The article title and URL are attached automatically. Send an error report or suggestion here."}
            </p>
            <form
              class="issue-report-form"
              data-issue-report-form
              data-article-title={entry.data.title}
              data-article-id={entry.data.articleId}
              data-article-subject={entry.data.subject}
              data-article-category={entry.data.category}
              data-locale={locale}
            >
              <div class="issue-report-fields">
                <label>
                  {locale === "ja" ? "報告の種類" : "Report type"}
                  <select name="reportType" required>
                    <option value="error">{locale === "ja" ? "誤り・誤植" : "Error or typo"}</option>
                    <option value="suggestion">{locale === "ja" ? "改善の提案" : "Suggestion"}</option>
                    <option value="reference">{locale === "ja" ? "出典・参考文献" : "Reference"}</option>
                    <option value="other">{locale === "ja" ? "その他" : "Other"}</option>
                  </select>
                </label>
                <label>
                  {locale === "ja" ? "内容" : "Details"}
                  <textarea
                    name="details"
                    rows="5"
                    required
                    maxlength="6000"
                    placeholder={locale === "ja" ? "該当箇所と、どのように修正すべきかをお書きください。" : "Describe the relevant section and the proposed correction."}
                  ></textarea>
                </label>
                <label>
                  {locale === "ja" ? "返信先（任意）" : "Reply address (optional)"}
                  <input name="contact" type="email" maxlength="320" autocomplete="email" />
                </label>
                <label class="issue-report-trap" aria-hidden="true">
                  Website
                  <input name="website" type="text" tabindex="-1" autocomplete="off" />
                </label>
              </div>
              <div class="issue-report-actions">
                <button type="submit" class="button">
                  {locale === "ja" ? "報告を送信" : "Send report"}
                </button>
                <p data-issue-report-status aria-live="polite"></p>
              </div>
            </form>
          </section>
          <a href={historyUrl} rel="noopener noreferrer" target="_blank">
            {t(locale, "editOnGitHub")}
          </a>
        </div>
      </footer>
    </article>

    {/* 右: 記事情報・関連 */}
    <aside class="article-aside" aria-label={locale === "ja" ? "記事情報" : "Article info"}>
      <section>
        <h2>{locale === "ja" ? "記事情報" : "Article info"}</h2>
        <dl class="meta-list">
          {
            /* 執筆者は frontmatter に "atlas-math-team" のような内部IDしか
               入っておらず、読者にとって意味をなさないので表示しない。
               実名で載せられるようになったら復活させる。 */
          }
          <dt>{t(locale, "conceptsCovered")}</dt>
          <dd>
            <ul class="concept-list">
              {conceptNames.map((c) => <li>{c.name}</li>)}
            </ul>
          </dd>
        </dl>
      </section>
      {
        prereqs.length > 0 && (
          <section>
            <h2>{t(locale, "prerequisiteArticles")}</h2>
            <ul class="aside-links">
              {prereqs.map((a) => (
                <li>
                  <a
                    href={articlePath(
                      locale,
                      a.data.subject,
                      a.data.category,
                      a.data.slug,
                    )}
                  >
                    {a.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
      {
        next.length > 0 && (
          <section>
            <h2>{t(locale, "nextArticles")}</h2>
            <ul class="aside-links">
              {next.map((a) => (
                <li>
                  <a
                    href={articlePath(
                      locale,
                      a.data.subject,
                      a.data.category,
                      a.data.slug,
                    )}
                  >
                    {a.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
      {
        related.length > 0 && (
          <section>
            <h2>{t(locale, "relatedArticles")}</h2>
            <ul class="aside-links">
              {related.map((a) => (
                <li>
                  <a
                    href={articlePath(
                      locale,
                      a.data.subject,
                      a.data.category,
                      a.data.slug,
                    )}
                  >
                    {a.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </aside>
  </div>
</AtlasLayout>

<style>
  /*
   * 読み進み具合の帯。画面上端に固定し、記事本文の位置に応じて伸びる。
   * 高さ 3px の装飾なので、内容は目次の現在地強調（scroll-spy）が担う。
   */
  .reading-progress {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 40;
    height: 3px;
    background: transparent;
    pointer-events: none;
  }
  .reading-progress-bar {
    width: 0;
    height: 100%;
    background: var(--accent-primary);
    transition: width 80ms linear;
  }
  [data-pref-motion="reduced"] .reading-progress-bar {
    transition: none;
  }

  .article-bottom-history {
    display: flex;
    justify-content: flex-end;
    margin-top: var(--space-5);
    padding-top: var(--space-3);
    border-top: 1px solid var(--border-default);
  }

  .back-to-toc {
    margin-top: var(--space-4);
    font-size: calc(0.9rem * var(--text-scale));
  }
  .article-concept-nodes {
    display: grid;
    gap: var(--space-1);
    margin: var(--space-3) 0;
  }
  .article-concept-nodes > span {
    color: var(--text-secondary);
    font-size: calc(.82rem * var(--text-scale));
    font-weight: 700;
  }
  .article-concept-nodes > div {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .article-concept-nodes a {
    border: 1px solid var(--accent-primary);
    border-radius: var(--radius);
    color: var(--text-primary);
    padding: .35rem .6rem;
    text-decoration: none;
  }
  .article-concept-nodes a:hover {
    background: var(--accent-primary);
    color: var(--background-primary);
  }

  /* 本文カラムを広く取るため、コンテナ幅を広げ左右カラムを絞っている */
  .article-layout {
    display: grid;
    grid-template-columns: 12.5rem minmax(0, 1fr) 14rem;
    gap: var(--space-4);
    align-items: start;
    max-width: 86rem;
  }
  .article-layout-no-toc {
    grid-template-columns: minmax(0, 1fr) 14rem;
  }
  .article-toc {
    position: sticky;
    top: var(--space-3);
    font-size: calc(0.9rem * var(--text-scale));
    max-height: calc(100vh - var(--space-5));
    overflow-y: auto;
  }
  .toc-list {
    list-style: none;
    margin: 0;
    padding: var(--space-2);
  }
  .toc-list a {
    display: block;
    padding: var(--space-1) var(--space-2);
    text-decoration: none;
    color: var(--text-secondary);
    border-left: 3px solid transparent;
  }
  .toc-list a:hover {
    color: var(--accent-primary);
  }
  .toc-list a[aria-current="true"] {
    border-left-color: var(--accent-primary);
    color: var(--accent-primary);
    font-weight: 600;
    background: var(--accent-subtle);
  }
  .toc-depth-3 a {
    padding-left: var(--space-4);
  }
  .article-header {
    padding-bottom: var(--space-3);
    border-bottom: 2px solid var(--accent-primary);
  }
  .article-header h1 {
    margin-bottom: var(--space-2);
  }
  .article-badges {
    display: flex;
    gap: var(--space-1);
    flex-wrap: wrap;
  }
  .article-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }
  .bookmark-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--accent-primary);
    border-radius: var(--radius, 4px);
    background: transparent;
    color: var(--accent-primary);
    font: inherit;
    font-size: calc(0.9rem * var(--text-scale));
    cursor: pointer;
  }
  .bookmark-btn:hover {
    background: var(--accent-subtle);
  }
  .bookmark-btn[aria-pressed="true"] {
    background: var(--accent-primary);
    color: var(--bg, #fff);
  }
  /* 学習の記録は「あとで読む」と役割が違うので、枠線の色で区別する */
  .history-btn {
    border-color: var(--border-strong);
    color: var(--text-secondary);
  }
  .history-btn:hover {
    border-color: var(--accent-primary);
    color: var(--accent-primary);
  }
  .translation-info {
    font-size: calc(0.9rem * var(--text-scale));
  }
  .translation-links {
    margin-inline-start: var(--space-2);
  }
  .article-exercise {
    margin-block: var(--space-3);
  }
  .article-refs,
  .article-footer {
    max-width: var(--reading-width);
    margin-top: var(--space-5);
    font-size: calc(0.9rem * var(--text-scale));
  }
  .article-refs li {
    scroll-margin-top: 5rem;
    margin-block: var(--space-1);
  }
  .article-refs li:target {
    background: var(--background-secondary);
    border-radius: var(--radius-sm);
    outline: 2px solid var(--accent-primary);
    outline-offset: .2rem;
  }
  .article-refs small {
    color: var(--text-secondary);
  }
  .article-citation {
    font-weight: 700;
    margin-inline: .08em;
    text-decoration: none;
  }
  .article-citation-missing {
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: .9em;
  }
  .issue-report {
    width: min(100%, 48rem);
    margin-bottom: var(--space-2);
    border: 1px solid var(--border-default);
    border-radius: var(--radius);
    background: var(--background-secondary);
  }
  .article-footer-links {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
  }
  .issue-report h2 {
    margin: 0;
    padding: var(--space-3) var(--space-3) 0;
    color: var(--text-primary);
    font-size: calc(1rem * var(--text-scale));
  }
  .issue-report-note {
    margin: 0;
    padding: 0 var(--space-3) var(--space-2);
    color: var(--text-secondary);
    font-size: calc(0.86rem * var(--text-scale));
  }
  .issue-report-form {
    margin: var(--space-2) var(--space-3) var(--space-3);
    width: calc(100% - var(--space-6));
  }
  .issue-report-fields {
    display: grid;
    gap: var(--space-2);
  }
  .issue-report-fields label {
    display: grid;
    gap: var(--space-1);
    color: var(--text-primary);
    font-weight: 600;
  }
  .issue-report-fields select,
  .issue-report-fields input,
  .issue-report-fields textarea {
    width: 100%;
    border: 1px solid var(--border-strong);
    border-radius: calc(var(--radius) - 2px);
    background: var(--background-primary);
    color: var(--text-primary);
    font: inherit;
    font-weight: 400;
  }
  .issue-report-fields textarea {
    min-height: 7rem;
    resize: vertical;
  }
  .issue-report-trap {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  .issue-report-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }
  .issue-report-actions p {
    margin: 0;
    color: var(--text-secondary);
    font-size: calc(0.86rem * var(--text-scale));
  }
  .issue-report-actions p[data-state="success"] {
    color: var(--accent-primary);
  }
  .issue-report-actions p[data-state="error"] {
    color: #a12828;
  }
  .article-aside {
    position: sticky;
    top: var(--space-3);
    font-size: calc(0.9rem * var(--text-scale));
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .article-aside section {
    border: 0;
    border-top: 2px solid var(--accent-primary);
    border-radius: 0;
    padding: var(--space-2) 0 var(--space-3);
  }
  .article-aside h2 {
    font-size: calc(0.95rem * var(--text-scale));
    margin: 0 0 var(--space-2);
  }
  .aside-links,
  .concept-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .meta-list {
    margin: 0;
  }
  .meta-list dt {
    font-weight: 600;
    color: var(--text-secondary);
  }
  .meta-list dd {
    margin: 0 0 var(--space-2);
  }
  /* タブレット以下: 1カラム。目次は本文の「上」に折り畳みで置く。
     本文の下に置くと読み始める前に見出しを見渡せず、目次の役に立たない。 */
  @media (max-width: 1023px) {
    .article-layout {
      grid-template-columns: minmax(0, 1fr);
    }
    .article-toc {
      position: static;
      max-height: none;
      overflow: visible;
      order: 0;
    }
    .article-main {
      order: 1;
    }
    .article-aside {
      position: static;
      order: 2;
    }
    /* 折り畳みの見出しは押せる帯として見せる */
    .toc-details {
      border: 1px solid var(--border-default);
      border-radius: var(--radius);
    }
    .toc-details > summary {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      min-height: var(--touch-target);
      padding: 0 var(--space-3);
      background: var(--background-secondary);
      font-weight: 700;
      cursor: pointer;
      list-style: none;
    }
    .toc-details > summary::-webkit-details-marker {
      display: none;
    }
    /* 開閉の向きが分かる三角 */
    .toc-details > summary::before {
      content: "▸";
      color: var(--text-secondary);
    }
    .toc-details[open] > summary::before {
      content: "▾";
    }
    .toc-details[open] summary ~ * {
      display: block;
    }
    /* 見出しが多い記事でも本文が押し下がりすぎないようにする */
    .toc-details[open] .toc-list {
      max-height: 50vh;
      overflow-y: auto;
    }
  }
  @media (max-width: 767px) {
    /* 別行立ての数式は画面幅を超えるので、その式だけ横に送れるようにする */
    .article-body :global(.katex-display) {
      overflow-x: auto;
      overflow-y: hidden;
    }
    /* 記事情報・関連の枠は狭い画面では余白を詰める */
    .article-aside section {
      padding-top: var(--space-2);
    }
    .article-header h1 {
      overflow-wrap: break-word;
    }
    .bookmark-btn {
      width: 100%;
      justify-content: center;
    }
    .mobile-toc-trigger {
      position: fixed;
      right: var(--space-3);
      bottom: calc(var(--space-3) + env(safe-area-inset-bottom));
      z-index: 20;
      min-height: 2.75rem;
      border: 1px solid var(--accent-primary);
      border-radius: 999px;
      background: var(--background-primary);
      box-shadow: var(--shadow);
      color: var(--accent-primary);
      font-weight: 700;
      padding: 0 var(--space-3);
    }
    /* 学習の記録のトグルも横幅いっぱいに広げ、2段で分け合う */
    .history-steps {
      display: flex;
      width: 100%;
    }
    .history-step {
      flex: 1 1 0;
      justify-content: center;
      padding: 0 var(--space-1);
    }
  }
  @media (min-width: 1024px) {
    .toc-details {
      border: 0;
    }
    .toc-details summary {
      padding-left: 0;
    }
    .toc-details[open] > summary {
      border-bottom: 0;
    }
  }
  @media (min-width: 768px) {
    .mobile-toc-trigger { display: none; }
  }
</style>

<script>
  // 匿名の利用統計。個人情報や端末識別子を送らず、記事ごとの日別集計だけを残す。
  const analyticsActions = document.querySelector<HTMLElement>("[data-article-actions]");
  const analyticsArticleBody = document.querySelector<HTMLElement>(".article-body");
  if (analyticsActions && analyticsArticleBody) {
    const data = analyticsActions.dataset;
    const analyticsPayload = {
      articleId: data.articleId ?? "",
      articleTitle: data.title ?? "",
      subject: data.subjectSlug ?? "",
      category: data.categorySlug ?? "",
      locale: data.locale ?? "ja",
    };
    const sent = new Set<string>();
    const endpoint = window.location.hostname === "mitukx.github.io"
      ? "https://atlasez-web-1.ukyoukay0.workers.dev/api/article-analytics"
      : "/api/article-analytics";
    const track = (event: "view" | "engaged" | "complete") => {
      if (sent.has(event)) return;
      sent.add(event);
      void fetch(endpoint, {
        method: "POST",
        keepalive: true,
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ ...analyticsPayload, event }),
      }).catch(() => {
        // 統計送信の失敗は記事閲覧を妨げない。
      });
    };
    track("view");
    window.setTimeout(() => {
      if (document.visibilityState === "visible") track("engaged");
    }, 15_000);
    const checkCompletion = () => {
      const threshold = analyticsArticleBody.offsetTop + analyticsArticleBody.offsetHeight * 0.9;
      if (window.scrollY + window.innerHeight >= threshold) track("complete");
    };
    window.addEventListener("scroll", checkCompletion, { passive: true });
    window.addEventListener("resize", checkCompletion);
    checkCompletion();
  }
</script>

<script>
  // 記事本文のどこまで来たかを画面上端の帯で示す
  const progressBar = document.querySelector<HTMLElement>("[data-reading-progress]");
  const articleBody = document.querySelector<HTMLElement>(".article-body");

  if (progressBar && articleBody) {
    const update = () => {
      const rect = articleBody.getBoundingClientRect();
      const total = rect.height - window.innerHeight;
      // 本文が画面より短い記事では帯を出しても意味がないので 0 のままにする
      const ratio = total <= 0 ? 0 : (-rect.top / total) * 100;
      progressBar.style.width = `${Math.min(100, Math.max(0, ratio))}%`;
    };
    update();
    window.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update);
  }

  // 現在読んでいる見出しを目次で強調する（scroll-spy）
  const links = new Map<string, HTMLAnchorElement>();
  document
    .querySelectorAll<HTMLAnchorElement>("[data-toc-link]")
    .forEach((a) => {
      const id = a.dataset.tocLink;
      if (id) links.set(id, a);
    });
  const headings = [...links.keys()]
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);

  if ("IntersectionObserver" in window && headings.length > 0) {
    let currentId: string | null = null;
    const observer = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            currentId = e.target.id;
          }
        }
        if (currentId) {
          links.forEach((a, id) => {
            if (id === currentId) a.setAttribute("aria-current", "true");
            else a.removeAttribute("aria-current");
          });
        }
      },
      { rootMargin: "0px 0px -70% 0px" },
    );
    headings.forEach((h) => observer.observe(h));
  }

  // モバイルでは目次を初期状態で閉じる
  const mq = window.matchMedia("(max-width: 1023px)");
  const details = document.querySelector<HTMLDetailsElement>(".toc-details");
  if (details && mq.matches) details.open = false;
  document.querySelector<HTMLButtonElement>("[data-mobile-toc]")?.addEventListener("click", () => {
    if (!details) return;
    details.open = true;
    document.getElementById("article-toc")?.scrollIntoView({ behavior: "smooth", block: "start" });
    window.setTimeout(() => details.querySelector<HTMLAnchorElement>("a")?.focus(), 350);
  });
</script>

<script>
  const reportForm = document.querySelector<HTMLFormElement>("[data-issue-report-form]");
  if (reportForm) {
    reportForm.dataset.openedAt = String(Date.now());
    const status = reportForm.querySelector<HTMLElement>("[data-issue-report-status]");
    const submit = reportForm.querySelector<HTMLButtonElement>('button[type="submit"]');
    const isJapanese = reportForm.dataset.locale === "ja";
    reportForm.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!reportForm.reportValidity()) return;

      const values = new FormData(reportForm);
      const setStatus = (message: string, state: "success" | "error" | "sending") => {
        if (!status) return;
        status.textContent = message;
        status.dataset.state = state;
      };
      submit?.setAttribute("disabled", "");
      setStatus(isJapanese ? "送信しています…" : "Sending…", "sending");
      try {
        const reportEndpoint = window.location.hostname === "mitukx.github.io"
          ? "https://atlasez-web-1.ukyoukay0.workers.dev/api/article-reports"
          : "/api/article-reports";
        const response = await fetch(reportEndpoint, {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({
            articleTitle: reportForm.dataset.articleTitle,
            articleUrl: window.location.href,
            articleId: reportForm.dataset.articleId,
            subject: reportForm.dataset.articleSubject,
            category: reportForm.dataset.articleCategory,
            locale: reportForm.dataset.locale,
            openedAt: reportForm.dataset.openedAt,
            reportType: values.get("reportType"),
            details: values.get("details"),
            contact: values.get("contact"),
            website: values.get("website"),
          }),
        });
        const contentType = response.headers.get("content-type") ?? "";
        const result = contentType.includes("application/json")
          ? (await response.json()) as { ok?: boolean; error?: string }
          : undefined;
        if (!response.ok || !result?.ok) {
          throw new Error(result?.error ?? (isJapanese
            ? "送信先に接続できませんでした。時間をおいて再度お試しください。"
            : "The report endpoint is unavailable. Please try again later."));
        }
        reportForm.reset();
        setStatus(isJapanese ? "送信しました。ご協力ありがとうございます。" : "Report sent. Thank you.", "success");
      } catch (error) {
        const message = error instanceof Error && error.message
          ? error.message
          : isJapanese ? "送信できませんでした。時間をおいて再度お試しください。" : "Could not send the report. Please try again later.";
        setStatus(message, "error");
      } finally {
        submit?.removeAttribute("disabled");
      }
    });
  }
</script>

<script>
  // 「あとで読む」と「読んだ・理解した」の状態反映とトグル
  import { toggleBookmark, isBookmarked } from "../../../../../lib/bookmarks";
  import {
    historyStateOf,
    setHistoryState,
    HISTORY_STAGES,
    type HistoryState,
  } from "../../../../../lib/history";

  const actions = document.querySelector<HTMLElement>("[data-article-actions]");
  if (actions) {
    const d = actions.dataset;
    const articleId = d.articleId ?? "";
    // 3つのボタンで同じ記事情報を使う
    const entry = {
      articleId,
      locale: d.locale ?? "",
      title: d.title ?? "",
      href: d.href ?? "",
      subject: d.subject ?? "",
      category: d.category ?? "",
      summary: d.summary ?? "",
    };

    const bookmarkBtn = actions.querySelector<HTMLButtonElement>(
      "[data-bookmark-toggle]",
    );
    if (bookmarkBtn) {
      const bd = bookmarkBtn.dataset;
      const labelEl =
        bookmarkBtn.querySelector<HTMLElement>("[data-bookmark-label]");
      const iconEl =
        bookmarkBtn.querySelector<HTMLElement>("[data-bookmark-icon]");

      const renderBookmark = (on: boolean) => {
        bookmarkBtn.setAttribute("aria-pressed", on ? "true" : "false");
        if (labelEl) {
          labelEl.textContent = on ? (bd.labelSaved ?? "") : (bd.labelSave ?? "");
        }
        if (iconEl) iconEl.textContent = on ? "★" : "☆";
      };

      renderBookmark(isBookmarked(articleId));
      bookmarkBtn.addEventListener("click", () => {
        renderBookmark(toggleBookmark(entry));
      });
    }

    const historyToggles = [
      ...document.querySelectorAll<HTMLButtonElement>(
        "[data-history-stage-toggle]",
      ),
    ];
    const historyControls = [
      ...document.querySelectorAll<HTMLElement>(
        "[data-history-stage-control]",
      ),
    ];
    const states: Array<HistoryState | null> = [
      null,
      ...HISTORY_STAGES.map((stage) => stage.id),
    ];
    const stateLabels = [
      historyToggles[0]?.dataset.labelNone ?? "",
      historyToggles[0]?.dataset.labelRead ?? "",
      historyToggles[0]?.dataset.labelUnderstood ?? "",
    ];
    const renderHistory = (state: HistoryState | null) => {
      const index = states.indexOf(state);
      historyToggles.forEach((toggle) => {
        toggle.dataset.state = state ?? "none";
        toggle.setAttribute("aria-valuenow", String(index));
        toggle.setAttribute("aria-valuetext", stateLabels[index] ?? "");
      });
      historyControls.forEach((control) => {
        control.dataset.state = state ?? "none";
      });
    };

    let currentState = historyStateOf(articleId);
    renderHistory(currentState);
    const moveTo = (index: number) => {
      const bounded = Math.max(0, Math.min(states.length - 1, index));
      currentState = setHistoryState(entry, states[bounded]);
      renderHistory(currentState);
    };
    historyToggles.forEach((historyToggle) => {
      historyToggle.addEventListener("click", (event) => {
        // ポインター操作では、触れた位置に最も近い段階へレバーを移す。
        // キーボードによる click は座標を持たないため、従来どおり1段進める。
        if (event.detail === 0) {
          const currentIndex = states.indexOf(currentState);
          moveTo((currentIndex + 1) % states.length);
          return;
        }
        const rect = historyToggle.getBoundingClientRect();
        const ratio = Math.max(
          0,
          Math.min(1, (event.clientX - rect.left) / rect.width),
        );
        moveTo(Math.round(ratio * (states.length - 1)));
      });
      historyToggle.addEventListener("keydown", (event) => {
        const currentIndex = states.indexOf(currentState);
        if (event.key === "ArrowRight" || event.key === "ArrowUp") {
          event.preventDefault();
          moveTo(currentIndex + 1);
        } else if (event.key === "ArrowLeft" || event.key === "ArrowDown") {
          event.preventDefault();
          moveTo(currentIndex - 1);
        } else if (event.key === "Home") {
          event.preventDefault();
          moveTo(0);
        } else if (event.key === "End") {
          event.preventDefault();
          moveTo(states.length - 1);
        }
      });
    });

  }
</script>
