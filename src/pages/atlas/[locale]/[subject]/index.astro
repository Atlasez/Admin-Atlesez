---
import AtlasLayout from "../../../../layouts/AtlasLayout.astro";
import Breadcrumb from "../../../../components/Breadcrumb.astro";
import LearningMap from "../../../../components/LearningMap.astro";
import { atlasPath, articlePath } from "../../../../lib/site";
import {
  t,
  LOCALES,
  localizedName,
  type Locale,
} from "../../../../lib/i18n";
import {
  getPublishedArticles,
  getPublishedSubjects,
} from "../../../../lib/content";
import {
  getPlannedArticles,
  plannedProgress,
  plannedArticleTitle,
} from "../../../../lib/planned";

export async function getStaticPaths() {
  const subjects = (await getPublishedSubjects()).filter(
    (s) => s.data.status === "published",
  );
  return LOCALES.flatMap((locale) =>
    subjects.map((s) => ({
      params: { locale, subject: s.data.slug },
      props: { subject: s },
    })),
  );
}

const locale = Astro.params.locale as Locale;
const { subject } = Astro.props;
const articles = await getPublishedArticles(locale);
const subjectArticles = articles.filter(
  (a) => a.data.subject === subject.data.slug,
);
const categories = [...subject.data.categories].sort(
  (a, b) => a.order - b.order,
);

/** 目次内の記事並び順: タイトル順 */
function sortForToc(list: typeof subjectArticles): typeof subjectArticles {
  return [...list].sort((a, b) =>
    a.data.title.localeCompare(b.data.title, "ja"),
  );
}

/** 分野全体の記事数（公開＋準備中） */
const totalPublished = subjectArticles.length;
const totalPlanned = getPlannedArticles(subject.data.slug).length;

const alternates = LOCALES.map((l) => ({
  hreflang: l,
  href: new URL(atlasPath(l, subject.data.slug), Astro.site).href,
}));
const subjectName = localizedName(subject.data.name, locale);

const categoryItems = categories.map((cat) => ({
  category: cat,
  articles: sortForToc(
    subjectArticles.filter((a) => a.data.category === cat.slug),
  ),
  planned: getPlannedArticles(subject.data.slug, cat.slug),
}));

const views = [
  { id: "tiles", label: t(locale, "tileView") },
  { id: "map", label: t(locale, "map") },
  { id: "list", label: t(locale, "listViewTab") },
] as const;

const summary =
  locale === "ja"
    ? `${categories.length}カテゴリ・${totalPublished}記事を公開中`
    : `${categories.length} categories · ${totalPublished} articles`;
---

<AtlasLayout
  locale={locale}
  title={subjectName}
  description={localizedName(subject.data.description, locale)}
  alternates={alternates}
  noindex={subjectArticles.length === 0}
  localeSwitchHrefs={Object.fromEntries(
    LOCALES.map((l) => [l, atlasPath(l, subject.data.slug)]),
  )}
>
  <div
    class="container subject-home"
    data-subject-layout
    data-view-storage-key={`atlasez-subject-view-v3:${subject.data.slug}`}
  >
    <Breadcrumb
      items={[
        { label: t(locale, "breadcrumbHome"), href: atlasPath(locale) },
        { label: subjectName },
      ]}
    />
    <h1>{subjectName}</h1>
    <p class="reading">{localizedName(subject.data.description, locale)}</p>

    <div class="view-bar">
      <div
        class="view-tabs"
        role="tablist"
        aria-label={t(locale, "viewSwitcher")}
        data-view-tabs
      >
        {
          views.map((view, index) => (
            <button
              type="button"
              role="tab"
              id={`subject-view-tab-${view.id}`}
              class="view-tab"
              data-view-tab={view.id}
              aria-selected={index === 0 ? "true" : "false"}
              aria-controls={`subject-view-panel-${view.id}`}
              tabindex={index === 0 ? undefined : "-1"}
            >
              {view.label}
            </button>
          ))
        }
      </div>
      <p class="section-meta">{summary}</p>
    </div>

    <div
      id="subject-view-panel-tiles"
      class="view-panel"
      role="tabpanel"
      aria-labelledby="subject-view-tab-tiles"
      data-view-panel="tiles"
    >
      <ul class="category-tiles">
        {
          categoryItems.map(({ category, articles, planned }) => (
            <li class="category-tile">
              <a href={atlasPath(locale, subject.data.slug, category.slug)}>
                <span class="category-name">
                  {localizedName(category.name, locale)}
                </span>
                <span class="category-counts">
                  <span>
                    {t(locale, "articles")}: {articles.length}
                  </span>
                  {planned.length > 0 && (
                    <span class="badge planned-count">
                      {t(locale, "preparing")}: {planned.length}
                    </span>
                  )}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div
      id="subject-view-panel-map"
      class="view-panel"
      role="tabpanel"
      aria-labelledby="subject-view-tab-map"
      data-view-panel="map"
    >
      <LearningMap locale={locale} subject={subject.data.slug} />
    </div>

    <div
      id="subject-view-panel-list"
      class="view-panel"
      role="tabpanel"
      aria-labelledby="subject-view-tab-list"
      data-view-panel="list"
    >
      <section class="subject-toc" aria-labelledby="toc-heading">
        <div class="toc-heading-row">
          <h2 id="toc-heading">
            {locale === "ja"
              ? `${subjectName}の目次`
              : `${subjectName} — Contents`}
          </h2>
          <span class="toc-total">
            {t(locale, "articles")}: {totalPublished}
            {totalPlanned > 0 && (
              <> / {t(locale, "preparing")}: {totalPlanned}</>
            )}
          </span>
        </div>

        <ol class="toc-categories">
          {
            categoryItems.map(({ category, articles, planned }) => {
              const empty = articles.length === 0 && planned.length === 0;
              return (
                <li class="toc-category">
                  <details
                    class="toc-category-details"
                    data-category={category.slug}
                    data-collapse-key={`list:category:${category.slug}`}
                  >
                    <summary class="toc-cat-head">
                      <h3>
                        <a
                          href={`${atlasPath(locale, subject.data.slug, category.slug)}?view=list`}
                        >
                          {localizedName(category.name, locale)}
                        </a>
                      </h3>
                      <span class="badge">
                        {t(locale, "articles")}: {articles.length}
                      </span>
                      {planned.length > 0 && (
                        <span class="badge planned-count">
                          {t(locale, "preparing")}: {planned.length}
                        </span>
                      )}
                    </summary>
                    <div class="toc-category-body">
                      {empty ? (
                        <p class="toc-empty">
                          <span class="badge">{t(locale, "preparing")}</span>
                        </p>
                      ) : (
                        <ol class="toc-articles">
                          {articles.map((a) => (
                            <li>
                              <a
                                href={articlePath(
                                  locale,
                                  a.data.subject,
                                  a.data.category,
                                  a.data.slug,
                                )}
                              >
                                {a.data.title}
                              </a>
                            </li>
                          ))}
                          {planned.map((item) => (
                            <li class="planned-article">
                              <span>{plannedArticleTitle(item, locale)}</span>
                              <span
                                class:list={[
                                  "badge",
                                  {
                                    "badge-accent":
                                      plannedProgress(item) === "in-progress",
                                  },
                                ]}
                              >
                                {plannedProgress(item) === "in-progress"
                                  ? t(locale, "progressInProgress")
                                  : t(locale, "progressNotStarted")}
                              </span>
                            </li>
                          ))}
                        </ol>
                      )}
                    </div>
                  </details>
                </li>
              );
            })
          }
        </ol>
      </section>
    </div>
  </div>
</AtlasLayout>

<script>
  const subjectLayout = document.querySelector<HTMLElement>(
    "[data-subject-layout]",
  );
  const subjectTabs = [
    ...document.querySelectorAll<HTMLButtonElement>(
      "[data-subject-layout] [data-view-tab]",
    ),
  ];
  const subjectPanels = [
    ...document.querySelectorAll<HTMLElement>(
      "[data-subject-layout] [data-view-panel]",
    ),
  ];
  const subjectViewKey =
    subjectLayout?.dataset.viewStorageKey ?? "atlasez-subject-view";

  function activateSubjectView(view: string, focus = false): void {
    if (!subjectTabs.some((tab) => tab.dataset.viewTab === view)) view = "tiles";
    for (const tab of subjectTabs) {
      const active = tab.dataset.viewTab === view;
      tab.setAttribute("aria-selected", String(active));
      if (active) tab.removeAttribute("tabindex");
      else tab.setAttribute("tabindex", "-1");
      if (active && focus) tab.focus();
    }
    for (const panel of subjectPanels) {
      panel.hidden = panel.dataset.viewPanel !== view;
    }
    try {
      localStorage.setItem(subjectViewKey, view);
    } catch {
      /* 保存できなくても表示切り替えは利用できる */
    }
    const url = new URL(location.href);
    if (view === "tiles") url.searchParams.delete("view");
    else url.searchParams.set("view", view);
    history.replaceState(null, "", url);
    if (view === "map") window.dispatchEvent(new Event("resize"));
  }

  if (subjectTabs.length > 0) {
    subjectTabs.forEach((tab) => {
      tab.addEventListener("click", () =>
        activateSubjectView(tab.dataset.viewTab ?? ""),
      );
    });
    document
      .querySelector<HTMLElement>("[data-subject-layout] [data-view-tabs]")
      ?.addEventListener("keydown", (event) => {
        const keys = ["ArrowRight", "ArrowLeft", "Home", "End"];
        if (!keys.includes(event.key)) return;
        event.preventDefault();
        const index = subjectTabs.findIndex(
          (tab) => tab.getAttribute("aria-selected") === "true",
        );
        const next =
          event.key === "Home"
            ? 0
            : event.key === "End"
              ? subjectTabs.length - 1
              : (index +
                  (event.key === "ArrowRight" ? 1 : -1) +
                  subjectTabs.length) %
                subjectTabs.length;
        activateSubjectView(subjectTabs[next].dataset.viewTab ?? "", true);
      });

    let initialView = new URL(location.href).searchParams.get("view");
    if (!initialView) {
      try {
        initialView = localStorage.getItem(subjectViewKey);
      } catch {
        initialView = null;
      }
    }
    activateSubjectView(initialView ?? "tiles");
  }

  // リスト表示のカテゴリ折りたたみ状態を分野ごとに保存する。
  const collapsePrefix = `atlasez-subject-collapse:${location.pathname}:`;
  document
    .querySelectorAll<HTMLDetailsElement>("[data-collapse-key]")
    .forEach((details) => {
      const key = `${collapsePrefix}${details.dataset.collapseKey}`;
      try {
        const stored = localStorage.getItem(key);
        if (stored === "open" || stored === "closed")
          details.open = stored === "open";
      } catch {
        /* 保存できなくても折りたたみ自体は利用できる */
      }
      details.addEventListener("toggle", () => {
        try {
          localStorage.setItem(key, details.open ? "open" : "closed");
        } catch {
          /* 保存できない環境では現在の表示だけ維持する */
        }
      });
    });
</script>

<style>
  .subject-home {
    max-width: var(--content-width);
    padding-bottom: var(--space-5);
  }
  .view-bar {
    display: flex;
    align-items: flex-end;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-top: var(--space-4);
    border-bottom: 2px solid var(--accent-primary);
  }
  .view-tabs {
    display: flex;
    gap: 2px;
  }
  .view-tab {
    position: relative;
    bottom: -2px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--touch-target);
    padding: 0 var(--space-3);
    border: 1px solid var(--border-strong);
    border-bottom: 2px solid var(--accent-primary);
    border-radius: var(--radius) var(--radius) 0 0;
    background: var(--background-secondary);
    color: var(--text-secondary);
    font: inherit;
    font-size: calc(0.95rem * var(--text-scale));
    font-weight: 600;
    cursor: pointer;
  }
  .view-tab:hover {
    color: var(--accent-primary);
    border-color: var(--accent-primary);
  }
  .view-tab[aria-selected="true"] {
    border-color: var(--accent-primary);
    border-bottom-color: var(--background-primary);
    background: var(--background-primary);
    color: var(--accent-primary);
    font-weight: 700;
  }
  .section-meta {
    margin: 0;
    padding-bottom: var(--space-2);
    color: var(--text-secondary);
    font-size: calc(0.85rem * var(--text-scale));
  }
  .view-panel {
    padding-top: var(--space-3);
  }
  .view-panel + .view-panel:not([hidden]) {
    margin-top: var(--space-5);
    border-top: 1px dashed var(--border-default);
  }
  .category-tiles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .category-tile {
    min-width: 0;
  }
  .category-tile > a {
    display: flex;
    min-height: 7rem;
    height: 100%;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-3);
    border: 1px solid var(--border-default);
    border-radius: var(--radius);
    background: var(--background-primary);
    color: var(--text-primary);
    text-decoration: none;
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease,
      transform 0.15s ease;
  }
  .category-tile > a:hover,
  .category-tile > a:focus-visible {
    border-color: var(--accent-primary);
    box-shadow: 0 3px 12px rgb(0 0 0 / 0.14);
    transform: translateY(-1px);
  }
  .category-name {
    font-size: calc(1.25rem * var(--text-scale));
    font-weight: 700;
  }
  .category-counts {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    color: var(--text-secondary);
    font-size: calc(0.82rem * var(--text-scale));
  }
  .subject-toc {
    max-width: none;
  }
  .toc-heading-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
    flex-wrap: wrap;
    border-bottom: 2px solid var(--border);
    padding-bottom: var(--space-1);
    margin-bottom: var(--space-3);
  }
  .toc-heading-row h2 {
    margin: 0;
  }
  .toc-total {
    color: var(--text-secondary);
    font-size: calc(0.85rem * var(--text-scale));
    white-space: nowrap;
  }
  .toc-categories {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .toc-category-details {
    border: 0;
  }
  .toc-cat-head {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    flex-wrap: wrap;
    min-height: var(--touch-target);
    padding: var(--space-1) 0;
    cursor: pointer;
    list-style: none;
  }
  .toc-cat-head::-webkit-details-marker {
    display: none;
  }
  .toc-cat-head::before {
    content: "▸";
    color: var(--text-secondary);
    font-size: calc(0.85rem * var(--text-scale));
  }
  .toc-category-details[open] > .toc-cat-head::before {
    content: "▾";
  }
  .toc-cat-head h3 {
    margin: 0;
    flex: 1;
  }
  .toc-cat-head h3 a {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }
  .toc-category-body {
    padding: 0 0 var(--space-2) calc(var(--space-3) + 0.7rem);
  }
  .planned-count {
    border-style: dashed;
  }
  .toc-empty {
    margin: 0 0 0 var(--space-3);
  }
  .toc-articles {
    list-style: none;
    margin: 0;
    padding: 0 0 0 var(--space-3);
    border-left: 2px solid var(--border);
    display: flex;
    flex-direction: column;
  }
  .toc-articles li {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
    align-items: baseline;
    padding: var(--space-1) 0;
  }
  .toc-articles li + li {
    border-top: 1px solid var(--border);
  }
  .planned-article > span:first-child {
    color: var(--text-secondary);
  }
  @media (max-width: 767px) {
    .view-tabs {
      width: 100%;
      border-bottom: 2px solid var(--accent-primary);
    }
    .view-bar {
      border-bottom: 0;
    }
    .view-tab {
      flex: 1 1 0;
      padding: 0 var(--space-1);
    }
    .section-meta {
      width: 100%;
      padding-top: var(--space-2);
      padding-bottom: 0;
    }
    .category-tiles {
      grid-template-columns: 1fr;
    }
  }
</style>
