---
import AtlasLayout from "../../../layouts/AtlasLayout.astro";
import LearningMap from "../../../components/LearningMap.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import {
  atlasPath,
  articlePath,
  formatDate,
  applyUrl,
} from "../../../lib/site";
import { t, LOCALES, localizedName, type Locale } from "../../../lib/i18n";
import { groupSubjects } from "../../../lib/taxonomy";
import {
  getPlannedArticles,
  plannedArticleTitle,
  plannedProgress,
} from "../../../lib/planned";
import {
  getPublishedArticles,
  getPublishedSubjects,
} from "../../../lib/content";

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const subjects = await getPublishedSubjects();
const articles = await getPublishedArticles(locale);

const countBySubject = new Map<string, number>();
for (const a of articles) {
  countBySubject.set(
    a.data.subject,
    (countBySubject.get(a.data.subject) ?? 0) + 1,
  );
}

/**
 * 「〇〇とは」の飛び先。分野定義の introSlug が指す総論記事を引く。
 * introSlug が未設定の分野、または記事がまだ無い分野では ? を出さない。
 */
const introArticleOf = new Map<string, string>();
for (const s of subjects) {
  if (!s.data.introSlug) continue;
  const article = articles.find(
    (a) => a.data.subject === s.data.slug && a.data.slug === s.data.introSlug,
  );
  if (!article) continue;
  introArticleOf.set(
    s.data.slug,
    articlePath(
      locale,
      article.data.subject,
      article.data.category,
      article.data.slug,
    ),
  );
}

/** 分野スラッグ + カテゴリスラッグ → 記事（リスト表示用） */
const articlesByCategory = new Map<string, typeof articles>();
for (const a of articles) {
  const key = `${a.data.subject}/${a.data.category}`;
  articlesByCategory.set(key, [...(articlesByCategory.get(key) ?? []), a]);
}

const recent = [...articles]
  .sort((a, b) => b.data.updatedAt.getTime() - a.data.updatedAt.getTime())
  .slice(0, 20);

/**
 * 近日公開予定の記事。
 * 目次に題名だけがあり本文が未移植の項目（planned-articles.json）を、
 * 公開中の分野に限って集める。行き先はその記事が入るカテゴリのページ。
 */
const categoryNameOf = new Map<string, string>();
for (const s of subjects) {
  for (const cat of s.data.categories) {
    categoryNameOf.set(
      `${s.data.slug}/${cat.slug}`,
      localizedName(cat.name, locale),
    );
  }
}
const upcoming = subjects
  .filter((s) => s.data.status === "published")
  .flatMap((s) =>
    getPlannedArticles(s.data.slug).map((item) => ({
      title: plannedArticleTitle(item, locale),
      category:
        categoryNameOf.get(`${s.data.slug}/${item.category}`) ?? item.category,
      href: `${atlasPath(locale, s.data.slug)}${item.category}/`,
      order: item.order,
      progress: plannedProgress(item),
    })),
  )
  .sort((a, b) => a.order - b.order)
  .slice(0, 12);

const alternates = LOCALES.map((l) => ({
  hreflang: l,
  href: new URL(atlasPath(l), Astro.site).href,
}));

const publishedSubjects = subjects.filter((s) => s.data.status === "published");

/** 大分類 → 中ジャンル → 分野。公開・準備中を同じ枠に並べる */
const grouped = groupSubjects(subjects, locale);

const summary =
  locale === "ja"
    ? `${publishedSubjects.length}分野・${articles.length}記事を公開中`
    : `${publishedSubjects.length} subjects · ${articles.length} articles`;

/** トップ内で切り替える3つの表示 */
const views = [
  { id: "tiles", label: t(locale, "tileView") },
  { id: "map", label: t(locale, "map") },
  { id: "list", label: t(locale, "listViewTab") },
] as const;
---

<AtlasLayout
  locale={locale}
  title={locale === "ja" ? "総合ホーム" : "Home"}
  description={t(locale, "siteTagline")}
  alternates={alternates}
>
  <div class="container atlas-home">
    <div class="content-columns" data-home-layout data-active-view="tiles">
      <section aria-labelledby="subjects-heading" class="home-main">
        <h1 id="subjects-heading" class="visually-hidden">
          {t(locale, "subjects")}
        </h1>

        <div data-home-map-breadcrumb>
          <Breadcrumb items={[{ label: t(locale, "breadcrumbHome") }]} />
        </div>

        {/* ブラウザのタブのように、ページ遷移せず表示を切り替える */}
        <div class="view-bar">
          <div
            class="view-tabs"
            role="tablist"
            aria-label={t(locale, "viewSwitcher")}
            data-view-tabs
          >
            {
              views.map((v, i) => (
                <button
                  type="button"
                  role="tab"
                  id={`view-tab-${v.id}`}
                  class="view-tab"
                  data-view-tab={v.id}
                  aria-selected={i === 0 ? "true" : "false"}
                  aria-controls={`view-panel-${v.id}`}
                  tabindex={i === 0 ? undefined : "-1"}
                >
                  {v.label}
                </button>
              ))
            }
          </div>
          <p class="section-meta">{summary}</p>
        </div>

        {/* --- タイル表示 --- */}
        <div
          id="view-panel-tiles"
          role="tabpanel"
          aria-labelledby="view-tab-tiles"
          class="view-panel"
          data-view-panel="tiles"
        >
          {
            grouped.map((group) => (
              <details
                class="group-block"
                open
                data-collapse-key={`tiles:group:${group.group}`}
              >
                <summary class="group-heading">
                  <h2 id={`group-${group.group}`}>{group.label}</h2>
                </summary>
                <div class="genre-columns">
                {group.genres.map((genre) => (
                  <section
                    class="genre-block"
                    aria-labelledby={`genre-${group.group}-${genre.genre}`}
                  >
                    <h3
                      class="genre-heading"
                      id={`genre-${group.group}-${genre.genre}`}
                    >
                      {genre.label}
                    </h3>
                    <ul class="subject-grid">
                      {genre.subjects.map((s) => {
                        const published = s.data.status === "published";
                        const name = localizedName(s.data.name, locale);
                        const infoLabel =
                          locale === "ja" ? `${name}とは` : `About ${name}`;
                        const introHref = introArticleOf.get(s.data.slug);
                        return (
                          <li
                            class:list={[
                              "subject-tile",
                              { "is-preparing": !published },
                            ]}
                          >
                            <div class="subject-row">
                              {/* タイル全体を押せるようにする（::after で行を覆う） */}
                              {published ? (
                                <a
                                  class="subject-name subject-link"
                                  href={atlasPath(locale, s.data.slug)}
                                >
                                  {name}
                                </a>
                              ) : (
                                <span class="subject-name">{name}</span>
                              )}
                              {/* 「〇〇とは」の解説へ。タイルのリンクより手前に出す */}
                              {introHref && (
                                <a
                                  class="subject-info"
                                  href={introHref}
                                  title={infoLabel}
                                >
                                  <span aria-hidden="true">?</span>
                                  <span class="visually-hidden">
                                    {infoLabel}
                                  </span>
                                </a>
                              )}
                              {/* 記事数・準備中は行の右端にそろえる */}
                              <span class="subject-count">
                                {published
                                  ? `${countBySubject.get(s.data.slug) ?? 0}${locale === "ja" ? "記事" : " articles"}`
                                  : t(locale, "preparing")}
                              </span>
                            </div>
                          </li>
                        );
                      })}
                    </ul>
                  </section>
                ))}
                </div>
              </details>
            ))
          }
        </div>

        {/* --- 学習地図 --- */}
        <div
          id="view-panel-map"
          role="tabpanel"
          aria-labelledby="view-tab-map"
          class="view-panel"
          data-view-panel="map"
        >
          <LearningMap locale={locale} />
        </div>

        {/* --- リスト表示 --- */}
        <div
          id="view-panel-list"
          role="tabpanel"
          aria-labelledby="view-tab-list"
          class="view-panel"
          data-view-panel="list"
        >
          {
            grouped.map((group) => (
              <details
                class="list-group"
                open
                data-collapse-key={`list:group:${group.group}`}
              >
                <summary class="group-heading">
                  <h2>{group.label}</h2>
                </summary>
                <div class="list-group-body">
                  {group.genres.map((genre) => (
                  <details
                    class="list-genre"
                    open
                    data-collapse-key={`list:genre:${group.group}:${genre.genre}`}
                  >
                    <summary class="list-genre-heading">
                      <h3>{genre.label}</h3>
                    </summary>
                    <ul class="subject-list">
                      {genre.subjects.map((s) => {
                        const published = s.data.status === "published";
                        const name = localizedName(s.data.name, locale);
                        const sortedCategories = s.data.categories
                          .slice()
                          .sort((a, b) => a.order - b.order);
                        return (
                          <li class="subject-list-item">
                            {published && sortedCategories.length > 0 ? (
                              <details
                                class="subject-list-details"
                                open
                                data-collapse-key={`list:subject:${s.data.slug}`}
                              >
                                <summary class="subject-list-head">
                                  <a href={`${atlasPath(locale, s.data.slug)}?view=list`}>
                                    {name}
                                  </a>
                                  <span class="subject-count">
                                    {countBySubject.get(s.data.slug) ?? 0}
                                    {locale === "ja" ? "記事" : " articles"}
                                  </span>
                                </summary>
                                <ul class="category-list">
                                  {sortedCategories.map((cat) => {
                                    const items =
                                      articlesByCategory.get(
                                        `${s.data.slug}/${cat.slug}`,
                                      ) ?? [];
                                    const planned = getPlannedArticles(
                                      s.data.slug,
                                      cat.slug,
                                    );
                                    return (
                                      <li class="category-list-item">
                                        <details
                                          class="category-list-details"
                                          data-category-key={`${s.data.slug}/${cat.slug}`}
                                          data-collapse-key={`list:category:${s.data.slug}:${cat.slug}`}
                                        >
                                          <summary class="category-list-head">
                                            <a
                                              href={`${atlasPath(locale, s.data.slug)}${cat.slug}/?view=list`}
                                            >
                                              {localizedName(cat.name, locale)}
                                            </a>
                                            <span class="subject-count">
                                              {items.length}
                                              {locale === "ja" ? "記事" : " articles"}
                                              {planned.length > 0 &&
                                                ` / ${locale === "ja" ? `準備中${planned.length}件` : `${planned.length} planned`}`}
                                            </span>
                                          </summary>
                                          <ul class="article-list">
                                            {items.map((article) => (
                                              <li>
                                                <a
                                                  href={articlePath(
                                                    locale,
                                                    article.data.subject,
                                                    article.data.category,
                                                    article.data.slug,
                                                  )}
                                                >
                                                  {article.data.title}
                                                </a>
                                              </li>
                                            ))}
                                            {planned.map((item) => (
                                              <li class="planned-list-item">
                                                <span>
                                                  {plannedArticleTitle(item, locale)}
                                                </span>
                                                <span class="planned-label">
                                                  {t(locale, "preparing")}
                                                </span>
                                                {/* 足りないと感じた人がそのまま書き手になれる導線 */}
                                                <a
                                                  class="planned-write"
                                                  href={applyUrl(
                                                    `?project=atlas&subject=${encodeURIComponent(s.data.slug)}&article=${encodeURIComponent(plannedArticleTitle(item, locale))}`,
                                                  )}
                                                  rel="noopener noreferrer"
                                                  target="_blank"
                                                >
                                                  {locale === "ja"
                                                    ? "書いてみませんか"
                                                    : "Write this"}
                                                </a>
                                              </li>
                                            ))}
                                          </ul>
                                        </details>
                                      </li>
                                    );
                                  })}
                                </ul>
                              </details>
                            ) : (
                              <div class="subject-list-head subject-list-static">
                                <span>{name}</span>
                                <span class="subject-count">
                                  {published
                                    ? `${countBySubject.get(s.data.slug) ?? 0}${locale === "ja" ? "記事" : " articles"}`
                                    : t(locale, "preparing")}
                                </span>
                              </div>
                            )}
                          </li>
                        );
                      })}
                    </ul>
                  </details>
                  ))}
                </div>
              </details>
            ))
          }
        </div>
      </section>

      <aside class="recent">
        <section aria-labelledby="recent-heading">
          <div class="section-title">
            <h2 id="recent-heading">{t(locale, "recentArticles")}</h2>
          </div>
          <div class="scroll-shell" data-scroll-fade>
          <div class="recent-scroll" data-scroll-region tabindex="0">
            <ul class="recent-list">
              {
                recent.map((a) => (
                  <li>
                    <a
                      href={articlePath(
                        locale,
                        a.data.subject,
                        a.data.category,
                        a.data.slug,
                      )}
                    >
                      {a.data.title}
                    </a>
                    <time datetime={a.data.updatedAt.toISOString().slice(0, 10)}>
                      {formatDate(a.data.updatedAt, locale)}
                    </time>
                  </li>
                ))
              }
            </ul>
          </div>
          </div>
        </section>

        {
          upcoming.length > 0 && (
            <section class="upcoming" aria-labelledby="upcoming-heading">
              <div class="section-title">
                <h2 id="upcoming-heading">{t(locale, "upcomingArticles")}</h2>
              </div>
              <div class="scroll-shell" data-scroll-fade>
              <ul class="upcoming-list" data-scroll-region tabindex="0">
                {upcoming.map((u) => (
                  <li>
                    <a href={u.href}>{u.title}</a>
                    <span class="upcoming-meta">
                      {u.progress === "in-progress" && (
                        <span class="badge badge-accent">
                          {t(locale, "progressInProgress")}
                        </span>
                      )}
                      <span class="upcoming-category">{u.category}</span>
                    </span>
                  </li>
                ))}
              </ul>
              </div>
            </section>
          )
        }
      </aside>
    </div>
  </div>
</AtlasLayout>

<script>
  /**
   * トップページの表示切り替え。
   * JavaScriptが無い場合は3つの表示がそのまま縦に並ぶので、情報には必ず到達できる。
   */
  const VIEW_KEY = "atlasez-home-view";
  const layout = document.querySelector<HTMLElement>("[data-home-layout]");
  const tabs = [
    ...document.querySelectorAll<HTMLButtonElement>("[data-view-tab]"),
  ];
  const panels = [
    ...document.querySelectorAll<HTMLElement>("[data-view-panel]"),
  ];
  const homeBreadcrumb = document.querySelector<HTMLElement>(
    "[data-home-map-breadcrumb] .breadcrumb",
  );
  const homeBreadcrumbList = homeBreadcrumb?.querySelector<HTMLOListElement>("ol");
  const homeBreadcrumbTemplate = homeBreadcrumbList?.innerHTML ?? "";
  const homeCategoryDetails = [
    ...document.querySelectorAll<HTMLDetailsElement>("[data-category-key]"),
  ];
  let mapCategoryKey = new URL(location.href).searchParams.get("category");

  function syncHomeMapContext(categoryKey: string | null): void {
    mapCategoryKey = categoryKey || null;
    const selected = homeCategoryDetails.find(
      (details) => details.dataset.categoryKey === mapCategoryKey,
    );
    homeCategoryDetails.forEach((details) => {
      if (details === selected) details.open = true;
    });
    if (!homeBreadcrumbList) return;
    homeBreadcrumbList.innerHTML = homeBreadcrumbTemplate;
    if (!selected) return;
    const subjectDetails = selected.closest<HTMLDetailsElement>(
      ".subject-list-details",
    );
    if (subjectDetails) subjectDetails.open = true;
    const subjectLink = subjectDetails?.querySelector<HTMLAnchorElement>(
      ".subject-list-head > a",
    );
    const categoryLink = selected.querySelector<HTMLAnchorElement>(
      ".category-list-head > a",
    );
    const current = homeBreadcrumbList.lastElementChild;
    if (!current || !subjectLink || !categoryLink) return;
    const subjectCrumb = document.createElement("li");
    const subjectAnchor = document.createElement("a");
    subjectAnchor.href = subjectLink.href;
    subjectAnchor.textContent = subjectLink.textContent?.trim() ?? "";
    subjectCrumb.append(subjectAnchor);
    const categoryCrumb = document.createElement("li");
    const categoryCurrent = document.createElement("span");
    categoryCurrent.setAttribute("aria-current", "page");
    categoryCurrent.textContent = categoryLink.textContent?.trim() ?? "";
    categoryCrumb.append(categoryCurrent);
    current.replaceWith(subjectCrumb, categoryCrumb);
  }

  window.addEventListener("atlas-map-category-change", (event) => {
    const detail = (event as CustomEvent<{ categoryKey?: string | null }>).detail;
    syncHomeMapContext(detail.categoryKey ?? null);
  });

  function activate(view: string, focus = false): void {
    if (!tabs.some((tab) => tab.dataset.viewTab === view)) view = "tiles";
    for (const tab of tabs) {
      const on = tab.dataset.viewTab === view;
      tab.setAttribute("aria-selected", String(on));
      if (on) tab.removeAttribute("tabindex");
      else tab.setAttribute("tabindex", "-1");
      if (on && focus) tab.focus();
    }
    for (const panel of panels) {
      panel.hidden = panel.dataset.viewPanel !== view;
    }
    if (view === "list" && mapCategoryKey) {
      syncHomeMapContext(mapCategoryKey);
      document
        .querySelector<HTMLDetailsElement>(
          `[data-category-key="${CSS.escape(mapCategoryKey)}"]`,
        )
        ?.scrollIntoView({ block: "nearest" });
    }
    if (layout) layout.dataset.activeView = view;
    try {
      localStorage.setItem(VIEW_KEY, view);
    } catch {
      /* 保存できなくても表示は切り替わる */
    }
    const url = new URL(location.href);
    if (view === "tiles") url.searchParams.delete("view");
    else url.searchParams.set("view", view);
    history.replaceState(null, "", url);
  }

  if (tabs.length > 0) {
    tabs.forEach((tab) => {
      tab.addEventListener("click", () => activate(tab.dataset.viewTab ?? ""));
    });

    // 左右キーでタブを移動できるようにする（WAI-ARIA のタブパターン）
    document
      .querySelector<HTMLElement>("[data-view-tabs]")
      ?.addEventListener("keydown", (event) => {
        const keys = ["ArrowRight", "ArrowLeft", "Home", "End"];
        if (!keys.includes(event.key)) return;
        event.preventDefault();
        const index = tabs.findIndex(
          (tab) => tab.getAttribute("aria-selected") === "true",
        );
        const next =
          event.key === "Home"
            ? 0
            : event.key === "End"
              ? tabs.length - 1
              : (index +
                  (event.key === "ArrowRight" ? 1 : -1) +
                  tabs.length) %
                tabs.length;
        activate(tabs[next].dataset.viewTab ?? "", true);
      });

    let initial = new URL(location.href).searchParams.get("view");
    if (!initial) {
      try {
        initial = localStorage.getItem(VIEW_KEY);
      } catch {
        initial = null;
      }
    }
    activate(initial ?? "tiles");
  }

  // タイル／リスト内の折りたたみ状態をページごとに保存する。
  // 画面を再訪したときも、最後に見ていた階層をそのまま復元する。
  const collapsePrefix = `atlasez-home-collapse:${location.pathname}:`;
  document
    .querySelectorAll<HTMLDetailsElement>("[data-collapse-key]")
    .forEach((details) => {
      const key = `${collapsePrefix}${details.dataset.collapseKey}`;
      try {
        const stored = localStorage.getItem(key);
        if (stored === "open" || stored === "closed")
          details.open = stored === "open";
      } catch {
        /* 保存できなくても折りたたみ自体は利用できる */
      }
      details.addEventListener("toggle", () => {
        try {
          localStorage.setItem(key, details.open ? "open" : "closed");
        } catch {
          /* 保存できない環境では現在の表示だけ維持する */
        }
      });
    });

  // OSの設定でスクロールバーが常時表示されない場合でも、下に続きが
  // あることを視覚的に示す。最後まで到達した時点では覆いを消す。
  document.querySelectorAll<HTMLElement>("[data-scroll-fade]").forEach((shell) => {
    const region = shell.querySelector<HTMLElement>("[data-scroll-region]");
    if (!region) return;

    const updateScrollFade = () => {
      const hasMore = region.scrollHeight > region.clientHeight + 1;
      const atEnd = region.scrollTop + region.clientHeight >= region.scrollHeight - 1;
      shell.dataset.scrollFade = hasMore && !atEnd ? "more" : "end";
    };

    region.addEventListener("scroll", updateScrollFade, { passive: true });
    new ResizeObserver(updateScrollFade).observe(region);
    updateScrollFade();
  });

</script>

<style>
  .atlas-home {
    max-width: var(--content-width);
  }
  .content-columns {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(14rem, 16rem);
    gap: var(--space-5);
    padding-block: var(--space-2) var(--space-5);
    align-items: start;
  }
  /* 地図とリストは横幅を使いたいので、右カラムを下に回す */
  /* 「近日公開予定」「最近更新された記事」は、どの表示でも同じ位置に置く。
     タブを切り替えるたびに右カラムが消えると視線の置き場が変わるため。
     地図で横幅が欲しいときは枠内の全画面ボタンを使う。 */
  .home-main {
    min-width: 0;
  }
  .section-title {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    padding-bottom: var(--space-1);
    border-bottom: 2px solid var(--accent-primary);
  }
  .section-title h2 {
    margin: 0;
    font-size: calc(1.45rem * var(--text-scale));
  }
  .section-meta {
    margin: 0;
    color: var(--text-secondary);
    font-size: calc(0.85rem * var(--text-scale));
  }

  /* ---- 表示切り替えタブ（ブラウザのタブ風） ---- */
  .view-bar {
    display: flex;
    align-items: flex-end;
    gap: var(--space-3);
    flex-wrap: wrap;
    /* タブの下辺がこの線の上にそのまま乗るよう、下の余白は入れない */
    border-bottom: 2px solid var(--accent-primary);
  }
  /*
   * ブラウザのタブのような見た目。選択中のタブだけ下辺を消して
   * 中身の面とつなげ、「いま開いている面」が分かるようにする。
   */
  .view-tabs {
    display: flex;
    gap: 2px;
  }
  .view-tab {
    position: relative;
    bottom: -2px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--touch-target);
    padding: 0 var(--space-3);
    border: 1px solid var(--border-strong);
