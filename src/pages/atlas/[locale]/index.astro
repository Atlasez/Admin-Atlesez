---
import AtlasLayout from "../../../layouts/AtlasLayout.astro";
import LearningMap from "../../../components/LearningMap.astro";
import { atlasPath, articlePath, formatDate } from "../../../lib/site";
import { t, LOCALES, localizedName, type Locale } from "../../../lib/i18n";
import { groupSubjects } from "../../../lib/taxonomy";
import {
  getPlannedArticles,
  plannedArticleTitle,
  plannedProgress,
} from "../../../lib/planned";
import {
  getPublishedArticles,
  getPublishedSubjects,
} from "../../../lib/content";

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const subjects = await getPublishedSubjects();
const articles = await getPublishedArticles(locale);

const countBySubject = new Map<string, number>();
for (const a of articles) {
  countBySubject.set(
    a.data.subject,
    (countBySubject.get(a.data.subject) ?? 0) + 1,
  );
}

/** 分野スラッグ + カテゴリスラッグ → 記事（リスト表示用） */
const articlesByCategory = new Map<string, typeof articles>();
for (const a of articles) {
  const key = `${a.data.subject}/${a.data.category}`;
  articlesByCategory.set(key, [...(articlesByCategory.get(key) ?? []), a]);
}

const recent = [...articles]
  .sort((a, b) => b.data.updatedAt.getTime() - a.data.updatedAt.getTime())
  .slice(0, 20);

/**
 * 近日公開予定の記事。
 * 目次に題名だけがあり本文が未移植の項目（planned-articles.json）を、
 * 公開中の分野に限って集める。行き先はその記事が入るカテゴリのページ。
 */
const categoryNameOf = new Map<string, string>();
for (const s of subjects) {
  for (const cat of s.data.categories) {
    categoryNameOf.set(
      `${s.data.slug}/${cat.slug}`,
      localizedName(cat.name, locale),
    );
  }
}
const upcoming = subjects
  .filter((s) => s.data.status === "published")
  .flatMap((s) =>
    getPlannedArticles(s.data.slug).map((item) => ({
      title: plannedArticleTitle(item, locale),
      category:
        categoryNameOf.get(`${s.data.slug}/${item.category}`) ?? item.category,
      href: `${atlasPath(locale, s.data.slug)}${item.category}/`,
      order: item.order,
      progress: plannedProgress(item),
    })),
  )
  .sort((a, b) => a.order - b.order)
  .slice(0, 12);

const alternates = LOCALES.map((l) => ({
  hreflang: l,
  href: new URL(atlasPath(l), Astro.site).href,
}));

const publishedSubjects = subjects.filter((s) => s.data.status === "published");

/** 大分類 → 中ジャンル → 分野。公開・準備中を同じ枠に並べる */
const grouped = groupSubjects(subjects, locale);

const summary =
  locale === "ja"
    ? `${publishedSubjects.length}分野・${articles.length}記事を公開中`
    : `${publishedSubjects.length} subjects · ${articles.length} articles`;

/** トップ内で切り替える3つの表示 */
const views = [
  { id: "tiles", label: t(locale, "tileView") },
  { id: "map", label: t(locale, "map") },
  { id: "list", label: t(locale, "listViewTab") },
] as const;
---

<AtlasLayout
  locale={locale}
  title={locale === "ja" ? "総合ホーム" : "Home"}
  description={t(locale, "siteTagline")}
  alternates={alternates}
>
  <div class="container atlas-home">
    <div class="content-columns" data-home-layout data-active-view="tiles">
      <section aria-labelledby="subjects-heading" class="home-main">
        <h1 id="subjects-heading" class="visually-hidden">
          {t(locale, "subjects")}
        </h1>

        {/* ブラウザのタブのように、ページ遷移せず表示を切り替える */}
        <div class="view-bar">
          <div
            class="view-tabs"
            role="tablist"
            aria-label={t(locale, "viewSwitcher")}
            data-view-tabs
          >
            {
              views.map((v, i) => (
                <button
                  type="button"
                  role="tab"
                  id={`view-tab-${v.id}`}
                  class="view-tab"
                  data-view-tab={v.id}
                  aria-selected={i === 0 ? "true" : "false"}
                  aria-controls={`view-panel-${v.id}`}
                  tabindex={i === 0 ? undefined : "-1"}
                >
                  {v.label}
                </button>
              ))
            }
          </div>
          <p class="section-meta">{summary}</p>
        </div>

        {/* --- タイル表示 --- */}
        <div
          id="view-panel-tiles"
          role="tabpanel"
          aria-labelledby="view-tab-tiles"
          class="view-panel"
          data-view-panel="tiles"
        >
          {
            grouped.map((group) => (
              <details class="group-block" open>
                <summary class="group-heading">
                  <h2 id={`group-${group.group}`}>{group.label}</h2>
                </summary>
                <div class="genre-columns">
                {group.genres.map((genre) => (
                  <section
                    class="genre-block"
                    aria-labelledby={`genre-${group.group}-${genre.genre}`}
                  >
                    <h3
                      class="genre-heading"
                      id={`genre-${group.group}-${genre.genre}`}
                    >
                      {genre.label}
                    </h3>
                    <ul class="subject-grid">
                      {genre.subjects.map((s) => {
                        const published = s.data.status === "published";
                        const name = localizedName(s.data.name, locale);
                        const desc = localizedName(s.data.description, locale);
                        const descId = `subject-desc-${s.data.slug}`;
                        const infoLabel =
                          locale === "ja" ? `${name}とは` : `About ${name}`;
                        return (
                          <li
                            class:list={[
                              "subject-tile",
                              { "is-preparing": !published },
                            ]}
                          >
                            <div class="subject-row">
                              {published ? (
                                <a
                                  class="subject-name"
                                  href={atlasPath(locale, s.data.slug)}
                                >
                                  {name}
                                </a>
                              ) : (
                                <span class="subject-name">{name}</span>
                              )}
                              {/* 丸囲みの「?」。分野名の一部に見えないよう
                                  記号にし、枠は淡色にして主張を抑える。 */}
                              <button
                                type="button"
                                class="subject-info"
                                aria-expanded="false"
                                aria-controls={descId}
                                data-subject-info
                                title={infoLabel}
                              >
                                <span aria-hidden="true">?</span>
                                <span class="visually-hidden">{infoLabel}</span>
                              </button>
                              {/* 記事数・準備中は行の右端にそろえる */}
                              <span class="subject-count">
                                {published
                                  ? `${countBySubject.get(s.data.slug) ?? 0}${locale === "ja" ? "記事" : " articles"}`
                                  : t(locale, "preparing")}
                              </span>
                            </div>
                            <p class="subject-desc" id={descId} hidden>
                              {desc}
                            </p>
                          </li>
                        );
                      })}
                    </ul>
                  </section>
                ))}
                </div>
              </details>
            ))
          }
        </div>

        {/* --- 学習地図 --- */}
        <div
          id="view-panel-map"
          role="tabpanel"
          aria-labelledby="view-tab-map"
          class="view-panel"
          data-view-panel="map"
        >
          <LearningMap locale={locale} />
        </div>

        {/* --- リスト表示 --- */}
        <div
          id="view-panel-list"
          role="tabpanel"
          aria-labelledby="view-tab-list"
          class="view-panel"
          data-view-panel="list"
        >
          {
            grouped.map((group) => (
              <details class="list-group" open>
                <summary class="group-heading">
                  <h2>{group.label}</h2>
                </summary>
                {group.genres.map((genre) => (
                  <section class="list-genre">
                    <h3 class="genre-heading">{genre.label}</h3>
                    <ul class="subject-list">
                      {genre.subjects.map((s) => {
                        const published = s.data.status === "published";
                        const name = localizedName(s.data.name, locale);
                        return (
                          <li class="subject-list-item">
                            <div class="subject-list-head">
                              {published ? (
                                <a href={atlasPath(locale, s.data.slug)}>{name}</a>
                              ) : (
                                <span>{name}</span>
                              )}
                              <span class="subject-count">
                                {published
                                  ? `${countBySubject.get(s.data.slug) ?? 0}${locale === "ja" ? "記事" : " articles"}`
                                  : t(locale, "preparing")}
                              </span>
                            </div>
                            {published && s.data.categories.length > 0 && (
                              <ul class="category-list">
                                {s.data.categories
                                  .slice()
                                  .sort((a, b) => a.order - b.order)
                                  .map((cat) => {
                                    const items =
                                      articlesByCategory.get(
                                        `${s.data.slug}/${cat.slug}`,
                                      ) ?? [];
                                    return (
                                      <li>
                                        <a
                                          href={`${atlasPath(locale, s.data.slug)}${cat.slug}/`}
                                        >
                                          {localizedName(cat.name, locale)}
                                        </a>
                                        <span class="subject-count">
                                          {items.length}
                                          {locale === "ja" ? "記事" : ""}
                                        </span>
                                      </li>
                                    );
                                  })}
                              </ul>
                            )}
                          </li>
                        );
                      })}
                    </ul>
                  </section>
                ))}
              </details>
            ))
          }
        </div>
      </section>

      <aside class="recent">
        {/* これから増えるものを先に見せ、その下に更新履歴を置く */}
        {
          upcoming.length > 0 && (
            <section class="upcoming" aria-labelledby="upcoming-heading">
              <div class="section-title">
                <h2 id="upcoming-heading">{t(locale, "upcomingArticles")}</h2>
              </div>
              <ul class="upcoming-list">
                {upcoming.map((u) => (
                  <li>
                    <a href={u.href}>{u.title}</a>
                    <span class="upcoming-meta">
                      {u.progress === "in-progress" && (
                        <span class="badge badge-accent">
                          {t(locale, "progressInProgress")}
                        </span>
                      )}
                      <span class="upcoming-category">{u.category}</span>
                    </span>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        <section aria-labelledby="recent-heading">
        <div class="section-title">
          <h2 id="recent-heading">{t(locale, "recentArticles")}</h2>
        </div>
        <div class="recent-scroll">
          <ul class="recent-list">
            {
              recent.map((a) => (
                <li>
                  <a
                    href={articlePath(
                      locale,
                      a.data.subject,
                      a.data.category,
                      a.data.slug,
                    )}
                  >
                    {a.data.title}
                  </a>
                  <time datetime={a.data.updatedAt.toISOString().slice(0, 10)}>
                    {formatDate(a.data.updatedAt, locale)}
                  </time>
                </li>
              ))
            }
          </ul>
        </div>
        </section>
      </aside>
    </div>
  </div>
</AtlasLayout>

<script>
  // 分野タイルの「?」で分野説明を開閉する
  document
    .querySelectorAll<HTMLButtonElement>("[data-subject-info]")
    .forEach((button) => {
      button.addEventListener("click", () => {
        const id = button.getAttribute("aria-controls");
        if (!id) return;
        const panel = document.getElementById(id);
        if (!panel) return;
        const open = button.getAttribute("aria-expanded") === "true";
        button.setAttribute("aria-expanded", open ? "false" : "true");
        panel.hidden = open;
      });
    });

  /**
   * トップページの表示切り替え。
   * JavaScriptが無い場合は3つの表示がそのまま縦に並ぶので、情報には必ず到達できる。
   */
  const VIEW_KEY = "atlasez-home-view";
  const layout = document.querySelector<HTMLElement>("[data-home-layout]");
  const tabs = [
    ...document.querySelectorAll<HTMLButtonElement>("[data-view-tab]"),
  ];
  const panels = [
    ...document.querySelectorAll<HTMLElement>("[data-view-panel]"),
  ];

  function activate(view: string, focus = false): void {
    if (!tabs.some((tab) => tab.dataset.viewTab === view)) view = "tiles";
    for (const tab of tabs) {
      const on = tab.dataset.viewTab === view;
      tab.setAttribute("aria-selected", String(on));
      if (on) tab.removeAttribute("tabindex");
      else tab.setAttribute("tabindex", "-1");
      if (on && focus) tab.focus();
    }
    for (const panel of panels) {
      panel.hidden = panel.dataset.viewPanel !== view;
    }
    if (layout) layout.dataset.activeView = view;
    try {
      localStorage.setItem(VIEW_KEY, view);
    } catch {
      /* 保存できなくても表示は切り替わる */
    }
    const url = new URL(location.href);
    if (view === "tiles") url.searchParams.delete("view");
    else url.searchParams.set("view", view);
    history.replaceState(null, "", url);
  }

  if (tabs.length > 0) {
    tabs.forEach((tab) => {
      tab.addEventListener("click", () => activate(tab.dataset.viewTab ?? ""));
    });

    // 左右キーでタブを移動できるようにする（WAI-ARIA のタブパターン）
    document
      .querySelector<HTMLElement>("[data-view-tabs]")
      ?.addEventListener("keydown", (event) => {
        const keys = ["ArrowRight", "ArrowLeft", "Home", "End"];
        if (!keys.includes(event.key)) return;
        event.preventDefault();
        const index = tabs.findIndex(
          (tab) => tab.getAttribute("aria-selected") === "true",
        );
        const next =
          event.key === "Home"
            ? 0
            : event.key === "End"
              ? tabs.length - 1
              : (index +
                  (event.key === "ArrowRight" ? 1 : -1) +
                  tabs.length) %
                tabs.length;
        activate(tabs[next].dataset.viewTab ?? "", true);
      });

    let initial = new URL(location.href).searchParams.get("view");
    if (!initial) {
      try {
        initial = localStorage.getItem(VIEW_KEY);
      } catch {
        initial = null;
      }
    }
    activate(initial ?? "tiles");
  }
</script>

<style>
  .atlas-home {
    max-width: var(--content-width);
  }
  .content-columns {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(14rem, 16rem);
    gap: var(--space-5);
    padding-block: var(--space-2) var(--space-5);
    align-items: start;
  }
  /* 地図とリストは横幅を使いたいので、右カラムを下に回す */
  .content-columns[data-active-view="map"],
  .content-columns[data-active-view="list"] {
    grid-template-columns: minmax(0, 1fr);
  }
  .home-main {
    min-width: 0;
  }
  .section-title {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    padding-bottom: var(--space-1);
    border-bottom: 2px solid var(--accent-primary);
  }
  .section-title h2 {
    margin: 0;
    font-size: calc(1.45rem * var(--text-scale));
  }
  .section-meta {
    margin: 0;
    color: var(--text-secondary);
    font-size: calc(0.85rem * var(--text-scale));
  }

  /* ---- 表示切り替えタブ（ブラウザのタブ風） ---- */
  .view-bar {
    display: flex;
    align-items: flex-end;
    gap: var(--space-3);
    flex-wrap: wrap;
    padding-bottom: var(--space-2);
    border-bottom: 2px solid var(--accent-primary);
  }
  /*
   * ブラウザのタブのような見た目。選択中のタブだけ下辺を消して
   * 中身の面とつなげ、「いま開いている面」が分かるようにする。
   */
  .view-tabs {
    display: flex;
    gap: 2px;
  }
  .view-tab {
    position: relative;
    bottom: -2px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--touch-target);
    padding: 0 var(--space-3);
    border: 1px solid var(--border-strong);
    border-bottom: 2px solid var(--accent-primary);
    border-radius: var(--radius) var(--radius) 0 0;
    background: var(--background-secondary);
    color: var(--text-secondary);
    font: inherit;
    font-size: calc(0.95rem * var(--text-scale));
    font-weight: 600;
    cursor: pointer;
  }
  .view-tab:hover {
    color: var(--accent-primary);
    border-color: var(--accent-primary);
  }
  .view-tab[aria-selected="true"] {
    border-color: var(--accent-primary);
    /* 下辺を面の色で塗りつぶし、中身と地続きに見せる */
    border-bottom-color: var(--background-primary);
    background: var(--background-primary);
    color: var(--accent-primary);
    font-weight: 700;
  }
  .section-meta {
    padding-bottom: var(--space-1);
  }
  .view-panel {
    padding-top: var(--space-3);
  }
  /* JSが無いときは3つとも並ぶ。どの表示かが分かるよう区切りを入れる */
  .view-panel + .view-panel:not([hidden]) {
    margin-top: var(--space-5);
    border-top: 1px dashed var(--border-default);
  }

  /* ---- 大分類・中ジャンル ---- */
  .group-block + .group-block,
  .list-group + .list-group {
    margin-top: var(--space-5);
  }
  /* 大ジャンル・中ジャンルは「入れ物」の名前。主役は分野名なので、
     大きさではなく罫線と色で段を示し、分野名より小さくする。 */
  .group-block,
  .list-group {
    border: 0;
    border-radius: 0;
  }
  .group-heading {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0 0 var(--space-2);
    padding: 0 0 2px;
    min-height: 0;
    border-bottom: 2px solid var(--border-strong);
    cursor: pointer;
    list-style: none;
  }
  .group-heading::-webkit-details-marker {
    display: none;
  }
  /* 開閉の向きが分かる三角。閉じているときは右向き */
  .group-heading::before {
    content: "▾";
    color: var(--text-secondary);
    font-size: calc(0.8rem * var(--text-scale));
  }
  .group-block:not([open]) > .group-heading::before,
  .list-group:not([open]) > .group-heading::before {
    content: "▸";
  }
  .group-heading h2 {
    margin: 0;
    font-size: calc(1.1rem * var(--text-scale));
  }
  .list-genre + .list-genre {
    margin-top: var(--space-3);
  }
  .genre-heading {
    margin: 0 0 var(--space-1);
    color: var(--text-secondary);
    font-size: calc(0.85rem * var(--text-scale));
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  /* ---- 分野一覧（タイル） ----
     大ジャンルの中で中ジャンルを段に分け、各段では分野を
     「名前 … 記事数」の1行ずつ積む。 */
  .genre-columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: var(--space-4) var(--space-5);
    align-items: start;
  }
  .subject-grid {
    display: block;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .subject-tile {
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--border-default);
    line-height: 1.4;
  }
  .subject-row {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
  }
  /* 記事数は行の右端へ */
  .subject-row .subject-count {
    margin-left: auto;
    flex: 0 0 auto;
  }
  /* min-height はWCAG 2.5.8（ターゲットサイズ 24px）を満たすため */
  .subject-name {
    display: inline-flex;
    align-items: center;
    min-height: 1.75rem;
    font-size: calc(1.3rem * var(--text-scale));
    font-weight: 650;
    text-decoration: none;
    color: var(--text-primary);
  }
  a.subject-name:hover {
    color: var(--accent-primary);
    text-decoration: underline;
  }
  /* 24px 未満だと WCAG 2.5.8（ターゲットサイズ）違反になる */
  .subject-info {
    flex: 0 0 auto;
    width: 1.5rem;
    height: 1.5rem;
    min-width: 24px;
    min-height: 24px;
    padding: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    /* 枠は淡色にして分野名より目立たせない。触れたときだけ色を強める */
    border: 1px solid var(--border-default);
    border-radius: 50%;
    background: transparent;
    color: var(--text-secondary);
    font: inherit;
    font-size: calc(0.78rem * var(--text-scale));
    line-height: 1;
    cursor: pointer;
  }
  .subject-info:hover,
  .subject-info[aria-expanded="true"] {
    border-color: var(--accent-primary);
    background: var(--accent-subtle);
    color: var(--accent-primary);
  }
  .subject-status {
    margin: 0;
  }
  .subject-count {
    color: var(--text-secondary);
    font-size: calc(0.78rem * var(--text-scale));
    font-weight: 400;
  }
  .subject-desc {
    margin: var(--space-1) 0 var(--space-1);
    padding-right: var(--space-2);
    color: var(--text-secondary);
    font-size: calc(0.85rem * var(--text-scale));
    line-height: 1.55;
  }
  /* 準備中は opacity で淡くしない（コントラスト比が 4.5:1 を割るため）。
     色は --text-secondary のまま、太さと下線の有無で区別する。 */
  .subject-tile.is-preparing .subject-name {
    color: var(--text-secondary);
    font-weight: 500;
  }
  .subject-tile.is-preparing {
    border-bottom-style: dashed;
  }

  /* ---- 分野一覧（リスト） ---- */
  .subject-list,
  .category-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .subject-list-item {
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--border-default);
  }
  .subject-list-head {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    font-size: calc(1.2rem * var(--text-scale));
    font-weight: 650;
  }
  .category-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
    gap: 0 var(--space-3);
    margin-top: var(--space-1);
    padding-left: var(--space-3);
    border-left: 2px solid var(--border-default);
  }
  .category-list li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
    padding: 2px 0;
