---
/** サイト内検索（Pagefind）。ビルド後に生成されるインデックスを利用する */
import AtlasLayout from "../../../../layouts/AtlasLayout.astro";
import Breadcrumb from "../../../../components/Breadcrumb.astro";
import { atlasPath, withBase } from "../../../../lib/site";
import {
  localizedName,
  t,
  LOCALES,
  localeNames,
  type Locale,
} from "../../../../lib/i18n";
import { getPublishedSubjects } from "../../../../lib/content";

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;

/** Pagefindのフィルタ名 → ローカライズ済みラベル */
const filterLabels: Record<string, string> = {
  subject: t(locale, "subjects"),
  category: t(locale, "category"),
  locale: t(locale, "languages"),
};

const subjectCategoryMap = Object.fromEntries(
  (await getPublishedSubjects())
    .filter((subject) => subject.data.status === "published")
    .map((subject) => [
      localizedName(subject.data.name, locale),
      [...subject.data.categories]
        .sort((a, b) => a.order - b.order)
        .map((category) => localizedName(category.name, locale)),
    ]),
);
---

<AtlasLayout
  locale={locale}
  title={t(locale, "search")}
  description={locale === "ja"
    ? "学習サイト「アトラス」の記事を分野横断で検索します。"
    : "Search articles across all subjects."}
  localeSwitchHrefs={Object.fromEntries(
    LOCALES.map((l) => [l, atlasPath(l, "search")]),
  )}
>
  <div class="container">
    <Breadcrumb
      items={[
        { label: t(locale, "breadcrumbHome"), href: atlasPath(locale) },
        { label: t(locale, "search") },
      ]}
    />
    <h1>{t(locale, "search")}</h1>
    <form
      class="search-form"
      role="search"
      data-search-form
      data-base={withBase("/")}
      data-locale-name={localeNames[locale]}
      data-all-label={t(locale, "all")}
      data-filter-labels={JSON.stringify(filterLabels)}
      data-subject-categories={JSON.stringify(subjectCategoryMap)}
    >
      <label for="search-input">{t(locale, "searchPlaceholder")}</label>
      <div class="search-row">
        <input
          id="search-input"
          type="search"
          data-search-input
          placeholder={t(locale, "searchPlaceholder")}
          autocomplete="off"
        />
        <button type="submit" class="button">{t(locale, "search")}</button>
      </div>
      <div class="search-filters" data-search-filters>
        {/* 選択肢と件数はPagefindから取得し、分野→カテゴリの順で描画する */}
      </div>
    </form>
    <p class="search-note" data-search-note>
      {
        locale === "ja"
          ? "検索インデックスはビルド後に生成されます（npm run build）。開発サーバーでは検索できません。"
          : "The search index is generated at build time (npm run build)."
      }
    </p>
    <div data-search-status aria-live="polite" class="visually-hidden"></div>
    <p class="search-count" data-search-count aria-live="polite"></p>
    <ol class="search-results" data-search-results></ol>
  </div>
</AtlasLayout>

<style>
  .search-form {
    max-width: var(--reading-width);
  }
  .search-row {
    display: flex;
    gap: var(--space-2);
  }
  .search-row input {
    flex: 1;
  }
  .search-filters {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-top: var(--space-2);
  }
  .search-filters :global(.search-filter) {
    display: grid;
    gap: 0.35rem;
    min-width: min(100%, 13rem);
  }
  .search-filters :global(.search-filter.is-multiple) {
    min-width: min(100%, 16rem);
  }
  .search-filters :global(.search-filter select) {
    min-width: 13rem;
  }
  .search-filters :global(.search-filter select[multiple]) {
    min-height: 8.5rem;
  }
  .search-filters :global(.search-filter-hint) {
    color: var(--text-secondary);
    font-size: calc(0.78rem * var(--text-scale));
    margin: 0.2rem 0 0;
  }
  .search-filters :global(label) {
    font-weight: 400;
    color: var(--text-secondary);
  }
  .search-note {
    color: var(--text-secondary);
    font-size: calc(0.9rem * var(--text-scale));
  }
  .search-results {
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
    max-width: var(--reading-width);
  }
  .search-count {
    min-height: 1.5em;
    margin: var(--space-3) 0 0;
    color: var(--text-secondary);
  }
  .search-results :global(li) {
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--border-default);
  }
  .search-results :global(mark) {
    background: var(--accent-subtle);
    color: var(--accent-primary);
    font-weight: 700;
  }
  .search-results :global(.result-title) {
    font-weight: 600;
  }

  /* iOS Safari は 16px 未満の入力欄で画面を拡大してしまう */
  @media (max-width: 767px) {
    #search-input {
      font-size: max(16px, calc(0.9rem * var(--text-scale)));
    }
  }
</style>

<script>
  import { createPagefindAdapter, type SearchAdapter } from "../../../../lib/search";

  const form = document.querySelector<HTMLFormElement>("[data-search-form]");
  const input = document.querySelector<HTMLInputElement>("[data-search-input]");
  const resultsEl = document.querySelector<HTMLElement>(
    "[data-search-results]",
  );
  const filtersEl = document.querySelector<HTMLElement>(
    "[data-search-filters]",
  );
  const note = document.querySelector<HTMLElement>("[data-search-note]");
  const status = document.querySelector<HTMLElement>("[data-search-status]");
  const count = document.querySelector<HTMLElement>("[data-search-count]");

  let adapter: SearchAdapter | null = null;

  // 現在ページのロケール表示名（例: 日本語 / English）と各種ラベル
  const localeName = form?.dataset.localeName ?? "";
  const allLabel = form?.dataset.allLabel ?? "---";
  let filterLabels: Record<string, string> = {};
  try {
    filterLabels = JSON.parse(form?.dataset.filterLabels ?? "{}");
  } catch {
    filterLabels = {};
  }

  let subjectCategoryMap: Record<string, string[]> = {};
  try {
    subjectCategoryMap = JSON.parse(form?.dataset.subjectCategories ?? "{}");
  } catch {
    subjectCategoryMap = {};
  }

  const filterControls = new Map<string, HTMLSelectElement>();
  let availableFilters: Record<string, Record<string, number>> = {};

  function selectedSubjectNames(): string[] {
    const select = filterControls.get("subject");
    if (!select) return [];
    return [...select.selectedOptions]
      .map((option) => option.value)
      .filter(Boolean);
  }

  function refreshCategoryOptions(): void {
    const select = filterControls.get("category");
    if (!select) return;
    const selectedSubjects = selectedSubjectNames();
    const allowed = new Set(
      selectedSubjects.length === 0
        ? Object.keys(availableFilters.category ?? {})
        : selectedSubjects.flatMap((subject) => subjectCategoryMap[subject] ?? []),
    );
    const current = select.value;
    const entries = Object.entries(availableFilters.category ?? {}).filter(([value]) =>
      allowed.has(value),
    );
    select.replaceChildren();
    const all = document.createElement("option");
    all.value = "";
    all.textContent = allLabel;
    select.append(all);
    for (const [value, articleCount] of entries) {
      const option = document.createElement("option");
      option.value = value;
      option.textContent = `${value} (${articleCount})`;
      select.append(option);
    }
    select.value = entries.some(([value]) => value === current) ? current : "";
  }

  function normalizeMultipleSelect(select: HTMLSelectElement): void {
    if (!select.multiple) return;
    const selected = [...select.selectedOptions];
    const all = selected.find((option) => option.value === "");
    if (all) {
      for (const option of select.options) option.selected = option === all;
    } else if (selected.length === 0 && select.options[0]) {
      select.options[0].selected = true;
    }
  }

  function createFilterControl(
    name: string,
    values: Record<string, number>,
    multiple = false,
  ): HTMLSelectElement {
    const wrap = document.createElement("span");
    wrap.className = `search-filter${multiple ? " is-multiple" : ""}`;
    const label = document.createElement("label");
    const id = `filter-${name}`;
    label.htmlFor = id;
    label.textContent = filterLabels[name] ?? name;
    const select = document.createElement("select");
    select.id = id;
    select.dataset.filterName = name;
    select.multiple = multiple;
    if (multiple) {
      select.size = Math.min(6, Math.max(3, Object.keys(values).length + 1));
      select.setAttribute("aria-describedby", "search-subject-hint");
    }
    const all = document.createElement("option");
    all.value = "";
    all.textContent = allLabel;
    all.selected = true;
    select.append(all);
    for (const [value, articleCount] of Object.entries(values)) {
      const option = document.createElement("option");
      option.value = value;
      option.textContent = `${value} (${articleCount})`;
      select.append(option);
    }
    select.addEventListener("change", () => {
      normalizeMultipleSelect(select);
      if (name === "subject") refreshCategoryOptions();
      void run();
    });
    wrap.append(label, select);
    if (multiple) {
      const hint = document.createElement("small");
      hint.id = "search-subject-hint";
      hint.className = "search-filter-hint";
      hint.textContent =
        document.documentElement.lang === "ja"
          ? "Ctrl / ⌘ を押しながら複数選択"
          : "Hold Ctrl / ⌘ to select multiple";
      wrap.append(hint);
    }
    filtersEl?.append(wrap);
    filterControls.set(name, select);
    return select;
  }

  async function init(): Promise<void> {
    if (!form) return;
    try {
      adapter = await createPagefindAdapter(form.dataset.base ?? "/");
      note?.remove();
      availableFilters = await adapter.filters();
      if (filtersEl) {
        filtersEl.replaceChildren();
        const subjectSelect = createFilterControl(
          "subject",
          availableFilters.subject ?? {},
          true,
        );
        createFilterControl("category", availableFilters.category ?? {});
        const localeSelect = createFilterControl(
          "locale",
          availableFilters.locale ?? {},
        );
        // 言語フィルタは現在ページのロケールを初期選択にする
        if (localeName && availableFilters.locale?.[localeName]) {
          localeSelect.value = localeName;
        }
        normalizeMultipleSelect(subjectSelect);
        refreshCategoryOptions();
      }
    } catch {
      /* 開発サーバーではインデックスがないため案内文を残す */
    }
  }

  async function run(): Promise<void> {
    if (!adapter || !input || !resultsEl) return;
    const q = input.value.trim();
    if (!q) {
      resultsEl.innerHTML = "";
      if (count) count.textContent = "";
      if (status) {
        status.textContent =
          document.documentElement.lang === "ja"
            ? "検索語を入力してください"
            : "Enter a search term";
      }
      return;
    }
    const filters: Record<string, string | string[] | undefined> = {};
    filtersEl
      ?.querySelectorAll<HTMLSelectElement>("select")
      .forEach((select) => {
        const name = select.dataset.filterName ?? "";
        const values = [...select.selectedOptions]
          .map((option) => option.value)
          .filter(Boolean);
        if (values.length > 0) {
          filters[name] = select.multiple ? values : values[0];
        }
      });
    const items = await adapter.search(q, filters);
    resultsEl.innerHTML = "";
    for (const item of items) {
      const li = document.createElement("li");
      const a = document.createElement("a");
      a.className = "result-title";
      a.href = item.url;
      a.textContent = item.title;
      const p = document.createElement("p");
      // 本文由来の抜粋には数式の読み上げ文字列や内部IDが混ざるため、
      // 編集済みの要約を検索結果の説明として使う。
      p.textContent = item.meta.summary ?? "";
      li.append(a, p);
      resultsEl.append(li);
    }
    const resultCount =
      document.documentElement.lang === "ja"
        ? `${items.length}件の記事`
        : `${items.length} results`;
    if (count) count.textContent = resultCount;
    if (status) status.textContent = resultCount;
  }

  // Pagefind は動的 import なので、回線や端末によってはページ表示直後の
  // 最初の送信が初期化より先に到達する。初期化完了を待ってから検索することで、
  // 「検索を押したのに結果が空のまま」という競合を防ぐ。
  const adapterReady = init();

  form?.addEventListener("submit", (ev) => {
    ev.preventDefault();
    void adapterReady.then(run);
  });
  input?.addEventListener("input", () => {
    if ((input?.value.length ?? 0) >= 2) void adapterReady.then(run);
  });

  // ヘッダーの検索欄から ?q= 付きで来たときは、そのまま結果まで出す
  void adapterReady.then(() => {
    const q = new URL(location.href).searchParams.get("q");
    if (q && input) {
      input.value = q;
      void run();
    }
  });
</script>
