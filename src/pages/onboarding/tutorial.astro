---
import ApplicantLayout from "../../layouts/ApplicantLayout.astro";
---

<ApplicantLayout title="はじめての使い方" description="Atlasezで活動を始めるための案内です。" showMemberProfile={true}>
  <main class="tutorial" data-tutorial>
    <p class="progress" data-progress>準備中…</p>
    <h1 data-title>はじめての使い方</h1>
    <p class="intro" data-body>案内を読み込んでいます。</p>
    <section class="lesson" aria-label="このステップの内容" data-lesson></section>
    <section class="checkpoint" aria-label="このステップの操作確認" data-checkpoint hidden>
      <p class="checkpoint__eyebrow">操作して確認</p>
      <h2 data-checkpoint-prompt></h2>
      <p data-checkpoint-instruction></p>
      <div class="checkpoint__choices" data-checkpoint-choices></div>
      <output data-checkpoint-message aria-live="polite"></output>
    </section>
    <section class="guide-card" aria-label="案内内容">
      <ol data-steps></ol>
    </section>
    <div class="actions">
      <button type="button" class="secondary" data-back disabled>前のステップへ戻る</button>
      <button type="button" data-next disabled>次へ</button>
    </div>
    <output data-message aria-live="polite"></output>
  </main>
</ApplicantLayout>

<style>
  .tutorial{margin:0 auto;max-width:760px;padding:3rem 1.25rem 5rem}.progress,.checkpoint__eyebrow{color:var(--accent-primary);font-size:.76rem;font-weight:800;letter-spacing:0;margin:0}.tutorial h1{margin:.4rem 0 .6rem}.intro,output{color:var(--text-secondary);line-height:1.8}.lesson{border:1px solid var(--border-default);display:grid;gap:1.25rem;margin:2rem 0;padding:1.25rem}.lesson__goal{border-left:3px solid var(--accent-primary);margin:0;padding-left:.8rem}.lesson__group{display:grid;gap:.55rem}.lesson h2{font-size:1rem;margin:0}.lesson ul{display:grid;gap:.55rem;margin:0;padding-left:1.35rem}.lesson li{line-height:1.7}.lesson__tip{background:var(--background-secondary);border:1px solid var(--border-default);font-size:.9rem;line-height:1.7;margin:0;padding:.85rem}.lesson__tip strong{display:block;font-size:.76rem;letter-spacing:.04em;margin-bottom:.25rem}.checkpoint{border-top:3px solid var(--accent-primary);display:grid;gap:.75rem;margin:2rem 0;padding:1.25rem}.checkpoint h2{font-size:1.1rem;margin:0}.checkpoint>p:not(.checkpoint__eyebrow){color:var(--text-secondary);line-height:1.7;margin:0}.checkpoint__choices{display:grid;gap:.6rem}.checkpoint__choice{background:var(--background-primary);border:1px solid var(--border-default);color:var(--text-primary);display:grid;gap:.28rem;min-height:0;padding:.9rem;text-align:left}.checkpoint__choice strong{font-size:.9rem}.checkpoint__choice span{color:var(--text-secondary);font-size:.82rem;font-weight:500;line-height:1.55}.checkpoint__choice[data-selected="true"]{border-color:var(--accent-primary);box-shadow:0 0 0 3px color-mix(in srgb,var(--accent-primary) 14%,transparent)}.guide-card{border-top:2px solid var(--accent-primary);margin:2rem 0;padding-top:1rem}.guide-card ol{display:grid;gap:.7rem;list-style:none;margin:0;padding:0}.guide-card li{border:1px solid var(--border-default);color:var(--text-secondary);font-size:.84rem;padding:.75rem}.guide-card li[data-current="true"]{border-color:var(--accent-primary);color:var(--text-primary);font-weight:800}.guide-card li[data-done="true"]::before{content:"✓ ";color:var(--accent-primary)}.actions{display:flex;flex-wrap:wrap;gap:.7rem}.actions button{flex:1 1 13rem}button{background:var(--accent-primary);border:1px solid var(--accent-primary);color:var(--on-accent);cursor:pointer;font:inherit;font-weight:800;min-height:2.8rem;padding:.65rem 1rem}button.secondary{background:var(--background-primary);color:var(--text-primary)}button:disabled{cursor:not-allowed;opacity:.6}output{display:block;min-height:1.5rem;margin-top:.75rem}@media(max-width:560px){.tutorial{padding:2rem 1rem 4rem}.lesson,.checkpoint{padding:1rem}}
</style>

