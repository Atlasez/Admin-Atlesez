    */
    const title = root.querySelector<HTMLElement>("[data-title]")!;
    const body = root.querySelector<HTMLElement>("[data-body]")!;
    const progress = root.querySelector<HTMLElement>("[data-progress]")!;
    const lesson = root.querySelector<HTMLElement>("[data-lesson]")!;
    const checkpoint = root.querySelector<HTMLElement>("[data-checkpoint]")!;
    const checkpointPrompt = root.querySelector<HTMLElement>("[data-checkpoint-prompt]")!;
    const checkpointInstruction = root.querySelector<HTMLElement>("[data-checkpoint-instruction]")!;
    const checkpointChoices = root.querySelector<HTMLElement>("[data-checkpoint-choices]")!;
    const checkpointMessage = root.querySelector<HTMLOutputElement>("[data-checkpoint-message]")!;
    const stepList = root.querySelector<HTMLOListElement>("[data-steps]")!;
    const back = root.querySelector<HTMLButtonElement>("[data-back]")!;
    const next = root.querySelector<HTMLButtonElement>("[data-next]")!;
    const message = root.querySelector<HTMLOutputElement>("[data-message]")!;
    let currentStep = 0;
    let project = "参加プロジェクト";
    let projectSlug = "";
    let savedStep = 0;
    let atlasWritingPracticeComplete = false;
    const selectedCheckpoints = new Map<number, string>();
    const withProject = (value: string) => value.replaceAll("{project}", project);
    const projectWorkspaceGroup = (): LessonGroup => {
      if (projectSlug === "atlas") return {
        heading: "アトラス運営で主に使う画面",
        items: ["「学習サイト『アトラス』運営用サイト」から、編集・フィードバック、タスク管理、カレンダー、同時作業会を開きます。", "自分の担当や自己紹介は「マイページ」で確認し、アトラスの記事作業では「編集・フィードバック」と「作業の進め方」を最初に確認します。"],
      };
      if (projectSlug === "secretariat") return {
        heading: "運営事務局で主に使う画面",
        items: ["「Atlasez運営事務局」から、事務局タスク管理、日程・交流、運営内自己紹介、マイページを開きます。", "メンバー情報の承認など、他の人の状態を変更する機能は必要な管理権限を持つ人だけに表示されます。"],
      };
      if (projectSlug === "seminar-platform") return {
        heading: "ゼミプラットフォームで主に使う画面",
        items: ["「ゼミプラットフォーム」から、ゼミ・タスク管理、日程・交流、運営内自己紹介、マイページを開きます。", "各画面で自分に関係するプロジェクトを選び、担当・期限・予定を確認します。"],
      };
      return {
        heading: "活動を始めた後の画面",
        items: ["役割が設定されると、「Atlasezメンバー用サイト」から、参加中のプロジェクト、タスク、カレンダー、マイページへ進めます。", "プロジェクト専用の画面やタイルは、参加状況と担当に応じて表示されます。"],
      };
    };
    const activeSteps = () => projectTutorials[projectSlug] ?? steps;
    const activeCheckpoints = () => projectTutorialCheckpoints[projectSlug] ?? [];
    const renderCheckpoint = (item: TutorialCheckpoint | undefined) => {
      if (!item) { checkpoint.hidden = true; return; }
      checkpoint.hidden = false;
      checkpointPrompt.textContent = item.prompt;
      checkpointInstruction.textContent = item.instruction;
      checkpointMessage.value = selectedCheckpoints.has(currentStep) ? "選択を確認しました。次へ進めます。" : "画面を一つ選ぶと、次へ進めます。";
      checkpointChoices.replaceChildren(...item.choices.map((choice) => {
        const button = document.createElement("button");
        button.type = "button"; button.className = "checkpoint__choice"; button.dataset.checkpointChoice = choice.id;
        button.dataset.selected = String(selectedCheckpoints.get(currentStep) === choice.id);
        const label = document.createElement("strong"); label.textContent = choice.label;
        const description = document.createElement("span"); description.textContent = choice.description;
        button.replaceChildren(label, description); return button;
      }));
    };
    const render = () => {
      const tutorialSteps = activeSteps();
      const item = tutorialSteps[currentStep];
      title.textContent = item.title;
      body.textContent = item.body;
      progress.textContent = `ステップ ${currentStep + 1} / ${tutorialSteps.length}`;
      lesson.replaceChildren(
        Object.assign(document.createElement("p"), { className: "lesson__goal", textContent: item.goal }),
        ...[...item.groups, ...(currentStep === 0 && !projectTutorials[projectSlug] ? [projectWorkspaceGroup()] : [])].map((group) => {
          const section = document.createElement("section"); section.className = "lesson__group";
          const heading = document.createElement("h2"); heading.textContent = group.heading;
          const list = document.createElement("ul");
          list.replaceChildren(...group.items.map((text) => Object.assign(document.createElement("li"), { textContent: withProject(text) })));
          section.replaceChildren(heading, list); return section;
        }),
        (() => { const note = document.createElement("p"); note.className = "lesson__tip"; const label = document.createElement("strong"); label.textContent = "覚えておくこと"; note.append(label, withProject(item.tip)); return note; })(),
      );
      const checkpointItem = activeCheckpoints()[currentStep];
      renderCheckpoint(checkpointItem);
      stepList.replaceChildren(...tutorialSteps.map((step, index) => {
        const li = document.createElement("li"); li.textContent = step.title;
        if (index < savedStep) li.dataset.done = "true";
        if (index === currentStep) li.dataset.current = "true";
        return li;
      }));
      back.disabled = currentStep === 0;
      next.disabled = Boolean(checkpointItem) && !selectedCheckpoints.has(currentStep);
      next.textContent = currentStep < savedStep
        ? "次のステップへ戻る"
        : currentStep === tutorialSteps.length - 1
          ? projectSlug === "atlas" && !atlasWritingPracticeComplete
            ? "記事編集の練習へ進む"
            : "案内を完了して応募状況へ"
          : "内容を確認して次へ";
    };
    checkpointChoices.addEventListener("click", (event) => {
      const choice = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-checkpoint-choice]");
      if (!choice) return;
      selectedCheckpoints.set(currentStep, choice.dataset.checkpointChoice ?? "");
      message.value = "";
      render();
    });
    fetch("/api/onboarding/tutorial", { credentials: "same-origin", cache: "no-store" })
      .then(async (response) => ({ response, data: await response.json() as { project?: string; projectSlug?: string | null; atlasWritingPracticeComplete?: boolean; step?: number; totalSteps?: number; error?: string } }))
      .then(({ response, data }) => {
        if (!response.ok) throw new Error(data.error ?? "案内を読み込めませんでした。");
        project = data.project || project;
        projectSlug = data.projectSlug || "";
        atlasWritingPracticeComplete = Boolean(data.atlasWritingPracticeComplete);
        savedStep = Math.min(Math.max(data.step ?? 0, 0), activeSteps().length - 1);
        currentStep = savedStep; render();
      })
      .catch((error) => { message.value = error instanceof Error ? error.message : "案内を読み込めませんでした。"; });
    back.addEventListener("click", () => {
      if (currentStep === 0) return;
      currentStep -= 1; message.value = ""; render();
    });
    next.addEventListener("click", async () => {
      if (currentStep < savedStep) { currentStep += 1; message.value = ""; render(); return; }
      if (
        projectSlug === "atlas" &&
        !atlasWritingPracticeComplete &&
        currentStep === activeSteps().length - 1
      ) {
        location.assign("/onboarding/atlas-writing-practice/");
        return;
      }
      next.disabled = true; message.value = "保存中…";
      try {
        const response = await fetch("/api/onboarding/tutorial", { method: "POST", credentials: "same-origin", headers: { "content-type": "application/json" }, body: JSON.stringify({ step: currentStep }) });
        const data = await response.json().catch(() => ({})) as { error?: string; step?: number; complete?: boolean; next?: string };
        if (!response.ok) throw new Error(data.error ?? "進捗を保存できませんでした。");
        if (data.complete) { location.assign(data.next ?? "/applicant/"); return; }
        savedStep = Math.min(data.step ?? currentStep + 1, activeSteps().length - 1);
        currentStep = savedStep; message.value = ""; render();
      } catch (error) { message.value = error instanceof Error ? error.message : "進捗を保存できませんでした。"; next.disabled = false; }
    });
  }
</script>
