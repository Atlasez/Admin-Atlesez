---
import ApplicantLayout from "../../layouts/ApplicantLayout.astro";
import { getCollection } from "astro:content";

const subjects = (await getCollection("subjects")).sort((a, b) => a.data.order - b.data.order);
const countries = ["日本", "韓国", "台湾", "中国", "米国", "カナダ", "英国", "フランス", "ドイツ", "イタリア", "スペイン", "オーストラリア", "ニュージーランド", "インド", "シンガポール", "その他"];
const fallbackTimeZones = ["UTC", "Asia/Tokyo", "Asia/Seoul", "Asia/Taipei", "Asia/Shanghai", "Asia/Singapore", "Asia/Kolkata", "Australia/Sydney", "Pacific/Auckland", "Europe/London", "Europe/Paris", "Europe/Berlin", "America/Los_Angeles", "America/Chicago", "America/New_York", "America/Sao_Paulo", "Africa/Cairo"];
const supportedValuesOf = (Intl as typeof Intl & { supportedValuesOf?: (key: string) => string[] }).supportedValuesOf;
const timeZones = [...new Set([...(supportedValuesOf?.("timeZone") ?? fallbackTimeZones), "UTC"])].sort();
const zoneGroups = timeZones.reduce<Record<string, string[]>>((groups, zone) => {
  const region = zone.includes("/") ? zone.split("/")[0] : "UTC";
  (groups[region] ??= []).push(zone);
  return groups;
}, {});
---

<ApplicantLayout title="運営参加応募" description="Atlasez運営への参加応募" showMemberProfile={true}>
  <main class="apply">
    <section>
      <div class="language-row">
        <select data-language hidden aria-hidden="true"><option value="ja" selected>日本語</option></select>
      </div>
      <h1 data-project-title>運営参加応募</h1>
      <p class="intro" data-project-intro>入力内容は運営参加の選考・連絡、承認後の担当設定にのみ使います。応募内容は運営内運営のみが閲覧します。</p>
      <nav class="form-directory" aria-label="応募フォームの種類">
        <a href="/apply/atlas/" data-form-link="atlas">学習サイト</a>
        <a href="/apply/thinking-cafe/" data-form-link="thinking-cafe">考えるカフェ</a>
        <a href="/apply/seminar-platform/" data-form-link="seminar-platform">ゼミプラットフォーム</a>
        <a href="/apply/student-council-exchange/" data-form-link="student-council-exchange">生徒会</a>
        <a href="/apply/secretariat/" data-form-link="secretariat">運営事務局</a>
      </nav>
      <p class="member-project-note" data-member-project-note hidden>基本情報は登録済みです。応募するプロジェクトを上から選ぶと、プロジェクト固有の入力画面へ進めます。</p>

      <form data-application>
        <p class="privacy-notice"><span data-i18n="privacyNotice">個人情報の取り扱いについて：ご入力いただいた個人情報は、応募内容の確認・選考、応募に関する連絡、受入後のアカウント・担当設定および本人確認のために、必要な範囲で利用します。法令に基づく場合を除き、ご本人の同意なく第三者へ提供しません。選考・運営上必要な期間保管し、利用目的を終えた後は適切に削除します。</span></p>
        <input type="hidden" name="projectSlug" data-project-slug value="atlas" />
        <fieldset data-basic-fieldset>
          <legend data-i18n="basic">基本情報</legend>
          <div class="name-grid">
            <label><span data-i18n="familyName">姓</span><input name="familyName" maxlength="80" required autocomplete="family-name" /></label>
            <label><span data-i18n="givenName">名</span><input name="givenName" maxlength="80" required autocomplete="given-name" /></label>
            <label class="middle-name" hidden><span data-i18n="middleName">ミドルネーム（任意）</span><input name="middleName" maxlength="80" autocomplete="additional-name" /></label>
          </div>
          <div class="name-grid kana-grid">
            <label><span data-i18n="familyNameKana">姓（ふりがな）</span><input name="familyNameKana" maxlength="80" autocomplete="off" /></label>
            <label><span data-i18n="givenNameKana">名（ふりがな）</span><input name="givenNameKana" maxlength="80" autocomplete="off" /></label>
          </div>
          <div class="two">
            <label><span data-i18n="email">メールアドレス</span><input name="email" data-auth-email type="email" maxlength="320" readonly autocomplete="email" /><small>Googleログイン中のアカウントを使用します。</small></label>
            <label><span data-i18n="affiliationType">所属区分</span><select name="affiliationType" data-affiliation required><option value="">選択してください</option><option>中学校</option><option>高等学校</option><option>高等専門学校</option><option>大学</option><option>大学院</option><option>研究機関・教育機関</option><option>社会人</option><option>その他</option></select></label>
          </div>
          <label><span data-i18n="affiliationEmail">学校・所属先のメールアドレス</span><input name="affiliationEmail" type="email" maxlength="320" required autocomplete="off" placeholder="本人確認に使用する学校・勤務先のメールアドレス" /><small data-i18n="affiliationEmailHelp">本人確認のために使用します。学校や勤務先など、所属先から発行されたメールアドレスを入力してください。</small></label>
          <div class="two">
            <div class="institution-field"><label for="institution-input"><span data-i18n="institution">所属機関</span></label><div class="institution-picker"><input id="institution-input" name="institution" data-institution-input maxlength="160" required placeholder="学校名を入力して候補から選択" autocomplete="organization" role="combobox" aria-autocomplete="list" aria-controls="institution-directory" aria-expanded="false" /><div id="institution-directory" class="institution-directory" role="listbox" hidden></div></div><small data-institution-status aria-live="polite">学校名を入力すると候補が表示されます。</small><small class="institution-source">出典：<a href="https://www.mext.go.jp/b_menu/toukei/mext_01087.html" target="_blank" rel="noreferrer">文部科学省「学校コード」</a>（公開データを定期更新）</small></div>
            <label><span data-i18n="grade">学習区分・学年</span><select name="grade" data-grade required><option value="">先に所属区分を選択してください</option><option>中1</option><option>中2</option><option>中3</option><option>高1</option><option>高2</option><option>高3</option><option>高専1</option><option>高専2</option><option>高専3</option><option>高専4</option><option>高専5</option><option>B1</option><option>B2</option><option>B3</option><option>B4</option><option>M1</option><option>M2</option><option>D1</option><option>D2</option><option>D3</option><option>教職員・研究者</option><option>社会人</option><option>その他</option></select></label>
          </div>
          <div class="two">
            <label><span data-i18n="country">居住国・地域</span><input name="country" list="countries" maxlength="100" required placeholder="例：日本" autocomplete="country-name" /></label>
            <label><span data-i18n="timezone">普段使うタイムゾーン</span><select name="timezone" data-timezone required>{Object.entries(zoneGroups).map(([region, zones]) => <optgroup label={region}>{zones.map((zone) => <option value={zone}>{zone}</option>)}</optgroup>)}</select></label>
          </div>
          <div class="two">
            <label>生年月日<input name="birthDate" type="date" required autocomplete="bday" /></label>
            <label>居住地（都道府県・都市名）<input name="residenceCity" maxlength="160" required autocomplete="address-level1" /></label>
          </div>
          <label>現在参加しているサークル・学生団体等（任意）<textarea name="currentOrganizations" maxlength="1000"></textarea></label>
          <label>このプロジェクトをどこで知りましたか<input name="referralSource" maxlength="500" required /></label>
          <small class="hint" data-i18n="timezoneHelp">IANAのタイムゾーンから選択できます。日程表示の基準になります。</small>
          <div class="basic-next" data-basic-next><button type="button" data-next-project>基本情報を保存して次へ</button><output data-profile-message aria-live="polite"></output></div>
        </fieldset>

        <fieldset data-project-content data-project-fieldset hidden>
          <legend data-i18n="interestsTitle">参加したい内容</legend>
          <fieldset class="subject-field" data-project-only="atlas"><legend data-i18n="subjectsLabel">関心のある分野（複数選択可・上限なし）</legend><div class="subjects">{subjects.map((subject) => <label><input type="checkbox" name="desiredSubjects" value={subject.data.slug} /><span data-subject-ja={subject.data.name.ja} data-subject-en={subject.data.name.en ?? subject.data.name.ja}>{subject.data.name.ja}</span></label>)}<label><input type="checkbox" name="desiredSubjects" value="other" /><span data-subject-ja="その他" data-subject-en="Other">その他</span></label></div></fieldset>
          <label data-copy-field="articleIdeas"><span data-i18n="articleIdeas">書いてみたい記事・テーマ</span><textarea name="articleIdeas" maxlength="3000" required placeholder="例：群論の基本概念、英語学習の語源マップ…"></textarea></label>
          <label data-copy-field="interests"><span data-i18n="skills">関心のあるプロジェクト・できること</span><textarea name="interests" maxlength="1000" required placeholder="例：記事執筆、査読、翻訳、ページデザイン、運営など"></textarea></label>
          <label data-copy-field="message"><span data-i18n="message">参加したい理由・自己紹介</span><textarea name="message" maxlength="8000" required></textarea></label>
          <label data-copy-field="motivation">参加理由（複数ある場合はすべて）<textarea name="motivationReasons" maxlength="3000" required placeholder="学習記事の執筆、運営への関心、交流など"></textarea></label>
          <label data-copy-field="roles">希望担当（複数ある場合はすべて）<textarea name="desiredRoles" maxlength="2000" required placeholder="記事執筆、査読、デザイン、システム、運営など"></textarea></label>
          <div class="project-extra" data-project-extra="thinking-cafe" hidden>
            <label>参加してみたいテーマ<textarea data-project-answer="theme" maxlength="3000" required></textarea></label>
          </div>
          <div class="project-extra" data-project-extra="student-council-exchange" hidden>
            <label>生徒会への所属または所属経験の有無<input data-project-answer="councilStatus" maxlength="300" required /></label>
            <label>生徒会での役職名<input data-project-answer="councilRole" maxlength="300" required /></label>
            <label>運営としてどんな活動や企画をしたいですか？<textarea data-project-answer="councilPlans" maxlength="4000" required></textarea></label>
          </div>
          <div class="project-extra" data-project-extra="secretariat" hidden>
            <label>あなたの得意なこと・資格・実績<textarea data-project-answer="strengths" maxlength="4000" required></textarea></label>
            <label>日頃持っている問題意識<textarea data-project-answer="problemAwareness" maxlength="4000" required></textarea></label>
            <label>本協議会で取り組みたいこと<textarea data-project-answer="plans" maxlength="4000" required></textarea></label>
          </div>
          <label>面談候補日・時間帯<textarea name="interviewAvailability" maxlength="2000" required placeholder="タイムゾーンも併記してください"></textarea></label>
          <label><span data-i18n="availability">参加可能な時間帯など（任意）</span><textarea name="availabilityNote" maxlength="1000"></textarea></label>
          <label>質問・確認したいこと（任意）<textarea name="applicantQuestions" maxlength="3000"></textarea></label>
        </fieldset>
        <datalist id="countries">{countries.map((country) => <option value={country} />)}</datalist>
        <div class="turnstile" data-turnstile aria-live="polite"></div>
        <label class="trap" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off" /></label>
        <button type="submit" data-i18n="submit">応募を送信</button>
        <output data-result aria-live="polite"></output>
      </form>
    </section>
  </main>
</ApplicantLayout>

<style>
  .apply{box-sizing:border-box;margin:0 auto;max-width:920px;padding:2rem 1.25rem 4rem}.brand{color:var(--accent-primary);font-size:1.1rem;font-weight:800;text-decoration:none}.apply section{border-top:2px solid var(--accent-primary);margin-top:2rem;padding-top:1.5rem}.language-row{align-items:center;display:flex;justify-content:space-between;gap:1rem}.apply p{color:var(--accent-primary);font-size:.76rem;font-weight:800;letter-spacing:.08em;margin:0}.language-picker{align-items:center;display:flex;gap:.45rem;font-size:.78rem;font-weight:700}.language-picker select{padding:.35rem .5rem}.apply h1{font-size:2rem;margin:.35rem 0}.intro{color:var(--text-secondary)!important;font-size:.9rem!important;letter-spacing:0!important;line-height:1.7}.apply form{display:grid;gap:1rem;margin-top:1.5rem}.apply fieldset{border:1px solid var(--border-default);display:grid;gap:.8rem;margin:0;padding:1rem}.apply legend{color:var(--accent-primary);font-size:.82rem;font-weight:800;padding:0 .35rem}.apply label,.institution-field{display:grid;font-size:.82rem;font-weight:800;gap:.35rem}.apply input,.apply textarea,.apply select{background:var(--background-primary);border:1px solid var(--border-default);box-sizing:border-box;color:var(--text-primary);font:inherit;min-height:2.8rem;padding:.65rem;width:100%}.apply textarea{min-height:6rem;resize:vertical}.apply small{color:var(--text-secondary);font-size:.74rem;font-weight:500;line-height:1.5}.two,.name-grid{display:grid;gap:.8rem;grid-template-columns:repeat(2,minmax(0,1fr))}.name-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.kana-grid{grid-template-columns:repeat(2,minmax(0,1fr));max-width:calc(66.666% - .25rem)}.subject-field{background:var(--background-secondary);padding:.8rem}.subjects{display:flex;flex-wrap:wrap;gap:.45rem}.subjects label{align-items:center;background:var(--background-primary);border:1px solid var(--border-default);border-radius:999px;display:flex;font-size:.76rem;gap:.3rem;padding:.3rem .55rem}.subjects input{accent-color:var(--accent-primary);min-height:1rem;padding:0;width:auto}.hint{display:block}.apply button{background:var(--accent-primary);border:0;color:#fff;cursor:pointer;font:inherit;font-weight:800;padding:.8rem}.apply output{color:var(--text-secondary);min-height:1.3rem}.trap{height:0;opacity:0;overflow:hidden;pointer-events:none}.language-picker select{min-height:2rem}.institution-picker{position:relative}.institution-directory{background:var(--background-primary);border:1px solid var(--border-default);box-shadow:0 8px 20px rgba(0,0,0,.14);display:grid;gap:0;left:0;max-height:18rem;overflow-y:auto;position:absolute;right:0;top:calc(100% + .2rem);z-index:10}.institution-directory[hidden]{display:none}.institution-directory button{background:var(--background-primary);border:0;border-bottom:1px solid var(--border-default);color:var(--text-primary);cursor:pointer;font-size:.78rem;font-weight:600;padding:.65rem .75rem;text-align:left}.institution-directory button:last-child{border-bottom:0}.institution-directory button:hover,.institution-directory button:focus-visible{background:var(--background-secondary);outline:2px solid var(--accent-primary);outline-offset:-2px}.institution-source a{color:var(--accent-primary);font-weight:700}@media(max-width:650px){.apply{padding:1.25rem .85rem 3rem}.language-row{align-items:flex-start;flex-direction:column}.two,.name-grid,.kana-grid{grid-template-columns:1fr;max-width:none}}
  .form-directory{display:flex;flex-wrap:wrap;gap:.45rem;margin-top:1rem}.form-directory a{border:1px solid var(--border-default);border-radius:999px;color:var(--text-primary);font-size:.76rem;padding:.35rem .6rem;text-decoration:none}.form-directory a[aria-current="true"]{background:var(--accent-primary);border-color:var(--accent-primary);color:#fff}.member-project-note{background:var(--background-secondary);border-left:3px solid var(--accent-primary);color:var(--text-secondary)!important;font-size:.82rem!important;font-weight:500!important;letter-spacing:0!important;line-height:1.6;margin:1rem 0 0!important;padding:.65rem .75rem}.privacy-notice{background:var(--background-secondary);border-left:3px solid var(--accent-primary);color:var(--text-secondary)!important;font-size:.82rem!important;font-weight:500!important;letter-spacing:0!important;line-height:1.7;margin:0!important;padding:.75rem .85rem}.privacy-notice a{color:var(--accent-primary);font-weight:700}.basic-next{align-items:center;display:flex;flex-wrap:wrap;gap:.6rem}.basic-next button{width:auto}.basic-next output{color:var(--text-secondary);font-size:.78rem}.project-extra{display:grid;gap:.8rem}
  .apply select{height:2.8rem;max-height:2.8rem}
</style>

<script>
  import { resolveApplicationProjectSlug } from "../../lib/application-project";

  const form = document.querySelector<HTMLFormElement>("[data-application]");
  if (form) {
    const page = document.querySelector<HTMLElement>(".apply")!;
    const authenticatedEmail = form.querySelector<HTMLInputElement>("[data-auth-email]");
    const userStatusPromise = fetch("/api/user/status", { credentials: "same-origin", cache: "no-store" })
      .then(async (response) => ({ response, data: await response.json() as { email?: string; stage?: string; applicationStatus?: string | null } }));
    void userStatusPromise
      .then(({ response, data }) => {
        if (response.ok && authenticatedEmail && data.email) authenticatedEmail.value = data.email;
      })
      .catch(() => undefined);
    const result = document.querySelector<HTMLOutputElement>("[data-result]")!;
    const slot = document.querySelector<HTMLElement>("[data-turnstile]")!;
    const tz = form.querySelector<HTMLSelectElement>("[data-timezone]")!;
    const affiliation = form.querySelector<HTMLSelectElement>("[data-affiliation]")!;
    const grade = form.querySelector<HTMLSelectElement>("[data-grade]")!;
    const language = form.querySelector<HTMLSelectElement>("[data-language]") ?? (() => {
      const fallback = document.createElement("select");
      const option = document.createElement("option");
      option.value = "ja";
      option.textContent = "日本語";
      fallback.append(option);
      return fallback;
    })();
    const institutionInput = form.querySelector<HTMLInputElement>("[data-institution-input]")!;
    const institutionList = form.querySelector<HTMLElement>("#institution-directory")!;
    const institutionStatus = form.querySelector<HTMLElement>("[data-institution-status]")!;
    const middle = form.querySelector<HTMLElement>(".middle-name")!;
    const projectSlugInput = form.querySelector<HTMLInputElement>("[data-project-slug]")!;
    const basicFieldset = form.querySelector<HTMLFieldSetElement>("[data-basic-fieldset]")!;
    const projectFieldset = form.querySelector<HTMLFieldSetElement>("[data-project-fieldset]")!;
    const nextProjectButton = form.querySelector<HTMLButtonElement>("[data-next-project]")!;
    const profileMessage = form.querySelector<HTMLOutputElement>("[data-profile-message]")!;
    const basicNext = form.querySelector<HTMLElement>("[data-basic-next]")!;
    const memberProjectNote = page.querySelector<HTMLElement>("[data-member-project-note]")!;
    const projectTitle = page.querySelector<HTMLElement>("[data-project-title]")!;
    const projectIntro = page.querySelector<HTMLElement>("[data-project-intro]")!;
    const projectForms: Record<string, { title: string; intro: string; article: string; interests: string; message: string; motivation: string; roles: string; articlePlaceholder: string }> = {
      atlas: { title: "学習サイト「アトラス」運営応募", intro: "学習サイト「アトラス」の記事執筆・査読・翻訳・運営に関する応募フォームです。", article: "書いてみたい記事・テーマ", interests: "関心のあるプロジェクト・できること", message: "参加したい理由・自己紹介", motivation: "参加理由（複数ある場合はすべて）", roles: "希望担当（複数ある場合はすべて）", articlePlaceholder: "例：群論の基本概念、英語学習の語源マップ…" },
      "thinking-cafe": { title: "考えるカフェ参加・運営応募", intro: "考えるカフェで扱いたいテーマや、対話の場づくりへの関心をお聞きします。", article: "参加してみたいテーマ", interests: "興味のある対話分野・できること", message: "参加してみたい理由・自己紹介", motivation: "", roles: "", articlePlaceholder: "考えてみたい問いや話し合いたいテーマ" },
      "seminar-platform": { title: "ゼミプラットフォーム運営応募", intro: "ゼミの企画・参加・運営に関する応募フォームです。", article: "ゼミで扱いたいテーマ", interests: "関心のある分野・できること", message: "参加したい理由・自己紹介", motivation: "参加理由", roles: "担当したい仕事内容", articlePlaceholder: "立ち上げたいゼミや扱いたいテーマ" },
      "student-council-exchange": { title: "日本生徒会協会運営応募", intro: "生徒会活動の経験や、学校を越えた交流・企画への関心をお聞きします。", article: "取り組みたい活動・企画", interests: "関心のある生徒会活動・できること", message: "参加したい理由・自己紹介", motivation: "参加理由", roles: "希望する役割", articlePlaceholder: "交流会、情報共有、企画など" },
      secretariat: { title: "Atlasez運営事務局応募", intro: "Atlasez全体の運営事務局で取り組みたいことをお聞きします。", article: "本協議会で取り組みたいこと", interests: "得意なこと・資格・実績", message: "志望動機・自己紹介", motivation: "志望動機", roles: "希望する部署", articlePlaceholder: "取り組みたい課題や具体的な活動" },
    };
    const searchParams = new URLSearchParams(location.search);
    const forceBasicStep = searchParams.get("step") === "basic";
    const projectSlug = resolveApplicationProjectSlug(location.pathname, location.search);
    const directProjectScreen = !forceBasicStep && (/^\/apply\/[^/]+\/?$/.test(location.pathname) || Boolean(searchParams.get("project")));
    const projectConfig = projectForms[projectSlug];
    projectSlugInput.value = projectSlug;
    projectTitle.textContent = directProjectScreen ? projectConfig.title : "運営参加応募 / 基本情報";
    projectIntro.textContent = directProjectScreen ? projectConfig.intro : "まず基本情報を登録し、その後に応募するプロジェクト固有の項目を入力します。基本情報は次回以降の応募でも再利用できます。";
    for (const link of page.querySelectorAll<HTMLAnchorElement>("[data-form-link]")) {
      if (directProjectScreen && link.dataset.formLink === projectSlug) link.setAttribute("aria-current", "true"); else link.removeAttribute("aria-current");
    }
    const copyField = (key: string, label: string, placeholder: string) => {
      const field = form.querySelector<HTMLElement>(`[data-copy-field="${key}"]`);
      if (!field) return;
      const span = field.querySelector<HTMLElement>("span");
      const control = field.querySelector<HTMLInputElement | HTMLTextAreaElement>("input,textarea");
      if (span) span.textContent = label;
      if (control && "placeholder" in control) control.placeholder = placeholder;
    };
    copyField("articleIdeas", projectConfig.article, projectConfig.articlePlaceholder);
    copyField("interests", projectConfig.interests, "経験・関心・貢献できること");
    copyField("message", projectConfig.message, "");
    copyField("motivation", projectConfig.motivation, "");
    copyField("roles", projectConfig.roles, "");
    const setProjectField = (selector: string, visible: boolean, required: boolean) => {
      const field = form.querySelector<HTMLElement>(selector);
      if (!field) return;
      field.hidden = !visible;
