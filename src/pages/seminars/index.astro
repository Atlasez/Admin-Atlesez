---
import SeminarLayout from "../../layouts/SeminarLayout.astro";
import { recruitmentLabels } from "../../lib/seminar-fields";
---
<SeminarLayout title="ゼミプラットフォーム" page="catalog">
  <section class="seminar-lead" aria-labelledby="seminar-heading">
    <h1 id="seminar-heading">ゼミプラットフォーム</h1>
    <p>教科書を輪読したり、調べたことを発表し合ったりする自主ゼミを掲載しています。参加を希望する方は、各ゼミの詳細から主催者に申請できます。</p>
    <div class="seminar-actions">
      <a class="button" href="#catalog">ゼミを探す</a>
      <a href="/seminars/propose/">ゼミを企画する</a>
      <a href="/seminars/join/">参加申請</a>
    </div>
  </section>
  <section id="catalog" class="seminar-directory" aria-labelledby="catalog-heading">
    <div class="seminar-section-head">
      <h2 id="catalog-heading">ゼミ一覧</h2>
      <p data-count role="status"></p>
    </div>
    <div class="seminar-filter">
      <div class="seminar-section-head"><h3>検索条件</h3></div>
      <label>キーワード <input type="search" data-query placeholder="ゼミ名・番号・テーマ・教材" /></label>
      <label>募集状況
        <select data-recruitment>
          <option value="">すべて</option>
          {Object.entries(recruitmentLabels).map(([value, label]) => <option value={value}>{label}</option>)}
        </select>
      </label>
    </div>
    <div class="seminar-directory-results" data-page-content aria-busy="true">
      <p role="status">ゼミ一覧を読み込んでいます。</p>
    </div>
  </section>
</SeminarLayout>
