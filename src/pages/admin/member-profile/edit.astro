---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { getTimeZoneOptions } from "../../../lib/timezones";
const timezones = getTimeZoneOptions(new Date());
const memberYears = ["中1","中2","中3","高1","高2","高3","高専1","高専2","高専3","高専4","高専5","B1","B2","B3","B4","M1","M2","D1","D2","D3","教職員・研究者","社会人","その他"];
---
<AdminLayout title="プロフィール編集" description="メンバー基本情報の変更を申請します">
  <main class="profile-edit" data-profile-edit>
    <header><a href="/admin/member-profile/">← マイページに戻る</a><p class="eyebrow">メンバー情報</p><h1>プロフィール編集</h1><p>変更内容は運営事務局の承認後に反映されます。</p></header>
    <section class="edit-card"><div class="avatar-row"><div class="avatar-preview" data-avatar-preview aria-hidden="true">A</div><label>プロフィール画像<input type="file" accept="image/png,image/jpeg,image/webp" data-avatar-file /><small>PNG・JPEG・WebP、2MB以下</small></label></div><div class="form-grid">
      <label>氏名<input data-display-name maxlength="120" required /></label><label>学校・所属<input data-university maxlength="200" /></label>
      <label>学年等<select data-year><option value="">選択してください</option>{memberYears.map((year)=><option value={year}>{year}</option>)}</select></label>
      <label>所属区分<select data-affiliation-type><option value="">選択してください</option><option value="student">学生</option><option value="faculty">教職員</option><option value="worker">社会人</option><option value="other">その他</option></select></label>
      <label>国・地域<input data-country maxlength="120" /></label><label>タイムゾーン<input data-timezone list="profile-edit-timezones" value="Asia/Tokyo" /><small data-timezone-offset></small></label>
    </div><datalist id="profile-edit-timezones">{timezones.map(({value,label})=><option value={value} label={label}></option>)}</datalist>
    <label>運営外自己紹介<textarea data-bio maxlength="4000"></textarea></label>
    <div class="actions"><output data-message aria-live="polite"></output><button type="button" data-save>変更を承認申請</button></div></section>
  </main>
</AdminLayout>
<style>
  .profile-edit{margin:0 auto;max-width:900px;padding:0 1.25rem 4rem}.profile-edit header{border-bottom:1px solid var(--border-default);padding:2rem 0 1.25rem}.profile-edit header a{color:var(--accent-primary);font-size:.8rem;font-weight:800;text-decoration:none}.eyebrow{color:var(--accent-primary);font-size:.72rem;font-weight:800;letter-spacing:.06em;margin:1.4rem 0 .3rem}.profile-edit h1{font-size:clamp(1.8rem,4vw,2.35rem);margin:0}.profile-edit header p:last-child{color:var(--text-secondary);font-size:.82rem;line-height:1.6}.edit-card{border:1px solid var(--border-default);border-top:2px solid var(--accent-primary);display:grid;gap:1rem;margin-top:1.25rem;padding:1rem}.avatar-row{align-items:center;display:flex;gap:1rem}.avatar-preview{align-items:center;background:linear-gradient(145deg,#2d6ea8,#153c66);background-position:center;background-size:cover;border:1px solid var(--border-default);border-radius:50%;color:#fff;display:flex;flex:0 0 4.5rem;font-size:1.6rem;font-weight:800;height:4.5rem;justify-content:center;overflow:hidden;width:4.5rem}.form-grid{display:grid;gap:.7rem;grid-template-columns:repeat(3,1fr)}label{display:grid;font-weight:700;gap:.35rem}input,select,textarea{background:var(--background-primary);border:1px solid var(--border-default);box-sizing:border-box;color:var(--text-primary);font:inherit;padding:.55rem;width:100%}textarea{min-height:12rem;resize:vertical}small,output{color:var(--text-secondary)}.actions{align-items:center;display:flex;gap:1rem;justify-content:space-between}.actions button{background:var(--accent-primary);border:1px solid var(--accent-primary);color:#fff;cursor:pointer;font:inherit;font-weight:800;padding:.6rem .8rem}@media(max-width:700px){.profile-edit{padding:0 .8rem 3rem}.avatar-row{align-items:start;flex-direction:column}.form-grid{grid-template-columns:1fr}.actions{align-items:stretch;flex-direction:column}.actions button{width:100%}}
</style>
<script>
  import { readAdminApiJson } from "../../../lib/admin-api";
  import { formatUtcOffset, isValidTimeZone, timeZoneOffsetMinutes } from "../../../lib/timezones";
  type Profile={display_name?:string;university?:string;year?:string;affiliation_type?:string;country?:string;timezone?:string;bio?:string;avatar_url?:string};
  type ResponseData={profile?:Profile;profileChangeRequest?:{status?:string;proposed_display_name?:string;proposed_university?:string;proposed_year?:string;proposed_affiliation_type?:string;proposed_country?:string;proposed_timezone?:string;proposed_bio?:string};error?:string};
  const initialize=()=>{const root=document.querySelector<HTMLElement>("[data-profile-edit]");if(!root||root.dataset.ready)return;root.dataset.ready="true";const get=<T extends Element>(selector:string)=>root.querySelector<T>(selector)!;const message=get<HTMLOutputElement>("[data-message]"),timezone=get<HTMLInputElement>("[data-timezone]"),avatar=get<HTMLElement>("[data-avatar-preview]"),avatarFile=get<HTMLInputElement>("[data-avatar-file]");let avatarUrl="";const set=(selector:string,value:string)=>{get<HTMLInputElement|HTMLSelectElement|HTMLTextAreaElement>(selector).value=value};const updateTimezone=()=>{const value=timezone.value.trim();get<HTMLElement>("[data-timezone-offset]").textContent=isValidTimeZone(value)?`現在のオフセット: ${formatUtcOffset(timeZoneOffsetMinutes(value))}`:"IANAタイムゾーンを入力してください。"};const apply=(profile:Profile)=>{set("[data-display-name]",profile.display_name??"");set("[data-university]",profile.university??"");set("[data-year]",profile.year??"");set("[data-affiliation-type]",profile.affiliation_type??"");set("[data-country]",profile.country??"");set("[data-timezone]",profile.timezone||"Asia/Tokyo");set("[data-bio]",profile.bio??"");avatarUrl=profile.avatar_url??"";avatar.style.backgroundImage=avatarUrl?`url(${JSON.stringify(avatarUrl)})`:"";avatar.textContent=avatarUrl?"":"A";updateTimezone()};void fetch("/api/admin/profile",{credentials:"same-origin",cache:"no-store"}).then(async response=>{const data=await readAdminApiJson<ResponseData>(response,"プロフィール情報を読み込めませんでした。");if(!response.ok)throw new Error(data.error);const request=data.profileChangeRequest;if(request?.status==="pending")apply({display_name:request.proposed_display_name,university:request.proposed_university,year:request.proposed_year,affiliation_type:request.proposed_affiliation_type,country:request.proposed_country,timezone:request.proposed_timezone,bio:request.proposed_bio});else apply(data.profile??{});if(request?.status==="pending")message.value="変更申請は承認待ちです。再申請すると内容を更新します。"}).catch(error=>message.value=error instanceof Error?error.message:"読み込めませんでした。");avatarFile.addEventListener("change",()=>{const file=avatarFile.files?.[0];if(!file)return;if(file.size>2_000_000){message.value="画像は2MB以下にしてください。";return}const reader=new FileReader();reader.onload=()=>{avatarUrl=String(reader.result??"");avatar.style.backgroundImage=`url(${JSON.stringify(avatarUrl)})`;avatar.textContent=""};reader.readAsDataURL(file)});timezone.addEventListener("input",updateTimezone);timezone.addEventListener("change",updateTimezone);get<HTMLButtonElement>("[data-save]").addEventListener("click",async()=>{const displayName=get<HTMLInputElement>("[data-display-name]").value.trim();if(!displayName){message.value="氏名を入力してください。";return}message.value="運営事務局へ申請中…";const response=await fetch("/api/admin/profile",{method:"PUT",credentials:"same-origin",headers:{"content-type":"application/json"},body:JSON.stringify({displayName,university:get<HTMLInputElement>("[data-university]").value,year:get<HTMLSelectElement>("[data-year]").value,affiliationType:get<HTMLSelectElement>("[data-affiliation-type]").value,country:get<HTMLInputElement>("[data-country]").value,timezone:timezone.value,bio:get<HTMLTextAreaElement>("[data-bio]").value,avatarUrl})});const data=await readAdminApiJson<{error?:string}>(response,"申請を送信できませんでした。");message.value=response.ok?"変更内容を運営事務局へ送りました。承認後に反映されます。":data.error??"申請できませんでした。"})};document.addEventListener("astro:page-load",initialize);initialize();
</script>
