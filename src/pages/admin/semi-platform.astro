---
import AdminLayout from "../../layouts/AdminLayout.astro";
---
<AdminLayout title="ゼミプラットフォーム" description="ゼミプラットフォームの運営ワークスペース">
  <main class="semi-platform-home">
    <header class="project-heading">
      <div>
        <h1>ゼミプラットフォーム</h1>
        <span>このプロジェクトの運営スペースです。</span>
      </div>
      <a href="/admin/portal/">Atlasezメンバー用サイトへ</a>
    </header>
    <section class="empty-state" aria-label="ゼミプラットフォームの準備中">
      <h2>準備中</h2>
      <p>ゼミプラットフォームの共有スペース、ToDo、日程は整備後にここへ追加します。</p>
    </section>
  </main>
</AdminLayout>
<style>
  .semi-platform-home { margin: 0 auto; max-width: 1200px; padding: 0 1.25rem 4rem; }
  .project-heading { align-items: end; border-bottom: 1px solid var(--border-default); display: flex; gap: 1rem; justify-content: space-between; padding: 2.2rem 0 1.4rem; }
  .project-heading h1 { font-size: clamp(1.8rem, 4vw, 2.6rem); margin: .25rem 0; }
  .project-heading span { color: var(--text-secondary); line-height: 1.6; }
  .project-heading > a { color: var(--accent-primary); font-size: .8rem; font-weight: 800; text-decoration: none; white-space: nowrap; }
  .empty-state { border: 1px solid var(--border-default); color: var(--text-secondary); margin-top: 1.5rem; padding: 3rem 1.5rem; text-align: center; }
  .empty-state h2 { color: var(--text-primary); font-size: 1.25rem; margin: 0 0 .55rem; }
  .empty-state p { line-height: 1.7; margin: 0; }
  @media (max-width: 700px) {
    .semi-platform-home { padding: 0 .8rem 3rem; }
    .project-heading { align-items: start; display: grid; }
  }
</style>
