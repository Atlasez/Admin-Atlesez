---
import AdminLayout from "../../layouts/AdminLayout.astro";
import AdminNav from "../../components/AdminNav.astro";
---
<AdminLayout title="ゼミプラットフォーム" description="ゼミプラットフォームの運営ワークスペース">
  <main class="semi-platform-home">
    <AdminNav current="semi-platform" site="semi-platform" />
    <header class="project-heading">
      <div>
        <p>ATLASEZ / SEMI PLATFORM</p>
        <h1>ゼミプラットフォーム</h1>
        <span>ゼミプラットフォームの運営タスク、日程、関連サイトをまとめて管理します。</span>
      </div>
      <a href="/admin/portal/">AtlasezプロジェクトHomeへ</a>
    </header>

    <section class="project-links" aria-label="ゼミプラットフォーム運営メニュー">
      <a class="featured" href="/admin/operations/?project=semi-platform">
        <strong>進捗・ToDo・日程</strong>
        <small>作業報告、担当タスク、予定をまとめて管理します。</small>
        <span>管理する →</span>
      </a>
      <a class="featured" href="/admin/co-working/?project=semi-platform">
        <strong>日程・同時作業会</strong>
        <small>開催候補や参加可否を確認し、作業予定を共有します。</small>
        <span>日程を見る →</span>
      </a>
      <a href="https://sites.google.com/view/atlasez-semi" target="_blank" rel="noreferrer">
        <strong>現行サイト</strong>
        <small>ゼミプラットフォームの外部サイトを確認します。</small>
        <span>サイトを開く →</span>
      </a>
      <a href="/admin/portal/">
        <strong>AtlasezプロジェクトHome</strong>
        <small>運営メンバー向けの共通ポータルを開きます。</small>
        <span>Homeを開く →</span>
      </a>
    </section>
  </main>
</AdminLayout>
<style>
  .semi-platform-home { margin: 0 auto; max-width: 1200px; padding: 0 1.25rem 4rem; }
  .project-heading { align-items: end; border-bottom: 1px solid var(--border-default); display: flex; gap: 1rem; justify-content: space-between; padding: 2.2rem 0 1.4rem; }
  .project-heading p { color: var(--accent-primary); font-size: .72rem; font-weight: 800; letter-spacing: .1em; margin: 0; }
  .project-heading h1 { font-size: clamp(1.8rem, 4vw, 2.6rem); margin: .25rem 0; }
  .project-heading span { color: var(--text-secondary); line-height: 1.6; }
  .project-heading > a { color: var(--accent-primary); font-size: .8rem; font-weight: 800; text-decoration: none; white-space: nowrap; }
  .project-links { display: grid; gap: .8rem; grid-template-columns: repeat(2, minmax(0, 1fr)); margin-top: 1.5rem; }
  .project-links a { background: var(--background-secondary); border: 1px solid var(--border-default); color: var(--text-primary); display: grid; gap: .4rem; min-height: 7rem; padding: 1.2rem; text-decoration: none; }
  .project-links a:hover { border-color: var(--accent-primary); transform: translateY(-1px); }
  .project-links .featured { border-top: 4px solid var(--accent-primary); min-height: 9rem; }
  .project-links strong { font-size: 1.05rem; }
  .project-links small { color: var(--text-secondary); font-size: .78rem; line-height: 1.55; }
  .project-links span { color: var(--accent-primary); font-size: .76rem; font-weight: 800; margin-top: auto; }
  @media (max-width: 700px) {
    .semi-platform-home { padding: 0 .8rem 3rem; }
    .project-heading { align-items: start; display: grid; }
    .project-links { grid-template-columns: 1fr; }
  }
</style>
