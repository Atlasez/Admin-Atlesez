---
import AdminLayout from "../../layouts/AdminLayout.astro";

const requestedProject = Astro.url.searchParams.get("project") ?? "atlas";
const project = requestedProject === "secretariat" ? "secretariat" : requestedProject === "seminar-platform" ? "seminar-platform" : "atlas";
---

<AdminLayout title="運営内自己紹介の承認" description="プロジェクト内プロフィールの変更申請を処理します">
  <main class="request-page" data-request-page data-project={project}>
    <header><h1>運営内自己紹介の承認</h1></header>
    <div class="filters"><label>状態<select data-status><option value="pending">承認待ち</option><option value="approved">承認済み</option><option value="rejected">却下済み</option><option value="all">すべて</option></select></label></div>
    <output data-message aria-live="polite"></output>
    <section data-list aria-label="変更申請一覧"><p>読み込み中…</p></section>
  </main>
</AdminLayout>

<style>
  .request-page{margin:0 auto;max-width:1050px;padding:0 1.25rem 4rem}.request-page header{border-bottom:1px solid var(--border-default);padding:2rem 0 1.25rem}.request-page h1{font-size:2rem;margin:0}.filters{display:flex;gap:.7rem;margin:1rem 0}.filters label{display:grid;font-size:.76rem;font-weight:800;gap:.25rem}.filters select,.review-note{background:var(--background-primary);border:1px solid var(--border-default);color:var(--text-primary);font:inherit;padding:.5rem}.request-page>output{color:var(--text-secondary);display:block;font-size:.78rem;min-height:1.2rem}.request-page section{display:grid;gap:.75rem;margin-top:.5rem}.request{border:1px solid var(--border-default);border-top:2px solid var(--accent-primary);display:grid;gap:.8rem;padding:1rem}.request-heading{align-items:start;display:flex;gap:.75rem;justify-content:space-between}.request-heading h2{font-size:1.05rem;margin:0}.request-heading small{color:var(--text-secondary)}.request-heading span{border:1px solid var(--border-default);font-size:.7rem;font-weight:800;padding:.2rem .4rem}.comparison{display:grid;gap:.65rem;grid-template-columns:repeat(2,minmax(0,1fr))}.comparison>div{background:var(--background-secondary);border:1px solid var(--border-default);padding:.65rem}.comparison h3{font-size:.78rem;margin:0 0 .4rem}.comparison p{font-size:.8rem;line-height:1.65;margin:0;white-space:pre-wrap}.review{display:grid;gap:.5rem}.review label{display:grid;font-size:.76rem;font-weight:800;gap:.25rem}.review-actions{display:flex;flex-wrap:wrap;gap:.5rem}.review-actions button{border:1px solid var(--border-default);cursor:pointer;font:inherit;font-size:.78rem;font-weight:800;padding:.5rem .75rem}.approve{background:var(--accent-primary);border-color:var(--accent-primary)!important;color:#fff}.reject{background:var(--background-primary);color:var(--text-primary)}.empty{color:var(--text-secondary);padding:2rem;text-align:center}@media(max-width:700px){.request-page{padding:0 .85rem 3rem}.request-heading{display:grid}.comparison{grid-template-columns:1fr}}
</style>

<script>
  type RequestRow={id:string;email:string;display_name?:string;current_internal_bio?:string;proposed_internal_bio?:string;status:string;submitted_at:string;review_note?:string};
  const initializeRequests=()=>{const root=document.querySelector<HTMLElement>("[data-request-page]");if(!root||root.dataset.initialized==="true")return;root.dataset.initialized="true";const project=root.dataset.project??"atlas";const status=root.querySelector<HTMLSelectElement>("[data-status]")!;const list=root.querySelector<HTMLElement>("[data-list]")!;const message=root.querySelector<HTMLOutputElement>("[data-message]")!;const escape=(value:unknown)=>String(value??"").replace(/[&<>"']/g,character=>({"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#39;"}[character]??character));const statusLabel=(value:string)=>value==="pending"?"承認待ち":value==="approved"?"承認済み":"却下済み";const format=(value:string)=>new Intl.DateTimeFormat("ja-JP",{dateStyle:"medium",timeStyle:"short"}).format(new Date(value));
    const render=(rows:RequestRow[])=>{list.innerHTML=rows.length?rows.map(row=>`<article class="request"><div class="request-heading"><div><h2>${escape(row.display_name||row.email)}</h2><small>${escape(row.email)} ・ ${escape(format(row.submitted_at))}</small></div><span>${statusLabel(row.status)}</span></div><div class="comparison"><div><h3>現在の自己紹介</h3><p>${escape(row.current_internal_bio)||"未登録"}</p></div><div><h3>申請内容</h3><p>${escape(row.proposed_internal_bio)||"未登録"}</p></div></div>${row.status==="pending"?`<div class="review"><label>承認・却下メモ<input class="review-note" data-note="${escape(row.id)}" maxlength="2000" /></label><div class="review-actions"><button type="button" class="approve" data-review="approve" data-id="${escape(row.id)}">承認</button><button type="button" class="reject" data-review="reject" data-id="${escape(row.id)}">却下</button></div></div>`:row.review_note?`<small>処理メモ：${escape(row.review_note)}</small>`:""}</article>`).join(""):"<p class=\"empty\">この状態の申請はありません。</p>"};
    const load=async()=>{message.value="";const response=await fetch(`/api/admin/project-profile-change-requests?project=${encodeURIComponent(project)}&status=${encodeURIComponent(status.value)}`,{credentials:"same-origin",cache:"no-store"});const data=await response.json() as {requests?:RequestRow[];error?:string};if(!response.ok)throw new Error(data.error??"申請を読み込めませんでした。");render(data.requests??[])};
    status.addEventListener("change",()=>void load().catch(error=>{message.value=error instanceof Error?error.message:"申請を読み込めませんでした。"}));list.addEventListener("click",async event=>{const button=(event.target as HTMLElement).closest<HTMLButtonElement>("[data-review]");if(!button)return;button.disabled=true;message.value="処理中…";const id=button.dataset.id??"";const note=list.querySelector<HTMLInputElement>(`[data-note="${CSS.escape(id)}"]`)?.value??"";try{const response=await fetch(`/api/admin/project-profile-change-requests/${encodeURIComponent(id)}`,{method:"PATCH",credentials:"same-origin",headers:{"content-type":"application/json"},body:JSON.stringify({action:button.dataset.review,reviewNote:note})});const data=await response.json() as {error?:string};if(!response.ok)throw new Error(data.error??"処理できませんでした。");message.value="処理しました。";await load()}catch(error){message.value=error instanceof Error?error.message:"処理できませんでした。";button.disabled=false}});void load().catch(error=>{message.value=error instanceof Error?error.message:"申請を読み込めませんでした。"});
  };document.addEventListener("astro:page-load",initializeRequests);initializeRequests();
</script>
