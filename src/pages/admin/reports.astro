---
import AdminLayout from "../../layouts/AdminLayout.astro";
import worldMap from "@svg-maps/world";

const worldCountryPaths = worldMap.locations
  .map((location: { id: string; name: string; path: string }) => `<path class="country-shape" data-country-shape="${location.id}" d="${location.path}"><title>${location.name}</title></path>`)
  .join("");
---

<AdminLayout
  title="問題報告・閲覧統計"
  description="運営用の記事問題報告と閲覧統計の管理画面"
>
  <section class="admin-reports" data-reports-admin>
    <header class="admin-reports-heading">
      <div>
        <h1>問題報告・閲覧統計</h1>
      </div>
    </header>

    <div class="admin-section-tabs" role="tablist" aria-label="問題報告・閲覧統計の表示切り替え">
      <button type="button" role="tab" aria-selected="true" aria-controls="reports-panel" data-admin-view="reports">問題報告</button>
      <button type="button" role="tab" aria-selected="false" aria-controls="analytics-panel" data-admin-view="analytics">閲覧統計</button>
    </div>

    <section class="analytics-panel" id="analytics-panel" data-admin-view-panel="analytics" data-analytics-admin aria-labelledby="analytics-heading" hidden>
      <div class="analytics-heading">
        <div>
          <p class="eyebrow">匿名集計</p>
          <h2 id="analytics-heading">記事の閲覧統計</h2>
          <p>個人情報を保存せず、閲覧・15秒以上の滞在・本文の90%到達を日別に集計します。</p>
        </div>
        <div class="analytics-controls">
          <label>期間<select data-analytics-days><option value="7">直近7日</option><option value="30" selected>直近30日</option><option value="90">直近90日</option></select></label>
          <button class="button button-outline" type="button" data-analytics-refresh>更新</button>
        </div>
      </div>
      <output class="analytics-summary" data-analytics-summary>読み込み中です…</output>
      <div class="analytics-table-wrap"><table class="analytics-table"><thead><tr><th>記事</th><th>閲覧</th><th>読まれた</th><th>90%到達</th></tr></thead><tbody data-analytics-list></tbody></table></div>
      <button class="button button-outline analytics-more" type="button" data-analytics-more hidden>残りを表示</button>

      <div class="analytics-geo-grid">
        <section class="analytics-geo-card" aria-labelledby="search-country-heading">
          <div class="analytics-geo-heading">
            <div><p class="eyebrow">学習サイト流入</p><h3 id="search-country-heading">学習サイトへの検索流入（国別）</h3></div>
            <a class="button button-outline analytics-gsc-button" href="/auth/google/search-console?days=30" data-gsc-import hidden>Search Consoleから更新</a>
          </div>
          <p class="analytics-geo-description">Google検索から学習サイトへ流入したクリック・表示回数を国別に表示します。運営サイトへのログイン情報は集計しません。</p>
          <output class="analytics-gsc-status" data-search-console-status>Search Consoleのデータを読み込み中です…</output>
          <div class="geo-layout"><div class="world-map" data-search-country-map role="img" aria-label="学習サイトへの検索流入国別地図"><svg viewBox={worldMap.viewBox} preserveAspectRatio="xMidYMid meet" aria-hidden="true"><rect class="map-ocean" x="0" y="0" width="1010" height="666"></rect><g class="map-countries" set:html={worldCountryPaths}></g><g class="map-bubbles" data-map-bubbles></g></svg></div><ol class="geo-list" data-search-country-list></ol></div>
        </section>
      </div>

      <section class="analytics-query-card" aria-labelledby="search-query-heading">
        <div class="analytics-geo-heading"><div><p class="eyebrow">検索語</p><h3 id="search-query-heading">検索された単語</h3></div><span class="analytics-privacy-note">運営メンバー向け</span></div>
        <p class="analytics-geo-description">Google検索で学習サイトに流入した検索語の上位100件です。Search Consoleの仕様により、匿名化された検索語などは表示されない場合があります。</p>
        <output class="analytics-gsc-status" data-search-query-status>Search Consoleの検索語を読み込み中です…</output>
        <div class="analytics-table-wrap"><table class="analytics-table analytics-query-table"><thead><tr><th>検索語</th><th>クリック</th><th>表示</th><th>CTR</th><th>平均掲載順位</th></tr></thead><tbody data-search-query-list></tbody></table></div>
        <p class="analytics-map-source">地図データ: <a href="https://github.com/svg-maps/svg-maps" target="_blank" rel="noreferrer">@svg-maps/world</a>（CC BY 4.0）</p>
      </section>
    </section>

    <section class="reports-panel" id="reports-panel" data-admin-view-panel="reports" aria-label="記事の問題報告">
    <div class="report-controls">
      <label>
        表示する状態
        <select data-report-filter>
          <option value="all">すべて</option>
          <option value="new">未確認</option>
          <option value="reviewing">確認中</option>
          <option value="resolved">対応済み</option>
        </select>
      </label>
      <button class="button button-outline" type="button" data-reports-refresh>一覧を更新</button>
      <output class="report-count" data-report-count></output>
    </div>
    <p class="report-feedback" data-report-feedback aria-live="polite">読み込み中です…</p>
    <div class="report-list" data-report-list></div>
    </section>
  </section>
</AdminLayout>

<style>
  .admin-reports { --surface: var(--background-primary); --surface-alt: var(--background-secondary); --border: var(--border-default); --text: var(--text-primary); --muted: var(--text-secondary); --accent: var(--accent-primary); box-sizing: border-box; margin: 0 auto; max-width: 1080px; padding: 0 1.5rem 4rem; }
  .admin-reports-heading { align-items: flex-start; border-bottom: 1px solid var(--border); display: flex; gap: 2rem; justify-content: space-between; margin-bottom: 1.25rem; padding-bottom: 1.25rem; }
  .eyebrow { color: var(--accent); font-size: .78rem; font-weight: 800; letter-spacing: .1em; margin: 0 0 .45rem; }
  h1 { font-size: clamp(1.8rem, 4vw, 2.45rem); letter-spacing: -.025em; margin: 0; }
  .admin-reports-heading div > p:last-child { color: var(--muted); margin: .65rem 0 0; }
  .admin-section-tabs { border-bottom: 1px solid var(--border); display: flex; gap: .15rem; margin: 0 0 1.25rem; }.admin-section-tabs button { background: transparent; border: 0; border-bottom: 3px solid transparent; color: var(--muted); cursor: pointer; font: inherit; font-size: .88rem; font-weight: 800; padding: .65rem .85rem; }.admin-section-tabs button[aria-selected="true"] { border-bottom-color: var(--accent); color: var(--accent); }.admin-section-tabs button:hover { background: var(--surface-alt); color: var(--text); }.reports-panel { display: grid; gap: .75rem; }
  .analytics-panel { background: var(--surface-alt); border: 1px solid var(--border); border-radius: 0; border-top: 2px solid var(--accent); margin: 0 0 1.25rem; padding: 1rem; }
  .analytics-heading { align-items: end; display: flex; gap: 1rem; justify-content: space-between; }
  .analytics-heading h2 { font-size: 1.05rem; margin: 0; }
  .analytics-heading p { color: var(--muted); font-size: .86rem; margin: .3rem 0 0; }
  .analytics-controls { align-items: end; display: flex; gap: .55rem; }
  .analytics-controls label { display: grid; font-size: .78rem; font-weight: 800; gap: .35rem; letter-spacing: .02em; }
  .analytics-summary { color: var(--muted); display: block; font-size: .8rem; margin: .85rem 0 .55rem; }
  .analytics-table-wrap { background: var(--surface); border: 1px solid var(--border); border-radius: .5rem; overflow-x: auto; }
  .analytics-table { border-collapse: collapse; font-size: .84rem; min-width: 36rem; width: 100%; }
  .analytics-table th, .analytics-table td { border-bottom: 1px solid var(--border); padding: .6rem .7rem; text-align: right; white-space: nowrap; }
  .analytics-table th { background: var(--surface-alt); color: var(--muted); font-size: .73rem; letter-spacing: .03em; }
  .analytics-table th:first-child, .analytics-table td:first-child { max-width: 32rem; overflow: hidden; text-align: left; text-overflow: ellipsis; }
  .analytics-table tr:last-child td { border-bottom: 0; }
  .analytics-table .analytics-meta { color: var(--muted); display: block; font-size: .72rem; margin-top: .15rem; }
  .analytics-table .analytics-number { display: grid; gap: .2rem; justify-items: end; min-width: 5rem; }
  .analytics-table .analytics-bar { background: var(--accent); border-radius: 999px; display: block; height: .32rem; max-width: 8rem; min-width: .2rem; opacity: .72; width: var(--bar); }
  .analytics-table tr[data-analytics-rest][hidden] { display: none; }
  .analytics-more { margin-top: .55rem; }
  .analytics-geo-grid { display: grid; gap: .9rem; grid-template-columns: 1fr; margin-top: .9rem; }
  .analytics-geo-card { background: var(--surface); border: 1px solid var(--border); border-radius: .5rem; min-width: 0; padding: .85rem; }
  .analytics-geo-heading { align-items: start; display: flex; gap: .7rem; justify-content: space-between; }
  .analytics-geo-heading h3 { font-size: .96rem; margin: 0; }
  .analytics-geo-heading .eyebrow { font-size: .62rem; margin-bottom: .25rem; }
  .analytics-privacy-note { border: 1px solid var(--border); border-radius: 999px; color: var(--muted); font-size: .65rem; padding: .22rem .45rem; white-space: nowrap; }
  .analytics-geo-description { color: var(--muted); font-size: .73rem; line-height: 1.5; margin: .45rem 0 .65rem; }
  .analytics-gsc-button { font-size: .68rem; min-height: 2rem; padding: .25rem .45rem; white-space: nowrap; }
  .analytics-gsc-status { color: var(--muted); display: block; font-size: .72rem; min-height: 1.1rem; margin-bottom: .45rem; }
  .geo-layout { align-items: start; display: grid; gap: .7rem; grid-template-columns: 1fr; }
  .world-map { background: #4b7fa8; border: 1px solid var(--border); border-radius: .45rem; overflow: hidden; position: relative; }
  .world-map svg { display: block; height: auto; width: 100%; }
  :global(.world-map .map-ocean) { fill: #4b7fa8; }
  :global(.world-map .country-shape) { fill: #f7fafc; stroke: #a9c8de; stroke-linejoin: round; stroke-width: 1.15; transition: fill .18s ease, stroke .18s ease; }
  :global(.world-map .country-shape:hover) { stroke: #ffffff; stroke-width: 1.8; }
  :global(.world-map .map-bubbles circle) { fill: #ef6c67; stroke: #ffffff; stroke-width: 1.7; }
  :global(.world-map .map-bubbles circle:hover) { fill: #f4a62a; }
  .geo-list { display: grid; gap: .28rem; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); list-style: none; margin: 0; max-height: 9.5rem; overflow: auto; padding: 0; }
  .geo-list li { align-items: baseline; border-bottom: 1px solid var(--border); display: flex; font-size: .7rem; gap: .35rem; justify-content: space-between; padding: .25rem 0; }
  .geo-list li:last-child { border-bottom: 0; }
  .geo-list .geo-country { min-width: 0; overflow: hidden; text-overflow: ellipsis; }
  .geo-list .geo-value { color: var(--accent); font-variant-numeric: tabular-nums; font-weight: 800; white-space: nowrap; }
  .analytics-query-card { background: var(--surface); border: 1px solid var(--border); border-radius: .5rem; margin-top: .9rem; padding: .85rem; }
  .analytics-query-table { min-width: 40rem; }
  .analytics-query-table th:first-child, .analytics-query-table td:first-child { max-width: 34rem; }
  .analytics-map-source { color: var(--muted); font-size: .68rem; margin: .7rem 0 0; }
  [data-admin-view-panel][hidden] { display: none !important; }
  .admin-reports[data-admin-active-view="analytics"] #reports-panel,
  .admin-reports[data-admin-active-view="reports"] #analytics-panel { display: none !important; }
  .permission-panel { background: var(--surface-alt); border: 1px solid var(--border); border-radius: 0; display: grid; gap: .8rem; margin: 0 0 1.25rem; padding: 1rem; }
  .permission-panel h2 { font-size: 1.05rem; margin: 0; }
  .permission-panel p { color: var(--muted); font-size: .86rem; margin: .3rem 0 0; }
  .permission-form { align-items: end; display: grid; gap: .65rem; grid-template-columns: minmax(14rem, 1fr) minmax(10rem, .7fr) auto; }
  .permission-form label { display: grid; font-size: .78rem; font-weight: 800; gap: .35rem; letter-spacing: .02em; }
  .permission-form input { border: 1px solid var(--border); border-radius: .45rem; background: var(--surface); color: var(--text); font: inherit; min-height: 2.35rem; padding: .3rem .55rem; }
  .permission-feedback { min-height: 1.1rem; }
  .permission-list { background: var(--surface); border: 1px solid var(--border); display: grid; gap: 0; overflow: hidden; }
  .permission-row { align-items: center; display: grid; gap: .8rem; grid-template-columns: minmax(15rem, 1fr) minmax(10rem, .65fr) auto; padding: .65rem .75rem; }
  .permission-row + .permission-row { border-top: 1px solid var(--border); }
  .permission-email { font-size: .84rem; font-weight: 750; overflow-wrap: anywhere; }
  .permission-scope { color: var(--accent); font-size: .8rem; font-weight: 800; }
  .permission-remove { align-items: center; background: transparent; border: 1px solid var(--border); border-radius: .4rem; color: var(--muted); cursor: pointer; display: inline-flex; font: inherit; font-size: .78rem; justify-content: center; min-height: 2.2rem; min-width: 4.6rem; padding: .35rem .65rem; }
  .permission-remove:hover, .permission-remove:focus-visible { background: var(--surface-alt); border-color: #a12828; color: #a12828; }
  .report-controls { align-items: end; background: var(--surface-alt); border: 1px solid var(--border); border-radius: 0; display: flex; flex-wrap: wrap; gap: .65rem; margin-bottom: .55rem; padding: .7rem .8rem; }
  .report-controls label { display: grid; font-size: .82rem; font-weight: 800; gap: .35rem; letter-spacing: .02em; }
  select, textarea { border: 1px solid var(--border); border-radius: .45rem; background: var(--surface); color: var(--text); font: inherit; }
  select { min-height: 2.35rem; min-width: 9rem; padding: .3rem .55rem; }
  .report-count { align-self: center; background: var(--surface); border: 1px solid var(--border); border-radius: 999px; color: var(--muted); font-size: .82rem; font-weight: 700; margin-left: auto; padding: .45rem .7rem; }
  .report-feedback { color: var(--muted); font-size: .83rem; min-height: 1.25rem; padding-left: .15rem; }
  .report-list { border: 1px solid var(--border); border-radius: 0; display: grid; overflow: hidden; }
  .report-list :global(.report-card) { background: var(--surface); border-bottom: 1px solid var(--border); border-left: 4px solid var(--accent); margin: 0; }
  .report-list :global(.report-card:last-child) { border-bottom: 0; }
  .report-list :global(.report-card[data-status="reviewing"]) { border-left-color: #c78500; }
  .report-list :global(.report-card[data-status="resolved"]) { border-left-color: #328455; }
  .report-list :global(.report-summary) { align-items: center; cursor: pointer; display: grid; gap: .75rem; grid-template-columns: minmax(0, 1fr) auto auto 1rem; list-style: none; padding: .7rem .9rem; }
  .report-list :global(.report-summary::-webkit-details-marker) { display: none; }
  .report-list :global(.report-summary::after) { color: var(--muted); content: "⌄"; font-size: 1rem; grid-column: 4; grid-row: 1; transform: rotate(-90deg); transition: transform .15s ease; }
  .report-list :global(.report-card[open] .report-summary::after) { transform: rotate(0); }
  .report-list :global(.report-summary:hover) { background: var(--surface-alt); }
  .report-list :global(.report-main) { min-width: 0; }
  .report-list :global(.report-article) { font-size: .96rem; font-weight: 800; margin: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .report-list :global(.report-label), .report-list :global(.report-type small), .report-list :global(.status-badge small) { color: var(--muted); display: block; font-size: .64rem; font-weight: 800; letter-spacing: .08em; margin: 0 0 .15rem; }
  .report-list :global(.report-meta) { color: var(--muted); font-size: .76rem; margin: .22rem 0 0; }
  .report-list :global(.report-subject) { background: color-mix(in srgb, var(--accent), transparent 90%); border-radius: 999px; color: var(--accent); display: inline-block; font-size: .72rem; font-weight: 800; margin-right: .35rem; padding: .12rem .42rem; }
  .report-list :global(.report-type) { color: var(--muted); font-size: .76rem; font-weight: 700; white-space: nowrap; }
  .report-list :global(.report-status) { display: grid; gap: .15rem; justify-items: start; }
  .report-list :global(.report-status small) { color: var(--muted); font-size: .64rem; font-weight: 800; letter-spacing: .08em; }
  .report-list :global(.report-article a) { color: var(--text); text-decoration-color: color-mix(in srgb, var(--accent), transparent 55%); text-underline-offset: .2em; }
  .report-list :global(.report-article a:hover) { color: var(--accent); }
  .report-list :global(.report-content) { border-top: 1px solid var(--border); padding: .8rem .9rem .9rem; }
  .report-list :global(.report-link) { font-size: .85rem; font-weight: 800; }
  .report-list :global(.report-details) { background: var(--surface-alt); border: 1px solid var(--border); border-radius: .45rem; font-size: .9rem; line-height: 1.55; margin: .65rem 0 0; padding: .65rem .75rem; white-space: pre-wrap; word-break: break-word; }
  .report-list :global(.report-card label) { display: grid; font-size: .78rem; font-weight: 800; gap: .35rem; letter-spacing: .02em; }
  .report-list :global(.report-card textarea) { box-sizing: border-box; line-height: 1.5; min-height: 4.5rem; padding: .55rem; resize: vertical; width: 100%; }
  .report-list :global(.report-actions) { align-items: end; display: grid; gap: .75rem; grid-template-columns: 9rem minmax(0, 1fr) auto; margin-top: .8rem; }
  .report-list :global(.status-badge) { background: color-mix(in srgb, var(--accent), transparent 90%); border: 1px solid currentColor; border-radius: 999px; color: var(--accent); font-size: .74rem; font-weight: 800; padding: .28rem .55rem; white-space: nowrap; }
  .report-list :global(.report-card[data-status="reviewing"] .status-badge) { background: #fff4d6; color: #9a6400; }
  .report-list :global(.report-card[data-status="resolved"] .status-badge) { background: #e4f5ea; color: #267143; }
  .report-list :global(.report-empty) { color: var(--muted); padding: 2.5rem 2rem; text-align: center; }
  @media (max-width: 700px) {
    .admin-reports { padding: 1.5rem 1rem 3rem; }
    .admin-reports-heading { display: grid; gap: 1rem; }
    .analytics-heading { align-items: stretch; display: grid; }
    .analytics-controls { align-items: end; }
    .analytics-geo-grid { grid-template-columns: 1fr; }
    .analytics-geo-heading { align-items: stretch; flex-direction: column; }
    .analytics-gsc-button { align-self: start; }
    .report-controls { align-items: stretch; display: grid; }
    .permission-form { grid-template-columns: 1fr; }
    .report-controls label, .report-controls select { width: 100%; }
    .report-count { justify-self: start; margin-left: 0; }
    .report-list :global(.report-summary), .report-list :global(.report-actions) { display: grid; grid-template-columns: 1fr; }
    .report-list :global(.report-summary::after) { display: none; }
    .report-list :global(.report-type), .report-list :global(.report-status) { justify-self: start; }
    .report-list :global(.status-badge) { justify-self: start; }
  }
</style>

<script>
  type ReportStatus = "new" | "reviewing" | "resolved";
  type Report = {
    id: string; article_title: string; article_url: string; report_type: string;
    details: string; contact: string | null; locale: string; subject: string; category: string; status: ReportStatus;
    admin_note: string; created_at: string; updated_at: string; can_manage: boolean;
  };
  type Permission = { email: string; subject: string };
  type Analytics = {
    article_id: string; article_title: string; subject: string; category: string;
    views: number; engaged_reads: number; completed_reads: number;
  };
  type SearchCountry = { country: string; clicks: number; impressions: number; ctr: number; position: number };
  type SearchQuery = { query: string; clicks: number; impressions: number; ctr: number; position: number };

  const initializeReportsAdmin = () => {
    const root = document.querySelector<HTMLElement>("[data-reports-admin]");
    if (!root || root.dataset.reportsInitialized === "true") return;
    root.dataset.reportsInitialized = "true";
    const filter = root.querySelector<HTMLSelectElement>("[data-report-filter]")!;
    const list = root.querySelector<HTMLElement>("[data-report-list]")!;
    const feedback = root.querySelector<HTMLElement>("[data-report-feedback]")!;
    const count = root.querySelector<HTMLOutputElement>("[data-report-count]")!;
    const permissionPanel = root.querySelector<HTMLElement>("[data-permission-admin]");
    const permissionForm = root.querySelector<HTMLFormElement>("[data-permission-form]");
    const permissionList = root.querySelector<HTMLElement>("[data-permission-list]");
    const permissionFeedback = root.querySelector<HTMLElement>("[data-permission-feedback]");
    const authActions = root.querySelector<HTMLElement>("[data-admin-auth-actions]");
    const analyticsDays = root.querySelector<HTMLSelectElement>("[data-analytics-days]");
    const analyticsList = root.querySelector<HTMLTableSectionElement>("[data-analytics-list]");
    const analyticsSummary = root.querySelector<HTMLOutputElement>("[data-analytics-summary]");
    const analyticsMore = root.querySelector<HTMLButtonElement>("[data-analytics-more]");
    const searchCountryMap = root.querySelector<HTMLElement>("[data-search-country-map]");
    const searchCountryList = root.querySelector<HTMLOListElement>("[data-search-country-list]");
    const searchConsoleStatus = root.querySelector<HTMLOutputElement>("[data-search-console-status]");
    const searchQueryList = root.querySelector<HTMLTableSectionElement>("[data-search-query-list]");
    const searchQueryStatus = root.querySelector<HTMLOutputElement>("[data-search-query-status]");
    const searchConsoleImport = root.querySelector<HTMLAnchorElement>("[data-gsc-import]");
    const viewButtons = root.querySelectorAll<HTMLButtonElement>("[data-admin-view]");
    const viewPanels = root.querySelectorAll<HTMLElement>("[data-admin-view-panel]");
    const labels: Record<ReportStatus, string> = { new: "未確認", reviewing: "確認中", resolved: "対応済み" };
    const types: Record<string, string> = { error: "誤り・不具合", suggestion: "改善提案", reference: "参考文献", other: "その他" };
    const escapeHtml = (value: string) => value.replace(/[&<>\"']/g, (character) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[character] ?? character);
    const date = (value: string) => new Intl.DateTimeFormat("ja-JP", { dateStyle: "medium", timeStyle: "short" }).format(new Date(value));
    const safeUrl = (value: string) => {
      try { const url = new URL(value); return ["http:", "https:"].includes(url.protocol) ? url.href : ""; } catch { return ""; }
    };
    const readApiResponse = async <T,>(response: Response): Promise<T> => {
      const contentType = response.headers.get("content-type") ?? "";
      if (contentType.includes("application/json")) return await response.json() as T;
      // Cloudflare Access のセッションが失効すると、API呼び出しはログイン用HTMLへ
      // リダイレクトされる。JSONとして読もうとせず、再認証の案内を表示する。
      if (response.redirected || contentType.includes("text/html")) {
        throw new Error("認証の有効期限が切れました。ページを再読み込みしてログインし直してください。");
      }
      throw new Error("管理サーバーから想定外の応答が返されました。時間をおいて再度お試しください。");
    };
    const subjectNames = new Map<string, string>([
      ["*", "全分野"],
      ...Array.from(permissionForm?.querySelectorAll<HTMLOptionElement>('select[name="subject"] option') ?? [])
        .map((option): [string, string] => [option.value, option.textContent?.trim() ?? option.value]),
    ]);
    const setPermissionFeedback = (message: string) => {
      if (permissionFeedback) permissionFeedback.textContent = message;
    };
    let searchConsoleCountries: Array<{ country: string; value: number }> = [];
    const selectView = (view: "reports" | "analytics") => {
      root.dataset.adminActiveView = view;
      viewButtons.forEach((button) => button.setAttribute("aria-selected", String(button.dataset.adminView === view)));
      viewPanels.forEach((panel) => { panel.hidden = panel.dataset.adminViewPanel !== view; });
      if (view === "analytics" && searchConsoleCountries.length) {
        requestAnimationFrame(() => renderWorldMap(searchCountryMap, searchConsoleCountries, "クリック"));
      }
    };
    const renderAnalytics = (articles: Analytics[], days: number) => {
      if (!analyticsList || !analyticsSummary) return;
      const totals = articles.reduce(
        (sum, article) => ({
          views: sum.views + article.views,
          engaged: sum.engaged + article.engaged_reads,
          completed: sum.completed + article.completed_reads,
        }),
        { views: 0, engaged: 0, completed: 0 },
      );
      analyticsSummary.value = `直近${days}日・${articles.length}記事 ／ 閲覧 ${totals.views.toLocaleString()} ・ 読まれた ${totals.engaged.toLocaleString()} ・ 90%到達 ${totals.completed.toLocaleString()}`;
      const sorted = [...articles].sort((a, b) => b.views - a.views);
      const maximum = Math.max(...sorted.map((article) => article.views), 1);
      analyticsList.innerHTML = sorted.length
        ? sorted.map((article, index) => `<tr${index >= 10 ? " data-analytics-rest hidden" : ""}><td>${escapeHtml(article.article_title)}<span class="analytics-meta">${escapeHtml(article.subject)} / ${escapeHtml(article.category)}</span></td><td><span class="analytics-number">${article.views.toLocaleString()}<span class="analytics-bar" style="--bar:${Math.max(2, article.views / maximum * 100)}%"></span></span></td><td>${article.engaged_reads.toLocaleString()}</td><td>${article.completed_reads.toLocaleString()}</td></tr>`).join("")
        : '<tr><td colspan="4" class="report-empty">この期間の統計はまだありません。</td></tr>';
      if (analyticsMore) { analyticsMore.hidden = sorted.length <= 10; analyticsMore.textContent = "残りを表示"; analyticsMore.setAttribute("aria-expanded", "false"); }
    };
    const countryNames: Record<string, string> = {
      AD: "アンドラ", AE: "アラブ首長国連邦", AR: "アルゼンチン", AU: "オーストラリア", AT: "オーストリア", BE: "ベルギー", BR: "ブラジル", CA: "カナダ", CH: "スイス", CL: "チリ", CN: "中国", CO: "コロンビア", CZ: "チェコ", DE: "ドイツ", DK: "デンマーク", ES: "スペイン", FI: "フィンランド", FR: "フランス", GB: "イギリス", GR: "ギリシャ", HK: "香港", HU: "ハンガリー", ID: "インドネシア", IE: "アイルランド", IL: "イスラエル", IN: "インド", IT: "イタリア", JP: "日本", KR: "韓国", LU: "ルクセンブルク", MX: "メキシコ", MY: "マレーシア", NL: "オランダ", NO: "ノルウェー", NZ: "ニュージーランド", PH: "フィリピン", PL: "ポーランド", PT: "ポルトガル", RU: "ロシア", SE: "スウェーデン", SG: "シンガポール", TH: "タイ", TR: "トルコ", TW: "台湾", UA: "ウクライナ", US: "アメリカ合衆国", VN: "ベトナム", ZA: "南アフリカ", ZZ: "判定不能",
      jpn: "日本", usa: "アメリカ合衆国", gbr: "イギリス", kor: "韓国", chn: "中国", twn: "台湾", deu: "ドイツ", fra: "フランス", can: "カナダ", aus: "オーストラリア", sgp: "シンガポール", ind: "インド", idn: "インドネシア", bra: "ブラジル", vnm: "ベトナム", tha: "タイ", mys: "マレーシア", phl: "フィリピン", nld: "オランダ", ita: "イタリア", esp: "スペイン", swe: "スウェーデン", che: "スイス", pol: "ポーランド", rus: "ロシア",
    };
    const iso3ToIso2: Record<string, string> = {
      AUS: "AU", AUT: "AT", BEL: "BE", BRA: "BR", CAN: "CA", CHE: "CH", CHL: "CL", CHN: "CN", COL: "CO", CZE: "CZ", DEU: "DE", DNK: "DK", EGY: "EG", ESP: "ES", FIN: "FI", FRA: "FR", GBR: "GB", GRC: "GR", HKG: "HK", HUN: "HU", IDN: "ID", IND: "IN", IRL: "IE", ISR: "IL", ITA: "IT", JPN: "JP", KOR: "KR", LUX: "LU", MEX: "MX", MYS: "MY", NLD: "NL", NOR: "NO", NZL: "NZ", PHL: "PH", POL: "PL", PRT: "PT", RUS: "RU", SGP: "SG", SWE: "SE", THA: "TH", TUR: "TR", TWN: "TW", UKR: "UA", USA: "US", VNM: "VN", ZAF: "ZA",
    };
    const mapCountryCode = (country: string) => {
      const normalized = country.trim().toUpperCase();
      return (normalized.length === 3 ? iso3ToIso2[normalized] : normalized).toLowerCase();
    };
    const countryLabel = (code: string) => countryNames[code] ?? code.toUpperCase();
    const renderWorldMap = (target: HTMLElement | null, countries: Array<{ country: string; value: number }>, metric: string) => {
      if (!target) return;
      const svg = target.querySelector<SVGSVGElement>("svg");
      const bubbles = target.querySelector<SVGGElement>("[data-map-bubbles]");
      if (!svg || !bubbles) return;
      const shapes = Array.from(target.querySelectorAll<SVGPathElement>("[data-country-shape]"));
      shapes.forEach((shape) => { shape.style.removeProperty("fill"); shape.removeAttribute("aria-label"); });
      bubbles.replaceChildren();
      const max = Math.max(...countries.map((item) => item.value), 1);
      countries.forEach((item) => {
        const code = mapCountryCode(item.country);
        const shape = shapes.find((candidate) => candidate.dataset.countryShape === code);
        const ratio = Math.max(0, Math.min(1, item.value / max));
        if (shape) {
          shape.style.fill = `hsl(5 78% ${92 - ratio * 43}%)`;
          shape.setAttribute("aria-label", `${countryLabel(item.country)} ${item.value.toLocaleString()} ${metric}`);
        }
        // 国ごとの固定座標は地図の投影・レスポンシブ幅とずれるため、
        // 実際のSVG形状の表示中心からマーカー位置を求める。
        if (!shape || item.value <= 0) return;
        const svgRect = svg.getBoundingClientRect();
        const shapeRect = shape.getBoundingClientRect();
        const viewBox = (svg.getAttribute("viewBox") ?? "").trim().split(/\s+/).map(Number);
        if (viewBox.length !== 4 || viewBox.some((value) => !Number.isFinite(value)) || !svgRect.width || !svgRect.height || !shapeRect.width || !shapeRect.height) return;
        const [viewBoxX, viewBoxY, viewBoxWidth, viewBoxHeight] = viewBox;
        const x = viewBoxX + ((shapeRect.left + shapeRect.width / 2 - svgRect.left) / svgRect.width) * viewBoxWidth;
        const y = viewBoxY + ((shapeRect.top + shapeRect.height / 2 - svgRect.top) / svgRect.height) * viewBoxHeight;
        const circle = document.createElementNS("http://www.w3.org/2000/svg", "circle");
        circle.setAttribute("cx", String(x)); circle.setAttribute("cy", String(y)); circle.setAttribute("r", String(3 + Math.sqrt(ratio) * 7));
        circle.setAttribute("aria-label", `${countryLabel(item.country)} ${item.value.toLocaleString()} ${metric}`);
        const title = document.createElementNS("http://www.w3.org/2000/svg", "title"); title.textContent = `${countryLabel(item.country)}: ${item.value.toLocaleString()} ${metric}`; circle.append(title);
        bubbles.append(circle);
      });
    };
    const renderCountryList = (target: HTMLOListElement | null, countries: Array<{ country: string; value: number }>, formatter: (value: number) => string) => {
      if (!target) return;
      target.innerHTML = countries.length ? countries.map((item) => `<li><span class="geo-country">${escapeHtml(countryLabel(item.country))}</span><span class="geo-value">${escapeHtml(formatter(item.value))}</span></li>`).join("") : '<li><span class="geo-country">データはまだありません</span></li>';
    };
    const loadSearchConsoleAnalytics = async () => {
      if (!searchConsoleStatus) return;
      try {
        const response = await fetch("/api/admin/search-console-country-analytics", { credentials: "same-origin", cache: "no-store" });
        const data = await readApiResponse<{ snapshot?: { start_date: string; end_date: string; fetched_at: string } | null; countries?: SearchCountry[] }>(response);
        if (!response.ok) throw new Error("Search Console統計を読み込めませんでした。");
        const countries = (data.countries ?? []).map((item) => ({ country: item.country, value: Number(item.clicks ?? 0) }));
        searchConsoleCountries = countries;
        const snapshot = data.snapshot;
        searchConsoleStatus.value = snapshot ? `${snapshot.start_date}〜${snapshot.end_date}を取得（クリック ${countries.reduce((sum, item) => sum + item.value, 0).toLocaleString()}）` : "まだSearch Consoleデータを取得していません。上のボタンから更新してください。";
        renderWorldMap(searchCountryMap, countries, "クリック"); renderCountryList(searchCountryList, countries, (value) => `${value.toLocaleString()}クリック`);
      } catch (error) { searchConsoleStatus.value = error instanceof Error ? error.message : "Search Console統計を読み込めませんでした。"; }
    };
    const loadSearchQueryAnalytics = async () => {
      if (!searchQueryStatus || !searchQueryList) return;
      try {
        const response = await fetch("/api/admin/search-console-query-analytics", { credentials: "same-origin", cache: "no-store" });
        const data = await readApiResponse<{ snapshot?: { start_date: string; end_date: string; fetched_at: string } | null; queries?: SearchQuery[]; error?: string }>(response);
        if (!response.ok) throw new Error(response.status === 403 ? "検索語統計は全分野管理者のみ閲覧できます。" : (data.error ?? "検索語統計を読み込めませんでした。"));
        const queries = data.queries ?? [];
        searchQueryStatus.value = data.snapshot ? `${data.snapshot.start_date}〜${data.snapshot.end_date}を取得（上位${queries.length.toLocaleString()}件）` : "まだSearch Consoleデータを取得していません。上のボタンから更新してください。";
        searchQueryList.innerHTML = queries.length ? queries.map((item) => `<tr><td>${escapeHtml(item.query)}</td><td>${Number(item.clicks ?? 0).toLocaleString()}</td><td>${Number(item.impressions ?? 0).toLocaleString()}</td><td>${(Number(item.ctr ?? 0) * 100).toFixed(1)}%</td><td>${Number(item.position ?? 0).toFixed(1)}</td></tr>`).join("") : '<tr><td colspan="5" class="report-empty">表示できる検索語統計はまだありません。</td></tr>';
      } catch (error) {
        searchQueryStatus.value = error instanceof Error ? error.message : "検索語統計を読み込めませんでした。";
        searchQueryList.innerHTML = "";
      }
    };
    const loadAnalytics = async () => {
      if (!analyticsDays || !analyticsSummary) return;
      analyticsSummary.value = "読み込み中です…";
      try {
        const response = await fetch(`/api/admin/article-analytics?days=${encodeURIComponent(analyticsDays.value)}`, { credentials: "same-origin" });
        const data = await readApiResponse<{ articles?: Analytics[]; days?: number; error?: string }>(response);
        if (!response.ok) throw new Error(data.error ?? "統計を読み込めませんでした。");
        renderAnalytics(data.articles ?? [], data.days ?? Number(analyticsDays.value));
      } catch (error) {
        analyticsSummary.value = error instanceof Error ? error.message : "統計を読み込めませんでした。";
        if (analyticsList) analyticsList.innerHTML = "";
      }
    };
    const loadAuthStatus = async () => {
      if (!authActions && !searchConsoleImport) return;
      try {
        const response = await fetch("/api/admin/auth-status", { credentials: "same-origin" });
        const data = await readApiResponse<{ googlePreviewEnabled?: boolean; googleAuthenticated?: boolean; isManager?: boolean }>(response);
        if (!response.ok) return;
        if (searchConsoleImport) searchConsoleImport.hidden = data.isManager !== true;
        if (!authActions || !data.googlePreviewEnabled) return;
        authActions.hidden = false;
        authActions.innerHTML = data.googleAuthenticated
          ? '<form method="post" action="/auth/google/logout?returnTo=%2Fadmin%2Freports"><button class="button button-outline" type="submit">Googleからログアウト</button></form>'
          : '<a href="/auth/google/login?returnTo=%2Fadmin%2Freports">Googleログインを試す</a>';
      } catch {
        // 認証補助UIは表示できないだけで、一覧利用には影響させない。
      }
    };
    const renderPermissions = (permissions: Permission[]) => {
      if (!permissionList) return;
      permissionList.innerHTML = permissions.length
        ? permissions.map((permission) => `<div class="permission-row"><span class="permission-email">${escapeHtml(permission.email)}</span><span class="permission-scope">${escapeHtml(subjectNames.get(permission.subject) ?? permission.subject)}${permission.subject === "*" ? "（全分野管理者）" : "（担当）"}</span><button type="button" class="permission-remove" aria-label="${escapeHtml(permission.email)} の ${escapeHtml(subjectNames.get(permission.subject) ?? permission.subject)} 担当を削除" data-permission-remove data-email="${escapeHtml(permission.email)}" data-subject="${escapeHtml(permission.subject)}">削除</button></div>`).join("")
        : '<span class="report-meta">担当分野はまだ設定されていません。</span>';
    };
    const loadPermissions = async () => {
      if (!permissionPanel) return;
      try {
        const response = await fetch("/api/admin/report-admin-permissions", { credentials: "same-origin" });
        const data = await readApiResponse<{ permissions?: Permission[]; error?: string }>(response);
        if (response.status === 403) { permissionPanel.hidden = true; return; }
        if (!response.ok) throw new Error(data.error ?? "担当分野を読み込めませんでした。");
        permissionPanel.hidden = false;
        renderPermissions(data.permissions ?? []);
      } catch (error) {
        permissionPanel.hidden = false;
        setPermissionFeedback(error instanceof Error ? error.message : "担当分野を読み込めませんでした。");
      }
    };

    const render = (reports: Report[]) => {
      count.value = `${reports.length} 件`;
      if (!reports.length) { list.innerHTML = '<p class="report-empty">該当する報告はありません。</p>'; return; }
      list.innerHTML = reports.map((report) => {
        const url = safeUrl(report.article_url);
        return `<details class="report-card" data-status="${report.status}" data-report-id="${report.id}">
          <summary class="report-summary">
            <div class="report-main"><p class="report-label">記事</p><p class="report-article">${escapeHtml(report.article_title)}</p><p class="report-meta"><span class="report-subject">${escapeHtml(report.subject || "未分類")}</span>${report.category ? `${escapeHtml(report.category)} ・ ` : ""}${date(report.created_at)} ・ ${escapeHtml(report.locale)}</p></div>
            <span class="report-type"><small>種別</small>${escapeHtml(types[report.report_type] ?? report.report_type)}</span><span class="report-status"><small>状態</small><b class="status-badge">${labels[report.status]}</b></span>
          </summary>
          <div class="report-content">
          ${url ? `<a class="report-link" href="${escapeHtml(url)}" target="_blank" rel="noreferrer">記事を開く</a>` : ""}
          <p class="report-details">${escapeHtml(report.details)}</p>
          ${report.can_manage ? `<div class="report-actions"><label>対応状況<select data-report-status>${Object.entries(labels).map(([value, label]) => `<option value="${value}" ${report.status === value ? "selected" : ""}>${label}</option>`).join("")}</select></label><label>運営メモ<textarea data-report-note maxlength="4000" placeholder="対応内容や確認事項を記録できます。">${escapeHtml(report.admin_note)}</textarea></label><button class="button" type="button" data-report-save>保存</button></div>` : '<p class="report-meta">この分野の報告は閲覧のみ可能です。</p>'}
          ${report.contact ? `<p class="report-meta">連絡先: ${escapeHtml(report.contact)}</p>` : ""}
          </div>
        </details>`;
      }).join("");
    };

    const load = async () => {
      feedback.textContent = "読み込み中です…";
      try {
        const response = await fetch(`/api/admin/article-reports?status=${encodeURIComponent(filter.value)}`, { credentials: "same-origin" });
        const data = await readApiResponse<{ reports?: Report[]; error?: string }>(response);
        if (!response.ok) throw new Error(data.error ?? "読み込めませんでした。");
        render(data.reports ?? []); feedback.textContent = "";
      } catch (error) { list.innerHTML = ""; count.value = ""; feedback.textContent = error instanceof Error ? error.message : "読み込めませんでした。"; }
    };
    filter.addEventListener("change", load);
    viewButtons.forEach((button) => button.addEventListener("click", () => selectView(button.dataset.adminView === "analytics" ? "analytics" : "reports")));
    root.querySelector<HTMLButtonElement>("[data-reports-refresh]")!.addEventListener("click", load);
    analyticsDays?.addEventListener("change", () => loadAllAnalytics());
    analyticsMore?.addEventListener("click", () => { const opening = analyticsMore.getAttribute("aria-expanded") !== "true"; analyticsList?.querySelectorAll<HTMLTableRowElement>("[data-analytics-rest]").forEach((row) => { row.hidden = !opening; }); analyticsMore.setAttribute("aria-expanded", String(opening)); analyticsMore.textContent = opening ? "上位10件だけ表示" : "残りを表示"; });
    root.querySelector<HTMLButtonElement>("[data-analytics-refresh]")?.addEventListener("click", () => loadAllAnalytics());
    permissionForm?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!permissionForm.reportValidity()) return;
      const submit = permissionForm.querySelector<HTMLButtonElement>('button[type="submit"]');
      const values = new FormData(permissionForm);
      submit?.setAttribute("disabled", "");
      setPermissionFeedback("追加しています…");
      try {
        const response = await fetch("/api/admin/report-admin-permissions", { method: "POST", credentials: "same-origin", headers: { "content-type": "application/json" }, body: JSON.stringify({ email: values.get("email"), subject: values.get("subject") }) });
        const data = await readApiResponse<{ error?: string }>(response);
        if (!response.ok) throw new Error(data.error ?? "担当を追加できませんでした。");
        permissionForm.reset(); setPermissionFeedback("担当を追加しました。"); await loadPermissions();
      } catch (error) { setPermissionFeedback(error instanceof Error ? error.message : "担当を追加できませんでした。"); }
      finally { submit?.removeAttribute("disabled"); }
    });
    permissionList?.addEventListener("click", async (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-permission-remove]");
      if (!button) return;
      const email = button.dataset.email;
      const subject = button.dataset.subject;
      if (!email || !subject) return;
      button.disabled = true;
      try {
        const query = new URLSearchParams({ email, subject });
        const response = await fetch(`/api/admin/report-admin-permissions?${query}`, { method: "DELETE", credentials: "same-origin" });
        const data = await readApiResponse<{ error?: string }>(response);
        if (!response.ok) throw new Error(data.error ?? "担当を削除できませんでした。");
        setPermissionFeedback("担当を削除しました。"); await loadPermissions();
      } catch (error) { setPermissionFeedback(error instanceof Error ? error.message : "担当を削除できませんでした。"); }
      finally { button.disabled = false; }
    });
    list.addEventListener("click", async (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-report-save]");
      if (!button) return;
      const card = button.closest<HTMLElement>("[data-report-id]");
      if (!card) return;
      const status = card.querySelector<HTMLSelectElement>("[data-report-status]")!;
      const note = card.querySelector<HTMLTextAreaElement>("[data-report-note]")!;
      button.disabled = true; button.textContent = "保存中…";
      try {
        const response = await fetch(`/api/admin/article-reports/${card.dataset.reportId}`, { method: "PATCH", credentials: "same-origin", headers: { "content-type": "application/json" }, body: JSON.stringify({ status: status.value, adminNote: note.value }) });
        const data = await readApiResponse<{ error?: string }>(response);
        if (!response.ok) throw new Error(data.error ?? "保存できませんでした。");
        feedback.textContent = "保存しました。"; await load();
      } catch (error) { feedback.textContent = error instanceof Error ? error.message : "保存できませんでした。"; }
      finally { button.disabled = false; button.textContent = "保存"; }
    });
    const loadAllAnalytics = () => { void loadAnalytics(); void loadSearchConsoleAnalytics(); void loadSearchQueryAnalytics(); };
    const syncSearchConsoleLink = () => { if (searchConsoleImport) searchConsoleImport.href = `/auth/google/search-console?days=${encodeURIComponent(analyticsDays?.value ?? "30")}`; };
    analyticsDays?.addEventListener("change", syncSearchConsoleLink);
    syncSearchConsoleLink();
    const gscResult = new URLSearchParams(window.location.search).get("gsc");
    if (searchConsoleStatus && gscResult === "imported") searchConsoleStatus.value = "Search Consoleのデータを更新しました。";
    if (searchConsoleStatus && gscResult === "error") searchConsoleStatus.value = "Search Consoleの取得に失敗しました。権限・プロパティ・期間を確認してください。";
    selectView("reports");
    void load();
    loadAllAnalytics();
    void loadPermissions();
    void loadAuthStatus();
  };

  document.addEventListener("astro:page-load", initializeReportsAdmin);
  initializeReportsAdmin();
</script>
