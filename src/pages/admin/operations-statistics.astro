---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { getCollection } from "astro:content";
const subjects = await getCollection("subjects");
const publishedSubjectCount = subjects.filter((subject) => subject.data.status === "published").length;
---

<AdminLayout title="運営内統計" description="アトラス運営の活動状況と進捗">
  <main class="operations-statistics" data-operations-statistics>
    <header class="page-heading"><div><p class="eyebrow">ATLAS / OPERATIONS</p><h1>運営内統計</h1><p class="lead">メンバー、担当分野、タスク、進捗報告を運営内の活動指標としてまとめています。</p></div><a href="/admin/manage/?project=atlas">← 管理トップ</a></header>
    <section class="metrics" aria-label="運営内サマリー"><div><span>運営メンバー</span><strong data-metric="members">—</strong><small>登録人数</small></div><div><span>担当分野</span><strong data-metric="assigned">—</strong><small>担当者がいる分野</small></div><div><span>未完了タスク</span><strong data-metric="tasks">—</strong><small>現在のタスク</small></div><div><span>進捗報告</span><strong data-metric="reports">—</strong><small>取得できた報告</small></div></section>
    <section class="stats-panel" aria-labelledby="subject-stats-heading"><div class="panel-heading"><div><p class="eyebrow">SUBJECT HEALTH</p><h2 id="subject-stats-heading">分野別の状況</h2></div><span data-updated>読み込み中…</span></div><div class="subject-table" data-subject-table><p class="loading">統計を読み込んでいます…</p></div></section>
    <section class="stats-panel demographics" aria-labelledby="demographics-heading"><div class="panel-heading"><div><p class="eyebrow">MEMBER PROFILE</p><h2 id="demographics-heading">メンバー構成</h2></div><span>登録プロフィールを集計</span></div><div class="breakdown-grid"><article><h3>学年別</h3><ul class="breakdown-list" data-breakdown="year"><li class="loading">集計中…</li></ul></article><article><h3>学校別</h3><ul class="breakdown-list" data-breakdown="university"><li class="loading">集計中…</li></ul></article><article><h3>国・地域別</h3><ul class="breakdown-list" data-breakdown="country"><li class="loading">集計中…</li></ul></article></div></section>
    <section class="stats-panel" aria-labelledby="activity-stats-heading"><div class="panel-heading"><div><p class="eyebrow">ACTIVITY</p><h2 id="activity-stats-heading">活動サマリー</h2></div></div><dl class="activity-list"><div><dt>登録イベント</dt><dd data-metric="events">—</dd></div><div><dt>公開フロー担当</dt><dd data-metric="leads">—</dd></div><div><dt>公開中の分野</dt><dd data-metric="published">{publishedSubjectCount}</dd></div><div><dt>直近の更新</dt><dd data-metric="last-update">—</dd></div></dl></section>
    <output class="message" data-message aria-live="polite"></output>
  </main>
</AdminLayout>

<style>
  .operations-statistics{margin:0 auto;max-width:1100px;padding:0 1.25rem 4rem}.page-heading{align-items:end;border-bottom:1px solid var(--border-default);display:flex;gap:1rem;justify-content:space-between;padding:2rem 0 1.3rem}.eyebrow{color:var(--accent-primary);font-size:.7rem;font-weight:800;letter-spacing:.1em;margin:0}.page-heading h1{font-size:clamp(1.8rem,4vw,2.5rem);margin:.25rem 0 .45rem}.lead{color:var(--text-secondary);line-height:1.7;margin:0}.page-heading>a{color:var(--accent-primary);font-size:.8rem;font-weight:800;text-decoration:none;white-space:nowrap}.metrics{display:grid;gap:.7rem;grid-template-columns:repeat(4,minmax(0,1fr));margin:1.2rem 0}.metrics>div{background:var(--background-secondary);border:1px solid var(--border-default);display:grid;gap:.25rem;padding:.85rem}.metrics span,.metrics small{color:var(--text-secondary);font-size:.72rem}.metrics strong{font-size:1.7rem;line-height:1.1}.stats-panel{border:1px solid var(--border-default);margin-top:1rem;padding:1rem}.panel-heading{align-items:end;border-bottom:1px solid var(--border-default);display:flex;justify-content:space-between;margin-bottom:.75rem;padding-bottom:.65rem}.panel-heading h2{font-size:1.15rem;margin:.18rem 0 0}.panel-heading>span{color:var(--text-secondary);font-size:.72rem}.subject-table{overflow:auto}.subject-table table{border-collapse:collapse;min-width:620px;width:100%}.subject-table th,.subject-table td{border-bottom:1px solid var(--border-default);padding:.6rem .55rem;text-align:left}.subject-table th{color:var(--text-secondary);font-size:.68rem}.subject-table td{font-size:.78rem}.subject-table tr:last-child td{border-bottom:0}.status-bar{background:var(--background-secondary);height:.4rem;min-width:6rem;overflow:hidden}.status-bar span{background:var(--accent-primary);display:block;height:100%}.status-ok{color:#72c98b}.status-warn{color:#e8b84a}.status-none{color:var(--text-muted)}.activity-list{display:grid;gap:.45rem;grid-template-columns:repeat(4,minmax(0,1fr));margin:0}.activity-list div{background:var(--background-secondary);border:1px solid var(--border-default);padding:.65rem}.activity-list dt{color:var(--text-secondary);font-size:.7rem}.activity-list dd{font-size:1.15rem;font-weight:800;margin:.25rem 0 0}.loading,.message{color:var(--text-secondary);font-size:.8rem}.message{display:block;min-height:1.2rem;padding-top:.65rem}@media(max-width:760px){.operations-statistics{padding:0 .8rem 3rem}.page-heading{align-items:start;display:grid}.metrics{grid-template-columns:repeat(2,minmax(0,1fr))}.activity-list{grid-template-columns:repeat(2,minmax(0,1fr))}}
  .operations-statistics{margin:0 auto;max-width:1100px;padding:0 1.25rem 4rem}.page-heading{align-items:end;border-bottom:1px solid var(--border-default);display:flex;gap:1rem;justify-content:space-between;padding:2rem 0 1.3rem}.eyebrow{color:var(--accent-primary);font-size:.7rem;font-weight:800;letter-spacing:.1em;margin:0}.page-heading h1{font-size:clamp(1.8rem,4vw,2.5rem);margin:.25rem 0 .45rem}.lead{color:var(--text-secondary);line-height:1.7;margin:0}.page-heading>a{color:var(--accent-primary);font-size:.8rem;font-weight:800;text-decoration:none;white-space:nowrap}.metrics{display:grid;gap:.7rem;grid-template-columns:repeat(4,minmax(0,1fr));margin:1.2rem 0}.metrics>div{background:var(--background-secondary);border:1px solid var(--border-default);display:grid;gap:.25rem;padding:.85rem}.metrics span,.metrics small{color:var(--text-secondary);font-size:.72rem}.metrics strong{font-size:1.7rem;line-height:1.1}.stats-panel{border:1px solid var(--border-default);margin-top:1rem;padding:1rem}.panel-heading{align-items:end;border-bottom:1px solid var(--border-default);display:flex;justify-content:space-between;margin-bottom:.75rem;padding-bottom:.65rem}.panel-heading h2{font-size:1.15rem;margin:.18rem 0 0}.panel-heading>span{color:var(--text-secondary);font-size:.72rem}.subject-table{overflow:auto}.subject-table table{border-collapse:collapse;min-width:620px;width:100%}.subject-table th,.subject-table td{border-bottom:1px solid var(--border-default);padding:.6rem .55rem;text-align:left}.subject-table th{color:var(--text-secondary);font-size:.68rem}.subject-table td{font-size:.78rem}.subject-table tr:last-child td{border-bottom:0}.status-bar{background:var(--background-secondary);height:.4rem;min-width:6rem;overflow:hidden}.status-bar span{background:var(--accent-primary);display:block;height:100%}.status-ok{color:#72c98b}.status-warn{color:#e8b84a}.status-none{color:var(--text-muted)}.demographics .panel-heading{margin-bottom:1rem}.breakdown-grid{display:grid;gap:.75rem;grid-template-columns:repeat(3,minmax(0,1fr))}.breakdown-grid article{background:var(--background-secondary);border:1px solid var(--border-default);min-width:0;padding:.75rem}.breakdown-grid h3{font-size:.8rem;margin:0 0 .55rem}.breakdown-list{list-style:none;margin:0;padding:0}.breakdown-list li{align-items:center;border-top:1px solid var(--border-default);display:flex;font-size:.75rem;gap:.5rem;justify-content:space-between;padding:.45rem 0}.breakdown-list li:first-child{border-top:0}.breakdown-list li span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.breakdown-list strong{color:var(--text-primary);font-size:.75rem;white-space:nowrap}.activity-list{display:grid;gap:.45rem;grid-template-columns:repeat(4,minmax(0,1fr));margin:0}.activity-list div{background:var(--background-secondary);border:1px solid var(--border-default);padding:.65rem}.activity-list dt{color:var(--text-secondary);font-size:.7rem}.activity-list dd{font-size:1.15rem;font-weight:800;margin:.25rem 0 0}.loading,.message{color:var(--text-secondary);font-size:.8rem}.message{display:block;min-height:1.2rem;padding-top:.65rem}@media(max-width:760px){.operations-statistics{padding:0 .8rem 3rem}.page-heading{align-items:start;display:grid}.metrics{grid-template-columns:repeat(2,minmax(0,1fr))}.breakdown-grid{grid-template-columns:1fr}.activity-list{grid-template-columns:repeat(2,minmax(0,1fr))}}
</style>

<script>
  type Member = { subjectAssignments?: string[]; workflowSubjects?: string[]; role?: string; university?: string; year?: string; country?: string };
  type GenreData = { members?: Member[]; overviews?: Array<{ subject?: string; progress?: string; updated_at?: string }>; error?: string };
  type OperationsData = { tasks?: Array<{ status?: string; updated_at?: string }>; events?: Array<{ created_at?: string }>; error?: string };
  type ProgressData = { progress?: Array<{ created_at?: string }>; error?: string };
  const initialize = () => { const root = document.querySelector<HTMLElement>("[data-operations-statistics]"); if (!root || root.dataset.ready) return; root.dataset.ready = "true"; const esc = (value: unknown) => String(value ?? "").replace(/[&<>"']/g, (character) => ({ "&":"&amp;", "<":"&lt;", ">":"&gt;", '"':"&quot;", "'":"&#39;" })[character] ?? character); const setMetric = (name: string, value: string | number) => { const element = root.querySelector<HTMLElement>(`[data-metric="${name}"]`); if (element) element.textContent = String(value); }; const renderBreakdown = (members: Member[], key: "year" | "university" | "country") => { const list = root.querySelector<HTMLElement>(`[data-breakdown="${key}"]`); if (!list) return; const counts = new Map<string, number>(); members.forEach((member) => { const value = String(member[key] ?? "").trim() || "未登録"; counts.set(value, (counts.get(value) ?? 0) + 1); }); const rows = [...counts.entries()].sort((left, right) => right[1] - left[1] || left[0].localeCompare(right[0], "ja")); list.innerHTML = rows.length ? rows.map(([label, count]) => `<li><span title="${esc(label)}">${esc(label)}</span><strong>${count}人</strong></li>`).join("") : '<li class="loading">データがありません。</li>'; }; void Promise.all([fetch("/api/admin/genre-overviews?project=atlas", { credentials: "same-origin", cache: "no-store" }).then(async (response) => { const data = await response.json() as GenreData; if (!response.ok) throw new Error(data.error ?? "分野統計を読み込めませんでした。"); return data; }), fetch("/api/admin/operations?project=atlas", { credentials: "same-origin", cache: "no-store" }).then(async (response) => { const data = await response.json() as OperationsData; if (!response.ok) throw new Error(data.error ?? "タスク統計を読み込めませんでした。"); return data; }), fetch("/api/admin/progress", { credentials: "same-origin", cache: "no-store" }).then(async (response) => { const data = await response.json() as ProgressData; if (!response.ok) throw new Error(data.error ?? "進捗統計を読み込めませんでした。"); return data; })]).then(([genre, operations, progress]) => { const members = genre.members ?? []; const assigned = new Set(members.flatMap((member) => [...(member.subjectAssignments ?? []), ...(member.workflowSubjects ?? [])])); const overview = genre.overviews ?? []; const tasks = operations.tasks ?? []; const events = operations.events ?? []; const reports = progress.progress ?? []; setMetric("members", members.length); setMetric("assigned", assigned.size); setMetric("tasks", tasks.filter((task) => task.status !== "done").length); setMetric("reports", reports.length); setMetric("events", events.length); setMetric("leads", new Set(members.flatMap((member) => member.workflowSubjects ?? [])).size); renderBreakdown(members, "year"); renderBreakdown(members, "university"); renderBreakdown(members, "country"); const updates = [...overview.map((item) => item.updated_at ?? ""), ...tasks.map((item) => item.updated_at ?? "")].filter(Boolean).sort().reverse(); setMetric("last-update", updates[0] ? new Date(updates[0]).toLocaleDateString("ja-JP") : "—"); const table = root.querySelector<HTMLElement>("[data-subject-table]")!; table.innerHTML = `<table><thead><tr><th>分野</th><th>担当</th><th>進捗メモ</th><th>更新</th></tr></thead><tbody>${overview.length ? overview.map((item) => `<tr><td>${esc(item.subject)}</td><td class="${item.progress ? "status-ok" : "status-none"}">${item.progress ? "登録済み" : "未登録"}</td><td><div class="status-bar"><span style="width:${item.progress ? "100" : "8"}%"></span></div></td><td class="muted">${item.updated_at ? esc(new Date(item.updated_at).toLocaleDateString("ja-JP")) : "—"}</td></tr>`).join("") : '<tr><td colspan="4" class="loading">分野データがありません。</td></tr>'}</tbody></table>`; const updated = root.querySelector<HTMLElement>("[data-updated]"); if (updated) updated.textContent = `${overview.length}分野を集計`; }).catch((error) => { const message = root.querySelector<HTMLOutputElement>("[data-message]"); if (message) message.value = error instanceof Error ? error.message : "統計を読み込めませんでした。"; }); };
  document.addEventListener("astro:page-load", initialize); initialize();
</script>
