---
import AdminLayout from "../../layouts/AdminLayout.astro";
import AdminRetryNotice from "../../components/admin/AdminRetryNotice.astro";
import { getCollection } from "astro:content";
const subjects = await getCollection("subjects");
const publishedSubjectCount = subjects.filter((subject) => subject.data.status === "published").length;
---

<AdminLayout title="運営メンバー統計" description="運営メンバー統計">
  <main class="operations-statistics" data-operations-statistics data-admin-load-surface data-admin-load-state="loading" aria-busy="true">
    <header class="page-heading"><div><h1>運営メンバー統計</h1></div><a href="/admin/manage/?project=atlas">← 管理トップ</a></header>
    <section class="metrics" aria-label="運営メンバー統計の概要"><div><span>運営メンバー</span><strong data-metric="members">—</strong><small>登録人数</small></div><div><span>担当分野</span><strong data-metric="assigned">—</strong><small>担当者がいる分野</small></div><div><span>未完了タスク</span><strong data-metric="tasks">—</strong><small>現在のタスク</small></div><div><span>進捗報告</span><strong data-metric="reports">—</strong><small>全件集計</small></div></section>
    <section class="metrics" aria-label="対応待ち"><div><span>期限超過</span><strong data-metric="overdue">—</strong><small>未完了タスク</small></div><div><span>公開審査待ち</span><strong data-metric="approval">—</strong><small>現在の審査段階</small></div><div><span>最長待ち時間</span><strong data-metric="waiting-days">—</strong><small data-waiting-unknown>開始日時未記録: —件</small></div></section>
    <section class="stats-panel"><h2>担当者別の負荷</h2><p>複数担当のタスクは各担当者に1件ずつ集計します。未担当と分野担当者全員は別枠です。未完了件数の多い順に最大100枠を表示します。</p><div class="subject-table" data-workload></div></section>
    <section class="stats-panel"><h2>公開審査の待ち状況</h2><p>開始日時が分かるものを古い順に最大10件表示します。</p><ul class="breakdown-list" data-waiting></ul></section>
    <section class="stats-panel" aria-labelledby="subject-stats-heading"><div class="panel-heading"><div><h2 id="subject-stats-heading">分野別の状況</h2></div><span data-updated>読み込み中…</span></div><div class="subject-table" data-subject-table><div data-admin-load-skeleton aria-hidden="true"></div><p class="loading-state">統計を読み込んでいます…</p></div></section>
    <section class="stats-panel demographics" aria-labelledby="demographics-heading"><div class="panel-heading"><div><h2 id="demographics-heading">メンバー構成</h2></div><span>登録プロフィールを集計</span></div><div class="breakdown-grid"><article><h3>学年別</h3><ul class="breakdown-list" data-breakdown="year"><li class="loading-state">集計中…</li></ul></article><article><h3>学校別</h3><ul class="breakdown-list" data-breakdown="university"><li class="loading-state">集計中…</li></ul></article><article><h3>国・地域別</h3><ul class="breakdown-list" data-breakdown="country"><li class="loading-state">集計中…</li></ul></article></div></section>
    <section class="stats-panel" aria-labelledby="activity-stats-heading"><div class="panel-heading"><div><h2 id="activity-stats-heading">活動サマリー</h2></div></div><dl class="activity-list"><div><dt>登録イベント</dt><dd data-metric="events">—</dd></div><div><dt>公開フロー担当</dt><dd data-metric="leads">—</dd></div><div><dt>公開中の分野</dt><dd data-metric="published">{publishedSubjectCount}</dd></div><div><dt>直近の更新</dt><dd data-metric="last-update">—</dd></div></dl></section>
    <p data-admin-empty-state hidden></p>
    <AdminRetryNotice />
    <output class="message" data-message aria-live="polite"></output>
  </main>
</AdminLayout>

<style>
  .operations-statistics { margin: 0 auto; max-width: 1100px; padding: 0 1.25rem 4rem; }
  .page-heading { align-items: end; border-bottom: 1px solid var(--border-default); display: flex; gap: 1rem; justify-content: space-between; padding: 2rem 0 1.3rem; }
  .page-heading h1 { font-size: clamp(1.8rem, 4vw, 2.5rem); margin: .25rem 0 .45rem; }
  .page-heading > a { color: var(--accent-primary); font-size: .8rem; font-weight: 800; text-decoration: none; white-space: nowrap; }
  .metrics { display: grid; gap: .7rem; grid-template-columns: repeat(4, minmax(0, 1fr)); margin: 1.2rem 0; }
  .metrics > div { background: var(--background-secondary); border: 1px solid var(--border-default); display: grid; gap: .25rem; padding: .85rem; }
  .metrics span, .metrics small { color: var(--text-secondary); font-size: .72rem; }
  .metrics strong { font-size: 1.7rem; line-height: 1.1; }
  .stats-panel { border: 1px solid var(--border-default); margin-top: 1rem; padding: 1rem; }
  .panel-heading { align-items: end; border-bottom: 1px solid var(--border-default); display: flex; justify-content: space-between; margin-bottom: .75rem; padding-bottom: .65rem; }
  .panel-heading h2 { font-size: 1.15rem; margin: .18rem 0 0; }
  .panel-heading > span { color: var(--text-secondary); font-size: .72rem; }
  .subject-table { min-height: 5rem; overflow: auto; }
  .subject-table table { border-collapse: collapse; min-width: 620px; width: 100%; }
  .subject-table th, .subject-table td { border-bottom: 1px solid var(--border-default); padding: .6rem .55rem; text-align: left; }
  .subject-table th { color: var(--text-secondary); font-size: .68rem; }
  .subject-table td { font-size: .78rem; }
  .subject-table tr:last-child td { border-bottom: 0; }
  .status-bar { background: var(--background-secondary); height: .4rem; min-width: 6rem; overflow: hidden; }
  .status-bar span { background: var(--accent-primary); display: block; height: 100%; }
  .status-ok { color: #72c98b; }
  .status-none { color: var(--text-muted); }
  .demographics .panel-heading { margin-bottom: 1rem; }
  .breakdown-grid { display: grid; gap: .75rem; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .breakdown-grid article { background: var(--background-secondary); border: 1px solid var(--border-default); min-width: 0; padding: .75rem; }
  .breakdown-grid h3 { font-size: .8rem; margin: 0 0 .55rem; }
  .breakdown-list { list-style: none; margin: 0; padding: 0; }
  .breakdown-list li { align-items: center; border-top: 1px solid var(--border-default); display: flex; font-size: .75rem; gap: .5rem; justify-content: space-between; padding: .45rem 0; }
  .breakdown-list li:first-child { border-top: 0; }
  .breakdown-list li span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .breakdown-list strong { color: var(--text-primary); font-size: .75rem; white-space: nowrap; }
  .activity-list { display: grid; gap: .45rem; grid-template-columns: repeat(4, minmax(0, 1fr)); margin: 0; }
  .activity-list div { background: var(--background-secondary); border: 1px solid var(--border-default); padding: .65rem; }
  .activity-list dt { color: var(--text-secondary); font-size: .7rem; }
  .activity-list dd { font-size: 1.15rem; font-weight: 800; margin: .25rem 0 0; }
  .loading-state, .message { color: var(--text-secondary); font-size: .8rem; }
  .message { display: block; min-height: 1.2rem; padding-top: .65rem; }
  @media (max-width: 760px) {
    .operations-statistics { padding: 0 .8rem 3rem; }
    .page-heading { align-items: start; display: grid; }
    .metrics { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .breakdown-grid { grid-template-columns: 1fr; }
    .activity-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>

<script>
  import "../../scripts/admin-operations-statistics";
</script>
