---
import AdminLayout from "../../layouts/AdminLayout.astro";
---

<AdminLayout title="オンボーディング紹介" description="運営内運営向けの応募・受入の初回手順">
  <main class="demo" data-onboarding-demo>
    <header class="preview-header">
      <h1>応募から活動開始までの紹介デモ</h1>
      <p class="notice">承認後に参加者が通る手順です。4段階のチュートリアルは参加条件ではなく、この画面でも案内しません。操作は保存されません。</p>
    </header>

    <section class="project-selector" aria-labelledby="project-heading">
      <h2 id="project-heading">紹介するプロジェクト</h2>
      <div class="project-tabs" role="tablist" aria-label="紹介するプロジェクト">
        <button type="button" role="tab" aria-selected="true" data-project="atlas">学習サイト「アトラス」</button>
        <button type="button" role="tab" aria-selected="false" data-project="secretariat">Atlasez運営事務局</button>
        <button type="button" role="tab" aria-selected="false" data-project="seminar-platform">ゼミプラットフォーム</button>
      </div>
    </section>

    <section class="site-map" aria-labelledby="site-map-heading">
      <div><p class="progress">運営サイトの地図</p><h2 id="site-map-heading">どの画面で何をするか</h2><p>日常的な作業の画面と、管理権限が必要な画面を分けて確認できます。</p></div>
      <div class="site-map-grid" data-site-map></div>
    </section>

    <section class="first-run" aria-labelledby="first-run-heading">
      <h2 id="first-run-heading">参加者が最初に行うこと</h2>
      <ol>
        <li>応募に使ったのと同じGoogleアカウントでログインする。</li>
        <li>表示名と、公開用の自己紹介を保存する。</li>
        <li>プロジェクト内の自己紹介を保存する。</li>
        <li>ポータルと参加後の案内を開く。</li>
        <li>自己紹介の保存が終わってからDiscordを連携する。</li>
      </ol>
      <p>自己紹介の途中では、応募状況の画面から自己紹介へ戻されます。Discordはその後です。</p>
    </section>
  </main>
</AdminLayout>

<style>
  .demo{margin:0 auto;max-width:760px;padding:0 1.25rem 5rem}.preview-header{border-bottom:1px solid var(--border-default);padding:2.2rem 0 1.4rem}.preview-header h1{font-size:clamp(1.8rem,4vw,2.6rem);margin:0 0 .7rem}.preview-header>p{color:var(--text-secondary);line-height:1.75;margin:.5rem 0 0}.notice{background:var(--background-secondary);border-left:3px solid var(--accent-primary);padding:.8rem 1rem}.project-selector{margin:1.75rem 0}.project-selector h2{font-size:1rem;margin:0}.project-tabs{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:.75rem}.project-tabs button{background:var(--background-primary);border:1px solid var(--border-default);color:var(--text-primary);cursor:pointer;font:inherit;font-size:.84rem;font-weight:800;padding:.6rem .75rem}.project-tabs button[aria-selected="true"]{background:var(--accent-primary);border-color:var(--accent-primary);color:var(--on-accent)}
  .site-map{border:1px solid var(--border-default);display:grid;gap:1rem;margin:1.75rem 0;padding:1.25rem}.site-map h2{font-size:1.15rem;margin:.3rem 0}.site-map>div>p:last-child{color:var(--text-secondary);line-height:1.6;margin:0}.site-map-grid{display:grid;gap:.6rem;grid-template-columns:repeat(2,minmax(0,1fr))}.site-map-card{border:1px solid var(--border-default);display:grid;gap:.35rem;padding:.8rem}.site-map-card strong{font-size:.9rem}.site-map-card p{color:var(--text-secondary);font-size:.78rem;line-height:1.55;margin:0}.site-map-card span{color:var(--accent-primary);font-size:.7rem;font-weight:800}.site-map-card[data-access="manager"]{opacity:.72}.first-run{border:1px solid var(--border-default);display:grid;gap:.7rem;margin-top:1.75rem;padding:1.25rem}.first-run h2{font-size:1.15rem;margin:0}.first-run ol{display:grid;gap:.55rem;margin:0;padding-left:1.3rem}.first-run li,.first-run p{color:var(--text-secondary);line-height:1.7}.first-run p{margin:0}button{background:var(--accent-primary);border:1px solid var(--accent-primary);color:var(--on-accent);cursor:pointer;font:inherit;font-weight:800;min-height:2.8rem;padding:.65rem 1rem}@media(max-width:560px){.demo{padding:0 1rem 4rem}.project-tabs,.site-map-grid{display:grid}.project-tabs button{text-align:left}}
</style>

<script>
  import { projectOperationalAreas } from "../../lib/project-tutorials";
  const initializeOnboardingDemo = () => {
    const root = document.querySelector<HTMLElement>("[data-onboarding-demo]");
    if (!root || root.dataset.initialized === "true") return;
    root.dataset.initialized = "true";
    const siteMap = root.querySelector<HTMLElement>("[data-site-map]");
    const buttons = root.querySelectorAll<HTMLButtonElement>("[data-project]");
    if (!siteMap) return;
    let project = "atlas";
    const render = () => {
      siteMap.replaceChildren(...(projectOperationalAreas[project] ?? projectOperationalAreas.atlas).map((area) => {
        const card = document.createElement("article");
        card.className = "site-map-card";
        card.dataset.access = area.access;
        const name = document.createElement("strong");
        name.textContent = area.title;
        const description = document.createElement("p");
        description.textContent = area.purpose;
        const access = document.createElement("span");
        access.textContent = area.access === "manager" ? "管理権限が必要" : "日常の作業で使う";
        card.replaceChildren(name, description, access);
        return card;
      }));
    };
    buttons.forEach((button) => button.addEventListener("click", () => {
      project = button.dataset.project ?? "atlas";
      buttons.forEach((item) => item.setAttribute("aria-selected", String(item === button)));
      render();
    }));
    render();
  };
  document.addEventListener("astro:page-load", initializeOnboardingDemo);
  initializeOnboardingDemo();
</script>
