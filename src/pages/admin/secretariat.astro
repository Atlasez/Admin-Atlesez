---
import AdminLayout from "../../layouts/AdminLayout.astro";
import AdminNav from "../../components/AdminNav.astro";
---
<AdminLayout title="Atlasez運営事務局" description="Atlasez運営事務局のプロジェクトワークスペース">
  <main class="secretariat-home">
    <AdminNav current="secretariat" site="secretariat" />
    <header class="project-heading">
      <div>
        <h1>Atlasez運営事務局</h1>
        <span>このプロジェクトのページ内容は現在準備中です。</span>
      </div>
      <a href="/admin/portal/">Atlasezメンバー用サイトへ</a>
    </header>
    <section class="secretariat-empty" aria-labelledby="secretariat-empty-heading">
      <h2 id="secretariat-empty-heading">準備中</h2>
      <p>運営事務局の共有スペース、ToDo、日程は整備後にここへ追加します。</p>
    </section>
  </main>
</AdminLayout>
<style>
  .secretariat-home { margin: 0 auto; max-width: 1200px; padding: 0 1.25rem 4rem; }
  .project-heading { align-items: end; border-bottom: 1px solid var(--border-default); display: flex; gap: 1rem; justify-content: space-between; padding: 2.2rem 0 1.4rem; }
  .project-heading h1 { font-size: clamp(1.8rem, 4vw, 2.6rem); margin: .25rem 0; }
  .project-heading span { color: var(--text-secondary); line-height: 1.6; }
  .project-heading > a { color: var(--accent-primary); font-size: .8rem; font-weight: 800; text-decoration: none; white-space: nowrap; }
  .secretariat-empty { border: 1px dashed var(--border-default); color: var(--text-secondary); margin-top: 1.5rem; padding: 2.5rem 1.25rem; text-align: center; }
  .secretariat-empty h2 { color: var(--text-primary); font-size: 1.15rem; margin: 0 0 .45rem; }
  .secretariat-empty p { line-height: 1.6; margin: 0; }
  @media (max-width: 700px) {
    .secretariat-home { padding: 0 .8rem 3rem; }
    .project-heading { align-items: start; display: grid; }
  }
</style>
