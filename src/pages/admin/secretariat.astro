---
import AdminLayout from "../../layouts/AdminLayout.astro";
---
<AdminLayout title="Atlasez運営事務局" description="Atlasez運営事務局のプロジェクトワークスペース">
  <main class="secretariat-home">
    <header class="project-heading">
      <div><h1>Atlasez運営事務局</h1></div>
      <a href="/admin/portal/" aria-label="Atlasezメンバー用サイトへ戻る">←</a>
    </header>
    <section class="project-links" aria-label="運営事務局メニュー">
      <a href="/admin/operations/?project=secretariat"><strong>タスク管理</strong><span aria-label="タスク管理を開く">→</span></a>
      <a href="/admin/co-working/?project=secretariat"><strong>日程・交流</strong><span aria-label="日程・交流を開く">→</span></a>
      <a href="/admin/profile-requests/"><strong>メンバー情報の承認</strong><span aria-label="メンバー情報の承認を開く">→</span></a>
      <a href="/admin/introductions/?project=secretariat"><strong>運営内自己紹介</strong><span aria-label="運営内自己紹介を開く">→</span></a>
      <a href="/admin/workspace/?project=secretariat"><strong>マイページ</strong><span aria-label="プロジェクトのマイページを開く">→</span></a>
    </section>
  </main>
</AdminLayout>
<style>
  .secretariat-home { margin: 0 auto; max-width: 1200px; padding: 0 1.25rem 4rem; }
  .project-heading { align-items: end; border-bottom: 1px solid var(--border-default); display: flex; gap: 1rem; justify-content: space-between; padding: 2.2rem 0 1.4rem; }
  .project-heading h1 { font-size: clamp(1.8rem, 4vw, 2.6rem); margin: .25rem 0; }
  .project-heading span { color: var(--text-secondary); line-height: 1.6; }
  .project-heading > a { color: var(--accent-primary); font-size: .8rem; font-weight: 800; text-decoration: none; white-space: nowrap; }
  .project-links { display:grid;gap:.8rem;grid-template-columns:repeat(2,minmax(0,1fr));margin-top:1.5rem }.project-links a{background:var(--background-secondary);border:1px solid var(--border-default);color:var(--text-primary);display:grid;gap:1rem;min-height:5.5rem;padding:1rem;text-decoration:none}.project-links a:hover{border-color:var(--accent-primary)}.project-links span{color:var(--accent-primary);font-size:.78rem;font-weight:800}
  @media (max-width: 700px) {
    .secretariat-home { padding: 0 .8rem 3rem; }
    .project-heading { align-items: start; display: grid; }
    .project-links { grid-template-columns:1fr; }
  }
</style>
