---
import AdminLayout from "../../layouts/AdminLayout.astro";
import AdminNav from "../../components/AdminNav.astro";
---
<AdminLayout title="Atlasez運営事務局" description="Atlasez運営事務局のプロジェクトワークスペース">
  <main class="secretariat-home">
    <AdminNav current="secretariat" site="secretariat" />
    <header class="project-heading">
      <div>
        <p>ATLASEZ / SECRETARIAT</p>
        <h1>Atlasez運営事務局</h1>
        <span>事務局の依頼、ToDo、日程調整をひとつのプロジェクトとして管理します。</span>
      </div>
      <a href="/admin/portal/">メンバー用サイトへ</a>
    </header>
    <section class="secretariat-links" aria-label="運営事務局メニュー">
      <a class="featured" href="/admin/operations/?project=secretariat">
        <strong>進捗・ToDo・日程</strong>
        <small>事務局のタスクを依頼し、担当状況・進捗・期限を確認します。</small>
        <span>事務局の作業を開く →</span>
      </a>
      <a class="featured" href="/admin/co-working/?project=secretariat">
        <strong>日程調整・同時作業会</strong>
        <small>開催候補や参加可否を確認し、メンバーの予定を共有します。</small>
        <span>日程を見る →</span>
      </a>
      <a href="/admin/introductions/">
        <strong>運営内自己紹介</strong>
        <small>事務局メンバーの担当やプロフィールを確認します。</small>
        <span>紹介を見る →</span>
      </a>
      <a href="/admin/guide/">
        <strong>作業の進め方</strong>
        <small>事務局内の依頼・報告の流れを確認します。</small>
        <span>読む →</span>
      </a>
    </section>
    <p class="scope-note">この入口のToDo・進捗・日程は、アトラス学習サイトとは分離した運営事務局プロジェクトとして保存されます。</p>
  </main>
</AdminLayout>
<style>
  .secretariat-home { margin: 0 auto; max-width: 1200px; padding: 0 1.25rem 4rem; }
  .project-heading { align-items: end; border-bottom: 1px solid var(--border-default); display: flex; gap: 1rem; justify-content: space-between; padding: 2.2rem 0 1.4rem; }
  .project-heading p { color: var(--accent-primary); font-size: .72rem; font-weight: 800; letter-spacing: .1em; margin: 0; }
  .project-heading h1 { font-size: clamp(1.8rem, 4vw, 2.6rem); margin: .25rem 0; }
  .project-heading span { color: var(--text-secondary); line-height: 1.6; }
  .project-heading > a { color: var(--accent-primary); font-size: .8rem; font-weight: 800; text-decoration: none; white-space: nowrap; }
  .secretariat-links { display: grid; gap: .8rem; grid-template-columns: repeat(2, minmax(0, 1fr)); margin-top: 1.5rem; }
  .secretariat-links a { background: var(--background-secondary); border: 1px solid var(--border-default); color: var(--text-primary); display: grid; gap: .4rem; min-height: 7rem; padding: 1.2rem; text-decoration: none; }
  .secretariat-links a:hover { border-color: var(--accent-primary); transform: translateY(-1px); }
  .secretariat-links .featured { border-top: 4px solid var(--accent-primary); min-height: 9rem; }
  .secretariat-links strong { font-size: 1.05rem; }
  .secretariat-links small { color: var(--text-secondary); font-size: .78rem; line-height: 1.55; }
  .secretariat-links span { color: var(--accent-primary); font-size: .76rem; font-weight: 800; margin-top: auto; }
  .scope-note { border-left: 3px solid var(--border-default); color: var(--text-secondary); font-size: .75rem; line-height: 1.6; margin: 1.5rem 0 0; padding: .55rem .7rem; }
  @media (max-width: 700px) {
    .secretariat-home { padding: 0 .8rem 3rem; }
    .project-heading { align-items: start; display: grid; }
    .secretariat-links { grid-template-columns: 1fr; }
  }
</style>
