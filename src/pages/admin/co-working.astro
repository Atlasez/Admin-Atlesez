---
import AdminLayout from "../../layouts/AdminLayout.astro";
const requestedProject = Astro.url.searchParams.get("project");
const operationProject = requestedProject === "secretariat" || requestedProject === "seminar-platform" ? requestedProject : "atlas";
const atlasRecurringSessions = [
  { day: "毎週火曜日", time: "21:00〜" },
  { day: "毎週水曜日", time: "21:00〜" },
  { day: "毎週木曜日", time: "21:00〜" },
  { day: "毎週金曜日", time: "21:00〜" },
  { day: "毎週日曜日", time: "10:00〜" },
];
---
<AdminLayout title="同時作業会" description="同時作業会の日時と参加状況">
  <main class="co-working" data-co-working>
    <header class="page-heading">
      <div>
        <h1>同時作業会</h1>
        <span>開催場所・日時・参加可否を一覧で確認できます。</span>
      </div>
      <a href={`/admin/operations/?project=${operationProject}`}>日程を追加・管理する →</a>
    </header>
    {operationProject === "atlas" && (
      <section class="regular-section" aria-labelledby="regular-heading" data-regular-schedule>
        <div class="section-heading">
          <div><p class="section-kicker">定期開催</p><h2 id="regular-heading">現在の同時作業会</h2></div>
          <span>日本標準時（JST）</span>
        </div>
        <div class="regular-list">
          {atlasRecurringSessions.map((session) => (
            <article class="regular-card"><strong>{session.day}</strong><time>{session.time}</time><small>Discord VCで開催</small></article>
          ))}
        </div>
        <p class="schedule-source">Discord「同時作業会連絡」の2026年7月1日付の最新日程告知を反映しています。</p>
      </section>
    )}
    <section class="event-section">
      <div class="section-heading">
        <div><p class="section-kicker">日程</p><h2>開催予定</h2></div>
        <a href={`/admin/operations/?project=${operationProject}`}>タスク管理・日程へ</a>
      </div>
      <div class="event-list" data-event-list aria-live="polite">読み込み中…</div>
      <p class="empty" data-event-empty hidden>登録された同時作業会はありません。</p>
    </section>
    <p class="scope-note">開催場所は日程の詳細欄に記録してください。イベントの作成・参加可否の登録は、既存のタスク管理・カレンダーページで行えます。</p>
  </main>
</AdminLayout>
<style>
  .co-working { margin: 0 auto; max-width: 1200px; padding: 0 1.25rem 4rem; }
  .page-heading { align-items: end; border-bottom: 1px solid var(--border-default); display: flex; gap: 1rem; justify-content: space-between; padding: 2.2rem 0 1.4rem; }
  .page-heading p, .section-kicker { color: var(--accent-primary); font-size: .72rem; font-weight: 800; letter-spacing: .1em; margin: 0; }
  .page-heading h1 { font-size: clamp(1.8rem, 4vw, 2.6rem); margin: .25rem 0; }
  .page-heading span { color: var(--text-secondary); line-height: 1.6; }
  .page-heading > a, .section-heading > a { color: var(--accent-primary); font-size: .8rem; font-weight: 800; text-decoration: none; white-space: nowrap; }
  .event-section { margin-top: 1.5rem; }
  .regular-section { margin-top: 1.5rem; }
  .section-heading { align-items: end; border-bottom: 1px solid var(--border-default); display: flex; gap: 1rem; justify-content: space-between; margin-bottom: .8rem; padding-bottom: .65rem; }
  .section-heading h2 { font-size: 1.25rem; margin: .2rem 0 0; }
  .event-list { display: grid; gap: .7rem; grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr)); }
  .regular-list { display: grid; gap: .7rem; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); }
  .regular-card { background: var(--background-secondary); border: 1px solid var(--border-default); display: grid; gap: .25rem; padding: .85rem; }
  .regular-card strong { font-size: .9rem; }
  .regular-card time { color: var(--accent-primary); font-size: 1.05rem; font-weight: 800; }
  .regular-card small, .schedule-source, .section-heading span { color: var(--text-secondary); font-size: .72rem; }
  .schedule-source { line-height: 1.6; margin: .65rem 0 0; }
  .event-card { border: 1px solid var(--border-default); display: grid; gap: .45rem; padding: 1rem; }
  .event-card strong { font-size: 1rem; }
  .event-card time { color: var(--accent-primary); font-size: .82rem; font-weight: 800; }
  .event-card small { color: var(--text-secondary); line-height: 1.55; }
  .availability { color: var(--text-secondary); font-size: .76rem; }
  .empty { color: var(--text-secondary); font-size: .82rem; }
  .scope-note { border-left: 3px solid var(--border-default); color: var(--text-secondary); font-size: .75rem; line-height: 1.6; margin: 1.5rem 0 0; padding: .55rem .7rem; }
  @media (max-width: 700px) {
    .co-working { padding: 0 .8rem 3rem; }
    .page-heading { align-items: start; display: grid; }
    .section-heading { align-items: start; display: grid; }
    .event-list { grid-template-columns: 1fr; }
  }
</style>
<script>
  type CoWorkingEvent = {
    title?: string;
    starts_at?: string;
    ends_at?: string | null;
    details?: string | null;
    location?: string | null;
    availabilityCounts?: Record<string, number>;
  };
  type OperationsResponse = { events?: CoWorkingEvent[]; error?: string };
  const initializeCoWorking = () => {
    const root = document.querySelector<HTMLElement>('[data-co-working]');
    if (!root || root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';
    const list = root.querySelector<HTMLElement>('[data-event-list]')!;
    const empty = root.querySelector<HTMLElement>('[data-event-empty]')!;
    const escapeHtml = (value: string) => value.replace(/[&<>"']/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[character] ?? character);
    const formatDate = (value: string) => new Intl.DateTimeFormat('ja-JP', { dateStyle: 'full', timeStyle: 'short' }).format(new Date(value));
    const projectId = new URLSearchParams(location.search).get('project') || 'atlas';
    void fetch(`/api/admin/operations?project=${encodeURIComponent(projectId)}`, { credentials: 'same-origin', cache: 'no-store' }).then(async (response) => {
      const contentType = response.headers.get('content-type') ?? '';
      const data = contentType.includes('application/json') ? await response.json() as OperationsResponse : null;
      if (!response.ok || !data) throw new Error(data?.error ?? '日程を読み込めませんでした。');
      const now = Date.now();
      const events = (data.events ?? []).filter((event) => event.starts_at && new Date(event.starts_at).getTime() >= now).sort((a, b) => new Date(a.starts_at!).getTime() - new Date(b.starts_at!).getTime());
      if (!events.length) { list.hidden = true; empty.hidden = false; return; }
      list.innerHTML = events.map((event) => {
        const counts = event.availabilityCounts ?? {};
        const availability = '参加 ' + (counts.available ?? 0) + ' / 未定 ' + (counts.maybe ?? 0) + ' / 不参加 ' + (counts.unavailable ?? 0);
        const description = event.location || event.details;
        const end = event.ends_at ? ' 〜 ' + formatDate(event.ends_at) : '';
        return '<article class="event-card"><strong>' + escapeHtml(event.title ?? '同時作業会') + '</strong><time datetime="' + escapeHtml(event.starts_at!) + '">' + escapeHtml(formatDate(event.starts_at!)) + escapeHtml(end) + '</time>' + (description ? '<small>' + escapeHtml(description) + '</small>' : '') + '<span class="availability">' + escapeHtml(availability) + '</span></article>';
      }).join('');
    }).catch((error) => {
      list.textContent = error instanceof Error ? error.message : '日程を読み込めませんでした。';
    });
  };
  document.addEventListener('astro:page-load', initializeCoWorking);
  initializeCoWorking();
</script>
