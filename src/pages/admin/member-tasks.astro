<script>
  (() => {
    const attachTaskFinder = () => {
      const root = document.querySelector<HTMLElement>('[data-member-tasks]');
      if (!root || root.dataset.finderReady === 'true') return;
      root.dataset.finderReady = 'true';
      const list = root.querySelector<HTMLElement>('[data-list]');
      const search = root.querySelector<HTMLInputElement>('[data-task-search]');
      const status = root.querySelector<HTMLSelectElement>('[data-status-filter]');
      const due = root.querySelector<HTMLSelectElement>('[data-due-filter]');
      const result = root.querySelector<HTMLElement>('[data-result-count]');
      if (!list || !search || !status || !due) return;

      const startOfToday = () => { const date = new Date(); date.setHours(0, 0, 0, 0); return date; };
      const matchesDue = (article: HTMLElement, mode: string) => {
        const dueText = article.textContent?.match(/期限:\s*([^\n]+?)(?:\s*\([^)]*\))?(?:\n|$)/)?.[1]?.trim() ?? '';
        if (mode === 'all') return true;
        if (mode === 'none') return !dueText;
        if (!dueText) return false;
        const date = new Date(dueText.replace(/年|月/g, '/').replace(/日/g, ''));
        if (Number.isNaN(date.getTime())) return true;
        const today = startOfToday();
        if (mode === 'overdue') return date < today;
        const end = new Date(today);
        end.setDate(end.getDate() + (mode === 'today' ? 1 : 7));
        return date >= today && date < end;
      };
      const apply = () => {
        const query = search.value.trim().toLocaleLowerCase();
        const selectedStatus = status.value;
        const selectedDue = due.value;
        const articles = [...list.querySelectorAll<HTMLElement>('.task')];
        let visible = 0;
        articles.forEach((article) => {
          const statusMatch = selectedStatus === 'all' || article.classList.contains(`status-${selectedStatus}`);
          const keywordMatch = !query || (article.textContent ?? '').toLocaleLowerCase().includes(query);
          const dueMatch = matchesDue(article, selectedDue);
          const show = statusMatch && keywordMatch && dueMatch;
          article.hidden = !show;
          if (show) visible += 1;
        });
        if (result && articles.length) result.textContent = `${visible}件`;
        const summary = {
          total: root.querySelector<HTMLElement>('[data-summary-total]'),
          open: root.querySelector<HTMLElement>('[data-summary-open]'),
          doing: root.querySelector<HTMLElement>('[data-summary-doing]'),
          done: root.querySelector<HTMLElement>('[data-summary-done]'),
        };
        if (articles.length) {
          summary.total && (summary.total.textContent = String(visible));
          summary.open && (summary.open.textContent = String(articles.filter((article) => !article.hidden && article.classList.contains('status-open')).length));
          summary.doing && (summary.doing.textContent = String(articles.filter((article) => !article.hidden && article.classList.contains('status-doing')).length));
          summary.done && (summary.done.textContent = String(articles.filter((article) => !article.hidden && article.classList.contains('status-done')).length));
        }
      };
      search.addEventListener('input', apply);
      status.addEventListener('change', apply);
      due.addEventListener('change', apply);
      root.querySelector<HTMLButtonElement>('[data-apply-filters]')?.addEventListener('click', apply);
      root.querySelector<HTMLButtonElement>('[data-clear-filters]')?.addEventListener('click', () => {
        search.value = '';
        status.value = 'all';
        due.value = 'all';
        root.querySelector<HTMLButtonElement>('[data-filter="assigned"]')?.click();
        root.querySelectorAll<HTMLInputElement>('[data-project-filter]').forEach((input) => { input.checked = true; });
        root.querySelector<HTMLElement>('[data-project-filters]')?.dispatchEvent(new Event('change', { bubbles: true }));
        window.requestAnimationFrame(apply);
      });
      new MutationObserver(() => window.requestAnimationFrame(apply)).observe(list, { childList: true });
      apply();
    };
    document.addEventListener('astro:page-load', attachTaskFinder);
    attachTaskFinder();
  })();
</script>
