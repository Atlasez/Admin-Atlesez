---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { getTimeZoneOptions } from "../../lib/timezones";
const timezones = getTimeZoneOptions(new Date());
---
<AdminLayout title="タスク管理" description="参加中のプロジェクトのタスクを横断管理します">
  <main class="member-tasks" data-member-tasks>
    <header class="task-page-header">
      <div><h1>タスク管理</h1><p>参加中のプロジェクトを横断して、担当・期限・進捗を確認できます。</p></div>
      <button class="primary-cta" type="button" data-scroll-create><span aria-hidden="true">＋</span>タスクを追加</button>
    </header>

    <section class="task-summary" aria-label="タスクの概要">
      <div class="summary-card"><span>表示中</span><strong data-summary-total>0</strong><small>件</small></div>
      <div class="summary-card"><span>未着手</span><strong data-summary-open>0</strong><small>件</small></div>
      <div class="summary-card"><span>進行中</span><strong data-summary-doing>0</strong><small>件</small></div>
      <div class="summary-card"><span>完了</span><strong data-summary-done>0</strong><small>件</small></div>
    </section>

    <section class="task-finder" aria-labelledby="task-finder-title">
      <div class="finder-heading"><div><h2 id="task-finder-title">条件からタスクを探す</h2><p>おわかりになる項目だけ指定して、必要なタスクをすばやく表示します。</p></div><span class="finder-hint">複数指定できます</span></div>
      <div class="finder-grid">
        <label class="finder-keyword"><span>キーワード</span><input data-task-search type="search" placeholder="タスク名・内容・プロジェクト名" /></label>
        <label><span>進捗</span><select data-status-filter><option value="all">すべて</option><option value="open">未着手</option><option value="doing">進行中</option><option value="done">完了</option></select></label>
        <label><span>期限</span><select data-due-filter><option value="all">すべて</option><option value="overdue">期限超過</option><option value="today">今日</option><option value="week">7日以内</option><option value="none">期限なし</option></select></label>
        <button class="finder-submit" type="button" data-apply-filters><span aria-hidden="true">⌕</span>検索</button>
        <button class="finder-reset" type="button" data-clear-filters>条件をリセット</button>
      </div>
      <details class="advanced-filters" open>
        <summary>条件を指定して絞り込む</summary>
        <div class="project-filter-panel"><div class="filter-panel-heading"><strong>プロジェクト</strong><span data-project-filter-count>0件選択中</span></div><div class="project-filters" data-project-filters></div></div>
      </details>
    </section>

    <section class="create-task" id="task-create" data-create-panel>
      <div class="create-heading"><div><h2>タスクを追加</h2><p>依頼内容と期限を入力して、担当者へ共有します。</p></div><span class="required-note">すべて任意</span></div>
      <div class="create-grid"><label><span>プロジェクト</span><select data-project></select></label><label><span>タスク名</span><input data-title maxlength="200" placeholder="例：記事を確認する" /></label><label><span>担当者</span><select data-assignee multiple size="6" aria-describedby="member-task-assignee-help"><option value="" disabled>担当者を選択</option></select><small id="member-task-assignee-help">複数人は Ctrl（Windows）または⌘（Mac）で選択</small></label><label><span>期限</span><input data-due type="datetime-local" /></label><label><span>期限のタイムゾーン</span><select data-timezone>{timezones.map(({value,label})=><option value={value} selected={value==="Asia/Tokyo"}>{label}</option>)}</select></label></div>
      <label class="details-field"><span>補足・依頼内容</span><textarea data-details maxlength="10000" placeholder="目的、確認してほしい点、完了条件など"></textarea></label>
      <div class="actions"><output data-message aria-live="polite"></output><button class="create-cta" type="button" data-create>タスクを追加<span aria-hidden="true">→</span></button></div>
    </section>

    <section class="task-section">
      <div class="section-head"><div><h2>参加中のプロジェクトのタスク</h2><p class="result-summary" data-result-count>0件</p></div><div class="filters" role="group" aria-label="タスクの表示対象"><button type="button" class="is-selected" aria-pressed="true" data-filter="assigned">自分がこなす</button><button type="button" aria-pressed="false" data-filter="created">自分が依頼</button><button type="button" aria-pressed="false" data-filter="all">すべて</button></div></div>
      <div data-list>読み込み中…</div>
    </section>
  </main>
</AdminLayout>
<style>
  .member-tasks{margin:0 auto;max-width:1150px;padding:0 1.25rem 4rem}.member-tasks>header{border-bottom:1px solid var(--border-default);padding:2rem 0 1.25rem}.member-tasks h1{font-size:clamp(1.8rem,4vw,2.35rem);margin:0}.member-tasks section{border:1px solid var(--border-default);margin-top:1rem;padding:1rem}.member-tasks h2{font-size:1.08rem;margin:0 0 .8rem}.create-grid{display:grid;gap:.65rem;grid-template-columns:1fr 1.5fr 1fr 1fr 1.2fr}.member-tasks label{display:grid;font-size:.78rem;font-weight:800;gap:.3rem}.member-tasks input,.member-tasks select,.member-tasks textarea{background:var(--background-primary);border:1px solid var(--border-default);box-sizing:border-box;color:var(--text-primary);font:inherit;padding:.5rem;width:100%}.member-tasks textarea{min-height:5rem;resize:vertical}.actions,.section-head{align-items:center;display:flex;gap:1rem;justify-content:space-between}.actions{margin-top:.7rem}.actions output{color:var(--text-secondary)}button{cursor:pointer;font:inherit}.actions button,.status-button{background:var(--accent-primary);border:1px solid var(--accent-primary);color:#fff;font-weight:800;padding:.5rem .7rem}.filters,.project-filters{display:flex;flex-wrap:wrap;gap:.4rem}.filters button,.project-filters label{background:var(--background-primary);border:1px solid var(--border-default);color:var(--text-primary);padding:.38rem .58rem}.filters button.is-selected{background:var(--accent-primary);color:#fff}.project-filters{margin-bottom:.8rem}.project-filters label{align-items:center;display:flex;font-size:.74rem}.task{align-items:start;border-top:1px solid var(--border-default);display:grid;gap:1rem;grid-template-columns:minmax(0,1fr) auto;padding:.85rem 0}.task:first-child{border-top:0}.task h3{font-size:.95rem;margin:0 0 .25rem}.task p{color:var(--text-secondary);font-size:.78rem;margin:.25rem 0;white-space:pre-wrap}.task-meta{display:flex;flex-wrap:wrap;gap:.35rem}.badge{background:var(--background-secondary);border:1px solid var(--border-default);font-size:.7rem;padding:.18rem .38rem}.task-actions{align-items:end;display:grid;gap:.4rem;min-width:9rem}.task-actions select{font-size:.78rem}.approval-link{color:var(--accent-primary);font-size:.76rem;font-weight:800}.empty{color:var(--text-secondary)}@media(max-width:850px){.create-grid{grid-template-columns:1fr 1fr}.section-head{align-items:start;flex-direction:column}.task{grid-template-columns:1fr}.task-actions{align-items:stretch}}@media(max-width:540px){.member-tasks{padding:0 .8rem 3rem}.create-grid{grid-template-columns:1fr}.actions{align-items:stretch;flex-direction:column}.actions button{width:100%}}
  .member-tasks label small{color:var(--text-secondary);font-weight:400;line-height:1.4}
</style>
<style is:global>
  .member-tasks {
    --task-blue: #1769aa;
    --task-blue-dark: #0e4f84;
    --task-navy: #17324d;
    --task-border: #cbd9e6;
    --task-soft: #f4f8fc;
    background: #fff;
    color: var(--task-navy);
    max-width: 1180px;
  }
  .member-tasks > header.task-page-header { align-items: end; border-bottom: 1px solid var(--task-border); display: flex; gap: 1.5rem; justify-content: space-between; padding: 2rem 0 1.35rem; }
  .member-tasks .eyebrow, .member-tasks .section-kicker { color: var(--task-blue); font-size: .7rem; font-weight: 900; letter-spacing: .12em; margin: 0; }
  .member-tasks .task-page-header h1 { color: var(--task-navy); font-size: clamp(2rem, 4vw, 2.75rem); letter-spacing: -.02em; margin: .35rem 0 .4rem; }
  .member-tasks .task-page-header p:not(.eyebrow) { color: #526b80; font-size: .9rem; line-height: 1.65; margin: 0; }
  .member-tasks .primary-cta, .member-tasks .create-cta { align-items: center; background: var(--task-blue); border: 1px solid var(--task-blue); border-radius: .5rem; color: #fff; display: inline-flex; font-weight: 900; justify-content: center; min-height: 3.2rem; padding: .7rem 1.25rem; transition: background .15s ease, transform .15s ease; }
  .member-tasks .primary-cta { font-size: .95rem; gap: .45rem; white-space: nowrap; }
  .member-tasks .primary-cta span { font-size: 1.25rem; line-height: 1; }
  .member-tasks .primary-cta:hover, .member-tasks .create-cta:hover { background: var(--task-blue-dark); transform: translateY(-1px); }
  .member-tasks .task-summary { background: transparent; border: 0; box-shadow: none; display: grid; gap: .7rem; grid-template-columns: repeat(4, minmax(0, 1fr)); margin-top: 1rem; padding: 0; }
  .member-tasks .summary-card { align-items: baseline; background: var(--task-soft); border: 1px solid var(--task-border); border-radius: .55rem; display: flex; gap: .35rem; padding: .85rem 1rem; }
  .member-tasks .summary-card span { color: #526b80; font-size: .78rem; font-weight: 800; margin-right: auto; }
  .member-tasks .summary-card strong { color: var(--task-blue); font-size: 1.65rem; line-height: 1; }
  .member-tasks .summary-card small { color: #526b80; font-size: .72rem; }
  .member-tasks section.create-task, .member-tasks section.task-section { background: #fff; border: 1px solid var(--task-border); border-radius: .65rem; box-shadow: 0 .35rem 1.2rem rgb(23 50 77 / .07); margin-top: 1.2rem; padding: 1.25rem; }
  .member-tasks section.create-task { background: #f8fbff; border-top: 4px solid var(--task-blue); }
  .member-tasks .create-heading { align-items: start; display: flex; gap: 1rem; justify-content: space-between; margin-bottom: 1rem; }
  .member-tasks .create-heading h2, .member-tasks .section-head h2 { color: var(--task-navy); font-size: 1.2rem; margin: .25rem 0 .2rem; }
  .member-tasks .create-heading p { color: #526b80; font-size: .82rem; margin: 0; }
  .member-tasks .required-note { background: #fff; border: 1px solid var(--task-border); border-radius: 999px; color: #526b80; font-size: .72rem; padding: .35rem .6rem; white-space: nowrap; }
  .member-tasks .create-grid { align-items: start; gap: .85rem; grid-template-columns: 1.05fr 1.55fr 1.2fr 1fr 1.2fr; }
  .member-tasks label { color: var(--task-navy); font-size: .78rem; gap: .35rem; }
  .member-tasks label > span { font-weight: 900; }
  .member-tasks input, .member-tasks select, .member-tasks textarea { background: #fff; border: 1px solid #b9ccdc; border-radius: .4rem; color: var(--task-navy); min-height: 2.6rem; outline: 0; padding: .6rem .65rem; }
  .member-tasks input:focus, .member-tasks select:focus, .member-tasks textarea:focus { border-color: var(--task-blue); box-shadow: 0 0 0 3px rgb(23 105 170 / .14); }
  .member-tasks select[multiple] { min-height: 8.7rem; padding: .35rem; }
  .member-tasks select[multiple] option { border-radius: .25rem; padding: .35rem .45rem; }
  .member-tasks select[multiple] option:checked { background: var(--task-blue); color: #fff; }
  .member-tasks .details-field { margin-top: .9rem; }
  .member-tasks .details-field textarea { min-height: 5.25rem; }
  .member-tasks .actions { align-items: center; margin-top: .9rem; }
  .member-tasks .actions output { color: #526b80; font-size: .82rem; }
  .member-tasks .create-cta { gap: .8rem; min-width: 10rem; }
  .member-tasks .create-cta span { font-size: 1.1rem; }
  .member-tasks .task-section { padding: 1.25rem; }
  .member-tasks .section-head { align-items: end; border-bottom: 1px solid var(--task-border); padding-bottom: 1rem; }
  .member-tasks .section-head h2 { margin-top: .25rem; }
  .member-tasks .result-summary { color: #526b80; font-size: .8rem; margin: .25rem 0 0; }
  .member-tasks .filters { background: var(--task-soft); border: 1px solid var(--task-border); border-radius: .5rem; gap: .25rem; padding: .25rem; }
  .member-tasks .filters button { background: transparent; border: 0; border-radius: .35rem; color: #526b80; font-size: .8rem; font-weight: 900; min-height: 2.35rem; padding: .5rem .8rem; }
  .member-tasks .filters button:hover { color: var(--task-blue); }
  .member-tasks .filters button.is-selected { background: var(--task-blue); box-shadow: 0 .15rem .35rem rgb(23 105 170 / .18); color: #fff; }
  .member-tasks .project-filter-panel { background: var(--task-soft); border: 1px solid var(--task-border); border-radius: .5rem; margin: 1rem 0; padding: .75rem; }
  .member-tasks .filter-panel-heading { align-items: baseline; display: flex; gap: .7rem; justify-content: space-between; margin-bottom: .55rem; }
  .member-tasks .filter-panel-heading strong { font-size: .78rem; }
  .member-tasks .filter-panel-heading span { color: #526b80; font-size: .72rem; }
  .member-tasks .project-filters { gap: .45rem; margin: 0; padding: 0; }
  .member-tasks .project-filters label { background: #fff; border: 1px solid #b9ccdc; border-radius: 999px; color: #526b80; cursor: pointer; display: inline-flex; font-size: .76rem; gap: .4rem; padding: .45rem .7rem; }
  .member-tasks .project-filters label:hover, .member-tasks .project-filters label:has(input:checked) { border-color: var(--task-blue); color: var(--task-blue); }
  .member-tasks .project-filters label:has(input:checked) { background: #eaf4fc; font-weight: 900; }
  .member-tasks .project-filters input { accent-color: var(--task-blue); min-height: 0; padding: 0; width: auto; }
  .member-tasks [data-list] { display: grid; gap: .7rem; }
  .member-tasks .task { background: #fff; border: 1px solid var(--task-border); border-left: 4px solid var(--task-blue); border-radius: .55rem; box-shadow: 0 .15rem .5rem rgb(23 50 77 / .04); padding: 1rem 1.05rem; }
  .member-tasks .task-title { align-items: baseline; display: flex; gap: .55rem; }
  .member-tasks .task-title h3 { color: var(--task-navy); font-size: 1rem; margin: 0; }
  .member-tasks .status-dot { background: var(--task-blue); border-radius: 50%; flex: 0 0 auto; height: .55rem; width: .55rem; }
  .member-tasks .task.status-done { border-left-color: #5d8c70; }
  .member-tasks .task.status-done .status-dot { background: #5d8c70; }
  .member-tasks .task.status-doing { border-left-color: #d0861d; }
  .member-tasks .task.status-doing .status-dot { background: #d0861d; }
  .member-tasks .task-meta { margin-top: .55rem; }
  .member-tasks .badge { background: #f4f8fc; border: 1px solid var(--task-border); color: #526b80; }
  .member-tasks .badge-status { font-weight: 900; }
  .member-tasks .task-actions { gap: .55rem; min-width: 10.5rem; }
  .member-tasks .status-control { gap: .25rem; }
  .member-tasks .status-control > span { color: #526b80; font-size: .7rem; }
  .member-tasks .task-actions select { min-height: 2.45rem; }
  .member-tasks .status-button { background: var(--task-blue); border-color: var(--task-blue); border-radius: .4rem; min-height: 2.45rem; padding: .55rem .7rem; }
  .member-tasks .status-button:hover { background: var(--task-blue-dark); }
  .member-tasks .empty { background: var(--task-soft); border: 1px dashed var(--task-border); color: #526b80; }
  @media (max-width: 980px) { .member-tasks .create-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 850px) { .member-tasks > header.task-page-header { align-items: start; } .member-tasks .task-summary { grid-template-columns: repeat(2, minmax(0, 1fr)); } .member-tasks .create-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 540px) { .member-tasks > header.task-page-header { gap: 1rem; } .member-tasks .primary-cta { width: 100%; } .member-tasks .task-summary { grid-template-columns: repeat(2, minmax(0, 1fr)); } .member-tasks .create-grid { grid-template-columns: 1fr; } .member-tasks .create-heading { display: grid; } .member-tasks .section-head { align-items: stretch; } .member-tasks .filters { display: grid; grid-template-columns: repeat(3, 1fr); } .member-tasks .filters button { padding-left: .35rem; padding-right: .35rem; } .member-tasks .actions { align-items: stretch; } .member-tasks .create-cta { width: 100%; } }
</style>
<style is:global>
  .member-tasks { --task-card-bg: color-mix(in srgb, var(--background-primary) 92%, var(--accent-primary) 8%); }
  .member-tasks > header { align-items: end; display: flex; gap: 1.5rem; justify-content: space-between; }
  .member-tasks > header p { color: var(--text-secondary); line-height: 1.6; margin: .45rem 0 0; max-width: 42rem; }
  .member-tasks section { background: var(--background-primary); border-radius: .85rem; box-shadow: 0 .45rem 1.5rem rgb(19 49 76 / .06); }
  .member-tasks .create-task { background: linear-gradient(135deg, color-mix(in srgb, var(--accent-primary) 6%, var(--background-primary)), var(--background-primary)); }
  .member-tasks .task-section { padding: 1.15rem; }
  .member-tasks .section-head { align-items: end; border-bottom: 1px solid var(--border-default); padding-bottom: .85rem; }
  .member-tasks .section-head h2 { margin: 0; }
  .member-tasks .filters { background: var(--background-secondary); border: 1px solid var(--border-default); border-radius: 999px; gap: .2rem; padding: .2rem; }
  .member-tasks .filters button { background: transparent; border: 0; border-radius: 999px; font-size: .76rem; font-weight: 800; padding: .48rem .7rem; }
  .member-tasks .filters button:hover { color: var(--accent-primary); }
  .member-tasks .filters button.is-selected { background: var(--background-primary); box-shadow: 0 .1rem .35rem rgb(19 49 76 / .12); color: var(--accent-primary); }
  .member-tasks .project-filters { background: var(--background-secondary); border: 1px solid var(--border-default); border-radius: .7rem; gap: .45rem; margin: .95rem 0 1rem; padding: .55rem; }
  .member-tasks .project-filters label { align-items: center; border: 1px solid transparent; border-radius: 999px; cursor: pointer; display: inline-flex; font-size: .74rem; gap: .35rem; padding: .45rem .65rem; transition: background .15s ease, border-color .15s ease, color .15s ease; }
  .member-tasks .project-filters label:hover { background: var(--background-primary); border-color: var(--border-default); }
  .member-tasks .project-filters label:has(input:checked) { background: color-mix(in srgb, var(--accent-primary) 10%, var(--background-primary)); border-color: color-mix(in srgb, var(--accent-primary) 35%, var(--border-default)); color: var(--accent-primary); font-weight: 800; }
  .member-tasks .project-filters input { accent-color: var(--accent-primary); margin: 0; width: auto; }
  .member-tasks [data-list] { display: grid; gap: .7rem; }
  .member-tasks .task { background: var(--task-card-bg); border: 1px solid var(--border-default); border-left: 4px solid var(--accent-primary); border-radius: .7rem; box-shadow: 0 .2rem .8rem rgb(19 49 76 / .04); display: grid; gap: 1rem; grid-template-columns: minmax(0, 1fr) auto; padding: 1rem; }
  .member-tasks .task + .task { margin-top: 0; }
  .member-tasks .task h3 { font-size: 1rem; line-height: 1.45; }
  .member-tasks .task p { line-height: 1.55; }
  .member-tasks .task-meta { margin-top: .5rem; }
  .member-tasks .badge { border-radius: 999px; font-size: .68rem; padding: .22rem .5rem; }
  .member-tasks .task-actions { align-items: stretch; display: grid; gap: .45rem; min-width: 9.5rem; }
  .member-tasks .task-actions select { border-radius: .45rem; }
  .member-tasks .status-button { border-radius: .45rem; cursor: pointer; }
  .member-tasks .status-button:hover, .member-tasks .actions button:hover { filter: brightness(.94); }
  .member-tasks .approval-link { display: inline-flex; margin-top: .45rem; }
  .member-tasks .empty { align-items: center; background: var(--background-secondary); border: 1px dashed var(--border-default); border-radius: .7rem; display: grid; gap: .35rem; justify-items: center; margin: 0; padding: 2rem 1rem; text-align: center; }
  .member-tasks .empty::before { align-items: center; background: color-mix(in srgb, var(--accent-primary) 12%, transparent); border-radius: 50%; color: var(--accent-primary); content: "✓"; display: flex; font-size: 1.25rem; font-weight: 900; height: 2.25rem; justify-content: center; width: 2.25rem; }
  @media (max-width: 850px) {
    .member-tasks > header { align-items: start; flex-direction: column; }
    .member-tasks .task { grid-template-columns: 1fr; }
    .member-tasks .task-actions { min-width: 0; }
  }
</style>
<style is:global>
  /* Keep the transaction controls crisp even when the shell theme changes. */
  .member-tasks .filters { background: var(--task-soft); border: 1px solid var(--task-border); border-radius: .5rem; gap: .25rem; padding: .25rem; }
  .member-tasks .filters button { background: transparent; border: 0; border-radius: .35rem; color: #526b80; font-size: .8rem; font-weight: 900; min-height: 2.35rem; padding: .5rem .8rem; }
  .member-tasks .filters button.is-selected { background: var(--task-blue); color: #fff; }
  .member-tasks .project-filters { gap: .45rem; margin: 0; padding: 0; }
  .member-tasks .project-filters label { background: #fff; border: 1px solid #b9ccdc; border-radius: 999px; color: #526b80; padding: .45rem .7rem; }
  .member-tasks .project-filters label:has(input:checked) { background: #eaf4fc; border-color: var(--task-blue); color: var(--task-blue); font-weight: 900; }
  .member-tasks .project-filters input { accent-color: var(--task-blue); }
  .member-tasks .task { background: #fff; border: 1px solid var(--task-border); border-left: 4px solid var(--task-blue); border-radius: .55rem; padding: 1rem 1.05rem; }
  .member-tasks .task-actions { min-width: 10.5rem; }
  .member-tasks .task-actions select { min-height: 2.45rem; }
  .member-tasks .status-button { background: var(--task-blue); border-color: var(--task-blue); min-height: 2.45rem; }
</style>
<style is:global>
  /* JR東日本の「条件をまとめて探す」構成を、既存のタスク操作に合わせた密度で再現する。 */
  .member-tasks {
    --task-accent: var(--accent-primary);
    --task-accent-strong: var(--accent-hover);
    --task-accent-ink: var(--on-accent);
    --task-surface: color-mix(in srgb, var(--background-primary) 96%, white 4%);
    --task-inset: color-mix(in srgb, var(--background-primary) 91%, white 9%);
    --task-hover: color-mix(in srgb, var(--background-primary) 86%, white 14%);
    --task-line: color-mix(in srgb, var(--text-primary) 14%, transparent);
    --task-line-strong: color-mix(in srgb, var(--text-primary) 22%, transparent);
    --task-muted: color-mix(in srgb, var(--text-primary) 64%, transparent);
    max-width: 1200px;
    padding-bottom: 5rem;
  }
  .member-tasks > header.task-page-header {
    align-items: flex-end;
