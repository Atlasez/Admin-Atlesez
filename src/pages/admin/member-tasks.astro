---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { getTimeZoneOptions } from "../../lib/timezones";
const timezones = getTimeZoneOptions(new Date());
---
<AdminLayout title="タスク管理" description="参加中のプロジェクトのタスクを横断管理します">
  <main class="member-tasks" data-member-tasks>
    <header><h1>タスク管理</h1></header>
    <section class="create-task">
      <h2>タスクを追加</h2>
      <div class="create-grid"><label>プロジェクト<select data-project></select></label><label>タスク名<input data-title maxlength="200" /></label><label>担当者<select data-assignee><option value="">担当者を指定しない</option></select></label><label>期限<input data-due type="datetime-local" /></label><label>期限のタイムゾーン<select data-timezone>{timezones.map(({value,label})=><option value={value} selected={value==="Asia/Tokyo"}>{label}</option>)}</select></label></div>
      <label>補足・依頼内容<textarea data-details maxlength="10000"></textarea></label>
      <div class="actions"><output data-message aria-live="polite"></output><button type="button" data-create>タスクを追加</button></div>
    </section>
    <section class="task-section">
      <div class="section-head"><h2>参加中のプロジェクトのタスク</h2><div class="filters" role="group" aria-label="タスクの表示対象"><button type="button" class="is-selected" data-filter="assigned">自分がこなす</button><button type="button" data-filter="created">自分が依頼</button><button type="button" data-filter="all">すべて</button></div></div>
      <div class="project-filters" data-project-filters></div>
      <div data-list>読み込み中…</div>
    </section>
  </main>
</AdminLayout>
<style>
  .member-tasks{margin:0 auto;max-width:1150px;padding:0 1.25rem 4rem}.member-tasks>header{border-bottom:1px solid var(--border-default);padding:2rem 0 1.25rem}.member-tasks h1{font-size:clamp(1.8rem,4vw,2.35rem);margin:0}.member-tasks section{border:1px solid var(--border-default);margin-top:1rem;padding:1rem}.member-tasks h2{font-size:1.08rem;margin:0 0 .8rem}.create-grid{display:grid;gap:.65rem;grid-template-columns:1fr 1.5fr 1fr 1fr 1.2fr}.member-tasks label{display:grid;font-size:.78rem;font-weight:800;gap:.3rem}.member-tasks input,.member-tasks select,.member-tasks textarea{background:var(--background-primary);border:1px solid var(--border-default);box-sizing:border-box;color:var(--text-primary);font:inherit;padding:.5rem;width:100%}.member-tasks textarea{min-height:5rem;resize:vertical}.actions,.section-head{align-items:center;display:flex;gap:1rem;justify-content:space-between}.actions{margin-top:.7rem}.actions output{color:var(--text-secondary)}button{cursor:pointer;font:inherit}.actions button,.status-button{background:var(--accent-primary);border:1px solid var(--accent-primary);color:#fff;font-weight:800;padding:.5rem .7rem}.filters,.project-filters{display:flex;flex-wrap:wrap;gap:.4rem}.filters button,.project-filters label{background:var(--background-primary);border:1px solid var(--border-default);color:var(--text-primary);padding:.38rem .58rem}.filters button.is-selected{background:var(--accent-primary);color:#fff}.project-filters{margin-bottom:.8rem}.project-filters label{align-items:center;display:flex;font-size:.74rem}.task{align-items:start;border-top:1px solid var(--border-default);display:grid;gap:1rem;grid-template-columns:minmax(0,1fr) auto;padding:.85rem 0}.task:first-child{border-top:0}.task h3{font-size:.95rem;margin:0 0 .25rem}.task p{color:var(--text-secondary);font-size:.78rem;margin:.25rem 0;white-space:pre-wrap}.task-meta{display:flex;flex-wrap:wrap;gap:.35rem}.badge{background:var(--background-secondary);border:1px solid var(--border-default);font-size:.7rem;padding:.18rem .38rem}.task-actions{align-items:end;display:grid;gap:.4rem;min-width:9rem}.task-actions select{font-size:.78rem}.approval-link{color:var(--accent-primary);font-size:.76rem;font-weight:800}.empty{color:var(--text-secondary)}@media(max-width:850px){.create-grid{grid-template-columns:1fr 1fr}.section-head{align-items:start;flex-direction:column}.task{grid-template-columns:1fr}.task-actions{align-items:stretch}}@media(max-width:540px){.member-tasks{padding:0 .8rem 3rem}.create-grid{grid-template-columns:1fr}.actions{align-items:stretch;flex-direction:column}.actions button{width:100%}}
</style>
<script>
  type Project={id:string;name:string;role:string};type Member={project_id:string;email:string;display_name:string};type Task={id:string;project_id:string;subject?:string|null;assignee_email?:string|null;title:string;details?:string;status:string;due_at?:string|null;due_timezone?:string;created_by:string};type Data={scope?:{email:string};projects?:Project[];members?:Member[];tasks?:Task[];error?:string};
  const initialize=()=>{const root=document.querySelector<HTMLElement>('[data-member-tasks]');if(!root||root.dataset.ready)return;root.dataset.ready='true';const get=<T extends Element>(selector:string)=>root.querySelector<T>(selector)!;const list=get<HTMLElement>('[data-list]'),projectSelect=get<HTMLSelectElement>('[data-project]'),assigneeSelect=get<HTMLSelectElement>('[data-assignee]'),message=get<HTMLOutputElement>('[data-message]');let data:Data={},filter='assigned';
    const escape=(value:unknown)=>String(value??'').replace(/[&<>"']/g,character=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[character]??character));const projectMap=()=>new Map((data.projects??[]).map(project=>[project.id,project]));const visibleProjects=()=>new Set([...root.querySelectorAll<HTMLInputElement>('[data-project-filter]:checked')].map(input=>input.value));
    const updateAssignees=()=>{const members=(data.members??[]).filter(member=>member.project_id===projectSelect.value);assigneeSelect.innerHTML='<option value="">担当者を指定しない</option>'+members.map(member=>`<option value="${escape(member.email)}">${escape(member.display_name)}</option>`).join('')};
    const render=()=>{const email=data.scope?.email??'',projects=projectMap(),allowed=visibleProjects();const rows=(data.tasks??[]).filter(task=>allowed.has(task.project_id)&&(filter==='all'||filter==='assigned'&&task.assignee_email===email||filter==='created'&&task.created_by===email));list.innerHTML=rows.length?rows.map(task=>{const project=projects.get(task.project_id);let approvalLink='';if(task.subject==='project-profile-change'&&project?.role==='manager'){approvalLink=task.project_id==='atlas'?'<a class="approval-link" href="/admin/profile-requests/?section=atlas" aria-label="メンバー情報の承認を開く">メンバー情報の承認 →</a>':`<a class="approval-link" href="/admin/project-profile-requests/?project=${encodeURIComponent(task.project_id)}" aria-label="運営内自己紹介の承認を開く">運営内自己紹介の承認 →</a>`}else if(task.subject==='member-profile-change'&&project?.role==='manager'){approvalLink='<a class="approval-link" href="/admin/profile-requests/" aria-label="メンバー情報の承認を開く">メンバー情報の承認 →</a>'}return `<article class="task"><div><h3>${escape(task.title)}</h3><div class="task-meta"><span class="badge">${escape(project?.name??task.project_id)}</span><span class="badge">${task.status==='open'?'未着手':task.status==='doing'?'進行中':'完了'}</span>${task.assignee_email?`<span class="badge">担当: ${escape((data.members??[]).find(member=>member.email===task.assignee_email&&member.project_id===task.project_id)?.display_name??task.assignee_email)}</span>`:''}</div>${task.details?`<p>${escape(task.details)}</p>`:''}${task.due_at?`<p>期限: ${escape(new Date(task.due_at).toLocaleString('ja-JP'))} (${escape(task.due_timezone)})</p>`:''}${approvalLink}</div><div class="task-actions"><select data-task-status="${escape(task.id)}"><option value="open" ${task.status==='open'?'selected':''}>未着手</option><option value="doing" ${task.status==='doing'?'selected':''}>進行中</option><option value="done" ${task.status==='done'?'selected':''}>完了</option></select><button type="button" class="status-button" data-save-status="${escape(task.id)}">状態を保存</button></div></article>`}).join(''):'<p class="empty">対象のタスクはありません。</p>'};
    const load=async()=>{const response=await fetch('/api/admin/member-tasks',{credentials:'same-origin',cache:'no-store'}),loaded=await response.json() as Data;if(!response.ok)throw new Error(loaded.error??'タスクを読み込めませんでした。');data=loaded;projectSelect.innerHTML=(data.projects??[]).map(project=>`<option value="${escape(project.id)}">${escape(project.name)}</option>`).join('');get<HTMLElement>('[data-project-filters]').innerHTML=(data.projects??[]).map(project=>`<label><input type="checkbox" data-project-filter value="${escape(project.id)}" checked />${escape(project.name)}</label>`).join('');updateAssignees();render()};
    projectSelect.addEventListener('change',updateAssignees);get<HTMLElement>('[data-project-filters]').addEventListener('change',render);root.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach(button=>button.addEventListener('click',()=>{filter=button.dataset.filter??'assigned';root.querySelectorAll('[data-filter]').forEach(item=>item.classList.toggle('is-selected',item===button));render()}));
    get<HTMLButtonElement>('[data-create]').addEventListener('click',async()=>{message.value='追加中…';const response=await fetch('/api/admin/operations/tasks',{method:'POST',credentials:'same-origin',headers:{'content-type':'application/json'},body:JSON.stringify({projectId:projectSelect.value,title:get<HTMLInputElement>('[data-title]').value,assigneeEmail:assigneeSelect.value,dueAt:get<HTMLInputElement>('[data-due]').value,dueTimezone:get<HTMLSelectElement>('[data-timezone]').value,details:get<HTMLTextAreaElement>('[data-details]').value})}),result=await response.json() as {error?:string};message.value=response.ok?'タスクを追加しました。':result.error??'追加できませんでした。';if(response.ok){get<HTMLInputElement>('[data-title]').value='';get<HTMLTextAreaElement>('[data-details]').value='';await load()}});
    list.addEventListener('click',async event=>{const button=(event.target as HTMLElement).closest<HTMLButtonElement>('[data-save-status]');if(!button)return;const id=button.dataset.saveStatus??'',status=list.querySelector<HTMLSelectElement>(`[data-task-status="${CSS.escape(id)}"]`)?.value;button.disabled=true;const response=await fetch(`/api/admin/operations/tasks/${encodeURIComponent(id)}`,{method:'PATCH',credentials:'same-origin',headers:{'content-type':'application/json'},body:JSON.stringify({status})}),result=await response.json() as {error?:string};message.value=response.ok?'状態を更新しました。':result.error??'更新できませんでした。';button.disabled=false;if(response.ok)await load()});
    void load().catch(error=>message.value=error instanceof Error?error.message:'読み込めませんでした。')};document.addEventListener('astro:page-load',initialize);initialize();
</script>
