---
import AdminLayout from "../../layouts/AdminLayout.astro";
---
<AdminLayout title="Atlasezメンバー用サイト" description="Atlasezの全プロジェクトへの入口">
  <main class="portal" data-portal>
    <header>
      <div>
        <h1 data-admin-i18n data-admin-ja="Atlasezメンバー用サイト" data-admin-en="Atlasez member site">Atlasezメンバー用サイト</h1>
        <span data-admin-i18n data-admin-ja="Atlasezの全プロジェクトを集約した入口です。各プロジェクトHomeから、それぞれの運営ワークスペースへ移動できます。" data-admin-en="One entry point for every Atlasez project. Open each project home to enter its workspace.">Atlasezの全プロジェクトを集約した入口です。各プロジェクトHomeから、それぞれの運営ワークスペースへ移動できます。</span>
      </div>
    </header>

    <section class="project-entry" aria-labelledby="projects-entry-heading">
      <div>
        <p class="section-kicker">PROJECTS</p>
        <h2 id="projects-entry-heading" data-admin-i18n data-admin-ja="主要プロジェクト" data-admin-en="Core projects">主要プロジェクト</h2>
        <span data-admin-i18n data-admin-ja="学習サイト、ゼミプラットフォーム、運営事務局をここから開けます。" data-admin-en="Open the learning site, seminar platform, or Secretariat from here.">学習サイト、ゼミプラットフォーム、運営事務局をここから開けます。</span>
      </div>
      <div class="project-entry-cards">
        <a class="project-entry-card" href="/admin/atlas/">
          <strong data-admin-i18n data-admin-ja="学習サイト「アトラス」運営" data-admin-en="Atlas learning site operations">学習サイト「アトラス」運営</strong>
          <small data-admin-i18n data-admin-ja="原稿、編集・査読、問題報告、進捗・ToDo・日程" data-admin-en="Articles, review, reports, progress, tasks and events">原稿、編集・査読、問題報告、進捗・ToDo・日程</small>
          <span data-admin-i18n data-admin-ja="学習サイト運営へ →" data-admin-en="Open learning site operations →">学習サイト運営へ →</span>
        </a>
        <a class="project-entry-card" href="/admin/secretariat/">
          <strong data-admin-i18n data-admin-ja="Atlasez運営事務局" data-admin-en="Atlasez Secretariat">Atlasez運営事務局</strong>
          <small data-admin-i18n data-admin-ja="事務局のToDo、依頼、日程調整、同時作業会" data-admin-en="Secretariat tasks, requests, scheduling and co-working">事務局のToDo、依頼、日程調整、同時作業会</small>
          <span data-admin-i18n data-admin-ja="事務局サイトへ →" data-admin-en="Open Secretariat →">事務局サイトへ →</span>
        </a>
        <a class="project-entry-card" href="/admin/semi-platform/">
          <strong data-admin-i18n data-admin-ja="ゼミプラットフォーム" data-admin-en="Seminar platform">ゼミプラットフォーム</strong>
          <small data-admin-i18n data-admin-ja="ゼミの運営、依頼、日程調整、現行サイトへの導線" data-admin-en="Seminar operations, tasks, scheduling and the current site">ゼミの運営、依頼、日程調整、現行サイトへの導線</small>
          <span data-admin-i18n data-admin-ja="ゼミサイトへ →" data-admin-en="Open seminar platform →">ゼミサイトへ →</span>
        </a>
      </div>
    </section>

    <section class="management-entry" data-manager-only hidden aria-labelledby="management-entry-heading">
      <div>
        <p class="section-kicker">SECRETARIAT</p>
        <h2 id="management-entry-heading" data-admin-i18n data-admin-ja="運営内運営の管理" data-admin-en="Operator administration">運営内運営の管理</h2>
        <span data-admin-i18n data-admin-ja="運営者のログイン権限、担当分野、プロフィールを管理します。" data-admin-en="Manage operator access, subjects and profiles.">運営者のログイン権限、担当分野、プロフィールを管理します。</span>
      </div>
      <a href="/admin/permissions/" data-admin-i18n data-admin-ja="管理ページを開く →" data-admin-en="Open administration →">管理ページを開く →</a>
    </section>

    <div class="home-grid">
      <section class="home-section calendar-section">
        <div class="section-heading">
          <div><p class="section-kicker">EVENTS</p><h2 data-admin-i18n data-admin-ja="同時作業会・交流会の日程" data-admin-en="Co-working & social events">同時作業会・交流会の日程</h2><small data-admin-i18n data-admin-ja="参加中のプロジェクトの日程" data-admin-en="Events from your projects">参加中のプロジェクトの日程</small><small class="calendar-timezone-note" data-calendar-timezone-note></small></div>
          <a href="/admin/co-working/" data-admin-i18n data-admin-ja="日程を見る" data-admin-en="View events">日程を見る</a>
        </div>
        <div class="calendar-toolbar" role="group" aria-label="カレンダー操作"><div class="calendar-nav"><button type="button" data-calendar-prev aria-label="前の月">‹</button><button type="button" class="calendar-today" data-calendar-today data-admin-i18n data-admin-ja="今月" data-admin-en="This month">今月</button><button type="button" data-calendar-next aria-label="次の月">›</button></div><div class="calendar-heading"><strong data-calendar-title>読み込み中…</strong><small data-calendar-range></small></div><div class="calendar-view-switch" role="group" aria-label="カレンダー表示"><button type="button" data-calendar-view="agenda" class="is-selected" aria-pressed="true" data-admin-i18n data-admin-ja="今日" data-admin-en="Today">今日</button><button type="button" data-calendar-view="month" aria-pressed="false" data-admin-i18n data-admin-ja="月" data-admin-en="Month">月</button></div></div>
        <div class="calendar-filters" role="group" aria-label="カレンダー表示対象"><span class="calendar-filter-label" data-admin-i18n data-admin-ja="表示対象" data-admin-en="Showing">表示対象</span><label><input type="checkbox" data-calendar-source="organization" checked /> <span data-admin-i18n data-admin-ja="同時作業会・交流会" data-admin-en="Co-working & socials">同時作業会・交流会</span></label></div>
        <div class="calendar-agenda" data-calendar-agenda aria-live="polite"></div>
        <div class="portal-calendar-wrap" hidden><div class="portal-calendar" data-portal-calendar role="grid" aria-label="カレンダー"></div></div>
        <div class="calendar-upcoming" data-calendar-upcoming aria-live="polite"></div>
      </section>
      <section class="home-section">
        <div class="section-heading">
          <div><p class="section-kicker">MY TASKS</p><h2 data-admin-i18n data-admin-ja="自分の未完了ToDo" data-admin-en="My open tasks">自分の未完了ToDo</h2></div>
          <a href="/admin/operations/" data-admin-i18n data-admin-ja="ToDoを開く" data-admin-en="Open tasks">ToDoを開く</a>
        </div>
        <div data-todos>読み込み中…</div>
      </section>
    </div>
  </main>
</AdminLayout>
<style>
  .portal { margin: 0 auto; max-width: 1200px; padding: 0 1.25rem 4rem; }
  .portal > header { border-bottom: 1px solid var(--border-default); display: flex; gap: 1rem; justify-content: space-between; padding: 2.1rem 0 1.3rem; }
  .portal > header p, .section-kicker { color: var(--accent-primary); font-size: .72rem; font-weight: 800; letter-spacing: .1em; margin: 0; }
  .portal h1 { font-size: clamp(2rem, 4vw, 2.7rem); letter-spacing: -.04em; margin: .25rem 0; }
  .portal > header span, .portal small { color: var(--text-secondary); line-height: 1.6; }
  .project-entry { align-items: center; border: 1px solid var(--border-default); display: grid; gap: 1rem; grid-template-columns: minmax(0, 1fr) minmax(24rem, 1.4fr); margin: 1.5rem 0; padding: 1.25rem; }
  .project-entry h2 { font-size: 1.2rem; margin: .25rem 0; }
  .project-entry > div > span { color: var(--text-secondary); font-size: .82rem; line-height: 1.6; }
  .project-entry-cards { display: grid; gap: .65rem; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .project-entry-card { align-content: start; background: var(--background-secondary); border: 1px solid var(--border-default); border-top: 3px solid var(--accent-primary); box-sizing: border-box; color: var(--text-primary); display: grid; gap: .35rem; min-height: 8.4rem; min-width: 0; overflow-wrap: anywhere; padding: 1rem; text-decoration: none; }
  .project-entry-card:hover { border-color: var(--accent-primary); transform: translateY(-1px); }
  .project-entry-card strong { font-size: .95rem; }
  .project-entry-card small { font-size: .76rem; }
  .project-entry-card span { color: var(--accent-primary); font-size: .76rem; font-weight: 800; margin-top: .25rem; }
  .management-entry { align-items: center; background: var(--background-secondary); border: 1px solid var(--border-default); display: grid; gap: 1rem; grid-template-columns: minmax(0, 1fr) auto; margin: 1rem 0; padding: .95rem 1.1rem; }
  .management-entry h2 { font-size: 1rem; margin: .2rem 0; }
  .management-entry > div > span { color: var(--text-secondary); font-size: .78rem; line-height: 1.5; }
  .management-entry > a { color: var(--accent-primary); font-size: .78rem; font-weight: 800; text-decoration: none; white-space: nowrap; }
  .home-grid { align-items: start; display: grid; gap: 1rem; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .home-section { border: 1px solid var(--border-default); border-radius: .7rem; min-width: 0; padding: 1rem; }
  .calendar-section { min-width: 0; }
  .section-heading { align-items: start; border-bottom: 1px solid var(--border-default); display: flex; gap: .7rem; justify-content: space-between; margin-bottom: .7rem; padding-bottom: .65rem; }
  .section-heading h2 { font-size: 1.1rem; margin: .2rem 0 0; }
  .section-heading a { color: var(--accent-primary); font-size: .75rem; font-weight: 800; text-decoration: none; white-space: nowrap; }
  .cards { display: grid; gap: .7rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); }
  .card, .todo { box-sizing: border-box; min-width: 0; overflow-wrap: anywhere; }
  .card { align-content: start; background: var(--background-secondary); border: 1px solid var(--border-default); display: grid; gap: .42rem; min-height: 8.5rem; padding: .85rem; }
  .card b, .card small, .card a { min-width: 0; overflow-wrap: anywhere; }
  .card b { line-height: 1.4; }
  .card small { color: var(--text-secondary); line-height: 1.5; }
  .card a { align-self: end; color: var(--accent-primary); font-size: .82rem; font-weight: 800; margin-top: .2rem; text-decoration: none; }
  .todo { border-left: 3px solid var(--accent-primary); margin: .45rem 0; }
  .empty { color: var(--text-secondary); font-size: .82rem; }
  .calendar-toolbar { align-items: center; display: flex; gap: .8rem; justify-content: space-between; margin: .15rem 0 .7rem; }
  .calendar-nav { align-items: center; display: flex; gap: .3rem; }
  .calendar-toolbar button { align-items: center; background: var(--background-primary); border: 1px solid var(--border-default); border-radius: .45rem; color: var(--text-primary); cursor: pointer; display: inline-flex; font: inherit; font-size: 1.15rem; height: 2.35rem; justify-content: center; line-height: 1; min-width: 2.35rem; padding: .25rem .55rem; }
  .calendar-toolbar button:hover { border-color: var(--accent-primary); color: var(--accent-primary); }
  .calendar-toolbar .calendar-today { font-size: .74rem; font-weight: 800; min-width: 3.5rem; }
  .calendar-heading { display: grid; gap: .1rem; min-width: 0; text-align: right; }
  .calendar-heading strong { font-size: 1rem; }
  .calendar-heading small { color: var(--text-secondary); font-size: .68rem; }
  .calendar-view-switch { background: var(--background-secondary); border: 1px solid var(--border-default); border-radius: .5rem; display: inline-flex; gap: .15rem; padding: .15rem; }
  .calendar-view-switch button { border: 0; font-size: .72rem; height: 1.95rem; min-width: 2.8rem; padding: .25rem .5rem; }
  .calendar-view-switch button.is-selected { background: var(--background-primary); box-shadow: 0 1px 3px rgb(24 32 39 / .12); color: var(--accent-primary); }
  .calendar-filters { align-items: center; display: flex; flex-wrap: wrap; gap: .45rem; margin-bottom: .7rem; }
  .calendar-filter-label { color: var(--text-secondary); font-size: .7rem; font-weight: 800; margin-right: .1rem; }
  .calendar-filters label { align-items: center; background: var(--background-secondary); border: 1px solid var(--border-default); border-radius: 999px; color: var(--text-secondary); cursor: pointer; display: inline-flex; font-size: .72rem; gap: .25rem; padding: .3rem .55rem; }
  .calendar-filters input { accent-color: var(--accent-primary); margin: 0; }
  .calendar-agenda { display: grid; gap: .75rem; grid-template-columns: repeat(2, minmax(0, 1fr)); margin-bottom: .75rem; }
  .calendar-section .calendar-agenda { grid-template-columns: 1fr; }
  .calendar-agenda[hidden], .portal-calendar-wrap[hidden], .calendar-upcoming[hidden] { display: none; }
  .calendar-agenda-section { background: var(--background-secondary); border: 1px solid var(--border-default); border-radius: .55rem; min-width: 0; padding: .8rem; }
  .calendar-agenda-section h3 { color: var(--text-primary); font-size: .78rem; margin: 0 0 .55rem; }
  .calendar-agenda-list { display: grid; gap: .4rem; }
  .calendar-agenda-item { align-items: start; background: var(--background-primary); border-left: 3px solid var(--accent-primary); border-radius: .35rem; color: var(--text-primary); display: grid; gap: .6rem; grid-template-columns: 3.8rem minmax(0, 1fr); padding: .55rem .6rem; text-decoration: none; }
  .calendar-agenda-item.is-personal { border-left-color: #a66a00; }
  .calendar-agenda-item:hover { box-shadow: 0 2px 8px rgb(24 32 39 / .1); transform: translateY(-1px); }
  .calendar-agenda-time { color: var(--accent-primary); font-size: .72rem; font-variant-numeric: tabular-nums; font-weight: 800; }
  .calendar-agenda-item.is-personal .calendar-agenda-time { color: #a66a00; }
  .calendar-agenda-copy { display: grid; gap: .12rem; min-width: 0; }
  .calendar-agenda-copy b { font-size: .78rem; line-height: 1.4; overflow-wrap: anywhere; }
  .calendar-agenda-copy small { color: var(--text-secondary); font-size: .67rem; line-height: 1.4; overflow-wrap: anywhere; }
  .calendar-agenda-empty { color: var(--text-secondary); font-size: .75rem; margin: 0; }
  .portal-calendar-wrap { overflow-x: auto; }
  .portal-calendar { background: var(--border-default); border: 1px solid var(--border-default); border-radius: .45rem; display: grid; gap: 1px; grid-template-columns: repeat(7, minmax(5.6rem, 1fr)); overflow: hidden; }
  .portal-calendar-cell { background: var(--background-primary); min-height: 7.2rem; min-width: 0; padding: .45rem; }
  .portal-calendar-cell.is-blank { background: var(--background-secondary); }
  .portal-calendar-cell.is-today { box-shadow: inset 0 0 0 2px var(--accent-primary); }
  .portal-calendar-cell.is-weekend { background: color-mix(in srgb, var(--background-secondary) 42%, var(--background-primary)); }
  .portal-calendar-weekday { background: var(--background-secondary); color: var(--text-secondary); font-size: .68rem; font-weight: 800; min-height: 2rem; padding: .4rem; text-align: center; }
  .portal-calendar-weekday.is-weekend { color: var(--accent-primary); }
  .portal-calendar-day { align-items: center; color: var(--text-secondary); display: flex; font-size: .78rem; font-weight: 800; justify-content: space-between; min-height: 1.35rem; }
  .portal-calendar-day.is-today { background: var(--accent-primary); border-radius: 999px; color: #fff; justify-content: center; margin: -.1rem auto .2rem; width: 1.5rem; }
  .portal-calendar-events { display: grid; gap: .25rem; margin-top: .25rem; }
  .portal-calendar-event { background: color-mix(in srgb, var(--accent-primary) 10%, var(--background-primary)); border-left: 3px solid var(--accent-primary); border-radius: .25rem; display: block; font-size: .66rem; line-height: 1.35; overflow: hidden; padding: .25rem .3rem; text-overflow: ellipsis; white-space: nowrap; }
  .portal-calendar-event.is-personal { background: color-mix(in srgb, #a66a00 10%, var(--background-primary)); border-left-color: #a66a00; }
  .portal-calendar-more { color: var(--text-secondary); font-size: .64rem; font-weight: 800; padding: .1rem .25rem; }
  .calendar-upcoming { border-top: 1px solid var(--border-default); display: grid; gap: .4rem; margin-top: .85rem; padding-top: .75rem; }
  .calendar-upcoming:empty { display: none; }
  .calendar-upcoming-heading { color: var(--text-secondary); font-size: .7rem; font-weight: 800; }
  .calendar-upcoming-item { border-left: 3px solid var(--accent-primary); border-radius: .25rem; color: var(--text-primary); display: grid; gap: .1rem; padding: .35rem .5rem; text-decoration: none; }
  .calendar-upcoming-item:hover { background: var(--background-secondary); }
  .calendar-upcoming-item.is-personal { border-left-color: #a66a00; }
  .calendar-upcoming-item b { font-size: .76rem; }
  .calendar-upcoming-item small { font-size: .67rem; }
  @media (max-width: 800px) {
    .portal { padding: 0 .8rem 3rem; }
    .project-entry { align-items: start; grid-template-columns: 1fr; padding: .9rem; }
    .project-entry-cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .home-grid { grid-template-columns: 1fr; }
    .management-entry { align-items: start; grid-template-columns: 1fr; }
  }
  @media (max-width: 520px) {
    .project-entry-cards { grid-template-columns: 1fr; }
    .calendar-toolbar { align-items: flex-start; flex-wrap: wrap; }
    .calendar-heading { order: -1; text-align: left; width: calc(100% - 1rem); }
    .calendar-agenda { grid-template-columns: 1fr; }
    .calendar-filter-label { flex-basis: 100%; }
    .portal-calendar { grid-template-columns: repeat(7, minmax(3.6rem, 1fr)); }
    .portal-calendar-cell { min-height: 5.3rem; padding: .25rem; }
    .portal-calendar-event { font-size: .58rem; padding: .2rem .22rem; }
  }
</style>
<script>
  type PortalTodo = { project_id: string; subject?: string | null; title: string; details?: string | null; status: string };
  type PortalCalendarEvent = { id: string; kind: 'organization' | 'personal'; title: string; details?: string | null; startsAt: string; endsAt?: string | null; timezone: string; projectName: string };
  type PortalData = { todos?: PortalTodo[]; calendar?: { rangeStart?: string; rangeEnd?: string; events?: PortalCalendarEvent[] }; error?: string };
  const initializePortal = () => {
    const root = document.querySelector<HTMLElement>('[data-portal]');
    if (!root || root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';
    const calendar = root.querySelector<HTMLElement>('[data-portal-calendar]')!;
    const calendarAgenda = root.querySelector<HTMLElement>('[data-calendar-agenda]')!;
    const calendarTitle = root.querySelector<HTMLElement>('[data-calendar-title]')!;
    const calendarRange = root.querySelector<HTMLElement>('[data-calendar-range]')!;
    const calendarUpcoming = root.querySelector<HTMLElement>('[data-calendar-upcoming]')!;
    const timezoneNote = root.querySelector<HTMLElement>('[data-calendar-timezone-note]')!;
    const todosView = root.querySelector<HTMLElement>('[data-todos]')!;
    const sourceInputs = [...root.querySelectorAll<HTMLInputElement>('[data-calendar-source]')];
    const escapeHtml = (value: string) => value.replace(/[&<>"']/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[character] ?? character);
    type PortalLanguage = 'ja' | 'en';
    const getLanguage = (): PortalLanguage => localStorage.getItem('atlasez-admin-language') === 'en' ? 'en' : 'ja';
    const copy = {
      ja: { noTodos: '未完了のToDoはありません。', status: '状態', today: '今日の予定', noEvents: 'この月の予定はありません。', noTodayEvents: '今日の予定はありません。', upcoming: '近日の予定', next: '次の予定', personal: '自分の期限', organization: '同時作業会・交流会', timezone: '表示タイムゾーン', continued: '継続中' },
      en: { noTodos: 'There are no open tasks.', status: 'Status', today: "Today's schedule", noEvents: 'There are no events this month.', noTodayEvents: 'There are no events today.', upcoming: 'Upcoming', next: 'Next', personal: 'My deadline', organization: 'Co-working & social event', timezone: 'Time zone', continued: 'Ongoing' },
    } as const;
    let portalData: PortalData | null = null;
    let month = new Date(new Date().getFullYear(), new Date().getMonth(), 1);
    let calendarView: 'agenda' | 'month' = 'agenda';
    const timezone = () => Intl.DateTimeFormat().resolvedOptions().timeZone || 'Asia/Tokyo';
    const dateParts = (value: Date | string, options: Intl.DateTimeFormatOptions = {}) => {
      try {
        const parts = new Intl.DateTimeFormat('en-US', { timeZone: timezone(), year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', hourCycle: 'h23', ...options }).formatToParts(new Date(value));
        return Object.fromEntries(parts.filter((part) => part.type !== 'literal').map((part) => [part.type, part.value]));
      } catch { return {}; }
    };
    const dateKey = (value: string) => { const parts = dateParts(value); return `${parts.year ?? ''}-${parts.month ?? ''}-${parts.day ?? ''}`; };
    const formatDate = (value: string) => new Intl.DateTimeFormat(getLanguage() === 'ja' ? 'ja-JP' : 'en-US', { dateStyle: 'medium', timeStyle: 'short', timeZone: timezone() }).format(new Date(value));
    const eventDateKeys = (event: PortalCalendarEvent) => {
      const start = new Date(event.startsAt);
      const end = new Date(event.endsAt || event.startsAt);
      if (Number.isNaN(start.getTime()) || Number.isNaN(end.getTime())) return [dateKey(event.startsAt)];
      const startKey = dateKey(start.toISOString());
      const endKey = dateKey(end.toISOString());
      const [startYear, startMonth, startDay] = startKey.split('-').map(Number);
      const [endYear, endMonth, endDay] = endKey.split('-').map(Number);
      const cursor = new Date(Date.UTC(startYear, startMonth - 1, startDay));
      const finish = new Date(Date.UTC(endYear, endMonth - 1, endDay));
      const keys: string[] = [];
      for (let index = 0; cursor <= finish && index < 62; index += 1) {
        keys.push(cursor.toISOString().slice(0, 10));
        cursor.setUTCDate(cursor.getUTCDate() + 1);
      }
      return keys;
    };
    const enabledKinds = () => new Set(sourceInputs.filter((input) => input.checked).map((input) => input.dataset.calendarSource));
    const visibleEvents = () => (portalData?.calendar?.events ?? []).filter((event) => enabledKinds().has(event.kind));
    const eventSort = (left: PortalCalendarEvent, right: PortalCalendarEvent) => new Date(left.startsAt).getTime() - new Date(right.startsAt).getTime();
    const eventCard = (event: PortalCalendarEvent, language: PortalLanguage) => {
      const parts = dateParts(event.startsAt);
      const time = parts.hour && parts.minute ? `${parts.hour}:${parts.minute}` : '—';
      const kind = event.kind === 'personal' ? copy[language].personal : copy[language].organization;
      const href = event.kind === 'organization' ? '/admin/co-working/' : '/admin/operations/';
      return `<a class="calendar-agenda-item${event.kind === 'personal' ? ' is-personal' : ''}" href="${href}"><span class="calendar-agenda-time">${escapeHtml(time)}</span><span class="calendar-agenda-copy"><b>${escapeHtml(event.title)}</b><small>${escapeHtml(kind)} / ${escapeHtml(event.projectName)} ・ ${escapeHtml(formatDate(event.startsAt))}</small></span></a>`;
    };
    const renderAgenda = (events: PortalCalendarEvent[], language: PortalLanguage) => {
      const today = dateKey(new Date().toISOString());
      const todayEvents = events.filter((event) => eventDateKeys(event).includes(today)).sort(eventSort);
      const todayIds = new Set(todayEvents.map((event) => event.id));
      const nextEvents = events.filter((event) => !todayIds.has(event.id) && new Date(event.startsAt).getTime() >= Date.now()).sort(eventSort).slice(0, 5);
      calendarTitle.textContent = new Intl.DateTimeFormat(language === 'ja' ? 'ja-JP' : 'en-US', { dateStyle: 'full', timeZone: timezone() }).format(new Date());
      calendarRange.textContent = `${todayEvents.length}${language === 'ja' ? '件' : ' events'}`;
      calendarAgenda.innerHTML = `<section class="calendar-agenda-section"><h3>${copy[language].today}</h3><div class="calendar-agenda-list">${todayEvents.length ? todayEvents.map((event) => eventCard(event, language)).join('') : `<p class="calendar-agenda-empty">${copy[language].noTodayEvents}</p>`}</div></section><section class="calendar-agenda-section"><h3>${copy[language].next}</h3><div class="calendar-agenda-list">${nextEvents.length ? nextEvents.map((event) => eventCard(event, language)).join('') : `<p class="calendar-agenda-empty">${copy[language].noEvents}</p>`}</div></section>`;
      calendarAgenda.hidden = false;
      calendar.parentElement?.toggleAttribute('hidden', true);
      calendarUpcoming.hidden = true;
    };
    const renderCalendar = () => {
      const language = getLanguage();
      const events = visibleEvents();
      timezoneNote.textContent = `${copy[language].timezone}: ${timezone()}`;
      if (calendarView === 'agenda') { renderAgenda(events, language); return; }
      calendarAgenda.hidden = true;
      calendar.parentElement?.toggleAttribute('hidden', false);
      calendarUpcoming.hidden = false;
      const formatter = new Intl.DateTimeFormat(language === 'ja' ? 'ja-JP' : 'en-US', { year: 'numeric', month: 'long' });
      calendarTitle.textContent = formatter.format(month);
      const headings = (language === 'ja' ? ['日', '月', '火', '水', '木', '金', '土'] : ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat']).map((day, index) => `<div class="portal-calendar-cell portal-calendar-weekday${index === 0 || index === 6 ? ' is-weekend' : ''}" role="columnheader">${day}</div>`);
      const firstDay = new Date(month.getFullYear(), month.getMonth(), 1).getDay();
      const lastDay = new Date(month.getFullYear(), month.getMonth() + 1, 0).getDate();
      const today = dateKey(new Date().toISOString());
      calendarRange.textContent = `${events.length}${language === 'ja' ? '件' : ' events'}`;
      const cells = [...headings];
      for (let index = 0; index < firstDay; index += 1) cells.push('<div class="portal-calendar-cell is-blank"></div>');
      for (let day = 1; day <= lastDay; day += 1) {
        const key = `${month.getFullYear()}-${String(month.getMonth() + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
        const dayEvents = events.filter((event) => eventDateKeys(event).includes(key));
        const visibleDayEvents = dayEvents.slice(0, 3);
        const eventMarkup = visibleDayEvents.map((event) => { const parts = dateParts(event.startsAt); const kind = event.kind === 'personal' ? copy[language].personal : copy[language].organization; const isStartDay = dateKey(event.startsAt) === key; const time = isStartDay && parts.hour && parts.minute ? `${parts.hour}:${parts.minute}` : copy[language].continued; return `<span class="portal-calendar-event${event.kind === 'personal' ? ' is-personal' : ''}" title="${escapeHtml(`${kind} / ${event.projectName} / ${event.title}`)}">${escapeHtml(`${time} ${event.title}`)}</span>`; }).join('');
        const more = dayEvents.length > visibleDayEvents.length ? `<span class="portal-calendar-more">+${dayEvents.length - visibleDayEvents.length}件</span>` : '';
        const weekday = new Date(month.getFullYear(), month.getMonth(), day).getDay();
        cells.push(`<div class="portal-calendar-cell${today === key ? ' is-today' : ''}${weekday === 0 || weekday === 6 ? ' is-weekend' : ''}" role="gridcell" aria-label="${escapeHtml(key)}"><span class="portal-calendar-day${today === key ? ' is-today' : ''}">${day}</span><div class="portal-calendar-events">${eventMarkup}${more}</div></div>`);
      }
      calendar.innerHTML = cells.join('');
      const upcoming = events.filter((event) => new Date(event.startsAt).getTime() >= Date.now()).sort((a, b) => new Date(a.startsAt).getTime() - new Date(b.startsAt).getTime()).slice(0, 5);
      calendarUpcoming.innerHTML = upcoming.length ? `<small class="calendar-upcoming-heading">${copy[language].upcoming}</small>${upcoming.map((event) => `<a class="calendar-upcoming-item${event.kind === 'personal' ? ' is-personal' : ''}" href="/admin/operations/"><b>${escapeHtml(event.title)}</b><small>${escapeHtml(event.kind === 'personal' ? copy[language].personal : copy[language].organization)} / ${escapeHtml(event.projectName)} ・ ${escapeHtml(formatDate(event.startsAt))}</small></a>`).join('')}` : `<small class="empty">${copy[language].noEvents}</small>`;
    };
    const renderTodos = (data: PortalData) => { const language = getLanguage(); const todos = data.todos ?? []; todosView.innerHTML = todos.length ? todos.map((todo) => `<article class="todo"><b>${escapeHtml(todo.title)}</b><small>${escapeHtml(todo.project_id)}${todo.subject ? ` / ${escapeHtml(todo.subject)}` : ''} ・ ${copy[language].status}: ${escapeHtml(todo.status)}</small>${todo.details ? `<small>${escapeHtml(todo.details)}</small>` : ''}</article>`).join('') : `<p class="empty">${copy[language].noTodos}</p>`; };
    const renderPortal = (data: PortalData) => { renderCalendar(); renderTodos(data); };
    const setCalendarView = (view: 'agenda' | 'month') => {
      calendarView = view;
      root.querySelectorAll<HTMLButtonElement>('[data-calendar-view]').forEach((item) => {
        const selected = item.dataset.calendarView === view;
        item.classList.toggle('is-selected', selected);
        item.setAttribute('aria-pressed', String(selected));
      });
    };
    sourceInputs.forEach((input) => input.addEventListener('change', renderCalendar));
    root.querySelectorAll<HTMLButtonElement>('[data-calendar-view]').forEach((button) => button.addEventListener('click', () => {
      setCalendarView(button.dataset.calendarView === 'month' ? 'month' : 'agenda');
      renderCalendar();
    }));
    root.querySelector<HTMLButtonElement>('[data-calendar-prev]')!.addEventListener('click', () => { setCalendarView('month'); month = new Date(month.getFullYear(), month.getMonth() - 1, 1); renderCalendar(); });
    root.querySelector<HTMLButtonElement>('[data-calendar-today]')!.addEventListener('click', () => { setCalendarView('month'); const now = new Date(); month = new Date(now.getFullYear(), now.getMonth(), 1); renderCalendar(); });
    root.querySelector<HTMLButtonElement>('[data-calendar-next]')!.addEventListener('click', () => { setCalendarView('month'); month = new Date(month.getFullYear(), month.getMonth() + 1, 1); renderCalendar(); });
    document.addEventListener('atlasez-admin-language-change', () => { if (portalData) renderPortal(portalData); });
    void fetch('/api/admin/portal', { credentials: 'same-origin', cache: 'no-store' }).then(async (response) => {
      const contentType = response.headers.get('content-type') ?? '';
      const data = contentType.includes('application/json') ? await response.json() as PortalData : null;
      if (!response.ok || !data) throw new Error(data?.error ?? '認証情報を確認できませんでした。ページを再読み込みしてください。');
      portalData = data;
      renderPortal(data);
    }).catch((error) => {
      const message = error instanceof Error ? error.message : 'Homeを読み込めませんでした。';
      calendar.textContent = message;
      todosView.textContent = message;
    });
  };
  document.addEventListener('astro:page-load', initializePortal);
  initializePortal();
</script>
