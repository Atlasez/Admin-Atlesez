---
import AdminLayout from "../../layouts/AdminLayout.astro";
import AdminNav from "../../components/AdminNav.astro";
import AdminBreadcrumb from "../../components/AdminBreadcrumb.astro";
---

<AdminLayout title="Atlasezメンバー用サイト" description="Atlasezのプロジェクトを横断して確認するホーム">
  <main class="member-home" data-member-home>
    <AdminNav current="portal" />
    <AdminBreadcrumb items={[{ label: "メンバー用サイト" }]} />
    <header class="home-heading">
      <p class="eyebrow">ATLASEZ / MEMBERS</p>
      <h1>Home</h1>
      <p>参加しているプロジェクトを選択し、それぞれの活動ページへ移動できます。</p>
    </header>
    <section class="projects-section" aria-labelledby="projects-heading">
      <div class="section-heading"><div><p class="eyebrow">PROJECTS</p><h2 id="projects-heading">参加中のプロジェクト</h2></div></div>
      <div class="project-list" data-projects><span class="loading">プロジェクトを読み込んでいます…</span></div>
    </section>
    <section class="tasks-section" aria-labelledby="tasks-heading">
      <div class="section-heading"><div><p class="eyebrow">MY TASKS</p><h2 id="tasks-heading">自分の未完了タスク</h2><p>複数のプロジェクトに割り当てられたタスクをまとめて確認できます。</p></div></div>
      <div class="task-list" data-todos><span class="loading">タスクを読み込んでいます…</span></div>
    </section>
  </main>
</AdminLayout>

<style>
  .member-home{box-sizing:border-box;margin:0 auto;max-width:1100px;min-width:0;padding:0 1.25rem 4rem}.home-heading{border-bottom:1px solid var(--border-default);margin:0 auto;min-width:0;padding:2.7rem 0 1.6rem;width:min(100%,64rem)}.eyebrow{color:var(--accent-primary);font-size:.72rem;font-weight:800;letter-spacing:.1em;margin:0 0 .35rem}.home-heading h1{font-size:clamp(2rem,4vw,2.8rem);letter-spacing:-.04em;margin:0}.home-heading>p:last-child{color:var(--text-secondary);font-size:.95rem;line-height:1.6;margin:.55rem 0 0}.projects-section,.tasks-section{margin:1.5rem auto 0;min-width:0;width:min(100%,64rem)}.section-heading{align-items:end;border-bottom:1px solid var(--border-default);display:flex;justify-content:space-between;padding-bottom:.7rem}.section-heading h2{font-size:1.2rem;margin:.2rem 0 0}.section-heading p:last-child{color:var(--text-secondary);font-size:.82rem;line-height:1.55;margin:.35rem 0 0}.project-list{display:grid;gap:.75rem;grid-template-columns:repeat(auto-fit,minmax(min(18rem,100%),1fr));margin-top:.85rem;min-width:0}.project-card{background:var(--background-secondary);border:1px solid var(--border-default);border-top:3px solid var(--accent-primary);box-sizing:border-box;color:var(--text-primary);display:grid;gap:.35rem;min-height:4.6rem;min-width:0;overflow:hidden;padding:1rem;text-decoration:none;transition:border-color .15s,transform .15s}.project-card:hover,.project-card:focus-visible{border-color:var(--accent-primary);transform:translateY(-1px)}.project-title{color:var(--text-primary);display:block;font-size:1.12rem;font-weight:800;line-height:1.35;min-width:0;overflow-wrap:anywhere;text-decoration:none}.project-card:hover .project-title,.project-card:focus-visible .project-title{color:var(--accent-primary);text-decoration:underline;text-underline-offset:.16em}.task-list{display:grid;gap:.55rem;margin-top:.85rem;min-width:0}.task-card{border:1px solid var(--border-default);border-left:3px solid var(--accent-primary);box-sizing:border-box;display:grid;gap:.25rem;min-width:0;overflow-wrap:anywhere;padding:.7rem .8rem}.task-card b{font-size:.88rem}.task-card small{color:var(--text-secondary);font-size:.75rem;line-height:1.5}.loading,.empty{color:var(--text-secondary);font-size:.82rem;padding:1rem 0}.empty{border:1px dashed var(--border-default);padding:.9rem}.task-project{color:var(--accent-primary);font-weight:800}@media(max-width:700px){.member-home{padding:0 .85rem 3rem}.home-heading{padding:2rem 0 1.3rem}.project-list{grid-template-columns:1fr}}
</style>

<script>
  type PortalProject={id:string;slug:string;name:string;description?:string|null};
  type PortalTodo={project_id:string;subject?:string|null;title:string;details?:string|null;status:string;due_at?:string|null;due_timezone?:string|null;project_name?:string|null};

  const initializeMemberHome=()=>{
    const root=document.querySelector<HTMLElement>('[data-member-home]');
    if(!root||root.dataset.initialized==='true')return;
    root.dataset.initialized='true';
    const projectsView=root.querySelector<HTMLElement>('[data-projects]')!;
    const todosView=root.querySelector<HTMLElement>('[data-todos]')!;
    const esc=(value:string)=>value.replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]??c));
    const projectHref=(slug:string)=>slug==='atlas'?'/admin/atlas/':`/admin/projects/${encodeURIComponent(slug)}/`;
    const load=async()=>{
      try{
        const response=await fetch('/api/admin/portal',{credentials:'same-origin',cache:'no-store'});
        const type=response.headers.get('content-type')??'';
        const data=type.includes('application/json')?await response.json() as {projects?:PortalProject[];todos?:PortalTodo[];error?:string}:null;
        if(!response.ok||!data)throw new Error(data?.error??'Homeを読み込めませんでした。');
        const projects=data.projects??[];
        projectsView.innerHTML=projects.length?projects.map(project=>`<a class="project-card" href="${projectHref(project.slug)}" aria-label="${esc(project.name)}"><span class="project-title">${esc(project.name)}</span></a>`).join(''):'<p class="empty">参加中のプロジェクトはありません。</p>';
        const todos=data.todos??[];
        todosView.innerHTML=todos.length?todos.map(todo=>`<article class="task-card"><b>${esc(todo.title)}</b><small><span class="task-project">${esc(todo.project_name??todo.project_id)}</span>${todo.subject?` / ${esc(todo.subject)}`:''} ・ ${esc(todo.status)}</small>${todo.details?`<small>${esc(todo.details)}</small>`:''}</article>`).join(''):'<p class="empty">未完了のタスクはありません。</p>';
      }catch(error){
        const message=error instanceof Error?error.message:'Homeを読み込めませんでした。';
        projectsView.textContent=message;
        todosView.textContent=message;
      }
    };
    void load();
  };
  document.addEventListener('astro:page-load',initializeMemberHome);
  initializeMemberHome();
</script>
