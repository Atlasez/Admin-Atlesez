---
import AdminLayout from "../../layouts/AdminLayout.astro";
---
<AdminLayout title="Atlasezメンバー用サイト" description="Atlasezの全プロジェクトへの入口">
  <main class="portal" data-portal>
    <header>
      <div>
        <h1 data-admin-i18n data-admin-ja="Atlasezメンバー用サイト" data-admin-en="Atlasez member site">Atlasezメンバー用サイト</h1>
        <span data-admin-i18n data-admin-ja="Atlasezの全プロジェクトを集約した入口です。各プロジェクトHomeから、それぞれの運営ワークスペースへ移動できます。" data-admin-en="One entry point for every Atlasez project. Open each project home to enter its workspace.">Atlasezの全プロジェクトを集約した入口です。各プロジェクトHomeから、それぞれの運営ワークスペースへ移動できます。</span>
      </div>
    </header>

    <section class="project-entry" aria-labelledby="projects-entry-heading">
      <div>
        <p class="section-kicker">PROJECTS</p>
        <h2 id="projects-entry-heading" data-admin-i18n data-admin-ja="主要プロジェクト" data-admin-en="Core projects">主要プロジェクト</h2>
        <span data-admin-i18n data-admin-ja="学習サイト、ゼミプラットフォーム、運営事務局をここから開けます。" data-admin-en="Open the learning site, seminar platform, or Secretariat from here.">学習サイト、ゼミプラットフォーム、運営事務局をここから開けます。</span>
      </div>
      <div class="project-entry-cards">
        <a class="project-entry-card" href="/admin/atlas/">
          <strong data-admin-i18n data-admin-ja="学習サイト「アトラス」運営" data-admin-en="Atlas learning site operations">学習サイト「アトラス」運営</strong>
          <small data-admin-i18n data-admin-ja="原稿、編集・査読、問題報告、進捗・ToDo・日程" data-admin-en="Articles, review, reports, progress, tasks and events">原稿、編集・査読、問題報告、進捗・ToDo・日程</small>
          <span data-admin-i18n data-admin-ja="学習サイト運営へ →" data-admin-en="Open learning site operations →">学習サイト運営へ →</span>
        </a>
        <a class="project-entry-card" href="/admin/secretariat/">
          <strong data-admin-i18n data-admin-ja="Atlasez運営事務局" data-admin-en="Atlasez Secretariat">Atlasez運営事務局</strong>
          <small data-admin-i18n data-admin-ja="事務局のToDo、依頼、日程調整、同時作業会" data-admin-en="Secretariat tasks, requests, scheduling and co-working">事務局のToDo、依頼、日程調整、同時作業会</small>
          <span data-admin-i18n data-admin-ja="事務局サイトへ →" data-admin-en="Open Secretariat →">事務局サイトへ →</span>
        </a>
        <a class="project-entry-card" href="/admin/semi-platform/">
          <strong data-admin-i18n data-admin-ja="ゼミプラットフォーム" data-admin-en="Seminar platform">ゼミプラットフォーム</strong>
          <small data-admin-i18n data-admin-ja="ゼミの運営、依頼、日程調整、現行サイトへの導線" data-admin-en="Seminar operations, tasks, scheduling and the current site">ゼミの運営、依頼、日程調整、現行サイトへの導線</small>
          <span data-admin-i18n data-admin-ja="ゼミサイトへ →" data-admin-en="Open seminar platform →">ゼミサイトへ →</span>
        </a>
      </div>
    </section>

    <div class="home-grid">
      <section class="home-section">
        <div class="section-heading">
          <div><p class="section-kicker">CALENDAR</p><h2 data-admin-i18n data-admin-ja="カレンダー" data-admin-en="Calendar">カレンダー</h2><small data-admin-i18n data-admin-ja="自分の期限と参加プロジェクトの組織イベント" data-admin-en="Your deadlines and organization events">自分の期限と参加プロジェクトの組織イベント</small><small class="calendar-timezone-note" data-calendar-timezone-note></small></div>
          <a href="/admin/operations/" data-admin-i18n data-admin-ja="日程を管理" data-admin-en="Manage schedule">日程を管理</a>
        </div>
        <div class="calendar-toolbar" role="group" aria-label="カレンダー操作"><button type="button" data-calendar-prev aria-label="前の月">‹</button><strong data-calendar-title>読み込み中…</strong><button type="button" data-calendar-next aria-label="次の月">›</button></div>
        <div class="calendar-filters" role="group" aria-label="カレンダー表示対象"><label><input type="checkbox" data-calendar-source="personal" checked /> <span data-admin-i18n data-admin-ja="自分の期限" data-admin-en="My deadlines">自分の期限</span></label><label><input type="checkbox" data-calendar-source="organization" checked /> <span data-admin-i18n data-admin-ja="組織イベント" data-admin-en="Organization events">組織イベント</span></label></div>
        <div class="portal-calendar" data-portal-calendar aria-label="カレンダー"></div>
        <div class="calendar-upcoming" data-calendar-upcoming aria-live="polite"></div>
      </section>
      <section class="home-section">
        <div class="section-heading">
          <div><p class="section-kicker">MY TASKS</p><h2 data-admin-i18n data-admin-ja="自分の未完了ToDo" data-admin-en="My open tasks">自分の未完了ToDo</h2></div>
          <a href="/admin/operations/" data-admin-i18n data-admin-ja="ToDoを開く" data-admin-en="Open tasks">ToDoを開く</a>
        </div>
        <div data-todos>読み込み中…</div>
      </section>
    </div>
  </main>
</AdminLayout>
<style>
  .portal { margin: 0 auto; max-width: 1200px; padding: 0 1.25rem 4rem; }
  .portal > header { border-bottom: 1px solid var(--border-default); display: flex; gap: 1rem; justify-content: space-between; padding: 2.1rem 0 1.3rem; }
  .portal > header p, .section-kicker { color: var(--accent-primary); font-size: .72rem; font-weight: 800; letter-spacing: .1em; margin: 0; }
  .portal h1 { font-size: clamp(2rem, 4vw, 2.7rem); letter-spacing: -.04em; margin: .25rem 0; }
  .portal > header span, .portal small { color: var(--text-secondary); line-height: 1.6; }
  .project-entry { align-items: center; border: 1px solid var(--border-default); display: grid; gap: 1rem; grid-template-columns: minmax(0, 1fr) minmax(24rem, 1.4fr); margin: 1.5rem 0; padding: 1.25rem; }
  .project-entry h2 { font-size: 1.2rem; margin: .25rem 0; }
  .project-entry > div > span { color: var(--text-secondary); font-size: .82rem; line-height: 1.6; }
  .project-entry-cards { display: grid; gap: .65rem; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .project-entry-card { align-content: start; background: var(--background-secondary); border: 1px solid var(--border-default); border-top: 3px solid var(--accent-primary); box-sizing: border-box; color: var(--text-primary); display: grid; gap: .35rem; min-height: 8.4rem; min-width: 0; overflow-wrap: anywhere; padding: 1rem; text-decoration: none; }
  .project-entry-card:hover { border-color: var(--accent-primary); transform: translateY(-1px); }
  .project-entry-card strong { font-size: .95rem; }
  .project-entry-card small { font-size: .76rem; }
  .project-entry-card span { color: var(--accent-primary); font-size: .76rem; font-weight: 800; margin-top: .25rem; }
  .home-grid { display: grid; gap: 1rem; grid-template-columns: 1fr 1fr; }
  .home-section { border: 1px solid var(--border-default); min-width: 0; padding: 1rem; }
  .section-heading { align-items: start; border-bottom: 1px solid var(--border-default); display: flex; gap: .7rem; justify-content: space-between; margin-bottom: .7rem; padding-bottom: .65rem; }
  .section-heading h2 { font-size: 1.1rem; margin: .2rem 0 0; }
  .section-heading a { color: var(--accent-primary); font-size: .75rem; font-weight: 800; text-decoration: none; white-space: nowrap; }
  .cards { display: grid; gap: .7rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); }
  .card, .todo { box-sizing: border-box; min-width: 0; overflow-wrap: anywhere; }
  .card { align-content: start; background: var(--background-secondary); border: 1px solid var(--border-default); display: grid; gap: .42rem; min-height: 8.5rem; padding: .85rem; }
  .card b, .card small, .card a { min-width: 0; overflow-wrap: anywhere; }
  .card b { line-height: 1.4; }
  .card small { color: var(--text-secondary); line-height: 1.5; }
  .card a { align-self: end; color: var(--accent-primary); font-size: .82rem; font-weight: 800; margin-top: .2rem; text-decoration: none; }
  .todo { border-left: 3px solid var(--accent-primary); margin: .45rem 0; }
  .empty { color: var(--text-secondary); font-size: .82rem; }
  .calendar-toolbar { align-items: center; display: flex; gap: .6rem; justify-content: center; margin: .15rem 0 .65rem; }
  .calendar-toolbar button { background: transparent; border: 1px solid var(--border-default); border-radius: .35rem; color: var(--text-primary); cursor: pointer; font: inherit; font-size: 1.15rem; line-height: 1; min-width: 2rem; padding: .25rem .5rem; }
  .calendar-toolbar button:hover { border-color: var(--accent-primary); color: var(--accent-primary); }
  .calendar-toolbar strong { font-size: .9rem; min-width: 8.5rem; text-align: center; }
  .calendar-filters { display: flex; flex-wrap: wrap; gap: .55rem; margin-bottom: .65rem; }
  .calendar-filters label { align-items: center; background: var(--background-secondary); border: 1px solid var(--border-default); border-radius: 999px; color: var(--text-secondary); cursor: pointer; display: inline-flex; font-size: .72rem; gap: .25rem; padding: .25rem .5rem; }
  .calendar-filters input { accent-color: var(--accent-primary); margin: 0; }
  .portal-calendar { background: var(--border-default); border: 1px solid var(--border-default); display: grid; gap: 1px; grid-template-columns: repeat(7, minmax(0, 1fr)); }
  .portal-calendar-cell { background: var(--background-primary); min-height: 5.6rem; min-width: 0; padding: .3rem; }
  .portal-calendar-cell.is-blank { background: var(--background-secondary); }
  .portal-calendar-cell.is-today { box-shadow: inset 0 0 0 2px color-mix(in srgb, var(--accent-primary) 55%, transparent); }
  .portal-calendar-weekday { background: var(--background-secondary); color: var(--text-secondary); font-size: .65rem; font-weight: 800; min-height: auto; text-align: center; }
  .portal-calendar-day { color: var(--text-secondary); display: block; font-size: .68rem; font-weight: 800; }
  .portal-calendar-event { border-left: 3px solid var(--accent-primary); display: block; font-size: .62rem; line-height: 1.35; margin-top: .2rem; overflow: hidden; padding: .14rem .22rem; text-overflow: ellipsis; white-space: nowrap; }
  .portal-calendar-event.is-personal { border-left-color: #a66a00; }
  .calendar-upcoming { display: grid; gap: .35rem; margin-top: .7rem; }
  .calendar-upcoming:empty { display: none; }
  .calendar-upcoming-heading { color: var(--text-secondary); font-size: .7rem; font-weight: 800; }
  .calendar-upcoming-item { border-left: 3px solid var(--accent-primary); color: var(--text-primary); display: grid; gap: .1rem; padding: .25rem .45rem; text-decoration: none; }
  .calendar-upcoming-item:hover { background: var(--background-secondary); }
  .calendar-upcoming-item.is-personal { border-left-color: #a66a00; }
  .calendar-upcoming-item b { font-size: .76rem; }
  .calendar-upcoming-item small { font-size: .67rem; }
  @media (max-width: 800px) {
    .portal { padding: 0 .8rem 3rem; }
    .project-entry { align-items: start; grid-template-columns: 1fr; padding: .9rem; }
    .project-entry-cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 700px) {
    .home-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 520px) {
    .project-entry-cards { grid-template-columns: 1fr; }
    .portal-calendar-cell { min-height: 4.2rem; padding: .2rem; }
    .portal-calendar-event { font-size: .55rem; }
  }
</style>
<script>
  type PortalTodo = { project_id: string; subject?: string | null; title: string; details?: string | null; status: string };
  type PortalCalendarEvent = { id: string; kind: 'organization' | 'personal'; title: string; details?: string | null; startsAt: string; endsAt?: string | null; timezone: string; projectName: string };
  type PortalData = { todos?: PortalTodo[]; calendar?: { events?: PortalCalendarEvent[] }; error?: string };
  const initializePortal = () => {
    const root = document.querySelector<HTMLElement>('[data-portal]');
    if (!root || root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';
    const calendar = root.querySelector<HTMLElement>('[data-portal-calendar]')!;
    const calendarTitle = root.querySelector<HTMLElement>('[data-calendar-title]')!;
    const calendarUpcoming = root.querySelector<HTMLElement>('[data-calendar-upcoming]')!;
    const timezoneNote = root.querySelector<HTMLElement>('[data-calendar-timezone-note]')!;
    const todosView = root.querySelector<HTMLElement>('[data-todos]')!;
    const sourceInputs = [...root.querySelectorAll<HTMLInputElement>('[data-calendar-source]')];
    const escapeHtml = (value: string) => value.replace(/[&<>"']/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[character] ?? character);
    type PortalLanguage = 'ja' | 'en';
    const getLanguage = (): PortalLanguage => localStorage.getItem('atlasez-admin-language') === 'en' ? 'en' : 'ja';
    const copy = {
      ja: { noTodos: '未完了のToDoはありません。', status: '状態', noEvents: 'この月の予定はありません。', upcoming: '近日の予定', personal: '自分の期限', organization: '組織イベント', timezone: '表示タイムゾーン' },
      en: { noTodos: 'There are no open tasks.', status: 'Status', noEvents: 'There are no events this month.', upcoming: 'Upcoming', personal: 'My deadline', organization: 'Organization event', timezone: 'Time zone' },
    } as const;
    let portalData: PortalData | null = null;
    let month = new Date(new Date().getFullYear(), new Date().getMonth(), 1);
    const timezone = () => Intl.DateTimeFormat().resolvedOptions().timeZone || 'Asia/Tokyo';
    const dateParts = (value: Date | string, options: Intl.DateTimeFormatOptions = {}) => {
      try {
        const parts = new Intl.DateTimeFormat('en-US', { timeZone: timezone(), year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', hourCycle: 'h23', ...options }).formatToParts(new Date(value));
        return Object.fromEntries(parts.filter((part) => part.type !== 'literal').map((part) => [part.type, part.value]));
      } catch { return {}; }
    };
    const dateKey = (value: string) => { const parts = dateParts(value); return `${parts.year ?? ''}-${parts.month ?? ''}-${parts.day ?? ''}`; };
    const formatDate = (value: string) => new Intl.DateTimeFormat(getLanguage() === 'ja' ? 'ja-JP' : 'en-US', { dateStyle: 'medium', timeStyle: 'short', timeZone: timezone() }).format(new Date(value));
    const enabledKinds = () => new Set(sourceInputs.filter((input) => input.checked).map((input) => input.dataset.calendarSource));
    const visibleEvents = () => (portalData?.calendar?.events ?? []).filter((event) => enabledKinds().has(event.kind));
    const renderCalendar = () => {
      const language = getLanguage();
      const formatter = new Intl.DateTimeFormat(language === 'ja' ? 'ja-JP' : 'en-US', { year: 'numeric', month: 'long' });
      calendarTitle.textContent = formatter.format(month);
      timezoneNote.textContent = `${copy[language].timezone}: ${timezone()}`;
      const headings = (language === 'ja' ? ['日', '月', '火', '水', '木', '金', '土'] : ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat']).map((day) => `<div class="portal-calendar-cell portal-calendar-weekday">${day}</div>`);
      const firstDay = new Date(month.getFullYear(), month.getMonth(), 1).getDay();
      const lastDay = new Date(month.getFullYear(), month.getMonth() + 1, 0).getDate();
      const today = dateKey(new Date().toISOString());
      const events = visibleEvents();
      const cells = [...headings];
      for (let index = 0; index < firstDay; index += 1) cells.push('<div class="portal-calendar-cell is-blank"></div>');
      for (let day = 1; day <= lastDay; day += 1) {
        const key = `${month.getFullYear()}-${String(month.getMonth() + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
        const dayEvents = events.filter((event) => dateKey(event.startsAt) === key);
        cells.push(`<div class="portal-calendar-cell${today === key ? ' is-today' : ''}"><span class="portal-calendar-day">${day}</span>${dayEvents.map((event) => { const parts = dateParts(event.startsAt); const kind = event.kind === 'personal' ? copy[language].personal : copy[language].organization; return `<span class="portal-calendar-event${event.kind === 'personal' ? ' is-personal' : ''}" title="${escapeHtml(`${kind} / ${event.projectName} / ${event.title}`)}">${escapeHtml(`${parts.hour ?? ''}:${parts.minute ?? ''} ${event.title}`)}</span>`; }).join('')}</div>`);
      }
      calendar.innerHTML = cells.join('');
      const upcoming = events.filter((event) => new Date(event.startsAt).getTime() >= Date.now()).sort((a, b) => new Date(a.startsAt).getTime() - new Date(b.startsAt).getTime()).slice(0, 5);
      calendarUpcoming.innerHTML = upcoming.length ? `<small class="calendar-upcoming-heading">${copy[language].upcoming}</small>${upcoming.map((event) => `<a class="calendar-upcoming-item${event.kind === 'personal' ? ' is-personal' : ''}" href="/admin/operations/"><b>${escapeHtml(event.title)}</b><small>${escapeHtml(event.kind === 'personal' ? copy[language].personal : copy[language].organization)} / ${escapeHtml(event.projectName)} ・ ${escapeHtml(formatDate(event.startsAt))}</small></a>`).join('')}` : `<small class="empty">${copy[language].noEvents}</small>`;
    };
    const renderTodos = (data: PortalData) => { const language = getLanguage(); const todos = data.todos ?? []; todosView.innerHTML = todos.length ? todos.map((todo) => `<article class="todo"><b>${escapeHtml(todo.title)}</b><small>${escapeHtml(todo.project_id)}${todo.subject ? ` / ${escapeHtml(todo.subject)}` : ''} ・ ${copy[language].status}: ${escapeHtml(todo.status)}</small>${todo.details ? `<small>${escapeHtml(todo.details)}</small>` : ''}</article>`).join('') : `<p class="empty">${copy[language].noTodos}</p>`; };
    const renderPortal = (data: PortalData) => { renderCalendar(); renderTodos(data); };
    sourceInputs.forEach((input) => input.addEventListener('change', renderCalendar));
    root.querySelector<HTMLButtonElement>('[data-calendar-prev]')!.addEventListener('click', () => { month = new Date(month.getFullYear(), month.getMonth() - 1, 1); renderCalendar(); });
    root.querySelector<HTMLButtonElement>('[data-calendar-next]')!.addEventListener('click', () => { month = new Date(month.getFullYear(), month.getMonth() + 1, 1); renderCalendar(); });
    document.addEventListener('atlasez-admin-language-change', () => { if (portalData) renderPortal(portalData); });
    void fetch('/api/admin/portal', { credentials: 'same-origin', cache: 'no-store' }).then(async (response) => {
      const contentType = response.headers.get('content-type') ?? '';
      const data = contentType.includes('application/json') ? await response.json() as PortalData : null;
      if (!response.ok || !data) throw new Error(data?.error ?? '認証情報を確認できませんでした。ページを再読み込みしてください。');
      portalData = data;
      renderPortal(data);
    }).catch((error) => {
      const message = error instanceof Error ? error.message : 'Homeを読み込めませんでした。';
      calendar.textContent = message;
      todosView.textContent = message;
    });
  };
  document.addEventListener('astro:page-load', initializePortal);
  initializePortal();
</script>
