---
import AdminLayout from "../../layouts/AdminLayout.astro";
import AdminNav from "../../components/AdminNav.astro";
---
<AdminLayout title="Atlasez運営ポータル" description="プロジェクト横断の運営ポータル">
<main class="portal" data-portal><AdminNav current="portal"/><header><div><p>ATLASEZ / 運営用サイト</p><h1>Home</h1></div></header>
<section class="project-entry" aria-labelledby="projects-entry-heading"><div><p class="section-kicker">PROJECTS</p><h2 id="projects-entry-heading">プロジェクトを選択</h2><span>学習サイトの原稿・査読・日程管理は、プロジェクト専用ページから行います。</span></div><a class="project-entry-card" href="/admin/atlas/"><strong>アトラス学習サイト</strong><small>原稿一覧、記事編集、査読、問題報告、進捗・ToDo・日程</small><span>学習サイト運営へ →</span></a></section>
<div class="home-grid"><section class="home-section"><div class="section-heading"><div><p class="section-kicker">PROJECTS</p><h2>参加中のプロジェクト</h2></div><a href="/admin/operations">進捗を見る</a></div><div data-projects>読み込み中…</div></section><section class="home-section"><div class="section-heading"><div><p class="section-kicker">MY TASKS</p><h2>自分の未完了ToDo</h2></div><a href="/admin/operations">ToDoを開く</a></div><div data-todos>読み込み中…</div></section></div>
</main>
</AdminLayout>
<style>.portal{margin:0 auto;max-width:1200px;padding:0 1.25rem 4rem}.portal > header{align-items:end;border-bottom:1px solid var(--border-default);display:flex;gap:1rem;justify-content:space-between;padding:2.1rem 0 1.3rem}.portal > header p,.section-kicker{color:var(--accent-primary);font-size:.72rem;font-weight:800;letter-spacing:.1em;margin:0}.portal h1{font-size:clamp(2rem,4vw,2.7rem);letter-spacing:-.04em;margin:.25rem 0}.portal > header span,.portal small{color:var(--text-secondary);line-height:1.6}.home-edit{background:var(--accent-primary);color:#fff;font-size:.82rem;font-weight:800;padding:.7rem .85rem;text-decoration:none;white-space:nowrap}.project-entry{align-items:center;border:1px solid var(--border-default);display:grid;gap:1rem;grid-template-columns:minmax(0,1fr) minmax(16rem,24rem);margin:1.5rem 0;padding:1.25rem}.project-entry h2{font-size:1.2rem;margin:.25rem 0}.project-entry>div>span{color:var(--text-secondary);font-size:.82rem;line-height:1.6}.project-entry-card{background:var(--background-secondary);border:1px solid var(--border-default);border-top:3px solid var(--accent-primary);color:var(--text-primary);display:grid;gap:.35rem;padding:1rem;text-decoration:none}.project-entry-card:hover{border-color:var(--accent-primary);transform:translateY(-1px)}.project-entry-card strong{font-size:1rem}.project-entry-card small{font-size:.76rem}.project-entry-card span{color:var(--accent-primary);font-size:.76rem;font-weight:800;margin-top:.25rem}.home-grid{display:grid;gap:1rem;grid-template-columns:1fr 1fr}.home-section{border:1px solid var(--border-default);min-width:0;padding:1rem}.section-heading{align-items:start;border-bottom:1px solid var(--border-default);display:flex;gap:.7rem;justify-content:space-between;margin-bottom:.7rem;padding-bottom:.65rem}.section-heading h2{font-size:1.1rem;margin:.2rem 0 0}.section-heading a{color:var(--accent-primary);font-size:.75rem;font-weight:800;text-decoration:none;white-space:nowrap}.cards{display:grid;gap:.7rem;grid-template-columns:repeat(auto-fit,minmax(13rem,1fr))}.card,.todo{border:1px solid var(--border-default);display:grid;gap:.35rem;padding:.8rem}.card a{color:var(--accent-primary);font-size:.82rem;font-weight:800;text-decoration:none}.todo{border-left:3px solid var(--accent-primary);margin:.45rem 0}.empty{color:var(--text-secondary);font-size:.82rem}@media(max-width:700px){.portal{padding:0 .8rem 3rem}.portal > header{align-items:start;display:grid}.home-edit{justify-self:start}.project-entry{grid-template-columns:1fr;padding:.9rem}.home-grid{grid-template-columns:1fr}.section-heading{align-items:start}.section-heading a{font-size:.7rem}}</style>
<script>
  type PortalProject = { id: string; slug: string; name: string; description?: string };
  type PortalTodo = { project_id: string; subject?: string | null; title: string; details?: string | null; status: string };
  const initializePortal = () => {
    const root = document.querySelector<HTMLElement>('[data-portal]');
    if (!root || root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';
    const projectsView = root.querySelector<HTMLElement>('[data-projects]')!;
    const todosView = root.querySelector<HTMLElement>('[data-todos]')!;
    const escapeHtml = (value: string) => value.replace(/[&<>"']/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[character] ?? character);
    const selectedProject = new URLSearchParams(location.search).get('project');
    void fetch('/api/admin/portal', { credentials: 'same-origin', cache: 'no-store' }).then(async (response) => {
      const contentType = response.headers.get('content-type') ?? '';
      const data = contentType.includes('application/json') ? await response.json() as { projects?: PortalProject[]; todos?: PortalTodo[]; error?: string } : null;
      if (!response.ok || !data) throw new Error(data?.error ?? '認証情報を確認できませんでした。ページを再読み込みしてください。');
      const projects = data.projects ?? [];
      const active = projects.find((project) => project.slug === selectedProject);
      projectsView.innerHTML = projects.length ? `<div class="cards">${projects.map((project) => `<article class="card${project.slug === selectedProject ? ' is-active' : ''}"><b>${escapeHtml(project.name)}</b><small>${escapeHtml(project.description ?? '')}</small><a href="/admin/portal/?project=${encodeURIComponent(project.slug)}">${project.slug === selectedProject ? 'このプロジェクトを表示中' : 'このプロジェクトを開く →'}</a></article>`).join('')}</div>` : '<p class="empty">参加プロジェクトはありません。</p>';
      const todos = (data.todos ?? []).filter((todo) => !selectedProject || todo.project_id === active?.id || todo.project_id === active?.slug);
      todosView.innerHTML = todos.length ? todos.map((todo) => `<article class="todo"><b>${escapeHtml(todo.title)}</b><small>${escapeHtml(todo.project_id)}${todo.subject ? ` / ${escapeHtml(todo.subject)}` : ''} ・ ${escapeHtml(todo.status)}</small>${todo.details ? `<small>${escapeHtml(todo.details)}</small>` : ''}</article>`).join('') : '<p class="empty">このプロジェクトに未完了のToDoはありません。</p>';
    }).catch((error) => {
      const message = error instanceof Error ? error.message : 'Homeを読み込めませんでした。';
      projectsView.textContent = message;
      todosView.textContent = message;
    });
  };
  document.addEventListener('astro:page-load', initializePortal);
  initializePortal();
</script>
