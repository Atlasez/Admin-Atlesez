---
import AdminLayout from "../../layouts/AdminLayout.astro";
import AdminRetryNotice from "../../components/admin/AdminRetryNotice.astro";
---

<AdminLayout title="役割管理" description="アトラス運営の役割カタログと担当メンバー">
  <main class="role-management" data-role-management>
    <header class="page-heading">
      <div><p class="eyebrow">運営の担当範囲</p><h1>役割管理</h1><p class="lead">役割をジャンル管理から分離して、役割名・説明・担当メンバーを管理します。ここでの役割は表示・運用上の担当範囲であり、APIのアクセス権は権限管理で設定します。</p></div>
      <div class="heading-actions"><a href="/admin/manage/?project=atlas">← 管理トップ</a><a class="quiet" href="/admin/genre-roles/?project=atlas&view=genres">ジャンル管理</a><a class="quiet" href="/admin/permissions/?project=atlas">権限管理</a></div>
    </header>

    <section class="create-panel" aria-labelledby="create-role-heading">
      <h2 id="create-role-heading">役割を追加</h2>
      <form data-role-form>
        <label class="wide">役割名<input name="name" required maxlength="120" placeholder="例：広報担当" /></label>
        <details class="advanced-field"><summary>詳細設定（内部ID）</summary><label>ID（任意・英数字とハイフン）<input name="slug" pattern="[a-z0-9-]+" maxlength="80" placeholder="未入力なら自動生成" /></label><small>役割名から自動生成します。既存の参照関係がある場合だけ指定してください。</small></details>
        <label class="wide">役割の説明<textarea name="description" maxlength="500" rows="2" placeholder="例：SNSでの告知と運用を担当します"></textarea></label>
        <label class="wide">権限範囲<textarea name="permissionScope" maxlength="500" rows="2" placeholder="例：SNS告知のみ。記事編集権限は別途付与"></textarea></label>
        <button type="submit">役割を追加</button>
        <output data-form-message aria-live="polite"></output>
      </form>
    </section>

    <section class="assign-panel" aria-labelledby="assign-role-heading">
      <h2 id="assign-role-heading">担当メンバーを追加</h2>
      <form data-assignment-form>
        <label class="wide">メールアドレス<input type="email" name="email" required maxlength="320" placeholder="member@example.com" /></label>
        <label class="wide">役割<select name="catalogId" data-role-select required><option value="">読み込み中…</option></select></label>
        <button type="submit">メンバーを追加</button>
        <output data-assignment-message aria-live="polite"></output>
      </form>
    </section>

    <section aria-labelledby="role-list-heading">
      <div class="section-heading"><div><h2 id="role-list-heading">役割一覧</h2><p>アーカイブ済みの役割も履歴として保持されます。</p></div><span data-count>—</span></div>
      <div class="role-grid" data-role-list><p class="loading">役割を読み込んでいます…</p></div>
    </section>
    <AdminRetryNotice scope="roles" message="役割情報を読み込めませんでした。" />
    <output class="message" data-message aria-live="polite"></output>
  </main>
</AdminLayout>

<style>

  .role-management{margin:0 auto;max-width:1100px;padding:0 1.25rem 4rem}.page-heading{align-items:end;border-bottom:1px solid var(--border-default);display:flex;gap:1rem;justify-content:space-between;padding:2rem 0 1.3rem}.eyebrow{color:var(--accent-primary);font-size:.7rem;font-weight:800;letter-spacing:.08em;margin:0}.page-heading h1{font-size:clamp(1.8rem,4vw,2.5rem);margin:.25rem 0 .45rem}.lead{color:var(--text-secondary);font-size:.82rem;line-height:1.7;margin:0;max-width:62rem}.heading-actions{align-items:flex-end;display:flex;flex-wrap:wrap;gap:.6rem}.heading-actions a{color:var(--accent-primary);font-size:.8rem;font-weight:800;text-decoration:none;white-space:nowrap}.heading-actions .quiet{border:1px solid var(--border-default);color:var(--text-primary);padding:.5rem .7rem}.create-panel,.assign-panel{background:var(--background-secondary);border:1px solid var(--border-default);margin-top:1rem;padding:.9rem}.create-panel h2,.assign-panel h2{font-size:.95rem;margin:0 0 .7rem}.create-panel form,.assign-panel form{align-items:end;display:flex;flex-wrap:wrap;gap:.55rem}.create-panel label,.assign-panel label{color:var(--text-secondary);display:grid;font-size:.68rem;font-weight:800;gap:.25rem;min-width:11rem}.create-panel label.wide,.assign-panel label.wide{flex:1 1 16rem}.create-panel input,.create-panel textarea,.assign-panel input,.assign-panel select{background:var(--background-primary);border:1px solid var(--border-default);color:var(--text-primary);font:inherit;min-height:2.2rem;padding:.4rem .5rem;resize:vertical}.create-panel button,.assign-panel button,.role-card button{background:var(--accent-primary);border:1px solid var(--accent-primary);color:#fff;cursor:pointer;font:inherit;font-size:.72rem;font-weight:800;min-height:2.2rem;padding:.4rem .65rem}.create-panel output,.assign-panel output{color:var(--text-secondary);font-size:.7rem;min-height:1.1rem}.section-heading{align-items:end;border-bottom:1px solid var(--border-default);display:flex;gap:1rem;justify-content:space-between;margin-top:2rem;padding-bottom:.65rem}.section-heading h2{font-size:1.15rem;margin:0}.section-heading p{color:var(--text-secondary);font-size:.72rem;margin:.3rem 0 0}.section-heading>span{color:var(--text-secondary);font-size:.72rem;white-space:nowrap}.role-grid{display:grid;gap:.75rem;grid-template-columns:repeat(auto-fit,minmax(18rem,1fr));padding-top:.8rem}.role-card{background:var(--background-secondary);border:1px solid var(--border-default);display:grid;gap:.65rem;min-width:0;padding:.9rem}.role-card[data-status="archived"]{opacity:.7}.role-card__heading{align-items:start;display:flex;gap:.5rem;justify-content:space-between}.role-card h3{font-size:1rem;margin:0;overflow-wrap:anywhere}.role-card code{color:var(--text-secondary);display:block;font-size:.66rem;margin-top:.15rem;overflow-wrap:anywhere}.status{border:1px solid var(--border-default);border-radius:999px;color:var(--text-secondary);font-size:.64rem;padding:.18rem .4rem;white-space:nowrap}.description,.permission-scope{color:var(--text-secondary);font-size:.76rem;line-height:1.55;margin:0;min-height:2.4em}.description strong,.permission-scope strong{color:var(--text-primary);display:block;font-size:.68rem;margin-bottom:.15rem}.members{border-top:1px solid var(--border-default);display:flex;flex-wrap:wrap;gap:.3rem;padding-top:.6rem}.member{align-items:center;background:var(--background-primary);border:1px solid var(--border-default);display:inline-flex;gap:.3rem;padding:.27rem .4rem}.member span{font-size:.7rem;overflow-wrap:anywhere}.member button,.secondary{background:transparent!important;border:1px solid var(--border-default)!important;color:var(--accent-primary)!important;font-size:.64rem!important;min-height:0!important;padding:.2rem .35rem!important}.role-editor{border-top:1px solid var(--border-default);display:grid;gap:.45rem;padding-top:.6rem}.role-editor[hidden]{display:none}.role-editor label{color:var(--text-secondary);display:grid;font-size:.65rem;font-weight:800;gap:.2rem}.role-editor input,.role-editor textarea{background:var(--background-primary);border:1px solid var(--border-default);color:var(--text-primary);font:inherit;min-height:1.9rem;padding:.3rem .4rem;resize:vertical}.role-editor__actions,.card-actions{display:flex;flex-wrap:wrap;gap:.35rem}.card-actions{justify-content:flex-end}.loading,.empty-state,.error-state,.message{color:var(--text-secondary);font-size:.78rem}.message{display:block;min-height:1.2rem;padding-top:.7rem}.create-panel .advanced-field{align-self:stretch;display:grid;gap:.25rem;min-width:11rem}.create-panel .advanced-field summary{color:var(--accent-primary);cursor:pointer;font-size:.68rem;font-weight:800;list-style-position:inside}.create-panel .advanced-field label{min-width:0}.create-panel .advanced-field small,.role-editor .advanced-field small{color:var(--text-secondary);font-size:.62rem;font-weight:400;line-height:1.45;max-width:18rem}.role-editor .advanced-field{display:grid;gap:.25rem}.role-editor .advanced-field summary{color:var(--accent-primary);cursor:pointer;font-size:.65rem;font-weight:800}.role-editor .advanced-field label{min-width:0}@media(max-width:700px){.role-management{padding:0 .8rem 3rem}.page-heading{align-items:start;display:grid}.heading-actions{align-items:start}.role-grid{grid-template-columns:1fr}}
</style>

<script>
  import { createAdminLoadRetry } from "../../scripts/admin-load-retry";
  import { lockAdminForm } from "../../scripts/admin-form-submit-lock";
  import { readAdminApiJson } from "../../lib/admin-api";

  type Role = { id: string; kind: string; slug: string; name: string; description?: string; permission_scope?: string; status?: string };
  type Assignment = { catalog_id: string; email: string; display_name?: string };
  type ResponseData = { catalog?: Role[]; assignments?: Assignment[]; error?: string };
  const initialize = () => {
    const root = document.querySelector<HTMLElement>("[data-role-management]");
    if (!root || root.dataset.ready) return;
    root.dataset.ready = "true";
    const list = root.querySelector<HTMLElement>("[data-role-list]")!;
    const select = root.querySelector<HTMLSelectElement>("[data-role-select]")!;
    const count = root.querySelector<HTMLElement>("[data-count]")!;
    const message = root.querySelector<HTMLOutputElement>("[data-message]")!;
    let roles: Role[] = [];
    let assignments: Assignment[] = [];
    const esc = (value: unknown) => String(value ?? "").replace(/[&<>"']/g, (character) => ({ "&":"&amp;", "<":"&lt;", ">":"&gt;", '"':"&quot;", "'":"&#39;" })[character] ?? character);
    const memberName = (item: Assignment) => item.display_name?.trim() || item.email;
    const attachAssignmentForms = () => {
      list.querySelectorAll<HTMLElement>(".role-card[data-role-id]").forEach((card) => {
        if (card.dataset.status === "archived" || card.querySelector("[data-role-assignment]")) return;
        const id = card.dataset.roleId ?? "";
        card.insertAdjacentHTML("beforeend", `<form class="role-card__assignment" data-role-assignment="${esc(id)}"><label>この役割の担当メンバー<input type="email" name="email" required maxlength="320" placeholder="member@example.com" /></label><button type="submit">追加</button><output aria-live="polite"></output></form>`);
      });
    };
    const send = async (url: string, options: RequestInit) => {
      const response = await fetch(url, { ...options, credentials: "same-origin", headers: { "content-type": "application/json", ...(options.headers ?? {}) } });
      const data = await readAdminApiJson<{ error?: string }>(response, "保存できませんでした。");
      if (!response.ok) throw new Error(data.error ?? "保存できませんでした。");
      return data;
    };
    const render = () => {
      const activeRoles = roles.filter((role) => role.kind === "role");
      count.textContent = `${activeRoles.length}件`;
      select.innerHTML = `<option value="">選択してください</option>${activeRoles.filter((role) => role.status !== "archived").map((role) => `<option value="${esc(role.id)}">${esc(role.name)}</option>`).join("")}`;
      select.disabled = false;
      list.innerHTML = activeRoles.length ? activeRoles.map((role) => {
        const members = assignments.filter((item) => item.catalog_id === role.id);
        const status = role.status === "archived" ? "アーカイブ" : "有効";
        return `<article class="role-card" data-status="${esc(role.status ?? "active")}" data-role-id="${esc(role.id)}"><div class="role-card__heading"><div><h3>${esc(role.name)}</h3><code>${esc(role.slug)}</code></div><span class="status">${status}</span></div><p class="description"><strong>役割の説明</strong>${esc(role.description || "説明は未登録です。")}</p><p class="permission-scope"><strong>権限範囲</strong>${esc(role.permission_scope || "権限範囲は未登録です。")}</p><div class="members"><strong class="role-card__meta">担当 ${members.length}人</strong>${members.length ? members.map((member) => `<span class="member"><span>${esc(memberName(member))}</span><button type="button" data-remove-member="${esc(role.id)}" data-email="${esc(member.email)}" aria-label="${esc(memberName(member))}を${esc(role.name)}から削除">削除</button></span>`).join("") : '<span class="role-card__meta">未割り当て</span>'}</div><div class="card-actions"><button type="button" class="secondary" data-edit-role="${esc(role.id)}">編集</button><button type="button" class="secondary" data-toggle-role="${esc(role.id)}" data-next-action="${role.status === "archived" ? "restore" : "archive"}">${role.status === "archived" ? "復元" : "アーカイブ"}</button></div><form class="role-editor" data-role-editor="${esc(role.id)}" hidden><label>役割名<input name="name" value="${esc(role.name)}" maxlength="120" required /></label><details class="advanced-field"><summary>詳細設定（内部ID）</summary><label>ID（任意・英数字とハイフン）<input name="slug" value="${esc(role.slug)}" pattern="[a-z0-9-]+" maxlength="80" /></label><small>参照関係を保つため、通常は変更しません。</small></details><label>役割の説明<textarea name="description" maxlength="500" rows="2">${esc(role.description ?? "")}</textarea></label><label>権限範囲<textarea name="permissionScope" maxlength="500" rows="2">${esc(role.permission_scope ?? "")}</textarea></label><div class="role-editor__actions"><button type="submit">保存</button><button type="button" class="secondary" data-cancel-role="${esc(role.id)}">キャンセル</button></div></form></article>`;
      }).join("") : '<p class="empty-state">役割はまだ登録されていません。</p>';
      attachAssignmentForms();
    };
    let load: () => Promise<void>;
    const retry = createAdminLoadRetry(root, () => load(), "役割情報を読み込めませんでした。");
    const setLoadMessage = (value: string) => { const className = value === "読み込み中…" ? "loading" : "error-state"; list.innerHTML = `<p class="${className}">${esc(value)}</p>`; select.innerHTML = `<option value="">${esc(value)}</option>`; select.disabled = true; };
    load = async () => { retry.begin(); setLoadMessage("読み込み中…"); try { const response = await fetch("/api/admin/genre-role-catalog?project=atlas&includeArchived=1", { credentials: "same-origin", cache: "no-store" }); const data = await readAdminApiJson<ResponseData>(response, "役割情報を読み込めませんでした。"); if (!response.ok) throw new Error(data.error ?? "役割情報を読み込めませんでした。"); roles = data.catalog ?? []; assignments = data.assignments ?? []; render(); retry.success(); } catch (error) { setLoadMessage(error instanceof Error ? error.message : "役割情報を読み込めませんでした。"); retry.fail(error); throw error; } };
    root.querySelector<HTMLFormElement>("[data-role-form]")?.addEventListener("submit", async (event) => { event.preventDefault(); const form = event.currentTarget as HTMLFormElement; const output = form.querySelector<HTMLOutputElement>("[data-form-message]")!; const values = Object.fromEntries(new FormData(form).entries()); const release = lockAdminForm(form, "追加中…"); try { await send("/api/admin/genre-role-catalog", { method: "POST", body: JSON.stringify({ ...values, kind: "role" }) }); output.textContent = "役割を追加しました。"; form.reset(); await load(); } catch (error) { output.textContent = error instanceof Error ? error.message : "役割を追加できませんでした。"; } finally { release(); } });
    root.querySelector<HTMLFormElement>("[data-assignment-form]")?.addEventListener("submit", async (event) => { event.preventDefault(); const form = event.currentTarget as HTMLFormElement; const output = form.querySelector<HTMLOutputElement>("[data-assignment-message]")!; const values = Object.fromEntries(new FormData(form).entries()); const release = lockAdminForm(form, "追加中…"); try { await send("/api/admin/genre-role-catalog/assignments", { method: "POST", body: JSON.stringify(values) }); output.textContent = "担当メンバーを追加しました。"; form.reset(); await load(); } catch (error) { output.textContent = error instanceof Error ? error.message : "担当メンバーを追加できませんでした。"; } finally { release(); } });
    root.addEventListener("click", (event) => { const target = event.target as HTMLElement; const edit = target.closest<HTMLElement>("[data-edit-role]"); const cancel = target.closest<HTMLElement>("[data-cancel-role]"); const toggle = target.closest<HTMLElement>("[data-toggle-role]"); const remove = target.closest<HTMLElement>("[data-remove-member]"); if (edit) { root.querySelector<HTMLElement>(`[data-role-editor="${CSS.escape(edit.dataset.editRole ?? "")}"]`)?.removeAttribute("hidden"); return; } if (cancel) { root.querySelector<HTMLElement>(`[data-role-editor="${CSS.escape(cancel.dataset.cancelRole ?? "")}"]`)?.setAttribute("hidden", ""); return; } if (toggle) { if (toggle.dataset.nextAction === "archive" && !window.confirm("この役割をアーカイブしますか？担当割り当てと履歴は保持されます。")) return; void send("/api/admin/genre-role-catalog", { method: "PATCH", body: JSON.stringify({ id: toggle.dataset.toggleRole, action: toggle.dataset.nextAction }) }).then(load).catch((error) => { message.value = error instanceof Error ? error.message : "役割の状態を更新できませんでした。"; }); return; } if (remove) { void send(`/api/admin/genre-role-catalog/assignments?catalogId=${encodeURIComponent(remove.dataset.removeMember ?? "")}&email=${encodeURIComponent(remove.dataset.email ?? "")}`, { method: "DELETE" }).then(load).catch((error) => { message.value = error instanceof Error ? error.message : "担当メンバーを削除できませんでした。"; }); } });
    root.addEventListener("submit", (event) => {
      const form = (event.target as HTMLElement).closest<HTMLFormElement>("[data-role-assignment]");
      if (!form) return;
      event.preventDefault();
      const output = form.querySelector<HTMLOutputElement>("output");
      const values = Object.fromEntries(new FormData(form).entries());
      const release = lockAdminForm(form, "追加中…");
      void send("/api/admin/genre-role-catalog/assignments", { method: "POST", body: JSON.stringify({ catalogId: form.dataset.roleAssignment, email: values.email }) }).then(() => { if (output) output.value = "追加しました。"; form.reset(); return load(); }).catch((error) => { if (output) output.value = error instanceof Error ? error.message : "追加できませんでした。"; }).finally(release);
    });
    root.addEventListener("submit", (event) => { const form = (event.target as HTMLElement).closest<HTMLFormElement>("[data-role-editor]"); if (!form) return; event.preventDefault(); const values = Object.fromEntries(new FormData(form).entries()); const release = lockAdminForm(form, "保存中…"); void send("/api/admin/genre-role-catalog", { method: "PATCH", body: JSON.stringify({ id: form.dataset.roleEditor, action: "update", ...values }) }).then(load).catch((error) => { message.value = error instanceof Error ? error.message : "役割を更新できませんでした。"; }).finally(release); });

    void load().catch(() => undefined);
  };
  document.addEventListener("astro:page-load", initialize);
  initialize();
</script>

<style is:global>
  .role-management .role-card__assignment { align-items: end; border-top: 1px solid var(--border-default); display: grid; gap: .4rem; grid-template-columns: minmax(0, 1fr) auto; padding-top: .6rem; }
  .role-management .role-card__assignment label { color: var(--text-secondary); display: grid; font-size: .65rem; font-weight: 800; gap: .2rem; }
  .role-management .role-card__assignment input { background: var(--background-primary); border: 1px solid var(--border-default); color: var(--text-primary); font: inherit; min-height: 2rem; min-width: 0; padding: .35rem .4rem; }
  .role-management .role-card__assignment button { background: var(--accent-primary); border: 1px solid var(--accent-primary); color: #fff; cursor: pointer; font: inherit; font-size: .67rem; font-weight: 800; min-height: 2rem; padding: .35rem .5rem; }
  .role-management .role-card__assignment button:disabled { cursor: wait; opacity: .65; }
  .role-management .role-card__assignment output { color: var(--text-secondary); font-size: .65rem; grid-column: 1 / -1; min-height: 1rem; }
  @media (max-width: 520px) { .role-management .role-card__assignment { grid-template-columns: 1fr; } }
</style>
