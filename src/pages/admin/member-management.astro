---
import AdminLayout from "../../layouts/AdminLayout.astro";
import AdminRetryNotice from "../../components/admin/AdminRetryNotice.astro";
---

<AdminLayout title="運営メンバー管理" description="アトラス運営メンバーの名簿">
  <main class="member-management" data-member-management>
    <header class="page-heading"><div><h1>運営メンバー管理</h1></div><a href="/admin/manage/?project=atlas">← 管理トップ</a></header>
    <section class="toolbar" aria-label="名簿の表示設定"><label class="search">検索<input type="search" data-search placeholder="名前・メール・担当分野" /></label><div class="view-switch" role="group" aria-label="表示形式"><button type="button" data-view="list" aria-pressed="true">一覧</button><button type="button" data-view="tiles" aria-pressed="false">タイル</button></div><span data-count>読み込み中…</span><button type="button" class="load-more" data-load-more hidden>さらに読み込む</button></section>
    <section class="member-list-view" data-list-view aria-label="運営メンバー一覧"><div class="table-wrap"><table><thead><tr><th>メンバー</th><th>所属</th><th>役割</th><th>担当分野</th><th>最終確認</th><th>操作</th></tr></thead><tbody data-table-body><tr><td colspan="6">読み込み中…</td></tr></tbody></table></div></section>
    <section class="member-tile-view" data-tile-view aria-label="運営メンバーのタイル表示" hidden><div class="tile-grid" data-tile-grid></div></section>
    <AdminRetryNotice />
    <details class="verification-archive" data-verification-archive hidden>
      <summary><span>検証用アーカイブ</span><span class="verification-archive-count" data-verification-count>0件</span></summary>
      <p>テスト用アカウントは通常の名簿から分けて表示しています。アカウントやプロフィールは削除せず、検証用の記録として保持します。</p>
      <div class="verification-archive-list" data-verification-list></div>
    </details>
    <output class="message" data-message aria-live="polite"></output>
  </main>
</AdminLayout>

<style>
  .member-management{margin:0 auto;max-width:1200px;padding:0 1.25rem 4rem}.page-heading{align-items:end;border-bottom:1px solid var(--border-default);display:flex;gap:1rem;justify-content:space-between;padding:2rem 0 1.3rem}.page-heading h1{font-size:clamp(1.8rem,4vw,2.5rem);margin:.25rem 0 .45rem}.lead{color:var(--text-secondary);line-height:1.7;margin:0}.page-heading>a{color:var(--accent-primary);font-size:.8rem;font-weight:800;text-decoration:none;white-space:nowrap}.toolbar{align-items:end;display:flex;gap:.8rem;justify-content:space-between;margin:1.2rem 0 .7rem}.search{color:var(--text-secondary);display:grid;font-size:.74rem;font-weight:800;gap:.3rem;max-width:28rem;width:100%}.search input{background:var(--background-primary);border:1px solid var(--border-default);color:var(--text-primary);font:inherit;padding:.6rem .7rem}.view-switch{display:flex;gap:.35rem}.view-switch button{background:var(--background-secondary);border:1px solid var(--border-default);color:var(--text-secondary);cursor:pointer;font:inherit;font-size:.75rem;font-weight:800;padding:.52rem .75rem}.view-switch button[aria-pressed="true"]{background:var(--accent-primary);border-color:var(--accent-primary);color:var(--on-accent)}.toolbar>span{color:var(--text-secondary);font-size:.75rem;white-space:nowrap}.load-more{background:var(--background-secondary);border:1px solid var(--border-default);color:var(--text-primary);cursor:pointer;font:inherit;font-size:.72rem;padding:.5rem .7rem;white-space:nowrap}.load-more:hover{border-color:var(--accent-primary)}.load-more:disabled{cursor:wait;opacity:.65}.table-wrap{border:1px solid var(--border-default);overflow:auto}.member-list-view table{border-collapse:collapse;min-width:760px;width:100%}th,td{border-bottom:1px solid var(--border-default);padding:.72rem .8rem;text-align:left;vertical-align:middle}th{background:var(--background-secondary);color:var(--text-secondary);font-size:.7rem;letter-spacing:.03em;white-space:nowrap}td{font-size:.8rem}tbody tr:last-child td{border-bottom:0}.identity{align-items:center;display:flex;gap:.6rem;min-width:13rem}.avatar{align-items:center;background:var(--background-secondary);border:1px solid var(--border-default);border-radius:50%;color:var(--accent-primary);display:inline-flex;flex:0 0 2.25rem;font-size:.8rem;font-weight:800;height:2.25rem;justify-content:center;overflow:hidden;width:2.25rem}.avatar img{height:100%;object-fit:cover;width:100%}.identity-copy{display:grid;gap:.1rem}.identity-copy strong{font-size:.82rem}.identity-copy small,.muted{color:var(--text-secondary);font-size:.7rem}.role,.assignment{display:flex;flex-wrap:wrap;gap:.25rem}.chip{background:var(--background-secondary);border:1px solid var(--border-default);border-radius:999px;color:var(--text-secondary);font-size:.66rem;padding:.2rem .4rem;white-space:nowrap}.chip--accent{color:var(--accent-primary)}.tile-grid{display:grid;gap:.75rem;grid-template-columns:repeat(auto-fill,minmax(290px,1fr))}.participant-card{background:var(--background-primary);border:1px solid var(--border-default);display:grid;gap:.7rem;min-width:0;padding:.85rem}.participant-card:hover{border-color:var(--accent-primary)}.participant-card__top{align-items:center;display:flex;gap:.65rem;min-width:0}.participant-card .avatar{flex-basis:1.9rem;font-size:.72rem;height:1.9rem;width:1.9rem}.participant-card__identity{min-width:0}.participant-card__name{font-size:.98rem;font-weight:800;line-height:1.3}.participant-card__email{color:var(--text-secondary);font-size:.72rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.participant-card__role{background:var(--background-secondary);border:1px solid var(--border-default);border-radius:999px;font-size:.7rem;margin-left:auto;padding:.22rem .42rem;white-space:nowrap}.participant-card__access{display:grid;gap:.45rem}.participant-card__facts{display:flex;flex-wrap:wrap;gap:.35rem}.participant-fact{background:var(--background-secondary);border:1px solid var(--border-default);border-radius:999px;color:var(--text-secondary);font-size:.7rem;line-height:1.2;padding:.25rem .42rem}.participant-fact b{color:var(--accent-primary)}.participant-card__discord{border-top:1px solid var(--border-default);display:grid;gap:.4rem;padding-top:.6rem}.participant-card__discord-heading{align-items:center;display:flex;justify-content:space-between}.participant-card__discord-heading strong{font-size:.75rem}.participant-card__discord-state{border:1px solid var(--border-default);border-radius:999px;color:var(--text-secondary);font-size:.66rem;padding:.18rem .4rem}.participant-card__discord-state[data-state="connected"]{border-color:var(--success);color:var(--success)}.participant-role-chips{display:flex;flex-wrap:wrap;gap:.28rem}.participant-role-chip{background:var(--background-secondary);border:1px solid var(--border-default);border-radius:999px;color:var(--text-secondary);font-size:.66rem;padding:.2rem .38rem}.participant-role-chip--empty{color:var(--text-muted)}.empty{color:var(--text-secondary);padding:2rem;text-align:center}.message{color:var(--text-secondary);display:block;font-size:.8rem;min-height:1.3rem;padding-top:.7rem}@media(max-width:700px){.member-management{padding:0 .8rem 3rem}.page-heading{align-items:start;display:grid}.toolbar{align-items:stretch;display:grid}.view-switch{justify-content:flex-start}.toolbar>span,.load-more{justify-self:start}}
  .verification-archive { border: 1px solid var(--border-default); margin-top: 1rem; }
  .verification-archive summary { align-items: center; color: var(--text-secondary); cursor: pointer; display: flex; font-size: .8rem; font-weight: 800; gap: .6rem; justify-content: space-between; list-style: none; padding: .7rem .8rem; }
  .verification-archive summary::-webkit-details-marker { display: none; }
  .verification-archive summary::before { color: var(--text-muted); content: "▸"; }
  .verification-archive[open] summary::before { content: "▾"; }
  .verification-archive-count { color: var(--text-muted); font-size: .7rem; font-variant-numeric: tabular-nums; }
  .verification-archive > p { border-top: 1px solid var(--border-default); color: var(--text-secondary); font-size: .74rem; line-height: 1.55; margin: 0; padding: .7rem .8rem; }
  .verification-archive-list { border-top: 1px solid var(--border-default); display: grid; gap: .45rem; padding: .7rem .8rem; }
  .verification-member { align-items: center; background: var(--background-secondary); border: 1px solid var(--border-default); display: flex; gap: .6rem; min-width: 0; padding: .5rem .6rem; }
  .verification-member .avatar { flex-basis: 1.8rem; height: 1.8rem; width: 1.8rem; }
  .verification-member-copy { display: grid; gap: .1rem; min-width: 0; }
  .verification-member-copy strong { font-size: .78rem; }
  .verification-member-copy small { color: var(--text-secondary); font-size: .68rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .verification-member-label { color: var(--text-muted); font-size: .66rem; margin-left: auto; white-space: nowrap; }
</style>

<style is:global>
  /* APIから後から挿入する行はAstroのスコープ属性を持たないため、一覧の構造を明示的に共有する。 */
  [data-member-management] .member-list-view .table-wrap { overflow-x: auto; }
  [data-member-management] .member-list-view table { border-collapse: collapse; min-width: 760px; table-layout: auto; width: 100%; }
  [data-member-management] .member-list-view th,
  [data-member-management] .member-list-view td { border-bottom: 1px solid var(--border-default); padding: .72rem .8rem; text-align: left; vertical-align: middle; }
  [data-member-management] .member-list-view th { background: var(--background-secondary); color: var(--text-secondary); font-size: .7rem; letter-spacing: .03em; white-space: nowrap; }
  [data-member-management] .member-list-view td { font-size: .8rem; }
  [data-member-management] .member-list-view tbody tr:last-child td { border-bottom: 0; }
  [data-member-management] .member-list-view .identity { align-items: center; display: flex; gap: .6rem; min-width: 15rem; }
  [data-member-management] .avatar { align-items: center; background: var(--background-secondary); border: 1px solid var(--border-default); border-radius: 50%; color: var(--accent-primary); display: inline-flex; flex: 0 0 2.25rem; font-size: .8rem; font-weight: 800; height: 2.25rem; justify-content: center; overflow: hidden; width: 2.25rem; }
  [data-member-management] .avatar img { display: block; height: 100%; object-fit: cover; width: 100%; }
  [data-member-management] .identity-copy { display: grid; gap: .1rem; min-width: 0; }
  [data-member-management] .identity-copy strong { font-size: .82rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  [data-member-management] .identity-copy small,
  [data-member-management] .muted { color: var(--text-secondary); font-size: .7rem; }
  [data-member-management] .role,
  [data-member-management] .assignment { display: flex; flex-wrap: wrap; gap: .25rem; }
  [data-member-management] .chip { background: var(--background-secondary); border: 1px solid var(--border-default); border-radius: 999px; color: var(--text-secondary); font-size: .66rem; padding: .2rem .4rem; white-space: nowrap; }
  [data-member-management] .chip--accent { color: var(--accent-primary); }
  [data-member-management] .member-remove { background: transparent; border: 1px solid color-mix(in srgb, var(--danger) 55%, var(--border-default)); border-radius: .3rem; color: var(--danger); cursor: pointer; font: inherit; font-size: .68rem; padding: .3rem .48rem; white-space: nowrap; }
  [data-member-management] .member-remove:hover { background: color-mix(in srgb, var(--danger) 12%, transparent); }
  [data-member-management] .member-remove:disabled { cursor: wait; opacity: .55; }
  [data-member-management] .member-card__actions { align-items: center; display: flex; gap: .45rem; justify-content: flex-end; }
  [data-member-management] .participant-card__actions { border-top: 1px solid var(--border-default); display: flex; justify-content: flex-end; padding-top: .6rem; }
  [data-member-management] .empty { color: var(--text-secondary); padding: 2rem; text-align: center; }

  [data-member-management] .participant-card{background:var(--background-primary);border:1px solid var(--border-default);display:grid;gap:.7rem;min-width:0;padding:.85rem}
  [data-member-management] .participant-card:hover{border-color:var(--accent-primary)}
  [data-member-management] .participant-card__top{align-items:center;display:flex;gap:.65rem;min-width:0}
  [data-member-management] .participant-card .avatar{align-items:center;background:var(--background-secondary);border:1px solid var(--border-default);border-radius:50%;color:var(--accent-primary);display:inline-flex;flex:0 0 1.9rem;font-size:.72rem;font-weight:800;height:1.9rem;justify-content:center;overflow:hidden;width:1.9rem}
  [data-member-management] .participant-card .avatar img{height:100%;object-fit:cover;width:100%}
  [data-member-management] .participant-card__identity{min-width:0}
  [data-member-management] .participant-card__name{font-size:.98rem;font-weight:800;line-height:1.3}
  [data-member-management] .participant-card__email{color:var(--text-secondary);font-size:.72rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  [data-member-management] .participant-card__role{background:var(--background-secondary);border:1px solid var(--border-default);border-radius:999px;font-size:.7rem;margin-left:auto;padding:.22rem .42rem;white-space:nowrap}
  [data-member-management] .participant-card__access{display:grid;gap:.45rem}
  [data-member-management] .participant-card__facts{display:flex;flex-wrap:wrap;gap:.35rem}
  [data-member-management] .participant-fact{background:var(--background-secondary);border:1px solid var(--border-default);border-radius:999px;color:var(--text-secondary);font-size:.7rem;line-height:1.2;padding:.25rem .42rem}
  [data-member-management] .participant-fact b{color:var(--accent-primary)}
  [data-member-management] .participant-card__discord{border-top:1px solid var(--border-default);display:grid;gap:.4rem;padding-top:.6rem}
  [data-member-management] .participant-card__discord-heading{align-items:center;display:flex;justify-content:space-between}
  [data-member-management] .participant-card__discord-heading strong{font-size:.75rem}
  [data-member-management] .participant-card__discord-state{border:1px solid var(--border-default);border-radius:999px;color:var(--text-secondary);font-size:.66rem;padding:.18rem .4rem}
  [data-member-management] .participant-card__discord-state[data-state="connected"]{border-color:var(--success);color:var(--success)}
  [data-member-management] .participant-role-chips{display:flex;flex-wrap:wrap;gap:.28rem}
  [data-member-management] .participant-role-chip{background:var(--background-secondary);border:1px solid var(--border-default);border-radius:999px;color:var(--text-secondary);font-size:.66rem;padding:.2rem .38rem}
  [data-member-management] .participant-role-chip--empty{color:var(--text-muted)}
</style>

<script>
  import { createAdminLoadRetry } from "../../scripts/admin-load-retry";

  type Member = { email?: string; display_name?: string; university?: string; year?: string; role?: string; avatar_url?: string; assignments?: string[]; subjectAssignments?: string[]; workflowSubjects?: string[] };
  type Participant = { email?: string; display_name?: string; university?: string; year?: string; interests?: string; avatar_url?: string; discord_user_id?: string; discord_role_ids?: string; subjects?: string };
  type Pagination = { limit?: number; nextCursor?: string | null; hasMore?: boolean };
  type ResponseData = { members?: Member[]; pagination?: Pagination; error?: string };
  type ParticipantResponse = { permissions?: Participant[]; pagination?: Pagination; error?: string };
  const initialize = () => { const root = document.querySelector<HTMLElement>("[data-member-management]"); if (!root || root.dataset.ready) return; root.dataset.ready = "true"; const table = root.querySelector<HTMLElement>("[data-table-body]")!; const tiles = root.querySelector<HTMLElement>("[data-tile-grid]")!; const search = root.querySelector<HTMLInputElement>("[data-search]")!; const count = root.querySelector<HTMLElement>("[data-count]")!; const loadMoreButton = root.querySelector<HTMLButtonElement>("[data-load-more]")!; const listView = root.querySelector<HTMLElement>("[data-list-view]")!; const tileView = root.querySelector<HTMLElement>("[data-tile-view]")!; const message = root.querySelector<HTMLOutputElement>("[data-message]")!; let members: Member[] = []; let participants: Participant[] = []; let memberCursor: string | null = null; let participantCursor: string | null = null; let membersHaveMore = false; let participantsHaveMore = false; let loadingMore = false;
    const esc = (value: unknown) => String(value ?? "").replace(/[&<>"']/g, (character) => ({ "&":"&amp;", "<":"&lt;", ">":"&gt;", '"':"&quot;", "'":"&#39;" })[character] ?? character);
    const memberName = (member: Member | Participant) => member.display_name?.trim() || "表示名未設定";
    const avatar = (member: Member | Participant) => member.avatar_url?.trim() ? `<span class="avatar"><img src="${esc(member.avatar_url)}" alt="" loading="lazy" /></span>` : `<span class="avatar" aria-hidden="true">${esc(memberName(member).slice(0,1))}</span>`;
    const chips = (items: string[] = [], accent = false) => items.length ? items.map((item) => `<span class="chip${accent ? " chip--accent" : ""}">${esc(item)}</span>`).join("") : '<span class="muted">未設定</span>';
    const participantSubjects = (participant: Participant) => String(participant.subjects ?? "").split(",").map((subject) => subject.trim()).filter(Boolean);
    const participantRoleIds = (participant: Participant) => String(participant.discord_role_ids ?? "").split(",").map((role) => role.trim()).filter(Boolean);
    const render = () => { const query = search.value.trim().toLocaleLowerCase(); const filtered = members.filter((member) => `${memberName(member)} ${member.email ?? ""} ${member.university ?? ""} ${(member.assignments ?? []).join(" ")}`.toLocaleLowerCase().includes(query)); count.textContent = `${filtered.length} / ${members.length}人`; if (!filtered.length) { table.innerHTML = '<tr><td colspan="6" class="empty">条件に一致するメンバーはいません。</td></tr>'; return; } table.innerHTML = filtered.map((member) => `<tr><td><div class="identity">${avatar(member)}<span class="identity-copy"><strong>${esc(memberName(member))}</strong><small>${esc(member.email)}</small></span></div></td><td>${esc([member.university, member.year].filter(Boolean).join(" / ") || "未登録")}</td><td><div class="role">${chips([member.role === "manager" ? "運営統括" : "運営メンバー"], true)}</div></td><td><div class="assignment">${chips(member.assignments)}</div></td><td class="muted">現在の登録情報</td><td><button type="button" class="member-remove" data-remove-member data-email="${esc(member.email)}">削除</button></td></tr>`).join(""); };
    const renderParticipants = () => { const query = search.value.trim().toLocaleLowerCase(); const filtered = participants.filter((participant) => `${memberName(participant)} ${participant.email ?? ""} ${participant.discord_user_id ?? ""} ${participant.university ?? ""}`.toLocaleLowerCase().includes(query)); if (!filtered.length) { tiles.innerHTML = '<p class="empty">条件に一致する参加者はいません。</p>'; return; } tiles.innerHTML = filtered.map((participant) => { const subjects = participantSubjects(participant); const roles = subjects.map((subject) => subject === "*" ? "全分野管理" : subject); const roleIds = participantRoleIds(participant); const roleChips = roleIds.length ? roleIds.slice(0, 4).map((role) => `<span class="participant-role-chip">${esc(role)}</span>`).join("") : '<span class="participant-role-chip participant-role-chip--empty">未付与</span>'; return `<article class="participant-card"><div class="participant-card__top">${avatar(participant)}<div class="participant-card__identity"><strong class="participant-card__name">${esc(memberName(participant))}</strong><div class="participant-card__email">${esc(participant.email)}</div></div><span class="participant-card__role">${esc(roles.join("・") || "担当未設定")}</span></div><div class="participant-card__access"><div class="participant-card__facts"><span class="participant-fact"><b>所属</b> ${esc(participant.university || "未登録")}</span><span class="participant-fact"><b>学年</b> ${esc(participant.year || "未登録")}</span><span class="participant-fact"><b>分野</b> ${esc(participant.interests || "未登録")}</span></div></div><div class="participant-card__discord"><div class="participant-card__discord-heading"><strong>Discord</strong><span class="participant-card__discord-state" data-state="${participant.discord_user_id ? "connected" : "unconnected"}">${participant.discord_user_id ? "連携済み" : "未連携"}</span></div><div class="participant-role-chips">${roleChips}</div></div><div class="participant-card__actions"><button type="button" class="member-remove" data-remove-member data-email="${esc(participant.email)}">削除</button></div></article>`; }).join(""); };
    const updateLoadMore = () => { const visible = membersHaveMore || participantsHaveMore; loadMoreButton.hidden = !visible; loadMoreButton.disabled = loadingMore; loadMoreButton.textContent = loadingMore ? "読み込み中…" : "さらに読み込む"; };
    const setView = (view: string) => { const tilesMode = view === "tiles"; listView.hidden = tilesMode; tileView.hidden = !tilesMode; root.querySelectorAll<HTMLButtonElement>("[data-view]").forEach((button) => button.setAttribute("aria-pressed", String(button.dataset.view === view))); if (tilesMode) renderParticipants(); else render(); };
    search.addEventListener("input", () => { render(); renderParticipants(); }); root.querySelectorAll<HTMLButtonElement>("[data-view]").forEach((button) => button.addEventListener("click", () => setView(button.dataset.view ?? "list")));
    const loadMore = async () => { if (loadingMore || (!membersHaveMore && !participantsHaveMore)) return; loadingMore = true; updateLoadMore(); message.value = "追加のメンバーを読み込んでいます…"; try { const requests: Promise<Response>[] = []; if (membersHaveMore && memberCursor) requests.push(fetch(`/api/admin/genre-overviews?project=atlas&limit=50&cursor=${encodeURIComponent(memberCursor)}`, { credentials: "same-origin", cache: "no-store" })); if (participantsHaveMore && participantCursor) requests.push(fetch(`/api/admin/report-admin-permissions?limit=50&cursor=${encodeURIComponent(participantCursor)}`, { credentials: "same-origin", cache: "no-store" })); const responses = await Promise.all(requests); for (const response of responses) { const data = await response.json() as ResponseData & ParticipantResponse; if (!response.ok) throw new Error(data.error ?? "追加のメンバーを読み込めませんでした。"); if (Array.isArray(data.members)) members = [...members, ...data.members]; if (data.pagination && Array.isArray(data.members)) { memberCursor = data.pagination.nextCursor ?? null; membersHaveMore = Boolean(data.pagination.hasMore); } if (Array.isArray(data.permissions)) participants = [...participants, ...data.permissions]; if (data.pagination && Array.isArray(data.permissions)) { participantCursor = data.pagination.nextCursor ?? null; participantsHaveMore = Boolean(data.pagination.hasMore); } } render(); renderParticipants(); message.value = "追加のメンバーを読み込みました。"; } catch (error) { message.value = error instanceof Error ? error.message : "追加のメンバーを読み込めませんでした。"; } finally { loadingMore = false; updateLoadMore(); } };
    loadMoreButton.addEventListener("click", () => { void loadMore(); });
    root.addEventListener("click", (event) => { const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-remove-member]"); if (!button) return; const email = button.dataset.email ?? ""; if (!email || !window.confirm(`${email} を運営メンバーから削除しますか？\nプロフィールとアカウントは残ります。`)) return; button.disabled = true; message.value = "削除しています…"; void fetch(`/api/admin/member-management?email=${encodeURIComponent(email)}`, { method: "DELETE", credentials: "same-origin" }).then(async (response) => { const data = await response.json().catch(() => ({})); if (!response.ok) throw new Error(data.error ?? "メンバーを削除できませんでした。"); message.value = "運営メンバーから削除しました。"; return data; }).then(() => load()).catch((error) => { message.value = error instanceof Error ? error.message : "メンバーを削除できませんでした。"; }).finally(() => { button.disabled = false; }); });
    let load: () => Promise<void>;
    const retry = createAdminLoadRetry(root, () => load(), "メンバー情報を読み込めませんでした。");
    load = async () => { root.setAttribute("aria-busy", "true"); retry.begin(); try { const [memberData, participantData] = await Promise.all([fetch("/api/admin/genre-overviews?project=atlas&limit=50", { credentials: "same-origin", cache: "no-store" }).then(async (response) => { const data = await response.json() as ResponseData; if (!response.ok) throw new Error(data.error ?? "メンバー情報を読み込めませんでした。"); return data; }), fetch("/api/admin/report-admin-permissions?limit=50", { credentials: "same-origin", cache: "no-store" }).then(async (response) => { const data = await response.json() as ParticipantResponse; if (!response.ok) throw new Error(data.error ?? "参加者一覧を読み込めませんでした。"); return data; }).catch(() => null)]); members = memberData.members ?? []; memberCursor = memberData.pagination?.nextCursor ?? null; membersHaveMore = Boolean(memberData.pagination?.hasMore); participants = participantData?.permissions ?? members.map((member) => ({ email: member.email, display_name: member.display_name, university: member.university, year: member.year, avatar_url: member.avatar_url, subjects: [...(member.subjectAssignments ?? []), ...(member.workflowSubjects ?? [])].join(",") })); participantCursor = participantData?.pagination?.nextCursor ?? null; participantsHaveMore = Boolean(participantData?.pagination?.hasMore); render(); renderParticipants(); updateLoadMore(); retry.success(); } catch (error) { const message = error instanceof Error ? error.message : "メンバー情報を読み込めませんでした。"; table.innerHTML = `<tr><td colspan="6" class="empty">${esc(message)}</td></tr>`; tiles.innerHTML = `<p class="empty">${esc(message)}</p>`; count.textContent = "—"; loadMoreButton.hidden = true; retry.fail(error); throw error; } finally { root.removeAttribute("aria-busy"); } };
    void load().catch(() => undefined);
  }; document.addEventListener("astro:page-load", initialize); initialize();
</script>

<script>
  // 検証用アカウントは通常の名簿から分離して保持する。APIやプロフィールは削除しない。
  const isolateVerificationAccounts = () => {
    const root = document.querySelector<HTMLElement>("[data-member-management]");
    if (!root || root.dataset.verificationReady === "true") return;
    root.dataset.verificationReady = "true";
    const table = root.querySelector<HTMLElement>("[data-table-body]");
    const tiles = root.querySelector<HTMLElement>("[data-tile-grid]");
    const archive = root.querySelector<HTMLElement>("[data-verification-archive]");
    const archiveList = root.querySelector<HTMLElement>("[data-verification-list]");
    const archiveCount = root.querySelector<HTMLElement>("[data-verification-count]");
    if (!table || !tiles || !archive || !archiveList || !archiveCount) return;
    const isVerificationEmail = (value: string) => { const email = value.trim().toLocaleLowerCase(); return email.endsWith("@example.com") || email.endsWith("@atlasez.test"); };
    const escape = (value: string) => value.replace(/[&<>\"']/g, (character) => ({ "&":"&amp;", "<":"&lt;", ">":"&gt;", '\"':"&quot;", "'":"&#39;" })[character] ?? character);
    const sync = () => {
      const records = new Map<string, { name: string; email: string }>();
      table.querySelectorAll<HTMLElement>("tr").forEach((row) => {
        const email = row.querySelector<HTMLElement>(".identity-copy small")?.textContent?.trim() ?? "";
        if (!isVerificationEmail(email)) return;
        row.hidden = true;
        const name = row.querySelector<HTMLElement>(".identity-copy strong")?.textContent?.trim() || "表示名未設定";
        records.set(email.toLocaleLowerCase(), { name, email });
      });
      tiles.querySelectorAll<HTMLElement>(".participant-card").forEach((card) => {
        const email = card.querySelector<HTMLElement>(".participant-card__email")?.textContent?.trim() ?? "";
        if (!isVerificationEmail(email)) return;
        card.hidden = true;
        const name = card.querySelector<HTMLElement>(".participant-card__name")?.textContent?.trim() || "表示名未設定";
        records.set(email.toLocaleLowerCase(), { name, email });
      });
      const entries = [...records.values()];
      archiveCount.textContent = `${entries.length}件`;
      archive.hidden = entries.length === 0;
      archiveList.innerHTML = entries.map((entry) => `<div class="verification-member"><span class="avatar" aria-hidden="true">${escape(entry.name.slice(0, 1))}</span><span class="verification-member-copy"><strong>${escape(entry.name)}</strong><small>${escape(entry.email)}</small></span><span class="verification-member-label">検証用・保持</span></div>`).join("");
      const visibleRows = [...table.querySelectorAll<HTMLTableRowElement>("tr")].filter((row) => !row.hidden && row.querySelector(".identity-copy"));
      const count = root.querySelector<HTMLElement>("[data-count]");
      if (count) {
        const rawCount = count.textContent ?? "";
        if (rawCount !== count.dataset.verificationRendered) count.dataset.verificationBase = rawCount;
        const base = count.dataset.verificationBase ?? rawCount;
        const match = base.match(/^(\d+)\s*\/\s*(\d+)人$/);
        const hiddenTableRows = table.querySelectorAll("tr[hidden]").length;
        count.textContent = match ? `${Math.max(0, Number(match[1]) - hiddenTableRows)} / ${Math.max(0, Number(match[2]) - records.size)}人` : `${visibleRows.length}件（検証用を除く）`;
        count.dataset.verificationRendered = count.textContent;
      }
    };
    const observer = new MutationObserver(sync);
    observer.observe(table, { childList: true, subtree: true });
    observer.observe(tiles, { childList: true, subtree: true });
    sync();
  };
  document.addEventListener("astro:page-load", isolateVerificationAccounts);
  isolateVerificationAccounts();
</script>
