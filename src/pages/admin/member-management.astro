---
import AdminLayout from "../../layouts/AdminLayout.astro";
---

<AdminLayout title="運営メンバー管理" description="アトラス運営メンバーの名簿">
  <main class="member-management" data-member-management>
    <header class="page-heading"><div><p class="eyebrow">ATLAS / PEOPLE</p><h1>運営メンバー管理</h1><p class="lead">アトラスに参加している運営メンバーを、名簿またはタイルで確認できます。</p></div><a href="/admin/manage/?project=atlas">← 管理トップ</a></header>
    <section class="toolbar" aria-label="名簿の表示設定"><label class="search">検索<input type="search" data-search placeholder="名前・メール・担当分野" /></label><div class="view-switch" role="group" aria-label="表示形式"><button type="button" data-view="list" aria-pressed="true">一覧</button><button type="button" data-view="tiles" aria-pressed="false">タイル</button></div><span data-count>読み込み中…</span></section>
    <section class="member-list-view" data-list-view aria-label="運営メンバー一覧"><div class="table-wrap"><table><thead><tr><th>メンバー</th><th>所属</th><th>役割</th><th>担当分野</th><th>最終確認</th></tr></thead><tbody data-table-body><tr><td colspan="5">読み込み中…</td></tr></tbody></table></div></section>
    <section class="member-tile-view" data-tile-view aria-label="運営メンバーのタイル表示" hidden><div class="tile-grid" data-tile-grid></div></section>
    <output class="message" data-message aria-live="polite"></output>
  </main>
</AdminLayout>

<style>
  .member-management{margin:0 auto;max-width:1200px;padding:0 1.25rem 4rem}.page-heading{align-items:end;border-bottom:1px solid var(--border-default);display:flex;gap:1rem;justify-content:space-between;padding:2rem 0 1.3rem}.eyebrow{color:var(--accent-primary);font-size:.7rem;font-weight:800;letter-spacing:.1em;margin:0}.page-heading h1{font-size:clamp(1.8rem,4vw,2.5rem);margin:.25rem 0 .45rem}.lead{color:var(--text-secondary);line-height:1.7;margin:0}.page-heading>a{color:var(--accent-primary);font-size:.8rem;font-weight:800;text-decoration:none;white-space:nowrap}.toolbar{align-items:end;display:flex;gap:.8rem;justify-content:space-between;margin:1.2rem 0 .7rem}.search{color:var(--text-secondary);display:grid;font-size:.74rem;font-weight:800;gap:.3rem;max-width:28rem;width:100%}.search input{background:var(--background-primary);border:1px solid var(--border-default);color:var(--text-primary);font:inherit;padding:.6rem .7rem}.view-switch{display:flex;gap:.35rem}.view-switch button{background:var(--background-secondary);border:1px solid var(--border-default);color:var(--text-secondary);cursor:pointer;font:inherit;font-size:.75rem;font-weight:800;padding:.52rem .75rem}.view-switch button[aria-pressed="true"]{background:var(--accent-primary);border-color:var(--accent-primary);color:#fff}.toolbar>span{color:var(--text-secondary);font-size:.75rem;white-space:nowrap}.table-wrap{border:1px solid var(--border-default);overflow:auto}.member-list-view table{border-collapse:collapse;min-width:760px;width:100%}th,td{border-bottom:1px solid var(--border-default);padding:.72rem .8rem;text-align:left;vertical-align:middle}th{background:var(--background-secondary);color:var(--text-secondary);font-size:.7rem;letter-spacing:.03em;white-space:nowrap}td{font-size:.8rem}tbody tr:last-child td{border-bottom:0}.identity{align-items:center;display:flex;gap:.6rem;min-width:13rem}.avatar{align-items:center;background:var(--background-secondary);border:1px solid var(--border-default);border-radius:50%;color:var(--accent-primary);display:inline-flex;flex:0 0 2.25rem;font-size:.8rem;font-weight:800;height:2.25rem;justify-content:center;overflow:hidden;width:2.25rem}.avatar img{height:100%;object-fit:cover;width:100%}.identity-copy{display:grid;gap:.1rem}.identity-copy strong{font-size:.82rem}.identity-copy small,.muted{color:var(--text-secondary);font-size:.7rem}.role,.assignment{display:flex;flex-wrap:wrap;gap:.25rem}.chip{background:var(--background-secondary);border:1px solid var(--border-default);border-radius:999px;color:var(--text-secondary);font-size:.66rem;padding:.2rem .4rem;white-space:nowrap}.chip--accent{color:var(--accent-primary)}.tile-grid{display:grid;gap:.75rem;grid-template-columns:repeat(auto-fill,minmax(290px,1fr))}.participant-card{background:var(--background-primary);border:1px solid var(--border-default);display:grid;gap:.7rem;min-width:0;padding:.85rem}.participant-card:hover{border-color:var(--accent-primary)}.participant-card__top{align-items:center;display:flex;gap:.65rem;min-width:0}.participant-card .avatar{flex-basis:1.9rem;font-size:.72rem;height:1.9rem;width:1.9rem}.participant-card__identity{min-width:0}.participant-card__name{font-size:.98rem;font-weight:800;line-height:1.3}.participant-card__email{color:var(--text-secondary);font-size:.72rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.participant-card__role{background:var(--background-secondary);border:1px solid var(--border-default);border-radius:999px;font-size:.7rem;margin-left:auto;padding:.22rem .42rem;white-space:nowrap}.participant-card__access{display:grid;gap:.45rem}.participant-card__facts{display:flex;flex-wrap:wrap;gap:.35rem}.participant-fact{background:var(--background-secondary);border:1px solid var(--border-default);border-radius:999px;color:var(--text-secondary);font-size:.7rem;line-height:1.2;padding:.25rem .42rem}.participant-fact b{color:var(--accent-primary)}.participant-card__discord{border-top:1px solid var(--border-default);display:grid;gap:.4rem;padding-top:.6rem}.participant-card__discord-heading{align-items:center;display:flex;justify-content:space-between}.participant-card__discord-heading strong{font-size:.75rem}.participant-card__discord-state{border:1px solid var(--border-default);border-radius:999px;color:var(--text-secondary);font-size:.66rem;padding:.18rem .4rem}.participant-card__discord-state[data-state="connected"]{border-color:#72c98b;color:#72c98b}.participant-role-chips{display:flex;flex-wrap:wrap;gap:.28rem}.participant-role-chip{background:var(--background-secondary);border:1px solid var(--border-default);border-radius:999px;color:var(--text-secondary);font-size:.66rem;padding:.2rem .38rem}.participant-role-chip--empty{color:var(--text-muted)}.empty{color:var(--text-secondary);padding:2rem;text-align:center}.message{color:var(--text-secondary);display:block;font-size:.8rem;min-height:1.3rem;padding-top:.7rem}@media(max-width:700px){.member-management{padding:0 .8rem 3rem}.page-heading{align-items:start;display:grid}.toolbar{align-items:stretch;display:grid}.view-switch{justify-content:flex-start}.toolbar>span{justify-self:start}}
</style>

<style is:global>
  [data-member-management] .participant-card{background:var(--background-primary);border:1px solid var(--border-default);display:grid;gap:.7rem;min-width:0;padding:.85rem}
  [data-member-management] .participant-card:hover{border-color:var(--accent-primary)}
  [data-member-management] .participant-card__top{align-items:center;display:flex;gap:.65rem;min-width:0}
  [data-member-management] .participant-card .avatar{align-items:center;background:var(--background-secondary);border:1px solid var(--border-default);border-radius:50%;color:var(--accent-primary);display:inline-flex;flex:0 0 1.9rem;font-size:.72rem;font-weight:800;height:1.9rem;justify-content:center;overflow:hidden;width:1.9rem}
  [data-member-management] .participant-card .avatar img{height:100%;object-fit:cover;width:100%}
  [data-member-management] .participant-card__identity{min-width:0}
  [data-member-management] .participant-card__name{font-size:.98rem;font-weight:800;line-height:1.3}
  [data-member-management] .participant-card__email{color:var(--text-secondary);font-size:.72rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  [data-member-management] .participant-card__role{background:var(--background-secondary);border:1px solid var(--border-default);border-radius:999px;font-size:.7rem;margin-left:auto;padding:.22rem .42rem;white-space:nowrap}
  [data-member-management] .participant-card__access{display:grid;gap:.45rem}
  [data-member-management] .participant-card__facts{display:flex;flex-wrap:wrap;gap:.35rem}
  [data-member-management] .participant-fact{background:var(--background-secondary);border:1px solid var(--border-default);border-radius:999px;color:var(--text-secondary);font-size:.7rem;line-height:1.2;padding:.25rem .42rem}
  [data-member-management] .participant-fact b{color:var(--accent-primary)}
  [data-member-management] .participant-card__discord{border-top:1px solid var(--border-default);display:grid;gap:.4rem;padding-top:.6rem}
  [data-member-management] .participant-card__discord-heading{align-items:center;display:flex;justify-content:space-between}
  [data-member-management] .participant-card__discord-heading strong{font-size:.75rem}
  [data-member-management] .participant-card__discord-state{border:1px solid var(--border-default);border-radius:999px;color:var(--text-secondary);font-size:.66rem;padding:.18rem .4rem}
  [data-member-management] .participant-card__discord-state[data-state="connected"]{border-color:#72c98b;color:#72c98b}
  [data-member-management] .participant-role-chips{display:flex;flex-wrap:wrap;gap:.28rem}
  [data-member-management] .participant-role-chip{background:var(--background-secondary);border:1px solid var(--border-default);border-radius:999px;color:var(--text-secondary);font-size:.66rem;padding:.2rem .38rem}
  [data-member-management] .participant-role-chip--empty{color:var(--text-muted)}
</style>

<script>
  type Member = { email?: string; display_name?: string; university?: string; year?: string; role?: string; avatar_url?: string; assignments?: string[]; subjectAssignments?: string[]; workflowSubjects?: string[] };
  type Participant = { email?: string; display_name?: string; university?: string; year?: string; interests?: string; avatar_url?: string; discord_user_id?: string; discord_role_ids?: string; subjects?: string };
  type ResponseData = { members?: Member[]; error?: string };
  type ParticipantResponse = { permissions?: Participant[]; error?: string };
  const initialize = () => { const root = document.querySelector<HTMLElement>("[data-member-management]"); if (!root || root.dataset.ready) return; root.dataset.ready = "true"; const table = root.querySelector<HTMLElement>("[data-table-body]")!; const tiles = root.querySelector<HTMLElement>("[data-tile-grid]")!; const search = root.querySelector<HTMLInputElement>("[data-search]")!; const count = root.querySelector<HTMLElement>("[data-count]")!; const listView = root.querySelector<HTMLElement>("[data-list-view]")!; const tileView = root.querySelector<HTMLElement>("[data-tile-view]")!; let members: Member[] = []; let participants: Participant[] = [];
    const esc = (value: unknown) => String(value ?? "").replace(/[&<>"']/g, (character) => ({ "&":"&amp;", "<":"&lt;", ">":"&gt;", '"':"&quot;", "'":"&#39;" })[character] ?? character);
    const memberName = (member: Member | Participant) => member.display_name?.trim() || "表示名未設定";
    const avatar = (member: Member | Participant) => member.avatar_url?.trim() ? `<span class="avatar"><img src="${esc(member.avatar_url)}" alt="" loading="lazy" /></span>` : `<span class="avatar" aria-hidden="true">${esc(memberName(member).slice(0,1))}</span>`;
    const chips = (items: string[] = [], accent = false) => items.length ? items.map((item) => `<span class="chip${accent ? " chip--accent" : ""}">${esc(item)}</span>`).join("") : '<span class="muted">未設定</span>';
    const participantSubjects = (participant: Participant) => String(participant.subjects ?? "").split(",").map((subject) => subject.trim()).filter(Boolean);
    const participantRoleIds = (participant: Participant) => String(participant.discord_role_ids ?? "").split(",").map((role) => role.trim()).filter(Boolean);
    const render = () => { const query = search.value.trim().toLocaleLowerCase(); const filtered = members.filter((member) => `${memberName(member)} ${member.email ?? ""} ${member.university ?? ""} ${(member.assignments ?? []).join(" ")}`.toLocaleLowerCase().includes(query)); count.textContent = `${filtered.length} / ${members.length}人`; if (!filtered.length) { table.innerHTML = '<tr><td colspan="5" class="empty">条件に一致するメンバーはいません。</td></tr>'; return; } table.innerHTML = filtered.map((member) => `<tr><td><div class="identity">${avatar(member)}<span class="identity-copy"><strong>${esc(memberName(member))}</strong><small>${esc(member.email)}</small></span></div></td><td>${esc([member.university, member.year].filter(Boolean).join(" / ") || "未登録")}</td><td><div class="role">${chips([member.role === "manager" ? "運営統括" : "運営メンバー"], true)}</div></td><td><div class="assignment">${chips(member.assignments)}</div></td><td class="muted">現在の登録情報</td></tr>`).join(""); };
    const renderParticipants = () => { const query = search.value.trim().toLocaleLowerCase(); const filtered = participants.filter((participant) => `${memberName(participant)} ${participant.email ?? ""} ${participant.discord_user_id ?? ""} ${participant.university ?? ""}`.toLocaleLowerCase().includes(query)); if (!filtered.length) { tiles.innerHTML = '<p class="empty">条件に一致する参加者はいません。</p>'; return; } tiles.innerHTML = filtered.map((participant) => { const subjects = participantSubjects(participant); const roles = subjects.map((subject) => subject === "*" ? "全分野管理" : subject); const roleIds = participantRoleIds(participant); const roleChips = roleIds.length ? roleIds.slice(0, 4).map((role) => `<span class="participant-role-chip">${esc(role)}</span>`).join("") : '<span class="participant-role-chip participant-role-chip--empty">未付与</span>'; return `<article class="participant-card"><div class="participant-card__top">${avatar(participant)}<div class="participant-card__identity"><strong class="participant-card__name">${esc(memberName(participant))}</strong><div class="participant-card__email">${esc(participant.email)}</div></div><span class="participant-card__role">${esc(roles.join("・") || "担当未設定")}</span></div><div class="participant-card__access"><div class="participant-card__facts"><span class="participant-fact"><b>所属</b> ${esc(participant.university || "未登録")}</span><span class="participant-fact"><b>学年</b> ${esc(participant.year || "未登録")}</span><span class="participant-fact"><b>分野</b> ${esc(participant.interests || "未登録")}</span></div></div><div class="participant-card__discord"><div class="participant-card__discord-heading"><strong>Discord</strong><span class="participant-card__discord-state" data-state="${participant.discord_user_id ? "connected" : "unconnected"}">${participant.discord_user_id ? "連携済み" : "未連携"}</span></div><div class="participant-role-chips">${roleChips}</div></div></article>`; }).join(""); };
    const setView = (view: string) => { const tilesMode = view === "tiles"; listView.hidden = tilesMode; tileView.hidden = !tilesMode; root.querySelectorAll<HTMLButtonElement>("[data-view]").forEach((button) => button.setAttribute("aria-pressed", String(button.dataset.view === view))); if (tilesMode) renderParticipants(); else render(); };
    search.addEventListener("input", () => { render(); renderParticipants(); }); root.querySelectorAll<HTMLButtonElement>("[data-view]").forEach((button) => button.addEventListener("click", () => setView(button.dataset.view ?? "list")));
    void Promise.all([fetch("/api/admin/genre-overviews?project=atlas", { credentials: "same-origin", cache: "no-store" }).then(async (response) => { const data = await response.json() as ResponseData; if (!response.ok) throw new Error(data.error ?? "メンバー情報を読み込めませんでした。"); return data; }), fetch("/api/admin/report-admin-permissions", { credentials: "same-origin", cache: "no-store" }).then(async (response) => { const data = await response.json() as ParticipantResponse; if (!response.ok) throw new Error(data.error ?? "参加者一覧を読み込めませんでした。"); return data; }).catch(() => null)]).then(([memberData, participantData]) => { members = memberData.members ?? []; participants = participantData?.permissions ?? members.map((member) => ({ email: member.email, display_name: member.display_name, university: member.university, year: member.year, avatar_url: member.avatar_url, subjects: [...(member.subjectAssignments ?? []), ...(member.workflowSubjects ?? [])].join(",") })); render(); renderParticipants(); }).catch((error) => { const message = error instanceof Error ? error.message : "メンバー情報を読み込めませんでした。"; table.innerHTML = `<tr><td colspan="5" class="empty">${esc(message)}</td></tr>`; tiles.innerHTML = `<p class="empty">${esc(message)}</p>`; count.textContent = "—"; });
  }; document.addEventListener("astro:page-load", initialize); initialize();
</script>
