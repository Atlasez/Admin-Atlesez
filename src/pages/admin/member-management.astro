---
import AdminLayout from "../../layouts/AdminLayout.astro";
import AdminRetryNotice from "../../components/admin/AdminRetryNotice.astro";
---

<AdminLayout title="運営メンバー管理" description="アトラス運営メンバーの名簿">
  <main class="member-management" data-member-management data-verification-server="true">
    <header class="page-heading"><div><h1>運営メンバー管理</h1></div><a href="/admin/manage/?project=atlas">← 管理トップ</a></header>
    <section class="toolbar" aria-label="名簿の表示設定"><label class="search">検索<input type="search" data-search placeholder="名前・メール・担当分野" /></label><div class="view-switch" role="group" aria-label="表示形式"><button type="button" data-view="list" aria-pressed="true">一覧</button><button type="button" data-view="tiles" aria-pressed="false">タイル</button></div><span data-count>読み込み中…</span><button type="button" class="load-more" data-load-more hidden>さらに読み込む</button></section>
    <section class="member-list-view" data-list-view aria-label="運営メンバー一覧"><div class="table-wrap"><table><thead><tr><th>メンバー</th><th>所属</th><th>役割</th><th>担当分野</th><th>最終確認</th><th>操作</th></tr></thead><tbody data-table-body><tr><td colspan="6">読み込み中…</td></tr></tbody></table></div></section>
    <section class="member-tile-view" data-tile-view aria-label="運営メンバーのタイル表示" hidden><div class="tile-grid" data-tile-grid></div></section>
    <AdminRetryNotice />
    <details class="verification-archive" data-verification-archive hidden>
      <summary><span>検証用アーカイブ</span><span class="verification-archive-count" data-verification-count>0件</span></summary>
      <p>テスト用アカウントは通常の名簿から分けて表示しています。アカウントやプロフィールは削除せず、検証用の記録として保持します。</p>
      <div class="verification-archive-list" data-verification-list></div>
    </details>
    <details class="member-archive" data-member-archive hidden>
      <summary><span>アーカイブ済みの運営メンバー</span><span class="member-archive-count" data-member-archive-count>0人</span></summary>
      <p>アーカイブすると運営上の担当・権限から外れます。プロフィールや記事、応募、監査履歴、Discordアカウントは保持され、ここから復元できます。</p>
      <div class="member-archive-list" data-member-archive-list></div>
    </details>
    <output class="message" data-message aria-live="polite"></output>
    <dialog class="member-detail-dialog" data-member-detail-dialog aria-labelledby="member-detail-title">
      <section class="member-detail-panel">
        <header><div><h2 id="member-detail-title">メンバー詳細</h2><p data-member-detail-email></p></div><button type="button" data-close-member-detail>閉じる</button></header>
        <div class="member-detail-content" data-member-detail-content aria-live="polite">読み込み中…</div>
      </section>
    </dialog>
  </main>
</AdminLayout>

<style>
  .member-management{margin:0 auto;max-width:1200px;padding:0 1.25rem 4rem}.page-heading{align-items:end;border-bottom:1px solid var(--border-default);display:flex;gap:1rem;justify-content:space-between;padding:2rem 0 1.3rem}.page-heading h1{font-size:clamp(1.8rem,4vw,2.5rem);margin:.25rem 0 .45rem}.lead{color:var(--text-secondary);line-height:1.7;margin:0}.page-heading>a{color:var(--accent-primary);font-size:.8rem;font-weight:800;text-decoration:none;white-space:nowrap}.toolbar{align-items:end;display:flex;gap:.8rem;justify-content:space-between;margin:1.2rem 0 .7rem}.search{color:var(--text-secondary);display:grid;font-size:.74rem;font-weight:800;gap:.3rem;max-width:28rem;width:100%}.search input{background:var(--background-primary);border:1px solid var(--border-default);color:var(--text-primary);font:inherit;padding:.6rem .7rem}.view-switch{display:flex;gap:.35rem}.view-switch button{background:var(--background-secondary);border:1px solid var(--border-default);color:var(--text-secondary);cursor:pointer;font:inherit;font-size:.75rem;font-weight:800;padding:.52rem .75rem}.view-switch button[aria-pressed="true"]{background:var(--accent-primary);border-color:var(--accent-primary);color:var(--on-accent)}.toolbar>span{color:var(--text-secondary);font-size:.75rem;white-space:nowrap}.load-more{background:var(--background-secondary);border:1px solid var(--border-default);color:var(--text-primary);cursor:pointer;font:inherit;font-size:.72rem;padding:.5rem .7rem;white-space:nowrap}.load-more:hover{border-color:var(--accent-primary)}.load-more:disabled{cursor:wait;opacity:.65}.table-wrap{border:1px solid var(--border-default);overflow:auto}.member-list-view table{border-collapse:collapse;min-width:760px;width:100%}th,td{border-bottom:1px solid var(--border-default);padding:.72rem .8rem;text-align:left;vertical-align:middle}th{background:var(--background-secondary);color:var(--text-secondary);font-size:.7rem;letter-spacing:.03em;white-space:nowrap}td{font-size:.8rem}tbody tr:last-child td{border-bottom:0}.identity{align-items:center;display:flex;gap:.6rem;min-width:13rem}.avatar{align-items:center;background:var(--background-secondary);border:1px solid var(--border-default);border-radius:50%;color:var(--accent-primary);display:inline-flex;flex:0 0 2.25rem;font-size:.8rem;font-weight:800;height:2.25rem;justify-content:center;overflow:hidden;width:2.25rem}.avatar img{height:100%;object-fit:cover;width:100%}.identity-copy{display:grid;gap:.1rem}.identity-copy strong{font-size:.82rem}.identity-copy small,.muted{color:var(--text-secondary);font-size:.7rem}.role,.assignment{display:flex;flex-wrap:wrap;gap:.25rem}.chip{background:var(--background-secondary);border:1px solid var(--border-default);border-radius:999px;color:var(--text-secondary);font-size:.66rem;padding:.2rem .4rem;white-space:nowrap}.chip--accent{color:var(--accent-primary)}.tile-grid{display:grid;gap:.75rem;grid-template-columns:repeat(auto-fill,minmax(290px,1fr))}.participant-card{background:var(--background-primary);border:1px solid var(--border-default);display:grid;gap:.7rem;min-width:0;padding:.85rem}.participant-card:hover{border-color:var(--accent-primary)}.participant-card__top{align-items:center;display:flex;gap:.65rem;min-width:0}.participant-card .avatar{flex-basis:1.9rem;font-size:.72rem;height:1.9rem;width:1.9rem}.participant-card__identity{min-width:0}.participant-card__name{font-size:.98rem;font-weight:800;line-height:1.3}.participant-card__email{color:var(--text-secondary);font-size:.72rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.participant-card__role{background:var(--background-secondary);border:1px solid var(--border-default);border-radius:999px;font-size:.7rem;margin-left:auto;padding:.22rem .42rem;white-space:nowrap}.participant-card__access{display:grid;gap:.45rem}.participant-card__facts{display:flex;flex-wrap:wrap;gap:.35rem}.participant-fact{background:var(--background-secondary);border:1px solid var(--border-default);border-radius:999px;color:var(--text-secondary);font-size:.7rem;line-height:1.2;padding:.25rem .42rem}.participant-fact b{color:var(--accent-primary)}.participant-card__discord{border-top:1px solid var(--border-default);display:grid;gap:.4rem;padding-top:.6rem}.participant-card__discord-heading{align-items:center;display:flex;justify-content:space-between}.participant-card__discord-heading strong{font-size:.75rem}.participant-card__discord-state{border:1px solid var(--border-default);border-radius:999px;color:var(--text-secondary);font-size:.66rem;padding:.18rem .4rem}.participant-card__discord-state[data-state="connected"]{border-color:var(--success);color:var(--success)}.participant-role-chips{display:flex;flex-wrap:wrap;gap:.28rem}.participant-role-chip{background:var(--background-secondary);border:1px solid var(--border-default);border-radius:999px;color:var(--text-secondary);font-size:.66rem;padding:.2rem .38rem}.participant-role-chip--empty{color:var(--text-muted)}.empty{color:var(--text-secondary);padding:2rem;text-align:center}.message{color:var(--text-secondary);display:block;font-size:.8rem;min-height:1.3rem;padding-top:.7rem}@media(max-width:700px){.member-management{padding:0 .8rem 3rem}.page-heading{align-items:start;display:grid}.toolbar{align-items:stretch;display:grid}.view-switch{justify-content:flex-start}.toolbar>span,.load-more{justify-self:start}}
  .verification-archive { border: 1px solid var(--border-default); margin-top: 1rem; }
  .verification-archive summary { align-items: center; color: var(--text-secondary); cursor: pointer; display: flex; font-size: .8rem; font-weight: 800; gap: .6rem; justify-content: space-between; list-style: none; padding: .7rem .8rem; }
  .verification-archive summary::-webkit-details-marker { display: none; }
  .verification-archive summary::before { color: var(--text-muted); content: "▸"; }
  .verification-archive[open] summary::before { content: "▾"; }
  .verification-archive-count { color: var(--text-muted); font-size: .7rem; font-variant-numeric: tabular-nums; }
  .verification-archive > p { border-top: 1px solid var(--border-default); color: var(--text-secondary); font-size: .74rem; line-height: 1.55; margin: 0; padding: .7rem .8rem; }
  .verification-archive-list { border-top: 1px solid var(--border-default); display: grid; gap: .45rem; padding: .7rem .8rem; }
  .verification-member { align-items: center; background: var(--background-secondary); border: 1px solid var(--border-default); display: flex; gap: .6rem; min-width: 0; padding: .5rem .6rem; }
  .verification-member .avatar { flex-basis: 1.8rem; height: 1.8rem; width: 1.8rem; }
  .verification-member-copy { display: grid; gap: .1rem; min-width: 0; }
  .verification-member-copy strong { font-size: .78rem; }
  .verification-member-copy small { color: var(--text-secondary); font-size: .68rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .verification-member-label { color: var(--text-muted); font-size: .66rem; margin-left: auto; white-space: nowrap; }
  .member-archive { border: 1px solid var(--border-default); margin-top: 1rem; }
  .member-archive summary { align-items:center; color:var(--text-secondary); cursor:pointer; display:flex; font-size:.8rem; font-weight:800; gap:.6rem; justify-content:space-between; list-style:none; padding:.7rem .8rem; }
  .member-archive summary::-webkit-details-marker { display:none; }
  .member-archive summary::before { color:var(--text-muted); content:"▸"; }
  .member-archive[open] summary::before { content:"▾"; }
  .member-archive-count { color:var(--text-muted); font-size:.7rem; font-variant-numeric:tabular-nums; }
  .member-archive > p { border-top:1px solid var(--border-default); color:var(--text-secondary); font-size:.74rem; line-height:1.55; margin:0; padding:.7rem .8rem; }
  .member-archive-list { border-top:1px solid var(--border-default); display:grid; gap:.45rem; padding:.7rem .8rem; }
  .member-archive-entry { align-items:center; background:var(--background-secondary); border:1px solid var(--border-default); display:flex; gap:.65rem; min-width:0; padding:.55rem .65rem; }
  .member-archive-entry__identity { display:grid; gap:.1rem; min-width:0; }
  .member-archive-entry__identity strong { font-size:.78rem; }
  .member-archive-entry__identity small { color:var(--text-secondary); font-size:.68rem; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .member-archive-entry__meta { color:var(--text-muted); font-size:.66rem; margin-left:auto; white-space:nowrap; }
  .member-archive-entry button { background:transparent; border:1px solid var(--accent-primary); color:var(--accent-primary); cursor:pointer; font:inherit; font-size:.68rem; padding:.3rem .48rem; }
  .member-archive-entry button:disabled { cursor:wait; opacity:.55; }
  .member-detail-dialog { background:var(--background-primary); border:1px solid var(--border-default); color:var(--text-primary); max-height:min(88vh,820px); max-width:min(760px,calc(100vw - 2rem)); padding:0; width:100%; }
  .member-detail-dialog::backdrop { background:rgb(0 0 0 / .62); }
  .member-detail-panel { display:grid; max-height:inherit; }
  .member-detail-panel > header { align-items:center; border-bottom:1px solid var(--border-default); display:flex; gap:1rem; justify-content:space-between; padding:1rem 1.1rem; }
  .member-detail-panel h2 { font-size:1.1rem; margin:0; }
  .member-detail-panel header p { color:var(--text-secondary); font-size:.78rem; margin:.25rem 0 0; }
  .member-detail-panel header button { background:transparent; border:1px solid var(--border-default); color:var(--text-primary); cursor:pointer; font:inherit; padding:.4rem .65rem; }
  .member-detail-content { display:grid; gap:1rem; max-height:70vh; overflow:auto; padding:1rem 1.1rem; }
  .member-detail-section { border-bottom:1px solid var(--border-default); display:grid; gap:.45rem; padding-bottom:.8rem; }
  .member-detail-section h3 { color:var(--text-secondary); font-size:.78rem; margin:0; }
  .member-detail-section p,.member-detail-section ul { font-size:.8rem; line-height:1.6; margin:0; }
  .member-detail-section ul { display:grid; gap:.25rem; padding-left:1.2rem; }
  .member-detail-bio { border:1px solid var(--border-default); padding:.65rem; white-space:pre-wrap; }
  .member-detail-empty { color:var(--text-muted); }
  .member-detail-retry { background:var(--background-secondary); border:1px solid var(--border-default); color:var(--text-primary); cursor:pointer; font:inherit; justify-self:start; padding:.45rem .7rem; }
  @media (max-width:600px) { .member-detail-dialog { max-width:calc(100vw - 1rem); } .member-detail-panel > header,.member-detail-content { padding-left:.8rem; padding-right:.8rem; } }
</style>

<style is:global>
  /* APIから後から挿入する行はAstroのスコープ属性を持たないため、一覧の構造を明示的に共有する。 */
  [data-member-management] .member-list-view .table-wrap { overflow-x: auto; }
  [data-member-management] .member-list-view table { border-collapse: collapse; min-width: 760px; table-layout: auto; width: 100%; }
  [data-member-management] .member-list-view th,
  [data-member-management] .member-list-view td { border-bottom: 1px solid var(--border-default); padding: .72rem .8rem; text-align: left; vertical-align: middle; }
  [data-member-management] .member-list-view th { background: var(--background-secondary); color: var(--text-secondary); font-size: .7rem; letter-spacing: .03em; white-space: nowrap; }
  [data-member-management] .member-list-view td { font-size: .8rem; }
  [data-member-management] .member-list-view tbody tr:last-child td { border-bottom: 0; }
  [data-member-management] .member-list-view .identity { align-items: center; display: flex; gap: .6rem; min-width: 15rem; }
  [data-member-management] .avatar { align-items: center; background: var(--background-secondary); border: 1px solid var(--border-default); border-radius: 50%; color: var(--accent-primary); display: inline-flex; flex: 0 0 2.25rem; font-size: .8rem; font-weight: 800; height: 2.25rem; justify-content: center; overflow: hidden; width: 2.25rem; }
  [data-member-management] .avatar img { display: block; height: 100%; object-fit: cover; width: 100%; }
  [data-member-management] .identity-copy { display: grid; gap: .1rem; min-width: 0; }
  [data-member-management] .identity-copy strong { font-size: .82rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  [data-member-management] .identity-copy small,
  [data-member-management] .muted { color: var(--text-secondary); font-size: .7rem; }
  [data-member-management] .role,
  [data-member-management] .assignment { display: flex; flex-wrap: wrap; gap: .25rem; }
  [data-member-management] .chip { background: var(--background-secondary); border: 1px solid var(--border-default); border-radius: 999px; color: var(--text-secondary); font-size: .66rem; padding: .2rem .4rem; white-space: nowrap; }
  [data-member-management] .chip--accent { color: var(--accent-primary); }
  [data-member-management] .member-remove { background: transparent; border: 1px solid color-mix(in srgb, var(--danger) 55%, var(--border-default)); border-radius: .3rem; color: var(--danger); cursor: pointer; font: inherit; font-size: .68rem; padding: .3rem .48rem; white-space: nowrap; }
  [data-member-management] .member-remove:hover { background: color-mix(in srgb, var(--danger) 12%, transparent); }
  [data-member-management] .member-remove:disabled { cursor: wait; opacity: .55; }
  [data-member-management] .member-card__actions { align-items: center; display: flex; gap: .45rem; justify-content: flex-end; }
  [data-member-management] .participant-card__actions { border-top: 1px solid var(--border-default); display: flex; justify-content: flex-end; padding-top: .6rem; }
  [data-member-management] .empty { color: var(--text-secondary); padding: 2rem; text-align: center; }

  [data-member-management] .participant-card{background:var(--background-primary);border:1px solid var(--border-default);display:grid;gap:.7rem;min-width:0;padding:.85rem}
  [data-member-management] .participant-card:hover{border-color:var(--accent-primary)}
  [data-member-management] .participant-card__top{align-items:center;display:flex;gap:.65rem;min-width:0}
  [data-member-management] .participant-card .avatar{align-items:center;background:var(--background-secondary);border:1px solid var(--border-default);border-radius:50%;color:var(--accent-primary);display:inline-flex;flex:0 0 1.9rem;font-size:.72rem;font-weight:800;height:1.9rem;justify-content:center;overflow:hidden;width:1.9rem}
  [data-member-management] .participant-card .avatar img{height:100%;object-fit:cover;width:100%}
  [data-member-management] .participant-card__identity{min-width:0}
  [data-member-management] .participant-card__name{font-size:.98rem;font-weight:800;line-height:1.3}
  [data-member-management] .participant-card__email{color:var(--text-secondary);font-size:.72rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  [data-member-management] .participant-card__role{background:var(--background-secondary);border:1px solid var(--border-default);border-radius:999px;font-size:.7rem;margin-left:auto;padding:.22rem .42rem;white-space:nowrap}
  [data-member-management] .participant-card__access{display:grid;gap:.45rem}
  [data-member-management] .participant-card__facts{display:flex;flex-wrap:wrap;gap:.35rem}
  [data-member-management] .participant-fact{background:var(--background-secondary);border:1px solid var(--border-default);border-radius:999px;color:var(--text-secondary);font-size:.7rem;line-height:1.2;padding:.25rem .42rem}
  [data-member-management] .participant-fact b{color:var(--accent-primary)}
  [data-member-management] .participant-card__discord{border-top:1px solid var(--border-default);display:grid;gap:.4rem;padding-top:.6rem}
  [data-member-management] .participant-card__discord-heading{align-items:center;display:flex;justify-content:space-between}
  [data-member-management] .participant-card__discord-heading strong{font-size:.75rem}
  [data-member-management] .participant-card__discord-state{border:1px solid var(--border-default);border-radius:999px;color:var(--text-secondary);font-size:.66rem;padding:.18rem .4rem}
  [data-member-management] .participant-card__discord-state[data-state="connected"]{border-color:var(--success);color:var(--success)}
  [data-member-management] .participant-role-chips{display:flex;flex-wrap:wrap;gap:.28rem}
  [data-member-management] .participant-role-chip{background:var(--background-secondary);border:1px solid var(--border-default);border-radius:999px;color:var(--text-secondary);font-size:.66rem;padding:.2rem .38rem}
  [data-member-management] .participant-role-chip--empty{color:var(--text-muted)}
</style>

<script>
  import { createAdminLoadRetry } from "../../scripts/admin-load-retry";

  type Member = { email?: string; display_name?: string; university?: string; year?: string; role?: string; avatar_url?: string; assignments?: string[]; subjectAssignments?: string[]; workflowSubjects?: string[] };
  type Participant = { email?: string; display_name?: string; university?: string; year?: string; interests?: string; avatar_url?: string; discord_user_id?: string; discord_role_ids?: string; subjects?: string };
  type Pagination = { limit?: number; nextCursor?: string | null; hasMore?: boolean };
  type ResponseData = { members?: Member[]; pagination?: Pagination; error?: string };
  type ParticipantResponse = { permissions?: Participant[]; pagination?: Pagination; error?: string };
  type VerificationResponse = { members?: Array<{ email?: string; display_name?: string; avatar_url?: string }>; error?: string };
  type ArchivedMember = { email: string; display_name: string; avatar_url: string; created_by: string; archived_by: string | null; archived_at: string | null };
  type ArchivedResponse = { members?: ArchivedMember[]; error?: string };
  type MemberDetail = { email: string; status: string; createdBy: string | null; createdAt: string | null; archivedBy: string | null; archivedAt: string | null; profile: { displayName: string; avatarUrl: string; bio: string; university: string; year: string; interests: string; affiliationType: string; country: string; timezone: string; updatedAt: string } | null; memberships: Array<{ project_id: string; role: string; joined_at: string }>; permissions: Array<{ subject: string }>; workflowRoles: Array<{ role: string; subject: string; created_at: string; created_by: string }>; genreRoles: Array<{ kind: string; name: string; created_at: string; created_by: string }>; articleCount: number; applicationCount: number; history: Array<{ actorEmail: string; action: string; summary: string; createdAt: string; category: string }> };
  type MemberDetailResponse = { member?: MemberDetail; error?: string };
  const initialize = () => { const root = document.querySelector<HTMLElement>("[data-member-management]"); if (!root || root.dataset.ready) return; root.dataset.ready = "true"; const table = root.querySelector<HTMLElement>("[data-table-body]")!; const tiles = root.querySelector<HTMLElement>("[data-tile-grid]")!; const search = root.querySelector<HTMLInputElement>("[data-search]")!; const count = root.querySelector<HTMLElement>("[data-count]")!; const loadMoreButton = root.querySelector<HTMLButtonElement>("[data-load-more]")!; const listView = root.querySelector<HTMLElement>("[data-list-view]")!; const tileView = root.querySelector<HTMLElement>("[data-tile-view]")!; const archive = root.querySelector<HTMLElement>("[data-verification-archive]")!; const archiveList = root.querySelector<HTMLElement>("[data-verification-list]")!; const archiveCount = root.querySelector<HTMLElement>("[data-verification-count]")!; const lifecycleArchive = root.querySelector<HTMLElement>("[data-member-archive]")!; const lifecycleArchiveList = root.querySelector<HTMLElement>("[data-member-archive-list]")!; const lifecycleArchiveCount = root.querySelector<HTMLElement>("[data-member-archive-count]")!; const detailDialog = root.querySelector<HTMLDialogElement>("[data-member-detail-dialog]")!; const detailEmail = root.querySelector<HTMLElement>("[data-member-detail-email]")!; const detailContent = root.querySelector<HTMLElement>("[data-member-detail-content]")!; const message = root.querySelector<HTMLOutputElement>("[data-message]")!; let members: Member[] = []; let participants: Participant[] = []; let verificationAccounts: VerificationResponse["members"] = []; let archivedMembers: ArchivedMember[] = []; let memberCursor: string | null = null; let participantCursor: string | null = null; let membersHaveMore = false; let participantsHaveMore = false; let loadingMore = false;
    const esc = (value: unknown) => String(value ?? "").replace(/[&<>"']/g, (character) => ({ "&":"&amp;", "<":"&lt;", ">":"&gt;", '"':"&quot;", "'":"&#39;" })[character] ?? character);
    const memberName = (member: Member | Participant | ArchivedMember) => member.display_name?.trim() || "表示名未設定";
    const avatar = (member: Member | Participant | ArchivedMember) => member.avatar_url?.trim() ? `<span class="avatar"><img src="${esc(member.avatar_url)}" alt="" loading="lazy" /></span>` : `<span class="avatar" aria-hidden="true">${esc(memberName(member).slice(0,1))}</span>`;
    const chips = (items: string[] = [], accent = false) => items.length ? items.map((item) => `<span class="chip${accent ? " chip--accent" : ""}">${esc(item)}</span>`).join("") : '<span class="muted">未設定</span>';
    const participantSubjects = (participant: Participant) => String(participant.subjects ?? "").split(",").map((subject) => subject.trim()).filter(Boolean);
    const participantRoleIds = (participant: Participant) => String(participant.discord_role_ids ?? "").split(",").map((role) => role.trim()).filter(Boolean);
    const render = () => { const query = search.value.trim().toLocaleLowerCase(); const filtered = members.filter((member) => `${memberName(member)} ${member.email ?? ""} ${member.university ?? ""} ${(member.assignments ?? []).join(" ")}`.toLocaleLowerCase().includes(query)); count.textContent = `${filtered.length} / ${members.length}人`; if (!filtered.length) { table.innerHTML = '<tr><td colspan="6" class="empty">条件に一致するメンバーはいません。</td></tr>'; return; } table.innerHTML = filtered.map((member) => `<tr><td><div class="identity">${avatar(member)}<span class="identity-copy"><strong>${esc(memberName(member))}</strong><small>${esc(member.email)}</small></span></div></td><td>${esc([member.university, member.year].filter(Boolean).join(" / ") || "未登録")}</td><td><div class="role">${chips([member.role === "manager" ? "運営統括" : "運営メンバー"], true)}</div></td><td><div class="assignment">${chips(member.assignments)}</div></td><td class="muted">現在の登録情報</td><td><button type="button" data-open-member data-email="${esc(member.email)}">詳細</button> <button type="button" class="member-remove" data-archive-member data-email="${esc(member.email)}">アーカイブ</button></td></tr>`).join(""); };
    const renderParticipants = () => { const query = search.value.trim().toLocaleLowerCase(); const filtered = participants.filter((participant) => `${memberName(participant)} ${participant.email ?? ""} ${participant.discord_user_id ?? ""} ${participant.university ?? ""}`.toLocaleLowerCase().includes(query)); if (!filtered.length) { tiles.innerHTML = '<p class="empty">条件に一致する参加者はいません。</p>'; return; } tiles.innerHTML = filtered.map((participant) => { const subjects = participantSubjects(participant); const roles = subjects.map((subject) => subject === "*" ? "全分野管理" : subject); const roleIds = participantRoleIds(participant); const roleChips = roleIds.length ? roleIds.slice(0, 4).map((role) => `<span class="participant-role-chip">${esc(role)}</span>`).join("") : '<span class="participant-role-chip participant-role-chip--empty">未付与</span>'; return `<article class="participant-card"><div class="participant-card__top">${avatar(participant)}<div class="participant-card__identity"><strong class="participant-card__name">${esc(memberName(participant))}</strong><div class="participant-card__email">${esc(participant.email)}</div></div><span class="participant-card__role">${esc(roles.join("・") || "担当未設定")}</span></div><div class="participant-card__access"><div class="participant-card__facts"><span class="participant-fact"><b>所属</b> ${esc(participant.university || "未登録")}</span><span class="participant-fact"><b>学年</b> ${esc(participant.year || "未登録")}</span><span class="participant-fact"><b>分野</b> ${esc(participant.interests || "未登録")}</span></div></div><div class="participant-card__discord"><div class="participant-card__discord-heading"><strong>Discord</strong><span class="participant-card__discord-state" data-state="${participant.discord_user_id ? "connected" : "unconnected"}">${participant.discord_user_id ? "連携済み" : "未連携"}</span></div><div class="participant-role-chips">${roleChips}</div></div><div class="participant-card__actions"><button type="button" data-open-member data-email="${esc(participant.email)}">詳細</button><button type="button" class="member-remove" data-archive-member data-email="${esc(participant.email)}">アーカイブ</button></div></article>`; }).join(""); };
    const renderVerification = () => { const entries = (verificationAccounts ?? []).filter((entry) => entry?.email?.trim()); archiveCount.textContent = `${entries.length}件`; archive.hidden = entries.length === 0; archiveList.innerHTML = entries.map((entry) => { const name = entry.display_name?.trim() || "表示名未設定"; const email = entry.email?.trim() || ""; const initial = name.slice(0, 1); const image = entry.avatar_url?.trim() ? `<img src="${esc(entry.avatar_url)}" alt="" loading="lazy" />` : esc(initial); return `<div class="verification-member">${image ? `<span class="avatar" aria-hidden="true">${image}</span>` : ""}<span class="verification-member-copy"><strong>${esc(name)}</strong><small>${esc(email)}</small></span><span class="verification-member-label">検証用・保持</span></div>`; }).join(""); };
    const renderArchivedMembers = (error = "") => { lifecycleArchiveCount.textContent = `${archivedMembers.length}人`; lifecycleArchive.hidden = archivedMembers.length === 0 && !error; lifecycleArchiveList.innerHTML = error ? `<p class="empty">${esc(error)}</p>` : archivedMembers.map((member) => `<div class="member-archive-entry">${avatar(member)}<span class="member-archive-entry__identity"><strong>${esc(member.display_name || "表示名未設定")}</strong><small>${esc(member.email)}</small></span><span class="member-archive-entry__meta">${member.archived_at ? `${esc(new Date(member.archived_at).toLocaleDateString("ja-JP"))}にアーカイブ` : "アーカイブ済み"}</span><button type="button" data-restore-member data-email="${esc(member.email)}">復元</button></div>`).join("") || '<p class="empty">アーカイブ済みのメンバーはいません。</p>'; };
    const updateLoadMore = () => { const visible = membersHaveMore || participantsHaveMore; loadMoreButton.hidden = !visible; loadMoreButton.disabled = loadingMore; loadMoreButton.textContent = loadingMore ? "読み込み中…" : "さらに読み込む"; };
    const setView = (view: string) => { const tilesMode = view === "tiles"; listView.hidden = tilesMode; tileView.hidden = !tilesMode; root.querySelectorAll<HTMLButtonElement>("[data-view]").forEach((button) => button.setAttribute("aria-pressed", String(button.dataset.view === view))); if (tilesMode) renderParticipants(); else render(); };
    search.addEventListener("input", () => { render(); renderParticipants(); }); root.querySelectorAll<HTMLButtonElement>("[data-view]").forEach((button) => button.addEventListener("click", () => setView(button.dataset.view ?? "list")));
    const loadMore = async () => { if (loadingMore || (!membersHaveMore && !participantsHaveMore)) return; loadingMore = true; updateLoadMore(); message.value = "追加のメンバーを読み込んでいます…"; try { const requests: Promise<Response>[] = []; if (membersHaveMore && memberCursor) requests.push(fetch(`/api/admin/genre-overviews?project=atlas&limit=50&cursor=${encodeURIComponent(memberCursor)}`, { credentials: "same-origin", cache: "no-store" })); if (participantsHaveMore && participantCursor) requests.push(fetch(`/api/admin/report-admin-permissions?limit=50&cursor=${encodeURIComponent(participantCursor)}`, { credentials: "same-origin", cache: "no-store" })); const responses = await Promise.all(requests); for (const response of responses) { const data = await response.json() as ResponseData & ParticipantResponse; if (!response.ok) throw new Error(data.error ?? "追加のメンバーを読み込めませんでした。"); if (Array.isArray(data.members)) members = [...members, ...data.members]; if (data.pagination && Array.isArray(data.members)) { memberCursor = data.pagination.nextCursor ?? null; membersHaveMore = Boolean(data.pagination.hasMore); } if (Array.isArray(data.permissions)) participants = [...participants, ...data.permissions]; if (data.pagination && Array.isArray(data.permissions)) { participantCursor = data.pagination.nextCursor ?? null; participantsHaveMore = Boolean(data.pagination.hasMore); } } render(); renderParticipants(); message.value = "追加のメンバーを読み込みました。"; } catch (error) { message.value = error instanceof Error ? error.message : "追加のメンバーを読み込めませんでした。"; } finally { loadingMore = false; updateLoadMore(); } };
    loadMoreButton.addEventListener("click", () => { void loadMore(); });
    let loadArchivedMembers: () => Promise<void>;
    loadArchivedMembers = async () => { try { const response = await fetch("/api/admin/member-management", { credentials: "same-origin", cache: "no-store" }); const data = await response.json() as ArchivedResponse; if (!response.ok) throw new Error(data.error ?? "アーカイブ一覧を読み込めませんでした。"); archivedMembers = data.members ?? []; renderArchivedMembers(); } catch (error) { renderArchivedMembers(error instanceof Error ? error.message : "アーカイブ一覧を読み込めませんでした。"); } };
    const openMemberDetail = async (email: string) => {
      detailEmail.textContent = email;
      detailContent.textContent = "メンバー情報を読み込んでいます…";
      detailDialog.showModal();
      try {
        const response = await fetch(`/api/admin/member-management?email=${encodeURIComponent(email)}`, { credentials: "same-origin", cache: "no-store" });
        const data = await response.json() as MemberDetailResponse;
        if (!response.ok || !data.member) throw new Error(data.error ?? "メンバー詳細を読み込めませんでした。");
        const member = data.member;
        const date = (value: string | null) => value && Number.isFinite(Date.parse(value)) ? new Date(value).toLocaleString("ja-JP") : "記録なし";
        const section = (title: string, content: string) => `<section class="member-detail-section"><h3>${esc(title)}</h3>${content}</section>`;
        const list = (values: string[], empty: string) => values.length ? `<ul>${values.map((value) => `<li>${esc(value)}</li>`).join("")}</ul>` : `<p class="member-detail-empty">${esc(empty)}</p>`;
        const profile = member.profile;
        const history = member.history.map((entry) => `${date(entry.createdAt)} — ${entry.summary}（${entry.actorEmail}）`);
        detailContent.innerHTML = [
          section("登録", `<p>状態：${esc(member.status === "archived" ? "アーカイブ済み" : "有効")}</p><p>初回作成者：${esc(member.createdBy || "記録なし")}</p><p>登録日時：${esc(date(member.createdAt))}</p>${member.archivedAt ? `<p>アーカイブ：${esc(date(member.archivedAt))}（${esc(member.archivedBy || "操作者記録なし")}）</p>` : ""}`),
          section("プロフィール", profile ? `<p>表示名：${esc(profile.displayName || "未設定")}</p><p>所属・学年：${esc([profile.university, profile.year].filter(Boolean).join(" / ") || "未登録")}</p><p>分野：${esc(profile.interests || "未登録")}</p><p>区分：${esc(profile.affiliationType || "未登録")} ／ 国・地域：${esc(profile.country || "未登録")} ／ タイムゾーン：${esc(profile.timezone || "未登録")}</p><p class="member-detail-bio">${esc(profile.bio || "プロフィール本文は未登録です。")}</p><p class="member-detail-empty">最終更新：${esc(date(profile.updatedAt))}</p>` : '<p class="member-detail-empty">プロフィール情報はありません。</p>'),
          section("所属プロジェクト", list(member.memberships.map((entry) => `${entry.project_id} — ${entry.role}（${date(entry.joined_at)}から）`), "所属記録はありません。")),
          section("分野・権限・役割", list([
            ...member.permissions.map((entry) => `権限：${entry.subject === "*" ? "全分野" : entry.subject}`),
            ...member.workflowRoles.map((entry) => `ワークフロー：${entry.role} — ${entry.subject}`),
            ...member.genreRoles.map((entry) => `${entry.kind === "role" ? "役割" : "分野"}：${entry.name}`),
          ], "担当・権限の記録はありません.")),
          section("関連記録", `<p>作成記事：${member.articleCount}件</p><p>応募：${member.applicationCount}件</p>`),
          section("記録されている変更履歴（最大40件）", list(history, "表示できる変更履歴はありません。")),
        ].join("");
      } catch (error) {
        const errorMessage = document.createElement("p");
        errorMessage.textContent = error instanceof Error ? error.message : "メンバー詳細を読み込めませんでした。";
        const retryButton = document.createElement("button");
        retryButton.className = "member-detail-retry";
        retryButton.type = "button";
        retryButton.textContent = "再試行";
        retryButton.addEventListener("click", () => void openMemberDetail(email));
        detailContent.replaceChildren(errorMessage, retryButton);
      }
    };
    root.querySelector<HTMLButtonElement>("[data-close-member-detail]")?.addEventListener("click", () => detailDialog.close());
    root.addEventListener("click", (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-open-member]");
      if (button?.dataset.email) void openMemberDetail(button.dataset.email);
    });
    root.addEventListener("click", (event) => { const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-archive-member], [data-restore-member]"); if (!button) return; const email = button.dataset.email ?? ""; const action = button.hasAttribute("data-restore-member") ? "restore" : "archive"; const messageText = action === "archive" ? `${email} を運営メンバーからアーカイブしますか？\n担当・権限から外れますが、プロフィールや記事、応募、監査履歴、Discordアカウントは保持され、後から復元できます。` : `${email} を運営メンバーへ復元しますか？\nアーカイブ時の担当・権限を復元します。`; if (!email || !window.confirm(messageText)) return; button.disabled = true; message.value = action === "archive" ? "アーカイブしています…" : "復元しています…"; void fetch("/api/admin/member-management", { method: "POST", credentials: "same-origin", headers: { "content-type": "application/json" }, body: JSON.stringify({ action, email }) }).then(async (response) => { const data = await response.json().catch(() => ({})); if (!response.ok) throw new Error(data.error ?? (action === "archive" ? "メンバーをアーカイブできませんでした。" : "メンバーを復元できませんでした。")); message.value = action === "archive" ? "メンバーをアーカイブしました。プロフィール等は保持されています。" : "メンバーを復元しました。"; await load(); await loadArchivedMembers(); }).catch((error) => { message.value = error instanceof Error ? error.message : "メンバー状態を変更できませんでした。"; }).finally(() => { button.disabled = false; }); });
    let load: () => Promise<void>;
    const retry = createAdminLoadRetry(root, () => load(), "メンバー情報を読み込めませんでした。");
    load = async () => { root.setAttribute("aria-busy", "true"); retry.begin(); try { const [memberData, participantData, verificationData] = await Promise.all([fetch("/api/admin/genre-overviews?project=atlas&limit=50", { credentials: "same-origin", cache: "no-store" }).then(async (response) => { const data = await response.json() as ResponseData; if (!response.ok) throw new Error(data.error ?? "メンバー情報を読み込めませんでした。"); return data; }), fetch("/api/admin/report-admin-permissions?limit=50", { credentials: "same-origin", cache: "no-store" }).then(async (response) => { const data = await response.json() as ParticipantResponse; if (!response.ok) throw new Error(data.error ?? "参加者一覧を読み込めませんでした。"); return data; }).catch(() => null), fetch("/api/admin/verification-members", { credentials: "same-origin", cache: "no-store" }).then(async (response) => { const data = await response.json() as VerificationResponse; if (!response.ok) throw new Error(data.error ?? "検証用アカウントを読み込めませんでした。"); return data; }).catch(() => ({ members: [] }))]); members = memberData.members ?? []; memberCursor = memberData.pagination?.nextCursor ?? null; membersHaveMore = Boolean(memberData.pagination?.hasMore); participants = participantData?.permissions ?? members.map((member) => ({ email: member.email, display_name: member.display_name, university: member.university, year: member.year, avatar_url: member.avatar_url, subjects: [...(member.subjectAssignments ?? []), ...(member.workflowSubjects ?? [])].join(",") })); participantCursor = participantData?.pagination?.nextCursor ?? null; participantsHaveMore = Boolean(participantData?.pagination?.hasMore); verificationAccounts = verificationData.members ?? []; render(); renderParticipants(); renderVerification(); updateLoadMore(); retry.success(); } catch (error) { const message = error instanceof Error ? error.message : "メンバー情報を読み込めませんでした。"; table.innerHTML = `<tr><td colspan="6" class="empty">${esc(message)}</td></tr>`; tiles.innerHTML = `<p class="empty">${esc(message)}</p>`; archive.hidden = true; archiveList.innerHTML = ""; count.textContent = "—"; loadMoreButton.hidden = true; retry.fail(error); throw error; } finally { root.removeAttribute("aria-busy"); } };
    void load().then(() => loadArchivedMembers()).catch(() => undefined);
  }; document.addEventListener("astro:page-load", initialize); initialize();
