---
import AdminLayout from "../../layouts/AdminLayout.astro";
---
<AdminLayout title="学習サイト「アトラス」運営用サイト" description="アトラス学習サイトの運営ワークスペース">
  <main class="project-home">
    <header class="project-heading">
      <div>
        <h1>アトラス学習サイト</h1>
      </div>
      <a href="/admin/portal/" aria-label="メンバー用サイトへ戻る">←</a>
    </header>

    <section class="project-links" aria-label="学習サイト運営メニュー">
      <a href="/admin/articles/" aria-label="原稿一覧を開く"><strong>編集・フィードバック</strong><span aria-hidden="true">→</span></a>
      <a href="/admin/genres/"><strong>各ジャンル概要</strong><span aria-label="各ジャンル概要を開く">→</span></a>
      <a href="/admin/co-working/?project=atlas"><strong>同時作業会</strong><span aria-label="同時作業会を開く">→</span></a>
      <a href="/admin/operations/?project=atlas"><strong>タスク管理</strong><span aria-label="タスク管理を開く">→</span></a>
      <a href="/admin/progress/?project=atlas"><strong>進捗報告</strong><span aria-label="進捗報告を開く">→</span></a>
      <a href="/admin/calendar/?project=atlas"><strong>カレンダー</strong><span aria-label="カレンダーを開く">→</span></a>
      <a href="/admin/reports/"><strong>問題報告</strong><span aria-label="問題報告を開く">→</span></a>
      <a href="/admin/analytics/"><strong>閲覧統計</strong><span aria-label="閲覧統計を開く">→</span></a>
      <a href="/admin/guide/"><strong>作業の進め方</strong><span aria-label="作業の進め方を開く">→</span></a>
      <a href="/admin/introductions/?project=atlas"><strong>運営内自己紹介</strong><span aria-label="運営内自己紹介を開く">→</span></a>
      <a href="/admin/workspace/?project=atlas"><strong>マイページ</strong><span aria-label="プロジェクトのマイページを開く">→</span></a>
      <a href="/admin/manage/"><strong>管理トップ</strong><span aria-label="管理トップを開く">→</span></a>
    </section>
  </main>
</AdminLayout>
<style>
  .project-home { margin: 0 auto; max-width: 1200px; padding: 0 1.25rem 4rem; }
  .project-heading { align-items: end; border-bottom: 1px solid var(--border-default); display: flex; gap: 1rem; justify-content: space-between; padding: 2.2rem 0 1.4rem; }
  .project-heading p { color: var(--accent-primary); font-size: .72rem; font-weight: 800; letter-spacing: .1em; margin: 0; }
  .project-heading h1 { font-size: clamp(1.8rem, 4vw, 2.6rem); margin: .25rem 0; }
  .project-heading span { color: var(--text-secondary); line-height: 1.6; }
  .project-heading > a { color: var(--accent-primary); font-size: .8rem; font-weight: 800; text-decoration: none; white-space: nowrap; }
  .project-links { display: grid; gap: .8rem; grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: 1.5rem; }
  .project-links a { background: var(--background-secondary); border: 1px solid var(--border-default); color: var(--text-primary); display: grid; gap: .4rem; min-height: 6.5rem; padding: 1.25rem; text-decoration: none; }
  .project-links a:hover { border-color: var(--accent-primary); transform: translateY(-1px); }
  .project-links [data-manager-only][hidden] { display: none !important; }
  .project-links strong { font-size: .98rem; }
  .project-links small { color: var(--text-secondary); font-size: .78rem; line-height: 1.55; }
  .project-links span { color: var(--accent-primary); font-size: .76rem; font-weight: 800; margin-top: auto; }
  @media (max-width: 800px) {
    .project-home { padding: 0 .8rem 3rem; }
    .project-heading { align-items: start; display: grid; }
    .project-links { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 520px) {
    .project-links { grid-template-columns: 1fr; }
  }
</style>
