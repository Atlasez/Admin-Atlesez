---
import AdminLayout from "../../layouts/AdminLayout.astro";
---
<AdminLayout title="学習サイト「アトラス」運営用サイト" description="アトラス学習サイトの運営ワークスペース">
  <main class="project-home" data-admin-atlas-menu>
    <header class="project-heading">
      <div>
        <h1>アトラス学習サイト</h1>
      </div>
      <a href="/admin/portal/" aria-label="メンバー用サイトへ戻る">←</a>
    </header>

    <div class="menu-groups" aria-label="学習サイト運営メニュー">
      <section class="menu-group" data-menu-group="editorial" aria-labelledby="menu-group-editorial">
        <header class="menu-group-heading"><span aria-hidden="true">・</span><div class="menu-group-title"><h2 id="menu-group-editorial">編集・フィードバック</h2></div><div class="project-links">
          <a href="/admin/articles/" aria-label="原稿一覧を開く"><strong>編集・フィードバック</strong><span aria-hidden="true">→</span></a>
          <a href="/admin/guide/"><strong>作業の進め方</strong><span aria-label="作業の進め方を開く">→</span></a>
          <a href="/admin/reports/"><strong>問題報告</strong><span aria-label="問題報告を開く">→</span></a>
        </div></header>
      </section>

      <section class="menu-group" data-menu-group="operations" aria-labelledby="menu-group-operations">
        <header class="menu-group-heading"><span aria-hidden="true">・</span><div class="menu-group-title"><h2 id="menu-group-operations">タスク・進行管理</h2></div><div class="project-links">
          <a href="/admin/operations/?project=atlas"><strong>タスク管理</strong><span aria-label="タスク管理を開く">→</span></a>
          <a href="/admin/progress/?project=atlas"><strong>進捗報告</strong><span aria-label="進捗報告を開く">→</span></a>
          <a href="/admin/calendar/?project=atlas"><strong>カレンダー</strong><span aria-label="カレンダーを開く">→</span></a>
          <a href="/admin/co-working/?project=atlas"><strong>同時作業会</strong><span aria-label="同時作業会を開く">→</span></a>
        </div></header>
      </section>

      <section class="menu-group" data-menu-group="community" aria-labelledby="menu-group-community">
        <header class="menu-group-heading"><span aria-hidden="true">・</span><div class="menu-group-title"><h2 id="menu-group-community">運営情報</h2></div><div class="project-links">
          <a href="/admin/introductions/?project=atlas"><strong>運営内自己紹介</strong><span aria-label="運営内自己紹介を開く">→</span></a>
          <a href="/admin/genres/"><strong>各ジャンル概要</strong><span aria-label="各ジャンル概要を開く">→</span></a>
          <a href="/admin/rules/"><strong>規則</strong><span aria-label="規則を開く">→</span></a>
        </div></header>
      </section>

      <section class="menu-group menu-group-management" data-menu-group="management" aria-labelledby="menu-group-management">
        <header class="menu-group-heading"><span aria-hidden="true">・</span><div class="menu-group-title"><h2 id="menu-group-management">管理</h2></div><div class="project-links">
          <a href="/admin/manage/"><strong>管理トップ</strong><span aria-label="管理トップを開く">→</span></a>
        </div></header>
      </section>
    </div>
  </main>
</AdminLayout>
<style>
  .project-home { margin: 0 auto; max-width: 1200px; padding: 0 1.25rem 4rem; }
  .project-heading { align-items: end; border-bottom: 1px solid var(--border-default); display: flex; gap: 1rem; justify-content: space-between; padding: 2.2rem 0 1.4rem; }
  .project-heading p { color: var(--accent-primary); font-size: .72rem; font-weight: 800; letter-spacing: .1em; margin: 0; }
  .project-heading h1 { font-size: clamp(1.8rem, 4vw, 2.6rem); margin: .25rem 0; }
  .project-heading span { color: var(--text-secondary); line-height: 1.6; }
  .project-heading > a { color: var(--accent-primary); font-size: .8rem; font-weight: 800; text-decoration: none; white-space: nowrap; }
  .menu-groups { display: grid; gap: 1.5rem; margin-top: 1.5rem; }
  .menu-group { background: color-mix(in srgb, var(--background-secondary) 52%, transparent); border: 1px solid var(--border-default); padding: 1.1rem; }
  .menu-group-heading { align-items: stretch; display: grid; gap: 1rem; grid-template-columns: auto minmax(11rem, .7fr) minmax(0, 2fr); }
  .menu-group-heading > span { color: var(--accent-primary); font-size: 1.2rem; font-weight: 800; line-height: 1; padding-top: .3rem; }
  .menu-group-title { align-self: start; }
  .menu-group-heading h2 { font-size: 1.35rem; line-height: 1.25; margin: .1rem 0 0; }
  .project-links { display: grid; gap: .6rem; grid-template-columns: repeat(3, minmax(0, 1fr)); margin: 0; }
  .project-links a { background: var(--background-secondary); border: 1px solid var(--border-default); color: var(--text-primary); display: block; min-height: 4.8rem; padding: .9rem 1rem; position: relative; text-decoration: none; }
  .project-links a:hover { border-color: var(--accent-primary); transform: translateY(-1px); }
  .project-links [data-manager-only][hidden] { display: none !important; }
  .project-links strong { display: block; font-size: 1.1rem; line-height: 1.3; padding-right: 1.2rem; }
  .project-links small { color: var(--text-secondary); font-size: .78rem; line-height: 1.55; }
  .project-links a > span { bottom: .5rem; color: var(--accent-primary); font-size: .66rem; font-weight: 800; line-height: 1; position: absolute; right: .65rem; }
  .menu-group[data-menu-group="operations"] .project-links { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .menu-group-management .project-links { grid-template-columns: minmax(0, 10rem); }
  @media (max-width: 800px) {
    .project-home { padding: 0 .8rem 3rem; }
    .project-heading { align-items: start; display: grid; }
    .menu-group-heading { grid-template-columns: auto minmax(0, 1fr); }
    .menu-group-title { grid-column: 2; }
    .project-links { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .menu-group[data-menu-group="operations"] .project-links { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .menu-group-management .project-links { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .menu-group-heading .project-links { grid-column: 2; }
  }
  @media (max-width: 520px) {
    .project-links, .menu-group-management .project-links { grid-template-columns: 1fr; }
  }
</style>
