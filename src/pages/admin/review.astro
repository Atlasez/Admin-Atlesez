---
import AdminLayout from "../../layouts/AdminLayout.astro";
---

<AdminLayout title="査読" description="編集・査読の査読一覧へ移動します">
  <main class="review-redirect">
    <h1>査読機能は「編集・査読」へ移動しました</h1>
    <p>査読依頼、担当者、原稿コメントを一つの流れで確認できます。</p>
    <a href="/admin/articles/?view=review&mode=review">査読一覧を開く →</a>
  </main>
</AdminLayout>

<style>
  .review-redirect { margin: 0 auto; max-width: 56rem; padding: 3rem 1.25rem; }
  .review-redirect h1 { font-size: clamp(1.7rem, 4vw, 2.35rem); margin: 0; }
  .review-redirect p { color: var(--text-secondary); line-height: 1.7; margin: .65rem 0 1.25rem; }
  .review-redirect a { background: var(--accent-primary); border-radius: .45rem; color: #fff; display: inline-flex; font-weight: 800; padding: .65rem .85rem; text-decoration: none; }
</style>

<script>
  import { navigate } from "astro:transitions/client";

  const destination = "/admin/articles/?view=review&mode=review";
  document.addEventListener("astro:page-load", () => {
    if (location.pathname.replace(/\/$/, "") === "/admin/review") void navigate(destination);
  });
</script>
