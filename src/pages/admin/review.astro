---
import AdminLayout from "../../layouts/AdminLayout.astro";
import AdminNav from "../../components/AdminNav.astro";
---

<AdminLayout title="査読スペース" description="運営内運営が査読依頼を確認する画面">
  <main class="review-space" data-review-space>
    <AdminNav current="review" />
    <header class="review-heading">
      <div><p class="eyebrow">ATLASEZ / 運営内運営</p><h1>査読スペース</h1><p>査読中の原稿を確認し、コメント・保留・査読完了を行います。全分野管理者だけが利用できます。</p></div>
      <button type="button" class="quiet-action" data-review-refresh>一覧を更新</button>
    </header>
    <section class="review-intro"><strong>査読の流れ</strong><ol><li>必要なら「査読担当」を選び、依頼を特定の運営メンバーへ割り当てる。</li><li>原稿を開き、本文とプレビューを確認する。</li><li>コメント欄へ修正依頼または確認結果を残す。</li><li>修正が必要なら「査読中」または「保留」、完了なら「査読済み」として保存する。</li><li>公開判断は「記事編集」の公開ボタンで行う。</li></ol></section>
    <div class="review-filters" aria-label="査読依頼の絞り込み"><label for="review-filter">表示</label><select id="review-filter" data-review-filter><option value="all">すべて</option><option value="mine">自分への依頼</option><option value="unassigned">未担当</option></select></div>
    <output class="review-feedback" data-review-feedback aria-live="polite">読み込み中…</output>
    <section class="review-list" data-review-list aria-label="査読依頼一覧"></section>
  </main>
</AdminLayout>

<style>
  .review-space { --surface:var(--background-primary); --alt:var(--background-secondary); --border:var(--border-default); --text:var(--text-primary); --muted:var(--text-secondary); --accent:var(--accent-primary); box-sizing:border-box; color:var(--text); margin:0 auto; max-width:1050px; padding:0 1.25rem 4rem; }
  .review-heading { align-items:start; border-bottom:1px solid var(--border); display:flex; gap:1rem; justify-content:space-between; padding:2rem 0 1.25rem; }
  .eyebrow { color:var(--accent); font-size:.76rem; font-weight:800; letter-spacing:.08em; margin:0 0 .35rem; }.review-heading h1 { font-size:clamp(1.8rem,4vw,2.35rem); margin:0; }.review-heading p { color:var(--muted); line-height:1.6; margin:.45rem 0 0; }
  .quiet-action { background:var(--surface); border:1px solid var(--border); color:var(--text); cursor:pointer; font:inherit; font-size:.82rem; font-weight:800; min-height:2.35rem; padding:.45rem .7rem; }.quiet-action:hover { border-color:var(--accent); color:var(--accent); }
  .review-intro { background:var(--alt); border:1px solid var(--border); border-left:3px solid var(--accent); margin:1.25rem 0; padding:.8rem .95rem; }.review-intro ol { color:var(--muted); line-height:1.7; margin:.45rem 0 0; padding-left:1.25rem; }.review-feedback { color:var(--muted); display:block; font-size:.85rem; min-height:1.3rem; }.review-list { border:1px solid var(--border); display:grid; margin-top:.3rem; }
  .review-filters { align-items:center; display:flex; gap:.55rem; margin:1rem 0 .4rem; }.review-filters label { color:var(--muted); font-size:.78rem; font-weight:800; }.review-filters select { background:var(--surface); border:1px solid var(--border); color:var(--text); font:inherit; font-size:.8rem; min-height:2.2rem; padding:.35rem .55rem; }
  .review-card { background:var(--surface); border-bottom:1px solid var(--border); display:grid; gap:.75rem; padding:.85rem .9rem; }.review-card:last-child { border-bottom:0; }.review-card:hover { background:var(--alt); }.review-card h2 { font-size:1rem; margin:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }.review-card p { color:var(--muted); font-size:.76rem; margin:.26rem 0 0; }.review-card a { background:var(--accent); color:#fff; font-size:.8rem; font-weight:800; padding:.5rem .65rem; text-decoration:none; white-space:nowrap; }
  .review-card-tools { align-items:center; display:flex; flex-wrap:wrap; gap:.75rem; justify-content:space-between; }.review-assignment { align-items:center; display:flex; flex:1 1 28rem; flex-wrap:wrap; gap:.4rem; }.review-assignment label { color:var(--muted); font-size:.76rem; font-weight:800; }.review-assignment select,.review-assignment input { background:var(--surface); border:1px solid var(--border); color:var(--text); font:inherit; font-size:.78rem; min-height:2.2rem; min-width:14rem; padding:.35rem .5rem; }.review-assignment input { min-width:11rem; }.review-assignment button { background:var(--surface); border:1px solid var(--border); color:var(--text); cursor:pointer; font:inherit; font-size:.76rem; font-weight:800; min-height:2.2rem; padding:.35rem .55rem; }.review-assignment button:hover { border-color:var(--accent); color:var(--accent); }.review-assignment output { color:var(--muted); font-size:.72rem; }.review-priority { background:#e7f1fb; border:1px solid #a8c8e0; border-radius:999px; color:#185c86; font-size:.7rem; font-weight:800; padding:.18rem .45rem; white-space:nowrap; }.review-due { color:var(--muted); font-size:.72rem; }.review-due.is-overdue { color:#a13b3b; font-weight:800; }.review-empty { color:var(--muted); padding:3rem 1rem; text-align:center; }
  @media(max-width:650px){.review-space{padding:0 .9rem 3rem}.review-heading,.review-card{display:grid;grid-template-columns:1fr}.review-card a{justify-self:start}.review-assignment{align-items:stretch;display:grid;grid-template-columns:1fr}.review-assignment select,.review-assignment input{min-width:0;width:100%}.review-assignment button{justify-self:start}}
</style>

<script>
  type Reviewer = { email: string; displayName: string; subjects: string[] };
  type ReviewRequest = { id: string; subject: string; category: string; title: string; updated_by: string; updated_at: string; reviewer_email: string | null; reviewerDisplayName: string; assignedToMe: boolean; dueAt: string | null };
  const initializeReviewSpace = () => {
    const root = document.querySelector<HTMLElement>("[data-review-space]");
    if (!root || root.dataset.reviewSpaceInitialized === "true") return;
    root.dataset.reviewSpaceInitialized = "true";
    const list = root.querySelector<HTMLElement>("[data-review-list]")!;
    const feedback = root.querySelector<HTMLOutputElement>("[data-review-feedback]")!;
    const refresh = root.querySelector<HTMLButtonElement>("[data-review-refresh]")!;
    const filter = root.querySelector<HTMLSelectElement>("[data-review-filter]")!;
    const escapeHtml = (value: string) => value.replace(/[&<>"']/g, (character) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[character] ?? character);
    const formatDate = (value: string) => new Intl.DateTimeFormat("ja-JP", { dateStyle: "medium", timeStyle: "short" }).format(new Date(value));
    const read = async <T,>(response: Response) => { if (!(response.headers.get("content-type") ?? "").includes("application/json")) throw new Error("認証が切れました。ページを再読み込みしてログインし直してください。"); return await response.json() as T; };
    let reviewers: Reviewer[] = [];
    let lastRequests: ReviewRequest[] = [];
    const reviewerOptions = (item: ReviewRequest) => [`<option value="">未割り当て</option>`, ...reviewers.filter((reviewer) => reviewer.subjects.includes("*") || reviewer.subjects.includes(item.subject)).map((reviewer) => `<option value="${escapeHtml(reviewer.email)}"${reviewer.email === item.reviewer_email ? " selected" : ""}>${escapeHtml(reviewer.displayName)}</option>`)].join("");
    const dueInputValue = (value: string | null) => value ? value.slice(0, 16) : "";
    const render = (requests: ReviewRequest[]) => { const selected = filter.value; const visible = requests.filter((item) => selected === "all" || (selected === "mine" && item.assignedToMe) || (selected === "unassigned" && !item.reviewer_email)); list.innerHTML = visible.length ? visible.map((item) => `<article class="review-card"><div><h2>${escapeHtml(item.title)} ${item.assignedToMe ? '<span class="review-priority">自分への依頼</span>' : ""}</h2><p>${escapeHtml(item.subject)} / ${escapeHtml(item.category)} ・ 依頼者: ${escapeHtml(item.updated_by)} ・ ${formatDate(item.updated_at)}${item.reviewerDisplayName && item.reviewer_email ? ` ・ 担当: ${escapeHtml(item.reviewerDisplayName)}` : ""}</p>${item.dueAt ? `<span class="review-due${Date.parse(item.dueAt) < Date.now() ? " is-overdue" : ""}">期限: ${escapeHtml(formatDate(item.dueAt))}</span>` : `<span class="review-due">期限未設定</span>`}</div><div class="review-card-tools"><div class="review-assignment"><label for="reviewer-${escapeHtml(item.id)}">査読担当</label><select id="reviewer-${escapeHtml(item.id)}" data-reviewer-for="${escapeHtml(item.id)}">${reviewerOptions(item)}</select><label for="due-${escapeHtml(item.id)}">期限</label><input id="due-${escapeHtml(item.id)}" type="datetime-local" data-due-for="${escapeHtml(item.id)}" value="${escapeHtml(dueInputValue(item.dueAt))}" /><button type="button" data-save-reviewer="${escapeHtml(item.id)}">割り当てを保存</button><output data-reviewer-message="${escapeHtml(item.id)}"></output></div><a href="/admin/editor/?document=${encodeURIComponent(item.id)}">原稿を開いて査読</a></div></article>`).join("") : '<p class="review-empty">現在、査読依頼はありません。</p>'; };
    const load = async () => { feedback.value = "読み込み中…"; refresh.disabled = true; try { const response = await fetch("/api/admin/editor/review-requests", { credentials: "same-origin" }); const data = await read<{ requests?: ReviewRequest[]; reviewers?: Reviewer[]; error?: string }>(response); if (!response.ok) throw new Error(data.error ?? "査読依頼を読み込めませんでした。"); reviewers = data.reviewers ?? []; lastRequests = data.requests ?? []; render(lastRequests); feedback.value = `${lastRequests.length}件の査読依頼${lastRequests.some((item) => item.assignedToMe) ? "（自分への依頼を先頭に表示）" : ""}`; } catch (error) { const message = error instanceof Error ? error.message : "査読依頼を読み込めませんでした。"; list.innerHTML = `<p class="review-empty">${escapeHtml(message)}</p>`; feedback.value = ""; } finally { refresh.disabled = false; } };
    refresh.addEventListener("click", () => void load());
    filter.addEventListener("change", () => { if (lastRequests) render(lastRequests); });
    list.addEventListener("click", (event) => { const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-save-reviewer]"); if (!button) return; const id = button.dataset.saveReviewer; const select = id ? list.querySelector<HTMLSelectElement>(`[data-reviewer-for="${id}"]`) : null; const dueInput = id ? list.querySelector<HTMLInputElement>(`[data-due-for="${id}"]`) : null; const message = id ? list.querySelector<HTMLOutputElement>(`[data-reviewer-message="${id}"]`) : null; if (!id || !select) return; button.disabled = true; if (message) message.value = "保存中…"; void (async () => { const response = await fetch(`/api/admin/editor/review-requests/${encodeURIComponent(id)}`, { method: "PATCH", headers: { "content-type": "application/json" }, credentials: "same-origin", body: JSON.stringify({ reviewerEmail: select.value, dueAt: dueInput?.value ? new Date(dueInput.value).toISOString() : "" }) }); const data = await read<{ error?: string }>(response); if (!response.ok) throw new Error(data.error ?? "査読担当を保存できませんでした。"); await load(); })().catch((error: unknown) => { if (message) message.value = error instanceof Error ? error.message : "査読担当を保存できませんでした。"; button.disabled = false; }); });
    void load();
  };
  document.addEventListener("astro:page-load", initializeReviewSpace);
  initializeReviewSpace();
</script>
