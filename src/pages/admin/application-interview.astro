---
import AdminLayout from "../../layouts/AdminLayout.astro";
---

<AdminLayout title="面談メモ" description="応募者の面談情報と選考メモを管理します">
  <main class="interview-page" data-interview-page>
    <a class="back-link" data-back-link href="/admin/applications/">← 応募一覧へ戻る</a>
    <header>
      <p class="eyebrow">INTERVIEW REVIEW</p>
      <h1>面談メモ</h1>
      <p class="lead">面談内容と選考結果を記録します。応募者には表示されません。</p>
    </header>
    <section class="app-summary" aria-labelledby="app-summary-title">
      <div><span class="summary-label">応募者</span><h2 id="app-summary-title" data-applicant-name>読み込み中…</h2><p data-applicant-email></p></div>
      <span class="status-pill" data-applicant-status>—</span>
    </section>
    <output class="notice" data-notice aria-live="polite"></output>
    <form class="review-form" data-review-form>
      <section class="form-section" aria-labelledby="meeting-title">
        <div class="section-heading"><div><p class="eyebrow">MEETING</p><h2 id="meeting-title">面談情報</h2></div><span data-meeting-status>—</span></div>
        <dl class="meeting-summary"><div><dt>日時</dt><dd data-meeting-date>未設定</dd></div><div><dt>形式</dt><dd data-meeting-format>未設定</dd></div><div><dt>Zoom</dt><dd data-meeting-zoom>—</dd></div></dl>
      </section>
      <section class="form-section" aria-labelledby="notes-title">
        <div class="section-heading"><div><p class="eyebrow">PRIVATE NOTE</p><h2 id="notes-title">面談の内容</h2></div><span>運営内メモ</span></div>
        <label class="field field--wide">自由メモ<textarea data-notes maxlength="20000" placeholder="面談で確認したこと、本人の希望、気になった点などを入力"></textarea><small>応募者には公開されません。</small></label>
      </section>
      <section class="form-section" aria-labelledby="decision-title">
        <div class="section-heading"><div><p class="eyebrow">DECISION</p><h2 id="decision-title">担当と採否</h2></div><span>採用確定時に担当を反映</span></div>
        <fieldset class="field-group"><legend>担当分野</legend><p class="field-hint">面談後に担当する分野を選択してください（複数可）。</p><div class="subject-options" data-subject-options><span class="muted">読み込み中…</span></div></fieldset>
        <label class="field">採否<select data-decision><option value="undecided">未判定</option><option value="hold">保留</option><option value="accepted">採用</option><option value="rejected">見送り</option></select></label>
        <label class="confirm-check" data-confirm-wrap hidden><input type="checkbox" data-confirm-accept /> <span>採用を確定し、選択した担当分野を応募者の権限へ反映することを確認しました。</span></label>
      </section>
      <div class="form-actions"><a class="button button--quiet" data-cancel-link href="/admin/applications/">キャンセル</a><button class="button" type="submit" data-save>メモを保存</button></div>
    </form>
  </main>
</AdminLayout>

<style>
  .interview-page{margin:0 auto;max-width:850px;padding:1.6rem 1.25rem 4rem}.back-link{color:var(--accent-primary);font-size:.8rem;font-weight:800;text-decoration:none}.back-link:hover{text-decoration:underline}.interview-page header{border-bottom:1px solid var(--border-default);padding:1.1rem 0 1.3rem}.eyebrow{color:var(--accent-primary);font-size:.68rem;font-weight:900;letter-spacing:.1em;margin:0 0 .35rem}.interview-page h1{font-size:clamp(1.8rem,4vw,2.35rem);margin:0}.lead{color:var(--text-secondary);font-size:.85rem;margin:.5rem 0 0}.app-summary{align-items:center;background:var(--background-secondary);border:1px solid var(--border-default);border-left:3px solid var(--accent-primary);display:flex;gap:1rem;justify-content:space-between;margin-top:1.25rem;padding:.9rem 1rem}.summary-label{color:var(--text-secondary);display:block;font-size:.68rem;font-weight:800}.app-summary h2{font-size:1.1rem;margin:.18rem 0}.app-summary p{color:var(--text-secondary);font-size:.76rem;margin:0}.status-pill{border:1px solid var(--border-default);border-radius:999px;font-size:.72rem;font-weight:800;padding:.3rem .65rem;white-space:nowrap}.status-pill[data-status="accepted"]{background:#e7f6ec;color:#176b32}.status-pill[data-status="rejected"]{background:#fff0f0;color:#922b24}.notice{display:block;min-height:1.5rem;padding:.7rem 0 0}.notice[data-error="true"]{color:#b42318}.review-form{display:grid;gap:.8rem}.form-section{background:var(--background-secondary);border:1px solid var(--border-default);border-radius:.65rem;padding:1rem}.section-heading{align-items:baseline;display:flex;gap:.75rem;justify-content:space-between;margin-bottom:.75rem}.section-heading h2{font-size:1.05rem;margin:0}.section-heading>span{color:var(--text-secondary);font-size:.7rem}.meeting-summary{display:grid;gap:.55rem;grid-template-columns:repeat(3,1fr);margin:0}.meeting-summary div{background:var(--background-primary);border:1px solid var(--border-default);border-radius:.45rem;padding:.65rem .7rem}.meeting-summary dt{color:var(--text-secondary);font-size:.67rem;font-weight:800}.meeting-summary dd{font-size:.8rem;line-height:1.5;margin:.25rem 0 0;overflow-wrap:anywhere}.meeting-summary a{color:var(--accent-primary);font-weight:700}.field{display:grid;gap:.35rem;font-size:.78rem;font-weight:800;margin-top:.75rem}.field--wide{margin-top:0}.field textarea,.field select{background:var(--background-primary);border:1px solid var(--border-default);border-radius:.35rem;box-sizing:border-box;color:var(--text-primary);font:inherit;padding:.65rem;width:100%}.field textarea{min-height:14rem;resize:vertical;line-height:1.7}.field small,.field-hint{color:var(--text-secondary);font-size:.7rem;font-weight:500}.field-hint{margin:.1rem 0 .65rem}.field-group{border:0;margin:0;padding:0}.field-group legend{font-size:.78rem;font-weight:800;padding:0}.subject-options{display:grid;gap:.5rem;grid-template-columns:repeat(3,minmax(0,1fr))}.subject-option{align-items:center;background:var(--background-primary);border:1px solid var(--border-default);border-radius:.35rem;display:flex;font-size:.78rem;font-weight:700;gap:.45rem;min-height:2.4rem;padding:.35rem .5rem}.subject-option:has(input:checked){background:color-mix(in srgb,var(--accent-primary) 12%,var(--background-primary));border-color:var(--accent-primary)}.subject-option input{accent-color:var(--accent-primary);margin:0}.muted{color:var(--text-secondary);font-size:.75rem}.confirm-check{align-items:flex-start;background:color-mix(in srgb,#d97706 10%,var(--background-primary));border:1px solid color-mix(in srgb,#d97706 38%,var(--border-default));border-radius:.4rem;display:flex;font-size:.74rem;gap:.5rem;line-height:1.55;margin-top:.85rem;padding:.7rem}.confirm-check input{accent-color:var(--accent-primary);flex:0 0 auto;margin-top:.15rem}.form-actions{display:flex;gap:.55rem;justify-content:flex-end;padding-top:.2rem}.button{appearance:none;background:var(--accent-primary);border:1px solid var(--accent-primary);border-radius:.35rem;color:#fff;cursor:pointer;font:inherit;font-size:.78rem;font-weight:800;min-height:2.4rem;padding:.55rem .8rem;text-decoration:none}.button--quiet{background:transparent;color:var(--accent-primary)}.button:disabled{cursor:wait;opacity:.55}@media(max-width:620px){.interview-page{padding:1.2rem .85rem 3rem}.app-summary{align-items:flex-start;display:grid}.status-pill{justify-self:start}.meeting-summary{grid-template-columns:1fr}.subject-options{grid-template-columns:repeat(2,minmax(0,1fr))}.form-actions{display:grid}.form-actions .button{justify-content:center;text-align:center;width:100%}}@media(max-width:390px){.subject-options{grid-template-columns:1fr}}
</style>

<script>
  const root=document.querySelector<HTMLElement>('[data-interview-page]');
  if(root){
    type Interview={scheduledAt?:string|null;format?:string|null;zoomUrl?:string|null;notes?:string|null;subjects?:string[]|null;decision?:string|null;completedAt?:string|null};
    type InterviewResponse={application?:{id?:string;name?:string;email?:string;status?:string};interview?:Interview;subjectLabels?:Record<string,string>;error?:string};
    const params=new URLSearchParams(location.search);const applicationId=params.get('application')?.trim()??'';const project=params.get('project')?.trim()??'';
    const get=<T extends Element>(selector:string)=>root.querySelector<T>(selector)!;const notice=get<HTMLOutputElement>('[data-notice]');const form=get<HTMLFormElement>('[data-review-form]');const decision=get<HTMLSelectElement>('[data-decision]');const confirmWrap=get<HTMLElement>('[data-confirm-wrap]');const confirm=get<HTMLInputElement>('[data-confirm-accept]');
    const setNotice=(message:string,error=false)=>{notice.value=message;notice.dataset.error=String(error)};const formatDate=(value:unknown)=>{if(!value)return '未設定';const date=new Date(String(value));return Number.isNaN(date.getTime())?'未設定':new Intl.DateTimeFormat('ja-JP',{dateStyle:'medium',timeStyle:'short'}).format(date)};
    const showDecisionConfirm=()=>{confirmWrap.hidden=decision.value!=='accepted';if(decision.value!=='accepted')confirm.checked=false};decision.addEventListener('change',showDecisionConfirm);
    const apply=(data:InterviewResponse)=>{const app=data.application??{};get<HTMLElement>('[data-applicant-name]').textContent=app.name||'応募者';get<HTMLElement>('[data-applicant-email]').textContent=app.email||'';const status=get<HTMLElement>('[data-applicant-status]');status.textContent=({new:'新規',reviewing:'確認中',accepted:'受入済み',rejected:'見送り'} as Record<string,string>)[app.status??'']??'—';status.dataset.status=app.status??'';const interview=data.interview??{};get<HTMLElement>('[data-meeting-date]').textContent=formatDate(interview.scheduledAt);get<HTMLElement>('[data-meeting-format]').textContent=interview.format==='in_person'?'対面':interview.format==='online'?'オンライン（Zoom）':'未設定';const zoom=get<HTMLElement>('[data-meeting-zoom]');if(interview.zoomUrl){zoom.innerHTML='';const link=document.createElement('a');link.href=interview.zoomUrl;link.target='_blank';link.rel='noopener noreferrer';link.textContent='Zoomを開く';zoom.append(link)}else zoom.textContent='—';get<HTMLElement>('[data-meeting-status]').textContent=interview.completedAt?`実施済み：${formatDate(interview.completedAt)}`:'予定';get<HTMLTextAreaElement>('[data-notes]').value=interview.notes??'';decision.value=interview.decision??'undecided';const selected=new Set(interview.subjects??[]);const options=get<HTMLElement>('[data-subject-options]');const labels=data.subjectLabels??{};const keys=Object.keys(labels);options.innerHTML=keys.length?keys.map(key=>`<label class="subject-option"><input type="checkbox" value="${key.replace(/[&<>"']/g,char=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]??char))}" ${selected.has(key)?'checked':''} /> <span>${String(labels[key]).replace(/[&<>"']/g,char=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]??char))}</span></label>`).join(''):'<span class="muted">担当分野の候補がありません。</span>';showDecisionConfirm()};
    const load=async()=>{if(!applicationId){setNotice('応募者が指定されていません。',true);form.querySelectorAll('input,textarea,select,button[type="submit"]').forEach((element)=>{(element as HTMLInputElement).disabled=true});return}try{const response=await fetch(`/api/admin/applications/${encodeURIComponent(applicationId)}/interview?project=${encodeURIComponent(project)}`,{credentials:'same-origin',cache:'no-store'});const data=await response.json() as InterviewResponse;if(!response.ok)throw Error(data.error??'面談情報を読み込めませんでした。');apply(data)}catch(error){setNotice(error instanceof Error?error.message:'面談情報を読み込めませんでした。',true)}};
    form.addEventListener('submit',async(event)=>{event.preventDefault();if(decision.value==='accepted'&&!confirm.checked){setNotice('採用を確定する場合は確認欄にチェックしてください。',true);confirm.focus();return}const subjects=[...root.querySelectorAll<HTMLInputElement>('[data-subject-options] input:checked')].map(input=>input.value);const save=get<HTMLButtonElement>('[data-save]');save.disabled=true;setNotice('面談メモを保存中…');try{const response=await fetch(`/api/admin/applications/${encodeURIComponent(applicationId)}/interview?project=${encodeURIComponent(project)}`,{method:'PUT',credentials:'same-origin',headers:{'content-type':'application/json'},body:JSON.stringify({notes:get<HTMLTextAreaElement>('[data-notes]').value,subjects,decision:decision.value,confirmAcceptance:confirm.checked})});const data=await response.json().catch(()=>({}));if(!response.ok)throw Error(data.error??'面談メモを保存できませんでした。');setNotice(decision.value==='accepted'?'面談メモを保存し、担当を反映しました。':'面談メモを保存しました。');await load()}catch(error){setNotice(error instanceof Error?error.message:'面談メモを保存できませんでした。',true)}finally{save.disabled=false}});
    const back=`/admin/applications/?project=${encodeURIComponent(project)}`;get<HTMLAnchorElement>('[data-back-link]').href=back;get<HTMLAnchorElement>('[data-cancel-link]').href=back;void load();
  }
</script>
