---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import AdminNav from "../../../components/AdminNav.astro";
import AdminBreadcrumb from "../../../components/AdminBreadcrumb.astro";
---

<AdminLayout title="ゼミプラットフォーム運営用ページ" description="ゼミプラットフォームのタスク管理">
  <main class="project-page" data-project-page>
    <AdminNav current="seminar" />
    <AdminBreadcrumb items={[{ label: "メンバー用サイト", href: "/admin/portal/" }, { label: "ゼミプラットフォーム運営用ページ" }]} />
    <header class="project-heading">
      <div><h1>ゼミプラットフォーム運営用ページ</h1><p>このプロジェクトで担当しているタスクを確認できます。</p></div>
      <a class="back-link" href="/admin/portal/">Homeへ戻る</a>
    </header>
    <section class="project-actions" aria-label="プロジェクトメニュー">
      <a href="/admin/projects/seminar-platform/workspace/"><strong>このプロジェクトのマイページ</strong><small>プロジェクト内の自己紹介と個人メモ</small><span>開く →</span></a>
    </section>
    <section class="task-section" aria-labelledby="task-heading">
      <div class="section-heading"><div><h2 id="task-heading">担当タスク</h2><p>完了していないタスクだけを表示しています。</p></div></div>
      <div class="task-list" data-tasks>タスクを読み込んでいます…</div>
    </section>
  </main>
</AdminLayout>

<style>
  .project-page{box-sizing:border-box;margin:0 auto;max-width:1100px;padding:0 1.25rem 4rem}.project-heading{align-items:end;border-bottom:1px solid var(--border-default);display:flex;gap:1rem;justify-content:space-between;padding:2.4rem 0 1.4rem}.eyebrow{color:var(--accent-primary);font-size:.72rem;font-weight:800;letter-spacing:.1em;margin:0 0 .35rem}.project-heading h1{font-size:clamp(1.75rem,4vw,2.5rem);letter-spacing:-.04em;margin:0}.project-heading p:last-child{color:var(--text-secondary);line-height:1.6;margin:.45rem 0 0}.back-link{color:var(--accent-primary);font-size:.8rem;font-weight:800;text-decoration:none;white-space:nowrap}.project-actions,.task-section{margin:1.5rem auto 0;width:min(100%,64rem)}.project-actions a{background:var(--background-secondary);border:1px solid var(--border-default);border-top:3px solid var(--accent-primary);color:var(--text-primary);display:grid;gap:.3rem;max-width:24rem;padding:1rem;text-decoration:none}.project-actions small{color:var(--text-secondary);font-size:.78rem}.project-actions span{color:var(--accent-primary);font-size:.76rem;font-weight:800;margin-top:.2rem}.section-heading{border-bottom:1px solid var(--border-default);padding-bottom:.7rem}.section-heading h2{font-size:1.2rem;margin:.2rem 0 0}.section-heading p:last-child{color:var(--text-secondary);font-size:.82rem;margin:.35rem 0 0}.task-list{display:grid;gap:.55rem;margin-top:.85rem}.task-card{border:1px solid var(--border-default);border-left:3px solid var(--accent-primary);display:grid;gap:.25rem;padding:.7rem .8rem}.task-card b{font-size:.9rem}.task-card small{color:var(--text-secondary);font-size:.75rem;line-height:1.5}.empty{border:1px dashed var(--border-default);color:var(--text-secondary);font-size:.82rem;padding:.9rem}@media(max-width:700px){.project-page{padding:0 .85rem 3rem}.project-heading{align-items:start;display:grid}.back-link{justify-self:start}}
</style>

<script>
  type Todo={title:string;details?:string|null;subject?:string|null;status:string;project_name?:string|null};
  const initializeProjectPage=()=>{const root=document.querySelector<HTMLElement>('[data-project-page]');if(!root||root.dataset.initialized==='true')return;root.dataset.initialized='true';const list=root.querySelector<HTMLElement>('[data-tasks]')!;const esc=(value:string)=>value.replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]??c));void fetch('/api/admin/portal?project=seminar-platform',{credentials:'same-origin',cache:'no-store'}).then(async response=>{const type=response.headers.get('content-type')??'';const data=type.includes('application/json')?await response.json() as {todos?:Todo[];error?:string}:null;if(!response.ok||!data)throw new Error(data?.error??'タスクを読み込めませんでした。');const todos=data.todos??[];list.innerHTML=todos.length?todos.map(todo=>`<article class="task-card"><b>${esc(todo.title)}</b><small>${todo.subject?`${esc(todo.subject)} ・ `:''}${esc(todo.status)}</small>${todo.details?`<small>${esc(todo.details)}</small>`:''}</article>`).join(''):'<p class="empty">現在、担当タスクはありません。</p>';}).catch(error=>{list.textContent=error instanceof Error?error.message:'タスクを読み込めませんでした。';});};document.addEventListener('astro:page-load',initializeProjectPage);initializeProjectPage();
</script>
