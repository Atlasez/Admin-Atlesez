---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import AdminNav from "../../../components/AdminNav.astro";
import AdminBreadcrumb from "../../../components/AdminBreadcrumb.astro";

const timezones: [string, string][] = [
  ["Pacific/Honolulu", "ホノルル"], ["America/Los_Angeles", "ロサンゼルス"], ["America/Denver", "デンバー"], ["America/Chicago", "シカゴ"], ["America/New_York", "ニューヨーク"], ["America/Sao_Paulo", "サンパウロ"], ["UTC", "UTC"], ["Europe/London", "ロンドン"], ["Europe/Paris", "パリ"], ["Europe/Berlin", "ベルリン"], ["Africa/Cairo", "カイロ"], ["Asia/Dubai", "ドバイ"], ["Asia/Kolkata", "コルカタ"], ["Asia/Bangkok", "バンコク"], ["Asia/Shanghai", "上海"], ["Asia/Taipei", "台北"], ["Asia/Tokyo", "東京"], ["Asia/Seoul", "ソウル"], ["Australia/Sydney", "シドニー"], ["Pacific/Auckland", "オークランド"],
];
---

<AdminLayout title="Atlasez運営事務局" description="Atlasez運営事務局のタスクと日程を管理します。">
  <main class="secretariat-page" data-secretariat>
    <AdminNav current="secretariat" />
    <AdminBreadcrumb items={[{ label: "メンバー用サイト", href: "/admin/portal/" }, { label: "Atlasez運営事務局" }]} />
    <header class="page-heading">
      <div><p class="eyebrow">ATLASEZ / SECRETARIAT</p><h1>Atlasez運営事務局</h1><p>団体全体のタスクと同時作業会の日程を管理します。</p></div>
      <a class="back-link" href="/admin/portal/">メンバー用Homeへ戻る</a>
    </header>
    <div class="actions" aria-label="運営事務局メニュー">
      <a href="/admin/projects/secretariat/workspace/"><strong>このプロジェクトのマイページ</strong><small>運営事務局内で共有するプロフィール</small></a>
      <a href="/admin/portal/"><strong>他のプロジェクトを見る</strong><small>アトラス・ゼミプラットフォームへ移動</small></a>
    </div>
    <div class="status" data-status aria-live="polite"></div>
    <div class="board">
      <section class="panel" aria-labelledby="todo-title">
        <div class="panel-heading"><div><p class="eyebrow">TASKS</p><h2 id="todo-title">運営事務局のToDo</h2></div><p class="anonymous-name-notice">表示名未設定の参加者は匿名の自動表示名で表示されます。</p></div>
        <form class="compact-form" data-todo-form>
          <label>タスク名<input required data-todo-title maxlength="200" placeholder="例：次回交流会の案内を作成" /></label>
          <label>担当者<select data-todo-assignee><option value="">担当者を指定しない</option></select></label>
          <label>詳細<textarea data-todo-details rows="2" maxlength="4000" placeholder="必要なら補足を入力"></textarea></label>
          <button type="submit">ToDoを追加</button>
        </form>
        <div class="list" data-todo-list><span class="loading">読み込んでいます…</span></div>
      </section>
      <section class="panel" aria-labelledby="event-title">
        <div class="panel-heading"><div><p class="eyebrow">SCHEDULE</p><h2 id="event-title">同時作業会・交流会の日程</h2></div></div>
        <form class="compact-form" data-event-form>
          <label>名称<input required data-event-title maxlength="200" placeholder="例：運営事務局の同時作業会" /></label>
          <div class="two-fields"><label>開始<input required type="datetime-local" data-event-start /></label><label>終了<input type="datetime-local" data-event-end /></label></div>
          <label>タイムゾーン<select data-event-timezone>{timezones.map(([value,label]) => <option value={value} selected={value === "Asia/Tokyo"}>{label}</option>)}</select></label>
          <button type="submit">日程を追加</button>
        </form>
        <div class="list" data-event-list><span class="loading">読み込んでいます…</span></div>
      </section>
    </div>
  </main>
</AdminLayout>

<style>
  .secretariat-page{box-sizing:border-box;margin:0 auto;max-width:1120px;padding:0 1.25rem 4rem}.page-heading{align-items:end;border-bottom:1px solid var(--border-default);display:flex;gap:1rem;justify-content:space-between;padding:2.3rem 0 1.35rem}.eyebrow{color:var(--accent-primary);font-size:.72rem;font-weight:850;letter-spacing:.08em;margin:0 0 .35rem}.page-heading h1{font-size:clamp(1.8rem,4vw,2.6rem);letter-spacing:-.03em;margin:0}.page-heading p:last-child{color:var(--text-secondary);line-height:1.6;margin:.45rem 0 0}.back-link{color:var(--accent-primary);font-size:.8rem;font-weight:800;white-space:nowrap}.actions{display:flex;flex-wrap:wrap;gap:.65rem;margin:1.3rem auto 0;width:min(100%,64rem)}.actions a{border:1px solid var(--border-default);border-top:3px solid var(--accent-primary);color:var(--text-primary);display:grid;gap:.25rem;min-width:15rem;padding:.8rem;text-decoration:none}.actions a:hover{border-color:var(--accent-primary);background:var(--background-secondary)}.actions small{color:var(--text-secondary);font-size:.75rem}.status{color:var(--text-secondary);font-size:.78rem;min-height:1.5rem;padding:.8rem .1rem .1rem}.board{display:grid;gap:1rem;grid-template-columns:1fr 1fr;margin:0 auto;width:min(100%,64rem)}.panel{border:1px solid var(--border-default);padding:1rem}.panel-heading{border-bottom:1px solid var(--border-default);padding-bottom:.7rem}.panel h2{font-size:1.15rem;margin:.15rem 0 0}.compact-form{display:grid;gap:.55rem;margin-top:.85rem}.compact-form label{color:var(--text-secondary);display:grid;font-size:.72rem;font-weight:800;gap:.2rem}.compact-form input,.compact-form textarea,.compact-form select{background:var(--background-primary);border:1px solid var(--border-default);box-sizing:border-box;color:var(--text-primary);font:inherit;padding:.5rem;width:100%}.compact-form textarea{resize:vertical}.compact-form button{background:var(--accent-primary);border:1px solid var(--accent-primary);color:#fff;cursor:pointer;font:inherit;font-size:.78rem;font-weight:800;justify-self:start;padding:.55rem .75rem}.two-fields{display:grid;gap:.5rem;grid-template-columns:1fr 1fr}.list{display:grid;gap:.5rem;margin-top:1rem}.item{border:1px solid var(--border-default);border-left:3px solid var(--accent-primary);display:grid;gap:.2rem;padding:.65rem .7rem}.item strong{font-size:.85rem}.item small{color:var(--text-secondary);font-size:.72rem;line-height:1.5}.item select{background:var(--background-primary);border:1px solid var(--border-default);color:var(--text-primary);font:inherit;font-size:.72rem;padding:.25rem}.empty,.loading{color:var(--text-secondary);font-size:.78rem;padding:.8rem 0}
  .anonymous-name-notice{background:color-mix(in srgb,var(--accent-primary) 9%,transparent);border-left:3px solid var(--accent-primary);color:var(--text-secondary);font-size:.7rem;line-height:1.45;margin:.45rem 0 0;padding:.4rem .55rem}
  @media(max-width:760px){.secretariat-page{padding:0 .8rem 3rem}.page-heading{align-items:start;display:grid}.back-link{justify-self:start}.board{grid-template-columns:1fr}.actions a{flex:1 1 100%;min-width:0}.two-fields{grid-template-columns:1fr}}
</style>

<script>
  type Member = { email:string; display_name?:string };
  type Todo = { id:string; title:string; details?:string|null; status:string; assignee_email?:string|null };
  type Event = { id:string; title:string; starts_at:string; ends_at?:string|null; timezone:string; availability?:string|null; participants?:Array<{displayName:string;availability:string;isSelf:boolean}> };
  type Data = { scope:{isManager:boolean}; members?:Member[]; todos?:Todo[]; events?:Event[] };
  const initializeSecretariat = () => {
    const root = document.querySelector<HTMLElement>('[data-secretariat]');
    if (!root || root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const todoList = root.querySelector<HTMLElement>('[data-todo-list]')!;
    const eventList = root.querySelector<HTMLElement>('[data-event-list]')!;
    const todoAssignee = root.querySelector<HTMLSelectElement>('[data-todo-assignee]')!;
    const esc = (value:string) => value.replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c] ?? c));
    const anonymousMemberLabel = (value:string) => { const normalized=value.trim().toLowerCase(); let hash=2166136261; for(const character of normalized){hash^=character.codePointAt(0)??0;hash=Math.imul(hash,16777619);} return `運営メンバー ${(hash>>>0)%9000+1000}`; };
    const memberDisplayName = (name:unknown,email:string) => { const value=String(name??'').trim(); return !value||value==='表示名未設定'?anonymousMemberLabel(email):value; };
    const api = async <T,>(method='GET', body?:unknown, path='/api/admin/projects/secretariat/operations') => { const response = await fetch(path,{method,credentials:'same-origin',cache:'no-store',headers:body===undefined?{}:{'content-type':'application/json'},body:body===undefined?undefined:JSON.stringify(body)}); const type=response.headers.get('content-type')??''; const data=type.includes('application/json')?await response.json() as T & {error?:string}:null; if(!response.ok||!data) throw new Error(data?.error??'情報を読み込めませんでした。'); return data; };
    let data:Data={scope:{isManager:false}};
    const render = () => { const members=new Map((data.members??[]).map(m=>[m.email,memberDisplayName(m.display_name,m.email)])); todoAssignee.innerHTML='<option value="">担当者を指定しない</option>'+(data.members??[]).map(m=>`<option value="${esc(m.email)}">${esc(memberDisplayName(m.display_name,m.email))}</option>`).join(''); todoList.innerHTML=(data.todos??[]).length?(data.todos??[]).map(t=>`<article class="item"><strong>${esc(t.title)}</strong><small>${t.assignee_email?`担当：${esc(members.get(t.assignee_email)||memberDisplayName('',t.assignee_email))} ・ `:''}${esc(t.status)}</small>${t.details?`<small>${esc(t.details)}</small>`:''}<select data-todo-status="${esc(t.id)}" aria-label="${esc(t.title)}の状態"><option value="open" ${t.status==='open'?'selected':''}>未着手</option><option value="doing" ${t.status==='doing'?'selected':''}>進行中</option><option value="done" ${t.status==='done'?'selected':''}>完了</option></select></article>`).join():'<p class="empty">未完了のタスクはありません。</p>'; eventList.innerHTML=(data.events??[]).length?(data.events??[]).map(e=>`<article class="item"><strong>${esc(e.title)}</strong><small>${esc(new Date(e.starts_at).toLocaleString('ja-JP'))}${e.ends_at?` 〜 ${esc(new Date(e.ends_at).toLocaleString('ja-JP'))}`:''}</small><div>${(e.participants??[]).map(p=>`<small>${esc(p.isSelf?'自分':p.displayName)}：${esc(p.availability)}</small>`).join('　')}</div><div><button type="button" data-availability="available" data-event="${esc(e.id)}">参加</button><button type="button" data-availability="maybe" data-event="${esc(e.id)}">未定</button><button type="button" data-availability="unavailable" data-event="${esc(e.id)}">不参加</button></div></article>`).join():'<p class="empty">登録された日程はありません。</p>'; };
    const load = async () => { data=await api<Data>(); render(); };
    root.querySelector<HTMLFormElement>('[data-todo-form]')!.addEventListener('submit',e=>{e.preventDefault();const form=e.currentTarget as HTMLFormElement;const title=form.querySelector<HTMLInputElement>('[data-todo-title]')!.value;const details=form.querySelector<HTMLTextAreaElement>('[data-todo-details]')!.value;void api('POST',{type:'todo',title,details,assigneeEmail:todoAssignee.value}).then(()=>{form.reset();status.textContent='ToDoを追加しました。';return load();}).catch(err=>{status.textContent=err instanceof Error?err.message:'ToDoを追加できませんでした。';});});
    root.querySelector<HTMLFormElement>('[data-event-form]')!.addEventListener('submit',e=>{e.preventDefault();const form=e.currentTarget as HTMLFormElement;const title=form.querySelector<HTMLInputElement>('[data-event-title]')!.value;const startsAt=form.querySelector<HTMLInputElement>('[data-event-start]')!.value;const endsAt=form.querySelector<HTMLInputElement>('[data-event-end]')!.value;const timezone=form.querySelector<HTMLSelectElement>('[data-event-timezone]')!.value;void api('POST',{type:'event',title,startsAt,endsAt,timezone}).then(()=>{form.reset();status.textContent='日程を追加しました。';return load();}).catch(err=>{status.textContent=err instanceof Error?err.message:'日程を追加できませんでした。';});});
    todoList.addEventListener('change',e=>{const select=(e.target as HTMLElement).closest<HTMLSelectElement>('[data-todo-status]');if(!select)return;void api('PATCH',{status:select.value},`/api/admin/projects/secretariat/operations/todos/${encodeURIComponent(select.dataset.todoStatus??'')}`).then(load).catch(err=>{status.textContent=err instanceof Error?err.message:'状態を更新できませんでした。';});});
    eventList.addEventListener('click',e=>{const button=(e.target as HTMLElement).closest<HTMLButtonElement>('[data-availability]');if(!button)return;void fetch(`/api/admin/operations/events/${encodeURIComponent(button.dataset.event??'')}/availability`,{method:'PUT',credentials:'same-origin',headers:{'content-type':'application/json'},body:JSON.stringify({availability:button.dataset.availability})}).then(load).catch(err=>{status.textContent=err instanceof Error?err.message:'参加状態を保存できませんでした。';});});
    void load().catch(err=>{status.textContent=err instanceof Error?err.message:'運営事務局の情報を読み込めませんでした。';todoList.textContent='読み込みに失敗しました。';eventList.textContent='読み込みに失敗しました。';});
  };
  document.addEventListener('astro:page-load',initializeSecretariat); initializeSecretariat();
</script>
