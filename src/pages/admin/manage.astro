---
import AdminLayout from "../../layouts/AdminLayout.astro";
import AdminRetryNotice from "../../components/admin/AdminRetryNotice.astro";
const project = Astro.url.searchParams.get("project") === "secretariat" ? "secretariat" : Astro.url.searchParams.get("project") === "seminar-platform" ? "seminar-platform" : "atlas";
const projectSite = project === "seminar-platform" ? "semi-platform" : project;
const projectLabel = project === "secretariat" ? "Atlasez運営事務局" : project === "seminar-platform" ? "ゼミプラットフォーム" : "学習サイト「アトラス」";
---

<AdminLayout title="管理トップ" description="管理機能の入口">
  <main class="management-home" data-management-home data-project={project} data-admin-load-surface data-admin-load-state="loading" aria-busy="true">
    <header><p>{projectLabel}</p><h1>管理トップ</h1></header>
    <section aria-label="管理機能">
      <a href={`/admin/permissions/?project=${project}`} data-manager-only data-admin-site={projectSite} hidden><strong>権限管理</strong><ul class="role-tags"><li>全分野管理者</li></ul><span aria-label="権限管理を開く">→</span></a>
      {project === "atlas" && <a href="/admin/member-management/?project=atlas" data-manager-only data-admin-site="atlas" hidden><strong>運営メンバー管理</strong><ul class="role-tags"><li>全分野管理者</li></ul><span aria-label="運営メンバー管理を開く">→</span></a>}
      {project === "atlas" && <a href="/admin/genre-roles/?project=atlas&view=genres" data-manager-only data-admin-site="atlas" hidden><strong>ジャンル管理</strong><ul class="role-tags"><li>全分野管理者</li></ul><span aria-label="ジャンル管理を開く">→</span></a>}
      {project === "atlas" && <a href="/admin/roles/?project=atlas" data-manager-only data-admin-site="atlas" hidden><strong>役割管理</strong><ul class="role-tags"><li>全分野管理者</li></ul><span aria-label="役割管理を開く">→</span></a>}
      {project !== "atlas" && <a href={`/admin/project-profile-requests/?project=${project}`} data-project-manager-only data-admin-site={projectSite} hidden><strong>運営内自己紹介の承認</strong><ul class="role-tags"><li>運営内運営</li></ul><span aria-label="運営内自己紹介の承認を開く">→</span></a>}
      <a href={`/admin/reports/?project=${project}`}><strong>問題報告</strong><ul class="role-tags"><li data-scope-tag="subject">担当分野のみ</li></ul><span aria-label="問題報告を開く">→</span></a>
      <a href={`/admin/analytics/?project=${project}`}><strong>学習サイト閲覧統計</strong><ul class="role-tags"><li data-scope-tag="subject">担当分野のみ</li></ul><span aria-label="学習サイト閲覧統計を開く">→</span></a>
      {project === "atlas" && <a href="/admin/publication-runs/"><strong>公開処理の状況</strong><ul class="role-tags"><li data-scope-tag="subject">担当分野のみ</li></ul><span aria-label="公開処理の状況を開く">→</span></a>}
      {project === "atlas" && <a href="/admin/operations-statistics/?project=atlas"><strong>運営メンバー統計</strong><ul class="role-tags"><li data-scope-tag="operations">所属プロジェクト・担当分野</li></ul><span aria-label="運営メンバー統計を開く">→</span></a>}
      <a href={`/admin/applications/?project=${project}`} data-project-manager-only data-admin-site={projectSite} hidden><strong>応募管理</strong><ul class="role-tags"><li>運営内運営（当該プロジェクト）</li></ul><span aria-label="応募管理を開く">→</span></a>
    </section>
    <AdminRetryNotice scope="management" message="管理トップの権限情報を読み込めませんでした。" />
    <details class="developer-entry" data-developer-only data-admin-site={project} hidden>
      <summary>開発者モード</summary>
      <p>操作履歴、状態遷移、配信診断など、日常運用では使わない機能を開きます。</p>
      <a href="/admin/developer/?mode=developer">開発者モードを開く →</a>
    </details>
  </main>
</AdminLayout>

<style>
  .management-home{margin:0 auto;max-width:1100px;padding:0 1.25rem 4rem}.management-home header{border-bottom:1px solid var(--border-default);padding:2rem 0 1.25rem}.management-home header p{color:var(--accent-primary);font-size:.74rem;font-weight:900;margin:0}.management-home h1{font-size:2rem;margin:.25rem 0}.management-home header span{color:var(--text-secondary);line-height:1.6}.management-home section{display:grid;gap:.75rem;grid-template-columns:repeat(3,minmax(0,1fr));margin-top:1.25rem}.management-home a{background:var(--background-secondary);border:1px solid var(--border-default);color:var(--text-primary);display:grid;gap:.4rem;min-height:7rem;padding:1rem;text-decoration:none}.management-home a:hover{border-color:var(--accent-primary)}.management-home a[hidden]{display:none!important}.management-home strong{font-size:.95rem}.management-home small{color:var(--text-secondary);line-height:1.55}.management-home a>span{color:var(--accent-primary);font-size:.75rem;font-weight:800;margin-top:auto}.role-tags{display:flex;flex-wrap:wrap;gap:.25rem;list-style:none;margin:0;padding:0}.role-tags li{background:var(--background-primary);border:1px solid var(--border-default);border-radius:999px;color:var(--text-secondary);font-size:.66rem;font-weight:800;padding:.18rem .4rem}.developer-entry{border-top:1px solid var(--border-default);color:var(--text-secondary);margin-top:1.25rem;padding-top:.8rem}.developer-entry summary{cursor:pointer;font-size:.72rem;font-weight:800;list-style:none}.developer-entry summary::-webkit-details-marker{display:none}.developer-entry summary::before{content:"＋";color:var(--text-muted);display:inline-block;margin-right:.35rem}.developer-entry[open] summary::before{content:"−"}.developer-entry p{font-size:.72rem;line-height:1.55;margin:.55rem 0}.developer-entry a{background:transparent;border:0;display:inline;font-size:.72rem;min-height:0;padding:0}.developer-entry a:hover{border:0;text-decoration:underline}@media(max-width:760px){.management-home{padding:0 .85rem 3rem}.management-home section{grid-template-columns:1fr}}
</style>
<script>
  import { createAdminLoadRetry } from "../../scripts/admin-load-retry";
  import { readAdminApiJson } from "../../lib/admin-api";

  const managementHome = document.querySelector<HTMLElement>('[data-management-home]');
  if (managementHome) {
    const projectLabels: Record<string, string> = {
      atlas: '学習サイト「アトラス」',
      'seminar-platform': 'ゼミプラットフォーム',
      secretariat: 'Atlasez運営事務局',
    };
    const requestedProject = new URLSearchParams(window.location.search).get('project')?.trim().toLowerCase() ?? '';
    const project = projectLabels[requestedProject] ? requestedProject : 'atlas';
    const projectSite = project === 'seminar-platform' ? 'semi-platform' : project;
    managementHome.dataset.project = project;
    const label = managementHome.querySelector<HTMLElement>('header p');
    if (label) label.textContent = projectLabels[project];
    managementHome.querySelectorAll<HTMLAnchorElement>('a[href*="?project="]').forEach((link) => {
      const url = new URL(link.href, window.location.origin);
      url.searchParams.set('project', project);
      link.href = `${url.pathname}?${url.searchParams.toString()}`;
      if (link.hasAttribute('data-manager-only') || link.hasAttribute('data-project-manager-only')) link.dataset.adminSite = projectSite;
    });
    const accessTags = managementHome.querySelectorAll<HTMLElement>('[data-scope-tag]');
    let retry!: ReturnType<typeof createAdminLoadRetry>;
    const loadAccessScope = async () => {
      retry.begin();
      managementHome.setAttribute('aria-busy', 'true');
      managementHome.dataset.adminLoadState = 'loading';
      try {
        const response = await fetch('/api/admin/auth-status', { credentials: 'same-origin', cache: 'no-store' });
        const status = await readAdminApiJson<{ hasAdminAccess?: boolean; isManager?: boolean; allSubjects?: boolean; subjects?: string[]; managerProjects?: string[] }>(response, '管理トップの権限情報を取得できませんでした。');
        if (!response.ok) throw new Error('管理トップの権限情報を取得できませんでした。');
        const hasAdminAccess = status.hasAdminAccess ?? true;
        const allSubjects = status.allSubjects ?? status.isManager === true;
        const hasScopeData = Array.isArray(status.subjects);
        const subjects = hasScopeData ? status.subjects!.filter(Boolean) : [];
        const managerProjects = Array.isArray(status.managerProjects) ? status.managerProjects : [];
        const subjectLabel = !hasAdminAccess ? 'アクセス不可' : allSubjects ? '全分野管理者' : subjects.length ? `担当分野（${subjects.length}件）` : hasScopeData ? '担当分野なし' : '担当分野のみ';
        accessTags.forEach((tag) => {
          if (!hasAdminAccess) { tag.textContent = 'アクセス不可'; return; }
          if (allSubjects) { tag.textContent = '全分野管理者'; return; }
          if (tag.dataset.scopeTag === 'operations' && !hasScopeData) { tag.textContent = '所属プロジェクト・担当分野'; return; }
          if (tag.dataset.scopeTag === 'operations' && managerProjects.includes(project)) { tag.textContent = '運営内運営（当該プロジェクト）'; return; }
          tag.textContent = subjectLabel;
        });
        managementHome.setAttribute('aria-busy', 'false');
        managementHome.dataset.adminLoadState = 'ready';
        retry.success();
      } catch (error) {
        managementHome.setAttribute('aria-busy', 'false');
        managementHome.dataset.adminLoadState = 'error';
        retry.fail(error);
        throw error;
      }
    };
    retry = createAdminLoadRetry(
      managementHome,
      loadAccessScope,
      '管理トップの権限情報を読み込めませんでした。',
      { scope: 'management' },
    );
    void loadAccessScope().catch(() => undefined);
  }
</script>
