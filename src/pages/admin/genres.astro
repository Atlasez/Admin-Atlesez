---
import { getCollection } from "astro:content";
import AdminLayout from "../../layouts/AdminLayout.astro";
import { genreLabel } from "../../lib/taxonomy";

const subjects = (await getCollection("subjects")).sort((a, b) => a.data.order - b.data.order);
const statusLabel = { published: "公開中", preparing: "準備中" } as const;
const publishedCount = subjects.filter((subject) => subject.data.status === "published").length;
const categoryCount = subjects.reduce((total, subject) => total + subject.data.categories.length, 0);
---

<AdminLayout title="各ジャンル概要" description="アトラスの分野・カテゴリ構成を確認します">
  <main class="genres" id="main">
    <header class="page-header">
      <div class="title-block">
        <p class="eyebrow">アトラスの構成</p>
        <h1>各ジャンル概要</h1>
        <p class="intro">学習サイトに登録されている分野とカテゴリを確認できます。</p>
      </div>
      <a class="header-action" href="/admin/articles/" aria-label="原稿一覧を開く"><span>原稿一覧を開く</span><span aria-hidden="true">→</span></a>
    </header>

    <section class="overview" aria-label="分野の概要">
      <div class="overview-item"><span>分野</span><strong>{subjects.length}</strong><small>登録済み</small></div>
      <div class="overview-item"><span>公開中</span><strong>{publishedCount}</strong><small>分野</small></div>
      <div class="overview-item"><span>準備中</span><strong>{subjects.length - publishedCount}</strong><small>分野</small></div>
      <div class="overview-item"><span>カテゴリ数</span><strong>{categoryCount}</strong><small>登録済み</small></div>
    </section>

    <nav class="subject-index" aria-label="分野内リンク">
      <div class="section-heading"><strong>分野一覧</strong><span>{subjects.length}分野</span></div>
      <div class="subject-index-list">
        {subjects.map((subject) => <a href={`#${subject.data.slug}`}><i data-status={subject.data.status} aria-hidden="true"></i><span>{subject.data.name.ja}</span><small>{subject.data.categories.length}</small></a>)}
      </div>
    </nav>

    <div class="section-heading cards-heading"><strong>分野とカテゴリ</strong><span>詳細情報</span></div>
    <div class="genre-grid">
      {subjects.map((subject) => (
        <article id={subject.data.slug} class="genre-card">
          <header class="genre-heading">
            <div class="genre-title">
              <div class="genre-meta"><span>{genreLabel(subject.data.genre, "ja")}</span><span class="status" data-status={subject.data.status}><i aria-hidden="true"></i>{statusLabel[subject.data.status]}</span></div>
              <h2>{subject.data.name.ja}</h2>
            </div>
            <a class="anchor-link" href={`#${subject.data.slug}`} aria-label={`${subject.data.name.ja}へのリンク`}>#</a>
          </header>
          <p class="genre-description">{subject.data.description.ja}</p>
          <dl class="genre-stats">
            <div><dt>分野ID</dt><dd><code>{subject.data.slug}</code></dd></div>
            <div><dt>カテゴリ数</dt><dd>{subject.data.categories.length}<span>件</span></dd></div>
          </dl>
          <section class="category-block" aria-labelledby={`${subject.data.slug}-categories`}>
            <div class="category-heading"><h3 id={`${subject.data.slug}-categories`}>カテゴリ</h3><span>{subject.data.categories.length}件</span></div>
            {subject.data.categories.length > 0 ? <ul>{[...subject.data.categories].sort((a, b) => a.order - b.order).map((category) => <li><strong>{category.name.ja}</strong><code>{category.slug}</code></li>)}</ul> : <p class="empty-categories">カテゴリは準備中です。</p>}
          </section>
          <div class="genre-actions"><a class="primary-link" href={`/admin/articles/?subject=${encodeURIComponent(subject.data.slug)}`}><span>この分野の原稿を見る</span><span aria-hidden="true">→</span></a>{subject.data.externalUrl && <a class="secondary-link" href={subject.data.externalUrl} target="_blank" rel="noopener noreferrer"><span>現行ページを確認</span><span aria-hidden="true">↗</span></a>}</div>
        </article>
      ))}
    </div>
  </main>
</AdminLayout>

<style>
  .genres { margin: 0 auto; max-width: 1280px; padding: 0 1.5rem 4rem; }
  .page-header { align-items: end; border-bottom: 1px solid var(--border-default); display: flex; gap: 2rem; justify-content: space-between; padding: 1.7rem 0 1.25rem; }
  .eyebrow { color: var(--accent-primary); font-size: .7rem; font-weight: 800; letter-spacing: .08em; margin: 0; }
  .title-block h1 { font-size: clamp(1.75rem, 3vw, 2.25rem); letter-spacing: -.03em; margin: .3rem 0 .4rem; }
  .intro { color: var(--text-secondary); font-size: .86rem; line-height: 1.65; margin: 0; }
  .header-action, .primary-link, .secondary-link { align-items: center; color: var(--accent-primary); display: inline-flex; font-size: .78rem; font-weight: 800; gap: .8rem; text-decoration: none; white-space: nowrap; }
  .header-action { border: 1px solid var(--border-default); padding: .65rem .8rem; }
  .header-action:hover, .secondary-link:hover { border-color: var(--accent-primary); }
  .header-action span:last-child, .primary-link span:last-child, .secondary-link span:last-child { font-size: 1rem; line-height: 1; }
  .overview { border-bottom: 1px solid var(--border-default); display: grid; grid-template-columns: repeat(4, 1fr); }
  .overview-item { border-right: 1px solid var(--border-default); display: grid; gap: .12rem; padding: .85rem 1rem; }
  .overview-item:first-child { padding-left: 0; }
  .overview-item:last-child { border-right: 0; }
  .overview-item span { color: var(--text-secondary); font-size: .7rem; font-weight: 700; }
  .overview-item strong { font-size: 1.35rem; letter-spacing: -.03em; line-height: 1.1; }
  .overview-item small { color: var(--text-muted); font-size: .65rem; }
  .subject-index { border-bottom: 1px solid var(--border-default); padding: 1rem 0 1.1rem; }
  .section-heading { align-items: center; display: flex; justify-content: space-between; }
  .section-heading strong { font-size: .78rem; }
  .section-heading > span { color: var(--text-secondary); font-size: .7rem; }
  .subject-index-list { display: grid; gap: .35rem .5rem; grid-template-columns: repeat(6, minmax(0, 1fr)); margin-top: .7rem; }
  .subject-index a { align-items: center; border: 1px solid transparent; color: var(--text-primary); display: flex; font-size: .78rem; gap: .45rem; min-width: 0; padding: .38rem .45rem; text-decoration: none; }
  .subject-index a:hover { background: var(--background-secondary); border-color: var(--border-default); }
  .subject-index a span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .subject-index a small { color: var(--text-muted); font-size: .65rem; margin-left: auto; }
  .subject-index a i, .status i { background: var(--text-muted); border-radius: 50%; display: inline-block; flex: 0 0 auto; height: .4rem; width: .4rem; }
  .subject-index a i[data-status="published"], .status[data-status="published"] i { background: var(--success); }
  .cards-heading { margin: 1.15rem 0 .6rem; }
  .genre-grid { display: grid; gap: .7rem; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .genre-card { background: color-mix(in srgb, var(--background-secondary) 66%, var(--background-primary)); border: 1px solid var(--border-default); display: flex; flex-direction: column; gap: .75rem; min-width: 0; padding: 1rem; scroll-margin-top: 1rem; }
  .genre-card:hover { border-color: var(--border-strong); }
  .genre-heading { align-items: start; display: flex; gap: .75rem; justify-content: space-between; }
  .genre-title { min-width: 0; }
  .genre-meta { align-items: center; color: var(--text-secondary); display: flex; flex-wrap: wrap; font-size: .68rem; gap: .55rem; }
  .genre-meta > span:first-child { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .status { align-items: center; border: 1px solid var(--border-default); display: inline-flex; font-size: .65rem; gap: .35rem; padding: .18rem .4rem; }
  .status[data-status="published"] { border-color: color-mix(in srgb, var(--success) 48%, var(--border-default)); color: var(--success); }
  .genre-heading h2 { font-size: 1.15rem; letter-spacing: -.02em; margin: .3rem 0 0; }
  .anchor-link { color: var(--text-muted); font-family: var(--font-mono); font-size: .8rem; line-height: 1; padding: .25rem; text-decoration: none; }
  .anchor-link:hover { color: var(--accent-primary); }
  .genre-description { color: var(--text-secondary); font-size: .8rem; line-height: 1.65; margin: 0; min-height: 2.65em; }
  .genre-stats { display: grid; gap: .5rem; grid-template-columns: minmax(0, 1fr) 7rem; margin: 0; }
  .genre-stats div { background: var(--background-primary); border: 1px solid var(--border-default); display: grid; gap: .15rem; min-width: 0; padding: .45rem .55rem; }
  .genre-stats dt, .category-heading > span { color: var(--text-muted); font-size: .64rem; }
  .genre-stats dd { font-size: .75rem; font-weight: 800; margin: 0; min-width: 0; }
  .genre-stats dd code { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .genre-stats dd span { color: var(--text-secondary); font-size: .65rem; font-weight: 400; margin-left: .2rem; }
  .category-block { display: grid; gap: .45rem; }
  .category-heading { align-items: center; display: flex; justify-content: space-between; }
  .category-heading h3 { font-size: .78rem; margin: 0; }
  .category-block ul { display: grid; gap: .35rem; grid-template-columns: repeat(2, minmax(0, 1fr)); list-style: none; margin: 0; padding: 0; }
  .category-block li { background: var(--background-primary); border: 1px solid var(--border-default); display: grid; gap: .12rem; min-width: 0; padding: .4rem .5rem; }
  .category-block li strong { font-size: .72rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .category-block code { color: var(--text-muted); font-size: .61rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .empty-categories { color: var(--text-muted); font-size: .75rem; margin: 0; }
  .genre-actions { align-items: center; border-top: 1px solid var(--border-default); display: flex; flex-wrap: wrap; gap: .8rem 1rem; margin-top: auto; padding-top: .75rem; }
  .secondary-link { color: var(--text-secondary); font-size: .72rem; font-weight: 700; }
  :where(a, button):focus-visible { outline: 2px solid var(--focus-ring); outline-offset: 2px; }
  @media (max-width: 980px) { .subject-index-list { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  @media (max-width: 760px) {
    .genres { padding: 0 .85rem 3rem; }
    .page-header { align-items: start; display: grid; gap: 1rem; }
    .header-action { justify-content: space-between; width: fit-content; }
    .subject-index-list { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .genre-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 480px) {
    .overview-item { padding: .75rem .55rem; }
    .overview-item:first-child { padding-left: 0; }
    .overview-item strong { font-size: 1.15rem; }
    .overview-item small { font-size: .58rem; }
    .subject-index-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .category-block ul { grid-template-columns: 1fr; }
  }
</style>
