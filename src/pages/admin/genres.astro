---
import { getCollection } from "astro:content";
import AdminLayout from "../../layouts/AdminLayout.astro";

const subjects = (await getCollection("subjects")).sort((a, b) => a.data.order - b.data.order);
const statusLabel = { published: "公開中", preparing: "準備中" } as const;
---

<AdminLayout title="各ジャンル概要" description="アトラスの分野・カテゴリ構成を確認します">
  <main class="genres">
    <header><div><h1>各ジャンル概要</h1></div><a href="/admin/articles/" aria-label="原稿一覧を開く">→</a></header>
    <nav aria-label="分野内リンク">{subjects.map((subject) => <a href={`#${subject.data.slug}`}>{subject.data.name.ja}</a>)}</nav>
    <div class="genre-grid">
      {subjects.map((subject) => (
        <article id={subject.data.slug}>
          <div class="genre-heading"><div><small>{subject.data.genre}</small><h2>{subject.data.name.ja}</h2></div><span data-status={subject.data.status}>{statusLabel[subject.data.status]}</span></div>
          <p>{subject.data.description.ja}</p>
          <dl><div><dt>分野ID</dt><dd>{subject.data.slug}</dd></div><div><dt>カテゴリ数</dt><dd>{subject.data.categories.length}</dd></div></dl>
          <h3>カテゴリ</h3>
          <ul>{subject.data.categories.sort((a, b) => a.order - b.order).map((category) => <li><strong>{category.name.ja}</strong><code>{category.slug}</code></li>)}</ul>
          <div class="genre-actions"><a href={`/admin/articles/?subject=${encodeURIComponent(subject.data.slug)}`}>この分野の原稿を見る</a>{subject.data.externalUrl && <a href={subject.data.externalUrl} target="_blank" rel="noopener noreferrer">現行ページを確認 ↗</a>}</div>
        </article>
      ))}
    </div>
  </main>
</AdminLayout>

<style>
  .genres{margin:0 auto;max-width:1200px;padding:0 1.25rem 4rem}.genres header{align-items:end;border-bottom:1px solid var(--border-default);display:flex;gap:1rem;justify-content:space-between;padding:2rem 0 1.25rem}.genres header p{color:var(--accent-primary);font-size:.74rem;font-weight:800;margin:0}.genres h1{font-size:2rem;margin:.25rem 0}.genres header span{color:var(--text-secondary)}.genres a{color:var(--accent-primary);font-size:.78rem;font-weight:800;text-decoration:none}.genres>nav{display:flex;flex-wrap:wrap;gap:.4rem;padding:1rem 0}.genres>nav a{border:1px solid var(--border-default);border-radius:999px;padding:.35rem .6rem}.genre-grid{display:grid;gap:.8rem;grid-template-columns:repeat(2,minmax(0,1fr))}.genre-grid article{background:var(--background-secondary);border:1px solid var(--border-default);display:grid;gap:.7rem;padding:1rem;scroll-margin-top:6rem}.genre-heading{align-items:start;display:flex;gap:.8rem;justify-content:space-between}.genre-heading small{color:var(--text-secondary);font-size:.68rem}.genre-heading h2{font-size:1.2rem;margin:.15rem 0}.genre-heading>span{border:1px solid var(--border-default);border-radius:999px;font-size:.68rem;font-weight:800;padding:.2rem .45rem}.genre-heading>[data-status=published]{background:#e8f7ed;color:#176b32}.genre-grid p{line-height:1.65;margin:0}.genre-grid dl{display:flex;gap:.5rem;margin:0}.genre-grid dl div{background:var(--background-primary);border:1px solid var(--border-default);display:grid;gap:.1rem;padding:.35rem .5rem}.genre-grid dt{color:var(--text-secondary);font-size:.65rem}.genre-grid dd{font-size:.76rem;font-weight:800;margin:0}.genre-grid h3{font-size:.82rem;margin:0}.genre-grid ul{display:flex;flex-wrap:wrap;gap:.35rem;list-style:none;margin:0;padding:0}.genre-grid li{background:var(--background-primary);border:1px solid var(--border-default);display:grid;gap:.08rem;padding:.3rem .45rem}.genre-grid li strong{font-size:.73rem}.genre-grid code{color:var(--text-secondary);font-size:.64rem}.genre-actions{display:flex;flex-wrap:wrap;gap:.75rem;margin-top:auto}@media(max-width:720px){.genres{padding:0 .85rem 3rem}.genres header{align-items:start;display:grid}.genre-grid{grid-template-columns:1fr}}
</style>
