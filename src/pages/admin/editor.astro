---
import { getCollection } from "astro:content";
import AdminLayout from "../../layouts/AdminLayout.astro";
import {
  getPlannedArticles,
  plannedArticleTitle,
  plannedProgress,
} from "../../lib/planned";

const subjects = (await getCollection("subjects"))
  .sort((a, b) => a.data.order - b.data.order)
  .map((subject) => ({
    slug: subject.data.slug,
    name: subject.data.name.ja,
    status: subject.data.status,
    categories: subject.data.categories
      .slice()
      .sort((a, b) => a.order - b.order)
      .map((category) => ({
        slug: category.slug,
        name: category.name.ja,
        order: category.order,
      })),
  }));
const articles = (await getCollection("articles"))
  .filter((article) => article.data.locale === "ja")
  .map((article) => ({
    articleId: article.data.articleId,
    title: article.data.title,
    subject: article.data.subject,
    category: article.data.category,
    slug: article.data.slug,
    summary: article.data.summary,
    conceptId: article.data.concepts[0]?.id ?? "",
    body: article.body,
    status: article.data.status,
  }));
const concepts = await getCollection("concepts");
const plannedArticles = subjects.flatMap((subject) =>
  getPlannedArticles(subject.slug).map((item) => {
    const concept = concepts.find(
      (entry) =>
        entry.data.subject === item.subject &&
        entry.data.category === item.category &&
        entry.data.name.ja === item.title.ja,
    );
    return {
      key: `${item.subject}/${item.category}/${item.order}`,
      subject: item.subject,
      category: item.category,
      title: plannedArticleTitle(item, "ja"),
      order: item.order,
      progress: plannedProgress(item),
      slug: `planned-${item.category}-${item.order}`,
      conceptId:
        concept?.id ?? `${item.subject}.${item.category}.planned-${item.order}`,
    };
  }),
);
const editorData = JSON.stringify({ subjects, articles, plannedArticles }).replace(
  /</g,
  "\\u003c",
);
---

<AdminLayout title="記事編集ワークスペース" description="アトラス運営者用の記事執筆・査読画面">
  <main class="editor-workspace" data-editor-workspace>
    <header class="workspace-header">
      <div>
        <h1>記事編集ワークスペース</h1>
        <p>原稿を書く、数式を確かめる、コメントで査読する。公開まで、この画面で完結します。</p>
      </div>
      <nav aria-label="運営メニュー">
        <a href="/admin/articles/">原稿一覧へ戻る</a>
      </nav>
    </header>

    <section class="workflow-guide" data-status-workflow aria-label="開いている原稿の進捗">
      <p>現在の状態：<strong data-workflow-current>原稿を選択してください</strong><small data-workflow-help>原稿を書いたら、まず「下書きを保存」します。</small></p>
      <ol aria-label="原稿の公開までの進捗">
        <li data-workflow-step="draft"><b>1</b><span>下書きを保存</span></li>
        <li data-workflow-step="in-review"><b>2</b><span>査読を依頼</span></li>
        <li data-workflow-step="approved"><b>3</b><span>査読完了</span></li>
        <li data-workflow-step="published"><b>4</b><span>公開する</span></li>
      </ol>
    </section>

    <div class="workspace-grid">
      <aside class="document-sidebar" aria-label="原稿一覧" hidden>
        <button type="button" class="sidebar-collapse-toggle" data-sidebar-collapse aria-expanded="true" aria-label="原稿一覧を閉じる" title="原稿一覧を閉じる">‹ 原稿一覧を閉じる</button>
        <div class="document-list" data-document-list aria-live="polite"></div>
        <section class="atlas-outline-panel" aria-labelledby="atlas-outline-heading">
          <div class="atlas-outline-heading">
            <div>
              <p class="eyebrow">学習サイトと同期</p>
              <h2 id="atlas-outline-heading">学習サイトの目次</h2>
            </div>
            <span data-outline-summary aria-live="polite"></span>
          </div>
          <p class="atlas-outline-description">公開済みの記事だけでなく、今後作成予定の「未着手」「執筆中」の項目も含めて分野全体を確認できます。</p>
          <div class="atlas-outline-filters">
            <label>分野<select data-outline-subject></select></label>
            <label>カテゴリ<select data-outline-category></select></label>
          </div>
          <div class="atlas-outline-list" data-atlas-outline aria-live="polite"></div>
        </section>
      </aside>

      <section class="editor-panel" aria-label="原稿編集">
        <div class="empty-state" data-editor-empty>
          <h2>原稿を選んでください</h2>
          <p>新規原稿を作るか、既存の記事を取り込むと、ここで執筆とプレビューを始められます。</p>
          <div class="editor-start-actions">
            <button type="button" class="primary-action" data-new-document>新規原稿を作成</button>
            <div class="source-picker" aria-label="公開済み記事を編集">
              <strong>学習サイトに公開済みの記事を編集</strong>
              <span>分野と記事を選ぶと、公開済み本文を原稿として取り込めます。</span>
              <label>分野<select data-source-subject><option value="">分野を選択…</option></select></label>
              <label>記事<select data-source-article disabled><option value="">先に分野を選択…</option></select></label>
              <button type="button" class="quiet-action" data-import-source>選んだ公開記事を編集する</button>
            </div>
          </div>
        </div>

        <form class="document-form" data-document-form hidden>
          <input type="hidden" name="documentId" />
          <section class="document-toolbar">
            <div>
              <div class="document-statuses" aria-label="原稿と公開の状態"><span>原稿状態：<strong data-document-state>下書き</strong></span><span>公開状態：<strong data-publication-state>未公開</strong></span></div>
              <h2 data-document-heading>新規原稿</h2>
            </div>
            <div class="toolbar-actions">
              <a class="quiet-action toolbar-guide-link" href="/admin/guide/?project=atlas" target="_blank" rel="noreferrer">作業の進め方 ↗</a>
              <label class="engine-control">Webプレビュー組版<select data-preview-engine><option value="katex">KaTeX（高速）</option><option value="mathjax">MathJax（LaTeX互換）</option></select></label>
              <div class="document-actions">
                <button type="button" class="quiet-action" data-request-review hidden>査読を依頼する</button>
                <button type="button" class="primary-action" data-publish-document hidden>公開する</button>
                <button type="button" class="withdraw-action" data-unpublish-document hidden>公開を取り消す</button>
                <button type="submit" class="primary-action" data-save-document>保存する</button>
              </div>
              <output class="save-status" data-save-message aria-live="polite">保存状態：原稿を選択してください</output>
            </div>
          </section>

          <details class="metadata" open>
            <summary>記事設定</summary>
            <div class="metadata-grid">
              <label>タイトル <span class="required-mark" aria-hidden="true">*</span><input name="title" required maxlength="180" placeholder="例：群の定義" /></label>
              <label>要約 <span class="required-mark" aria-hidden="true">*</span><input name="summary" required maxlength="800" placeholder="記事一覧に表示される短い説明" /></label>
              <label>分野 <span class="required-mark" aria-hidden="true">*</span><select name="subject" required data-subject></select></label>
              <label>カテゴリ <span class="required-mark" aria-hidden="true">*</span><select name="category" required data-category></select></label>
              <label>URL用の名前 <span class="required-mark" aria-hidden="true">*</span><input name="slug" required pattern="[a-z0-9-]+" maxlength="100" placeholder="group-definition" /></label>
              <label>概念ID <span class="required-mark" aria-hidden="true">*</span><input name="conceptId" required pattern="[a-z0-9-]+\.[a-z0-9-]+\.[a-z0-9-]+" maxlength="180" placeholder="math.group-theory.group-definition" /></label>
              <label>言語<select name="locale"><option value="ja">日本語</option><option value="en">English</option></select></label>
              <label>LaTeXコンパイル形式<select name="latexEngine"><option value="uplatex">upLaTeX（日本語文書）</option><option value="pdflatex">LaTeX標準</option><option value="xelatex">XeLaTeX</option><option value="lualatex">LuaLaTeX</option></select><small>外部のLaTeX処理で使う形式です。上の「Webプレビュー組版」は、この画面内での数式表示だけを切り替えます。</small></label>
              <label>状態<select name="status"><option value="draft">下書き</option><option value="in-review">査読中</option><option value="on-hold">保留</option><option value="approved">査読済み</option></select></label>
            </div>
          </details>

          <details class="personal-notebook" data-personal-notebook>
            <summary>自分用メモ帳</summary>
            <p>記事の執筆メモとは別の、自分だけが見るメモです。保存した内容は他のメンバーには表示されません。</p>
            <textarea data-personal-note maxlength="20000" placeholder="確認したいこと、次回やること、調査メモなどを自由に書けます。"></textarea>
            <div class="personal-notebook-actions"><button type="button" class="quiet-action" data-save-personal-note>メモを保存</button><output data-personal-note-message aria-live="polite"></output><small data-personal-note-updated>読み込み中…</small></div>
          </details>
          <div class="pane-layout-controls" role="group" aria-label="表示する枠"><span>表示枠</span><button type="button" data-pane-tab="writing" aria-pressed="true">本文</button><button type="button" data-pane-tab="preview" aria-pressed="true">プレビュー</button><button type="button" data-pane-tab="review" aria-pressed="true">コメント</button><button type="button" data-pane-tab="memo" aria-pressed="false">メモ</button><button type="button" data-pane-tab="media" aria-pressed="false">図・画像</button></div>
          <details class="heading-outline"><summary>見出し一覧</summary><nav data-heading-outline>本文の見出しがここに表示されます。</nav></details>
          <div class="editor-split" aria-label="原稿とプレビュー">
            <section class="writing-area">
              <div class="pane-heading"><div><h3>本文（Markdown）</h3><p><code>$...$</code> は行内数式、<code>$$...$$</code> は別行数式です。</p></div><span data-word-count>0文字</span><div class="pane-controls"><button type="button" data-pane-popout="writing">別窓</button></div></div>
              <textarea name="body" data-body spellcheck="true" placeholder={"## 見出し\n\n本文を書きます。\n\n$G$ を群とする。"}></textarea>
            </section>

            <section class="preview-area" aria-labelledby="preview-heading">
              <div class="pane-heading"><div><h3 id="preview-heading">プレビュー</h3><p>本文の入力内容をリアルタイムで確認できます。公開サイトへの反映は「公開」後に行われます。</p></div><span class="live-badge">自動更新</span><div class="pane-controls"><button type="button" data-pane-popout="preview">別窓</button></div></div>
              <article class="article-preview" data-preview></article>
            </section>
          <section class="media-area" aria-labelledby="media-studio-heading">
            <div class="pane-heading"><div><h3 id="media-studio-heading">図・画像</h3><p>アップロードした素材を管理し、本文へ挿入できます。</p></div><span data-media-status aria-live="polite">原稿を保存すると利用できます</span><div class="pane-controls"><button type="button" data-pane-popout="media">別窓</button></div></div>
            <div class="media-studio">
              <div class="media-studio-actions">
                <label class="media-alt-label">画像の説明（alt）<input type="text" data-media-alt maxlength="180" placeholder="例：正多角形の対称軸" /></label>
                <label class="media-latex-label">LaTeX名<input type="text" data-media-latex-name maxlength="120" pattern="[A-Za-z][A-Za-z0-9_-]*" placeholder="例：group-diagram" /><small>本文では <code>\includegraphics&#123;group-diagram&#125;</code> と引用します。</small></label>
                <input type="file" data-media-input accept="image/png,image/jpeg,image/webp,image/gif" hidden />
                <button type="button" class="quiet-action" data-open-media>画像を選択</button>
                <button type="button" class="quiet-action" data-insert-tikz>TikZを挿入</button>
              </div>
              <div class="media-hint">PNG・JPEG・WebP・GIF、1.5MB以下。アップロードした画像はこの原稿に紐づき、Previewにも反映されます。TikZは専用ブロックとして編集できます。</div>
              <div class="media-list" data-media-list aria-live="polite"></div>
            </div>
          </section>
          <section class="review-panel" aria-labelledby="review-heading">
            <div class="pane-heading"><div><h3 id="review-heading">査読コメント</h3><p>選択した文章または記事全体について、コメントと返信を記録できます。</p></div><div class="pane-controls"><button type="button" data-pane-popout="review">別窓</button></div></div>
            <details class="review-help"><summary>コメントの使い方</summary><p>本文またはプレビューで文章を選択してコメントすると、その文章に紐づきます。対応したら「解決」にしてください。</p></details>
            <h4 class="comment-list-heading">コメント</h4>
            <div class="comment-list" data-comment-list></div>
            <div class="selection-action" data-selection-action hidden><span data-selection-action-text></span><button type="button" class="quiet-action" data-use-selection>選択範囲を追加</button></div>
            <div class="selected-ranges" data-selected-ranges hidden></div>
            <label class="comment-entry"><span>新しいコメント</span><output class="selection-hint" data-comment-selection>範囲未選択：記事全体へのコメントとして送信します。</output><textarea data-comment-body maxlength="8000" placeholder="例：@表示名 定義の前に具体例を一つ入れると読みやすくなりそうです。"></textarea></label>
            <datalist id="comment-mention-members" data-comment-mention-members></datalist>
            <button type="button" class="primary-action review-submit" data-send-comment>この内容でコメントを追加</button>
            <details class="revision-panel"><summary>版履歴・差分確認</summary><div data-revision-list>原稿を保存すると履歴が残ります。</div></details>
          </section>
          <section class="memo-area" aria-labelledby="memo-heading">
            <div class="pane-heading"><div><h3 id="memo-heading">原稿用メモ</h3><p>構成案、参照文献、次に直す点を原稿と一緒に保存します。</p></div><div class="pane-controls"><button type="button" data-pane-popout="memo">別窓</button></div></div>
            <textarea name="writingMemo" data-writing-memo maxlength="12000" placeholder="構成案、参照文献、次に直す点などを記録します。"></textarea>
            <footer class="memo-footer"><span>このメモは原稿と一緒に保存されます</span><span data-writing-memo-count>0 / 12,000文字</span></footer>
          </section>
          </div>
        </form>
      </section>
    </div>
    <dialog class="approval-dialog" data-approval-dialog aria-labelledby="approval-dialog-title">
      <form method="dialog">
        <p class="eyebrow">公開の最終確認</p>
        <h2 id="approval-dialog-title">この記事を公開しますか？</h2>
        <p>「はい」を選ぶと、GitHubへ公開し、学習サイトの自動ビルドが始まります。公開してから反映までに数十秒から数分かかります。</p>
        <div class="approval-actions">
          <button type="submit" value="no" class="quiet-action">いいえ（公開しない）</button>
          <button type="submit" value="yes" class="primary-action">はい（公開する）</button>
        </div>
      </form>
    </dialog>
    <dialog class="approval-dialog" data-unpublish-dialog aria-labelledby="unpublish-dialog-title">
      <form method="dialog">
        <p class="eyebrow">公開取り消しの確認</p>
        <h2 id="unpublish-dialog-title">公開を取り消して下書きへ戻しますか？</h2>
        <p>「はい」を選ぶと、学習サイトではこの記事が非公開になります。原稿と版履歴は運営サイトに残ります。</p>
        <div class="approval-actions">
          <button type="submit" value="no" class="quiet-action">いいえ（取り消さない）</button>
          <button type="submit" value="yes" class="withdraw-action">はい（下書きへ戻す）</button>
        </div>
      </form>
    </dialog>
    <dialog class="approval-dialog progress-dialog" data-progress-dialog aria-labelledby="progress-dialog-title">
      <form method="dialog">
        <p class="eyebrow">保存が完了しました</p>
        <h2 id="progress-dialog-title">進捗を記録しますか？</h2>
        <p>記録した進捗は、設定済みの分野Discordチャンネルと全体進捗チャンネルに自動転送されます。</p>
        <label class="progress-detail-label">具体的な進捗内容<textarea data-progress-body maxlength="8000" placeholder="例：定義枠の太字表示を修正し、査読コメント3件を確認しました。"></textarea></label>
        <div class="approval-actions">
          <button type="submit" value="continue" class="quiet-action">編集を続ける</button>
          <button type="submit" value="progress" class="primary-action">進捗を記録する</button>
        </div>
      </form>
    </dialog>
    <dialog class="reference-dialog" data-reference-dialog aria-labelledby="reference-dialog-title">
      <div class="reference-dialog-header"><div><p class="eyebrow">公開記事の参考</p><h2 id="reference-dialog-title" data-reference-title>記事を選択してください</h2><p data-reference-meta></p></div><button type="button" class="quiet-action" data-reference-close>閉じる</button></div>
      <div class="reference-dialog-tabs" role="tablist" aria-label="公開記事の表示方法"><button type="button" role="tab" class="is-selected" data-reference-tab="preview" aria-selected="true" aria-controls="reference-preview-panel">プレビュー</button><button type="button" role="tab" data-reference-tab="source" aria-selected="false" aria-controls="reference-source-panel">Markdown</button></div>
      <article id="reference-preview-panel" class="article-preview reference-preview" data-reference-preview role="tabpanel" aria-label="公開記事のプレビュー"></article>
      <pre id="reference-source-panel" class="reference-source" data-reference-source role="tabpanel" aria-label="公開記事のMarkdown原文" hidden></pre>
    </dialog>
  </main>

  <script is:inline id="editor-source-data" type="application/json" set:html={editorData}></script>
</AdminLayout>

<style>
  .editor-workspace { --surface: var(--background-primary); --surface-alt: var(--background-secondary); --border: var(--border-default); --text: var(--text-primary); --muted: var(--text-secondary); --accent: var(--accent-primary); box-sizing: border-box; margin: 0 auto; max-width: 1500px; padding: 0 clamp(1rem, 3vw, 2.5rem) 4rem; }
  .workspace-header { align-items: start; border-bottom: 1px solid var(--border); display: flex; gap: 2rem; justify-content: space-between; padding-bottom: 1.25rem; }
  .eyebrow { color: var(--accent); font-size: .76rem; font-weight: 800; letter-spacing: .1em; margin: 0 0 .4rem; }
  h1 { font-size: clamp(1.75rem, 3vw, 2.4rem); letter-spacing: -.03em; margin: 0; }
  .workspace-header > div > p:last-child { color: var(--muted); margin: .55rem 0 0; max-width: 48rem; }
  .workspace-header nav { align-items: center; display: flex; flex: 0 0 auto; gap: .55rem; }
  .workspace-header nav a, .workspace-header nav button { background: var(--surface); border: 1px solid var(--border); border-radius: .45rem; color: var(--text); cursor: pointer; font: inherit; font-size: .84rem; padding: .55rem .7rem; text-decoration: none; }
  .workspace-header nav a:hover, .workspace-header nav button:hover { background: var(--surface-alt); }
  .workspace-header nav form { margin: 0; }
  .workflow-guide { color: var(--muted); display: grid; font-size: .8rem; gap: .55rem; padding: 1rem 0; }.workflow-guide p { margin: 0; }.workflow-guide p strong { color: var(--text); }.workflow-guide p small { color: var(--muted); display: block; margin-top: .2rem; }.workflow-guide ol { display: flex; list-style: none; margin: 0; max-width: 48rem; padding: 0; width: 100%; }.workflow-guide li { align-items: center; color: var(--muted); display: flex; flex: 1; font-weight: 700; gap: .38rem; min-width: 0; position: relative; }.workflow-guide li:not(:last-child)::after { background: var(--border); content: ""; height: 2px; margin: 0 .65rem; min-width: .65rem; order: 3; flex: 1; }.workflow-guide b { align-items: center; background: color-mix(in srgb, var(--accent), transparent 88%); border-radius: 999px; color: var(--accent); display: inline-flex; flex: 0 0 auto; font-size: .72rem; height: 1.3rem; justify-content: center; width: 1.3rem; }.workflow-guide li.is-complete { color: var(--accent); }.workflow-guide li.is-complete b, .workflow-guide li.is-current b { background: var(--accent); color: white; }.workflow-guide li.is-complete:not(:last-child)::after { background: var(--accent); }.workflow-guide li.is-current { color: var(--text); }.workflow-guide li.is-current span { text-decoration: underline; text-decoration-color: var(--accent); text-decoration-thickness: 2px; text-underline-offset: .25rem; }.workflow-guide.is-on-hold [data-workflow-step] { opacity: .45; }
  .workspace-grid { border-bottom: 1px solid var(--border); border-top: 2px solid var(--accent); display: grid; grid-template-columns: minmax(0, 1fr); min-height: 46rem; overflow: visible; }.document-sidebar { align-content:start; background:var(--surface-alt); border-right:1px solid var(--border); display:grid!important; gap:.75rem; min-width:0; padding:.9rem; }.document-sidebar[hidden] { display:none!important; }.sidebar-collapse-toggle { align-self:start; background:transparent; border:1px solid var(--border); color:var(--muted); cursor:pointer; font:inherit; font-size:.72rem; font-weight:800; padding:.35rem .45rem; text-align:left; }.sidebar-collapse-toggle:hover { border-color:var(--accent); color:var(--accent); }
  .editor-workspace.sidebar-collapsed .workspace-grid { grid-template-columns: 3.2rem minmax(0, 1fr); }.editor-workspace.sidebar-collapsed .document-sidebar { padding:.45rem; }.editor-workspace.sidebar-collapsed .document-sidebar > :not(.sidebar-collapse-toggle) { display:none; }.editor-workspace.sidebar-collapsed .sidebar-collapse-toggle { align-items:center; display:flex; font-size:1.05rem; height:2.35rem; justify-content:center; overflow:visible; padding:0; white-space:nowrap; width:2.35rem; }
  .sidebar-heading { align-items: start; display: flex; gap: .75rem; justify-content: space-between; }
  .sidebar-heading strong { display: block; font-size: .9rem; max-width: 13rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  button { font: inherit; }
  .primary-action, .quiet-action { border-radius: .45rem; cursor: pointer; font-size: .82rem; font-weight: 800; min-height: 2.35rem; padding: .42rem .68rem; }
