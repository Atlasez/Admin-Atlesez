    flex-wrap: wrap;
    gap: .35rem;
    min-width: 0;
    padding: 0;
  }
  .publication-links a,
  .publication-integration-status {
    align-items: center;
    border: 1px solid var(--border);
    border-radius: .4rem;
    display: inline-flex;
    font-size: .68rem;
    font-weight: 800;
    line-height: 1.25;
    min-height: 1.8rem;
    padding: .3rem .5rem;
    text-decoration: none;
  }
  .publication-links a { background: var(--surface-alt); color: var(--accent, #176ea6); }
  .publication-links a:hover,
  .publication-links a:focus-visible { border-color: var(--accent, #176ea6); text-decoration: underline; }
  .document-statuses .publication-integration-status[data-state="ready"] {
    background: color-mix(in srgb, #e6f4eb 72%, var(--surface));
    border-color: #83b995;
    color: #24643a;
  }
  .document-statuses .publication-integration-status[data-state="checking"] {
    background: color-mix(in srgb, var(--accent-subtle, #e5f2fa) 72%, var(--surface));
    border-color: #72add3;
    color: var(--accent, #176ea6);
  }
  .document-statuses .publication-integration-status[data-state="error"] {
    background: color-mix(in srgb, #fff3cf 72%, var(--surface));
    border-color: #c58d13;
    color: #805500;
  }
  .document-statuses .publication-integration-status::before { content: "●"; font-size: .58rem; margin-right: .35rem; }
  .document-statuses .publication-integration-status[data-state="checking"]::before { content: "◌"; font-size: .9rem; }
  .publication-diagnostic { z-index: 31; }
  @media (max-width: 700px) {
    .document-statuses { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .document-statuses .publication-run-status { grid-template-columns: auto minmax(0, 1fr); }
    .publication-run-updated { grid-column: 2; max-width: none; text-align: left; }
    .publication-run-message { white-space: normal; }
  }
  @media (prefers-reduced-motion: reduce) {
    .publication-run-status[aria-busy="true"] .publication-run-indicator { animation: none; }
  }
</style>

<style>
