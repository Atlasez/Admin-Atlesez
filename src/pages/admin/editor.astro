---
import { getCollection } from "astro:content";
import AdminLayout from "../../layouts/AdminLayout.astro";
import { MATH_PRESETS } from "../../lib/math-authoring.mjs";
import {
  getPlannedArticles,
  plannedArticleTitle,
  plannedProgress,
} from "../../lib/planned";

const LATEX_COMMAND_GROUPS = [
  {
    label: "構造・分数",
    commands: [
      ["\\frac{a}{b}", "分数"],
      ["\\dfrac{a}{b}", "大きな分数"],
      ["\\sqrt{x}", "平方根"],
      ["\\sqrt[n]{x}", "n乗根"],
      ["\\binom{n}{k}", "二項係数"],
      ["\\begin{pmatrix} ... \\end{pmatrix}", "行列"],
    ],
  },
  {
    label: "記号・関係",
    commands: [
      ["\\alpha, \\beta, \\gamma", "ギリシャ文字"],
      ["\\infty, \\partial, \\nabla", "無限大・偏微分・勾配"],
      ["\\in, \\notin, \\subseteq", "集合の関係"],
      ["\\cup, \\cap, \\setminus", "集合の演算"],
      ["\\forall, \\exists", "全称・存在"],
      ["\\Rightarrow, \\Leftrightarrow, \\mapsto", "論理・写像"],
      ["\\leq, \\geq, \\neq, \\approx", "大小・近似"],
    ],
  },
  {
    label: "解析・演算",
    commands: [
      ["\\sum_{i=1}^{n}", "総和"],
      ["\\prod_{i=1}^{n}", "総積"],
      ["\\int_a^b", "定積分"],
      ["\\iint, \\oint", "多重積分・周回積分"],
      ["\\lim_{x\\to a}", "極限"],
      ["\\mathrm{d}x, \\frac{\\partial f}{\\partial x}", "微分"],
      ["\\log, \\ln, \\exp", "対数・指数"],
      ["\\sin, \\cos, \\tan", "三角関数"],
      ["\\det, \\operatorname{rank}", "行列式・階数"],
    ],
  },
  {
    label: "装飾・標準体",
    commands: [
      ["\\mathbb{R}", "黒板太字"],
      ["\\mathcal{F}", "カリグラフィ体"],
      ["\\mathfrak{g}", "フラクトゥール体"],
      ["\\mathbf{v}, \\mathrm{d}x", "太字・ローマン体"],
      ["\\overline{x}, \\hat{x}, \\vec{x}", "上付き装飾"],
      ["\\left\\langle x,y \\right\\rangle", "内積"],
      ["\\left\\lVert x \\right\\rVert", "ノルム"],
      ["\\text{文章}", "数式内の文章"],
    ],
  },
];

const subjects = (await getCollection("subjects"))
  .sort((a, b) => a.data.order - b.data.order)
  .map((subject) => ({
    slug: subject.data.slug,
    name: subject.data.name.ja,
    status: subject.data.status,
    categories: subject.data.categories
      .slice()
      .sort((a, b) => a.order - b.order)
      .map((category) => ({
        slug: category.slug,
        name: category.name.ja,
        order: category.order,
      })),
  }));
const articles = (await getCollection("articles"))
  .filter((article) => article.data.locale === "ja")
  .map((article) => ({
    articleId: article.data.articleId,
    title: article.data.title,
    subject: article.data.subject,
    category: article.data.category,
    slug: article.data.slug,
    summary: article.data.summary,
    conceptId: article.data.concepts[0]?.id ?? "",
    body: article.body,
    status: article.data.status,
  }));
const concepts = await getCollection("concepts");
const conceptOptions = concepts
  .map((concept) => ({
    id: concept.id,
    subject: concept.data.subject,
    category: concept.data.category,
    name: concept.data.name.ja,
    nameEn: concept.data.name.en ?? "",
  }))
  .sort((a, b) => a.subject.localeCompare(b.subject) || a.category.localeCompare(b.category) || a.name.localeCompare(b.name, "ja"));
const plannedArticles = subjects.flatMap((subject) =>
  getPlannedArticles(subject.slug).map((item) => {
    const concept = concepts.find(
      (entry) =>
        entry.data.subject === item.subject &&
        entry.data.category === item.category &&
        entry.data.name.ja === item.title.ja,
    );
    return {
      key: `${item.subject}/${item.category}/${item.order}`,
      subject: item.subject,
      category: item.category,
      title: plannedArticleTitle(item, "ja"),
      order: item.order,
      progress: plannedProgress(item),
      slug: `planned-${item.category}-${item.order}`,
      conceptId: concept?.id ?? "",
    };
  }),
);
const commentTags = [
  "定義不足",
  "根拠確認",
  "表記修正",
  "要相談",
  "例・図の追加",
  "数式確認",
  "構成改善",
  "翻訳・用語",
  "アクセシビリティ",
  "公開前確認",
];
const editorData = JSON.stringify({ subjects, articles, plannedArticles, conceptOptions, commentTags }).replace(
  /</g,
  "\\u003c",
);
---

<AdminLayout title="記事編集ワークスペース" description="アトラス運営者用の記事執筆・フィードバック画面">
  <main class="editor-workspace" data-editor-workspace data-editor-starting>
    <header class="workspace-header">
      <div>
        <h1>記事編集ワークスペース</h1>
      </div>
      <nav aria-label="運営メニュー">
        <a href="/admin/articles/">編集・フィードバックへ戻る</a>
      </nav>
    </header>

    <section class="workflow-guide" data-status-workflow aria-label="開いている原稿の進捗">
      <p>現在の状態：<strong data-workflow-current>原稿を選択してください</strong><small data-workflow-help>原稿を書いたら、まず「下書きを保存」します。</small></p>
      <ol aria-label="原稿の公開までの進捗">
        <li data-workflow-step="draft"><b>1</b><span>執筆・保存</span></li>
        <li data-workflow-step="in-review"><b>2</b><span>フィードバック</span></li>
        <li data-workflow-step="publication-subject"><b>3</b><span>分野統括</span></li>
        <li data-workflow-step="publication-leader"><b>4</b><span>プロジェクトリーダー</span></li>
        <li data-workflow-step="approved"><b>5</b><span>公開準備完了</span></li>
        <li data-workflow-step="published"><b>6</b><span>公開</span></li>
      </ol>
    </section>

    <div class="workspace-grid">
      <aside class="document-sidebar" aria-label="原稿一覧" hidden>
        <button type="button" class="sidebar-collapse-toggle" data-sidebar-collapse aria-expanded="true" aria-label="原稿一覧を閉じる" title="原稿一覧を閉じる">‹ 原稿一覧を閉じる</button>
        <div class="document-list" data-document-list aria-live="polite"></div>
        <section class="atlas-outline-panel" aria-labelledby="atlas-outline-heading">
          <div class="atlas-outline-heading">
            <div>
              <p class="eyebrow">学習サイトと同期</p>
              <h2 id="atlas-outline-heading">学習サイトの目次</h2>
            </div>
            <span data-outline-summary aria-live="polite"></span>
          </div>
          <p class="atlas-outline-description">公開済みの記事だけでなく、今後作成予定の「未着手」「執筆中」の項目も含めて分野全体を確認できます。</p>
          <div class="atlas-outline-filters">
            <label>分野<select data-outline-subject></select></label>
            <label>カテゴリ<select data-outline-category></select></label>
          </div>
          <div class="atlas-outline-list" data-atlas-outline aria-live="polite"></div>
        </section>
      </aside>

      <section class="editor-panel" aria-label="原稿編集">
        <div class="empty-state" data-editor-empty>
          <h2>原稿を選んでください</h2>
          <p>新規原稿を作るか、学習サイトの公開記事を運営管理へ登録すると、ここで執筆とプレビューを始められます。</p>
          <div class="editor-start-actions">
            <button type="button" class="primary-action" data-new-document>新規原稿を作成</button>
            <div class="source-picker" aria-label="公開済み記事を編集">
              <strong>学習サイトに公開済みの記事を運営管理へ登録</strong>
              <span>公開中の記事を編集用原稿として紐付けます。登録だけでは記事は再公開されません。</span>
              <label>分野<select data-source-subject><option value="">分野を選択…</option></select></label>
              <label>記事<select data-source-article disabled><option value="">先に分野を選択…</option></select></label>
              <button type="button" class="quiet-action" data-import-source>公開記事を運営管理へ登録</button>
            </div>
          </div>
        </div>

        <form class="document-form" data-document-form hidden>
          <input type="hidden" name="documentId" />
          <section class="document-toolbar">
            <div>
              <div class="document-statuses" aria-label="原稿と公開の状態">
                <span class="document-status-pill"><span>原稿</span><strong data-document-state>下書き</strong></span>
                <span class="document-status-pill"><span>公開</span><strong data-publication-state>未公開</strong></span>
                <span class="publication-run-status" data-publication-run role="status" aria-live="polite" hidden>
                  <span class="publication-run-indicator" aria-hidden="true"></span>
                  <span class="publication-run-copy">
                    <strong class="publication-run-title">GitHub反映</strong>
                    <span class="publication-run-state" data-publication-run-state></span>
                    <span class="publication-run-message" data-publication-run-label></span>
                  </span>
                  <small class="publication-run-updated" data-publication-run-updated></small>
                </span>
                <span class="publication-links" data-publication-link hidden></span>
                <span class="publication-integration-status" data-publication-integration hidden></span>
                <details class="publication-diagnostic" data-publication-diagnostic hidden><summary>CI失敗の詳細を表示</summary><div class="publication-diagnostic-body"><dl><div><dt>失敗ステップ</dt><dd data-publication-failure-step></dd></div><div><dt>対象ファイル</dt><dd data-publication-failure-file></dd></div><div><dt>原因</dt><dd data-publication-failure-detail></dd></div><div><dt>対処方法</dt><dd data-publication-failure-suggestion></dd></div></dl></div></details>
              </div>
              <h2 data-document-heading>新規原稿</h2>
            </div>
            <div class="toolbar-actions">
              <a class="quiet-action toolbar-guide-link" href="/admin/guide/?project=atlas" target="_blank" rel="noreferrer">手順 ↗</a>
              <label class="engine-control"><input type="checkbox" data-autosave-toggle />下書きを自動保存</label>
              <label class="engine-control">Webプレビュー組版<select data-preview-engine><option value="katex">KaTeX（高速）</option><option value="mathjax">MathJax（LaTeX互換）</option></select></label>
              <div class="collaboration-status" data-collaboration-status data-state="connecting" hidden>
                <span class="collaboration-indicator" aria-hidden="true"></span>
                <span data-collaboration-state>同時編集に接続中…</span>
                <small data-collaboration-latency hidden></small>
                <div data-collaboration-participants aria-label="同時編集中のメンバー"></div>
              </div>
              <div class="document-actions">
                <button type="button" class="primary-action" data-create-update-proposal hidden>更新案を作成</button>
                <button type="button" class="quiet-action" data-request-review hidden>フィードバックを依頼する</button>
                <button type="button" class="quiet-action" data-complete-writing hidden>フィードバック完了・公開審査へ</button>
                <button type="button" class="quiet-action" data-publication-review hidden>公開審査を処理</button>
                <button type="button" class="primary-action" data-publish-document hidden>公開する</button>
                <button type="button" class="quiet-action" data-schedule-document hidden>公開予約</button>
                <button type="button" class="withdraw-action" data-unpublish-document hidden>公開を取り消す</button>
                <button type="submit" class="primary-action" data-save-document>保存する</button>
              </div>
              <output class="save-status" data-save-message aria-live="polite">保存状態：原稿を選択してください</output>
              <p class="update-proposal-note" data-update-proposal-note hidden aria-live="polite"></p>
            </div>
          </section>

          <details class="metadata" data-metadata>
            <summary><span class="metadata-summary-title">記事設定</span><span class="metadata-summary-value" data-metadata-summary>必須項目を確認</span><span class="metadata-summary-action">編集</span></summary>
            <div class="metadata-grid">
              <label class="metadata-field metadata-title"><span class="field-heading">タイトル<span class="required-mark" aria-hidden="true">*</span></span><input name="title" required maxlength="180" placeholder="例：群の定義" /></label>
              <label class="metadata-field metadata-abstract"><span class="field-heading">要約<span class="required-mark" aria-hidden="true">*</span></span><input name="summary" required maxlength="800" placeholder="記事一覧に表示される短い説明" /></label>
              <label class="metadata-field metadata-subject"><span class="field-heading">分野<span class="required-mark" aria-hidden="true">*</span></span><select name="subject" required data-subject></select></label>
              <label class="metadata-field metadata-category"><span class="field-heading">カテゴリ<span class="required-mark" aria-hidden="true">*</span></span><select name="category" required data-category></select></label>
              <label class="metadata-field metadata-slug"><span class="field-heading">URL用の名前<span class="required-mark" aria-hidden="true">*</span></span><input name="slug" required pattern="[a-z0-9-]+" maxlength="100" placeholder="group-definition" /></label>
      <label class="metadata-field metadata-concept concept-picker-field"><span class="field-heading">記事で扱う概念<span class="required-mark" aria-hidden="true">*</span></span><select data-concept-picker aria-label="記事で扱う概念"><option value="">概念を選択してください</option></select><small>既存の概念を選択。新規概念は「新しい概念を作成」から記事と一緒に登録できます。</small><output class="concept-id-preview" data-concept-id-preview aria-live="polite">概念を選択してください</output></label>
      <details class="concept-id-advanced"><summary>概念IDの確認・手入力（上級者向け）</summary><label><span class="field-heading">概念ID<span class="required-mark" aria-hidden="true">*</span></span><input name="conceptId" required pattern="[a-z0-9-]+\.[a-z0-9-]+\.[a-z0-9-]+" maxlength="180" placeholder="例：math.group-theory.group-definition" /></label><label class="concept-registration-toggle"><input type="checkbox" data-register-concept /> 新しい概念として公開PRに追加する</label><div class="concept-registration-fields" data-concept-registration-fields hidden><label><span class="field-heading">概念名（日本語）<span class="required-mark" aria-hidden="true">*</span></span><input name="conceptName" maxlength="180" placeholder="例：群の中心" /></label><label><span class="field-heading">概念名（英語・任意）</span><input name="conceptNameEn" maxlength="180" placeholder="例：The Center of a Group" /></label><small>チェックすると、この概念IDと概念名を記事の公開PRで concepts.yaml に追加します。学習地図に登録されるのはPRのCI成功後です。</small></div><small>概念一覧にない新しい概念や、既存記事の旧IDを扱う場合だけ使用します。</small></details>
              <label class="metadata-field metadata-locale">言語<select name="locale"><option value="ja">日本語</option><option value="en">English</option></select></label>
              <label class="metadata-field metadata-latex">LaTeX形式<select name="latexEngine"><option value="uplatex">upLaTeX（日本語文書）</option><option value="pdflatex">LaTeX標準</option><option value="xelatex">XeLaTeX</option><option value="lualatex">LuaLaTeX</option></select><small>外部LaTeX処理で使用。画面内プレビューはKaTeXです。</small></label>
      <label class="metadata-field metadata-status">状態<select name="status"><option value="draft">下書き</option><option value="in-review">フィードバック中</option><option value="on-hold">保留</option><option value="approved" disabled>フィードバック済み（公開審査後のみ）</option></select><small data-status-help>公開審査で承認されたときに自動で変更されます。</small></label>
            </div>
          </details>

          <details class="personal-notebook" data-personal-notebook>
            <summary>自分用メモ帳</summary>
            <p>自分だけが見るメモです。保存した内容は他のメンバーには表示されません。</p>
            <textarea data-personal-note maxlength="20000" placeholder="確認したいこと、次回やること、調査メモなどを自由に書けます。"></textarea>
            <div class="personal-notebook-actions"><button type="button" class="quiet-action" data-save-personal-note>メモを保存</button><output data-personal-note-message aria-live="polite"></output><small data-personal-note-updated>読み込み中…</small></div>
          </details>
          <div class="pane-layout-controls" role="group" aria-label="表示する枠"><span>表示枠</span>{([['writing', '本文'], ['preview', 'プレビュー'], ['review', 'コメント'], ['media', '図・画像'], ['memo', '執筆メモ']] as const).map(([key, label]) => <span class="pane-layout-control" data-pane-control={key}><button type="button" data-pane-tab={key} aria-pressed={key === 'writing' || key === 'preview' || key === 'review' ? 'true' : 'false'}>{label}</button><button type="button" class="pane-popout-toggle" data-pane-popout={key} aria-pressed="false" aria-label={`${label}を別窓で表示`} title={`${label}を別窓で表示`}>↗</button></span>)}</div>
          <details class="heading-outline"><summary>見出し一覧</summary><nav data-heading-outline>本文の見出しがここに表示されます。</nav></details>
          <div class="editor-split" aria-label="原稿とプレビュー">
            <section class="writing-area">
              <div class="pane-heading writing-pane-heading"><div class="pane-title"><h3>本文（Markdown）</h3><p class="math-authoring-help">詳細は「使える機能」へ</p></div><span data-word-count>0文字</span><div class="pane-controls"><button type="button" class="diagnostics-trigger" data-open-diagnostics aria-haspopup="dialog" hidden><span>確認事項</span><b data-diagnostics-trigger-count>0</b></button><button type="button" data-open-authoring-help aria-haspopup="dialog">使える機能</button><button type="button" data-pane-popout="writing">別窓</button></div></div>
              <details class="writing-tools" open><summary>挿入・数式設定</summary><div class="pane-controls writing-tools-controls" aria-label="本文への挿入"><label class="math-preset-control"><span>共通数式</span><button type="button" class="math-preset-picker" data-open-math-preset-library aria-haspopup="dialog"><span data-math-preset-selection>なし</span><span aria-hidden="true">⌄</span></button><select data-math-preset aria-label="共通数式プリセット" hidden><option value="">なし</option>{Object.entries(MATH_PRESETS).map(([value, preset]) => <option value={value}>{preset.label}</option>)}</select></label><button type="button" class="quiet-action" data-add-math-preset>プリセット管理</button><button type="button" class="quiet-action" data-open-reference-library>参考文献</button><button type="button" class="quiet-action" data-insert-math="inline">インライン数式</button><button type="button" class="quiet-action" data-insert-math="display">表示数式</button><button type="button" class="quiet-action" data-insert-math="proposition">命題</button></div></details>
              <dialog class="math-preset-dialog" data-math-preset-dialog aria-labelledby="math-preset-dialog-title"><div class="math-preset-dialog-inner"><div class="math-preset-dialog-header"><div><p class="eyebrow">LATEX PRESETS</p><h2 id="math-preset-dialog-title">LaTeXプリセット</h2><p>選択したプリセットは記事の数式設定に適用されます。自分用プリセットはここで追加・編集・削除できます。</p></div><button type="button" class="help-close" data-close-math-preset aria-label="プリセットを閉じる">×</button></div><div class="math-preset-library" data-math-preset-library><div class="math-preset-library-heading"><h3>利用できるプリセット</h3><button type="button" class="primary-action" data-start-math-preset>＋ 新規追加</button></div><div class="math-preset-library-list" data-math-preset-library-list></div></div><section class="math-preset-editor" data-math-preset-editor hidden><div class="math-preset-editor-heading"><h3 data-math-preset-editor-title>プリセットを追加</h3><button type="button" class="quiet-action" data-cancel-math-preset-edit>一覧に戻る</button></div><label class="math-preset-group-field">グループ名（任意）<input data-custom-preset-group maxlength="80" placeholder="例：代数・写像" /></label><div data-math-preset-form><label>プリセット名<input data-custom-preset-label maxlength="80" required disabled placeholder="例：自分の解析記号" /></label><label>マクロ<textarea data-custom-preset-macros required disabled placeholder="\\foo = \\mathbb{R}\n\\dd = \\,\\mathrm{d}#1"></textarea></label><output data-custom-preset-message aria-live="polite"></output><div class="math-preset-dialog-actions"><button type="button" class="primary-action" data-custom-preset-save>保存</button></div></div></section></div></dialog>
              <dialog class="reference-library-dialog" data-reference-library-dialog aria-labelledby="reference-library-title"><div class="reference-library-inner"><div class="reference-library-header"><div><p class="eyebrow">PERSONAL REFERENCES</p><h2 id="reference-library-title">自分用参考文献リスト</h2><p><code>[[cite:識別子]]</code> を本文へ挿入すると、記事内では番号リンクとして表示されます。記事で使った文献は原稿にもコピー保存されます。</p></div><button type="button" class="help-close" data-close-reference-library aria-label="参考文献を閉じる">×</button></div><div class="reference-entry-form" data-reference-entry-form><input type="hidden" data-reference-edit-id /><label>識別子<input data-reference-id maxlength="80" pattern="[A-Za-z0-9][A-Za-z0-9_-]{1,79}" required disabled placeholder="例：atiyah-macdonald" /></label><label>書名・論文名<input data-reference-title maxlength="240" required disabled placeholder="例：Introduction to Commutative Algebra" /></label><label>著者・編者<input data-reference-authors maxlength="240" placeholder="例：M. F. Atiyah and I. G. Macdonald" /></label><label>出版年<input data-reference-year maxlength="32" placeholder="例：1969" /></label><label>出版社・掲載誌<input data-reference-publisher maxlength="240" placeholder="例：Addison-Wesley" /></label><label>URL<input data-reference-url type="url" maxlength="2000" placeholder="https://..." /></label><label>メモ<input data-reference-note maxlength="500" placeholder="必要なら版・ページなど" /></label><div class="reference-entry-actions"><button type="button" class="primary-action" data-save-reference>リストに保存</button><button type="button" class="quiet-action" data-cancel-reference-edit hidden>編集をキャンセル</button><output data-reference-entry-message aria-live="polite"></output></div></div><section class="reference-library-section" aria-labelledby="reference-list-heading"><div class="reference-library-section-heading"><h3 id="reference-list-heading">登録済みの文献</h3><span data-reference-count></span></div><div data-reference-library-list></div></section></div></dialog>
              <div class="editor-lock-bar" data-editor-lock-bar><span data-lock-status>確定部分はありません</span><button type="button" class="quiet-action" data-lock-selection disabled>選択範囲をロック</button><button type="button" class="quiet-action" data-unlock-selection disabled>選択範囲のロック解除</button></div>
              <dialog class="editor-diagnostics-dialog" data-editor-diagnostics aria-labelledby="editor-diagnostics-title"><div class="editor-diagnostics-inner"><div class="editor-diagnostics-header"><div><p class="eyebrow">EDITOR CHECKS</p><h2 id="editor-diagnostics-title">確認事項</h2><p>保存前に確認してください。本文・プレビューとは別に表示しています。</p></div><button type="button" class="help-close" data-close-editor-diagnostics aria-label="確認事項を閉じる">×</button></div><div class="editor-diagnostics-summary"><strong data-diagnostics-summary></strong><span>記事の表示や参照に関する確認です。</span></div><ul data-diagnostics-list></ul></div></dialog>
              <dialog class="authoring-help-dialog" data-authoring-help-dialog aria-labelledby="authoring-help-title"><div class="authoring-help-inner"><div class="authoring-help-head"><div><p class="eyebrow">EDITOR HELP</p><h2 id="authoring-help-title">本文で使える機能</h2><p>カテゴリを選ぶと、右側の表示が切り替わります。</p></div><button type="button" class="help-close" data-close-authoring-help aria-label="ヘルプを閉じる">×</button></div><div class="authoring-help-layout"><nav class="authoring-help-nav" aria-label="ヘルプカテゴリ" role="tablist"><button type="button" class="help-topic-button" data-help-topic="markdown" role="tab" aria-selected="false" aria-controls="help-topic-markdown">Markdown</button><button type="button" class="help-topic-button is-active" data-help-topic="latex" role="tab" aria-selected="true" aria-controls="help-topic-latex">LaTeX・数式</button><button type="button" class="help-topic-button" data-help-topic="preset" role="tab" aria-selected="false" aria-controls="help-topic-preset">プリセット・マクロ</button><button type="button" class="help-topic-button" data-help-topic="proposition" role="tab" aria-selected="false" aria-controls="help-topic-proposition">命題・証明</button><button type="button" class="help-topic-button" data-help-topic="reference" role="tab" aria-selected="false" aria-controls="help-topic-reference">参照・番号</button><button type="button" class="help-topic-button" data-help-topic="media" role="tab" aria-selected="false" aria-controls="help-topic-media">画像・TikZ</button><button type="button" class="help-topic-button" data-help-topic="review" role="tab" aria-selected="false" aria-controls="help-topic-review">レビュー</button><button type="button" class="help-topic-button" data-help-topic="screen" role="tab" aria-selected="false" aria-controls="help-topic-screen">画面操作</button><button type="button" class="help-topic-button" data-help-topic="workflow" role="tab" aria-selected="false" aria-controls="help-topic-workflow">保存・公開</button></nav><div class="authoring-help-topics"><section class="help-topic-panel" id="help-topic-markdown" data-help-panel="markdown" role="tabpanel" hidden><h3>Markdownの基本</h3><p><code># 見出し</code>、空行で段落、<code>**太字**</code>、<code>*斜体*</code>、<code>&#96;コード&#96;</code>、<code>- 箇条書き</code>、<code>1. 番号付き</code> が使えます。</p><p>リンクは <code>[表示名](https://...)</code> と書けます。見出しは「見出し一覧」から移動できます。</p></section><section class="help-topic-panel" id="help-topic-latex" data-help-panel="latex" role="tabpanel"><h3>LaTeX数式・入力補完</h3><p><code>$...$</code> は本文中、<code>$$...$$</code> は表示数式です。<code>\</code> を入力するか、本文内で <kbd>Ctrl</kbd> + <kbd>Space</kbd> を押すと候補が出ます。</p><div class="help-command-groups">{LATEX_COMMAND_GROUPS.map((group) => <div class="help-command-group"><h4>{group.label}</h4><ul>{group.commands.map(([command, description]) => <li><code>{command}</code><span>{description}</span></li>)}</ul></div>)}</div><p class="help-tip">候補は入力中に絞り込まれます。候補を選択して <kbd>Enter</kbd>、移動して <kbd>↑</kbd> <kbd>↓</kbd> で確定できます。</p></section><section class="help-topic-panel" id="help-topic-preset" data-help-panel="preset" role="tabpanel" hidden><h3>LaTeXマクロ・共通プリセット</h3><p>「共通数式」から記事ごとにプリセットを選ぶと、よく使う記号を共通設定として使えます。</p><ul class="preset-help-list">{Object.entries(MATH_PRESETS).map(([value, preset]) => <li><code>{value}</code><span>{preset.label}</span><span class="preset-command-list">{Object.keys(preset.macros).join(" ")}</span></li>)}</ul><p>記事固有の定義は数式ブロック内で <code>\newcommand&#123;\foo&#125;[1]&#123;...&#125;</code>、<code>\DeclareMathOperator&#123;\rank&#125;&#123;rank&#125;</code> が使えます。定義は記事内の数式で再利用できます。</p></section><section class="help-topic-panel" id="help-topic-proposition" data-help-panel="proposition" role="tabpanel" hidden><h3>命題・定義・証明</h3><p><code>:::prop タイトル &#123;#識別子&#125;</code> のように書きます。<code>defi</code>（定義）、<code>prop</code>（命題）、<code>thm</code>（定理）、<code>lemma</code>（補題）、<code>cor</code>（系）、<code>example</code>（例）、<code>proof</code>（証明）などに対応しています。</p><button type="button" class="help-insert-button" data-help-insert="proposition">命題のひな形を挿入</button></section><section class="help-topic-panel" id="help-topic-reference" data-help-panel="reference" role="tabpanel" hidden><h3>参照・自動番号・参考文献</h3><p>命題などの参照は <code>[[ref:識別子]]</code>、参考文献の引用は <code>[[cite:識別子]]</code> です。番号は記事で使われた参考文献の登録順に付き、本文の <code>[1]</code> から記事末尾の参考文献へ移動できます。</p><p>「参考文献」ボタンから自分用リストを登録し、「本文へ引用」を押すと識別子の挿入と記事へのコピー保存を同時に行います。URL、著者、出版年、出版社・掲載誌、ページなどのメモも登録できます。</p></section><section class="help-topic-panel" id="help-topic-media" data-help-panel="media" role="tabpanel" hidden><h3>画像・図・TikZ</h3><p>「図・画像」から画像をアップロードして本文へ挿入できます。画像ごとに幅を選び、「既存参照に適用」で挿入済み画像も変更できます。</p><p>TikZは専用ボタンから <code>&#96;&#96;&#96;tikz</code> ブロックとして挿入できます。</p></section><section class="help-topic-panel" id="help-topic-review" data-help-panel="review" role="tabpanel" hidden><h3>コメントとレビュー</h3><p>本文またはプレビューの文章を選択するとコメントを付けられます。タグ、返信、引用添付、<code>@表示名</code> のメンションが使えます。</p><p>コメントを確認したら「確認済み」、修正が必要なら「未反映」を使います。</p></section><section class="help-topic-panel" id="help-topic-screen" data-help-panel="screen" role="tabpanel" hidden><h3>画面操作・共同編集</h3><p>「本文」「プレビュー」「コメント」「図・画像」は表示枠ボタンで切り替えられます。「別窓」で各枠を別ウィンドウにできます。</p><p>共同編集、自分用メモ、改訂比較、見出し一覧も利用できます。</p></section><section class="help-topic-panel" id="help-topic-workflow" data-help-panel="workflow" role="tabpanel" hidden><h3>保存・レビュー依頼・公開</h3><p>「保存する」で下書きを保存し、「フィードバックを依頼する」→確認・修正→承認→「公開する」の順に進めます。「下書きを自動保存」を有効にすると入力中の変更も保存されます。</p></section></div></div><p class="authoring-help-foot"><code>/help</code> は本文の末尾だけでなく、本文内のどこに入力してもこのヘルプを開きます。入力された <code>/help</code> は本文から自動的に取り除かれます。</p></div></dialog>
              <div class="body-editor-surface" data-body-surface>
                <pre class="locked-range-markup" data-locked-range-markup aria-hidden="true"></pre>
                <textarea name="body" data-body disabled spellcheck="true" placeholder={"## 見出し\n\n本文を書きます。\n\n$G$ を群とする。"}></textarea>
              </div>
              <button type="button" class="pane-resize-handle" data-pane-resize="writing" aria-label="本文枠の高さを調整" aria-valuemin="240" aria-valuemax="1400" aria-valuenow="528" title="ドラッグして本文枠の高さを調整。ダブルクリックで元の高さに戻します"><span aria-hidden="true"></span></button>
            </section>

            <section class="preview-area" aria-labelledby="preview-heading">
              <div class="pane-heading"><h3 id="preview-heading">プレビュー</h3><span class="live-badge">自動更新</span><div class="pane-controls"><button type="button" data-preview-expand aria-pressed="false">全文表示</button><button type="button" data-pane-popout="preview">別窓</button></div></div>
              <article class="article-preview" data-preview></article>
              <button type="button" class="pane-resize-handle" data-pane-resize="preview" aria-label="プレビュー枠の高さを調整" aria-valuemin="240" aria-valuemax="1400" aria-valuenow="528" title="ドラッグしてプレビュー枠の高さを調整。ダブルクリックで元の高さに戻します"><span aria-hidden="true"></span></button>
            </section>
            <section class="memo-area" aria-labelledby="memo-heading">
              <div class="pane-heading"><h3 id="memo-heading">執筆メモ</h3><span>記事ごとに保存・非公開</span><div class="pane-controls"><button type="button" data-pane-popout="memo">別窓</button></div></div>
              <div class="memo-content"><p>構成の意図、説明を採用した理由、将来公開したい補足などを記録できます。このメモは現在の記事編集メンバー向けで、公開記事には表示されません。</p><textarea data-writing-memo maxlength="30000" placeholder="なぜこの構成にしたのか、どの説明を採用したのか、今後追加したい内容などを書き留めます。"></textarea></div>
              <button type="button" class="pane-resize-handle" data-pane-resize="memo" aria-label="執筆メモ枠の高さを調整" aria-valuemin="240" aria-valuemax="1400" aria-valuenow="528" title="ドラッグして執筆メモ枠の高さを調整。ダブルクリックで元の高さに戻します"><span aria-hidden="true"></span></button>
            </section>
          <section class="media-area" aria-labelledby="media-studio-heading">
            <div class="pane-heading"><h3 id="media-studio-heading">図・画像</h3><span data-media-status aria-live="polite">画像を選択すると原稿を自動保存</span><div class="pane-controls"><button type="button" data-pane-popout="media">別窓</button></div></div>
            <div class="media-studio">
              <div class="media-studio-actions">
                <label class="media-alt-label">画像の説明（alt）<input type="text" data-media-alt maxlength="180" placeholder="例：正多角形の対称軸" /></label>
                <label class="media-latex-label">LaTeX名<input type="text" data-media-latex-name maxlength="120" pattern="[A-Za-z][A-Za-z0-9_-]*" placeholder="例：group-diagram" /><small>本文では <code>\includegraphics&#123;group-diagram&#125;</code> と引用します。</small></label>
                <input type="file" data-media-input accept="image/png,image/jpeg,image/webp,image/gif,image/svg+xml" hidden />
                <button type="button" class="quiet-action" data-open-media>画像を選択</button>
                <button type="button" class="quiet-action" data-insert-tikz>TikZを挿入</button>
              </div>
              <div class="media-hint">PNG・JPEG・WebP・GIF・SVG、1.5MB以下。新規原稿でも画像を選択すると、先に下書きを自動保存してからアップロードします。アップロードした画像はこの原稿に紐づき、Previewにも反映されます。TikZは組版サービス未設定時、無料のブラウザ内TikZJaxでプレビューします。素材一覧の「画像幅」でプリセットまたは1〜100%の任意の幅を指定でき、既存参照にも適用できます。</div>
              <div class="media-list" data-media-list aria-live="polite"></div>
            </div>
            <button type="button" class="pane-resize-handle" data-pane-resize="media" aria-label="図・画像枠の高さを調整" aria-valuemin="240" aria-valuemax="1400" aria-valuenow="528" title="ドラッグして図・画像枠の高さを調整。ダブルクリックで元の高さに戻します"><span aria-hidden="true"></span></button>
          </section>
          <section class="review-panel" aria-labelledby="review-heading">
            <div class="pane-heading"><h3 id="review-heading">フィードバック</h3><div class="pane-controls"><button type="button" data-pane-popout="review">別窓</button></div></div>
            <details class="review-help"><summary>コメントの使い方</summary><p>本文またはプレビューで文章を選択してコメントすると、その文章に紐づきます。コメント投稿者が修正を反映したら「反映済み」にしてください。他の人のコメントは、投稿者と対応者の双方が「反映済み」にすると解決済みになります。</p></details>
            <div class="comment-list-toolbar"><h4 class="comment-list-heading">コメント</h4><div class="comment-list-filters"><label>コメントを検索<input type="search" data-comment-search placeholder="本文・投稿者・タグを検索" autocomplete="off" /></label><label>タグで絞り込む<select data-comment-tag-filter><option value="">すべて</option>{commentTags.map((tag) => <option value={tag}>{tag}</option>)}</select></label><label>確認状態<select data-comment-status-filter><option value="">すべて</option><option value="pending">未確認</option><option value="acknowledged">確認済み</option><option value="resolved">反映済み</option></select></label></div></div>
            <div class="comment-list" data-comment-list></div>
            <div class="selection-action" data-selection-action hidden><span data-selection-action-text></span><button type="button" class="quiet-action" data-use-selection>選択範囲を追加</button></div>
            <div class="selected-ranges" data-selected-ranges hidden></div>
            <div class="comment-tags" aria-label="コメントタグ"><span>タグ（複数選択可）</span>{commentTags.map((tag) => <button type="button" data-comment-tag={tag} aria-pressed="false">{tag}</button>)}</div>
            <label class="comment-entry"><span>新しいコメント</span><output class="selection-hint" data-comment-selection>範囲未選択：記事全体へのコメントとして送信します。</output><textarea data-comment-body maxlength="8000" placeholder="例：@表示名 定義の前に具体例を一つ入れると読みやすくなりそうです。"></textarea></label>
            <datalist id="comment-mention-members" data-comment-mention-members></datalist>
            <button type="button" class="primary-action review-submit" data-send-comment>この内容でコメントを追加</button>
            <button type="button" class="pane-resize-handle" data-pane-resize="review" aria-label="フィードバック枠の高さを調整" aria-valuemin="240" aria-valuemax="1400" aria-valuenow="528" title="ドラッグしてフィードバック枠の高さを調整。ダブルクリックで元の高さに戻します"><span aria-hidden="true"></span></button>
          </section>
          </div>
          <section class="revision-workspace" aria-labelledby="revision-heading">
            <h3 id="revision-heading">版履歴・差分確認</h3>
            <p>保存した版を独立して確認できます。</p>
            <div data-revision-list>原稿を保存すると履歴が残ります。</div>
            <section class="feedback-request-history" aria-labelledby="feedback-request-history-heading">
              <h4 id="feedback-request-history-heading">フィードバック依頼の履歴</h4>
              <p>記事に紐づく依頼を確認できます。担当タスクは、この画面から進行中・完了へ更新できます。</p>
              <div data-feedback-request-history>原稿を選ぶと、依頼履歴を確認できます。</div>
            </section>
          </section>
        </form>
      </section>
    </div>
    <dialog class="approval-dialog" data-approval-dialog aria-labelledby="approval-dialog-title">
      <form method="dialog">
        <p class="eyebrow">公開の最終確認</p>
        <h2 id="approval-dialog-title">この記事を公開しますか？</h2>
        <p>「はい」を選ぶと、GitHubに公開用PRを作成します。PRを確認してMergeすると、学習サイトの自動ビルドが始まります。公開状態は通常5分以内に運営サイトへ反映されます。</p>
        <div class="approval-actions">
          <button type="submit" value="no" class="quiet-action">いいえ（公開しない）</button>
          <button type="submit" value="yes" class="primary-action">はい（公開する）</button>
        </div>
      </form>
    </dialog>
    <dialog class="approval-dialog" data-publication-review-dialog aria-labelledby="publication-review-dialog-title">
      <form method="dialog" data-publication-review-form>
        <p class="eyebrow">公開審査</p>
        <h2 id="publication-review-dialog-title">公開審査を処理しますか？</h2>
        <p data-publication-review-description>承認すると次の審査担当へ通知されます。差し戻すとフィードバック中へ戻ります。</p>
        <label>審査メモ（任意）<textarea data-publication-review-note maxlength="2000" rows="4" placeholder="確認内容や差し戻し理由"></textarea></label>
        <output data-publication-review-message aria-live="polite"></output>
        <div class="approval-actions">
          <button type="button" value="no" class="quiet-action" data-publication-review-cancel>キャンセル</button>
          <button type="submit" value="reject" class="withdraw-action">差し戻す</button>
          <button type="submit" value="approve" class="primary-action">承認する</button>
        </div>
      </form>
    </dialog>
    <dialog class="approval-dialog" data-unpublish-dialog aria-labelledby="unpublish-dialog-title">
      <form method="dialog">
        <p class="eyebrow">公開取り消しの確認</p>
        <h2 id="unpublish-dialog-title">公開を取り消して下書きへ戻しますか？</h2>
        <p>「はい」を選ぶと、GitHubに公開取り消し用PRを作成します。PRをMergeすると、学習サイトではこの記事が非公開になります。原稿と版履歴は運営サイトに残ります。</p>
        <div class="approval-actions">
          <button type="submit" value="no" class="quiet-action">いいえ（取り消さない）</button>
          <button type="submit" value="yes" class="withdraw-action">はい（下書きへ戻す）</button>
        </div>
      </form>
    </dialog>
    <dialog class="approval-dialog" data-schedule-dialog aria-labelledby="schedule-dialog-title">
      <form method="dialog" data-schedule-form>
        <p class="eyebrow">公開予約</p>
        <h2 id="schedule-dialog-title">公開日時を設定</h2>
        <p>公開審査完了済みの記事だけ予約できます。指定時刻（日本時間）になると公開用PRが自動作成されます。</p>
        <label>公開日時（日本時間）<input type="datetime-local" data-schedule-at required /></label>
        <output data-schedule-message aria-live="polite"></output>
        <div class="approval-actions"><button type="button" class="quiet-action" data-schedule-cancel>キャンセル</button><button type="submit" value="save" class="primary-action">予約する</button></div>
      </form>
    </dialog>
    <dialog class="approval-dialog progress-dialog" data-progress-dialog aria-labelledby="progress-dialog-title">
      <form method="dialog">
        <p class="eyebrow">保存が完了しました</p>
        <h2 id="progress-dialog-title">進捗を記録しますか？</h2>
        <p>記録した進捗は、設定済みの分野Discordチャンネルと全体進捗チャンネルに自動転送されます。</p>
        <label class="progress-detail-label">具体的な進捗内容<textarea data-progress-body maxlength="8000" placeholder="例：定義枠の太字表示を修正し、フィードバック3件を確認しました。"></textarea></label>
        <div class="approval-actions">
          <button type="submit" value="continue" class="quiet-action">編集を続ける</button>
          <button type="submit" value="progress" class="primary-action">進捗を記録する</button>
        </div>
      </form>
    </dialog>
    <dialog class="approval-dialog review-request-dialog" data-review-request-dialog aria-labelledby="review-request-title">
      <form method="dialog" data-review-request-form>
        <p class="eyebrow">フィードバック依頼</p>
        <h2 id="review-request-title">フィードバックを誰に依頼しますか？</h2>
        <label>依頼先<select data-review-request-assignee multiple size="7" required aria-describedby="review-request-assignee-help"><option value="" disabled>担当者を選択</option><option value="*">この分野の担当者全員</option></select><small id="review-request-assignee-help">複数人を選ぶには Ctrl（Windows）または⌘（Mac）を押しながら選択してください。「担当者全員」と個別担当者は同時に選べません。</small></label>
        <label>依頼内容・備考<textarea data-review-request-note maxlength="2000" rows="5" placeholder="重点的に確認してほしい点や期限など"></textarea></label>
        <output data-review-request-message aria-live="polite"></output>
        <div class="approval-actions"><button type="button" data-review-request-cancel class="quiet-action">キャンセル</button><button type="submit" value="request" class="primary-action">フィードバックを依頼する</button></div>
      </form>
    </dialog>
    <dialog class="reference-dialog" data-reference-dialog aria-labelledby="reference-dialog-title">
      <div class="reference-dialog-header"><div><p class="eyebrow">公開記事の参考</p><h2 id="reference-dialog-title" data-reference-title>記事を選択してください</h2><p data-reference-meta></p></div><button type="button" class="quiet-action" data-reference-close>閉じる</button></div>
      <div class="reference-dialog-tabs" role="tablist" aria-label="公開記事の表示方法"><button type="button" role="tab" class="is-selected" data-reference-tab="preview" aria-selected="true" aria-controls="reference-preview-panel">プレビュー</button><button type="button" role="tab" data-reference-tab="source" aria-selected="false" aria-controls="reference-source-panel">Markdown</button></div>
      <article id="reference-preview-panel" class="article-preview reference-preview" data-reference-preview role="tabpanel" aria-label="公開記事のプレビュー"></article>
      <pre id="reference-source-panel" class="reference-source" data-reference-source role="tabpanel" aria-label="公開記事のMarkdown原文" hidden></pre>
    </dialog>
  </main>

  <script is:inline id="editor-source-data" type="application/json" set:html={editorData}></script>
</AdminLayout>

