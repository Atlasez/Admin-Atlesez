---
import { getCollection } from "astro:content";
import AdminLayout from "../../layouts/AdminLayout.astro";
import AdminNav from "../../components/AdminNav.astro";

const subjects = (await getCollection("subjects"))
  .sort((a, b) => a.data.order - b.data.order)
  .map((subject) => ({
    slug: subject.data.slug,
    name: subject.data.name.ja,
    categories: subject.data.categories.map((category) => ({
      slug: category.slug,
      name: category.name.ja,
    })),
  }));
const articles = (await getCollection("articles"))
  .filter((article) => article.data.locale === "ja")
  .map((article) => ({
    articleId: article.data.articleId,
    title: article.data.title,
    subject: article.data.subject,
    category: article.data.category,
    slug: article.data.slug,
    summary: article.data.summary,
    conceptId: article.data.concepts[0]?.id ?? "",
    body: article.body,
  }));
const editorData = JSON.stringify({ subjects, articles }).replace(/</g, "\\u003c");
---

<AdminLayout title="記事編集ワークスペース" description="アトラス運営者用の記事執筆・査読画面">
  <main class="editor-workspace" data-editor-workspace>
    <AdminNav current="editor" />
    <header class="workspace-header">
      <div>
        <p class="eyebrow">ATLASEZ / 運営用</p>
        <h1>記事編集ワークスペース</h1>
        <p>原稿を書く、数式を確かめる、コメントで査読する。公開用のMarkdownまで、この画面で準備できます。</p>
      </div>
      <nav aria-label="運営メニュー">
        <form method="post" action="/auth/logout"><button type="submit">ログアウト</button></form>
      </nav>
    </header>

    <section class="workflow-guide" aria-label="編集の流れ">
      <span><b>1</b> 下書き</span><span aria-hidden="true">→</span><span><b>2</b> 査読中</span><span aria-hidden="true">→</span><span><b>3</b> 査読済み</span><span aria-hidden="true">→</span><span><b>4</b> 公開するか選択</span>
    </section>

    <div class="workspace-grid">
      <aside class="document-sidebar" aria-label="原稿一覧">
        <div class="sidebar-heading">
          <div><p class="eyebrow">自分の担当分野</p><strong data-editor-scope>読み込み中…</strong></div>
          <button type="button" class="primary-action" data-new-document>新規原稿</button>
        </div>
        <div class="source-picker" aria-label="既存記事を下書きに取り込む">
          <span>既存記事を下書きに取り込む</span>
          <label>分野<select data-source-subject><option value="">分野を選択…</option></select></label>
          <label>記事<select data-source-article disabled><option value="">先に分野を選択…</option></select></label>
        </div>
        <button type="button" class="quiet-action" data-import-source>選んだ記事を編集する</button>
        <section class="review-requests" data-review-requests hidden aria-labelledby="review-requests-heading">
          <strong id="review-requests-heading">査読依頼</strong>
          <p>査読中にされた原稿です。全分野管理者だけが確認できます。</p>
          <div data-review-request-list>読み込み中…</div>
        </section>
        <section class="work-board" aria-labelledby="board-heading"><strong id="board-heading">分野ごとの作業状況</strong><div data-work-board>読み込み中…</div></section>
        <div class="document-list" data-document-list aria-live="polite"></div>
      </aside>

      <section class="editor-panel" aria-label="原稿編集">
        <div class="empty-state" data-editor-empty>
          <h2>原稿を選んでください</h2>
          <p>新規原稿を作るか、既存の記事を取り込むと、ここで執筆とプレビューを始められます。</p>
        </div>

        <form class="document-form" data-document-form hidden>
          <input type="hidden" name="documentId" />
          <section class="document-toolbar">
            <div>
              <p class="eyebrow" data-document-state>下書き</p>
              <h2 data-document-heading>新規原稿</h2>
            </div>
            <div class="toolbar-actions">
              <output data-save-message aria-live="polite"></output>
              <label class="engine-control">数式組版<select data-preview-engine><option value="katex">KaTeX（高速）</option><option value="mathjax">MathJax（LaTeX互換）</option></select></label>
              <button type="button" class="quiet-action" data-copy-markdown>公開用Markdownをコピー</button>
              <button type="button" class="primary-action" data-publish-document hidden>査読済み原稿を公開</button>
              <button type="submit" class="primary-action">保存</button>
            </div>
          </section>

          <details class="metadata" open>
            <summary>記事設定</summary>
            <div class="metadata-grid">
              <label>タイトル<input name="title" required maxlength="180" placeholder="例：群の定義" /></label>
              <label>要約<input name="summary" required maxlength="800" placeholder="記事一覧に表示される短い説明" /></label>
              <label>分野<select name="subject" required data-subject></select></label>
              <label>カテゴリ<select name="category" required data-category></select></label>
              <label>URL用の名前<input name="slug" required pattern="[a-z0-9-]+" maxlength="100" placeholder="group-definition" /></label>
              <label>概念ID<input name="conceptId" required pattern="[a-z0-9-]+\.[a-z0-9-]+\.[a-z0-9-]+" maxlength="180" placeholder="math.group-theory.group-definition" /></label>
              <label>言語<select name="locale"><option value="ja">日本語</option><option value="en">English</option></select></label>
              <label>状態<select name="status"><option value="draft">下書き</option><option value="in-review">査読中</option><option value="on-hold">保留</option><option value="approved">査読済み</option></select></label>
            </div>
          </details>

          <div class="editor-split" aria-label="原稿とプレビュー">
            <section class="writing-area">
              <div class="pane-heading"><div><h3>本文（Markdown）</h3><p><code>$...$</code> は行内数式、<code>$$...$$</code> は別行数式です。</p></div><span data-word-count>0文字</span></div>
              <textarea name="body" data-body spellcheck="true" placeholder="## 見出し\n\n本文を書きます。\n\n$G$ を群とする。"></textarea>
            </section>

            <section class="preview-area" aria-labelledby="preview-heading">
              <div class="pane-heading"><div><h3 id="preview-heading">プレビュー</h3><p>KaTeXで数式を即時に組版します。エラーは赤で表示されます。</p></div><span class="live-badge">自動更新</span></div>
              <article class="article-preview" data-preview></article>
            </section>
          </div>

          <section class="review-panel" aria-labelledby="review-heading">
            <div class="pane-heading"><div><h3 id="review-heading">査読・フィードバック</h3><p>本文の修正依頼や確認結果を記録します。コメントは同じ担当分野の運営者に共有されます。</p></div></div>
            <div class="comment-list" data-comment-list></div>
            <label class="comment-entry">コメントを追加<textarea data-comment-body maxlength="8000" placeholder="例：定義の前に具体例を一つ入れると読みやすくなりそうです。"></textarea></label>
            <button type="button" class="quiet-action" data-send-comment>コメントを送る</button>
            <details class="revision-panel"><summary>版履歴・差分確認</summary><div data-revision-list>原稿を保存すると履歴が残ります。</div></details>
          </section>
        </form>
      </section>
    </div>
    <dialog class="approval-dialog" data-approval-dialog aria-labelledby="approval-dialog-title">
      <form method="dialog">
        <p class="eyebrow">公開の最終確認</p>
        <h2 id="approval-dialog-title">この記事を公開しますか？</h2>
        <p>「はい」を選ぶと、GitHubへ公開し、学習サイトの自動ビルドが始まります。</p>
        <div class="approval-actions">
          <button type="submit" value="no" class="quiet-action">いいえ（公開しない）</button>
          <button type="submit" value="yes" class="primary-action">はい（公開する）</button>
        </div>
      </form>
    </dialog>
  </main>

  <script is:inline id="editor-source-data" type="application/json" set:html={editorData}></script>
</AdminLayout>

<style>
  .editor-workspace { --surface: var(--background-primary); --surface-alt: var(--background-secondary); --border: var(--border-default); --text: var(--text-primary); --muted: var(--text-secondary); --accent: var(--accent-primary); box-sizing: border-box; margin: 0 auto; max-width: 1500px; padding: 0 clamp(1rem, 3vw, 2.5rem) 4rem; }
  .workspace-header { align-items: start; border-bottom: 1px solid var(--border); display: flex; gap: 2rem; justify-content: space-between; padding-bottom: 1.25rem; }
  .eyebrow { color: var(--accent); font-size: .76rem; font-weight: 800; letter-spacing: .1em; margin: 0 0 .4rem; }
  h1 { font-size: clamp(1.75rem, 3vw, 2.4rem); letter-spacing: -.03em; margin: 0; }
  .workspace-header > div > p:last-child { color: var(--muted); margin: .55rem 0 0; max-width: 48rem; }
  .workspace-header nav { align-items: center; display: flex; flex: 0 0 auto; gap: .55rem; }
  .workspace-header nav a, .workspace-header nav button { background: var(--surface); border: 1px solid var(--border); border-radius: .45rem; color: var(--text); cursor: pointer; font: inherit; font-size: .84rem; padding: .55rem .7rem; text-decoration: none; }
  .workspace-header nav a:hover, .workspace-header nav button:hover { background: var(--surface-alt); }
  .workspace-header nav form { margin: 0; }
