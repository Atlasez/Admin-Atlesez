<style>
  /* GitHub/CI の状態は、短いバッジだけでなく「何を待っているか」まで読める状態カードにする。 */
  .document-statuses {
    align-items: stretch;
    display: grid;
    gap: .45rem;
    grid-template-columns: max-content max-content minmax(0, 1fr);
    margin-bottom: .55rem;
  }
  .document-statuses .document-status-pill {
    align-items: baseline;
    background: var(--surface-alt);
    border: 1px solid var(--border);
    border-radius: .5rem;
    display: inline-flex;
    gap: .35rem;
    min-height: 2rem;
    padding: .35rem .55rem;
  }
  .document-status-pill > span {
    color: var(--muted);
    font-size: .66rem;
    font-weight: 800;
    letter-spacing: .04em;
    text-transform: uppercase;
  }
  .document-status-pill strong { color: var(--text); font-size: .78rem; }
  .document-statuses .publication-run-status {
    align-items: center;
    background: color-mix(in srgb, var(--accent-subtle, #e5f2fa) 72%, var(--surface));
    border: 1px solid color-mix(in srgb, var(--accent, #176ea6) 62%, var(--border));
    border-radius: .65rem;
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent, #176ea6) 12%, transparent);
    display: grid;
    gap: .55rem;
    grid-column: 1 / -1;
    grid-template-columns: auto minmax(0, 1fr) auto;
    min-width: 0;
    padding: .5rem .65rem;
    width: auto;
  }
  .document-statuses .publication-run-status[hidden],
  .document-statuses .publication-links[hidden],
  .document-statuses .publication-integration-status[hidden] { display: none; }
  .publication-run-status[aria-busy="true"] {
    border-color: color-mix(in srgb, var(--accent, #176ea6) 84%, #164e73);
  }
  .publication-run-status[data-state="failed"],
  .publication-run-status[data-state="needs_operator"] {
    background: color-mix(in srgb, #fff3cf 76%, var(--surface));
    border-color: #c58d13;
    box-shadow: 0 0 0 2px rgb(197 141 19 / .12);
  }
  .publication-run-status .publication-run-indicator {
    background: var(--accent, #176ea6);
    border: 0;
    border-radius: 50%;
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent, #176ea6) 20%, transparent);
    display: inline-block;
    flex: 0 0 16px;
    height: 16px;
    width: 16px;
  }
  .publication-run-status[aria-busy="true"] .publication-run-indicator {
    animation: publication-run-spin .8s linear infinite;
    background: transparent;
    border: 3px solid color-mix(in srgb, var(--accent, #176ea6) 28%, transparent);
    border-right-color: var(--accent, #176ea6);
    border-top-color: var(--accent, #176ea6);
    box-shadow: none;
    box-sizing: border-box;
    height: 16px;
    width: 16px;
  }
  .document-statuses .publication-run-status[aria-busy="true"] .publication-run-indicator {
    height: 16px;
    width: 16px;
  }
  .publication-run-status[data-state="failed"] .publication-run-indicator,
  .publication-run-status[data-state="needs_operator"] .publication-run-indicator {
    background: #b77900;
    box-shadow: 0 0 0 3px rgb(183 121 0 / .16);
  }
  .publication-run-copy {
    align-items: baseline;
    display: grid;
    gap: .1rem .5rem;
    grid-template-columns: max-content minmax(0, 1fr);
    min-width: 0;
  }
  .publication-run-title { color: var(--text); font-size: .7rem; letter-spacing: .04em; }
  .publication-run-state { color: var(--accent, #176ea6); font-size: .82rem; font-weight: 900; }
  .publication-run-status[data-state="failed"] .publication-run-state,
  .publication-run-status[data-state="needs_operator"] .publication-run-state { color: #8a5a00; }
  .publication-run-message {
    color: var(--muted);
    font-size: .67rem;
    grid-column: 1 / -1;
    line-height: 1.35;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .publication-run-updated {
    color: var(--muted);
    font-size: .64rem;
    font-variant-numeric: tabular-nums;
    font-weight: 800;
    line-height: 1.35;
    max-width: 12rem;
    text-align: right;
    white-space: nowrap;
  }
  .document-statuses .publication-links,
  .document-statuses .publication-integration-status {
    align-items: center;
