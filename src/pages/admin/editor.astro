        savedPaneHeights = Object.fromEntries(paneKeys.flatMap((key) => typeof saved[key] === "number" ? [[key, clampPaneHeight(saved[key])]] : []));
      } catch { savedPaneHeights = {}; }
      paneKeys.forEach((key) => {
        const pane = paneElements[key];
        const handle = pane.querySelector<HTMLButtonElement>("[data-pane-resize]");
        if (!handle) return;
        const savedHeight = savedPaneHeights[key];
        if (savedHeight) setPaneHeight(key, savedHeight, false);
        handle.addEventListener("pointerdown", (event) => {
