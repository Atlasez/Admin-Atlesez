  .mention-suggestions { background:var(--surface,#fff); border:1px solid var(--border,#d5dde2); border-radius:.55rem; box-shadow:0 .55rem 1.4rem rgb(24 32 39 / .2); display:grid; gap:.15rem; max-height:15rem; overflow:auto; padding:.3rem; position:fixed; z-index:80; }
  .mention-suggestions[hidden] { display:none; }
  .mention-suggestions button { background:transparent; border:0; border-radius:.35rem; color:var(--text,#182027); cursor:pointer; display:block; font:inherit; font-size:.82rem; padding:.45rem .55rem; text-align:left; width:100%; }
  .mention-suggestions button:hover,.mention-suggestions button.is-active { background:var(--accent-subtle,#e5f2fa); color:var(--accent,#176ea6); }
  .review-panel .comment-replies { display:grid; gap:.65rem; grid-template-columns:minmax(0,1fr); margin:.55rem .7rem .7rem 2.25rem; max-width:calc(100% - 2.95rem); overflow:visible; padding:0 0 .35rem; }
  .review-panel .comment-replies .comment-reply { min-width:0; width:100%; }
  .review-panel .reply-entry textarea { font-size:.78rem; min-height:4rem; max-height:10rem; }
  .editorial-image-error { background:#fff0f0; border:1px solid #d7a2a2; color:#8c2f2f; display:inline-block; font-size:.72rem; padding:.4rem .55rem; }
  .media-item .editorial-image-error { grid-column:1; }
  [data-editorial-asset].is-loading { background:linear-gradient(90deg,var(--surface-alt) 25%,color-mix(in srgb,var(--surface-alt) 65%,var(--surface)) 50%,var(--surface-alt) 75%); }
  [data-editorial-asset].is-unavailable { display:none !important; }
  .pane-edge-controls { inset:0; pointer-events:none; position:absolute; z-index:4; }
  .pane-edge-control { align-items:center; background:color-mix(in srgb,var(--surface,#fff) 88%,transparent); border:1px solid var(--border,#d5dde2); border-radius:.35rem; color:var(--muted,#56616a); cursor:pointer; display:flex; font-size:.72rem; height:1.45rem; justify-content:center; opacity:.78; padding:0; pointer-events:auto; position:absolute; width:1.45rem; }
  .pane-edge-control:hover,.pane-edge-control:focus-visible { background:var(--accent,#176ea6); color:#fff; opacity:1; }
  .pane-edge-control:disabled { cursor:not-allowed; opacity:.25; }
  .pane-edge-control[data-edge="top"] { left:50%; top:-.72rem; transform:translateX(-50%); }
  .pane-edge-control[data-edge="right"] { right:-.72rem; top:50%; transform:translateY(-50%); }
  .pane-edge-control[data-edge="bottom"] { bottom:-.72rem; left:50%; transform:translateX(-50%); }
  .pane-edge-control[data-edge="left"] { left:-.72rem; top:50%; transform:translateY(-50%); }
  .popup-pane-toolbar { align-items:center; background:var(--surface-alt,#f5f7f8); border:1px solid var(--border,#d5dde2); display:flex; justify-content:space-between; margin-bottom:1rem; padding:.7rem .9rem; }
  .popup-pane-toolbar div { display:grid; gap:.15rem; }
  .popup-pane-toolbar small { color:var(--muted,#56616a); }
  .popup-pane-toolbar button { width:auto; }
  .editor-popup-shell .pane-edge-controls { display:none; }
</style>

<style is:global>
  /*
   * 編集画面には、公開状態・警告・入力補助など意味を持つ色付きUIがある。
   * これらをライトテーマの固定色のままにすると、暗色テーマで背景だけが
   * 明るく浮いたり、文字とのコントラストが不足したりするため、ここで
   * ダークテーマ用の状態色へ切り替える。本文や記事データは変更しない。
   */
  [data-pref-bg="dark"] .editor-workspace {
    --editor-status-info-background: #1f3b4d;
    --editor-status-info-border: #5f9fca;
    --editor-status-info-text: #c5e7fb;
    --editor-status-warning-background: #4a3a1b;
    --editor-status-warning-border: #c79a3d;
    --editor-status-warning-text: #f3d58a;
    --editor-status-success-background: #1d3a2a;
    --editor-status-success-border: #64b889;
    --editor-status-success-text: #c8f0d5;
    --editor-status-error-background: #4b2226;
    --editor-status-error-border: #d77f88;
    --editor-status-error-text: #ffd8dc;
  }

  /* CodeMirror が使えない場合にも表示されるフォールバック本文欄。 */
  [data-pref-bg="dark"] .editor-workspace .body-editor-surface:not([data-codemirror-ready="true"]) [data-body],
  [data-pref-bg="dark"] .editor-workspace .source-picker select:disabled {
    background: var(--background-inset);
    color: var(--text-primary);
  }
  [data-pref-bg="dark"] .editor-workspace .source-picker select:disabled {
    color: var(--text-muted);
  }

  /* ツールバーの公開状態・CI状態 */
  [data-pref-bg="dark"] .editor-workspace .document-statuses [data-publication-run][data-state="failed"],
  [data-pref-bg="dark"] .editor-workspace .document-statuses [data-publication-run][data-state="needs_operator"],
  [data-pref-bg="dark"] .editor-workspace .document-statuses .publication-integration-status[data-state="error"],
  [data-pref-bg="dark"] .editor-workspace .publication-diagnostic {
    background: var(--editor-status-warning-background);
    border-color: var(--editor-status-warning-border);
    color: var(--editor-status-warning-text);
  }
  [data-pref-bg="dark"] .editor-workspace .document-statuses [data-publication-run][data-state="failed"] .publication-run-state,
  [data-pref-bg="dark"] .editor-workspace .document-statuses [data-publication-run][data-state="needs_operator"] .publication-run-state,
  [data-pref-bg="dark"] .editor-workspace .publication-diagnostic summary {
    color: var(--editor-status-warning-text);
  }
  [data-pref-bg="dark"] .editor-workspace .document-statuses .publication-integration-status[data-state="ready"] {
    background: var(--editor-status-success-background);
    border-color: var(--editor-status-success-border);
    color: var(--editor-status-success-text);
  }
  [data-pref-bg="dark"] .editor-workspace .document-statuses .publication-integration-status[data-state="checking"],
  [data-pref-bg="dark"] .editor-workspace .document-statuses [data-publication-run][aria-busy="true"] {
    background: var(--editor-status-info-background);
    border-color: var(--editor-status-info-border);
    color: var(--editor-status-info-text);
  }
  [data-pref-bg="dark"] .editor-workspace .document-statuses [data-publication-run][data-state="failed"] .publication-run-indicator,
  [data-pref-bg="dark"] .editor-workspace .document-statuses [data-publication-run][data-state="needs_operator"] .publication-run-indicator {
    background: var(--editor-status-warning-border);
  }

  /* 保存前警告・選択範囲・返信欄など、編集操作に付随する補助UI */
  [data-pref-bg="dark"] .editor-workspace .unsaved-warning,
  [data-pref-bg="dark"] .editor-workspace .selection-action,
  [data-pref-bg="dark"] .editor-workspace .selection-hint.has-selection {
    background: var(--editor-status-warning-background);
    border-color: var(--editor-status-warning-border);
    color: var(--editor-status-warning-text);
  }
  [data-pref-bg="dark"] .editor-workspace .reply-target,
  [data-pref-bg="dark"] .editor-workspace .reply-entry,
  [data-pref-bg="dark"] .editor-workspace .comment-reply {
    background: var(--background-inset);
    color: var(--text-primary);
  }
  [data-pref-bg="dark"] .editor-workspace .editorial-image-error {
    background: var(--editor-status-error-background);
    border-color: var(--editor-status-error-border);
    color: var(--editor-status-error-text);
  }

  /*
   * 状態表示は長いGitHub情報を含むため、max-contentの列で幅を確保しない。
   * 以前の3列グリッドでは、左カラムに残った数pxへPRリンクが押し込まれ、
   * リンク文字が縦一列になってツールバー全体の高さも不安定になっていた。
   */
  .editor-workspace .document-toolbar {
    grid-template-columns: minmax(0, .9fr) minmax(0, 1.8fr);
  }

  .editor-workspace .document-toolbar > div:first-child,
  .editor-workspace .toolbar-actions {
    min-width: 0;
  }

  .editor-workspace .document-statuses {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: .3rem .4rem;
    min-width: 0;
    width: 100%;
  }

  .editor-workspace .document-statuses > .document-status-pill {
    flex: 0 1 auto;
    max-width: 100%;
    min-width: 0;
  }

  .editor-workspace .document-statuses .publication-run-status,
  .editor-workspace .document-statuses .publication-links,
  .editor-workspace .document-statuses .publication-integration-status {
    flex: 1 1 100%;
    grid-column: auto;
    max-width: 100%;
    width: 100%;
  }

  .editor-workspace .document-statuses .publication-run-status {
    display: grid;
  }

  .editor-workspace .publication-run-copy,
  .editor-workspace .publication-run-state,
  .editor-workspace .publication-run-message {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .editor-workspace .publication-run-message {
    white-space: normal;
  }

  .editor-workspace .publication-links {
    align-items: stretch;
  }

  .editor-workspace .publication-links a {
    max-width: 100%;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .editor-workspace .publication-diagnostic {
    max-width: 100%;
    width: min(26rem, 100%);
  }

  .editor-workspace .toolbar-actions {
    align-content: start;
    justify-content: end;
  }

  .editor-workspace .toolbar-actions > .collaboration-status,
  .editor-workspace .toolbar-actions > .document-actions,
  .editor-workspace .toolbar-actions > .save-status {
    min-width: 0;
  }

  .editor-workspace .toolbar-actions > .document-actions {
    flex: 1 1 auto;
    justify-content: end;
  }

  .editor-workspace .toolbar-actions > .save-status {
    flex: 0 1 auto;
    max-width: min(18rem, 100%);
    overflow-wrap: anywhere;
    width: auto;
  }

  @media (max-width: 1080px) {
    .editor-workspace .document-toolbar {
      grid-template-columns: minmax(0, 1fr);
    }

    .editor-workspace .toolbar-actions > .document-actions {
      justify-content: start;
    }
  }

  @media (max-width: 700px) {
    .editor-workspace .document-statuses > .document-status-pill {
      flex: 1 1 auto;
    }

    .editor-workspace .publication-run-status {
      grid-template-columns: auto minmax(0, 1fr);
    }
  }

</style>
