  type PlannedArticle = { key: string; subject: string; category: string; title: string; order: number; progress: "not-started" | "in-progress"; slug: string; conceptId: string };
  type EditorialAsset = { id: string; filename: string; mediaType: string; bytes: number; alt: string; latexName: string; createdAt: string; marker: string };
  type Document = { id: string; source_article_id: string | null; subject: string; category: string; locale: string; slug: string; title: string; summary: string; concept_id: string; body: string; writing_memo?: string; latex_engine: "uplatex" | "pdflatex" | "xelatex" | "lualatex" | "mathjax" | "katex"; status: "draft" | "in-review" | "on-hold" | "approved"; created_by: string; updated_by: string; created_at: string; updated_at: string; reviewed_at: string | null; published_at: string | null };
  type SelectedRange = { start: number | null; end: number | null; text: string; source: "本文" | "プレビュー" | "記事" };
  type CommentSelection = { id?: string; position?: number; selection_start: number | null; selection_end: number | null; selection_text: string };
  type CommentAction = "acknowledge" | "unacknowledge" | "resolve" | "reopen";
  type ActionActorCount = { actor_email: string; actor_display_name?: string; count: number };
  type Comment = { id: string; parent_comment_id: string | null; body: string; created_by: string; author_display_name?: string; author_avatar_url?: string; created_at: string; selection_start: number | null; selection_end: number | null; selection_text: string | null; selections?: CommentSelection[]; acknowledged_at: string | null; acknowledged_by: string | null; acknowledged_by_emails?: string[]; unacknowledged_by_emails?: string[]; resolved_at: string | null; resolved_by: string | null; action_counts?: Partial<Record<CommentAction, number>>; action_actor_counts?: Partial<Record<CommentAction, ActionActorCount[]>> };
  const initializeEditorWorkspace = () => {
    const payloadElement = document.querySelector<HTMLScriptElement>("#editor-source-data");
    const root = document.querySelector<HTMLElement>("[data-editor-workspace]");
    if (!root || !payloadElement || root.dataset.editorInitialized === "true") return;
    root.dataset.editorInitialized = "true";
    const { subjects, articles, plannedArticles } = JSON.parse(payloadElement.textContent ?? "{}") as { subjects: Subject[]; articles: SourceArticle[]; plannedArticles: PlannedArticle[] };
