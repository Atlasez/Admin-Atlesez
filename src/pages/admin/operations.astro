---
import AdminLayout from "../../layouts/AdminLayout.astro";
import AdminNav from "../../components/AdminNav.astro";
import AdminErrorActions from "../../components/AdminErrorActions.astro";
import { getCollection } from "astro:content";
const subjects = (await getCollection("subjects")).sort((a, b) => a.data.order - b.data.order).map((subject) => ({ slug: subject.data.slug, name: subject.data.name.ja }));
const timezones = [
  ["Asia/Tokyo", "日本（東京）"], ["Asia/Seoul", "韓国（ソウル）"], ["Asia/Shanghai", "中国（上海）"], ["Asia/Taipei", "台湾（台北）"], ["Asia/Hong_Kong", "香港"], ["Asia/Singapore", "シンガポール"], ["Asia/Bangkok", "タイ（バンコク）"], ["Asia/Kolkata", "インド（コルカタ）"], ["Asia/Dubai", "アラブ首長国連邦（ドバイ）"], ["Australia/Sydney", "オーストラリア（シドニー）"], ["Pacific/Auckland", "ニュージーランド（オークランド）"], ["Europe/London", "英国（ロンドン）"], ["Europe/Paris", "フランス・中央ヨーロッパ"], ["Europe/Berlin", "ドイツ（ベルリン）"], ["Europe/Rome", "イタリア（ローマ）"], ["Europe/Madrid", "スペイン（マドリード）"], ["Europe/Moscow", "ロシア（モスクワ）"], ["Africa/Cairo", "エジプト（カイロ）"], ["Africa/Johannesburg", "南アフリカ（ヨハネスブルク）"], ["America/Sao_Paulo", "ブラジル（サンパウロ）"], ["America/New_York", "米国東部（ニューヨーク）"], ["America/Chicago", "米国中部（シカゴ）"], ["America/Denver", "米国山岳部（デンバー）"], ["America/Los_Angeles", "米国太平洋（ロサンゼルス）"], ["America/Anchorage", "米国アラスカ"], ["Pacific/Honolulu", "米国ハワイ"], ["America/Toronto", "カナダ（トロント）"], ["America/Vancouver", "カナダ（バンクーバー）"], ["America/Mexico_City", "メキシコ（メキシコシティ）"], ["UTC", "協定世界時（UTC）"],
] as const;
---
<AdminLayout title="進捗・ToDo・日程" description="運営作業を共有する場所">
<main class="operations" data-operations><AdminNav current="operations" /><AdminErrorActions />
<header><p>ATLASEZ / 運営の進行管理</p><h1>進捗・ToDo・日程</h1><span>作業を終えたら進捗を残し、次の作業と参加可能な日程を共有します。</span></header>
<div class="grid">
<section><h2>進捗を報告</h2><p>編集・査読の完了後に、ここへ短く記録できます。</p><p class="discord-notice">記録すると、設定済みの分野Discordチャンネルと全体進捗チャンネルへ自動転送されます。</p><textarea data-progress placeholder="例：群の定義を修正し、査読コメント3件に対応しました。"></textarea><button data-send-progress>進捗を記録してDiscordへ送る</button><output data-progress-feedback aria-live="polite"></output><h3 class="subheading">自分が投げた進捗報告</h3><div data-progress-list></div></section>
<section><h2>ToDo</h2><p>自分の担当、または自分が依頼したタスクを優先して確認できます。</p><div class="todo-view-switch" role="tablist" aria-label="ToDoの表示範囲"><button type="button" data-task-view="mine" aria-selected="true">自分のToDo</button><button type="button" data-task-view="all" aria-selected="false">すべてのToDo</button></div><label class="field-label">並べ替え・絞り込み<select data-task-filter><option value="due">期限が近い順</option><option value="overdue">期限切れ</option><option value="today">今日まで</option><option value="created">自分が依頼</option><option value="assigned">自分が担当</option></select></label><input data-task-title placeholder="タスク名"/><label class="field-label">対象分野<select data-task-subject><option value="">全体</option>{subjects.map((subject) => <option value={subject.slug}>{subject.name}</option>)}</select></label><label class="field-label">担当者<select data-task-assignee><option value="">担当者を指定しない</option></select></label><div class="task-deadline"><label class="field-label">期限日時<input data-task-due type="datetime-local" /></label><label class="field-label">期限のタイムゾーン<select data-task-due-timezone>{timezones.map(([value, label]) => <option value={value} selected={value === "Asia/Tokyo"}>{label}</option>)}</select></label></div><div class="task-reminder"><label class="field-label">リマインダー日時<input data-task-reminder type="datetime-local" /></label><label class="field-label">繰り返し<select data-task-reminder-repeat><option value="none">設定なし</option><option value="once">1回</option><option value="daily">毎日</option><option value="weekly">毎週</option><option value="monthly">毎月</option></select></label></div><textarea data-task-details placeholder="補足・依頼内容（任意）"></textarea><button data-create-task>タスクを追加</button><output class="operation-feedback" data-task-feedback aria-live="polite"></output><div data-task-list aria-live="polite"></div></section>
<section class="wide"><h2>同時作業会・交流会の日程</h2><p>全分野管理者は日程を追加できます。各メンバーは「参加できる／未定／参加できない」を自分で登録します。</p><label class="field-label">表示するタイムゾーン<select data-calendar-timezone>{timezones.map(([value, label]) => <option value={value} selected={value === "Asia/Tokyo"}>{label}</option>)}</select></label><div class="calendar-head"><button type="button" data-calendar-prev aria-label="前の月">‹</button><strong data-calendar-title>読み込み中…</strong><button type="button" data-calendar-next aria-label="次の月">›</button></div><div class="calendar-week" data-event-calendar aria-label="日程カレンダー"></div><small class="calendar-note">選択した地域の主な祝日をカレンダーに表示します。日程は選択したタイムゾーンで表示します。</small><div class="event-create" data-event-create hidden><input data-event-title placeholder="催し名"/><input data-event-start type="datetime-local" aria-label="開始日時"/><input data-event-end type="datetime-local" aria-label="終了日時"/><select data-event-timezone aria-label="日程の基準タイムゾーン">{timezones.map(([value, label]) => <option value={value} selected={value === "Asia/Tokyo"}>{label}</option>)}</select><button data-create-event>日程を追加</button></div><output class="operation-feedback" data-event-feedback aria-live="polite"></output><div data-event-list aria-live="polite"></div></section>
</div></main>
</AdminLayout>
<style is:global>
.operations{margin:0 auto;max-width:1200px;padding:0 1.25rem 4rem}.operations > header{border-bottom:1px solid var(--border-default);padding:2rem 0 1.25rem}.operations > header p{color:var(--accent-primary);font-size:.76rem;font-weight:800;letter-spacing:.08em;margin:0}.operations h1{font-size:2rem;margin:.25rem 0}.operations > header span,.operations section>p{color:var(--text-secondary);line-height:1.6}.grid{display:grid;gap:1rem;grid-template-columns:1fr 1fr;margin-top:1.25rem}.grid section{border:1px solid var(--border-default);padding:1rem}.grid h2{font-size:1.1rem;margin:0}.grid section>p{font-size:.82rem;margin:.4rem 0 .8rem}.wide{grid-column:span 2}.operations input,.operations textarea{background:var(--background-primary);border:1px solid var(--border-default);box-sizing:border-box;color:var(--text-primary);font:inherit;margin:.25rem 0;padding:.55rem;width:100%}.operations textarea{min-height:6rem;resize:vertical}.operations button{background:var(--accent-primary);border:1px solid var(--accent-primary);color:#fff;cursor:pointer;font:inherit;font-size:.82rem;font-weight:800;margin-top:.35rem;padding:.5rem .7rem}.item{border-top:1px solid var(--border-default);display:grid;gap:.3rem;margin-top:.85rem;padding:.7rem 0}.item small{color:var(--text-secondary)}.task-row{align-items:center;display:flex;gap:.5rem;justify-content:space-between}.task-row select{font:inherit;padding:.25rem}.event-create{display:grid;gap:.35rem;grid-template-columns:1fr 1fr 1fr auto}.event-create[hidden]{display:none!important}.availability{display:flex;flex-wrap:wrap;gap:.35rem}.availability button{background:var(--background-secondary);border-color:var(--border-default);color:var(--text-primary)}.availability button:hover{border-color:var(--accent-primary);color:var(--accent-primary)}@media(max-width:700px){.operations{padding:0 .8rem 3rem}.operations > header{align-items:start;display:block}.grid{grid-template-columns:1fr}.wide{grid-column:auto}.event-create{grid-template-columns:1fr}.task-row{align-items:start;display:grid}}
  .calendar-head{align-items:center;display:flex;justify-content:center;gap:.7rem;margin:1rem 0 .55rem}.calendar-head button{font-size:1.2rem;line-height:1;margin:0;min-width:2.2rem}.calendar-week{display:grid;gap:1px;grid-template-columns:repeat(7,minmax(0,1fr));background:var(--border-default);border:1px solid var(--border-default)}.calendar-cell{background:var(--background-primary);min-height:6.8rem;padding:.35rem}.calendar-cell--blank{background:var(--background-secondary)}.calendar-day{color:var(--text-secondary);font-size:.7rem;font-weight:800}.calendar-event{background:color-mix(in srgb,var(--accent-primary) 13%,var(--background-primary));border-left:2px solid var(--accent-primary);display:block;font-size:.67rem;line-height:1.35;margin-top:.25rem;overflow:hidden;padding:.15rem .25rem;text-overflow:ellipsis;white-space:nowrap}.calendar-note{color:var(--text-secondary);display:block;font-size:.72rem;margin-top:.5rem}.event-create{grid-template-columns:1fr 1fr 1fr minmax(125px,.7fr) auto}@media(max-width:700px){.calendar-cell{min-height:4.6rem;padding:.25rem}.calendar-event{font-size:.58rem}.event-create{grid-template-columns:1fr}}
  .calendar-cell--holiday{background:color-mix(in srgb,#d9485f 8%,var(--background-primary))}.calendar-holiday{color:#b33649;display:block;font-size:.61rem;font-weight:800;line-height:1.25;margin-top:.15rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.task-deadline{display:grid;gap:.55rem;grid-template-columns:1fr 1fr}.task-deadline input,.task-deadline select{margin:.25rem 0}@media(max-width:700px){.task-deadline{grid-template-columns:1fr}}
  .event-heading{align-items:center;display:flex;gap:.6rem;justify-content:space-between}
  .event-delete{background:transparent!important;border-color:var(--border-default)!important;color:var(--text-secondary)!important;font-size:.72rem!important;font-weight:700!important;margin:0!important;padding:.3rem .5rem!important}
  .event-delete:hover{border-color:var(--accent-primary)!important;color:var(--accent-primary)!important}
</style>
<style is:global>
  .participant-summary { border-top: 1px solid var(--border-default); display: grid; gap: .45rem; margin-top: .55rem; padding-top: .55rem; }
  .participant-counts, .participant-names { display: flex; flex-wrap: wrap; gap: .35rem; }
  .participant-counts span, .participant-chip { border: 1px solid var(--border-default); border-radius: 999px; color: var(--text-secondary); font-size: .72rem; padding: .2rem .45rem; }
  .participant-chip { color: var(--text-primary); }
  .participant-available { background: #e4f5ea; border-color: #9bc9a9; }
  .participant-maybe { background: #fff4d6; border-color: #e5c879; }
  .participant-unavailable { background: #f5e5e7; border-color: #d8a4ad; }
</style>
<style>.discord-notice{background:color-mix(in srgb,var(--accent-primary),transparent 90%);border-left:3px solid var(--accent-primary);font-size:.8rem!important;font-weight:700;padding:.55rem .7rem}</style>
<style>.field-label{color:var(--text-secondary);display:grid;font-size:.76rem;font-weight:800;gap:.15rem}.operations select{background:var(--background-primary);border:1px solid var(--border-default);box-sizing:border-box;color:var(--text-primary);font:inherit;margin:.25rem 0;padding:.55rem;width:100%}.operation-feedback{color:var(--text-secondary);display:block;font-size:.76rem;min-height:1.2rem;padding-top:.35rem}.operations button:disabled{cursor:wait;opacity:.62}</style>
<style>.availability button.is-selected{background:var(--accent-primary);border-color:var(--accent-primary);color:#fff;box-shadow:0 0 0 2px color-mix(in srgb,var(--accent-primary),transparent 75%)}.availability button[aria-pressed="true"]{font-weight:900}</style>
<style>.subheading{border-top:1px solid var(--border-default);font-size:.82rem;margin:1rem 0 0;padding-top:.75rem}.todo-view-switch{display:flex;gap:.35rem;margin:.7rem 0}.todo-view-switch button{background:var(--background-secondary);border-color:var(--border-default);color:var(--text-primary);font-size:.76rem;margin:0}.todo-view-switch button[aria-selected="true"]{background:var(--accent-primary);border-color:var(--accent-primary);color:#fff}.task-role{background:color-mix(in srgb,var(--accent-primary),transparent 88%);border-radius:999px;color:var(--accent-primary);font-weight:800;padding:.12rem .35rem}.task-reminder{display:grid;gap:.55rem;grid-template-columns:1fr 1fr}.task-reminder input,.task-reminder select{margin:.25rem 0}@media(max-width:700px){.task-reminder{grid-template-columns:1fr}}</style>
<style>.task-feedback{align-items:center;color:var(--text-secondary);display:flex;flex-wrap:wrap;font-size:.72rem;gap:.35rem .55rem;margin-top:.35rem}.task-feedback button{background:transparent;border-color:var(--border-default);color:var(--text-primary);font-size:.7rem;margin:0;padding:.25rem .45rem}.task-feedback button:hover{border-color:var(--accent-primary);color:var(--accent-primary)}.task-feedback .task-unreflected{color:#9a3535}</style>
<style is:global>
  .availability { gap: .6rem; margin-top: .45rem; }
  .availability button { border-radius: .55rem; font-size: .9rem; min-height: 2.8rem; min-width: 8.5rem; padding: .65rem .9rem; }
  .availability button.is-selected { box-shadow: 0 0 0 3px color-mix(in srgb,var(--accent-primary),transparent 78%); }
  @media (max-width: 700px) { .availability { display: grid; grid-template-columns: 1fr; } .availability button { width: 100%; } }
</style>
<script>
  type OperationMember = { email: string; display_name?: string };
  type OperationEvent = { id: string; title: string; starts_at: string; ends_at?: string | null; availability?: string | null; availabilityCounts?: Record<string, number>; participants?: Array<{ displayName: string; availability: string; isSelf: boolean }> };
  type OperationData = { scope: { email?: string; isManager: boolean }; tasks?: Array<Record<string, any>>; events?: OperationEvent[]; progress?: Array<Record<string, any>>; members?: OperationMember[] };
  const initializeOperations = () => {
    const root = document.querySelector<HTMLElement>('[data-operations]');
    if (!root || root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';
    const get = <T extends Element>(selector: string) => root.querySelector<T>(selector)!;
    const progress = get<HTMLTextAreaElement>('[data-progress]');
    const tasks = get<HTMLElement>('[data-task-list]');
    const events = get<HTMLElement>('[data-event-list]');
    const reports = get<HTMLElement>('[data-progress-list]');
    const assignee = get<HTMLSelectElement>('[data-task-assignee]');
    const taskFilter = get<HTMLSelectElement>('[data-task-filter]');
    const calendar = get<HTMLElement>('[data-event-calendar]');
    const calendarTitle = get<HTMLElement>('[data-calendar-title]');
    const timezone = get<HTMLSelectElement>('[data-calendar-timezone]');
    const taskDue = get<HTMLInputElement>('[data-task-due]');
    const taskDueTimezone = get<HTMLSelectElement>('[data-task-due-timezone]');
    const taskReminder = get<HTMLInputElement>('[data-task-reminder]');
    const taskReminderRepeat = get<HTMLSelectElement>('[data-task-reminder-repeat]');
    const progressFeedback = get<HTMLOutputElement>('[data-progress-feedback]');
    const taskFeedback = get<HTMLOutputElement>('[data-task-feedback]');
    const eventFeedback = get<HTMLOutputElement>('[data-event-feedback]');
    const escapeHtml = (value: string) => value.replace(/[&<>"']/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[character] ?? character);
    const anonymousMemberLabel = (value: string) => { const normalized = value.trim().toLowerCase(); let hash = 2166136261; for (const character of normalized) { hash ^= character.codePointAt(0) ?? 0; hash = Math.imul(hash, 16777619); } return String((hash >>> 0) % 9000 + 1000); };
    const memberDisplayName = (name: unknown, email: string) => { const value = String(name ?? '').trim(); return !value || value === '表示名未設定' ? anonymousMemberLabel(email) : value; };
    const api = async <T,>(url: string, method = 'GET', body?: unknown): Promise<T> => {
      const response = await fetch(url, { method, credentials: 'same-origin', cache: 'no-store', headers: body === undefined ? {} : { 'content-type': 'application/json' }, body: body === undefined ? undefined : JSON.stringify(body) });
      const contentType = response.headers.get('content-type') ?? '';
      const data = contentType.includes('application/json') ? await response.json() as T & { error?: string } : null;
      if (!response.ok || !data) throw new Error(data?.error ?? '認証情報を確認できませんでした。ページを再読み込みしてください。');
      return data;
    };
    const showError = (message: string) => window.dispatchEvent(new CustomEvent('atlasez-admin-error', { detail: { message } }));
    let data: OperationData = { scope: { isManager: false } };
    let taskView: 'mine' | 'all' = 'mine';
    let month = new Date(); month = new Date(month.getFullYear(), month.getMonth(), 1);
    try { const local = Intl.DateTimeFormat().resolvedOptions().timeZone; if ([...timezone.options].some((option) => option.value === local)) timezone.value = local; } catch { /* 既定の日本時間を使う */ }
    const formatDate = (value: string) => new Intl.DateTimeFormat('ja-JP', { dateStyle: 'medium', timeStyle: 'short', timeZone: timezone.value }).format(new Date(value));
    const dateParts = (value: string) => Object.fromEntries(new Intl.DateTimeFormat('en-CA', { timeZone: timezone.value, year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', hour12: false }).formatToParts(new Date(value)).filter((part) => part.type !== 'literal').map((part) => [part.type, part.value]));
    const holidayName = (key: string) => {
      const [year, month, day] = key.split('-').map(Number); const zone = timezone.value;
      const fixed: Record<string, Record<string, string>> = {
        'Asia/Tokyo': {'01-01':'元日','02-11':'建国記念の日','02-23':'天皇誕生日','04-29':'昭和の日','05-03':'憲法記念日','05-04':'みどりの日','05-05':'こどもの日','08-11':'山の日','11-03':'文化の日','11-23':'勤労感謝の日'},
        'Asia/Seoul': {'01-01':'元日','03-01':'三一節','05-05':'こどもの日','06-06':'顕忠日','08-15':'光復節','10-03':'開天節','10-09':'ハングルの日','12-25':'クリスマス'},
        'Asia/Taipei': {'01-01':'元日','02-28':'和平記念日','05-01':'労働節','10-10':'国慶日','12-25':'行憲紀念日'},
        'America/New_York': {'01-01':'New Year’s Day','07-04':'Independence Day','11-11':'Veterans Day','12-25':'Christmas Day'},
        'America/Chicago': {'01-01':'New Year’s Day','07-04':'Independence Day','11-11':'Veterans Day','12-25':'Christmas Day'},
        'America/Denver': {'01-01':'New Year’s Day','07-04':'Independence Day','11-11':'Veterans Day','12-25':'Christmas Day'},
        'America/Los_Angeles': {'01-01':'New Year’s Day','07-04':'Independence Day','11-11':'Veterans Day','12-25':'Christmas Day'},
        'Europe/London': {'01-01':'New Year’s Day','12-25':'Christmas Day','12-26':'Boxing Day'},
        'Europe/Paris': {'01-01':'Jour de l’An','05-01':'Fête du Travail','07-14':'Fête nationale','11-11':'Armistice','12-25':'Noël'},
      };
      const name = fixed[zone]?.[`${String(month).padStart(2,'0')}-${String(day).padStart(2,'0')}`]; if (name) return name;
      // 日本の移動祝日（春分・秋分を除く）は年に依存するため、代表的な月曜祝日を計算する。
      if (zone === 'Asia/Tokyo') { const dow = new Date(year, month - 1, day).getDay(); if (month === 1 && dow === 1 && day >= 8 && day <= 14) return '成人の日'; if (month === 7 && dow === 1 && day >= 15 && day <= 21) return '海の日'; if (month === 9 && dow === 1 && day >= 15 && day <= 21) return '敬老の日'; if (month === 10 && dow === 1 && day >= 8 && day <= 14) return 'スポーツの日'; }
      return '';
    };
    const renderCalendar = () => {
      const first = new Date(month.getFullYear(), month.getMonth(), 1), last = new Date(month.getFullYear(), month.getMonth() + 1, 0);
      calendarTitle.textContent = new Intl.DateTimeFormat('ja-JP', { year: 'numeric', month: 'long' }).format(first);
      const cells = ['日','月','火','水','木','金','土'].map((day) => `<div class="calendar-cell calendar-cell--blank"><span class="calendar-day">${day}</span></div>`);
      for (let index = 0; index < first.getDay(); index += 1) cells.push('<div class="calendar-cell calendar-cell--blank"></div>');
      for (let day = 1; day <= last.getDate(); day += 1) {
        const key = `${month.getFullYear()}-${String(month.getMonth() + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
        const dayEvents = (data.events ?? []).filter((event) => { const parts = dateParts(event.starts_at); return `${parts.year}-${parts.month}-${parts.day}` === key; });
        const holiday = holidayName(key); cells.push(`<div class="calendar-cell${holiday ? ' calendar-cell--holiday' : ''}"><span class="calendar-day">${day}</span>${holiday ? `<span class="calendar-holiday" title="祝日">${escapeHtml(holiday)}</span>` : ''}${dayEvents.map((event) => { const parts = dateParts(event.starts_at); return `<span class="calendar-event" title="${escapeHtml(event.title)}">${parts.hour}:${parts.minute} ${escapeHtml(event.title)}</span>`; }).join('')}</div>`);
      }
      calendar.innerHTML = cells.join('');
    };
    const render = () => {
      const members = new Map((data.members ?? []).map((member) => [member.email, memberDisplayName(member.display_name, member.email)]));
      get<HTMLElement>('[data-event-create]').hidden = !data.scope.isManager;
      assignee.innerHTML = '<option value="">担当者を指定しない</option>' + (data.members ?? []).map((member) => `<option value="${escapeHtml(member.email)}">${escapeHtml(memberDisplayName(member.display_name, member.email))}</option>`).join('');
      reports.innerHTML = (data.progress ?? []).map((item) => `<article class="item"><span>${escapeHtml(String(item.body ?? ''))}</span><small>${formatDate(String(item.created_at))}</small></article>`).join('') || '<p>まだ進捗報告はありません。</p>';
      const now = Date.now();
      const todayKey = new Intl.DateTimeFormat('en-CA', { timeZone: timezone.value }).format(new Date());
      const visibleTasks = (data.tasks ?? []).filter((item) => taskView === 'all' || String(item.assignee_email ?? '') === String(data.scope.email ?? '') || String(item.created_by ?? '') === String(data.scope.email ?? '')).filter((item) => {
        const due = item.due_at ? Date.parse(String(item.due_at)) : Number.NaN;
        if (taskFilter.value === 'overdue') return Number.isFinite(due) && due < now && item.status !== 'done';
        if (taskFilter.value === 'today') return String(item.due_at ?? '').slice(0, 10) === todayKey && item.status !== 'done';
        if (taskFilter.value === 'created') return String(item.created_by ?? '') === String(data.scope.email ?? '');
        if (taskFilter.value === 'assigned') return String(item.assignee_email ?? '') === String(data.scope.email ?? '');
        return true;
      }).sort((a, b) => {
        if (taskFilter.value === 'created' || taskFilter.value === 'assigned') return String(b.updated_at ?? '').localeCompare(String(a.updated_at ?? ''));
        const aDue = a.due_at ? Date.parse(String(a.due_at)) : Number.POSITIVE_INFINITY;
        const bDue = b.due_at ? Date.parse(String(b.due_at)) : Number.POSITIVE_INFINITY;
        return aDue - bDue || String(b.updated_at ?? '').localeCompare(String(a.updated_at ?? ''));
      });
      tasks.innerHTML = visibleTasks.map((item) => { const feedback = Array.isArray(item.feedback) ? item.feedback as Array<{ displayName?: string; status?: string }> : []; const confirmed = feedback.filter((entry) => entry.status === 'confirmed'); const unreflected = feedback.filter((entry) => entry.status === 'unreflected'); const viewer = String(item.viewerFeedbackStatus ?? ''); const role = String(item.assignee_email ?? '') === String(data.scope.email ?? '') ? '自分が担当' : String(item.created_by ?? '') === String(data.scope.email ?? '') ? '自分が依頼' : ''; const repeatLabel = ({ once: '1回', daily: '毎日', weekly: '毎週', monthly: '毎月' } as Record<string, string>)[String(item.reminder_repeat)] ?? ''; const reminder = item.reminder_at ? ` ・リマインダー：${escapeHtml(String(item.reminder_at).replace('T',' '))}${repeatLabel ? `（${repeatLabel}）` : ''}` : ''; return `<article class="item task-item"><div class="task-row"><b>${escapeHtml(String(item.title ?? ''))}</b><select aria-label="${escapeHtml(String(item.title ?? 'タスク'))}の状態" data-task-status="${escapeHtml(String(item.id))}"><option value="open" ${item.status === 'open' ? 'selected' : ''}>未着手</option><option value="doing" ${item.status === 'doing' ? 'selected' : ''}>進行中</option><option value="done" ${item.status === 'done' ? 'selected' : ''}>完了</option></select></div><small>${role ? `<span class="task-role">${role}</span> ・ ` : ''}${escapeHtml(String(item.subject || '全体'))}${item.assignee_email ? ` ・担当：${escapeHtml(members.get(String(item.assignee_email)) || '表示名未設定')}` : ''}${item.due_at ? ` ・期限：${escapeHtml(String(item.due_at).replace('T',' '))}（${escapeHtml(String(item.due_timezone || 'Asia/Tokyo'))}）` : ''}${reminder}</small>${item.details ? `<small>${escapeHtml(String(item.details))}</small>` : ''}<div class="task-feedback"><span>確認済み（${confirmed.length}）・未反映（${unreflected.length}）</span>${feedback.length ? `<span>${feedback.map((entry) => `${escapeHtml(String(entry.displayName || '運営メンバー'))}：${entry.status === 'confirmed' ? '確認済み' : '未反映'}`).join('、')}</span>` : ''}<button type="button" data-task-feedback-action="${viewer === 'confirmed' ? 'unacknowledge' : 'acknowledge'}" data-task-id="${escapeHtml(String(item.id))}">${viewer === 'confirmed' ? '確認を取り消す' : '確認済みにする'}</button><button type="button" class="task-unreflected" data-task-feedback-action="${viewer === 'unreflected' ? 'clear-unreflected' : 'unreflected'}" data-task-id="${escapeHtml(String(item.id))}">${viewer === 'unreflected' ? '未反映を取り消す' : '未反映'}</button></div></article>`; }).join('') || '<p>表示できるタスクはありません。</p>';
      const availabilityLabels: Record<string, string> = { available: '参加できる', maybe: '未定', unavailable: '参加できない' };
      events.innerHTML = (data.events ?? []).map((item) => { const counts = item.availabilityCounts ?? {}; const participants = item.participants ?? []; return `<article class="item"><div class="event-heading"><b>${escapeHtml(item.title)}</b>${data.scope.isManager ? `<button type="button" class="event-delete" data-delete-event="${escapeHtml(item.id)}">この日程を削除</button>` : ''}</div><small>${formatDate(item.starts_at)}${item.ends_at ? ` 〜 ${formatDate(item.ends_at)}` : ''}</small><div class="availability">${Object.entries(availabilityLabels).map(([value, label]) => `<button type="button" class="${item.availability === value ? 'is-selected' : ''}" aria-pressed="${item.availability === value}" data-availability="${value}" data-event="${escapeHtml(item.id)}">${label}${item.availability === value ? ' ✓' : ''}</button>`).join('')}</div><div class="participant-summary"><div class="participant-counts"><span>参加 ${counts.available ?? 0}</span><span>未定 ${counts.maybe ?? 0}</span><span>不参加 ${counts.unavailable ?? 0}</span></div><div class="participant-names">${participants.length ? participants.map((participant) => `<span class="participant-chip participant-${escapeHtml(participant.availability)}">${escapeHtml(participant.isSelf ? '自分' : participant.displayName)}：${escapeHtml(availabilityLabels[participant.availability] ?? participant.availability)}</span>`).join('') : '<span>まだ参加登録はありません。</span>'}</div></div></article>`; }).join('') || '<p>登録された日程はありません。</p>';
      renderCalendar();
    };
    const load = async () => { data = await api<OperationData>('/api/admin/operations'); render(); };
    const runButtonAction = async (button: HTMLButtonElement, feedback: HTMLOutputElement, action: () => Promise<void>, success: string) => { button.disabled = true; feedback.value = '保存中…'; try { await action(); feedback.value = success; await load(); } catch (error) { const message = error instanceof Error ? error.message : '保存できませんでした。'; feedback.value = message; showError(message); } finally { button.disabled = false; } };
    get<HTMLButtonElement>('[data-send-progress]').addEventListener('click', (event) => { const button = event.currentTarget as HTMLButtonElement; void runButtonAction(button, progressFeedback, async () => { await api('/api/admin/operations/progress', 'POST', { body: progress.value }); progress.value = ''; }, '進捗を記録しました。'); });
    get<HTMLButtonElement>('[data-create-task]').addEventListener('click', (event) => { const button = event.currentTarget as HTMLButtonElement; void runButtonAction(button, taskFeedback, async () => { await api('/api/admin/operations/tasks', 'POST', { title: get<HTMLInputElement>('[data-task-title]').value, subject: get<HTMLSelectElement>('[data-task-subject]').value, assigneeEmail: assignee.value, dueAt: taskDue.value, dueTimezone: taskDueTimezone.value, reminderAt: taskReminder.value, reminderRepeat: taskReminderRepeat.value, details: get<HTMLTextAreaElement>('[data-task-details]').value }); taskDue.value = ''; taskReminder.value = ''; taskReminderRepeat.value = 'none'; }, 'ToDoを追加しました。'); });
    root.querySelectorAll<HTMLButtonElement>('[data-task-view]').forEach((button) => button.addEventListener('click', () => { taskView = button.dataset.taskView === 'all' ? 'all' : 'mine'; root.querySelectorAll<HTMLButtonElement>('[data-task-view]').forEach((item) => item.setAttribute('aria-selected', String(item === button))); render(); }));
    taskFilter.addEventListener('change', () => render());
    get<HTMLButtonElement>('[data-create-event]').addEventListener('click', (event) => { const button = event.currentTarget as HTMLButtonElement; void runButtonAction(button, eventFeedback, async () => { await api('/api/admin/operations/events', 'POST', { title: get<HTMLInputElement>('[data-event-title]').value, startsAt: get<HTMLInputElement>('[data-event-start]').value, endsAt: get<HTMLInputElement>('[data-event-end]').value, timezone: get<HTMLSelectElement>('[data-event-timezone]').value }); }, '日程を追加しました。'); });
    tasks.addEventListener('change', (event) => { const select = (event.target as HTMLElement).closest<HTMLSelectElement>('[data-task-status]'); if (!select) return; select.disabled = true; void api(`/api/admin/operations/tasks/${encodeURIComponent(select.dataset.taskStatus ?? '')}`, 'PATCH', { status: select.value }).then(load).catch((error) => { const message = error instanceof Error ? error.message : '状態を更新できませんでした。'; taskFeedback.value = message; showError(message); }).finally(() => { select.disabled = false; }); });
    tasks.addEventListener('click', (event) => { const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-task-feedback-action]'); if (!button) return; button.disabled = true; taskFeedback.value = '確認状態を保存中…'; void api(`/api/admin/operations/tasks/${encodeURIComponent(button.dataset.taskId ?? '')}`, 'PATCH', { feedbackAction: button.dataset.taskFeedbackAction }).then(async () => { taskFeedback.value = '確認状態を保存しました。'; await load(); }).catch((error) => { const message = error instanceof Error ? error.message : '確認状態を更新できませんでした。'; taskFeedback.value = message; showError(message); }).finally(() => { button.disabled = false; }); });
    events.addEventListener('click', (event) => { const target = event.target as HTMLElement; const deleteButton = target.closest<HTMLButtonElement>('[data-delete-event]'); if (deleteButton) { if (!confirm('この日程と参加登録を削除しますか？')) return; deleteButton.disabled = true; eventFeedback.value = '日程を削除中…'; void api(`/api/admin/operations/events/${encodeURIComponent(deleteButton.dataset.deleteEvent ?? '')}`, 'DELETE').then(async () => { eventFeedback.value = '日程を削除しました。'; await load(); }).catch((error) => { const message = error instanceof Error ? error.message : '日程を削除できませんでした。'; eventFeedback.value = message; showError(message); }).finally(() => { deleteButton.disabled = false; }); return; } const button = target.closest<HTMLButtonElement>('[data-availability]'); if (!button) return; button.disabled = true; eventFeedback.value = '参加状態を保存中…'; void api(`/api/admin/operations/events/${encodeURIComponent(button.dataset.event ?? '')}/availability`, 'PUT', { availability: button.dataset.availability }).then(async () => { eventFeedback.value = '参加状態を保存しました。'; await load(); }).catch((error) => { const message = error instanceof Error ? error.message : '参加状態を保存できませんでした。'; eventFeedback.value = message; showError(message); }).finally(() => { button.disabled = false; }); });
    get<HTMLButtonElement>('[data-calendar-prev]').addEventListener('click', () => { month = new Date(month.getFullYear(), month.getMonth() - 1, 1); renderCalendar(); });
    get<HTMLButtonElement>('[data-calendar-next]').addEventListener('click', () => { month = new Date(month.getFullYear(), month.getMonth() + 1, 1); renderCalendar(); });
    timezone.addEventListener('change', () => { render(); });
    void load().catch((error) => { const message = error instanceof Error ? error.message : '進行管理を読み込めませんでした。'; tasks.textContent = message; events.textContent = message; reports.textContent = message; calendarTitle.textContent = '読み込めませんでした'; showError(message); });
  };
  document.addEventListener('astro:page-load', initializeOperations);
  initializeOperations();
</script>
