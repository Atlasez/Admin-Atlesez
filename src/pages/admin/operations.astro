    const refreshReminderRows = (container: HTMLElement) => container.querySelectorAll<HTMLElement>('[data-task-reminder-row]').forEach(refreshReminderRow);
    const collectReminderRows = (container: HTMLElement, repeat: string) => [...container.querySelectorAll<HTMLElement>('[data-task-reminder-row]')].map((row) => {
      const kind = row.querySelector<HTMLSelectElement>('[data-reminder-kind]')?.value || 'before_days';
      const amount = row.querySelector<HTMLInputElement>('[data-reminder-amount]')?.value || '';
      const start = row.querySelector<HTMLInputElement>('[data-reminder-start]')?.value || '09:00';
      const remindAt = row.querySelector<HTMLInputElement>('[data-reminder-at]')?.value || '';
      if (kind === 'before_days' || kind === 'before_hours') return amount ? { kind: 'before', amount: Number(amount), unit: kind === 'before_days' ? 'days' : 'hours' } : null;
      if (kind === 'due_day_hourly') return { kind: 'due_day_hourly', start };
      return { kind: 'absolute', remindAt, timezone: row.querySelector<HTMLInputElement>('[data-reminder-timezone]')?.value || taskDueTimezone.value || 'Asia/Tokyo', repeat, label: '指定日時' };
    }).filter((row) => row !== null && (row.kind !== 'absolute' || row.remindAt));
    const taskReminderRules = (item: Record<string, any>): ReminderRule[] => {
      const rules = Array.isArray(item.reminders) ? item.reminders as ReminderRule[] : [];
      if (rules.length) return rules;
      return item.reminder_at ? [{ remind_at: String(item.reminder_at), relative_kind: 'absolute', repeat: String(item.reminder_repeat || 'none') }] : [];
    };
    const taskReminderEditor = (item: Record<string, any>) => {
      const rules = taskReminderRules(item);
      const repeat = String(item.reminder_repeat || rules[0]?.repeat || 'none');
      const rows = rules.map((rule) => reminderRowHtml(rule)).join('') || '<p class="reminder-empty">リマインダーは設定されていません。</p>';
      return `<details class="task-reminder-editor"><summary>リマインダーを確認・編集（${rules.length}件）</summary><div data-reminder-editor="${escapeHtml(String(item.id))}"><p class="reminder-editor-note">期限基準の相対指定は保存時に日時へ展開されます。メール欄が空欄なら通知ベルに表示します。</p><div class="task-reminder-rules">${rows}</div><button type="button" class="secondary-button" data-add-reminder>リマインダーを追加</button><label class="field-label">指定日時の繰り返し<select data-reminder-repeat><option value="none" ${selected(repeat, 'none')}>1回</option><option value="daily" ${selected(repeat, 'daily')}>毎日</option><option value="weekly" ${selected(repeat, 'weekly')}>毎週</option><option value="monthly" ${selected(repeat, 'monthly')}>毎月</option></select></label><label class="field-label">自分の通知先メールアドレス（任意）<input type="email" maxlength="254" data-reminder-email value="${escapeHtml(String(item.reminder_email || ''))}" placeholder="自分のメールアドレス" /></label><button type="button" data-save-reminders>このタスクの設定を保存</button><output class="operation-feedback" data-reminder-feedback aria-live="polite"></output></div></details>`;
    };
    populateTimezones();
    const api = async <T,>(url: string, method = 'GET', body?: unknown): Promise<T> => {
      const response = await fetch(url, { method, credentials: 'same-origin', cache: 'no-store', headers: body === undefined ? {} : { 'content-type': 'application/json' }, body: body === undefined ? undefined : JSON.stringify(body) });
      const contentType = response.headers.get('content-type') ?? '';
      const data = contentType.includes('application/json') ? await response.json() as T & { error?: string } : null;
      if (!response.ok || !data) throw new Error(data?.error ?? '認証情報を確認できませんでした。ページを再読み込みしてください。');
      return data;
    };
    let data: OperationData = { scope: { isManager: false } };
    let month = new Date(); month = new Date(month.getFullYear(), month.getMonth(), 1);
    let calendarSelectionStart = '';
    let calendarSelectionEnd = '';
    try { const local = Intl.DateTimeFormat().resolvedOptions().timeZone; if (local) timezone.value = local; } catch { /* 既定の日本時間を使う */ }
    const selectedTimezone = () => {
      const candidate = timezone.value.trim() || 'Asia/Tokyo';
      try { new Intl.DateTimeFormat('en', { timeZone: candidate }).format(); return candidate; } catch { return 'Asia/Tokyo'; }
    };
    const renderTimezoneOffset = () => {
      try {
        const part = new Intl.DateTimeFormat('en', { timeZone: selectedTimezone(), timeZoneName: 'longOffset' }).formatToParts(new Date()).find((item) => item.type === 'timeZoneName')?.value || 'GMT';
        timezoneOffset.value = part === 'GMT' ? 'UTC+00:00' : part.replace(/^GMT/, 'UTC');
      } catch { timezoneOffset.value = ''; }
    };
    const formatDate = (value: string) => new Intl.DateTimeFormat('ja-JP', { dateStyle: 'medium', timeStyle: 'short', timeZone: selectedTimezone() }).format(new Date(value));
    const dateParts = (value: string) => Object.fromEntries(new Intl.DateTimeFormat('en-CA', { timeZone: selectedTimezone(), year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', hour12: false }).formatToParts(new Date(value)).filter((part) => part.type !== 'literal').map((part) => [part.type, part.value]));
    const participantNames = (participants: OperationParticipant[], availability: string) => participants.filter((participant) => participant.availability === availability).map((participant) => participant.isSelf ? '自分' : participant.displayName);
    const availabilitySummary = (context: string, participants: OperationParticipant[], counts?: Record<string, number>) => {
      const available = participantNames(participants, 'available');
      const maybe = participantNames(participants, 'maybe');
      const unavailable = participantNames(participants, 'unavailable');
      const availableCount = counts?.available ?? available.length;
      const maybeCount = counts?.maybe ?? maybe.length;
      const unavailableCount = counts?.unavailable ?? unavailable.length;
      if (!availableCount && !maybeCount && !unavailableCount) return '';
      const countMarkup = `${availableCount ? `<span class="availability-count-available">○${availableCount}</span>` : ''}${maybeCount ? `<span class="availability-count-maybe">△${maybeCount}</span>` : ''}${unavailableCount ? `<span class="availability-count-unavailable">×${unavailableCount}</span>` : ''}`;
      return `<button type="button" class="availability-summary-trigger" data-availability-summary aria-haspopup="dialog" aria-label="${escapeHtml(context)}。クリックまたは右クリックでメンバーを表示" data-summary-title="${escapeHtml(context)}" data-available-members="${escapeHtml(JSON.stringify(available))}" data-maybe-members="${escapeHtml(JSON.stringify(maybe))}" data-unavailable-members="${escapeHtml(JSON.stringify(unavailable))}">${countMarkup}</button>`;
    };
    const dayParticipants = (blocks: AvailabilityBlock[]): OperationParticipant[] => {
      const byMember = new Map<string, AvailabilityBlock>();
      for (const block of blocks) {
        const memberKey = (block.email || block.display_name || block.id).toLowerCase();
        const current = byMember.get(memberKey);
        if (!current || (current.kind === 'available' && block.kind === 'unavailable')) byMember.set(memberKey, block);
      }
      return [...byMember.values()].map((block) => ({ displayName: block.display_name || '表示名未設定', availability: block.kind, isSelf: Boolean(block.isSelf) }));
    };
    const calendarEvents = () => {
      const storedEvents = data.events ?? [];
      if (memberPage) return storedEvents;
      if (projectId !== 'atlas') return storedEvents;
      const storedIds = new Set(storedEvents.map((event) => event.id));
      const storedCoWorkingTimes = new Set(storedEvents.filter((event) => event.title.includes('同時作業会')).map((event) => new Date(event.starts_at).getTime()));
      const recurringEvents: OperationEvent[] = recurringCoWorkingEventsForMonth(month.getFullYear(), month.getMonth()).filter((event) => !storedIds.has(event.id) && !storedCoWorkingTimes.has(new Date(event.starts_at).getTime()));
      return [...storedEvents, ...recurringEvents];
    };
    const renderCalendar = () => {
      const first = new Date(month.getFullYear(), month.getMonth(), 1), last = new Date(month.getFullYear(), month.getMonth() + 1, 0);
      const selectedRegions = [...holidayCountry.selectedOptions].map((option) => option.value);
      const holidays = holidaysForRegions(selectedRegions, month.getFullYear());
      const calendarFormatter = new Intl.DateTimeFormat(`ja-JP-u-ca-${calendarSystem.value || 'gregory'}`, { year: 'numeric', month: 'long' });
      const dayFormatter = new Intl.DateTimeFormat(`ja-JP-u-ca-${calendarSystem.value || 'gregory'}`, { day: 'numeric' });
      calendarTitle.textContent = calendarFormatter.format(first);
      const cells = ['日','月','火','水','木','金','土'].map((day) => `<div class="calendar-cell calendar-cell--blank"><div class="calendar-cell-header"><span class="calendar-day">${day}</span></div></div>`);
      for (let index = 0; index < first.getDay(); index += 1) cells.push('<div class="calendar-cell calendar-cell--blank"></div>');
      const visibleEvents = calendarEvents();
      for (let day = 1; day <= last.getDate(); day += 1) {
        const key = `${month.getFullYear()}-${String(month.getMonth() + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
        const dayEvents = visibleEvents.filter((event) => { const parts = dateParts(event.starts_at); return `${parts.year}-${parts.month}-${parts.day}` === key; });
        const dayHolidays = holidays.filter((holiday) => holiday.date === key);
        const nextDate = new Date(`${key}T00:00:00Z`); nextDate.setUTCDate(nextDate.getUTCDate() + 1);
        const dayStart = localDateTimeToInstant(`${key}T00:00`, selectedTimezone());
        const dayEnd = localDateTimeToInstant(`${nextDate.toISOString().slice(0, 10)}T00:00`, selectedTimezone());
        const dayBlocks = (data.availabilityBlocks ?? []).filter((block) => new Date(block.starts_at) < new Date(dayEnd) && new Date(block.ends_at) > new Date(dayStart));
        const participants = dayParticipants(dayBlocks);
        const dateLabel = `${month.getFullYear()}年${month.getMonth() + 1}月${day}日`;
        const eventMarkup = dayEvents.map((event) => { const parts = dateParts(event.starts_at); return `<span class="calendar-event" data-calendar-event-id="${escapeHtml(event.id)}" title="${escapeHtml(event.title)}"><span>${parts.hour}:${parts.minute} ${escapeHtml(event.title)}</span>${availabilitySummary(`${event.title}の参加状況`, event.participants ?? [], event.availabilityCounts)}</span>`; }).join('');
        cells.push(`<div class="calendar-cell${dayHolidays.length ? ' calendar-cell--holiday' : ''}" data-calendar-date="${key}"><div class="calendar-cell-header" data-calendar-date-header><button type="button" class="calendar-date-select" data-calendar-select aria-label="${escapeHtml(dateLabel)}を可否期間に選択"><span class="calendar-day">${escapeHtml(dayFormatter.format(new Date(month.getFullYear(), month.getMonth(), day)))}</span></button></div><div class="calendar-cell-content">${dayHolidays.map((holiday) => `<span class="calendar-holiday" title="${escapeHtml(holiday.regionName)}">${escapeHtml(holiday.region)}: ${escapeHtml(holiday.name)}</span>`).join('')}${eventMarkup}${availabilitySummary(`${dateLabel}の対応可否`, participants)}</div></div>`);
      }
      calendar.innerHTML = cells.join('');
      const today = dateParts(new Date().toISOString());
      const todayKey = `${today.year}-${today.month}-${today.day}`;
      const orderedSelection = calendarSelectionStart && calendarSelectionEnd ? [calendarSelectionStart, calendarSelectionEnd].sort() : [];
      calendar.querySelectorAll<HTMLElement>('[data-calendar-date]').forEach((cell) => {
        const key = cell.dataset.calendarDate ?? '';
        cell.classList.toggle('calendar-cell--today', key === todayKey);
        if (key === todayKey) cell.setAttribute('aria-current', 'date');
