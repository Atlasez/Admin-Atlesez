<script>
  import { holidaysForRegions, localDateTimeToInstant, supportedHolidayRegions } from '../../lib/calendar-support';
  type OperationMember = { email: string; display_name?: string };
  type OperationEvent = { id: string; title: string; starts_at: string; ends_at?: string | null; availability?: string | null; availabilityCounts?: Record<string, number>; participants?: Array<{ displayName: string; availability: string; isSelf: boolean }> };
  type ReminderRule = { id?: string; remind_at?: string; timezone?: string; label?: string; relative_kind?: string; relative_amount?: number | null; relative_unit?: string | null; relative_start?: string | null; repeat?: string | null };
  type AvailabilityBlock = { id: string; email?: string; display_name?: string; starts_at: string; ends_at: string; timezone: string; label?: string; kind: 'available' | 'unavailable'; isSelf?: boolean };
  type OperationData = { scope: { isManager: boolean; email?: string }; project?: { id: string; slug: string; name: string }; tasks?: Array<Record<string, any>>; events?: OperationEvent[]; progress?: Array<Record<string, any>>; members?: OperationMember[]; availabilityBlocks?: AvailabilityBlock[] };
  const initializeOperations = () => {
    const root = document.querySelector<HTMLElement>('[data-operations]');
    if (!root || root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';
    root.querySelectorAll<HTMLAnchorElement>('[data-calendar-tab]').forEach((tab) => tab.addEventListener('click', (event) => {
      event.preventDefault();
      const view = tab.dataset.calendarTab === 'settings' ? 'settings' : 'agenda';
      root.dataset.calendarView = view;
      root.querySelectorAll<HTMLAnchorElement>('[data-calendar-tab]').forEach((item) => item.setAttribute('aria-current', item === tab ? 'page' : 'false'));
      history.replaceState(null, '', tab.href);
    }));
    const taskSection = Array.from(root.querySelectorAll<HTMLElement>('.grid > section')).find((section) => section.querySelector('h2')?.textContent?.trim() === 'タスク作成・依頼');
    if (taskSection) {
      const description = taskSection.querySelector('p');
      if (description) description.textContent = '表示対象を切り替えると、このフォームの下にあるタスク一覧が変わります。';
    }
    const get = <T extends Element>(selector: string) => root.querySelector<T>(selector)!;
    const progress = get<HTMLTextAreaElement>('[data-progress]');
    const tasks = get<HTMLElement>('[data-task-list]');
    const events = get<HTMLElement>('[data-event-list]');
    const reports = get<HTMLElement>('[data-progress-list]');
    const assignee = get<HTMLSelectElement>('[data-task-assignee]');
    const calendar = get<HTMLElement>('[data-event-calendar]');
    const calendarTitle = get<HTMLElement>('[data-calendar-title]');
    const timezone = get<HTMLInputElement>('[data-calendar-timezone]');
    const holidayCountry = get<HTMLSelectElement>('[data-calendar-holiday-country]');
    const holidayTags = get<HTMLElement>('[data-holiday-tags]');
    const holidayAdd = get<HTMLButtonElement>('[data-holiday-add]');
    const timezoneOptions = get<HTMLElement>('[data-timezone-options]');
    const timezoneToggle = get<HTMLButtonElement>('[data-timezone-toggle]');
    const blockEditor = get<HTMLDetailsElement>('[data-block-editor]');
    const blockAllDay = get<HTMLInputElement>('[data-block-all-day]');
    const calendarSystem = get<HTMLSelectElement>('[data-calendar-system]');
    const taskDue = get<HTMLInputElement>('[data-task-due]');
    const taskDueTimezone = get<HTMLSelectElement>('[data-task-due-timezone]');
    const taskReminderList = get<HTMLElement>('[data-task-reminder-list]');
    const taskReminderEmail = get<HTMLInputElement>('[data-task-reminder-email]');
    const taskReminderRepeat = get<HTMLSelectElement>('[data-task-reminder-repeat]');
    const progressFeedback = get<HTMLOutputElement>('[data-progress-feedback]');
    const taskFeedback = get<HTMLOutputElement>('[data-task-feedback]');
    const eventFeedback = get<HTMLOutputElement>('[data-event-feedback]');
    const blockFeedback = get<HTMLOutputElement>('[data-block-feedback]');
    const projectTitle = get<HTMLElement>('[data-project-title]');
    const projectId = new URLSearchParams(location.search).get('project') || 'atlas';
    const calendarPage = location.pathname.replace(/\/$/, '') === '/admin/calendar';
    let taskFilter: 'assigned' | 'created' | 'all' = 'assigned';
    const renderHolidayTags = () => {
      holidayTags.innerHTML = [...holidayCountry.selectedOptions].map((option) => `<button type="button" data-remove-holiday="${escapeHtml(option.value)}" aria-label="${escapeHtml(option.textContent || option.value)}を外す">${escapeHtml(option.textContent || option.value)} ×</button>`).join('') || '<span>祝日を表示しない</span>';
    };
    holidayAdd.addEventListener('click', () => {
      const opening = !holidayCountry.closest('.holiday-picker')?.classList.contains('is-open');
      holidayCountry.closest('.holiday-picker')?.classList.toggle('is-open', opening);
      holidayAdd.setAttribute('aria-expanded', String(opening));
    });
    holidayTags.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-remove-holiday]');
      if (!button) return;
      const option = [...holidayCountry.options].find((item) => item.value === button.dataset.removeHoliday);
      if (option) option.selected = false;
      renderHolidayTags();
      renderCalendar();
    });
    const populateTimezones = () => {
      const values = typeof Intl.supportedValuesOf === 'function' ? Intl.supportedValuesOf('timeZone') : [];
      const fallbackValues = [...root.querySelectorAll<HTMLOptionElement>('#atlasez-timezone-datalist option')].map((option) => option.value);
      const allValues = [...new Set(['UTC', ...(values.length ? values : fallbackValues)])];
      const datalist = root.querySelector<HTMLDataListElement>('#atlasez-timezone-datalist');
      if (datalist) datalist.innerHTML = allValues.map((value) => `<option value="${escapeHtml(value)}" label="${escapeHtml(value.replaceAll('_', ' / '))}"></option>`).join('');
      root.querySelectorAll<HTMLSelectElement>('[data-task-due-timezone]').forEach((select) => {
        const current = select.value || 'Asia/Tokyo';
        select.innerHTML = allValues.map((value) => `<option value="${escapeHtml(value)}">${escapeHtml(value.replaceAll('_', ' / '))}</option>`).join('');
        select.value = allValues.includes(current) ? current : 'Asia/Tokyo';
      });
      root.querySelectorAll<HTMLInputElement>('[data-event-timezone]').forEach((input) => input.setAttribute('list', 'atlasez-timezone-datalist'));
      const renderTimezoneOptions = () => {
        const query = timezone.value.trim().toLocaleLowerCase();
        timezoneOptions.innerHTML = allValues.filter((value) => !query || value.toLocaleLowerCase().includes(query)).slice(0, 80).map((value) => `<button type="button" role="option" data-timezone-value="${escapeHtml(value)}">${escapeHtml(value.replaceAll('_', ' / '))}</button>`).join('');
      };
      timezone.addEventListener('input', () => { renderTimezoneOptions(); timezoneOptions.hidden = false; timezone.setAttribute('aria-expanded', 'true'); });
      timezoneToggle.addEventListener('click', () => { timezoneOptions.hidden = !timezoneOptions.hidden; timezone.setAttribute('aria-expanded', String(!timezoneOptions.hidden)); renderTimezoneOptions(); });
      timezoneOptions.addEventListener('click', (event) => { const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-timezone-value]'); if (!button) return; timezone.value = button.dataset.timezoneValue ?? 'UTC'; timezoneOptions.hidden = true; timezone.setAttribute('aria-expanded', 'false'); render(); });
      renderTimezoneOptions();
      const selectedRegions = new Set([...holidayCountry.selectedOptions].map((option) => option.value));
      holidayCountry.innerHTML = supportedHolidayRegions().map((region) => `<option value="${escapeHtml(region.code)}" ${selectedRegions.has(region.code) ? 'selected' : ''}>${escapeHtml(region.name)}（${escapeHtml(region.code)}）</option>`).join('');
    };
    const escapeHtml = (value: string) => value.replace(/[&<>"']/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[character] ?? character);
    renderHolidayTags();
    const selected = (actual: string, expected: string) => actual === expected ? 'selected' : '';
    const reminderKind = (rule: ReminderRule) => rule.relative_kind === 'before' ? (rule.relative_unit === 'hours' ? 'before_hours' : 'before_days') : rule.relative_kind === 'due_day_hourly' ? 'due_day_hourly' : 'absolute';
    const reminderRowHtml = (rule: ReminderRule = {}) => {
      const kind = reminderKind(rule);
      return `<div class="task-reminder-row" data-task-reminder-row><label class="field-label">種類<select data-reminder-kind><option value="before_days" ${selected(kind, 'before_days')}>N日前</option><option value="before_hours" ${selected(kind, 'before_hours')}>N時間前</option><option value="due_day_hourly" ${selected(kind, 'due_day_hourly')}>当日毎時</option><option value="absolute" ${selected(kind, 'absolute')}>指定日時</option></select></label><label class="field-label" data-reminder-amount-label>数量<input data-reminder-amount type="number" min="1" max="8760" value="${escapeHtml(String(rule.relative_amount ?? ''))}" placeholder="N" /></label><label class="field-label" data-reminder-start-label>開始時刻<input data-reminder-start type="time" value="${escapeHtml(String(rule.relative_start || '09:00'))}" /></label><label class="field-label" data-reminder-at-label>日時<input data-reminder-at type="datetime-local" value="${escapeHtml(String(rule.remind_at || ''))}" /></label><button type="button" class="task-reminder-remove" data-remove-reminder>削除</button></div>`;
    };
    const refreshReminderRow = (row: HTMLElement) => {
      const kind = row.querySelector<HTMLSelectElement>('[data-reminder-kind]')?.value || 'before_days';
      const amount = row.querySelector<HTMLElement>('[data-reminder-amount-label]');
      const start = row.querySelector<HTMLElement>('[data-reminder-start-label]');
      const at = row.querySelector<HTMLElement>('[data-reminder-at-label]');
      if (amount) amount.hidden = kind !== 'before_days' && kind !== 'before_hours';
      if (start) start.hidden = kind !== 'due_day_hourly';
      if (at) at.hidden = kind !== 'absolute';
    };
    const refreshReminderRows = (container: HTMLElement) => container.querySelectorAll<HTMLElement>('[data-task-reminder-row]').forEach(refreshReminderRow);
    const collectReminderRows = (container: HTMLElement, repeat: string) => [...container.querySelectorAll<HTMLElement>('[data-task-reminder-row]')].map((row) => {
      const kind = row.querySelector<HTMLSelectElement>('[data-reminder-kind]')?.value || 'before_days';
      const amount = row.querySelector<HTMLInputElement>('[data-reminder-amount]')?.value || '';
      const start = row.querySelector<HTMLInputElement>('[data-reminder-start]')?.value || '09:00';
      const remindAt = row.querySelector<HTMLInputElement>('[data-reminder-at]')?.value || '';
      if (kind === 'before_days' || kind === 'before_hours') return amount ? { kind: 'before', amount: Number(amount), unit: kind === 'before_days' ? 'days' : 'hours' } : null;
      if (kind === 'due_day_hourly') return { kind: 'due_day_hourly', start };
      return { kind: 'absolute', remindAt, timezone: taskDueTimezone.value || 'Asia/Tokyo', repeat, label: '指定日時' };
    }).filter((row) => row !== null && (row.kind !== 'absolute' || row.remindAt));
    const taskReminderRules = (item: Record<string, any>): ReminderRule[] => {
      const rules = Array.isArray(item.reminders) ? item.reminders as ReminderRule[] : [];
      if (rules.length) return rules;
      return item.reminder_at ? [{ remind_at: String(item.reminder_at), relative_kind: 'absolute', repeat: String(item.reminder_repeat || 'none') }] : [];
    };
    const taskReminderEditor = (item: Record<string, any>) => {
      const rules = taskReminderRules(item);
      const repeat = String(item.reminder_repeat || rules[0]?.repeat || 'none');
      const rows = rules.map((rule) => reminderRowHtml(rule)).join('') || '<p class="reminder-empty">リマインダーは設定されていません。</p>';
      return `<details class="task-reminder-editor"><summary>リマインダーを確認・編集（${rules.length}件）</summary><div data-reminder-editor="${escapeHtml(String(item.id))}"><p class="reminder-editor-note">期限基準の相対指定は保存時に日時へ展開されます。メール欄が空欄なら通知ベルに表示します。</p><div class="task-reminder-rules">${rows}</div><button type="button" class="secondary-button" data-add-reminder>リマインダーを追加</button><label class="field-label">指定日時の繰り返し<select data-reminder-repeat><option value="none" ${selected(repeat, 'none')}>1回</option><option value="daily" ${selected(repeat, 'daily')}>毎日</option><option value="weekly" ${selected(repeat, 'weekly')}>毎週</option><option value="monthly" ${selected(repeat, 'monthly')}>毎月</option></select></label><label class="field-label">自分の通知先メールアドレス（任意）<input type="email" maxlength="254" data-reminder-email value="${escapeHtml(String(item.reminder_email || ''))}" placeholder="自分のメールアドレス" /></label><button type="button" data-save-reminders>このタスクの設定を保存</button><output class="operation-feedback" data-reminder-feedback aria-live="polite"></output></div></details>`;
    };
    populateTimezones();
    const api = async <T,>(url: string, method = 'GET', body?: unknown): Promise<T> => {
      const response = await fetch(url, { method, credentials: 'same-origin', cache: 'no-store', headers: body === undefined ? {} : { 'content-type': 'application/json' }, body: body === undefined ? undefined : JSON.stringify(body) });
      const contentType = response.headers.get('content-type') ?? '';
      const data = contentType.includes('application/json') ? await response.json() as T & { error?: string } : null;
      if (!response.ok || !data) throw new Error(data?.error ?? '認証情報を確認できませんでした。ページを再読み込みしてください。');
      return data;
    };
    let data: OperationData = { scope: { isManager: false } };
    let month = new Date(); month = new Date(month.getFullYear(), month.getMonth(), 1);
    let calendarSelectionStart = '';
    let calendarSelectionEnd = '';
    try { const local = Intl.DateTimeFormat().resolvedOptions().timeZone; if (local) timezone.value = local; } catch { /* 既定の日本時間を使う */ }
    const selectedTimezone = () => {
      const candidate = timezone.value.trim() || 'Asia/Tokyo';
      try { new Intl.DateTimeFormat('en', { timeZone: candidate }).format(); return candidate; } catch { return 'Asia/Tokyo'; }
    };
    const formatDate = (value: string) => new Intl.DateTimeFormat('ja-JP', { dateStyle: 'medium', timeStyle: 'short', timeZone: selectedTimezone() }).format(new Date(value));
    const dateParts = (value: string) => Object.fromEntries(new Intl.DateTimeFormat('en-CA', { timeZone: selectedTimezone(), year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', hour12: false }).formatToParts(new Date(value)).filter((part) => part.type !== 'literal').map((part) => [part.type, part.value]));
    const renderCalendar = () => {
      const first = new Date(month.getFullYear(), month.getMonth(), 1), last = new Date(month.getFullYear(), month.getMonth() + 1, 0);
      const selectedRegions = [...holidayCountry.selectedOptions].map((option) => option.value);
      const holidays = holidaysForRegions(selectedRegions, month.getFullYear());
      const calendarFormatter = new Intl.DateTimeFormat(`ja-JP-u-ca-${calendarSystem.value || 'gregory'}`, { year: 'numeric', month: 'long' });
      const dayFormatter = new Intl.DateTimeFormat(`ja-JP-u-ca-${calendarSystem.value || 'gregory'}`, { day: 'numeric' });
      calendarTitle.textContent = calendarFormatter.format(first);
      const cells = ['日','月','火','水','木','金','土'].map((day) => `<div class="calendar-cell calendar-cell--blank"><span class="calendar-day">${day}</span></div>`);
      for (let index = 0; index < first.getDay(); index += 1) cells.push('<div class="calendar-cell calendar-cell--blank"></div>');
      for (let day = 1; day <= last.getDate(); day += 1) {
        const key = `${month.getFullYear()}-${String(month.getMonth() + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
        const dayEvents = (data.events ?? []).filter((event) => { const parts = dateParts(event.starts_at); return `${parts.year}-${parts.month}-${parts.day}` === key; });
        const dayHolidays = holidays.filter((holiday) => holiday.date === key);
        const nextDate = new Date(`${key}T00:00:00Z`); nextDate.setUTCDate(nextDate.getUTCDate() + 1);
        const dayStart = localDateTimeToInstant(`${key}T00:00`, selectedTimezone());
        const dayEnd = localDateTimeToInstant(`${nextDate.toISOString().slice(0, 10)}T00:00`, selectedTimezone());
        const dayBlocks = (data.availabilityBlocks ?? []).filter((block) => new Date(block.starts_at) < new Date(dayEnd) && new Date(block.ends_at) > new Date(dayStart));
        cells.push(`<button type="button" class="calendar-cell${dayHolidays.length ? ' calendar-cell--holiday' : ''}" data-calendar-date="${key}"><span class="calendar-day">${escapeHtml(dayFormatter.format(new Date(month.getFullYear(), month.getMonth(), day)))}</span>${dayHolidays.map((holiday) => `<span class="calendar-holiday" title="${escapeHtml(holiday.regionName)}">${escapeHtml(holiday.region)}: ${escapeHtml(holiday.name)}</span>`).join('')}${dayEvents.map((event) => { const parts = dateParts(event.starts_at); return `<span class="calendar-event" title="${escapeHtml(event.title)}">${parts.hour}:${parts.minute} ${escapeHtml(event.title)}</span>`; }).join('')}${dayBlocks.map((block) => `<span class="calendar-availability calendar-availability--${block.kind}">${escapeHtml(block.isSelf ? '自分' : block.display_name || 'メンバー')}：${block.kind === 'available' ? '動ける' : '動けない'}</span>`).join('')}</button>`);
      }
      calendar.innerHTML = cells.join('');
      const today = dateParts(new Date().toISOString());
      const todayKey = `${today.year}-${today.month}-${today.day}`;
      const orderedSelection = calendarSelectionStart && calendarSelectionEnd ? [calendarSelectionStart, calendarSelectionEnd].sort() : [];
      calendar.querySelectorAll<HTMLElement>('[data-calendar-date]').forEach((cell) => {
        const key = cell.dataset.calendarDate ?? '';
        cell.classList.toggle('calendar-cell--today', key === todayKey);
        cell.classList.toggle('calendar-cell--selected', orderedSelection.length === 2 && key >= orderedSelection[0] && key <= orderedSelection[1]);
      });
    };
    const render = () => {
      const members = new Map((data.members ?? []).map((member) => [member.email, member.display_name || '表示名未設定']));
      projectTitle.textContent = `${data.project?.name || 'プロジェクト'}：${calendarPage ? 'カレンダー' : 'タスク管理'}`;
      get<HTMLElement>('[data-event-create]').hidden = !data.scope.isManager;
      assignee.innerHTML = '<option value="">担当者を指定しない</option>' + (data.members ?? []).map((member) => `<option value="${escapeHtml(member.email)}">${escapeHtml(member.display_name || '表示名未設定')}</option>`).join('');
      reports.innerHTML = (data.progress ?? []).map((item) => `<article class="item"><span>${escapeHtml(String(item.body ?? ''))}</span><small>自分が投げた進捗報告 ・ ${formatDate(String(item.created_at))}</small></article>`).join('') || '<p>自分が投げた進捗報告はまだありません。</p>';
      const visibleTasks = (data.tasks ?? []).filter((item) => taskFilter === 'all' || (taskFilter === 'assigned' ? item.assignee_email === data.scope.email : item.created_by === data.scope.email));
      tasks.innerHTML = visibleTasks.map((item) => `<article class="item"><div class="task-row"><b>${escapeHtml(String(item.title ?? ''))}</b><select aria-label="${escapeHtml(String(item.title ?? 'タスク'))}の状態" data-task-status="${escapeHtml(String(item.id))}"><option value="open" ${item.status === 'open' ? 'selected' : ''}>未着手</option><option value="doing" ${item.status === 'doing' ? 'selected' : ''}>進行中</option><option value="done" ${item.status === 'done' ? 'selected' : ''}>完了</option></select></div><small><span class="task-role">${item.assignee_email === data.scope.email ? '自分がこなす' : item.created_by === data.scope.email ? '自分が依頼' : 'すべて'}</span> ${escapeHtml(String(item.subject || '全体'))}${item.assignee_email ? ` ・担当：${escapeHtml(members.get(String(item.assignee_email)) || '表示名未設定')}` : ' ・担当未指定'}${item.created_by ? ` ・依頼者：${escapeHtml(String(item.created_by === data.scope.email ? '自分' : item.created_by))}` : ''}${item.due_at ? ` ・期限：${escapeHtml(String(item.due_at).replace('T',' '))}（${escapeHtml(String(item.due_timezone || 'Asia/Tokyo'))}）` : ''}</small>${item.details ? `<small>${escapeHtml(String(item.details))}</small>` : ''}${taskReminderEditor(item)}</article>`).join('') || '<p>この条件のタスクはありません。</p>';
      tasks.querySelectorAll('small').forEach((small) => {
        small.childNodes.forEach((node) => {
          if (node.nodeType !== Node.TEXT_NODE || !node.textContent?.includes('依頼者：')) return;
          for (const [memberEmail, memberName] of members) node.textContent = node.textContent.replace(memberEmail, memberName);
        });
      });
      const availabilityLabels: Record<string, string> = { available: '参加できる', maybe: '未定', unavailable: '参加できない' };
      events.innerHTML = (data.events ?? []).map((item) => { const counts = item.availabilityCounts ?? {}; const participants = item.participants ?? []; return `<article class="item"><div class="event-heading"><b>${escapeHtml(item.title)}</b>${data.scope.isManager ? `<button type="button" class="event-delete" data-delete-event="${escapeHtml(item.id)}">この日程を削除</button>` : ''}</div><small>${formatDate(item.starts_at)}${item.ends_at ? ` 〜 ${formatDate(item.ends_at)}` : ''}</small><div class="availability">${Object.entries(availabilityLabels).map(([value, label]) => `<button type="button" class="${item.availability === value ? 'is-selected' : ''}" aria-pressed="${item.availability === value}" data-availability="${value}" data-event="${escapeHtml(item.id)}">${label}${item.availability === value ? ' ✓' : ''}</button>`).join('')}</div><div class="participant-summary"><div class="participant-counts"><span>参加 ${counts.available ?? 0}</span><span>未定 ${counts.maybe ?? 0}</span><span>不参加 ${counts.unavailable ?? 0}</span></div><div class="participant-names">${participants.length ? participants.map((participant) => `<span class="participant-chip participant-${escapeHtml(participant.availability)}">${escapeHtml(participant.isSelf ? '自分' : participant.displayName)}：${escapeHtml(availabilityLabels[participant.availability] ?? participant.availability)}</span>`).join('') : '<span>まだ参加登録はありません。</span>'}</div></div></article>`; }).join('') || '<p>登録された日程はありません。</p>';
      const blocks = data.availabilityBlocks ?? [];
      const ownBlocks = blocks.filter((item) => item.isSelf);
      get<HTMLElement>('[data-block-list]').innerHTML = ownBlocks.length ? ownBlocks.map((item) => `<div class="item availability-block-item"><span><b>${item.kind === 'available' ? '動ける' : '動けない'}</b> ・ ${formatDate(item.starts_at)} 〜 ${formatDate(item.ends_at)}${item.label ? ` ・ ${escapeHtml(String(item.label))}` : ''}</span><button type="button" class="event-delete" data-delete-block="${escapeHtml(String(item.id))}">削除</button></div>`).join('') : '<p>登録した可否期間はありません。</p>';
      renderCalendar();
    };
    const load = async () => { data = await api<OperationData>(`/api/admin/operations?project=${encodeURIComponent(projectId)}`); render(); };
    const runButtonAction = async (button: HTMLButtonElement, feedback: HTMLOutputElement, action: () => Promise<void>, success: string) => { button.disabled = true; feedback.value = '保存中…'; try { await action(); feedback.value = success; await load(); } catch (error) { feedback.value = error instanceof Error ? error.message : '保存できませんでした。'; } finally { button.disabled = false; } };
    get<HTMLButtonElement>('[data-send-progress]').addEventListener('click', (event) => { const button = event.currentTarget as HTMLButtonElement; void runButtonAction(button, progressFeedback, async () => { await api('/api/admin/operations/progress', 'POST', { projectId, body: progress.value }); progress.value = ''; }, '進捗を記録しました。'); });
    get<HTMLButtonElement>('[data-create-task]').addEventListener('click', (event) => { const button = event.currentTarget as HTMLButtonElement; void runButtonAction(button, taskFeedback, async () => { await api('/api/admin/operations/tasks', 'POST', { projectId, title: get<HTMLInputElement>('[data-task-title]').value, subject: get<HTMLSelectElement>('[data-task-subject]').value, assigneeEmail: assignee.value, dueAt: taskDue.value, dueTimezone: taskDueTimezone.value, details: get<HTMLTextAreaElement>('[data-task-details]').value, reminders: collectReminderRows(taskReminderList, taskReminderRepeat.value), reminderRepeat: taskReminderRepeat.value, reminderEmail: taskReminderEmail.value }); taskDue.value = ''; }, 'タスクを追加しました。'); });
    get<HTMLButtonElement>('[data-add-task-reminder]').addEventListener('click', () => { taskReminderList.insertAdjacentHTML('beforeend', reminderRowHtml()); refreshReminderRows(taskReminderList); });
    refreshReminderRows(taskReminderList);
    root.addEventListener('change', (event) => { const row = (event.target as HTMLElement).closest<HTMLElement>('[data-task-reminder-row]'); if (row) refreshReminderRow(row); });
    root.addEventListener('click', (event) => { const target = event.target as HTMLElement; const remove = target.closest<HTMLButtonElement>('[data-remove-reminder]'); if (remove) { remove.closest<HTMLElement>('[data-task-reminder-row]')?.remove(); return; } const add = target.closest<HTMLButtonElement>('[data-add-reminder]'); if (add) { const container = add.closest<HTMLElement>('[data-reminder-editor]')?.querySelector<HTMLElement>('.task-reminder-rules'); if (container) { container.insertAdjacentHTML('beforeend', reminderRowHtml()); refreshReminderRows(container); } return; } const save = target.closest<HTMLButtonElement>('[data-save-reminders]'); if (!save) return; const editor = save.closest<HTMLElement>('[data-reminder-editor]'); if (!editor) return; const feedback = editor.querySelector<HTMLOutputElement>('[data-reminder-feedback]'); const repeat = editor.querySelector<HTMLSelectElement>('[data-reminder-repeat]')?.value || 'none'; const email = editor.querySelector<HTMLInputElement>('[data-reminder-email]')?.value || ''; const reminderContainer = editor.querySelector<HTMLElement>('.task-reminder-rules'); if (!feedback || !reminderContainer) return; void runButtonAction(save, feedback, async () => { await api(`/api/admin/operations/tasks/${encodeURIComponent(editor.dataset.reminderEditor || '')}`, 'PATCH', { reminderAction: 'replace', reminders: collectReminderRows(reminderContainer, repeat), reminderEmail: email }); }, 'リマインダーを保存しました。'); });
    get<HTMLButtonElement>('[data-create-event]').addEventListener('click', (event) => { const button = event.currentTarget as HTMLButtonElement; void runButtonAction(button, eventFeedback, async () => { const eventTimezone = get<HTMLInputElement>('[data-event-timezone]').value || 'Asia/Tokyo'; await api('/api/admin/operations/events', 'POST', { projectId, title: get<HTMLInputElement>('[data-event-title]').value, startsAt: localDateTimeToInstant(get<HTMLInputElement>('[data-event-start]').value, eventTimezone), endsAt: localDateTimeToInstant(get<HTMLInputElement>('[data-event-end]').value, eventTimezone), details: get<HTMLInputElement>('[data-event-details]').value, timezone: eventTimezone }); }, '日程を追加しました。'); });
    root.querySelectorAll<HTMLButtonElement>('[data-task-filter]').forEach((button) => button.addEventListener('click', () => { taskFilter = (button.dataset.taskFilter as typeof taskFilter) || 'assigned'; root.querySelectorAll<HTMLButtonElement>('[data-task-filter]').forEach((item) => { const active = item === button; item.classList.toggle('is-selected', active); item.setAttribute('aria-pressed', String(active)); }); render(); }));
    get<HTMLButtonElement>('[data-create-block]').addEventListener('click', (event) => { const button = event.currentTarget as HTMLButtonElement; void runButtonAction(button, blockFeedback, async () => { const zone = selectedTimezone(); await api('/api/admin/operations/availability-blocks', 'POST', { startsAt: localDateTimeToInstant(get<HTMLInputElement>('[data-block-start]').value, zone), endsAt: localDateTimeToInstant(get<HTMLInputElement>('[data-block-end]').value, zone), timezone: zone, kind: get<HTMLSelectElement>('[data-block-kind]').value, label: get<HTMLInputElement>('[data-block-label]').value }); }, '可否期間を追加しました。'); });
    tasks.addEventListener('change', (event) => { const select = (event.target as HTMLElement).closest<HTMLSelectElement>('[data-task-status]'); if (!select) return; select.disabled = true; void api(`/api/admin/operations/tasks/${encodeURIComponent(select.dataset.taskStatus ?? '')}`, 'PATCH', { status: select.value }).then(load).catch((error) => { taskFeedback.value = error instanceof Error ? error.message : '状態を更新できませんでした。'; }).finally(() => { select.disabled = false; }); });
    events.addEventListener('click', (event) => { const target = event.target as HTMLElement; const deleteButton = target.closest<HTMLButtonElement>('[data-delete-event]'); if (deleteButton) { if (!confirm('この日程と参加登録を削除しますか？')) return; deleteButton.disabled = true; eventFeedback.value = '日程を削除中…'; void api(`/api/admin/operations/events/${encodeURIComponent(deleteButton.dataset.deleteEvent ?? '')}`, 'DELETE').then(async () => { eventFeedback.value = '日程を削除しました。'; await load(); }).catch((error) => { eventFeedback.value = error instanceof Error ? error.message : '日程を削除できませんでした。'; }).finally(() => { deleteButton.disabled = false; }); return; } const button = target.closest<HTMLButtonElement>('[data-availability]'); if (!button) return; button.disabled = true; eventFeedback.value = '参加状態を保存中…'; void api(`/api/admin/operations/events/${encodeURIComponent(button.dataset.event ?? '')}/availability`, 'PUT', { availability: button.dataset.availability }).then(async () => { eventFeedback.value = '参加状態を保存しました。'; await load(); }).catch((error) => { eventFeedback.value = error instanceof Error ? error.message : '参加状態を保存できませんでした。'; }).finally(() => { button.disabled = false; }); });
    root.querySelector<HTMLElement>('[data-block-list]')!.addEventListener('click', (event) => { const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-delete-block]'); if (!button) return; button.disabled = true; void api(`/api/admin/operations/availability-blocks/${encodeURIComponent(button.dataset.deleteBlock ?? '')}`, 'DELETE').then(load).catch((error) => { blockFeedback.value = error instanceof Error ? error.message : '可否期間を削除できませんでした。'; }).finally(() => { button.disabled = false; }); });
    get<HTMLButtonElement>('[data-calendar-prev]').addEventListener('click', () => { month = new Date(month.getFullYear(), month.getMonth() - 1, 1); renderCalendar(); });
    get<HTMLButtonElement>('[data-calendar-next]').addEventListener('click', () => { month = new Date(month.getFullYear(), month.getMonth() + 1, 1); renderCalendar(); });
    const selectCalendarRange = (start: string, end: string) => {
      const ordered = [start, end].sort();
      const after = new Date(`${ordered[1]}T00:00:00Z`); after.setUTCDate(after.getUTCDate() + 1);
      get<HTMLInputElement>('[data-block-start]').value = `${ordered[0]}T00:00`;
      get<HTMLInputElement>('[data-block-end]').value = `${after.toISOString().slice(0, 10)}T00:00`;
      blockAllDay.checked = true;
      renderCalendar();
    };
    calendar.addEventListener('click', (event) => {
      const cell = (event.target as HTMLElement).closest<HTMLElement>('[data-calendar-date]');
      const date = cell?.dataset.calendarDate ?? '';
      if (!date) return;
      if (!calendarSelectionStart || (calendarSelectionStart && calendarSelectionEnd && calendarSelectionStart !== calendarSelectionEnd)) {
        calendarSelectionStart = date;
        calendarSelectionEnd = date;
      } else {
        calendarSelectionEnd = date;
        blockEditor.open = true;
      }
      selectCalendarRange(calendarSelectionStart, calendarSelectionEnd);
    });
    blockAllDay.addEventListener('change', () => { if (!blockAllDay.checked) get<HTMLInputElement>('[data-block-start]').focus(); });
    timezone.addEventListener('input', () => { render(); });
    holidayCountry.addEventListener('change', () => { renderHolidayTags(); renderCalendar(); });
    calendarSystem.addEventListener('change', () => { renderCalendar(); });
    // API の応答を待たずに月表示を作る。認証切れや一時的な取得失敗が
    // あっても、カレンダーそのものと月移動は利用できる状態を保つ。
    renderCalendar();
    void load().catch((error) => {
      const message = error instanceof Error ? error.message : '進行管理を読み込めませんでした。';
      tasks.textContent = message;
      events.textContent = message;
      reports.textContent = message;
      eventFeedback.value = `予定を読み込めませんでした。${message}`;
    });
  };
  document.addEventListener('astro:page-load', initializeOperations);
  initializeOperations();
</script>
