    };
    const render = () => {
      renderTimezoneOffset();
      const members = new Map((data.members ?? []).map((member) => [member.email, member.display_name || '表示名未設定']));
      projectTitle.textContent = memberPage ? 'カレンダー' : `${data.project?.name || 'プロジェクト'}：${calendarPage ? 'カレンダー' : progressOnly ? '進捗報告' : 'タスク管理'}`;
      get<HTMLElement>('[data-event-create]').hidden = memberPage || !data.scope.isManager;
      const selectedAssignees = new Set([...assignee.selectedOptions].map((option) => option.value));
      assignee.innerHTML = '<option value="" disabled>担当者を選択</option>' + (data.members ?? []).map((member) => `<option value="${escapeHtml(member.email)}" ${selectedAssignees.has(member.email) ? 'selected' : ''}>${escapeHtml(member.display_name || '表示名未設定')}</option>`).join('');
      const currentProject = progressProjectFilter.value;
      progressProjectFilter.innerHTML = '<option value="">すべてのプロジェクト</option>' + (data.projects ?? []).map((project) => `<option value="${escapeHtml(String(project.id))}">${escapeHtml(String(project.name || project.slug || project.id))}</option>`).join('');
      if ([...(data.projects ?? [])].some((project) => String(project.id) === currentProject)) progressProjectFilter.value = currentProject;
      renderProgressReports();
      const taskAssignedTo = (item: Record<string, any>) => { const assignee = String(item.assignee_email ?? '').trim().toLowerCase(), email = String(data.scope.email ?? '').toLowerCase(); return (item.task_kind === 'feedback' && assignee === '*') || assignee.split(',').map((value: string) => value.trim()).includes(email); };
      const taskKindLabel = (item: Record<string, any>) => item.task_kind === 'feedback' ? 'フィードバック依頼' : 'タスク依頼';
      const visibleTasks = (data.tasks ?? []).filter((item) => taskFilter === 'all' || (taskFilter === 'assigned' ? taskAssignedTo(item) : item.created_by === data.scope.email));
      tasks.innerHTML = visibleTasks.map((item) => { const assigned = taskAssignedTo(item); const assignee = String(item.assignee_email ?? '').trim(); const assigneeLabel = assignee === '*' ? '分野担当者全員' : assignee ? assignee.split(',').map((value: string) => members.get(value.trim()) || value.trim()).filter(Boolean).join('、') : '担当未指定'; return `<article class="item"><div class="task-row"><b><span class="task-kind-label">${taskKindLabel(item)}</span>${escapeHtml(String(item.title ?? ''))}</b><select aria-label="${escapeHtml(String(item.title ?? 'タスク'))}の状態" data-task-status="${escapeHtml(String(item.id))}"><option value="open" ${item.status === 'open' ? 'selected' : ''}>未着手</option><option value="doing" ${item.status === 'doing' ? 'selected' : ''}>進行中</option><option value="done" ${item.status === 'done' ? 'selected' : ''}>完了</option></select></div><small><span class="task-role">${assigned ? '自分がこなす' : item.created_by === data.scope.email ? '自分が依頼' : 'すべて'}</span> ${escapeHtml(String(item.subject || '全体'))} ・担当：${escapeHtml(assigneeLabel)}${item.created_by ? ` ・依頼者：${escapeHtml(String(item.created_by === data.scope.email ? '自分' : item.created_by))}` : ''}${item.due_at ? ` ・期限：${escapeHtml(String(item.due_at).replace('T',' '))}（${escapeHtml(String(item.due_timezone || 'Asia/Tokyo'))}）` : ''}</small>${item.details ? `<small>${escapeHtml(String(item.details))}</small>` : ''}${taskReminderEditor(item)}</article>`; }).join('') || '<p>この条件のタスクはありません。</p>';
      tasks.querySelectorAll('small').forEach((small) => {
        small.childNodes.forEach((node) => {
          if (node.nodeType !== Node.TEXT_NODE || !node.textContent?.includes('依頼者：')) return;
          for (const [memberEmail, memberName] of members) node.textContent = node.textContent.replace(memberEmail, memberName);
        });
      });
      const availabilityLabels: Record<string, string> = { available: '参加できる', maybe: '未定', unavailable: '参加できない' };
      events.innerHTML = (data.events ?? []).map((item) => {
        const participants = item.participants ?? [];
        const summary = availabilitySummary(`${item.title}の参加状況`, participants, item.availabilityCounts);
        return `<article class="item"><div class="event-heading"><b>${escapeHtml(item.title)}</b>${data.scope.isManager ? `<button type="button" class="event-delete" data-delete-event="${escapeHtml(item.id)}">この日程を削除</button>` : ''}</div><small>${formatDate(item.starts_at)}${item.ends_at ? ` 〜 ${formatDate(item.ends_at)}` : ''}</small><div class="availability">${Object.entries(availabilityLabels).map(([value, label]) => `<button type="button" class="${item.availability === value ? 'is-selected' : ''}" aria-pressed="${item.availability === value}" data-availability="${value}" data-event="${escapeHtml(item.id)}">${label}${item.availability === value ? ' ✓' : ''}</button>`).join('')}</div><div class="participant-summary">${summary || '<span>まだ参加登録はありません。</span>'}</div></article>`;
      }).join('') || '<p>登録された日程はありません。</p>';
      const blocks = data.availabilityBlocks ?? [];
      const ownBlocks = blocks.filter((item) => item.isSelf);
      get<HTMLElement>('[data-block-list]').innerHTML = ownBlocks.length ? ownBlocks.map((item) => `<div class="item availability-block-item"><span><b>${item.kind === 'available' ? '動ける' : '動けない'}</b> ・ ${formatDate(item.starts_at)} 〜 ${formatDate(item.ends_at)}${item.label ? ` ・ ${escapeHtml(String(item.label))}` : ''}</span><button type="button" class="event-delete" data-delete-block="${escapeHtml(String(item.id))}">削除</button></div>`).join('') : '<p>登録した可否期間はありません。</p>';
      renderCalendar();
    };
    const load = async () => { data = memberPage ? await api<OperationData>('/api/admin/member-calendar') : progressOverview ? await api<OperationData>('/api/admin/progress') : await api<OperationData>(`/api/admin/operations?project=${encodeURIComponent(projectId)}`); render(); };
    const runButtonAction = async (button: HTMLButtonElement, feedback: HTMLOutputElement, action: () => Promise<void>, success: string) => { button.disabled = true; feedback.value = '保存中…'; try { await action(); feedback.value = success; await load(); return true; } catch (error) { feedback.value = error instanceof Error ? error.message : '保存できませんでした。'; return false; } finally { button.disabled = false; } };
    let activeAvailabilityTrigger: HTMLButtonElement | null = null;
    const closeAvailabilityPopover = (restoreFocus = false) => {
      availabilityPopover.hidden = true;
      if (restoreFocus) activeAvailabilityTrigger?.focus();
      activeAvailabilityTrigger = null;
    };
    const readMemberNames = (button: HTMLButtonElement, key: 'availableMembers' | 'maybeMembers' | 'unavailableMembers') => {
      try { const value = JSON.parse(button.dataset[key] || '[]'); return Array.isArray(value) ? value.map(String) : []; }
      catch { return []; }
    };
    const openAvailabilityPopover = (button: HTMLButtonElement, point?: { x: number; y: number }) => {
      const groups = [
        { title: '参加可能 ○', names: readMemberNames(button, 'availableMembers') },
        { title: '未定 △', names: readMemberNames(button, 'maybeMembers') },
        { title: '参加不可 ×', names: readMemberNames(button, 'unavailableMembers') },
      ].filter((group) => group.names.length);
      availabilityPopover.innerHTML = `<h3>${escapeHtml(button.dataset.summaryTitle || '参加可否')}</h3>${groups.length ? groups.map((group) => `<section><h4>${group.title}</h4><ul>${group.names.map((name) => `<li>${escapeHtml(name)}</li>`).join('')}</ul></section>`).join('') : '<p>メンバー情報はありません。</p>'}`;
      availabilityPopover.hidden = false;
      activeAvailabilityTrigger = button;
      const anchor = button.getBoundingClientRect();
      const popover = availabilityPopover.getBoundingClientRect();
      const preferredLeft = point?.x ?? anchor.left;
      const preferredTop = point?.y ?? anchor.bottom + 6;
      availabilityPopover.style.left = `${Math.max(8, Math.min(preferredLeft, window.innerWidth - popover.width - 8))}px`;
      availabilityPopover.style.top = `${Math.max(8, Math.min(preferredTop, window.innerHeight - popover.height - 8))}px`;
    };
    root.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-availability-summary]');
      if (!button) return;
      event.preventDefault();
      if (activeAvailabilityTrigger === button && !availabilityPopover.hidden) closeAvailabilityPopover();
      else openAvailabilityPopover(button);
    });
    root.addEventListener('contextmenu', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-availability-summary]');
      if (!button) return;
      event.preventDefault();
      openAvailabilityPopover(button, { x: event.clientX, y: event.clientY });
    });
    document.addEventListener('click', (event) => {
      const target = event.target as Node;
      if (availabilityPopover.hidden || availabilityPopover.contains(target) || activeAvailabilityTrigger?.contains(target)) return;
      closeAvailabilityPopover();
    });
    document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && !availabilityPopover.hidden) closeAvailabilityPopover(true); });
    taskCreateOpen.addEventListener('click', () => { taskFeedback.value = ''; taskCreateDialog.showModal(); taskTitle.focus(); });
    get<HTMLButtonElement>('[data-close-task-create]').addEventListener('click', () => taskCreateDialog.close());
    taskCreateDialog.addEventListener('click', (event) => { if (event.target === taskCreateDialog) taskCreateDialog.close(); });
    taskCreateDialog.addEventListener('close', () => taskCreateOpen.focus());
    get<HTMLButtonElement>('[data-send-progress]').addEventListener('click', (event) => { const button = event.currentTarget as HTMLButtonElement; void runButtonAction(button, progressFeedback, async () => { await api('/api/admin/operations/progress', 'POST', { projectId, subject: progressSubject.value, body: progress.value }); progress.value = ''; }, '進捗を記録しました。'); });
    progressProjectFilter.addEventListener('change', renderProgressReports);
    progressSubjectFilters.forEach((input) => input.addEventListener('change', () => {
      const all = progressSubjectFilters.find((item) => item.dataset.progressSubjectFilter === 'all');
      if (input.dataset.progressSubjectFilter === 'all' && input.checked) progressSubjectFilters.filter((item) => item !== input).forEach((item) => { item.checked = false; });
      if (input.dataset.progressSubjectFilter !== 'all' && input.checked && all) all.checked = false;
      if (!progressSubjectFilters.some((item) => item.checked)) { if (all) all.checked = true; }
      renderProgressReports();
    }));
    get<HTMLButtonElement>('[data-create-task]').addEventListener('click', (event) => { const button = event.currentTarget as HTMLButtonElement; void runButtonAction(button, taskFeedback, async () => { await api('/api/admin/operations/tasks', 'POST', { projectId, title: taskTitle.value, subject: get<HTMLSelectElement>('[data-task-subject]').value, assigneeEmails: [...assignee.selectedOptions].map((option) => option.value).filter(Boolean), dueAt: taskDue.value, dueTimezone: taskDueTimezone.value, details: taskDetails.value, reminders: collectReminderRows(taskReminderList, taskReminderRepeat.value), reminderRepeat: taskReminderRepeat.value, reminderEmail: taskReminderEmail.value }); }, 'タスクを追加しました。').then((created) => { if (!created) return; taskTitle.value = ''; taskDetails.value = ''; taskDue.value = ''; [...assignee.options].forEach((option) => { option.selected = false; }); taskFeedback.value = ''; taskListFeedback.value = 'タスクを追加しました。'; taskCreateDialog.close(); }); });
    get<HTMLButtonElement>('[data-add-task-reminder]').addEventListener('click', () => { taskReminderList.insertAdjacentHTML('beforeend', reminderRowHtml()); refreshReminderRows(taskReminderList); });
    refreshReminderRows(taskReminderList);
    root.addEventListener('change', (event) => { const row = (event.target as HTMLElement).closest<HTMLElement>('[data-task-reminder-row]'); if (row) refreshReminderRow(row); });
    root.addEventListener('click', (event) => { const target = event.target as HTMLElement; const remove = target.closest<HTMLButtonElement>('[data-remove-reminder]'); if (remove) { remove.closest<HTMLElement>('[data-task-reminder-row]')?.remove(); return; } const add = target.closest<HTMLButtonElement>('[data-add-reminder]'); if (add) { const container = add.closest<HTMLElement>('[data-reminder-editor]')?.querySelector<HTMLElement>('.task-reminder-rules'); if (container) { container.insertAdjacentHTML('beforeend', reminderRowHtml()); refreshReminderRows(container); } return; } const save = target.closest<HTMLButtonElement>('[data-save-reminders]'); if (!save) return; const editor = save.closest<HTMLElement>('[data-reminder-editor]'); if (!editor) return; const feedback = editor.querySelector<HTMLOutputElement>('[data-reminder-feedback]'); const repeat = editor.querySelector<HTMLSelectElement>('[data-reminder-repeat]')?.value || 'none'; const email = editor.querySelector<HTMLInputElement>('[data-reminder-email]')?.value || ''; const reminderContainer = editor.querySelector<HTMLElement>('.task-reminder-rules'); if (!feedback || !reminderContainer) return; void runButtonAction(save, feedback, async () => { await api(`/api/admin/operations/tasks/${encodeURIComponent(editor.dataset.reminderEditor || '')}`, 'PATCH', { reminderAction: 'replace', reminders: collectReminderRows(reminderContainer, repeat), reminderEmail: email }); }, 'リマインダーを保存しました。'); });
    get<HTMLButtonElement>('[data-create-event]').addEventListener('click', (event) => { const button = event.currentTarget as HTMLButtonElement; void runButtonAction(button, eventFeedback, async () => { const eventTimezone = get<HTMLInputElement>('[data-event-timezone]').value || 'Asia/Tokyo'; await api('/api/admin/operations/events', 'POST', { projectId, title: get<HTMLInputElement>('[data-event-title]').value, startsAt: localDateTimeToInstant(get<HTMLInputElement>('[data-event-start]').value, eventTimezone), endsAt: localDateTimeToInstant(get<HTMLInputElement>('[data-event-end]').value, eventTimezone), details: get<HTMLInputElement>('[data-event-details]').value, timezone: eventTimezone }); }, '日程を追加しました。'); });
    root.querySelectorAll<HTMLButtonElement>('[data-task-filter]').forEach((button) => button.addEventListener('click', () => { taskFilter = (button.dataset.taskFilter as typeof taskFilter) || 'assigned'; root.querySelectorAll<HTMLButtonElement>('[data-task-filter]').forEach((item) => { const active = item === button; item.classList.toggle('is-selected', active); item.setAttribute('aria-pressed', String(active)); }); render(); }));
    get<HTMLButtonElement>('[data-create-block]').addEventListener('click', (event) => { const button = event.currentTarget as HTMLButtonElement; void runButtonAction(button, blockFeedback, async () => { const zone = selectedTimezone(); await api('/api/admin/operations/availability-blocks', 'POST', { startsAt: localDateTimeToInstant(get<HTMLInputElement>('[data-block-start]').value, zone), endsAt: localDateTimeToInstant(get<HTMLInputElement>('[data-block-end]').value, zone), timezone: zone, kind: get<HTMLSelectElement>('[data-block-kind]').value, label: get<HTMLInputElement>('[data-block-label]').value }); }, '可否期間を追加しました。'); });
    tasks.addEventListener('change', (event) => { const select = (event.target as HTMLElement).closest<HTMLSelectElement>('[data-task-status]'); if (!select) return; select.disabled = true; taskListFeedback.value = ''; void api(`/api/admin/operations/tasks/${encodeURIComponent(select.dataset.taskStatus ?? '')}`, 'PATCH', { status: select.value }).then(load).catch((error) => { taskListFeedback.value = error instanceof Error ? error.message : '状態を更新できませんでした。'; }).finally(() => { select.disabled = false; }); });
    events.addEventListener('click', (event) => { const target = event.target as HTMLElement; const deleteButton = target.closest<HTMLButtonElement>('[data-delete-event]'); if (deleteButton) { if (!confirm('この日程と参加登録を削除しますか？')) return; deleteButton.disabled = true; eventFeedback.value = '日程を削除中…'; void api(`/api/admin/operations/events/${encodeURIComponent(deleteButton.dataset.deleteEvent ?? '')}`, 'DELETE').then(async () => { eventFeedback.value = '日程を削除しました。'; await load(); }).catch((error) => { eventFeedback.value = error instanceof Error ? error.message : '日程を削除できませんでした。'; }).finally(() => { deleteButton.disabled = false; }); return; } const button = target.closest<HTMLButtonElement>('[data-availability]'); if (!button) return; button.disabled = true; eventFeedback.value = '参加状態を保存中…'; void api(`/api/admin/operations/events/${encodeURIComponent(button.dataset.event ?? '')}/availability`, 'PUT', { availability: button.dataset.availability }).then(async () => { eventFeedback.value = '参加状態を保存しました。'; await load(); }).catch((error) => { eventFeedback.value = error instanceof Error ? error.message : '参加状態を保存できませんでした。'; }).finally(() => { button.disabled = false; }); });
    root.querySelector<HTMLElement>('[data-block-list]')!.addEventListener('click', (event) => { const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-delete-block]'); if (!button) return; button.disabled = true; void api(`/api/admin/operations/availability-blocks/${encodeURIComponent(button.dataset.deleteBlock ?? '')}`, 'DELETE').then(load).catch((error) => { blockFeedback.value = error instanceof Error ? error.message : '可否期間を削除できませんでした。'; }).finally(() => { button.disabled = false; }); });
    get<HTMLButtonElement>('[data-calendar-prev]').addEventListener('click', () => { month = new Date(month.getFullYear(), month.getMonth() - 1, 1); renderCalendar(); });
    get<HTMLButtonElement>('[data-calendar-next]').addEventListener('click', () => { month = new Date(month.getFullYear(), month.getMonth() + 1, 1); renderCalendar(); });
    const selectCalendarRange = (start: string, end: string) => {
      const ordered = [start, end].sort();
      const after = new Date(`${ordered[1]}T00:00:00Z`); after.setUTCDate(after.getUTCDate() + 1);
      get<HTMLInputElement>('[data-block-start]').value = `${ordered[0]}T00:00`;
      get<HTMLInputElement>('[data-block-end]').value = `${after.toISOString().slice(0, 10)}T00:00`;
      blockAllDay.checked = true;
      renderCalendar();
    };
    calendar.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      if (target.closest('[data-availability-summary], .calendar-event')) return;
      const cell = target.closest<HTMLElement>('[data-calendar-date]');
      const date = cell?.dataset.calendarDate ?? '';
      if (!date) return;
      if (!calendarSelectionStart || (calendarSelectionStart && calendarSelectionEnd && calendarSelectionStart !== calendarSelectionEnd)) {
        calendarSelectionStart = date;
        calendarSelectionEnd = date;
      } else {
        calendarSelectionEnd = date;
        blockEditor.open = true;
      }
      selectCalendarRange(calendarSelectionStart, calendarSelectionEnd);
    });
    blockAllDay.addEventListener('change', () => { if (!blockAllDay.checked) get<HTMLInputElement>('[data-block-start]').focus(); });
    timezone.addEventListener('input', () => { render(); });
    holidayCountry.addEventListener('change', () => { renderHolidayTags(); renderCalendar(); });
    holidaySearch.addEventListener('input', () => {
      const query = holidaySearch.value.trim().toLocaleLowerCase();
      [...holidayCountry.options].forEach((option) => { option.hidden = Boolean(query) && !`${option.textContent ?? ''} ${option.value}`.toLocaleLowerCase().includes(query); });
    });
    calendarSystem.addEventListener('change', () => { renderCalendar(); });
    // API の応答を待たずに月表示を作る。認証切れや一時的な取得失敗が
    // あっても、カレンダーそのものと月移動は利用できる状態を保つ。
    renderCalendar();
    void load().catch((error) => {
      const message = error instanceof Error ? error.message : '進行管理を読み込めませんでした。';
      tasks.textContent = message;
      events.textContent = message;
      reports.textContent = message;
      eventFeedback.value = `予定を読み込めませんでした。${message}`;
    });
  };
  document.addEventListener('astro:page-load', initializeOperations);
  initializeOperations();
</script>
