---
import AdminLayout from "../../layouts/AdminLayout.astro";
import AdminNav from "../../components/AdminNav.astro";
import { getCollection } from "astro:content";
const subjects = (await getCollection("subjects")).sort((a, b) => a.data.order - b.data.order).map((subject) => ({ slug: subject.data.slug, name: subject.data.name.ja }));
const operationSite = Astro.url.searchParams.get("project") === "secretariat" ? "secretariat" : "atlas";
const timezones = [
  ["Asia/Tokyo", "日本（東京）"], ["Asia/Seoul", "韓国（ソウル）"], ["Asia/Shanghai", "中国（上海）"], ["Asia/Taipei", "台湾（台北）"], ["Asia/Hong_Kong", "香港"], ["Asia/Singapore", "シンガポール"], ["Asia/Bangkok", "タイ（バンコク）"], ["Asia/Kolkata", "インド（コルカタ）"], ["Asia/Dubai", "アラブ首長国連邦（ドバイ）"], ["Australia/Sydney", "オーストラリア（シドニー）"], ["Pacific/Auckland", "ニュージーランド（オークランド）"], ["Europe/London", "英国（ロンドン）"], ["Europe/Paris", "フランス・中央ヨーロッパ"], ["Europe/Berlin", "ドイツ（ベルリン）"], ["Europe/Rome", "イタリア（ローマ）"], ["Europe/Madrid", "スペイン（マドリード）"], ["Europe/Moscow", "ロシア（モスクワ）"], ["Africa/Cairo", "エジプト（カイロ）"], ["Africa/Johannesburg", "南アフリカ（ヨハネスブルク）"], ["America/Sao_Paulo", "ブラジル（サンパウロ）"], ["America/New_York", "米国東部（ニューヨーク）"], ["America/Chicago", "米国中部（シカゴ）"], ["America/Denver", "米国山岳部（デンバー）"], ["America/Los_Angeles", "米国太平洋（ロサンゼルス）"], ["America/Anchorage", "米国アラスカ"], ["Pacific/Honolulu", "米国ハワイ"], ["America/Toronto", "カナダ（トロント）"], ["America/Vancouver", "カナダ（バンクーバー）"], ["America/Mexico_City", "メキシコ（メキシコシティ）"], ["UTC", "協定世界時（UTC）"],
] as const;
---
<AdminLayout title="進捗・ToDo・日程" description="運営作業を共有する場所">
<main class="operations" data-operations><AdminNav current="operations" site={operationSite} />
<header><p>ATLASEZ / 運営の進行管理</p><h1 data-project-title>進捗・ToDo・日程</h1><span>作業を終えたら進捗を残し、次の作業と参加可能な日程を共有します。</span><nav class="project-switcher" aria-label="プロジェクト切替"><a href="/admin/operations/?project=atlas">アトラス</a><a href="/admin/operations/?project=secretariat">運営事務局</a></nav></header>
<div class="grid">
<section><h2>進捗を報告</h2><p>編集・査読の完了後に、ここへ短く記録できます。</p><p class="discord-notice">記録すると、設定済みの分野Discordチャンネルと全体進捗チャンネルへ自動転送されます。</p><label class="field-label">進捗内容<textarea data-progress placeholder="例：群の定義を修正し、査読コメント3件に対応しました。"></textarea></label><button data-send-progress>進捗を記録してDiscordへ送る</button><output data-progress-feedback aria-live="polite"></output><h3 class="subheading">自分が投げた進捗報告</h3><div data-progress-list></div></section>
<section><h2>ToDo</h2><p>「自分がこなす」「自分が依頼」「すべて」を切り替えると、この直下の一覧が変わります。</p><div class="task-filters" role="group" aria-label="ToDoの表示対象"><button type="button" class="is-selected" data-task-filter="assigned" aria-pressed="true">自分がこなす</button><button type="button" data-task-filter="created" aria-pressed="false">自分が依頼</button><button type="button" data-task-filter="all" aria-pressed="false">すべて</button></div><input data-task-title placeholder="タスク名"/><label class="field-label">対象分野<select data-task-subject><option value="">全体</option>{subjects.map((subject) => <option value={subject.slug}>{subject.name}</option>)}</select></label><label class="field-label">担当者<select data-task-assignee><option value="">担当者を指定しない</option></select></label><div class="task-deadline"><label class="field-label">期限日時<input data-task-due type="datetime-local" /></label><label class="field-label">期限のタイムゾーン<select data-task-due-timezone>{timezones.map(([value, label]) => <option value={value} selected={value === "Asia/Tokyo"}>{label}</option>)}</select></label></div><div class="task-reminder-settings"><h3>自分用リマインダー</h3><p>期限基準の「N日前」「N時間前」「当日毎時」、または指定日時を複数登録できます。メール欄が空欄なら通知ベルに表示します。</p><div data-task-reminder-list><div class="task-reminder-row" data-task-reminder-row><label class="field-label">種類<select data-reminder-kind><option value="before_days">N日前</option><option value="before_hours">N時間前</option><option value="due_day_hourly">当日毎時</option><option value="absolute">指定日時</option></select></label><label class="field-label" data-reminder-amount-label>数量<input data-reminder-amount type="number" min="1" max="8760" placeholder="N" /></label><label class="field-label" data-reminder-start-label hidden>開始時刻<input data-reminder-start type="time" value="09:00" /></label><label class="field-label" data-reminder-at-label hidden>日時<input data-reminder-at type="datetime-local" /></label><button type="button" class="task-reminder-remove" data-remove-reminder hidden>削除</button></div></div><button type="button" class="secondary-button" data-add-task-reminder>リマインダーを追加</button><label class="field-label">指定日時の繰り返し（1つのリマインダーにのみ適用）<select data-task-reminder-repeat><option value="none">1回</option><option value="daily">毎日</option><option value="weekly">毎週</option><option value="monthly">毎月</option></select></label><label class="field-label">自分の通知先メールアドレス（任意）<input data-task-reminder-email type="email" maxlength="254" placeholder="自分のメールアドレス" /></label></div><textarea data-task-details placeholder="補足・依頼内容（任意）"></textarea><button data-create-task>タスクを追加</button><output class="operation-feedback" data-task-feedback aria-live="polite"></output><div data-task-list aria-live="polite"></div></section>
<section class="wide"><h2>同時作業会・交流会の日程</h2><p>全分野管理者は日程を追加できます。各メンバーは「参加できる／未定／参加できない」を自分で登録します。</p><label class="field-label">表示するタイムゾーン<select data-calendar-timezone>{timezones.map(([value, label]) => <option value={value} selected={value === "Asia/Tokyo"}>{label}</option>)}</select></label><div class="calendar-head"><button type="button" data-calendar-prev aria-label="前の月">‹</button><strong data-calendar-title>読み込み中…</strong><button type="button" data-calendar-next aria-label="次の月">›</button></div><div class="calendar-week" data-event-calendar aria-label="日程カレンダー"></div><small class="calendar-note">祝日は現在主要な固定祝日のプロトタイプ表示です。国・地域別の祝日カレンダー連携は次段階で追加できます。</small><div class="event-create" data-event-create hidden><input data-event-title placeholder="催し名"/><input data-event-start type="datetime-local" aria-label="開始日時"/><input data-event-end type="datetime-local" aria-label="終了日時"/><input data-event-details placeholder="場所・URL・補足" aria-label="場所・URL・補足"/><select data-event-timezone aria-label="日程の基準タイムゾーン">{timezones.map(([value, label]) => <option value={value} selected={value === "Asia/Tokyo"}>{label}</option>)}</select><button data-create-event>日程を追加</button></div><output class="operation-feedback" data-event-feedback aria-live="polite"></output><div data-event-list aria-live="polite"></div><details class="availability-blocks"><summary>自分の可否期間を登録</summary><p>テスト期間や一時滞在など、日程調整で考慮してほしい期間を自分だけの予定として登録できます。</p><div class="availability-block-form"><input data-block-start type="datetime-local" aria-label="可否期間の開始"/><input data-block-end type="datetime-local" aria-label="可否期間の終了"/><select data-block-kind aria-label="可否"><option value="unavailable">動けない</option><option value="available">動ける</option></select><input data-block-label placeholder="理由・メモ（任意）"/><button type="button" data-create-block>期間を追加</button></div><output class="operation-feedback" data-block-feedback aria-live="polite"></output><div data-block-list></div></details></section>
</div></main>
</AdminLayout>
<style is:global>
.operations{margin:0 auto;max-width:1200px;padding:0 1.25rem 4rem}.operations > header{border-bottom:1px solid var(--border-default);padding:2rem 0 1.25rem}.operations > header p{color:var(--accent-primary);font-size:.76rem;font-weight:800;letter-spacing:.08em;margin:0}.operations h1{font-size:2rem;margin:.25rem 0}.operations > header span,.operations section>p{color:var(--text-secondary);line-height:1.6}.grid{display:grid;gap:1rem;grid-template-columns:1fr 1fr;margin-top:1.25rem}.grid section{border:1px solid var(--border-default);padding:1rem}.grid h2{font-size:1.1rem;margin:0}.grid section>p{font-size:.82rem;margin:.4rem 0 .8rem}.wide{grid-column:span 2}.operations input,.operations textarea{background:var(--background-primary);border:1px solid var(--border-default);box-sizing:border-box;color:var(--text-primary);font:inherit;margin:.25rem 0;padding:.55rem;width:100%}.operations textarea{min-height:6rem;resize:vertical}.operations button{background:var(--accent-primary);border:1px solid var(--accent-primary);color:#fff;cursor:pointer;font:inherit;font-size:.82rem;font-weight:800;margin-top:.35rem;padding:.5rem .7rem}.item{border-top:1px solid var(--border-default);display:grid;gap:.3rem;margin-top:.85rem;padding:.7rem 0}.item small{color:var(--text-secondary)}.task-row{align-items:center;display:flex;gap:.5rem;justify-content:space-between}.task-row select{font:inherit;padding:.25rem}.event-create{display:grid;gap:.35rem;grid-template-columns:1fr 1fr 1fr auto}.event-create[hidden]{display:none!important}.availability{display:flex;flex-wrap:wrap;gap:.35rem}.availability button{background:var(--background-secondary);border-color:var(--border-default);color:var(--text-primary)}.availability button:hover{border-color:var(--accent-primary);color:var(--accent-primary)}@media(max-width:700px){.operations{padding:0 .8rem 3rem}.operations > header{align-items:start;display:block}.grid{grid-template-columns:1fr}.wide{grid-column:auto}.event-create{grid-template-columns:1fr}.task-row{align-items:start;display:grid}}
  .calendar-head{align-items:center;display:flex;justify-content:center;gap:.7rem;margin:1rem 0 .55rem}.calendar-head button{font-size:1.2rem;line-height:1;margin:0;min-width:2.2rem}.calendar-week{display:grid;gap:1px;grid-template-columns:repeat(7,minmax(0,1fr));background:var(--border-default);border:1px solid var(--border-default)}.calendar-cell{background:var(--background-primary);min-height:6.8rem;padding:.35rem}.calendar-cell--blank{background:var(--background-secondary)}.calendar-day{color:var(--text-secondary);font-size:.7rem;font-weight:800}.calendar-event{background:color-mix(in srgb,var(--accent-primary) 13%,var(--background-primary));border-left:2px solid var(--accent-primary);display:block;font-size:.67rem;line-height:1.35;margin-top:.25rem;overflow:hidden;padding:.15rem .25rem;text-overflow:ellipsis;white-space:nowrap}.calendar-note{color:var(--text-secondary);display:block;font-size:.72rem;margin-top:.5rem}.event-create{grid-template-columns:1fr 1fr 1fr minmax(125px,.7fr) auto}@media(max-width:700px){.calendar-cell{min-height:4.6rem;padding:.25rem}.calendar-event{font-size:.58rem}.event-create{grid-template-columns:1fr}}
  .calendar-cell--holiday{background:color-mix(in srgb,#d9485f 8%,var(--background-primary))}.calendar-holiday{color:#b33649;display:block;font-size:.61rem;font-weight:800;line-height:1.25;margin-top:.15rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.task-deadline{display:grid;gap:.55rem;grid-template-columns:1fr 1fr}.task-deadline input,.task-deadline select{margin:.25rem 0}@media(max-width:700px){.task-deadline{grid-template-columns:1fr}}
  .event-heading{align-items:center;display:flex;gap:.6rem;justify-content:space-between}
  .event-delete{background:transparent!important;border-color:var(--border-default)!important;color:var(--text-secondary)!important;font-size:.72rem!important;font-weight:700!important;margin:0!important;padding:.3rem .5rem!important}
  .event-delete:hover{border-color:var(--accent-primary)!important;color:var(--accent-primary)!important}
</style>
<style is:global>
  .participant-summary { border-top: 1px solid var(--border-default); display: grid; gap: .45rem; margin-top: .55rem; padding-top: .55rem; }
  .participant-counts, .participant-names { display: flex; flex-wrap: wrap; gap: .35rem; }
  .participant-counts span, .participant-chip { border: 1px solid var(--border-default); border-radius: 999px; color: var(--text-secondary); font-size: .72rem; padding: .2rem .45rem; }
  .participant-chip { color: var(--text-primary); }
  .participant-available { background: #e4f5ea; border-color: #9bc9a9; }
  .participant-maybe { background: #fff4d6; border-color: #e5c879; }
  .participant-unavailable { background: #f5e5e7; border-color: #d8a4ad; }
</style>
<style>.discord-notice{background:color-mix(in srgb,var(--accent-primary),transparent 90%);border-left:3px solid var(--accent-primary);font-size:.8rem!important;font-weight:700;padding:.55rem .7rem}</style>
<style>.field-label{color:var(--text-secondary);display:grid;font-size:.76rem;font-weight:800;gap:.15rem}.operations select{background:var(--background-primary);border:1px solid var(--border-default);box-sizing:border-box;color:var(--text-primary);font:inherit;margin:.25rem 0;padding:.55rem;width:100%}.operation-feedback{color:var(--text-secondary);display:block;font-size:.76rem;min-height:1.2rem;padding-top:.35rem}.operations button:disabled{cursor:wait;opacity:.62}</style>
<style>.availability button.is-selected{background:var(--accent-primary);border-color:var(--accent-primary);color:#fff;box-shadow:0 0 0 2px color-mix(in srgb,var(--accent-primary),transparent 75%)}.availability button[aria-pressed="true"]{font-weight:900}</style>
<style is:global>
  .subheading{border-top:1px solid var(--border-default);font-size:.82rem;margin:1rem 0 0;padding-top:.75rem}
  .task-role{background:color-mix(in srgb,var(--accent-primary),transparent 88%);border-radius:999px;color:var(--accent-primary);font-weight:800;padding:.12rem .35rem}
  .task-reminder-settings{background:color-mix(in srgb,var(--accent-primary),transparent 95%);border:1px solid var(--border-default);margin:.8rem 0;padding:.75rem}
  .task-reminder-settings h3{font-size:.9rem;margin:0}
  .task-reminder-settings p,.reminder-editor-note{color:var(--text-secondary);font-size:.75rem;line-height:1.5}
  .task-reminder-row{align-items:end;border-top:1px solid var(--border-default);display:grid;gap:.4rem;grid-template-columns:1.2fr .8fr 1fr 1.25fr auto;padding-top:.5rem}
  .task-reminder-row input,.task-reminder-row select{margin:0}
  .task-reminder-row [hidden]{display:none}
  .task-reminder-remove,.secondary-button{background:var(--background-secondary)!important;border-color:var(--border-default)!important;color:var(--text-primary)!important}
  .task-reminder-remove{margin:0!important;white-space:nowrap}
  .task-reminder-editor{border-top:1px solid var(--border-default);margin-top:.7rem;padding-top:.55rem}
  .task-reminder-editor summary{color:var(--accent-primary);cursor:pointer;font-size:.78rem;font-weight:800}
  .task-reminder-rules{display:grid;gap:.45rem}
  .task-reminder-editor > div > .field-label{margin-top:.5rem}
  @media(max-width:900px){.task-reminder-row{grid-template-columns:1fr 1fr}.task-reminder-row button{justify-self:start}}
  @media(max-width:700px){.task-reminder-row{grid-template-columns:1fr}.task-reminder-row button{width:auto}}
</style>
<style is:global>
  .project-switcher { display:flex; flex-wrap:wrap; gap:.45rem; margin-top:.8rem; }
  .project-switcher a { border:1px solid var(--border-default); border-radius:999px; color:var(--text-primary); font-size:.74rem; font-weight:800; padding:.35rem .6rem; text-decoration:none; }
  .project-switcher a:hover { border-color:var(--accent-primary); color:var(--accent-primary); }
  .task-filters { display:flex; flex-wrap:wrap; gap:.4rem; margin:.7rem 0; }
  .task-filters button { background:var(--background-primary); border-color:var(--border-default); border-radius:999px; color:var(--text-primary); margin:0; }
  .task-filters button.is-selected { background:var(--accent-primary); border-color:var(--accent-primary); color:#fff; }
  .availability-blocks { border-top:1px solid var(--border-default); margin-top:1rem; padding-top:.8rem; }
  .availability-blocks summary { cursor:pointer; font-weight:800; }
  .availability-blocks p { font-size:.78rem; }
  .availability-block-form { display:grid; gap:.4rem; grid-template-columns:1fr 1fr .7fr 1fr auto; }
  .availability-block-form input,.availability-block-form select { margin:0; min-width:0; }
  .availability-block-form button { margin:0; }
  .availability-block-item { align-items:center; display:flex; gap:.5rem; grid-template-columns:1fr auto; justify-content:space-between; }
  .availability-block-item .event-delete { flex:0 0 auto; }
  @media(max-width:900px) { .availability-block-form { grid-template-columns:1fr 1fr; } }
  @media(max-width:700px) { .availability-block-form { grid-template-columns:1fr; } }
</style>
<style is:global>
  .availability { gap: .6rem; margin-top: .45rem; }
  .availability button { border-radius: .55rem; font-size: .9rem; min-height: 2.8rem; min-width: 8.5rem; padding: .65rem .9rem; }
  .availability button.is-selected { box-shadow: 0 0 0 3px color-mix(in srgb,var(--accent-primary),transparent 78%); }
  @media (max-width: 700px) { .availability { display: grid; grid-template-columns: 1fr; } .availability button { width: 100%; } }
</style>
<script>
  type OperationMember = { email: string; display_name?: string };
  type OperationEvent = { id: string; title: string; starts_at: string; ends_at?: string | null; availability?: string | null; availabilityCounts?: Record<string, number>; participants?: Array<{ displayName: string; availability: string; isSelf: boolean }> };
  type ReminderRule = { id?: string; remind_at?: string; timezone?: string; label?: string; relative_kind?: string; relative_amount?: number | null; relative_unit?: string | null; relative_start?: string | null; repeat?: string | null };
  type OperationData = { scope: { isManager: boolean; email?: string }; project?: { id: string; slug: string; name: string }; tasks?: Array<Record<string, any>>; events?: OperationEvent[]; progress?: Array<Record<string, any>>; members?: OperationMember[]; availabilityBlocks?: Array<Record<string, any>> };
  const initializeOperations = () => {
    const root = document.querySelector<HTMLElement>('[data-operations]');
    if (!root || root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';
    const get = <T extends Element>(selector: string) => root.querySelector<T>(selector)!;
    const progress = get<HTMLTextAreaElement>('[data-progress]');
    const tasks = get<HTMLElement>('[data-task-list]');
    const events = get<HTMLElement>('[data-event-list]');
    const reports = get<HTMLElement>('[data-progress-list]');
    const assignee = get<HTMLSelectElement>('[data-task-assignee]');
    const calendar = get<HTMLElement>('[data-event-calendar]');
    const calendarTitle = get<HTMLElement>('[data-calendar-title]');
    const timezone = get<HTMLSelectElement>('[data-calendar-timezone]');
    const taskDue = get<HTMLInputElement>('[data-task-due]');
    const taskDueTimezone = get<HTMLSelectElement>('[data-task-due-timezone]');
    const taskReminderList = get<HTMLElement>('[data-task-reminder-list]');
    const taskReminderEmail = get<HTMLInputElement>('[data-task-reminder-email]');
    const taskReminderRepeat = get<HTMLSelectElement>('[data-task-reminder-repeat]');
    const progressFeedback = get<HTMLOutputElement>('[data-progress-feedback]');
    const taskFeedback = get<HTMLOutputElement>('[data-task-feedback]');
    const eventFeedback = get<HTMLOutputElement>('[data-event-feedback]');
    const blockFeedback = get<HTMLOutputElement>('[data-block-feedback]');
    const projectTitle = get<HTMLElement>('[data-project-title]');
    const projectId = new URLSearchParams(location.search).get('project') || 'atlas';
    let taskFilter: 'assigned' | 'created' | 'all' = 'assigned';
    const populateTimezones = () => {
      const values = typeof Intl.supportedValuesOf === 'function' ? Intl.supportedValuesOf('timeZone') : [];
      if (!values.length) return;
      root.querySelectorAll<HTMLSelectElement>('[data-calendar-timezone], [data-task-due-timezone], [data-event-timezone]').forEach((select) => {
        const current = select.value || 'Asia/Tokyo';
        select.innerHTML = values.map((value) => `<option value="${escapeHtml(value)}">${escapeHtml(value.replaceAll('_', ' / '))}</option>`).join('');
        select.value = values.includes(current) ? current : 'Asia/Tokyo';
      });
    };
    const escapeHtml = (value: string) => value.replace(/[&<>"']/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[character] ?? character);
    const selected = (actual: string, expected: string) => actual === expected ? 'selected' : '';
    const reminderKind = (rule: ReminderRule) => rule.relative_kind === 'before' ? (rule.relative_unit === 'hours' ? 'before_hours' : 'before_days') : rule.relative_kind === 'due_day_hourly' ? 'due_day_hourly' : 'absolute';
    const reminderRowHtml = (rule: ReminderRule = {}) => {
      const kind = reminderKind(rule);
      return `<div class="task-reminder-row" data-task-reminder-row><label class="field-label">種類<select data-reminder-kind><option value="before_days" ${selected(kind, 'before_days')}>N日前</option><option value="before_hours" ${selected(kind, 'before_hours')}>N時間前</option><option value="due_day_hourly" ${selected(kind, 'due_day_hourly')}>当日毎時</option><option value="absolute" ${selected(kind, 'absolute')}>指定日時</option></select></label><label class="field-label" data-reminder-amount-label>数量<input data-reminder-amount type="number" min="1" max="8760" value="${escapeHtml(String(rule.relative_amount ?? ''))}" placeholder="N" /></label><label class="field-label" data-reminder-start-label>開始時刻<input data-reminder-start type="time" value="${escapeHtml(String(rule.relative_start || '09:00'))}" /></label><label class="field-label" data-reminder-at-label>日時<input data-reminder-at type="datetime-local" value="${escapeHtml(String(rule.remind_at || ''))}" /></label><button type="button" class="task-reminder-remove" data-remove-reminder>削除</button></div>`;
    };
    const refreshReminderRow = (row: HTMLElement) => {
      const kind = row.querySelector<HTMLSelectElement>('[data-reminder-kind]')?.value || 'before_days';
      const amount = row.querySelector<HTMLElement>('[data-reminder-amount-label]');
      const start = row.querySelector<HTMLElement>('[data-reminder-start-label]');
      const at = row.querySelector<HTMLElement>('[data-reminder-at-label]');
      if (amount) amount.hidden = kind !== 'before_days' && kind !== 'before_hours';
      if (start) start.hidden = kind !== 'due_day_hourly';
      if (at) at.hidden = kind !== 'absolute';
    };
    const refreshReminderRows = (container: HTMLElement) => container.querySelectorAll<HTMLElement>('[data-task-reminder-row]').forEach(refreshReminderRow);
    const collectReminderRows = (container: HTMLElement, repeat: string) => [...container.querySelectorAll<HTMLElement>('[data-task-reminder-row]')].map((row) => {
      const kind = row.querySelector<HTMLSelectElement>('[data-reminder-kind]')?.value || 'before_days';
      const amount = row.querySelector<HTMLInputElement>('[data-reminder-amount]')?.value || '';
      const start = row.querySelector<HTMLInputElement>('[data-reminder-start]')?.value || '09:00';
      const remindAt = row.querySelector<HTMLInputElement>('[data-reminder-at]')?.value || '';
      if (kind === 'before_days' || kind === 'before_hours') return amount ? { kind: 'before', amount: Number(amount), unit: kind === 'before_days' ? 'days' : 'hours' } : null;
      if (kind === 'due_day_hourly') return { kind: 'due_day_hourly', start };
      return { kind: 'absolute', remindAt, timezone: taskDueTimezone.value || 'Asia/Tokyo', repeat, label: '指定日時' };
    }).filter((row) => row !== null && (row.kind !== 'absolute' || row.remindAt));
    const taskReminderRules = (item: Record<string, any>): ReminderRule[] => {
      const rules = Array.isArray(item.reminders) ? item.reminders as ReminderRule[] : [];
      if (rules.length) return rules;
      return item.reminder_at ? [{ remind_at: String(item.reminder_at), relative_kind: 'absolute', repeat: String(item.reminder_repeat || 'none') }] : [];
    };
    const taskReminderEditor = (item: Record<string, any>) => {
      const rules = taskReminderRules(item);
      const repeat = String(item.reminder_repeat || rules[0]?.repeat || 'none');
      const rows = rules.map((rule) => reminderRowHtml(rule)).join('') || '<p class="reminder-empty">リマインダーは設定されていません。</p>';
      return `<details class="task-reminder-editor"><summary>リマインダーを確認・編集（${rules.length}件）</summary><div data-reminder-editor="${escapeHtml(String(item.id))}"><p class="reminder-editor-note">期限基準の相対指定は保存時に日時へ展開されます。メール欄が空欄なら通知ベルに表示します。</p><div class="task-reminder-rules">${rows}</div><button type="button" class="secondary-button" data-add-reminder>リマインダーを追加</button><label class="field-label">指定日時の繰り返し<select data-reminder-repeat><option value="none" ${selected(repeat, 'none')}>1回</option><option value="daily" ${selected(repeat, 'daily')}>毎日</option><option value="weekly" ${selected(repeat, 'weekly')}>毎週</option><option value="monthly" ${selected(repeat, 'monthly')}>毎月</option></select></label><label class="field-label">自分の通知先メールアドレス（任意）<input type="email" maxlength="254" data-reminder-email value="${escapeHtml(String(item.reminder_email || ''))}" placeholder="自分のメールアドレス" /></label><button type="button" data-save-reminders>このToDoの設定を保存</button><output class="operation-feedback" data-reminder-feedback aria-live="polite"></output></div></details>`;
    };
    populateTimezones();
    const api = async <T,>(url: string, method = 'GET', body?: unknown): Promise<T> => {
      const response = await fetch(url, { method, credentials: 'same-origin', cache: 'no-store', headers: body === undefined ? {} : { 'content-type': 'application/json' }, body: body === undefined ? undefined : JSON.stringify(body) });
      const contentType = response.headers.get('content-type') ?? '';
      const data = contentType.includes('application/json') ? await response.json() as T & { error?: string } : null;
      if (!response.ok || !data) throw new Error(data?.error ?? '認証情報を確認できませんでした。ページを再読み込みしてください。');
      return data;
    };
    let data: OperationData = { scope: { isManager: false } };
    let month = new Date(); month = new Date(month.getFullYear(), month.getMonth(), 1);
    try { const local = Intl.DateTimeFormat().resolvedOptions().timeZone; if ([...timezone.options].some((option) => option.value === local)) timezone.value = local; } catch { /* 既定の日本時間を使う */ }
    const formatDate = (value: string) => new Intl.DateTimeFormat('ja-JP', { dateStyle: 'medium', timeStyle: 'short', timeZone: timezone.value }).format(new Date(value));
    const dateParts = (value: string) => Object.fromEntries(new Intl.DateTimeFormat('en-CA', { timeZone: timezone.value, year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', hour12: false }).formatToParts(new Date(value)).filter((part) => part.type !== 'literal').map((part) => [part.type, part.value]));
    const holidayName = (key: string) => {
      const [year, month, day] = key.split('-').map(Number); const zone = timezone.value;
      const fixed: Record<string, Record<string, string>> = {
        'Asia/Tokyo': {'01-01':'元日','02-11':'建国記念の日','02-23':'天皇誕生日','04-29':'昭和の日','05-03':'憲法記念日','05-04':'みどりの日','05-05':'こどもの日','08-11':'山の日','11-03':'文化の日','11-23':'勤労感謝の日'},
        'Asia/Seoul': {'01-01':'元日','03-01':'三一節','05-05':'こどもの日','06-06':'顕忠日','08-15':'光復節','10-03':'開天節','10-09':'ハングルの日','12-25':'クリスマス'},
        'Asia/Taipei': {'01-01':'元日','02-28':'和平記念日','05-01':'労働節','10-10':'国慶日','12-25':'行憲紀念日'},
        'America/New_York': {'01-01':'New Year’s Day','07-04':'Independence Day','11-11':'Veterans Day','12-25':'Christmas Day'},
        'America/Chicago': {'01-01':'New Year’s Day','07-04':'Independence Day','11-11':'Veterans Day','12-25':'Christmas Day'},
        'America/Denver': {'01-01':'New Year’s Day','07-04':'Independence Day','11-11':'Veterans Day','12-25':'Christmas Day'},
        'America/Los_Angeles': {'01-01':'New Year’s Day','07-04':'Independence Day','11-11':'Veterans Day','12-25':'Christmas Day'},
        'Europe/London': {'01-01':'New Year’s Day','12-25':'Christmas Day','12-26':'Boxing Day'},
        'Europe/Paris': {'01-01':'Jour de l’An','05-01':'Fête du Travail','07-14':'Fête nationale','11-11':'Armistice','12-25':'Noël'},
      };
      const name = fixed[zone]?.[`${String(month).padStart(2,'0')}-${String(day).padStart(2,'0')}`]; if (name) return name;
      // 日本の移動祝日（春分・秋分を除く）は年に依存するため、代表的な月曜祝日を計算する。
      if (zone === 'Asia/Tokyo') { const dow = new Date(year, month - 1, day).getDay(); if (month === 1 && dow === 1 && day >= 8 && day <= 14) return '成人の日'; if (month === 7 && dow === 1 && day >= 15 && day <= 21) return '海の日'; if (month === 9 && dow === 1 && day >= 15 && day <= 21) return '敬老の日'; if (month === 10 && dow === 1 && day >= 8 && day <= 14) return 'スポーツの日'; }
      return '';
    };
    const renderCalendar = () => {
      const first = new Date(month.getFullYear(), month.getMonth(), 1), last = new Date(month.getFullYear(), month.getMonth() + 1, 0);
      calendarTitle.textContent = new Intl.DateTimeFormat('ja-JP', { year: 'numeric', month: 'long' }).format(first);
      const cells = ['日','月','火','水','木','金','土'].map((day) => `<div class="calendar-cell calendar-cell--blank"><span class="calendar-day">${day}</span></div>`);
      for (let index = 0; index < first.getDay(); index += 1) cells.push('<div class="calendar-cell calendar-cell--blank"></div>');
      for (let day = 1; day <= last.getDate(); day += 1) {
        const key = `${month.getFullYear()}-${String(month.getMonth() + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
        const dayEvents = (data.events ?? []).filter((event) => { const parts = dateParts(event.starts_at); return `${parts.year}-${parts.month}-${parts.day}` === key; });
        const holiday = holidayName(key); cells.push(`<div class="calendar-cell${holiday ? ' calendar-cell--holiday' : ''}"><span class="calendar-day">${day}</span>${holiday ? `<span class="calendar-holiday" title="祝日">${escapeHtml(holiday)}</span>` : ''}${dayEvents.map((event) => { const parts = dateParts(event.starts_at); return `<span class="calendar-event" title="${escapeHtml(event.title)}">${parts.hour}:${parts.minute} ${escapeHtml(event.title)}</span>`; }).join('')}</div>`);
      }
      calendar.innerHTML = cells.join('');
    };
    const render = () => {
      const members = new Map((data.members ?? []).map((member) => [member.email, member.display_name || '表示名未設定']));
      projectTitle.textContent = `${data.project?.name || 'プロジェクト'}：進捗・ToDo・日程`;
      get<HTMLElement>('[data-event-create]').hidden = !data.scope.isManager;
      assignee.innerHTML = '<option value="">担当者を指定しない</option>' + (data.members ?? []).map((member) => `<option value="${escapeHtml(member.email)}">${escapeHtml(member.display_name || '表示名未設定')}</option>`).join('');
      reports.innerHTML = (data.progress ?? []).map((item) => `<article class="item"><span>${escapeHtml(String(item.body ?? ''))}</span><small>自分が投げた進捗報告 ・ ${formatDate(String(item.created_at))}</small></article>`).join('') || '<p>自分が投げた進捗報告はまだありません。</p>';
      const visibleTasks = (data.tasks ?? []).filter((item) => taskFilter === 'all' || (taskFilter === 'assigned' ? item.assignee_email === data.scope.email : item.created_by === data.scope.email));
      tasks.innerHTML = visibleTasks.map((item) => `<article class="item"><div class="task-row"><b>${escapeHtml(String(item.title ?? ''))}</b><select aria-label="${escapeHtml(String(item.title ?? 'タスク'))}の状態" data-task-status="${escapeHtml(String(item.id))}"><option value="open" ${item.status === 'open' ? 'selected' : ''}>未着手</option><option value="doing" ${item.status === 'doing' ? 'selected' : ''}>進行中</option><option value="done" ${item.status === 'done' ? 'selected' : ''}>完了</option></select></div><small><span class="task-role">${item.assignee_email === data.scope.email ? '自分がこなす' : item.created_by === data.scope.email ? '自分が依頼' : 'すべて'}</span> ${escapeHtml(String(item.subject || '全体'))}${item.assignee_email ? ` ・担当：${escapeHtml(members.get(String(item.assignee_email)) || '表示名未設定')}` : ' ・担当未指定'}${item.created_by ? ` ・依頼者：${escapeHtml(String(item.created_by === data.scope.email ? '自分' : item.created_by))}` : ''}${item.due_at ? ` ・期限：${escapeHtml(String(item.due_at).replace('T',' '))}（${escapeHtml(String(item.due_timezone || 'Asia/Tokyo'))}）` : ''}</small>${item.details ? `<small>${escapeHtml(String(item.details))}</small>` : ''}${taskReminderEditor(item)}</article>`).join('') || '<p>この条件のToDoはありません。</p>';
      const availabilityLabels: Record<string, string> = { available: '参加できる', maybe: '未定', unavailable: '参加できない' };
      events.innerHTML = (data.events ?? []).map((item) => { const counts = item.availabilityCounts ?? {}; const participants = item.participants ?? []; return `<article class="item"><div class="event-heading"><b>${escapeHtml(item.title)}</b>${data.scope.isManager ? `<button type="button" class="event-delete" data-delete-event="${escapeHtml(item.id)}">この日程を削除</button>` : ''}</div><small>${formatDate(item.starts_at)}${item.ends_at ? ` 〜 ${formatDate(item.ends_at)}` : ''}</small><div class="availability">${Object.entries(availabilityLabels).map(([value, label]) => `<button type="button" class="${item.availability === value ? 'is-selected' : ''}" aria-pressed="${item.availability === value}" data-availability="${value}" data-event="${escapeHtml(item.id)}">${label}${item.availability === value ? ' ✓' : ''}</button>`).join('')}</div><div class="participant-summary"><div class="participant-counts"><span>参加 ${counts.available ?? 0}</span><span>未定 ${counts.maybe ?? 0}</span><span>不参加 ${counts.unavailable ?? 0}</span></div><div class="participant-names">${participants.length ? participants.map((participant) => `<span class="participant-chip participant-${escapeHtml(participant.availability)}">${escapeHtml(participant.isSelf ? '自分' : participant.displayName)}：${escapeHtml(availabilityLabels[participant.availability] ?? participant.availability)}</span>`).join('') : '<span>まだ参加登録はありません。</span>'}</div></div></article>`; }).join('') || '<p>登録された日程はありません。</p>';
      const blocks = data.availabilityBlocks ?? [];
      get<HTMLElement>('[data-block-list]').innerHTML = blocks.length ? blocks.map((item) => `<div class="item availability-block-item"><span><b>${item.kind === 'available' ? '動ける' : '動けない'}</b> ・ ${escapeHtml(String(item.starts_at).replace('T',' '))} 〜 ${escapeHtml(String(item.ends_at).replace('T',' '))}${item.label ? ` ・ ${escapeHtml(String(item.label))}` : ''}</span><button type="button" class="event-delete" data-delete-block="${escapeHtml(String(item.id))}">削除</button></div>`).join('') : '<p>登録した可否期間はありません。</p>';
      renderCalendar();
    };
    const load = async () => { data = await api<OperationData>(`/api/admin/operations?project=${encodeURIComponent(projectId)}`); render(); };
    const runButtonAction = async (button: HTMLButtonElement, feedback: HTMLOutputElement, action: () => Promise<void>, success: string) => { button.disabled = true; feedback.value = '保存中…'; try { await action(); feedback.value = success; await load(); } catch (error) { feedback.value = error instanceof Error ? error.message : '保存できませんでした。'; } finally { button.disabled = false; } };
    get<HTMLButtonElement>('[data-send-progress]').addEventListener('click', (event) => { const button = event.currentTarget as HTMLButtonElement; void runButtonAction(button, progressFeedback, async () => { await api('/api/admin/operations/progress', 'POST', { projectId, body: progress.value }); progress.value = ''; }, '進捗を記録しました。'); });
    get<HTMLButtonElement>('[data-create-task]').addEventListener('click', (event) => { const button = event.currentTarget as HTMLButtonElement; void runButtonAction(button, taskFeedback, async () => { await api('/api/admin/operations/tasks', 'POST', { projectId, title: get<HTMLInputElement>('[data-task-title]').value, subject: get<HTMLSelectElement>('[data-task-subject]').value, assigneeEmail: assignee.value, dueAt: taskDue.value, dueTimezone: taskDueTimezone.value, details: get<HTMLTextAreaElement>('[data-task-details]').value, reminders: collectReminderRows(taskReminderList, taskReminderRepeat.value), reminderRepeat: taskReminderRepeat.value, reminderEmail: taskReminderEmail.value }); taskDue.value = ''; }, 'ToDoを追加しました。'); });
    get<HTMLButtonElement>('[data-add-task-reminder]').addEventListener('click', () => { taskReminderList.insertAdjacentHTML('beforeend', reminderRowHtml()); refreshReminderRows(taskReminderList); });
    refreshReminderRows(taskReminderList);
    root.addEventListener('change', (event) => { const row = (event.target as HTMLElement).closest<HTMLElement>('[data-task-reminder-row]'); if (row) refreshReminderRow(row); });
    root.addEventListener('click', (event) => { const target = event.target as HTMLElement; const remove = target.closest<HTMLButtonElement>('[data-remove-reminder]'); if (remove) { remove.closest<HTMLElement>('[data-task-reminder-row]')?.remove(); return; } const add = target.closest<HTMLButtonElement>('[data-add-reminder]'); if (add) { const container = add.closest<HTMLElement>('[data-reminder-editor]')?.querySelector<HTMLElement>('.task-reminder-rules'); if (container) { container.insertAdjacentHTML('beforeend', reminderRowHtml()); refreshReminderRows(container); } return; } const save = target.closest<HTMLButtonElement>('[data-save-reminders]'); if (!save) return; const editor = save.closest<HTMLElement>('[data-reminder-editor]'); if (!editor) return; const feedback = editor.querySelector<HTMLOutputElement>('[data-reminder-feedback]'); const repeat = editor.querySelector<HTMLSelectElement>('[data-reminder-repeat]')?.value || 'none'; const email = editor.querySelector<HTMLInputElement>('[data-reminder-email]')?.value || ''; const reminderContainer = editor.querySelector<HTMLElement>('.task-reminder-rules'); if (!feedback || !reminderContainer) return; void runButtonAction(save, feedback, async () => { await api(`/api/admin/operations/tasks/${encodeURIComponent(editor.dataset.reminderEditor || '')}`, 'PATCH', { reminderAction: 'replace', reminders: collectReminderRows(reminderContainer, repeat), reminderEmail: email }); }, 'リマインダーを保存しました。'); });
    get<HTMLButtonElement>('[data-create-event]').addEventListener('click', (event) => { const button = event.currentTarget as HTMLButtonElement; void runButtonAction(button, eventFeedback, async () => { await api('/api/admin/operations/events', 'POST', { projectId, title: get<HTMLInputElement>('[data-event-title]').value, startsAt: get<HTMLInputElement>('[data-event-start]').value, endsAt: get<HTMLInputElement>('[data-event-end]').value, details: get<HTMLInputElement>('[data-event-details]').value, timezone: get<HTMLSelectElement>('[data-event-timezone]').value }); }, '日程を追加しました。'); });
    root.querySelectorAll<HTMLButtonElement>('[data-task-filter]').forEach((button) => button.addEventListener('click', () => { taskFilter = (button.dataset.taskFilter as typeof taskFilter) || 'assigned'; root.querySelectorAll<HTMLButtonElement>('[data-task-filter]').forEach((item) => { const active = item === button; item.classList.toggle('is-selected', active); item.setAttribute('aria-pressed', String(active)); }); render(); }));
    get<HTMLButtonElement>('[data-create-block]').addEventListener('click', (event) => { const button = event.currentTarget as HTMLButtonElement; void runButtonAction(button, blockFeedback, async () => { await api('/api/admin/operations/availability-blocks', 'POST', { startsAt: get<HTMLInputElement>('[data-block-start]').value, endsAt: get<HTMLInputElement>('[data-block-end]').value, timezone: timezone.value, kind: get<HTMLSelectElement>('[data-block-kind]').value, label: get<HTMLInputElement>('[data-block-label]').value }); }, '可否期間を追加しました。'); });
    tasks.addEventListener('change', (event) => { const select = (event.target as HTMLElement).closest<HTMLSelectElement>('[data-task-status]'); if (!select) return; select.disabled = true; void api(`/api/admin/operations/tasks/${encodeURIComponent(select.dataset.taskStatus ?? '')}`, 'PATCH', { status: select.value }).then(load).catch((error) => { taskFeedback.value = error instanceof Error ? error.message : '状態を更新できませんでした。'; }).finally(() => { select.disabled = false; }); });
    events.addEventListener('click', (event) => { const target = event.target as HTMLElement; const deleteButton = target.closest<HTMLButtonElement>('[data-delete-event]'); if (deleteButton) { if (!confirm('この日程と参加登録を削除しますか？')) return; deleteButton.disabled = true; eventFeedback.value = '日程を削除中…'; void api(`/api/admin/operations/events/${encodeURIComponent(deleteButton.dataset.deleteEvent ?? '')}`, 'DELETE').then(async () => { eventFeedback.value = '日程を削除しました。'; await load(); }).catch((error) => { eventFeedback.value = error instanceof Error ? error.message : '日程を削除できませんでした。'; }).finally(() => { deleteButton.disabled = false; }); return; } const button = target.closest<HTMLButtonElement>('[data-availability]'); if (!button) return; button.disabled = true; eventFeedback.value = '参加状態を保存中…'; void api(`/api/admin/operations/events/${encodeURIComponent(button.dataset.event ?? '')}/availability`, 'PUT', { availability: button.dataset.availability }).then(async () => { eventFeedback.value = '参加状態を保存しました。'; await load(); }).catch((error) => { eventFeedback.value = error instanceof Error ? error.message : '参加状態を保存できませんでした。'; }).finally(() => { button.disabled = false; }); });
    root.querySelector<HTMLElement>('[data-block-list]')!.addEventListener('click', (event) => { const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-delete-block]'); if (!button) return; button.disabled = true; void api(`/api/admin/operations/availability-blocks/${encodeURIComponent(button.dataset.deleteBlock ?? '')}`, 'DELETE').then(load).catch((error) => { blockFeedback.value = error instanceof Error ? error.message : '可否期間を削除できませんでした。'; }).finally(() => { button.disabled = false; }); });
    get<HTMLButtonElement>('[data-calendar-prev]').addEventListener('click', () => { month = new Date(month.getFullYear(), month.getMonth() - 1, 1); renderCalendar(); });
    get<HTMLButtonElement>('[data-calendar-next]').addEventListener('click', () => { month = new Date(month.getFullYear(), month.getMonth() + 1, 1); renderCalendar(); });
    timezone.addEventListener('change', () => { render(); });
    void load().catch((error) => { const message = error instanceof Error ? error.message : '進行管理を読み込めませんでした。'; tasks.textContent = message; events.textContent = message; reports.textContent = message; calendarTitle.textContent = '読み込めませんでした'; });
  };
  document.addEventListener('astro:page-load', initializeOperations);
  initializeOperations();
</script>
