---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { getCollection } from "astro:content";
const subjects = (await getCollection("subjects")).sort((a, b) => a.data.order - b.data.order).map((subject) => ({ slug: subject.data.slug, name: subject.data.name.ja }));
const timezones = [
  ["Asia/Tokyo", "日本（東京）"], ["Asia/Seoul", "韓国（ソウル）"], ["Asia/Shanghai", "中国（上海）"], ["Asia/Taipei", "台湾（台北）"], ["Asia/Hong_Kong", "香港"], ["Asia/Singapore", "シンガポール"], ["Asia/Bangkok", "タイ（バンコク）"], ["Asia/Kolkata", "インド（コルカタ）"], ["Asia/Dubai", "アラブ首長国連邦（ドバイ）"], ["Australia/Sydney", "オーストラリア（シドニー）"], ["Pacific/Auckland", "ニュージーランド（オークランド）"], ["Europe/London", "英国（ロンドン）"], ["Europe/Paris", "フランス・中央ヨーロッパ"], ["Europe/Berlin", "ドイツ（ベルリン）"], ["Europe/Rome", "イタリア（ローマ）"], ["Europe/Madrid", "スペイン（マドリード）"], ["Europe/Moscow", "ロシア（モスクワ）"], ["Africa/Cairo", "エジプト（カイロ）"], ["Africa/Johannesburg", "南アフリカ（ヨハネスブルク）"], ["America/Sao_Paulo", "ブラジル（サンパウロ）"], ["America/New_York", "米国東部（ニューヨーク）"], ["America/Chicago", "米国中部（シカゴ）"], ["America/Denver", "米国山岳部（デンバー）"], ["America/Los_Angeles", "米国太平洋（ロサンゼルス）"], ["America/Anchorage", "米国アラスカ"], ["Pacific/Honolulu", "米国ハワイ"], ["America/Toronto", "カナダ（トロント）"], ["America/Vancouver", "カナダ（バンクーバー）"], ["America/Mexico_City", "メキシコ（メキシコシティ）"], ["UTC", "協定世界時（UTC）"],
] as const;
const holidayCountries = [
  ["JP", "日本"], ["US", "米国"], ["GB", "英国"], ["FR", "フランス"], ["DE", "ドイツ"], ["KR", "韓国"], ["CN", "中国"], ["TW", "台湾"], ["IN", "インド"], ["AU", "オーストラリア"], ["CA", "カナダ"],
] as const;
const calendarSystems = [["gregory", "西暦（グレゴリオ暦）"], ["japanese", "和暦（日本）"]] as const;
const calendarPage = Astro.url.pathname.replace(/\/$/, "") === "/admin/calendar";
const calendarSettings = Astro.url.searchParams.get("tab") === "settings";
const projectQuery = Astro.url.searchParams.get("project") ?? "atlas";
---

<AdminLayout title={calendarPage ? "カレンダー" : "タスク管理"} description="運営作業を共有する場所">
  <main class="operations" data-operations data-calendar-view={calendarSettings ? "settings" : "agenda"}>
    <header>
      <h1 data-project-title>{calendarPage ? "カレンダー" : "タスク管理"}</h1>
      <span>{calendarPage ? "日程、参加可否、祝日を確認します。" : "進捗報告と、次に行うタスクを共有します。"}</span>
      <nav class="operations-tabs" aria-label="タスクとカレンダー"><a href={`/admin/operations/${Astro.url.search}`} aria-current={!calendarPage ? "page" : undefined}>タスク管理</a><a href={`/admin/calendar/${Astro.url.search}`} aria-current={calendarPage ? "page" : undefined}>カレンダー</a></nav>
    </header>
    <div class="grid">
      <section hidden={calendarPage}>
        <h2>進捗を報告</h2>
        <p>編集・査読の完了後に、ここへ短く記録できます。</p>
        <p class="discord-notice">
          記録すると、設定済みの分野Discordチャンネルと全体進捗チャンネルへ自動転送されます。
        </p>
        <label class="field-label"
          >進捗内容<textarea
            data-progress
            placeholder="例：群の定義を修正し、査読コメント3件に対応しました。"
          ></textarea></label
        ><button data-send-progress>進捗を記録してDiscordへ送る</button
        ><output data-progress-feedback aria-live="polite"></output>
        <h3 class="subheading">自分が投げた進捗報告</h3>
        <div data-progress-list></div>
      </section>
      <section hidden={calendarPage}>
        <h2>タスク作成・依頼</h2>
        <p>
          表示対象を切り替えると、このフォームの下にあるタスク一覧が変わります。
        </p>
        <div class="task-filters" role="group" aria-label="タスクの表示対象">
          <button
            type="button"
            class="is-selected"
            data-task-filter="assigned"
            aria-pressed="true"
          >
            自分がこなす</button
          ><button
            type="button"
            data-task-filter="created"
            aria-pressed="false"
          >
            自分が依頼</button
          ><button type="button" data-task-filter="all" aria-pressed="false">
            すべて
          </button>
        </div>
        <input data-task-title placeholder="タスク名" /><label
          class="field-label"
          >対象分野<select data-task-subject>
            <option value="">全体</option>
            {subjects.map((subject) => <option value={subject.slug}>{subject.name}</option>)}
          </select></label
        ><label class="field-label"
          >担当者<select data-task-assignee>
            <option value="">担当者を指定しない</option>
          </select></label
        >
        <div class="task-deadline">
          <label class="field-label"
            >期限日時<input data-task-due type="datetime-local" /></label
          ><label class="field-label"
            >期限のタイムゾーン<select data-task-due-timezone>
              {timezones.map(([value, label]) => <option value={value} selected={value === "Asia/Tokyo"}>{label}</option>)}
            </select></label
          >
        </div>
        <div class="task-reminder-settings">
          <h3>自分用リマインダー</h3>
          <p>
            期限基準の「N日前」「N時間前」「当日毎時」、または指定日時を複数登録できます。メール欄が空欄なら通知ベルに表示します。
          </p>
          <div data-task-reminder-list>
            <div class="task-reminder-row" data-task-reminder-row>
              <label class="field-label"
                >種類<select data-reminder-kind>
                  <option value="before_days">N日前</option>
                  <option value="before_hours">N時間前</option>
                  <option value="due_day_hourly">当日毎時</option>
                  <option value="absolute">指定日時</option>
                </select></label
              ><label class="field-label" data-reminder-amount-label
                >数量<input
                  data-reminder-amount
                  type="number"
                  min="1"
                  max="8760"
                  placeholder="N" /></label
              ><label class="field-label" data-reminder-start-label hidden
                >開始時刻<input
                  data-reminder-start
                  type="time"
                  value="09:00" /></label
              ><label class="field-label" data-reminder-at-label hidden
                >日時<input data-reminder-at type="datetime-local" /></label
              ><button
                type="button"
                class="task-reminder-remove"
                data-remove-reminder
                hidden
              >
                削除
              </button>
            </div>
          </div>
          <button type="button" class="secondary-button" data-add-task-reminder>
            リマインダーを追加</button
          ><label class="field-label"
            >指定日時の繰り返し（1つのリマインダーにのみ適用）<select
              data-task-reminder-repeat
            >
              <option value="none">1回</option>
              <option value="daily">毎日</option>
              <option value="weekly">毎週</option>
              <option value="monthly">毎月</option>
            </select></label
          ><label class="field-label"
            >自分の通知先メールアドレス（任意）<input
              data-task-reminder-email
              type="email"
              maxlength="254"
              placeholder="自分のメールアドレス"
          /></label>
        </div>
        <textarea
          data-task-details
          placeholder="補足・依頼内容（任意）"
        ></textarea
        ><button data-create-task>タスクを追加</button
        ><output
          class="operation-feedback"
          data-task-feedback
          aria-live="polite"
        ></output>
        <div data-task-list aria-live="polite"></div>
      </section>
      <section class="wide" hidden={!calendarPage}>
        <h2>同時作業会・交流会の日程</h2>
        <p>
          日付をクリック、またはドラッグして、自分が動ける／動けない期間を登録できます。
        </p>
        <nav class="calendar-view-tabs" aria-label="カレンダー表示"><a href={`/admin/calendar/?project=${encodeURIComponent(projectQuery)}`} data-calendar-tab="agenda" aria-current={!calendarSettings ? "page" : undefined}>予定</a><a href={`/admin/calendar/?project=${encodeURIComponent(projectQuery)}&tab=settings`} data-calendar-tab="settings" aria-current={calendarSettings ? "page" : undefined}>設定</a></nav>
        <div class="calendar-settings" aria-label="カレンダー表示設定">
          <label class="field-label timezone-combobox"
            >表示するタイムゾーン
            <div>
              <input
                data-calendar-timezone
                role="combobox"
                aria-label="表示するタイムゾーン"
                aria-autocomplete="list"
                aria-expanded="false"
                aria-controls="atlasez-timezone-options"
                value="Asia/Tokyo"
                placeholder="タイムゾーンを検索"
              /><button
                type="button"
                data-timezone-toggle
                aria-label="タイムゾーン候補を開く"
              >
                ▼
              </button>
            </div>
            <div
              id="atlasez-timezone-options"
              class="timezone-options"
              data-timezone-options
              role="listbox"
              hidden
            ></div></label
          ><label class="field-label holiday-picker"
            >表示する祝日の国・地域（複数選択可）
            <div class="holiday-tags" data-holiday-tags></div>
            <button type="button" class="holiday-add" data-holiday-add aria-expanded="false">タグを追加</button>
            <select
              data-calendar-holiday-country
              multiple
              size="4"
            >
              {holidayCountries.map(([value, label]) => <option value={value} selected={value === "JP"}>{label}</option>)}
            </select></label
          ><label class="field-label"
            >暦の表示<select data-calendar-system>
              {calendarSystems.map(([value, label]) => <option value={value} selected={value === "gregory"}>{label}</option>)}
            </select></label
          >
        </div>
        <datalist id="atlasez-timezone-datalist">
          {timezones.map(([value, label]) => <option value={value} label={label}></option>)}
        </datalist>
        <div class="calendar-head">
          <button type="button" data-calendar-prev aria-label="前の月">‹</button
          ><strong data-calendar-title>読み込み中…</strong
          ><button type="button" data-calendar-next aria-label="次の月">
            ›
          </button>
        </div>
        <div
          class="calendar-week"
          data-event-calendar
          aria-label="日程カレンダー"
        ></div>
        <small class="calendar-note"
          >祝日は date-holidays
          で自動計算します（206か国と対応する州・地域、ISC。データ: CC BY-SA
          3.0）。未対応の地域は公開iCalを追加する方式へ拡張できます。</small
        >
        <div class="event-create" data-event-create hidden>
          <input data-event-title placeholder="催し名" /><input
            data-event-start
            type="datetime-local"
            aria-label="開始日時"
          /><input
            data-event-end
            type="datetime-local"
            aria-label="終了日時"
          /><input
            data-event-details
            placeholder="場所・URL・補足"
            aria-label="場所・URL・補足"
          /><input
            data-event-timezone
            list="atlasez-timezone-datalist"
            value="Asia/Tokyo"
            placeholder="日程の基準タイムゾーン"
            aria-label="日程の基準タイムゾーン"
          /><button data-create-event>日程を追加</button>
        </div>
        <output
          class="operation-feedback"
          data-event-feedback
          aria-live="polite"
        ></output>
        <div data-event-list aria-live="polite"></div>
        <details class="availability-blocks" data-block-editor>
          <summary>自分の可否期間を登録</summary>
          <p>
            終日が初期値です。必要な場合だけ時刻を指定できます。他メンバーには表示名と可否だけを共有し、メモは本人と管理者だけに表示します。
          </p>
          <label class="all-day-toggle"
            ><input type="checkbox" data-block-all-day checked />終日</label
          >
          <div class="availability-block-form">
            <input
              data-block-start
              type="datetime-local"
              aria-label="可否期間の開始"
            /><input
              data-block-end
              type="datetime-local"
              aria-label="可否期間の終了"
            /><select data-block-kind aria-label="可否">
              <option value="unavailable">動けない</option>
              <option value="available">動ける</option></select
            ><input data-block-label placeholder="理由・メモ（任意）" /><button
              type="button"
              data-create-block
            >
              期間を追加
            </button>
          </div>
          <output
            class="operation-feedback"
            data-block-feedback
            aria-live="polite"
          ></output>
          <div data-block-list></div>
        </details>
      </section>
    </div>
  </main>
</AdminLayout>
<style is:global>
  .operations {
    margin: 0 auto;
    max-width: 1200px;
    padding: 0 1.25rem 4rem;
  }
  .operations > header {
    border-bottom: 1px solid var(--border-default);
    padding: 2rem 0 1.25rem;
  }
  .operations > header p {
    color: var(--accent-primary);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    margin: 0;
  }
  .operations h1 {
    font-size: 2rem;
    margin: 0.25rem 0;
  }
  .operations > header span,
  .operations section > p {
    color: var(--text-secondary);
    line-height: 1.6;
  }
  .operations-tabs { display:flex; gap:.35rem; margin-top:.75rem; }
  .operations-tabs a { border:1px solid var(--border-default); color:var(--text-primary); font-size:.76rem; font-weight:800; padding:.4rem .65rem; text-decoration:none; }
  .operations-tabs a[aria-current="page"] { background:var(--accent-primary); border-color:var(--accent-primary); color:#fff; }
  .calendar-view-tabs { border-bottom:1px solid var(--border-default); display:flex; gap:.2rem; margin:.75rem 0; }
  .calendar-view-tabs a { border-bottom:3px solid transparent; color:var(--text-secondary); font-size:.78rem; font-weight:800; padding:.45rem .7rem; text-decoration:none; }
  .calendar-view-tabs a[aria-current="page"] { border-bottom-color:var(--accent-primary); color:var(--accent-primary); }
  .operations[data-calendar-view="agenda"] .calendar-settings { display:none; }
  .operations[data-calendar-view="settings"] .calendar-head,
  .operations[data-calendar-view="settings"] .calendar-week,
  .operations[data-calendar-view="settings"] .calendar-note,
  .operations[data-calendar-view="settings"] .event-create,
  .operations[data-calendar-view="settings"] [data-event-feedback],
  .operations[data-calendar-view="settings"] [data-event-list],
  .operations[data-calendar-view="settings"] .availability-blocks { display:none!important; }
  .grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr 1fr;
    margin-top: 1.25rem;
  }
  .grid section {
    border: 1px solid var(--border-default);
    padding: 1rem;
  }
  .grid h2 {
    font-size: 1.1rem;
    margin: 0;
  }
  .grid section > p {
    font-size: 0.82rem;
    margin: 0.4rem 0 0.8rem;
  }
  .wide {
    grid-column: span 2;
  }
  .operations input,
  .operations textarea {
    background: var(--background-primary);
    border: 1px solid var(--border-default);
    box-sizing: border-box;
    color: var(--text-primary);
    font: inherit;
    margin: 0.25rem 0;
    padding: 0.55rem;
    width: 100%;
  }
  .operations textarea {
    min-height: 6rem;
    resize: vertical;
  }
  .operations button {
    background: var(--accent-primary);
    border: 1px solid var(--accent-primary);
    color: #fff;
    cursor: pointer;
    font: inherit;
    font-size: 0.82rem;
    font-weight: 800;
    margin-top: 0.35rem;
    padding: 0.5rem 0.7rem;
  }
  .item {
    border-top: 1px solid var(--border-default);
    display: grid;
    gap: 0.3rem;
    margin-top: 0.85rem;
    padding: 0.7rem 0;
  }
  .item small {
    color: var(--text-secondary);
  }
  .task-row {
    align-items: center;
    display: flex;
    gap: 0.5rem;
    justify-content: space-between;
  }
  .task-row select {
    font: inherit;
    padding: 0.25rem;
  }
  .event-create {
    display: grid;
    gap: 0.35rem;
    grid-template-columns: 1fr 1fr 1fr auto;
  }
  .event-create[hidden] {
    display: none !important;
  }
  .availability {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .availability button {
    background: var(--background-secondary);
    border-color: var(--border-default);
    color: var(--text-primary);
  }
  .availability button:hover {
    border-color: var(--accent-primary);
    color: var(--accent-primary);
  }
  @media (max-width: 700px) {
    .operations {
      padding: 0 0.8rem 3rem;
    }
    .operations > header {
      align-items: start;
      display: block;
    }
    .grid {
      grid-template-columns: 1fr;
    }
    .wide {
      grid-column: auto;
    }
    .event-create {
      grid-template-columns: 1fr;
    }
    .task-row {
      align-items: start;
      display: grid;
    }
  }
  .calendar-head {
    align-items: center;
    display: flex;
    justify-content: center;
    gap: 0.7rem;
    margin: 1rem 0 0.55rem;
  }
  .calendar-head button {
    font-size: 1.2rem;
    line-height: 1;
    margin: 0;
    min-width: 2.2rem;
  }
  .calendar-week {
    display: grid;
    gap: 1px;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    background: var(--border-default);
    border: 1px solid var(--border-default);
  }
  .calendar-cell {
    background: var(--background-primary);
    min-height: 6.8rem;
    padding: 0.35rem;
  }
  .calendar-cell--blank {
    background: var(--background-secondary);
  }
  .calendar-day {
    color: var(--text-secondary);
    font-size: 0.7rem;
    font-weight: 800;
  }
  .calendar-event {
    background: color-mix(
      in srgb,
      var(--accent-primary) 13%,
      var(--background-primary)
    );
    border-left: 2px solid var(--accent-primary);
    display: block;
    font-size: 0.67rem;
    line-height: 1.35;
    margin-top: 0.25rem;
    overflow: hidden;
    padding: 0.15rem 0.25rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .calendar-note {
    color: var(--text-secondary);
    display: block;
    font-size: 0.72rem;
    margin-top: 0.5rem;
  }
  .event-create {
    grid-template-columns: 1fr 1fr 1fr minmax(125px, 0.7fr) auto;
  }
  @media (max-width: 700px) {
    .calendar-cell {
      min-height: 4.6rem;
      padding: 0.25rem;
    }
    .calendar-event {
      font-size: 0.58rem;
    }
    .event-create {
      grid-template-columns: 1fr;
    }
  }
  .calendar-settings {
    display: grid;
    gap: 0.65rem;
    grid-template-columns: 1.35fr 1fr 1fr;
  }
  .holiday-picker { align-content:start; position:relative; }
  .holiday-picker > select { display:none; }
  .holiday-picker.is-open > select { display:block; max-height:11rem; position:absolute; top:100%; z-index:25; }
  .holiday-tags { display:flex; flex-wrap:wrap; gap:.3rem; min-height:2rem; }
  .holiday-tags button { background:var(--background-secondary); border-color:var(--border-default); border-radius:999px; color:var(--text-primary); font-size:.7rem; margin:0; padding:.25rem .45rem; }
  .holiday-tags span { color:var(--text-secondary); font-size:.72rem; }
  .holiday-add { background:var(--background-primary)!important; border-color:var(--accent-primary)!important; color:var(--accent-primary)!important; justify-self:start; margin:0!important; }
  .calendar-settings input,
  .calendar-settings select {
    margin: 0.25rem 0;
  }
  .calendar-settings input[list] {
    min-width: 0;
  }
  .calendar-note {
    line-height: 1.5;
  }
  @media (max-width: 700px) {
    .calendar-settings {
      grid-template-columns: 1fr;
    }
  }
  .calendar-cell--holiday {
    background: color-mix(in srgb, #d9485f 8%, var(--background-primary));
  }
  .calendar-holiday {
    color: #b33649;
    display: block;
    font-size: 0.61rem;
    font-weight: 800;
    line-height: 1.25;
    margin-top: 0.15rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .task-deadline {
    display: grid;
    gap: 0.55rem;
    grid-template-columns: 1fr 1fr;
  }
  .task-deadline input,
  .task-deadline select {
    margin: 0.25rem 0;
  }
  @media (max-width: 700px) {
    .task-deadline {
      grid-template-columns: 1fr;
    }
  }
  button.calendar-cell {
    background: var(--background-primary);
    border: 0;
    color: var(--text-primary);
    margin: 0;
    min-height: 6.8rem;
    padding: 0.35rem;
    text-align: left;
    width: 100%;
  }
  button.calendar-cell:hover,
  button.calendar-cell:focus-visible {
    box-shadow: inset 0 0 0 2px var(--accent-primary);
  }
  button.calendar-cell--holiday {
    background: color-mix(in srgb, #d9485f 8%, var(--background-primary));
  }
  button.calendar-cell--selected {
    background: color-mix(in srgb, var(--accent-primary) 20%, var(--background-primary));
    box-shadow: inset 0 0 0 2px var(--accent-primary);
  }
  button.calendar-cell--today .calendar-day {
    align-items: center;
    background: var(--accent-primary);
    border-radius: 50%;
    color: #fff;
    display: inline-flex;
    height: 1.55rem;
    justify-content: center;
    width: 1.55rem;
  }
  .calendar-availability {
    border-radius: 0.25rem;
    display: block;
    font-size: 0.61rem;
    font-weight: 800;
    margin-top: 0.18rem;
    overflow: hidden;
    padding: 0.12rem 0.22rem;
    text-overflow: ellipsis;
    white-space: nowrap;
