  import { holidaysForRegions, localDateTimeToInstant, supportedHolidayRegions } from '../../lib/calendar-support';
  import { recurringCoWorkingEventsForMonth } from '../../lib/co-working-schedule';
  import { getTimeZoneOptions } from '../../lib/timezones';
  type OperationMember = { email: string; display_name?: string };
  type OperationParticipant = { displayName: string; availability: string; isSelf: boolean };
  type OperationEvent = { id: string; title: string; starts_at: string; ends_at?: string | null; details?: string | null; timezone?: string; source?: string; availability?: string | null; availabilityCounts?: Record<string, number>; participants?: OperationParticipant[] };
  type ReminderRule = { id?: string; remind_at?: string; timezone?: string; label?: string; relative_kind?: string; relative_amount?: number | null; relative_unit?: string | null; relative_start?: string | null; repeat?: string | null };
  type AvailabilityBlock = { id: string; email?: string; display_name?: string; starts_at: string; ends_at: string; timezone: string; label?: string; kind: 'available' | 'unavailable'; isSelf?: boolean };
  type OperationData = { scope: { isManager: boolean; email?: string }; project?: { id: string; slug: string; name: string }; projects?: Array<{ id: string; slug: string; name: string; role?: string }>; tasks?: Array<Record<string, any>>; events?: OperationEvent[]; progress?: Array<Record<string, any>>; members?: OperationMember[]; availabilityBlocks?: AvailabilityBlock[] };
  const initializeOperations = () => {
    const root = document.querySelector<HTMLElement>('[data-operations]');
    if (!root || root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';
    const get = <T extends Element>(selector: string) => root.querySelector<T>(selector)!;
    const progress = get<HTMLTextAreaElement>('[data-progress]');
    const tasks = get<HTMLElement>('[data-task-list]');
    const events = get<HTMLElement>('[data-event-list]');
    const reports = get<HTMLElement>('[data-progress-list]');
    const progressSubject = get<HTMLSelectElement>('[data-progress-subject]');
    const progressProjectFilter = get<HTMLSelectElement>('[data-progress-project-filter]');
    const progressCount = get<HTMLElement>('[data-progress-count]');
    const progressOverview = root.dataset.progressOverview === 'true';
