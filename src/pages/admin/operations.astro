      timezoneOptions.addEventListener('click', (event) => { const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-timezone-value]'); if (!button) return; timezone.value = button.dataset.timezoneValue ?? 'UTC'; timezoneOptions.hidden = true; timezone.setAttribute('aria-expanded', 'false'); render(); });
