---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { getCollection } from "astro:content";
import { getTimeZoneOptions } from "../../lib/timezones";
const { memberMode = false, progressOnly = false, progressOverview = false } = Astro.props;
const subjects = (await getCollection("subjects")).sort((a, b) => a.data.order - b.data.order).map((subject) => ({ slug: subject.data.slug, name: subject.data.name.ja }));
const timezones = getTimeZoneOptions(new Date());
const holidayCountries = [
  ["JP", "日本"], ["US", "米国"], ["GB", "英国"], ["FR", "フランス"], ["DE", "ドイツ"], ["KR", "韓国"], ["CN", "中国"], ["TW", "台湾"], ["IN", "インド"], ["AU", "オーストラリア"], ["CA", "カナダ"],
] as const;
const calendarSystems = [["gregory", "西暦（グレゴリオ暦）"], ["japanese", "和暦（日本）"]] as const;
const calendarPage = memberMode || Astro.url.pathname.replace(/\/$/, "") === "/admin/calendar";
const requestedProject = Astro.url.searchParams.get("project");
const projectSlug = ["secretariat", "seminar-platform", "student-council-exchange", "thinking-cafe"].includes(requestedProject ?? "") ? requestedProject! : "atlas";
const projectLabel = projectSlug === "secretariat"
  ? "運営事務局"
  : projectSlug === "seminar-platform"
    ? "ゼミプラットフォーム"
    : projectSlug === "student-council-exchange"
      ? "日本生徒会協会"
      : projectSlug === "thinking-cafe"
        ? "考えるカフェ"
        : "アトラス";
const pageLabel = calendarPage ? "カレンダー" : progressOnly ? "進捗報告" : "タスク管理";
const initialPageTitle = memberMode ? "カレンダー" : `${projectLabel}：${pageLabel}`;
---

<AdminLayout title={initialPageTitle} description="運営作業を共有する場所">
  <main class="operations" data-operations data-member-mode={memberMode ? "true" : undefined} data-progress-only={progressOnly ? "true" : undefined} data-progress-overview={progressOverview ? "true" : undefined}>
    <header>
      <p class="operations-eyebrow">OPERATIONS / {projectLabel.toUpperCase()}</p>
      <h1 data-project-title>{initialPageTitle}</h1>
      <p class="operations-lede">共有タスクと進捗を、いま必要なものから確認できます。</p>
    </header>
    <div class="grid">
      <section hidden={calendarPage || !progressOnly}>
        <h2>進捗を報告</h2>
        <p>編集・フィードバックの完了後に、ここへ短く記録できます。</p>
        <p class="discord-notice">
          記録すると、設定済みの分野Discordチャンネルと全体進捗チャンネルへ自動転送されます。
        </p>
        <label class="field-label"
          >対象分野<select data-progress-subject>
            <option value="">全体</option>
            {subjects.map((subject) => <option value={subject.slug}>{subject.name}</option>)}
          </select></label
        ><label class="field-label"
          >進捗内容<textarea
            data-progress
            placeholder="例：群の定義を修正し、フィードバック3件に対応しました。"
          ></textarea></label
        ><button data-send-progress>進捗を記録してDiscordへ送る</button
        ><output data-progress-feedback aria-live="polite"></output>
        <div class="progress-list-heading">
          <h3 class="subheading">進捗報告一覧</h3>
          <span data-progress-count aria-live="polite"></span>
        </div>
        <div class="progress-filters" role="group" aria-label="進捗報告の絞り込み">
          <label class="field-label">プロジェクト<select data-progress-project-filter><option value="">すべてのプロジェクト</option></select></label>
          <fieldset class="progress-subject-filters">
            <legend>分野（複数選択可）</legend>
            <label><input type="checkbox" data-progress-subject-filter="all" checked />すべて</label>
            {subjects.map((subject) => <label><input type="checkbox" data-progress-subject-filter={subject.slug} />{subject.name}</label>)}
            <label><input type="checkbox" data-progress-subject-filter="__none__" />全体報告（分野指定なし）</label>
          </fieldset>
        </div>
        <div data-progress-list></div>
      </section>
      <section class="task-workspace" hidden={calendarPage || progressOnly}>
        <div class="task-list-heading">
          <div>
            <h2>タスク一覧</h2>
            <p>表示対象を切り替えると、一覧に表示するタスクが変わります。</p>
          </div>
          <button type="button" class="task-create-open" data-open-task-create aria-label="タスクを作成・依頼"><span aria-hidden="true">＋</span><span class="task-create-label">タスクを作成</span></button>
        </div>
        <div class="task-filters" role="group" aria-label="タスクの表示対象">
          <button
            type="button"
            class="is-selected"
            data-task-filter="assigned"
            aria-pressed="true"
          >
            自分がこなす</button
          ><button
            type="button"
            data-task-filter="created"
            aria-pressed="false"
          >
            自分が依頼</button
          ><button type="button" data-task-filter="all" aria-pressed="false">
            すべて
          </button>
        </div>
        <div data-task-list aria-live="polite"></div>
        <output class="operation-feedback" data-task-list-feedback aria-live="polite"></output>
        <dialog class="task-create-dialog" data-task-create-dialog aria-labelledby="task-create-heading">
          <div class="task-create-panel">
            <div class="task-create-heading">
              <h2 id="task-create-heading">タスク作成・依頼</h2>
              <button type="button" class="task-create-close" data-close-task-create aria-label="タスク作成画面を閉じる">×</button>
            </div>
        <input data-task-title placeholder="タスク名" /><label
          class="field-label"
          >対象分野<select data-task-subject>
            <option value="">全体</option>
            {subjects.map((subject) => <option value={subject.slug}>{subject.name}</option>)}
          </select></label
        ><label class="field-label"
          >担当者<select data-task-assignee multiple size="6" aria-describedby="task-assignee-help">
            <option value="" disabled>担当者を選択</option>
          </select><small id="task-assignee-help">複数人を選ぶには Ctrl（Windows）または⌘（Mac）を押しながら選択してください。</small></label
        >
        <div class="task-deadline">
          <label class="field-label"
            >期限日時<input data-task-due type="datetime-local" /></label
          ><label class="field-label"
            >期限のタイムゾーン<select data-task-due-timezone>
              {timezones.map(({ value, label }) => <option value={value} selected={value === "Asia/Tokyo"}>{label}</option>)}
            </select></label
          >
        </div>
        <div class="task-reminder-settings">
          <h3>自分用リマインダー</h3>
          <p>
            期限基準の「N日前」「N時間前」「当日毎時」、または指定日時を複数登録できます。メール欄が空欄なら通知ベルに表示します。
          </p>
          <div data-task-reminder-list>
            <div class="task-reminder-row" data-task-reminder-row>
              <label class="field-label"
                >種類<select data-reminder-kind>
                  <option value="before_days">N日前</option>
                  <option value="before_hours">N時間前</option>
                  <option value="due_day_hourly">当日毎時</option>
                  <option value="absolute">指定日時</option>
                </select></label
              ><label class="field-label" data-reminder-amount-label
                >数量<input
                  data-reminder-amount
                  type="number"
                  min="1"
                  max="8760"
                  placeholder="N" /></label
              ><label class="field-label" data-reminder-start-label hidden
                >開始時刻<input
                  data-reminder-start
                  type="time"
                  value="09:00" /></label
              ><label class="field-label" data-reminder-at-label hidden
                >日時<input data-reminder-at type="datetime-local" /></label
              ><button
                type="button"
                class="task-reminder-remove"
                data-remove-reminder
                hidden
              >
                削除
              </button>
            </div>
          </div>
          <button type="button" class="secondary-button" data-add-task-reminder>
            リマインダーを追加</button
          ><label class="field-label"
            >指定日時の繰り返し（1つのリマインダーにのみ適用）<select
              data-task-reminder-repeat
            >
              <option value="none">1回</option>
              <option value="daily">毎日</option>
              <option value="weekly">毎週</option>
              <option value="monthly">毎月</option>
            </select></label
          ><label class="field-label"
            >自分の通知先メールアドレス（任意）<input
              data-task-reminder-email
              type="email"
              maxlength="254"
              placeholder="自分のメールアドレス"
          /></label>
        </div>
        <textarea
          data-task-details
          placeholder="補足・依頼内容（任意）"
        ></textarea
        ><button type="button" data-create-task>タスクを追加</button
        ><output
          class="operation-feedback"
          data-task-feedback
          aria-live="polite"
        ></output>
          </div>
        </dialog>
      </section>
      <section class="wide" hidden={!calendarPage}>
        <h2>同時作業会・交流会の日程</h2>
        <p>
          日付をクリック、またはドラッグして、自分が動ける／動けない期間を登録できます。
        </p>
        <div class="calendar-actions"><button type="button" data-open-calendar-settings aria-haspopup="dialog">⚙️ 設定</button></div>
        <dialog class="calendar-settings-dialog" data-calendar-settings-dialog aria-labelledby="calendar-settings-heading">
          <div class="calendar-settings-heading"><h2 id="calendar-settings-heading">カレンダー設定</h2><button type="button" data-close-calendar-settings aria-label="設定を閉じる">×</button></div>
          <div class="calendar-settings" aria-label="カレンダー表示設定">
          <label class="field-label timezone-combobox"
            >表示タイムゾーン
            <div>
              <input
                data-calendar-timezone
                role="combobox"
                aria-label="表示タイムゾーン"
                aria-autocomplete="list"
                aria-expanded="false"
                aria-controls="atlasez-timezone-options"
                value="Asia/Tokyo"
                placeholder="タイムゾーンを検索"
              /><button
                type="button"
                data-timezone-toggle
                aria-label="タイムゾーン候補を開く"
              >
                ▼
              </button>
            </div>
            <output data-timezone-offset aria-live="polite"></output>
            <div
              id="atlasez-timezone-options"
              class="timezone-options"
              data-timezone-options
              role="listbox"
              hidden
            ></div></label
          ><label class="field-label holiday-picker"
            >表示する祝日の国・地域（複数選択可）
            <div class="holiday-tags" data-holiday-tags></div>
            <button type="button" class="holiday-add" data-holiday-add aria-expanded="false">タグを追加</button>
            <input type="search" data-holiday-search placeholder="国・地域名、コードで検索" aria-label="祝日の国・地域を検索" />
            <select
              data-calendar-holiday-country
              multiple
              size="4"
            >
              {holidayCountries.map(([value, label]) => <option value={value} selected={value === "JP"}>{label}</option>)}
            </select></label
          ><label class="field-label"
            >暦の表示<select data-calendar-system>
              {calendarSystems.map(([value, label]) => <option value={value} selected={value === "gregory"}>{label}</option>)}
            </select></label
          >
          </div>
        </dialog>
        <datalist id="atlasez-timezone-datalist">
          {timezones.map(({ value, label }) => <option value={value} label={label}></option>)}
        </datalist>
        <div class="calendar-head">
          <button type="button" data-calendar-prev aria-label="前の月">‹</button
          ><strong data-calendar-title>読み込み中…</strong
          ><button type="button" data-calendar-next aria-label="次の月">
            ›
          </button>
        </div>
        <div
          class="calendar-week"
          data-event-calendar
          aria-label="日程カレンダー"
        ></div>
        <div
          class="availability-popover"
          data-availability-popover
          role="dialog"
          aria-label="参加可否のメンバー詳細"
          hidden
        ></div>
        <small class="calendar-note"
          >祝日は date-holidays
          で自動計算します（206か国と対応する州・地域、ISC。データ: CC BY-SA
          3.0）。未対応の地域は公開iCalを追加する方式へ拡張できます。</small
        >
        <div class="event-create" data-event-create hidden>
          <input data-event-title placeholder="催し名" /><input
            data-event-start
            type="datetime-local"
            aria-label="開始日時"
          /><input
            data-event-end
            type="datetime-local"
            aria-label="終了日時"
          /><input
            data-event-details
            placeholder="場所・URL・補足"
            aria-label="場所・URL・補足"
          /><input
            data-event-timezone
            list="atlasez-timezone-datalist"
            value="Asia/Tokyo"
            placeholder="日程の基準タイムゾーン"
            aria-label="日程の基準タイムゾーン"
          /><button data-create-event>日程を追加</button>
        </div>
        <output
          class="operation-feedback"
          data-event-feedback
          aria-live="polite"
        ></output>
        <div data-event-list aria-live="polite"></div>
        <details class="availability-blocks" data-block-editor>
          <summary>自分の可否期間を登録</summary>
          <p>
            終日が初期値です。必要な場合だけ時刻を指定できます。他メンバーには表示名と可否だけを共有し、メモは本人と管理者だけに表示します。
          </p>
          <label class="all-day-toggle"
            ><input type="checkbox" data-block-all-day checked />終日</label
          >
          <div class="availability-block-form">
            <input
              data-block-start
              type="datetime-local"
              aria-label="可否期間の開始"
            /><input
              data-block-end
              type="datetime-local"
              aria-label="可否期間の終了"
            /><select data-block-kind aria-label="可否">
              <option value="unavailable">動けない</option>
              <option value="available">動ける</option></select
            ><input data-block-label placeholder="理由・メモ（任意）" /><button
              type="button"
              data-create-block
            >
              期間を追加
            </button>
          </div>
          <output
            class="operation-feedback"
            data-block-feedback
            aria-live="polite"
          ></output>
          <div data-block-list></div>
        </details>
      </section>
    </div>
  </main>
</AdminLayout>
<style is:global>
  .operations {
    margin: 0 auto;
    max-width: 1200px;
    padding: 0 1.25rem 4rem;
  }
  .operations > header {
    border-bottom: 1px solid var(--border-default);
    padding: 2rem 0 1.25rem;
  }
  .operations > header p {
    color: var(--accent-primary);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    margin: 0;
  }
  .operations h1 {
    font-size: 2rem;
    margin: 0.25rem 0;
  }
  .operations > header span,
  .operations section > p {
    color: var(--text-secondary);
    line-height: 1.6;
  }
  .calendar-actions { display:flex; justify-content:flex-end; margin:.75rem 0; }
  .calendar-actions button { margin:0; }
  .calendar-settings-dialog { background:var(--background-primary); border:1px solid var(--border-default); color:var(--text-primary); max-width:44rem; padding:1rem; width:calc(100% - 2rem); }
  .calendar-settings-dialog::backdrop { background:#001a2c73; }
  .calendar-settings-heading { align-items:center; border-bottom:1px solid var(--border-default); display:flex; justify-content:space-between; margin-bottom:1rem; padding-bottom:.7rem; }
  .calendar-settings-heading h2 { margin:0; }
  .calendar-settings-heading button { background:transparent; border:0; color:var(--text-primary); font-size:1.25rem; margin:0; }
  .grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr 1fr;
    margin-top: 1.25rem;
  }
  .grid section {
    border: 1px solid var(--border-default);
    padding: 1rem;
  }
  .grid h2 {
    font-size: 1.1rem;
    margin: 0;
  }
  .grid section > p {
    font-size: 0.82rem;
    margin: 0.4rem 0 0.8rem;
  }
  .wide {
    grid-column: span 2;
  }
  .operations input,
  .operations textarea {
    background: var(--background-primary);
    border: 1px solid var(--border-default);
    box-sizing: border-box;
    color: var(--text-primary);
    font: inherit;
    margin: 0.25rem 0;
    padding: 0.55rem;
    width: 100%;
  }
  .operations textarea {
    min-height: 6rem;
    resize: vertical;
  }
  .operations button {
    background: var(--accent-primary);
    border: 1px solid var(--accent-primary);
    color: #fff;
    cursor: pointer;
    font: inherit;
    font-size: 0.82rem;
    font-weight: 800;
    margin-top: 0.35rem;
    padding: 0.5rem 0.7rem;
  }
  .item {
    border-top: 1px solid var(--border-default);
    display: grid;
    gap: 0.3rem;
    margin-top: 0.85rem;
    padding: 0.7rem 0;
  }
  .item small {
    color: var(--text-secondary);
  }
  .task-kind-label { border:1px solid var(--accent-primary); border-radius:999px; color:var(--accent-primary); display:inline-block; font-size:.68em; margin-right:.45rem; padding:.12rem .4rem; vertical-align:.12em; }
  .progress-list-heading {
    align-items: baseline;
    display: flex;
    gap: 0.7rem;
    justify-content: space-between;
    margin-top: 1.25rem;
  }
  .progress-list-heading .subheading { margin-bottom: 0; }
  [data-progress-count] { color: var(--text-secondary); font-size: 0.78rem; }
  .progress-filters {
    background: color-mix(in srgb, var(--background-secondary) 72%, transparent);
    border: 1px solid var(--border-default);
    display: grid;
    gap: 0.85rem;
    margin-top: 0.8rem;
    padding: 0.8rem;
  }
  .progress-filters .field-label { margin: 0; }
  .progress-subject-filters {
    border: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 0.8rem;
    margin: 0;
    padding: 0;
  }
  .progress-subject-filters legend {
    color: var(--text-secondary);
    font-size: 0.78rem;
    font-weight: 800;
    margin-bottom: 0.35rem;
    width: 100%;
  }
  .progress-subject-filters label {
    align-items: center;
    color: var(--text-primary);
    display: inline-flex;
    font-size: 0.82rem;
    gap: 0.3rem;
  }
  .progress-subject-filters input { margin: 0; width: auto; }
  .progress-report {
    background: var(--background-secondary);
    border: 1px solid var(--border-default);
    border-left: 3px solid var(--accent-primary);
    border-radius: 0.35rem;
    display: grid;
    gap: 0.55rem;
    margin-top: 0.8rem;
    padding: 0.85rem 1rem;
  }
  .progress-report-body { line-height: 1.7; white-space: pre-wrap; }
  .progress-report-meta { color: var(--text-secondary); font-size: 0.78rem; }
  .progress-report-meta strong { color: var(--text-primary); }
  .progress-report-tag {
    background: color-mix(in srgb, var(--accent-primary) 14%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent-primary) 38%, transparent);
    border-radius: 999px;
    color: var(--text-primary);
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 800;
    margin-right: 0.35rem;
    padding: 0.12rem 0.45rem;
  }
  .task-row {
    align-items: center;
    display: flex;
    gap: 0.5rem;
    justify-content: space-between;
  }
  .task-row select {
    font: inherit;
    padding: 0.25rem;
  }
  .event-create {
    display: grid;
    gap: 0.35rem;
    grid-template-columns: 1fr 1fr 1fr auto;
  }
  .event-create[hidden] {
    display: none !important;
  }
  .availability {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .availability button {
    background: var(--background-secondary);
    border-color: var(--border-default);
    color: var(--text-primary);
  }
  .availability button:hover {
    border-color: var(--accent-primary);
    color: var(--accent-primary);
  }
  @media (max-width: 700px) {
    .operations {
      padding: 0 0.8rem 3rem;
    }
    .operations > header {
      align-items: start;
      display: block;
    }
    .grid {
      grid-template-columns: 1fr;
    }
    .wide {
      grid-column: auto;
    }
    .event-create {
      grid-template-columns: 1fr;
    }
    .task-row {
      align-items: start;
      display: grid;
    }
  }
  @media (max-width: 560px) {
    .progress-list-heading { align-items: start; display: grid; gap: 0.2rem; }
  }
  .calendar-head {
    align-items: center;
    display: flex;
    justify-content: center;
    gap: 0.7rem;
    margin: 1rem 0 0.55rem;
  }
  .calendar-head button {
    font-size: 1.2rem;
    line-height: 1;
    margin: 0;
    min-width: 2.2rem;
  }
  .calendar-week {
    display: grid;
    gap: 1px;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    background: var(--border-default);
    border: 1px solid var(--border-default);
  }
  .calendar-cell {
    background: var(--background-primary);
    min-height: 6.8rem;
    padding: 0.35rem;
    position: relative;
  }
  .calendar-cell--blank {
    background: var(--background-secondary);
  }
  .calendar-day {
    align-items: center;
    color: var(--text-secondary);
    display: inline-flex;
    font-size: 0.7rem;
    font-weight: 800;
    height: 1.55rem;
    justify-content: center;
    width: 1.55rem;
  }
  .calendar-cell-header {
    align-items: center;
    display: flex;
    height: 1.7rem;
    justify-content: space-between;
  }
  .calendar-date-select {
    align-items: center;
    background: transparent !important;
    border: 0 !important;
    border-radius: 50%;
    color: inherit !important;
    display: inline-flex;
    height: 1.55rem;
    justify-content: center;
    margin: 0 !important;
    padding: 0 !important;
    width: 1.55rem;
  }
  .calendar-cell-content {
    display: grid;
    gap: 0.22rem;
    min-width: 0;
  }
  .calendar-event {
    background: color-mix(
      in srgb,
      var(--accent-primary) 13%,
      var(--background-primary)
    );
    border-left: 2px solid var(--accent-primary);
    display: grid;
    font-size: 0.67rem;
