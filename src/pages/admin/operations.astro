      return `<div class="task-reminder-row" data-task-reminder-row><input type="hidden" data-reminder-timezone value="${escapeHtml(reminderTimezone)}" /><label class="field-label">種類<select data-reminder-kind><option value="before_days" ${selected(kind, 'before_days')}>N日前</option><option value="before_hours" ${selected(kind, 'before_hours')}>N時間前</option><option value="due_day_hourly" ${selected(kind, 'due_day_hourly')}>当日毎時</option><option value="absolute" ${selected(kind, 'absolute')}>指定日時</option></select></label><label class="field-label" data-reminder-amount-label>数量<input data-reminder-amount type="number" min="1" max="8760" value="${escapeHtml(String(rule.relative_amount ?? ''))}" placeholder="N" /></label><label class="field-label" data-reminder-start-label>開始時刻<input data-reminder-start type="time" value="${escapeHtml(String(rule.relative_start || '09:00'))}" /></label><label class="field-label" data-reminder-at-label>日時<input data-reminder-at type="datetime-local" value="${escapeHtml(String(rule.remind_at || ''))}" /></label><button type="button" class="task-reminder-remove" data-remove-reminder>削除</button></div>`;
    };
    const refreshReminderRow = (row: HTMLElement) => {
      const kind = row.querySelector<HTMLSelectElement>('[data-reminder-kind]')?.value || 'before_days';
      const amount = row.querySelector<HTMLElement>('[data-reminder-amount-label]');
      const start = row.querySelector<HTMLElement>('[data-reminder-start-label]');
      const at = row.querySelector<HTMLElement>('[data-reminder-at-label]');
      if (amount) amount.hidden = kind !== 'before_days' && kind !== 'before_hours';
      if (start) start.hidden = kind !== 'due_day_hourly';
