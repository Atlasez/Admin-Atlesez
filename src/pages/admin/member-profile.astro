---
import AdminLayout from "../../layouts/AdminLayout.astro";
---
<AdminLayout title="マイページ" description="メンバー基本情報を管理します">
  <main class="member-profile" data-member-profile>
    <header><h1>マイページ</h1><p>登録済みの基本情報と公開プロフィールを確認できます。</p><div class="profile-header-actions" data-profile-view-actions><a class="secondary-action" href="/apply/?step=basic&returnTo=%2Fadmin%2Fmember-profile%2F">基本情報を変更</a><a class="primary-action" href="/admin/member-profile/?mode=edit">公開プロフィールを変更・編集</a></div><a class="secondary-action profile-back-link" href="/admin/member-profile/" data-profile-back hidden>マイページの確認へ戻る</a></header>
    <section class="profile-summary" data-profile-summary aria-live="polite">
      <div class="profile-top"><span class="avatar profile-summary-avatar" data-summary-avatar aria-hidden="true">A</span><div><p class="summary-kicker">MY PROFILE</p><h2 data-summary-name>読み込み中…</h2><small data-summary-email></small></div></div>
      <p class="summary-note">ここは閲覧・確認用の画面です。変更する場合は上のボタンから編集画面を開いてください。</p>
      <section class="summary-section"><h2>基本情報</h2><dl class="profile-facts" data-basic-profile-facts><div><dt>状態</dt><dd>読み込み中…</dd></div></dl></section>
      <section class="summary-section"><h2>公開プロフィール</h2><dl class="profile-facts" data-public-profile-facts></dl></section>
      <section class="summary-section"><h2>担当・権限</h2><dl class="profile-facts" data-role-facts></dl></section>
      <output data-summary-message aria-live="polite"></output>
    </section>
    <section data-profile-editor hidden>
      <div class="profile-top">
        <button type="button" class="avatar" data-avatar-button aria-label="プロフィール画像を変更">A</button>
        <div><h2 data-name>読み込み中…</h2><small data-email></small></div>
      </div>
      <dialog data-avatar-dialog>
        <form method="dialog"><h2>プロフィール画像</h2><label>画像を選択<input type="file" accept="image/png,image/jpeg,image/webp" data-avatar-file /></label><small>PNG・JPEG・WebP、2MB以下</small><button>閉じる</button></form>
      </dialog>
      <aside class="approval-state" data-approval-state hidden aria-live="polite"></aside>
      <p class="editor-note">氏名・所属・連絡先などの基本情報は、<a href="/apply/?step=basic&returnTo=%2Fadmin%2Fmember-profile%2F">基本情報の編集画面</a>から変更します。ここでは基本情報と重複しない公開プロフィールだけを変更できます。</p>
      <div class="editor-fields">
        <label>公開表示名<input data-display-name maxlength="120" required /><small>基本情報の氏名・ニックネームとは別に、公開時に表示する名前です。</small></label>
        <label>運営外自己紹介<textarea data-bio maxlength="4000" placeholder="運営外に向けた自己紹介を入力"></textarea></label>
      </div>
      <div class="actions"><output data-message aria-live="polite"></output><button type="button" data-save>変更を承認申請</button></div>
    </section>
  </main>
</AdminLayout>
<style>
  .member-profile{margin:0 auto;max-width:900px;padding:0 1.25rem 4rem}.member-profile [hidden]{display:none!important}.member-profile header{border-bottom:1px solid var(--border-default);padding:2rem 0 1.25rem}.member-profile h1{font-size:clamp(1.8rem,4vw,2.35rem);margin:0}.member-profile header>p,.member-profile small,.member-profile output{color:var(--text-secondary)}.member-profile section{border:1px solid var(--border-default);display:grid;gap:1rem;margin-top:1.25rem;padding:1rem}.profile-header-actions{display:flex;flex-wrap:wrap;gap:.65rem;margin-top:1rem}.primary-action,.secondary-action{align-items:center;border:1px solid var(--accent-primary);display:inline-flex;font-weight:800;justify-content:center;padding:.55rem .75rem;text-decoration:none}.primary-action{background:var(--accent-primary);color:#fff}.secondary-action{background:var(--background-primary);color:var(--accent-primary)}.profile-back-link{margin-top:1rem}.profile-top{align-items:center;display:flex;gap:1rem}.profile-top h2{margin:0}.summary-kicker{color:var(--accent-primary);font-size:.7rem;font-weight:900;letter-spacing:.08em;margin:0 0 .2rem}.avatar{align-items:center;background:#285a86;background-position:center;background-size:cover;border:1px solid var(--border-default);border-radius:50%;color:#fff;cursor:pointer;display:flex;font-size:1.8rem;font-weight:800;height:5rem;justify-content:center;width:5rem}.profile-summary-avatar{cursor:default}.summary-note{background:var(--background-secondary);border-left:3px solid var(--accent-primary);line-height:1.6;margin:0;padding:.7rem .8rem}.summary-section{border:0!important;border-top:1px solid var(--border-default)!important;margin:0!important;padding:1rem 0 0!important}.summary-section h2{font-size:1rem;margin:0}.profile-facts{display:grid;gap:0;margin:0}.profile-facts div{border-bottom:1px solid var(--border-default);display:grid;gap:.6rem;grid-template-columns:minmax(11rem,.8fr) 1.4fr;padding:.68rem .15rem}.profile-facts dt{color:var(--text-secondary);font-size:.78rem;font-weight:800}.profile-facts dd{margin:0;overflow-wrap:anywhere;white-space:pre-wrap}.approval-state{background:var(--background-secondary);border-left:4px solid var(--accent-primary);padding:.75rem}.approval-state.is-rejected{border-left-color:#a53a32}.editor-note{background:var(--background-secondary);line-height:1.6;margin:0;padding:.7rem}.editor-note a{color:var(--accent-primary);font-weight:800}.editor-fields{display:grid;gap:1rem}.member-profile label{display:grid;font-weight:700;gap:.35rem}.member-profile input,.member-profile textarea{background:var(--background-primary);border:1px solid var(--border-default);box-sizing:border-box;color:var(--text-primary);font:inherit;padding:.55rem;width:100%}.member-profile textarea{min-height:11rem;resize:vertical}.actions{align-items:center;display:flex;gap:1rem;justify-content:space-between}.actions output{min-height:1.5em}button{background:var(--accent-primary);border:1px solid var(--accent-primary);color:#fff;cursor:pointer;font:inherit;font-weight:800;padding:.55rem .75rem;width:max-content}dialog{background:var(--background-primary);border:1px solid var(--border-default);color:var(--text-primary);padding:1rem}dialog form{display:grid;gap:.7rem}@media(max-width:700px){.member-profile{padding:0 .8rem 3rem}.profile-facts div{grid-template-columns:1fr}.actions{align-items:stretch;flex-direction:column}.actions button{width:100%}}
</style>
<script>
  import { readAdminApiJson } from "../../lib/admin-api";
  type Profile={display_name?:string;bio?:string;avatar_url?:string;updated_at?:string|null};
  type BasicProfile={family_name?:string;given_name?:string;middle_name?:string;nickname?:string;family_name_kana?:string;given_name_kana?:string;affiliation_email?:string;affiliation_type?:string;institution?:string;grade?:string;country?:string;timezone?:string;birth_date?:string;residence_city?:string;current_organizations?:string};
  type ChangeRequest={status?:string;proposed_display_name?:string;proposed_university?:string;proposed_year?:string;proposed_affiliation_type?:string;proposed_country?:string;proposed_timezone?:string;proposed_bio?:string;submitted_at?:string;review_note?:string};
  type ProfileResponse={profile?:Profile;basicProfile?:BasicProfile|null;roles?:string[];profileChangeRequest?:ChangeRequest|null;email?:string;error?:string;approvalRequired?:boolean};
  const initializeMemberProfile=()=>{
    const root=document.querySelector<HTMLElement>('[data-member-profile]');if(!root||root.dataset.ready)return;root.dataset.ready='true';
    const get=<T extends Element>(selector:string)=>root.querySelector<T>(selector)!;
    const message=get<HTMLOutputElement>('[data-message]'),avatar=get<HTMLButtonElement>('[data-avatar-button]'),dialog=get<HTMLDialogElement>('[data-avatar-dialog]'),approvalState=get<HTMLElement>('[data-approval-state]'),summary=get<HTMLElement>('[data-profile-summary]'),editor=get<HTMLElement>('[data-profile-editor]'),summaryMessage=get<HTMLOutputElement>('[data-summary-message]'),summaryAvatar=get<HTMLElement>('[data-summary-avatar]');
    const editMode=new URLSearchParams(location.search).get('mode')==='edit';
    let avatarUrl='';
    const read=(response:Response)=>readAdminApiJson<ProfileResponse>(response,'プロフィール情報を読み込めませんでした。');
    const setValue=(selector:string,value:string)=>{get<HTMLInputElement|HTMLSelectElement|HTMLTextAreaElement>(selector).value=value};
    const proposedProfile=(request:ChangeRequest):Profile=>({display_name:request.proposed_display_name,bio:request.proposed_bio});
    const apply=(profile:Profile)=>{setValue('[data-display-name]',profile.display_name??'');setValue('[data-bio]',profile.bio??'');avatarUrl=profile.avatar_url??avatarUrl;avatar.style.backgroundImage=avatarUrl?`url(${JSON.stringify(avatarUrl)})`:'';avatar.textContent=avatarUrl?'':'A';get<HTMLElement>('[data-name]').textContent=profile.display_name||'表示名未設定'};
    const escape=(value:unknown)=>String(value??'').replace(/[&<>"']/g,character=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[character]??character));
    const fact=(label:string,value:unknown)=>`<div><dt>${escape(label)}</dt><dd>${escape(String(value??'').trim()||'未登録')}</dd></div>`;
    const renderSummary=(profile:Profile,basic:BasicProfile|null,email:string,roles:string[])=>{const displayName=profile.display_name?.trim()||basic?.nickname?.trim()||[basic?.family_name,basic?.given_name].filter(Boolean).join(' ')||'表示名未設定';get<HTMLElement>('[data-summary-name]').textContent=displayName;get<HTMLElement>('[data-summary-email]').textContent=email;const avatarUrl=profile.avatar_url?.trim()||'';summaryAvatar.style.backgroundImage=avatarUrl?`url(${JSON.stringify(avatarUrl)})`:'';summaryAvatar.textContent=avatarUrl?'':displayName.slice(0,1).toUpperCase()||'A';get<HTMLElement>('[data-basic-profile-facts]').innerHTML=[fact('氏名',[basic?.family_name,basic?.given_name,basic?.middle_name].filter(Boolean).join(' ')),fact('ふりがな',[basic?.family_name_kana,basic?.given_name_kana].filter(Boolean).join(' ')),fact('ニックネーム',basic?.nickname),fact('ログイン中のメールアドレス',email),fact('所属先メールアドレス',basic?.affiliation_email),fact('所属区分',basic?.affiliation_type),fact('所属機関',basic?.institution),fact('学年・立場',basic?.grade),fact('居住国・地域',basic?.country),fact('タイムゾーン',basic?.timezone),fact('生年月日',basic?.birth_date),fact('居住都市',basic?.residence_city),fact('参加団体など',basic?.current_organizations)].join('');get<HTMLElement>('[data-public-profile-facts]').innerHTML=[fact('表示名',displayName),fact('運営外自己紹介',profile.bio),fact('プロフィール画像',avatarUrl?'設定済み':'未設定'),fact('更新日時',profile.updated_at?new Date(profile.updated_at).toLocaleString('ja-JP'):'未更新')].join('');get<HTMLElement>('[data-role-facts]').innerHTML=[fact('担当・権限',roles.join('・'))].join('');};
    const showRequest=(request?:ChangeRequest|null)=>{if(!request)return;const status=request.status??'';if(status==='pending'){approvalState.hidden=false;approvalState.textContent=`運営事務局の承認待ちです（申請日時: ${new Date(request.submitted_at??'').toLocaleString('ja-JP')}）。再申請すると内容を更新できます。`;apply({...proposedProfile(request),avatar_url:avatarUrl})}else if(status==='rejected'){approvalState.hidden=false;approvalState.classList.add('is-rejected');approvalState.textContent=`直近の申請は却下されました。${request.review_note?` 理由: ${request.review_note}`:''}`}};
    const load=async()=>{const response=await fetch('/api/admin/profile',{credentials:'same-origin',cache:'no-store'}),data=await read(response);if(!response.ok)throw new Error(data.error);const profile=data.profile??{};apply(profile);renderSummary(profile,data.basicProfile??null,data.email??'',data.roles??[]);get<HTMLElement>('[data-email]').textContent=data.email??'';showRequest(data.profileChangeRequest)};
    avatar.addEventListener('click',()=>dialog.showModal());
    get<HTMLInputElement>('[data-avatar-file]').addEventListener('change',()=>{const file=get<HTMLInputElement>('[data-avatar-file]').files?.[0];if(!file)return;if(file.size>2_000_000){message.value='画像は2MB以下にしてください。';return}const reader=new FileReader();reader.onload=()=>{avatarUrl=String(reader.result??'');avatar.style.backgroundImage=`url(${JSON.stringify(avatarUrl)})`;avatar.textContent='';dialog.close()};reader.readAsDataURL(file)});
    get<HTMLButtonElement>('[data-save]').addEventListener('click',async()=>{const displayName=get<HTMLInputElement>('[data-display-name]').value.trim();if(!displayName){message.value='公開表示名を入力してください。';return}message.value='運営事務局へ申請中…';const response=await fetch('/api/admin/profile',{method:'PUT',credentials:'same-origin',headers:{'content-type':'application/json'},body:JSON.stringify({displayName,bio:get<HTMLTextAreaElement>('[data-bio]').value,avatarUrl})}),data=await read(response);message.value=response.ok?'変更内容を運営事務局へ送りました。承認後に反映されます。':data.error??'申請できませんでした。';if(response.ok){approvalState.hidden=false;approvalState.classList.remove('is-rejected');approvalState.textContent='運営事務局の承認待ちです。';document.dispatchEvent(new CustomEvent('atlasez-profile-updated'))}});
    summary.hidden=editMode;editor.hidden=!editMode;get<HTMLElement>('[data-profile-view-actions]').hidden=editMode;get<HTMLAnchorElement>('[data-profile-back]').hidden=!editMode;
    void load().catch(error=>{const text=error instanceof Error?error.message:'読み込めませんでした。';message.value=text;summaryMessage.value=text});
  };
  document.addEventListener('astro:page-load',initializeMemberProfile);initializeMemberProfile();
</script>
