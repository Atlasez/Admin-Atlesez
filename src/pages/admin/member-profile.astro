---
import AdminLayout from "../../layouts/AdminLayout.astro";
---
<AdminLayout title="マイページ" description="メンバー情報を確認します">
  <main class="member-profile" data-member-profile>
    <header class="page-heading"><div><p class="eyebrow">メンバー情報</p><h1>マイページ</h1><p class="lead">登録されている情報を確認できます。変更は専用の編集ページから申請してください。</p></div><a class="edit-link" href="/admin/member-profile/edit/">プロフィールを編集</a></header>
    <section class="profile-card" aria-labelledby="profile-heading">
      <div class="profile-top"><div class="avatar" data-avatar aria-hidden="true">A</div><div><h2 id="profile-heading" data-name>読み込み中…</h2><small data-email></small></div></div>
      <section class="discord-card" aria-labelledby="discord-heading"><div class="discord-card__heading"><div><p class="eyebrow">外部サービス連携</p><h2 id="discord-heading">Discord</h2></div><span class="discord-card__status" data-discord-status data-state="unconnected">未連携</span></div><p data-discord-description>Discordサーバー参加に必要な本人同意を行えます。</p><a class="discord-card__action" data-discord-link href="/auth/discord/start?returnTo=%2Fadmin%2Fmember-profile%2F">Discordと連携</a><output data-discord-message aria-live="polite"></output></section>
      <aside class="approval-state" data-approval-state hidden aria-live="polite"></aside>
      <dl class="profile-facts"><div><dt>氏名</dt><dd data-fact="display_name">読み込み中…</dd></div><div><dt>学校・所属</dt><dd data-fact="university">—</dd></div><div><dt>学年等</dt><dd data-fact="year">—</dd></div><div><dt>所属区分</dt><dd data-fact="affiliation_type">—</dd></div><div><dt>国・地域</dt><dd data-fact="country">—</dd></div><div><dt>タイムゾーン</dt><dd data-fact="timezone">—</dd></div></dl>
      <section class="bio-card" aria-labelledby="bio-heading"><h2 id="bio-heading">運営外自己紹介</h2><p data-bio>—</p></section>
      <output class="message" data-message aria-live="polite"></output>
    </section>
  </main>
</AdminLayout>
<style>
.member-profile{margin:0 auto;max-width:900px;padding:0 1.25rem 4rem}.page-heading{align-items:end;border-bottom:1px solid var(--border-default);display:flex;gap:1rem;justify-content:space-between;padding:2rem 0 1.25rem}.eyebrow{color:var(--accent-primary);font-size:.72rem;font-weight:800;letter-spacing:.06em;margin:0}.member-profile h1{font-size:clamp(1.8rem,4vw,2.35rem);margin:.25rem 0}.lead{color:var(--text-secondary);font-size:.82rem;line-height:1.6;margin:.4rem 0 0}.edit-link,.discord-card__action{background:var(--accent-primary);color:#fff;font-size:.8rem;font-weight:800;padding:.65rem .85rem;text-decoration:none;white-space:nowrap}.profile-card{border:1px solid var(--border-default);border-top:2px solid var(--accent-primary);display:grid;gap:1rem;margin-top:1.25rem;padding:1rem}.profile-top{align-items:center;display:flex;gap:1rem}.profile-top h2{margin:0}.profile-top small,.profile-card output{color:var(--text-secondary)}.avatar{align-items:center;background:linear-gradient(145deg,#2d6ea8,#153c66);background-position:center;background-size:cover;border:1px solid var(--border-default);border-radius:50%;color:#fff;display:flex;font-size:1.8rem;font-weight:800;height:5rem;justify-content:center;overflow:hidden;width:5rem}.discord-card{background:var(--background-secondary);border:1px solid var(--border-default);display:grid;gap:.65rem;padding:.85rem}.discord-card__heading{align-items:center;display:flex;justify-content:space-between}.discord-card h2{font-size:1.1rem;margin:.15rem 0 0}.discord-card__status{border:1px solid var(--border-default);border-radius:999px;font-size:.78rem;font-weight:800;padding:.2rem .6rem}.discord-card__status[data-state="connected"]{background:var(--accent-subtle);border-color:var(--accent-primary);color:var(--accent-primary)}.discord-card__action{display:inline-block;justify-self:start}.approval-state{background:var(--background-secondary);border-left:4px solid var(--accent-primary);padding:.75rem}.profile-facts{display:grid;gap:.65rem;grid-template-columns:repeat(3,minmax(0,1fr));margin:0}.profile-facts div{background:var(--background-secondary);border:1px solid var(--border-default);padding:.6rem}.profile-facts dt{color:var(--text-secondary);font-size:.68rem;font-weight:800}.profile-facts dd{font-size:.84rem;margin:.25rem 0 0;overflow-wrap:anywhere}.bio-card{border-top:1px solid var(--border-default);padding-top:.8rem}.bio-card h2{font-size:1rem;margin:0 0 .4rem}.bio-card p{color:var(--text-secondary);line-height:1.7;margin:0;white-space:pre-wrap}.message{min-height:1.2em}@media(max-width:700px){.member-profile{padding:0 .8rem 3rem}.page-heading{align-items:start;display:grid}.edit-link{justify-self:start}.profile-facts{grid-template-columns:repeat(2,minmax(0,1fr))}.discord-card__action{justify-self:stretch;text-align:center}}
</style>
<script>
import { readAdminApiJson } from "../../lib/admin-api";
type Profile={display_name?:string;university?:string;year?:string;affiliation_type?:string;country?:string;timezone?:string;bio?:string;avatar_url?:string};
type ChangeRequest={status?:string;submitted_at?:string;review_note?:string};
type ResponseData={profile?:Profile;profileChangeRequest?:ChangeRequest|null;email?:string;discordUserId?:string;error?:string};
const initialize=()=>{const root=document.querySelector<HTMLElement>("[data-member-profile]");if(!root||root.dataset.ready)return;root.dataset.ready="true";const get=<T extends Element=HTMLElement>(selector:string)=>root.querySelector<T>(selector)!;const message=get("[data-message]");const apply=(profile:Profile)=>{get("[data-name]").textContent=profile.display_name?.trim()||"表示名未設定";get("[data-fact=display_name]").textContent=profile.display_name?.trim()||"未登録";for(const key of ["university","year","affiliation_type","country","timezone"]){get(`[data-fact=${key}]`).textContent=profile[key as keyof Profile]?.toString().trim()||"未登録"}get("[data-bio]").textContent=profile.bio?.trim()||"自己紹介はまだ登録されていません。";const avatar=get("[data-avatar]");if(profile.avatar_url){avatar.style.backgroundImage=`url(${JSON.stringify(profile.avatar_url)})`;avatar.textContent=""}};const showRequest=(request?:ChangeRequest|null)=>{if(!request)return;const view=get("[data-approval-state]");view.hidden=false;view.textContent=request.status==="pending"?`変更申請は承認待ちです（${request.submitted_at?new Date(request.submitted_at).toLocaleString("ja-JP"):"日時不明"}）。`:`直近の変更申請は却下されました。${request.review_note?`理由: ${request.review_note}`:""}`};const applyDiscord=(id:string)=>{const status=get("[data-discord-status]"),description=get("[data-discord-description]"),link=get("[data-discord-link]");const connected=Boolean(id.trim());status.textContent=connected?"連携済み":"未連携";status.dataset.state=connected?"connected":"unconnected";description.textContent=connected?"Discordアカウントは連携済みです。必要に応じて連携先を更新できます。":"Discordサーバー参加に必要な本人同意を行えます。";link.textContent=connected?"Discord連携を更新":"Discordと連携"};const showDiscordResult=()=>{const params=new URLSearchParams(location.search);const result=params.get("discord");if(result==="connected")get("[data-discord-message]").textContent="Discord連携が完了しました。";else if(result==="error")get("[data-discord-message]").textContent=params.get("discordMessage")||"Discord連携に失敗しました。";if(result)history.replaceState({},"",location.pathname)};void fetch("/api/admin/profile",{credentials:"same-origin",cache:"no-store"}).then(async response=>{const data=await readAdminApiJson<ResponseData>(response,"プロフィール情報を読み込めませんでした。");if(!response.ok)throw new Error(data.error);apply(data.profile??{});get("[data-email]").textContent=data.email??"";applyDiscord(data.discordUserId??"");showRequest(data.profileChangeRequest);showDiscordResult()}).catch(error=>{message.textContent=error instanceof Error?error.message:"読み込めませんでした."})};document.addEventListener("astro:page-load",initialize);initialize();
</script>
