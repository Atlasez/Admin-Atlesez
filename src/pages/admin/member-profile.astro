---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { getTimeZoneOptions } from "../../lib/timezones";
const timezones = getTimeZoneOptions(new Date());
---
<AdminLayout title="マイページ" description="メンバー基本情報を管理します">
  <main class="member-profile" data-member-profile>
    <header><h1>マイページ</h1></header>
    <section>
      <div class="profile-top">
        <button type="button" class="avatar" data-avatar-button aria-label="プロフィール画像を変更">A</button>
        <div><h2 data-name>読み込み中…</h2><small data-email></small></div>
      </div>
      <dialog data-avatar-dialog>
        <form method="dialog"><h2>プロフィール画像</h2><label>画像を選択<input type="file" accept="image/png,image/jpeg,image/webp" data-avatar-file /></label><small>PNG・JPEG・WebP、2MB以下</small><button>閉じる</button></form>
      </dialog>
      <aside class="approval-state" data-approval-state hidden aria-live="polite"></aside>
      <div class="form-grid">
        <label>氏名<input data-display-name maxlength="120" required /></label>
        <label>学校・所属<input data-university maxlength="200" /></label>
        <label>学年等<input data-year maxlength="80" /></label>
        <label>所属区分<select data-affiliation-type><option value="">選択してください</option><option value="student">学生</option><option value="faculty">教職員</option><option value="worker">社会人</option><option value="other">その他</option></select></label>
        <label>国・地域<input data-country maxlength="120" /></label>
        <label>タイムゾーン<input data-timezone list="member-profile-timezones" value="Asia/Tokyo" placeholder="地域名・都市名で検索" /><small data-timezone-offset></small></label>
      </div>
      <datalist id="member-profile-timezones">{timezones.map(({ value, label }) => <option value={value} label={label}></option>)}</datalist>
      <label>運営外自己紹介<textarea data-bio maxlength="4000" placeholder="運営外に向けた自己紹介を入力"></textarea></label>
      <div class="actions"><output data-message aria-live="polite"></output><button type="button" data-save>変更を承認申請</button></div>
    </section>
  </main>
</AdminLayout>
<style>
  .member-profile{margin:0 auto;max-width:900px;padding:0 1.25rem 4rem}.member-profile header{border-bottom:1px solid var(--border-default);padding:2rem 0 1.25rem}.member-profile h1{font-size:clamp(1.8rem,4vw,2.35rem);margin:0}.member-profile small,.member-profile output{color:var(--text-secondary)}.member-profile section{border:1px solid var(--border-default);display:grid;gap:1rem;margin-top:1.25rem;padding:1rem}.profile-top{align-items:center;display:flex;gap:1rem}.profile-top h2{margin:0}.avatar{align-items:center;background:#285a86;background-position:center;background-size:cover;border:1px solid var(--border-default);border-radius:50%;color:#fff;cursor:pointer;display:flex;font-size:1.8rem;font-weight:800;height:5rem;justify-content:center;width:5rem}.approval-state{background:var(--background-secondary);border-left:4px solid var(--accent-primary);padding:.75rem}.approval-state.is-rejected{border-left-color:#a53a32}.form-grid{display:grid;gap:.7rem;grid-template-columns:repeat(3,1fr)}label{display:grid;font-weight:700;gap:.35rem}input,select,textarea{background:var(--background-primary);border:1px solid var(--border-default);box-sizing:border-box;color:var(--text-primary);font:inherit;padding:.55rem;width:100%}textarea{min-height:11rem;resize:vertical}.actions{align-items:center;display:flex;gap:1rem;justify-content:space-between}.actions output{min-height:1.5em}button{background:var(--accent-primary);border:1px solid var(--accent-primary);color:#fff;cursor:pointer;font:inherit;font-weight:800;padding:.55rem .75rem;width:max-content}dialog{background:var(--background-primary);border:1px solid var(--border-default);color:var(--text-primary);padding:1rem}dialog form{display:grid;gap:.7rem}@media(max-width:700px){.member-profile{padding:0 .8rem 3rem}.form-grid{grid-template-columns:1fr}.actions{align-items:stretch;flex-direction:column}.actions button{width:100%}}
</style>
<script>
  import { formatUtcOffset, isValidTimeZone, timeZoneOffsetMinutes } from "../../lib/timezones";
  type Profile={display_name?:string;university?:string;year?:string;affiliation_type?:string;country?:string;timezone?:string;bio?:string;avatar_url?:string};
  type ChangeRequest={status?:string;proposed_display_name?:string;proposed_university?:string;proposed_year?:string;proposed_affiliation_type?:string;proposed_country?:string;proposed_timezone?:string;proposed_bio?:string;submitted_at?:string;review_note?:string};
  type ProfileResponse={profile?:Profile;profileChangeRequest?:ChangeRequest|null;email?:string;error?:string;approvalRequired?:boolean};
  const initializeMemberProfile=()=>{
    const root=document.querySelector<HTMLElement>('[data-member-profile]');if(!root||root.dataset.ready)return;root.dataset.ready='true';
    const get=<T extends Element>(selector:string)=>root.querySelector<T>(selector)!;
    const message=get<HTMLOutputElement>('[data-message]'),avatar=get<HTMLButtonElement>('[data-avatar-button]'),dialog=get<HTMLDialogElement>('[data-avatar-dialog]'),timezoneInput=get<HTMLInputElement>('[data-timezone]'),approvalState=get<HTMLElement>('[data-approval-state]');
    let avatarUrl='';
    const read=async(response:Response)=>await response.json() as ProfileResponse;
    const setValue=(selector:string,value:string)=>{get<HTMLInputElement|HTMLSelectElement|HTMLTextAreaElement>(selector).value=value};
    const proposedProfile=(request:ChangeRequest):Profile=>({display_name:request.proposed_display_name,university:request.proposed_university,year:request.proposed_year,affiliation_type:request.proposed_affiliation_type,country:request.proposed_country,timezone:request.proposed_timezone,bio:request.proposed_bio});
    const updateTimezone=()=>{const candidate=timezoneInput.value.trim();get<HTMLElement>('[data-timezone-offset]').textContent=isValidTimeZone(candidate)?`現在のオフセット: ${formatUtcOffset(timeZoneOffsetMinutes(candidate))}`:'IANAタイムゾーンを入力してください。'};
    const apply=(profile:Profile)=>{setValue('[data-display-name]',profile.display_name??'');setValue('[data-university]',profile.university??'');setValue('[data-year]',profile.year??'');setValue('[data-affiliation-type]',profile.affiliation_type??'');setValue('[data-country]',profile.country??'');setValue('[data-timezone]',profile.timezone||'Asia/Tokyo');setValue('[data-bio]',profile.bio??'');avatarUrl=profile.avatar_url??avatarUrl;avatar.style.backgroundImage=avatarUrl?`url(${JSON.stringify(avatarUrl)})`:'';avatar.textContent=avatarUrl?'':'A';get<HTMLElement>('[data-name]').textContent=profile.display_name||'表示名未設定';updateTimezone()};
    const showRequest=(request?:ChangeRequest|null)=>{if(!request)return;const status=request.status??'';if(status==='pending'){approvalState.hidden=false;approvalState.textContent=`運営事務局の承認待ちです（申請日時: ${new Date(request.submitted_at??'').toLocaleString('ja-JP')}）。再申請すると内容を更新できます。`;apply({...proposedProfile(request),avatar_url:avatarUrl})}else if(status==='rejected'){approvalState.hidden=false;approvalState.classList.add('is-rejected');approvalState.textContent=`直近の申請は却下されました。${request.review_note?` 理由: ${request.review_note}`:''}`}};
    const load=async()=>{const response=await fetch('/api/admin/profile',{credentials:'same-origin',cache:'no-store'}),data=await read(response);if(!response.ok)throw new Error(data.error);apply(data.profile??{});get<HTMLElement>('[data-email]').textContent=data.email??'';showRequest(data.profileChangeRequest)};
    timezoneInput.addEventListener('input',updateTimezone);timezoneInput.addEventListener('change',updateTimezone);
    avatar.addEventListener('click',()=>dialog.showModal());
    get<HTMLInputElement>('[data-avatar-file]').addEventListener('change',()=>{const file=get<HTMLInputElement>('[data-avatar-file]').files?.[0];if(!file)return;if(file.size>2_000_000){message.value='画像は2MB以下にしてください。';return}const reader=new FileReader();reader.onload=()=>{avatarUrl=String(reader.result??'');avatar.style.backgroundImage=`url(${JSON.stringify(avatarUrl)})`;avatar.textContent='';dialog.close()};reader.readAsDataURL(file)});
    get<HTMLButtonElement>('[data-save]').addEventListener('click',async()=>{const displayName=get<HTMLInputElement>('[data-display-name]').value.trim();if(!displayName){message.value='氏名を入力してください。';return}message.value='運営事務局へ申請中…';const response=await fetch('/api/admin/profile',{method:'PUT',credentials:'same-origin',headers:{'content-type':'application/json'},body:JSON.stringify({displayName,university:get<HTMLInputElement>('[data-university]').value,year:get<HTMLInputElement>('[data-year]').value,affiliationType:get<HTMLSelectElement>('[data-affiliation-type]').value,country:get<HTMLInputElement>('[data-country]').value,timezone:timezoneInput.value,bio:get<HTMLTextAreaElement>('[data-bio]').value,avatarUrl})}),data=await read(response);message.value=response.ok?'変更内容を運営事務局へ送りました。承認後に反映されます。':data.error??'申請できませんでした。';if(response.ok){approvalState.hidden=false;approvalState.classList.remove('is-rejected');approvalState.textContent='運営事務局の承認待ちです。';document.dispatchEvent(new CustomEvent('atlasez-profile-updated'))}});
    void load().catch(error=>message.value=error instanceof Error?error.message:'読み込めませんでした。');
  };
  document.addEventListener('astro:page-load',initializeMemberProfile);initializeMemberProfile();
</script>
