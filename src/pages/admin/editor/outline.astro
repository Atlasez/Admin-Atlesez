---
import { getCollection } from "astro:content";
import AdminLayout from "../../../layouts/AdminLayout.astro";
import AdminRetryNotice from "../../../components/admin/AdminRetryNotice.astro";
import { getPlannedArticles, plannedArticleTitle, plannedProgress } from "../../../lib/planned";

const sourceSubjects = (await getCollection("subjects"))
  .sort((a, b) => a.data.order - b.data.order)
  .map((subject) => ({
    slug: subject.data.slug,
    name: subject.data.name.ja,
    status: subject.data.status,
    categories: subject.data.categories.slice().sort((a, b) => a.order - b.order).map((category) => ({ slug: category.slug, name: category.name.ja, order: category.order })),
  }));
const planned = sourceSubjects.flatMap((subject) => getPlannedArticles(subject.slug).map((item) => ({
  key: `${item.subject}/${item.category}/${item.order}`,
  subject: item.subject,
  category: item.category,
  title: plannedArticleTitle(item, "ja"),
  slug: `planned-${item.category}-${item.order}`,
  order: item.order,
  progress: plannedProgress(item),
})));
const payload = JSON.stringify({ subjects: sourceSubjects, planned }).replace(/</g, "\\u003c");
---

<AdminLayout title="学習サイトの目次" description="分野の構成を先に決め、目次から記事を作成します。">
  <main class="outline-page" data-outline-page data-admin-load-surface data-admin-load-state="loading" aria-busy="true">
    <header class="outline-header">
      <div>
        <h1>学習サイトの目次</h1>
      </div>
      <nav aria-label="目次の操作"><a href="/admin/editor/?new=1&choose=1">新規記事作成</a><a href="/admin/genre-roles/?project=atlas">分野・カテゴリを管理</a></nav>
    </header>

    <section class="outline-toolbar" aria-label="目次の絞り込み">
      <label>分野<select data-outline-subject></select></label>
      <label>カテゴリ<select data-outline-category></select></label>
      <label class="outline-archive-toggle"><input type="checkbox" data-outline-include-archived />アーカイブ済みを表示</label>
      <div class="outline-toolbar-actions">
        <span class="outline-count" data-outline-count aria-live="polite"></span>
        <span class="outline-selection-count" data-outline-selection-count aria-live="polite">0件選択</span>
        <button type="button" class="outline-button" data-outline-confirm disabled>選択項目を確認</button>
        <button type="button" class="outline-button" data-outline-bulk-archive disabled>選択項目をアーカイブ</button>
        <button type="button" class="outline-button" data-outline-bulk-restore disabled>選択項目を復元</button>
        <button type="button" class="outline-button outline-button-primary" data-outline-save-order disabled>並び順を保存</button>
      </div>
    </section>

    <section class="outline-create" aria-labelledby="outline-create-heading">
      <details>
        <summary id="outline-create-heading">目次項目を追加</summary>
        <form data-outline-form>
          <div class="outline-form-grid">
            <label>分野<select name="subject" data-form-subject required></select></label>
            <label>カテゴリ<select name="category" data-form-category required></select></label>
            <label>記事タイトル<input name="title" required maxlength="160" placeholder="例：ラグランジュの定理" /></label>
            <label>URL名（任意）<input name="slug" pattern="[a-z0-9-]+" maxlength="80" placeholder="未入力なら自動生成" /></label>
            <label>表示順<input name="sortOrder" type="number" min="0" max="9999" value="0" /></label>
            <label>親項目（任意）<select name="parentId" data-form-parent><option value="">最上位</option></select></label>
            <label>概念ID（任意）<input name="conceptId" maxlength="200" placeholder="自動設定も可能" /></label>
            <label class="wide">要約（任意）<textarea name="summary" rows="2" maxlength="500" placeholder="記事一覧に表示する短い説明"></textarea></label>
          </div>
          <div class="outline-form-actions"><button type="submit">目次に追加</button><output data-outline-form-message aria-live="polite"></output></div>
        </form>
      </details>
    </section>

    <dialog class="outline-edit-dialog" data-outline-edit-dialog aria-labelledby="outline-edit-heading">
      <form method="dialog" data-outline-edit-form>
        <h2 id="outline-edit-heading">目次項目を編集</h2>
        <input type="hidden" name="id" />
        <label>記事タイトル<input name="title" required maxlength="160" /></label>
        <label>URL名（英小文字）<input name="slug" required pattern="[a-z0-9-]+" maxlength="80" /></label>
        <label>要約（任意）<textarea name="summary" rows="2" maxlength="500"></textarea></label>
        <label>親項目（任意）<select name="parentId" data-edit-parent><option value="">最上位</option></select></label>
        <label>表示順<input name="sortOrder" type="number" min="0" max="9999" /></label>
        <div class="outline-dialog-actions"><button type="button" class="outline-button" data-outline-edit-cancel>キャンセル</button><button type="submit" class="outline-button outline-button-primary">保存</button></div>
        <output data-outline-edit-message aria-live="polite"></output>
      </form>
    </dialog>

    <section class="outline-results" aria-labelledby="outline-results-heading">
      <div class="outline-results-heading"><h2 id="outline-results-heading">記事の構成</h2></div>
      <div class="outline-list" data-outline-list aria-live="polite"><p class="outline-loading">目次を読み込んでいます…</p></div>
    </section>
    <AdminRetryNotice scope="editor-outline" message="目次を読み込めませんでした。" />
    <script is:inline type="application/json" data-outline-source set:html={payload}></script>
  </main>
</AdminLayout>

