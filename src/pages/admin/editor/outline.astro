      if (!taxonomyResponse.ok) throw new Error(taxonomyData.error ?? "分野・カテゴリを読み込めませんでした。");
      documents = documentsPage.rows as DocumentRow[];
      // 管理APIの目次行はDB列名（subject_slug/category_slug/parent_id）で返る。
      // 画面側のEntryモデルへ正規化しないと、フィルターの subject/category と
