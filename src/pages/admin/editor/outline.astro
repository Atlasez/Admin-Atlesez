      }
      return false;
    };
    const categoryOf = (entry: HTMLElement) => entry.closest<HTMLElement>("[data-outline-category]")?.dataset.outlineCategory ?? "";
    const markCategoryDirty = (category: HTMLElement | null) => category?.querySelectorAll<HTMLElement>("[data-outline-entry][data-entry-id]").forEach((item) => { if (item.dataset.entryId) orderDirty.add(item.dataset.entryId); });
    const refreshDepths = (container: HTMLElement, depth: number) => {
      [...container.children].forEach((node) => {
        if (!(node instanceof HTMLElement) || !node.matches("[data-outline-entry]")) return;
        node.style.setProperty("--outline-depth", String(depth));
        const children = node.nextElementSibling;
        if (children instanceof HTMLElement && children.classList.contains("outline-children")) refreshDepths(children, depth + 1);
