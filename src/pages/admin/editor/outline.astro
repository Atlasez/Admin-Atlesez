    accent-color: var(--accent-primary);
    appearance: auto;
    block-size: 16px !important;
    box-sizing: border-box;
    display: block;
    flex: 0 0 16px;
    height: 16px !important;
    inline-size: 16px !important;
    margin: 0;
    min-block-size: 16px !important;
    min-height: 16px !important;
    min-inline-size: 16px !important;
    padding: 0;
    width: 16px !important;
  }
</style>

<script>
  import { createAdminLoadRetry } from "../../../scripts/admin-load-retry";

  type Subject = { slug:string; name:string; status?:string; categories:Array<{slug:string;name:string;order:number}> };
  type Entry = { id?:string; key:string; subject:string; category:string; title:string; slug:string; summary?:string; concept_id?:string; parent_id?:string|null; document_id?:string|null; order:number; sort_order?:number; progress?:string; status?:string };
  type DocumentRow = { id:string; subject:string; category:string; slug:string; title:string; status:string; published_at?:string|null; scheduled_publish_at?:string|null; publication_pr_number?:number|null; publication_action?:string|null };
  const initialize = () => {
    const root = document.querySelector<HTMLElement>("[data-outline-page]");
    const source = root?.querySelector<HTMLScriptElement>("[data-outline-source]");
    if (!root || !source || root.dataset.ready === "true") return;
    root.dataset.ready = "true";
    const data = JSON.parse(source.textContent ?? "{}") as { subjects:Subject[]; planned:Entry[] };
    let subjects = data.subjects ?? [];
    let staticEntries = data.planned ?? [];
    let customEntries:Entry[] = [];
    let documents:DocumentRow[] = [];
    const query = new URLSearchParams(window.location.search);
    const initialSubject = query.get("subject")?.trim() ?? "";
    const initialCategory = query.get("category")?.trim() ?? "";
    const subjectSelect = root.querySelector<HTMLSelectElement>("[data-outline-subject]")!;
    const categorySelect = root.querySelector<HTMLSelectElement>("[data-outline-category]")!;
    const formSubject = root.querySelector<HTMLSelectElement>("[data-form-subject]")!;
    const formCategory = root.querySelector<HTMLSelectElement>("[data-form-category]")!;
    const formParent = root.querySelector<HTMLSelectElement>("[data-form-parent]")!;
    const editDialog = root.querySelector<HTMLDialogElement>("[data-outline-edit-dialog]")!;
    const editForm = root.querySelector<HTMLFormElement>("[data-outline-edit-form]")!;
    const editParent = root.querySelector<HTMLSelectElement>("[data-edit-parent]")!;
    const includeArchived = root.querySelector<HTMLInputElement>("[data-outline-include-archived]")!;
    const list = root.querySelector<HTMLElement>("[data-outline-list]")!;
    const count = root.querySelector<HTMLElement>("[data-outline-count]")!;
    const esc = (value:unknown) => String(value ?? "").replace(/[&<>"']/g, (character) => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[character] ?? character));
    const subjectBySlug = (slug:string) => subjects.find((item) => item.slug === slug);
    const categoryOptions = (subjectSlug:string) => {
      const map = new Map((subjectBySlug(subjectSlug)?.categories ?? []).map((item) => [item.slug,item]));
      [...staticEntries,...customEntries].filter((item) => item.subject === subjectSlug).forEach((item) => { if (!map.has(item.category)) map.set(item.category,{slug:item.category,name:item.category,order:999}); });
      return [...map.values()].sort((a,b) => a.order-b.order || a.name.localeCompare(b.name,"ja"));
    };
    const allEntries = () => [...customEntries,...staticEntries].filter((entry,index,array) => array.findIndex((item) => item.subject === entry.subject && item.category === entry.category && item.slug === entry.slug) === index);
    const fillParentOptions = (select:HTMLSelectElement, subject:string, category:string, excluded:string = "", selected = "") => {
      const entries = allEntries().filter((entry) => entry.id && entry.subject === subject && entry.category === category && entry.id !== excluded && entry.status !== "archived").sort((a,b) => a.order-b.order || a.title.localeCompare(b.title,"ja"));
      select.innerHTML = `<option value="">最上位</option>${entries.map((entry) => `<option value="${esc(entry.id)}">${esc(entry.title)}</option>`).join("")}`;
      select.value = entries.some((entry) => entry.id === selected) ? selected : "";
    };
    const fillSubjects = (selected = subjectSelect.value || initialSubject) => {
      const options = subjects.map((item) => `<option value="${esc(item.slug)}">${esc(item.name)}${item.status === "preparing" ? "（準備中）" : ""}</option>`).join("");
      subjectSelect.innerHTML = options || '<option value="">分野がありません</option>'; formSubject.innerHTML = options;
      const value = subjects.some((item) => item.slug === selected) ? selected : subjects[0]?.slug ?? ""; subjectSelect.value = value; formSubject.value = value; fillCategories(); fillFormCategories();
    };
    const fillCategories = (selected = categorySelect.value || initialCategory) => { const options = categoryOptions(subjectSelect.value); categorySelect.innerHTML = `<option value="">すべてのカテゴリ</option>${options.map((item) => `<option value="${esc(item.slug)}">${esc(item.name)}</option>`).join("")}`; categorySelect.value = options.some((item) => item.slug === selected) ? selected : ""; };
    const fillFormCategories = (selected = formCategory.value) => { const options = categoryOptions(formSubject.value); formCategory.innerHTML = options.map((item) => `<option value="${esc(item.slug)}">${esc(item.name)}</option>`).join(""); formCategory.value = options.some((item) => item.slug === selected) ? selected : options[0]?.slug ?? ""; fillParentOptions(formParent, formSubject.value, formCategory.value); };
    const documentFor = (entry:Entry) => entry.document_id ? documents.find((item) => item.id === entry.document_id) : documents.find((item) => item.subject === entry.subject && item.category === entry.category && (item.slug === entry.slug || item.title === entry.title));
    const editorUrl = (entry:Entry, document?:DocumentRow) => document ? `/admin/editor/?document=${encodeURIComponent(document.id)}${entry.id ? `&outlineId=${encodeURIComponent(entry.id)}` : ""}` : `/admin/editor/?new=1&subject=${encodeURIComponent(entry.subject)}&category=${encodeURIComponent(entry.category)}&slug=${encodeURIComponent(entry.slug)}&title=${encodeURIComponent(entry.title)}${entry.summary ? `&summary=${encodeURIComponent(entry.summary)}` : ""}${entry.concept_id ? `&conceptId=${encodeURIComponent(entry.concept_id)}` : ""}${entry.id ? `&outlineId=${encodeURIComponent(entry.id)}` : ""}`;
    const orderDirty = new Set<string>();
    const selectedKeys = new Set<string>();
    const orderButton = root.querySelector<HTMLButtonElement>("[data-outline-save-order]")!;
    const confirmButton = root.querySelector<HTMLButtonElement>("[data-outline-confirm]")!;
    const bulkArchiveButton = root.querySelector<HTMLButtonElement>("[data-outline-bulk-archive]")!;
    const bulkRestoreButton = root.querySelector<HTMLButtonElement>("[data-outline-bulk-restore]")!;
    const selectionCount = root.querySelector<HTMLElement>("[data-outline-selection-count]")!;
    const updateToolbar = () => { selectionCount.textContent = `${selectedKeys.size}件選択`; confirmButton.disabled = selectedKeys.size === 0; bulkArchiveButton.disabled = selectedKeys.size === 0; bulkRestoreButton.disabled = selectedKeys.size === 0 || !includeArchived.checked; orderButton.disabled = orderDirty.size === 0; };
    const entryStatus = (entry:Entry) => {
      const document = documentFor(entry);
      if (!document) return entry.progress === "in-progress" ? "執筆中" : "未着手";
      if (document.published_at) return "公開済み";
      if (document.publication_action === "publish" && document.publication_pr_number) return "公開処理中";
      if (document.scheduled_publish_at) return "公開予約";
      if (document.status === "approved") return "公開準備完了";
      if (document.status === "in-review") return "フィードバック中";
      if (document.status === "on-hold") return "修正中";
      if (document.status === "draft") return "下書き";
      return "執筆中";
    };
    const renderEntry = (entry:Entry, childrenByParent:Map<string,Entry[]>, depth:number):string => {
      const document = documentFor(entry); const archived = entry.status === "archived"; const status = archived ? "アーカイブ済み" : entryStatus(entry); const tone = archived ? "" : ["公開済み", "公開準備完了", "公開予約"].includes(status) ? "outline-status-ready" : ["下書き", "執筆中", "フィードバック中", "修正中", "公開処理中"].includes(status) ? "outline-status-progress" : ""; const id = entry.id ? esc(entry.id) : ""; const selectionKey = esc(entry.key); const editable = Boolean(entry.id); const children = entry.id ? (childrenByParent.get(entry.id) ?? []) : [];
      const move = editable && !archived ? `<button type="button" data-move-entry="up" aria-label="${esc(entry.title)}を上へ">↑</button><button type="button" data-move-entry="down" aria-label="${esc(entry.title)}を下へ">↓</button>` : "";
      return `<article class="outline-entry${archived ? " is-archived" : ""}" style="--outline-depth:${depth}" data-outline-entry data-entry-id="${id}" data-entry-key="${selectionKey}" draggable="${editable && !archived}"><input class="outline-select" type="checkbox" data-outline-select="${selectionKey}" aria-label="${esc(entry.title)}を選択" ${selectedKeys.has(entry.key) ? "checked" : ""} ${archived && !includeArchived.checked ? "disabled" : ""}><button class="outline-drag-handle" type="button" data-drag-handle="${id}" aria-label="${esc(entry.title)}の並び順を変更" ${editable && !archived ? "" : "disabled"}>⋮⋮</button><div class="outline-entry-main"><div class="outline-entry-title">${esc(entry.title)}</div><div class="outline-entry-meta">${esc(entry.slug)}${entry.summary ? ` ・ ${esc(entry.summary)}` : ""}</div></div><span class="outline-status ${tone}">${status}</span><div class="outline-entry-actions">${move}${editable ? `<button type="button" data-edit-entry="${id}" ${archived ? "disabled" : ""}>編集</button><button type="button" data-archive-entry="${id}" data-archive-action="${archived ? "restore" : "archive"}">${archived ? "復元" : "アーカイブ"}</button>` : ""}<a href="${editorUrl(entry,document)}">${document ? "記事を開く" : "執筆を開始"}</a></div></article>${children.length ? `<div class="outline-children" data-parent-id="${id}">${children.map((child) => renderEntry(child, childrenByParent, depth + 1)).join("")}</div>` : ""}`;
    };
    const render = () => {
      const selectedSubject = subjectSelect.value; const selectedCategory = categorySelect.value;
      const filtered = allEntries().filter((entry) => entry.subject === selectedSubject && (!selectedCategory || entry.category === selectedCategory) && (includeArchived.checked || entry.status !== "archived")).sort((a,b) => a.category.localeCompare(b.category) || a.order-b.order || a.title.localeCompare(b.title,"ja"));
      count.textContent = `${filtered.length}件`;
      const groups = new Map<string,Entry[]>(); filtered.forEach((entry) => groups.set(entry.category,[...(groups.get(entry.category) ?? []),entry]));
      list.innerHTML = groups.size ? [...groups.entries()].map(([category,entries]) => { const name = categoryOptions(selectedSubject).find((item) => item.slug === category)?.name ?? category; const childrenByParent = new Map<string,Entry[]>(); entries.forEach((entry) => { if (entry.parent_id) childrenByParent.set(entry.parent_id,[...(childrenByParent.get(entry.parent_id) ?? []),entry]); }); const roots = entries.filter((entry) => !entry.parent_id || !entries.some((candidate) => candidate.id === entry.parent_id)); return `<section class="outline-category" data-outline-category="${esc(category)}"><div class="outline-category-heading"><h3>${esc(name)}</h3><span>${entries.length}件</span></div>${roots.map((entry) => renderEntry(entry, childrenByParent, 0)).join("")}</section>`; }).join("") : '<p class="outline-empty">この分野には目次項目がありません。上の「目次項目を追加」から作成できます。</p>';
      updateToolbar();
    };
    const loadPaged = async <T extends { error?: string; pagination?: { hasMore?: boolean; nextCursor?: string | null }; [key: string]: unknown }>(path: string, key: "documents" | "entries", limit: number, fallback: string) => {
      const rows: unknown[] = [];
      let cursor = "";
      let first: T | null = null;
