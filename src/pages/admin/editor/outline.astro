        const separator = path.includes("?") ? "&" : "?";
        const response = await fetch(`${path}${separator}limit=${limit}${cursor ? `&cursor=${encodeURIComponent(cursor)}` : ""}`, { credentials:"same-origin", cache:"no-store" });
        const data = await response.json() as T;
        if (!first) first = data;
        if (!response.ok) throw new Error(data.error ?? fallback);
        const pageRows = Array.isArray(data[key]) ? data[key] : [];
        rows.push(...pageRows);
        if (!data.pagination?.hasMore || !data.pagination.nextCursor) break;
        cursor = data.pagination.nextCursor;
      }
      return { data: first ?? ({} as T), rows };
    };
    const load = async () => {
      const [documentsPage, outlinePage, taxonomyResponse] = await Promise.all([
        loadPaged<{ documents?:DocumentRow[];scope?:{subjects?:string[];isManager?:boolean};error?:string;pagination?:{hasMore?:boolean;nextCursor?:string|null}}>("/api/admin/editor/documents", "documents", 100, "原稿一覧を読み込めませんでした。"),
        loadPaged<{ entries?:Entry[];error?:string;pagination?:{hasMore?:boolean;nextCursor?:string|null}}>(`/api/admin/editor/outline?project=atlas${includeArchived.checked ? "&includeArchived=1" : ""}`, "entries", 200, "目次を読み込めませんでした。"),
        fetch("/api/admin/editor/taxonomy?project=atlas",{credentials:"same-origin",cache:"no-store"}),
      ]);
