  .outline-entry-actions button[data-move-entry]{font-size:.75rem;line-height:1;min-width:1.7rem;padding:.3rem;}
  .outline-entry.is-archived{opacity:.7;}
  .outline-edit-dialog{background:var(--background-primary);border:1px solid var(--border-strong);color:var(--text-primary);max-width:34rem;padding:0;width:calc(100vw - 2rem);}
