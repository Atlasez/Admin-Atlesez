      updateToolbar();
    });
    root.addEventListener("dragend", () => { root.querySelectorAll(".is-dragging,.is-drop-target").forEach((item) => item.classList.remove("is-dragging","is-drop-target")); draggedId = ""; });
    orderButton.addEventListener("click", () => { const items = [...root.querySelectorAll<HTMLElement>("[data-outline-category]")].flatMap((group) => { const counters = new Map<string,number>(); return [...group.querySelectorAll<HTMLElement>("[data-outline-entry][data-entry-id]")].map((item) => { const parentId = item.parentElement?.classList.contains("outline-children") ? item.parentElement.dataset.parentId ?? null : null; const next = (counters.get(parentId ?? "") ?? 0) + 1; counters.set(parentId ?? "", next); return { id:item.dataset.entryId!, sortOrder:next * 10, parentId }; }); }); orderButton.disabled = true; void patchEntry({ action:"reorder", items }).then(() => orderDirty.clear()).catch((error) => { orderButton.disabled = false; alert(error instanceof Error ? error.message : "並び順を保存できませんでした。"); }); });
    confirmButton.addEventListener("click", () => { const selected = allEntries().filter((entry) => selectedKeys.has(entry.key)); const summary = selected.map((entry) => `${entry.title}：${entryStatus(entry)}`).join("\n"); if (summary) alert(`選択した記事の状態\n\n${summary}`); });
    root.querySelector<HTMLFormElement>("[data-outline-form]")?.addEventListener("submit", async (event) => { event.preventDefault(); const form = event.currentTarget as HTMLFormElement; const output = form.querySelector<HTMLOutputElement>("[data-outline-form-message]")!; const values = Object.fromEntries(new FormData(form).entries()); const submit = form.querySelector<HTMLButtonElement>("button[type=submit]")!; submit.disabled = true; output.textContent = "追加しています…"; try { const response = await fetch("/api/admin/editor/outline",{method:"POST",credentials:"same-origin",headers:{"content-type":"application/json"},body:JSON.stringify(values)}); const result = await response.json() as {error?:string}; if (!response.ok) throw new Error(result.error ?? "目次を追加できませんでした。"); output.textContent = "目次に追加しました。"; form.reset(); fillSubjects(subjectSelect.value); await run(); } catch (error) { output.textContent = error instanceof Error ? error.message : "目次を追加できませんでした。"; } finally { submit.disabled = false; } });
    editForm.addEventListener("submit", async (event) => { event.preventDefault(); const values = Object.fromEntries(new FormData(editForm).entries()); const output = editForm.querySelector<HTMLOutputElement>("[data-outline-edit-message]")!; const submit = editForm.querySelector<HTMLButtonElement>("button[type=submit]")!; submit.disabled = true; output.textContent = "保存しています…"; try { await patchEntry({ ...values, action:"update", sortOrder:Number(values.sortOrder ?? 0), parentId:values.parentId || null }); editDialog.close(); } catch (error) { output.textContent = error instanceof Error ? error.message : "目次を更新できませんでした。"; } finally { submit.disabled = false; } });
