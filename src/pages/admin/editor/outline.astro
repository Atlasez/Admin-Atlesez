      const target = (event.target as HTMLElement).closest<HTMLElement>("[data-outline-entry]");
      const targetContainer = (event.target as HTMLElement).closest<HTMLElement>(".outline-children");
      clearDropTargets();
      if (!source || (!target && !targetContainer)) { draggedId = ""; return; }
      const category = source.closest<HTMLElement>("[data-outline-category]");
      if ((target && categoryOf(target) !== category?.dataset.outlineCategory) || (targetContainer && targetContainer.closest<HTMLElement>("[data-outline-category]") !== category) || (target && (target === source || isDescendantTarget(source, target, targetContainer)))) { draggedId = ""; return; }
      event.preventDefault();
