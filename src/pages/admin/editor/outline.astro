        const subject = entry.subject ?? entry.subject_slug ?? "";
        const category = entry.category ?? entry.category_slug ?? "";
        const slug = entry.slug ?? "";
        const id = entry.id;
        return {
          ...entry,
          id,
          subject,
          category,
          parent_id: entry.parent_id ?? null,
          key: id ?? `${subject}/${category}/${slug}`,
          order: Number(entry.sort_order ?? entry.order ?? 0),
        };
      });
      const catalog = (taxonomyData.catalog ?? []).filter((item) => item.status !== "archived"); const merged = new Map(subjects.map((item) => [item.slug,{...item,categories:[...item.categories]}])); catalog.filter((item) => item.kind === "subject").forEach((item) => { if (!merged.has(item.slug)) merged.set(item.slug,{slug:item.slug,name:item.name,status:"preparing",categories:[]}); }); catalog.filter((item) => item.kind === "category").forEach((item) => { const subject = merged.get(item.subject_slug); if (subject && !subject.categories.some((category) => category.slug === item.slug)) subject.categories.push({slug:item.slug,name:item.name,order:Number(item.sort_order ?? 0)}); });
      const permitted = documentsData.scope?.isManager || !documentsData.scope?.subjects?.length ? null : new Set(documentsData.scope.subjects); subjects = [...merged.values()].filter((item) => !permitted || permitted.has(item.slug)); staticEntries = staticEntries.filter((entry) => !permitted || permitted.has(entry.subject)); fillSubjects(); render();
    };
    const retry = createAdminLoadRetry(root, () => load(), "目次を読み込めませんでした。");
    const run = async () => { retry.begin(); try { await load(); retry.success(); } catch (error) { retry.fail(error); list.innerHTML = `<p class="outline-empty">${esc(error instanceof Error ? error.message : "目次を読み込めませんでした。")}</p>`; } };
    const patchEntry = async (payload:Record<string,unknown>) => { const response = await fetch("/api/admin/editor/outline", { method:"PATCH", credentials:"same-origin", headers:{"content-type":"application/json"}, body:JSON.stringify(payload) }); const result = await response.json() as {error?:string}; if (!response.ok) throw new Error(result.error ?? "目次項目を更新できませんでした。"); await run(); };
    const selectedIds = () => allEntries().filter((entry) => selectedKeys.has(entry.key) && entry.id).map((entry) => entry.id as string);
    subjectSelect.addEventListener("change", () => { fillCategories(); formSubject.value = subjectSelect.value; fillFormCategories(); selectedKeys.clear(); orderDirty.clear(); render(); }); categorySelect.addEventListener("change", () => { selectedKeys.clear(); render(); }); includeArchived.addEventListener("change", () => { selectedKeys.clear(); orderDirty.clear(); void run(); }); formSubject.addEventListener("change", () => { fillFormCategories(); }); formCategory.addEventListener("change", () => fillParentOptions(formParent, formSubject.value, formCategory.value));
    root.addEventListener("change", (event) => { const input = (event.target as HTMLElement).closest<HTMLInputElement>("[data-outline-select]"); if (!input) return; const key = input.dataset.outlineSelect; if (!key) return; if (input.checked) selectedKeys.add(key); else selectedKeys.delete(key); updateToolbar(); });
    root.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;
      const move = target.closest<HTMLButtonElement>("[data-move-entry]");
      if (move) { const entry = move.closest<HTMLElement>("[data-outline-entry]"); const container = entry?.parentElement; if (!entry || !container) return; const sibling = move.dataset.moveEntry === "up" ? entry.previousElementSibling : entry.nextElementSibling; if (!(sibling instanceof HTMLElement) || !sibling.matches("[data-outline-entry]")) return; if (move.dataset.moveEntry === "up") container.insertBefore(entry, sibling); else container.insertBefore(sibling, entry); container.querySelectorAll<HTMLElement>("[data-outline-entry][data-entry-id]").forEach((item) => { if (item.dataset.entryId) orderDirty.add(item.dataset.entryId); }); updateToolbar(); return; }
      const archive = target.closest<HTMLButtonElement>("[data-archive-entry]");
      if (archive) { const id = archive.dataset.archiveEntry; const action = archive.dataset.archiveAction === "restore" ? "restore" : "archive"; if (!id || !confirm(action === "restore" ? "この目次項目を復元しますか？" : "この目次項目をアーカイブしますか？")) return; archive.disabled = true; void patchEntry({ id, action }).catch((error) => { archive.disabled = false; alert(error instanceof Error ? error.message : "目次項目を更新できませんでした。"); }); return; }
      const edit = target.closest<HTMLButtonElement>("[data-edit-entry]");
      if (edit) { const id = edit.dataset.editEntry; const entry = allEntries().find((item) => item.id === id); if (!entry) return; (editForm.elements.namedItem("id") as HTMLInputElement).value = entry.id ?? ""; (editForm.elements.namedItem("title") as HTMLInputElement).value = entry.title; (editForm.elements.namedItem("slug") as HTMLInputElement).value = entry.slug; (editForm.elements.namedItem("summary") as HTMLTextAreaElement).value = entry.summary ?? ""; (editForm.elements.namedItem("sortOrder") as HTMLInputElement).value = String(entry.order); fillParentOptions(editParent, entry.subject, entry.category, entry.id, entry.parent_id ?? ""); editDialog.showModal(); }
    });
    root.querySelector<HTMLButtonElement>("[data-outline-edit-cancel]")?.addEventListener("click", () => editDialog.close());
    bulkArchiveButton.addEventListener("click", () => { const ids = selectedIds(); if (!ids.length || !confirm(`${ids.length}件をアーカイブしますか？`)) return; bulkArchiveButton.disabled = true; void patchEntry({ action:"bulk", ids, status:"archived" }).then(() => selectedKeys.clear()).catch((error) => alert(error instanceof Error ? error.message : "一括アーカイブに失敗しました。")); });
    bulkRestoreButton.addEventListener("click", () => { const ids = selectedIds(); if (!ids.length || !confirm(`${ids.length}件を復元しますか？`)) return; bulkRestoreButton.disabled = true; void patchEntry({ action:"bulk", ids, status:"active" }).then(() => selectedKeys.clear()).catch((error) => alert(error instanceof Error ? error.message : "一括復元に失敗しました。")); });
    let draggedId = "";
    const clearDropTargets = () => root.querySelectorAll<HTMLElement>(".is-drop-target").forEach((item) => item.classList.remove("is-drop-target"));
    const sourceNodes = (entry: HTMLElement) => {
      const nodes: HTMLElement[] = [entry];
      const children = entry.nextElementSibling;
      if (children instanceof HTMLElement && children.matches(`.outline-children[data-parent-id="${CSS.escape(entry.dataset.entryId ?? "")}"]`)) nodes.push(children);
      return nodes;
    };
    const isDescendantTarget = (source: HTMLElement, target: HTMLElement | null, targetContainer: HTMLElement | null) => {
      if (targetContainer?.dataset.parentId === source.dataset.entryId) return true;
      let current: HTMLElement | null = target;
