    };
    const insertAfterSubtree = (container: HTMLElement, target: HTMLElement, nodes: HTMLElement[]) => {
      const anchor = target.nextElementSibling instanceof HTMLElement && target.nextElementSibling.classList.contains("outline-children") ? target.nextElementSibling : target;
      const next = anchor.nextElementSibling;
      nodes.forEach((node) => container.insertBefore(node, next));
    };
    root.addEventListener("dragstart", (event) => { const entry = (event.target as HTMLElement).closest<HTMLElement>("[data-outline-entry]"); if (!entry?.dataset.entryId || entry.getAttribute("draggable") !== "true") return; draggedId = entry.dataset.entryId; entry.classList.add("is-dragging"); event.dataTransfer?.setData("text/plain", draggedId); event.dataTransfer?.setDragImage(entry, 12, 12); });
    root.addEventListener("dragover", (event) => {
      if (!draggedId) return;
