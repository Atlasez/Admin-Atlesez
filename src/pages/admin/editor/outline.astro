---
import { getCollection } from "astro:content";
import AdminLayout from "../../../layouts/AdminLayout.astro";
import AdminRetryNotice from "../../../components/admin/AdminRetryNotice.astro";
import { getPlannedArticles, plannedArticleTitle, plannedProgress } from "../../../lib/planned";

const sourceSubjects = (await getCollection("subjects"))
  .sort((a, b) => a.data.order - b.data.order)
  .map((subject) => ({
    slug: subject.data.slug,
    name: subject.data.name.ja,
    status: subject.data.status,
    categories: subject.data.categories.slice().sort((a, b) => a.order - b.order).map((category) => ({ slug: category.slug, name: category.name.ja, order: category.order })),
  }));
const planned = sourceSubjects.flatMap((subject) => getPlannedArticles(subject.slug).map((item) => ({
  key: `${item.subject}/${item.category}/${item.order}`,
  subject: item.subject,
  category: item.category,
  title: plannedArticleTitle(item, "ja"),
  slug: `planned-${item.category}-${item.order}`,
  order: item.order,
  progress: plannedProgress(item),
})));
const payload = JSON.stringify({ subjects: sourceSubjects, planned }).replace(/</g, "\\u003c");
---

<AdminLayout title="学習サイトの目次" description="分野の構成を先に決め、目次から記事を作成します。">
  <main class="outline-page" data-outline-page data-admin-load-surface data-admin-load-state="loading" aria-busy="true">
    <header class="outline-header">
      <div>
        <h1>学習サイトの目次</h1>
        <p>分野とカテゴリの構成を先に決め、各項目から記事の執筆を始めます。</p>
      </div>
      <nav aria-label="目次の操作"><a href="/admin/editor/?new=1&choose=1">新規記事作成</a><a href="/admin/genre-roles/?project=atlas">分野・カテゴリを管理</a></nav>
    </header>

    <section class="outline-toolbar" aria-label="目次の絞り込み">
      <label>分野<select data-outline-subject></select></label>
      <label>カテゴリ<select data-outline-category></select></label>
      <label class="outline-archive-toggle"><input type="checkbox" data-outline-include-archived />アーカイブ済みを表示</label>
      <div class="outline-toolbar-actions">
        <span class="outline-count" data-outline-count aria-live="polite"></span>
        <span class="outline-selection-count" data-outline-selection-count aria-live="polite">0件選択</span>
        <button type="button" class="outline-button" data-outline-confirm disabled>選択項目を確認</button>
        <button type="button" class="outline-button outline-button-primary" data-outline-save-order disabled>並び順を保存</button>
      </div>
    </section>

    <section class="outline-create" aria-labelledby="outline-create-heading">
      <details>
        <summary id="outline-create-heading">目次項目を追加</summary>
        <form data-outline-form>
          <div class="outline-form-grid">
            <label>分野<select name="subject" data-form-subject required></select></label>
            <label>カテゴリ<select name="category" data-form-category required></select></label>
            <label>記事タイトル<input name="title" required maxlength="160" placeholder="例：ラグランジュの定理" /></label>
            <label>URL名（英小文字）<input name="slug" required pattern="[a-z0-9-]+" maxlength="80" placeholder="lagrange-theorem" /></label>
            <label>表示順<input name="sortOrder" type="number" min="0" max="9999" value="0" /></label>
            <label>概念ID（任意）<input name="conceptId" maxlength="200" placeholder="自動設定も可能" /></label>
            <label class="wide">要約（任意）<textarea name="summary" rows="2" maxlength="500" placeholder="記事一覧に表示する短い説明"></textarea></label>
          </div>
          <div class="outline-form-actions"><button type="submit">目次に追加</button><output data-outline-form-message aria-live="polite"></output></div>
        </form>
      </details>
    </section>

    <section class="outline-results" aria-labelledby="outline-results-heading">
      <div class="outline-results-heading"><h2 id="outline-results-heading">記事の構成</h2><span>本文の進み具合は記事の状態に反映されます。</span></div>
      <div class="outline-list" data-outline-list aria-live="polite"><p class="outline-loading">目次を読み込んでいます…</p></div>
    </section>
    <AdminRetryNotice scope="editor-outline" message="目次を読み込めませんでした。" />
    <script is:inline type="application/json" data-outline-source set:html={payload}></script>
  </main>
</AdminLayout>

<style>
  .outline-page{margin:0 auto;max-width:1160px;padding:0 1.25rem 4rem;color:var(--text-primary)}
  .outline-header{align-items:end;border-bottom:1px solid var(--border-default);display:flex;gap:1rem;justify-content:space-between;padding:2rem 0 1.25rem}
  .outline-header h1{font-size:1.8rem;margin:0}.outline-header p{color:var(--text-secondary);font-size:.82rem;margin:.45rem 0 0}
  .outline-header nav{display:flex;flex-wrap:wrap;gap:.5rem}.outline-header a,.outline-form-actions button{background:var(--accent-primary);border:1px solid var(--accent-primary);color:var(--on-accent);font:inherit;font-size:.78rem;font-weight:800;padding:.55rem .75rem;text-decoration:none}.outline-header a+ a{background:var(--background-secondary);color:var(--text-primary);border-color:var(--border-default)}
  .outline-toolbar{align-items:end;background:var(--background-secondary);border:1px solid var(--border-default);display:flex;flex-wrap:wrap;gap:.75rem;margin:1.15rem 0 .8rem;padding:.8rem}.outline-toolbar label,.outline-form-grid label{color:var(--text-secondary);display:grid;font-size:.75rem;font-weight:800;gap:.3rem}.outline-toolbar select,.outline-form-grid input,.outline-form-grid select,.outline-form-grid textarea{background:var(--background-primary);border:1px solid var(--border-default);color:var(--text-primary);font:inherit;min-height:2.25rem;padding:.45rem .55rem}.outline-toolbar label{min-width:12rem}.outline-toolbar-actions{align-items:center;display:flex;flex-wrap:wrap;gap:.5rem;margin-left:auto}.outline-count,.outline-selection-count{color:var(--text-secondary);font-size:.75rem}.outline-button{background:var(--background-primary);border:1px solid var(--border-default);color:var(--text-primary);cursor:pointer;font:inherit;font-size:.72rem;font-weight:800;min-height:2.1rem;padding:.4rem .6rem}.outline-button:hover:not(:disabled),.outline-button:focus-visible{border-color:var(--accent-primary);color:var(--accent-primary)}.outline-button-primary{background:var(--accent-primary);border-color:var(--accent-primary);color:var(--on-accent)}.outline-button:disabled{cursor:not-allowed;opacity:.5}
  .outline-create{border-bottom:1px solid var(--border-default);padding-bottom:.8rem}.outline-create summary{color:var(--accent-primary);cursor:pointer;font-size:.8rem;font-weight:800}.outline-create form{background:var(--background-secondary);border:1px solid var(--border-default);margin-top:.7rem;padding:.8rem}.outline-form-grid{display:grid;gap:.65rem;grid-template-columns:repeat(3,minmax(0,1fr))}.outline-form-grid .wide{grid-column:1/-1}.outline-form-actions{align-items:center;display:flex;gap:.7rem;margin-top:.7rem}.outline-form-actions output{color:var(--text-secondary);font-size:.75rem}
  .outline-results{margin-top:1.25rem}.outline-results-heading{align-items:baseline;border-bottom:1px solid var(--border-default);display:flex;gap:.75rem;justify-content:space-between;padding-bottom:.65rem}.outline-results-heading h2{font-size:1.1rem;margin:0}.outline-results-heading span{color:var(--text-secondary);font-size:.72rem}.outline-list{display:grid;gap:.75rem;margin-top:.8rem}.outline-category{border:1px solid var(--border-default);background:var(--background-secondary)}.outline-category-heading{align-items:center;background:var(--surface-alt);border-bottom:1px solid var(--border-default);display:flex;justify-content:space-between;padding:.65rem .8rem}.outline-category-heading h3{font-size:.9rem;margin:0}.outline-category-heading span{color:var(--text-secondary);font-size:.72rem}.outline-entry{align-items:center;border-bottom:1px solid var(--border-default);display:grid;gap:.65rem;grid-template-columns:auto auto minmax(0,1fr) auto auto;padding:.7rem .8rem}.outline-entry:last-child{border-bottom:0}.outline-entry.is-dragging{background:color-mix(in srgb,var(--accent-primary) 10%,var(--background-primary));opacity:.65}.outline-entry.is-drop-target{outline:2px solid var(--accent-primary);outline-offset:-2px}.outline-select{accent-color:var(--accent-primary);height:1rem;width:1rem}.outline-drag-handle{background:transparent;border:0;color:var(--text-secondary);cursor:grab;font-size:1rem;padding:.15rem}.outline-drag-handle:active{cursor:grabbing}.outline-entry-title{font-size:.84rem;font-weight:800}.outline-entry-meta{color:var(--text-secondary);font-size:.7rem;margin-top:.2rem}.outline-status{border:1px solid var(--border-default);color:var(--text-secondary);font-size:.68rem;font-weight:800;padding:.2rem .4rem;white-space:nowrap}.outline-status-ready{border-color:var(--success);color:var(--success)}.outline-status-progress{border-color:var(--warning);color:var(--warning)}.outline-entry a{border:1px solid var(--border-default);color:var(--accent-primary);font-size:.72rem;font-weight:800;padding:.35rem .5rem;text-decoration:none;white-space:nowrap}.outline-entry a:hover{border-color:var(--accent-primary)}.outline-entry-actions{display:flex;gap:.35rem}.outline-entry-actions button{background:transparent;border:1px solid var(--border-default);color:var(--text-secondary);cursor:pointer;font:inherit;font-size:.68rem;padding:.3rem .45rem}.outline-entry-actions button:hover,.outline-entry-actions button:focus-visible{border-color:var(--accent-primary);color:var(--accent-primary)}.outline-empty,.outline-loading{color:var(--text-secondary);font-size:.8rem;padding:1rem 0}.outline-create button:disabled{cursor:wait;opacity:.6}
  .outline-select{appearance:auto!important;block-size:16px!important;box-sizing:border-box;display:block;flex:0 0 16px;height:16px!important;inline-size:16px!important;margin:0;min-block-size:16px!important;min-height:16px!important;min-inline-size:16px!important;padding:0;width:16px!important}
  @media(max-width:760px){.outline-page{padding:0 .85rem 3rem}.outline-header{align-items:start;display:grid}.outline-header nav a{flex:1}.outline-toolbar{display:grid}.outline-toolbar label{min-width:0}.outline-toolbar-actions{margin-left:0}.outline-count{margin:0;padding:0}.outline-form-grid{grid-template-columns:1fr}.outline-form-grid .wide{grid-column:auto}.outline-entry{align-items:start;grid-template-columns:auto auto minmax(0,1fr) auto}.outline-entry .outline-status{grid-column:4;grid-row:1}.outline-entry a{grid-column:3/-1;text-align:center}.outline-entry-actions{grid-column:3/-1}.outline-results-heading{display:grid}}
</style>
<style is:global>
  /* 目次項目はAPI応答から動的に描画するため、チェックの寸法はグローバルに固定する。 */
  .outline-page input[type="checkbox"] {
    accent-color: var(--accent-primary);
    appearance: auto;
    block-size: 16px !important;
    box-sizing: border-box;
    display: block;
    flex: 0 0 16px;
    height: 16px !important;
    inline-size: 16px !important;
    margin: 0;
    min-block-size: 16px !important;
    min-height: 16px !important;
    min-inline-size: 16px !important;
    padding: 0;
    width: 16px !important;
  }
</style>

<script>
  import { createAdminLoadRetry } from "../../../scripts/admin-load-retry";

  type Subject = { slug:string; name:string; status?:string; categories:Array<{slug:string;name:string;order:number}> };
  type Entry = { id?:string; key:string; subject:string; category:string; title:string; slug:string; summary?:string; concept_id?:string; order:number; sort_order?:number; progress?:string; status?:string };
  type DocumentRow = { id:string; subject:string; category:string; slug:string; title:string; status:string; published_at?:string|null };
  const initialize = () => {
    const root = document.querySelector<HTMLElement>("[data-outline-page]");
    const source = root?.querySelector<HTMLScriptElement>("[data-outline-source]");
    if (!root || !source || root.dataset.ready === "true") return;
    root.dataset.ready = "true";
    const data = JSON.parse(source.textContent ?? "{}") as { subjects:Subject[]; planned:Entry[] };
    let subjects = data.subjects ?? [];
    let staticEntries = data.planned ?? [];
    let customEntries:Entry[] = [];
    let documents:DocumentRow[] = [];
    const subjectSelect = root.querySelector<HTMLSelectElement>("[data-outline-subject]")!;
    const categorySelect = root.querySelector<HTMLSelectElement>("[data-outline-category]")!;
    const formSubject = root.querySelector<HTMLSelectElement>("[data-form-subject]")!;
    const formCategory = root.querySelector<HTMLSelectElement>("[data-form-category]")!;
    const includeArchived = root.querySelector<HTMLInputElement>("[data-outline-include-archived]")!;
    const list = root.querySelector<HTMLElement>("[data-outline-list]")!;
    const count = root.querySelector<HTMLElement>("[data-outline-count]")!;
    const esc = (value:unknown) => String(value ?? "").replace(/[&<>"']/g, (character) => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[character] ?? character));
    const subjectBySlug = (slug:string) => subjects.find((item) => item.slug === slug);
    const categoryOptions = (subjectSlug:string) => {
      const map = new Map((subjectBySlug(subjectSlug)?.categories ?? []).map((item) => [item.slug,item]));
      [...staticEntries,...customEntries].filter((item) => item.subject === subjectSlug).forEach((item) => { if (!map.has(item.category)) map.set(item.category,{slug:item.category,name:item.category,order:999}); });
      return [...map.values()].sort((a,b) => a.order-b.order || a.name.localeCompare(b.name,"ja"));
    };
    const fillSubjects = (selected = subjectSelect.value) => {
      const options = subjects.map((item) => `<option value="${esc(item.slug)}">${esc(item.name)}${item.status === "preparing" ? "（準備中）" : ""}</option>`).join("");
      subjectSelect.innerHTML = options || '<option value="">分野がありません</option>'; formSubject.innerHTML = options;
      const value = subjects.some((item) => item.slug === selected) ? selected : subjects[0]?.slug ?? ""; subjectSelect.value = value; formSubject.value = value; fillCategories(); fillFormCategories();
    };
    const fillCategories = (selected = categorySelect.value) => { const options = categoryOptions(subjectSelect.value); categorySelect.innerHTML = `<option value="">すべてのカテゴリ</option>${options.map((item) => `<option value="${esc(item.slug)}">${esc(item.name)}</option>`).join("")}`; categorySelect.value = options.some((item) => item.slug === selected) ? selected : ""; };
    const fillFormCategories = (selected = formCategory.value) => { const options = categoryOptions(formSubject.value); formCategory.innerHTML = options.map((item) => `<option value="${esc(item.slug)}">${esc(item.name)}</option>`).join(""); formCategory.value = options.some((item) => item.slug === selected) ? selected : options[0]?.slug ?? ""; };
    const allEntries = () => [...staticEntries,...customEntries].filter((entry,index,array) => array.findIndex((item) => item.subject === entry.subject && item.category === entry.category && item.slug === entry.slug) === index);
    const documentFor = (entry:Entry) => documents.find((item) => item.subject === entry.subject && item.category === entry.category && (item.slug === entry.slug || item.title === entry.title));
    const editorUrl = (entry:Entry, document?:DocumentRow) => document ? `/admin/editor/?document=${encodeURIComponent(document.id)}` : `/admin/editor/?new=1&subject=${encodeURIComponent(entry.subject)}&category=${encodeURIComponent(entry.category)}&slug=${encodeURIComponent(entry.slug)}&title=${encodeURIComponent(entry.title)}${entry.summary ? `&summary=${encodeURIComponent(entry.summary)}` : ""}${entry.concept_id ? `&conceptId=${encodeURIComponent(entry.concept_id)}` : ""}`;
    const orderDirty = new Set<string>();
    const selectedKeys = new Set<string>();
    const orderButton = root.querySelector<HTMLButtonElement>("[data-outline-save-order]")!;
    const confirmButton = root.querySelector<HTMLButtonElement>("[data-outline-confirm]")!;
    const selectionCount = root.querySelector<HTMLElement>("[data-outline-selection-count]")!;
    const updateToolbar = () => {
      selectionCount.textContent = `${selectedKeys.size}件選択`;
      confirmButton.disabled = selectedKeys.size === 0;
      orderButton.disabled = orderDirty.size === 0;
    };
    const entryStatus = (entry:Entry) => {
      const document = documentFor(entry);
      return document ? (document.published_at ? "公開済み" : document.status === "draft" ? "原稿あり" : "執筆中") : entry.progress === "in-progress" ? "執筆中" : "未着手";
    };
    const render = () => {
      const selectedSubject = subjectSelect.value; const selectedCategory = categorySelect.value;
      const filtered = allEntries().filter((entry) => entry.subject === selectedSubject && (!selectedCategory || entry.category === selectedCategory) && (includeArchived.checked || entry.status !== "archived")).sort((a,b) => a.category.localeCompare(b.category) || a.order-b.order || a.title.localeCompare(b.title,"ja"));
      count.textContent = `${filtered.length}件`;
      const groups = new Map<string,Entry[]>(); filtered.forEach((entry) => groups.set(entry.category,[...(groups.get(entry.category) ?? []),entry]));
      list.innerHTML = groups.size ? [...groups.entries()].map(([category,entries]) => { const name = categoryOptions(selectedSubject).find((item) => item.slug === category)?.name ?? category; return `<section class="outline-category" data-outline-category="${esc(category)}"><div class="outline-category-heading"><h3>${esc(name)}</h3><span>${entries.length}件</span></div>${entries.map((entry) => { const document = documentFor(entry); const archived = entry.status === "archived"; const status = archived ? "アーカイブ済み" : entryStatus(entry); const tone = archived ? "" : status === "公開済み" || status === "原稿あり" ? "outline-status-ready" : status === "執筆中" ? "outline-status-progress" : ""; const id = entry.id ? esc(entry.id) : ""; const selectionKey = esc(entry.key); const editable = Boolean(entry.id); return `<article class="outline-entry${archived ? " is-archived" : ""}" data-outline-entry data-entry-id="${id}" draggable="${editable && !archived}"><input class="outline-select" type="checkbox" data-outline-select="${selectionKey}" aria-label="${esc(entry.title)}を選択" ${selectedKeys.has(entry.key) ? "checked" : ""} ${archived ? "disabled" : ""}><button class="outline-drag-handle" type="button" data-drag-handle="${id}" aria-label="${esc(entry.title)}の並び順を変更" ${editable && !archived ? "" : "disabled"}>⋮⋮</button><div><div class="outline-entry-title">${esc(entry.title)}</div><div class="outline-entry-meta">${esc(entry.slug)}${entry.summary ? ` ・ ${esc(entry.summary)}` : ""}</div></div><span class="outline-status ${tone}">${status}</span><div class="outline-entry-actions">${editable ? `<button type="button" data-edit-entry="${id}" ${archived ? "disabled" : ""}>編集</button><button type="button" data-archive-entry="${id}" data-archive-action="${archived ? "restore" : "archive"}">${archived ? "復元" : "アーカイブ"}</button>` : ""}<a href="${editorUrl(entry,document)}">${document ? "記事を開く" : "執筆を開始"}</a></div></article>`; }).join("")}</section>`; }).join("") : '<p class="outline-empty">この分野には目次項目がありません。上の「目次項目を追加」から作成できます。</p>';
      updateToolbar();
    };
    const load = async () => {
      const [documentsResponse, outlineResponse, taxonomyResponse] = await Promise.all([fetch("/api/admin/editor/documents",{credentials:"same-origin",cache:"no-store"}), fetch(`/api/admin/editor/outline?project=atlas${includeArchived.checked ? "&includeArchived=1" : ""}`,{credentials:"same-origin",cache:"no-store"}), fetch("/api/admin/editor/taxonomy?project=atlas",{credentials:"same-origin",cache:"no-store"})]);
      const documentsData = await documentsResponse.json() as {documents?:DocumentRow[];scope?:{subjects?:string[];isManager?:boolean};error?:string}; const outlineData = await outlineResponse.json() as {entries?:Entry[];error?:string}; const taxonomyData = await taxonomyResponse.json() as {catalog?:Array<{kind:string;subject_slug:string;slug:string;name:string;sort_order?:number;status?:string}>;error?:string};
      if (!documentsResponse.ok) throw new Error(documentsData.error ?? "原稿一覧を読み込めませんでした。"); if (!outlineResponse.ok) throw new Error(outlineData.error ?? "目次を読み込めませんでした。");
      documents = documentsData.documents ?? []; customEntries = (outlineData.entries ?? []).map((entry) => ({...entry,key:entry.id ?? `${entry.subject}/${entry.category}/${entry.slug}`,order:Number(entry.sort_order ?? entry.order ?? 0)}));
      const catalog = (taxonomyData.catalog ?? []).filter((item) => item.status !== "archived"); const merged = new Map(subjects.map((item) => [item.slug,{...item,categories:[...item.categories]}])); catalog.filter((item) => item.kind === "subject").forEach((item) => { if (!merged.has(item.slug)) merged.set(item.slug,{slug:item.slug,name:item.name,status:"preparing",categories:[]}); }); catalog.filter((item) => item.kind === "category").forEach((item) => { const subject = merged.get(item.subject_slug); if (subject && !subject.categories.some((category) => category.slug === item.slug)) subject.categories.push({slug:item.slug,name:item.name,order:Number(item.sort_order ?? 0)}); });
      const permitted = documentsData.scope?.isManager || !documentsData.scope?.subjects?.length ? null : new Set(documentsData.scope.subjects);
      subjects = [...merged.values()].filter((item) => !permitted || permitted.has(item.slug));
      staticEntries = staticEntries.filter((entry) => !permitted || permitted.has(entry.subject));
      fillSubjects(); render();
    };
    const retry = createAdminLoadRetry(root, () => load(), "目次を読み込めませんでした。");
    const run = async () => { retry.begin(); try { await load(); retry.success(); } catch (error) { retry.fail(error); list.innerHTML = `<p class="outline-empty">${esc(error instanceof Error ? error.message : "目次を読み込めませんでした。")}</p>`; } };
    subjectSelect.addEventListener("change", () => { fillCategories(); formSubject.value = subjectSelect.value; fillFormCategories(); selectedKeys.clear(); orderDirty.clear(); render(); }); categorySelect.addEventListener("change", () => { selectedKeys.clear(); render(); }); includeArchived.addEventListener("change", () => { selectedKeys.clear(); orderDirty.clear(); void run(); }); formSubject.addEventListener("change", () => fillFormCategories());
    root.addEventListener("change", (event) => { const input = (event.target as HTMLElement).closest<HTMLInputElement>("[data-outline-select]"); if (!input) return; const key = input.dataset.outlineSelect; if (!key) return; if (input.checked) selectedKeys.add(key); else selectedKeys.delete(key); updateToolbar(); });
      root.addEventListener("click", (event) => { const target = event.target as HTMLElement; const archive = target.closest<HTMLButtonElement>("[data-archive-entry]"); if (archive) { const id = archive.dataset.archiveEntry; const action = archive.dataset.archiveAction === "restore" ? "restore" : "archive"; if (!id || !confirm(action === "restore" ? "この目次項目を復元しますか？" : "この目次項目をアーカイブしますか？")) return; archive.disabled = true; void fetch("/api/admin/editor/outline", { method:"PATCH", credentials:"same-origin", headers:{"content-type":"application/json"}, body:JSON.stringify({ id, action }) }).then(async (response) => { const result = await response.json() as {error?:string}; if (!response.ok) throw new Error(result.error ?? "目次項目を更新できませんでした。"); await run(); }).catch((error) => { archive.disabled = false; alert(error instanceof Error ? error.message : "目次項目を更新できませんでした。"); }); return; } const edit = target.closest<HTMLButtonElement>("[data-edit-entry]"); if (edit) { const id = edit.dataset.editEntry; const entry = allEntries().find((item) => item.id === id); if (!entry) return; const title = prompt("記事タイトル", entry.title); if (title === null || !title.trim()) return; const sortOrder = prompt("表示順", String(entry.order)); if (sortOrder === null) return; edit.disabled = true; void fetch("/api/admin/editor/outline", { method:"PATCH", credentials:"same-origin", headers:{"content-type":"application/json"}, body:JSON.stringify({ id, action:"update", title:title.trim(), sortOrder:Number(sortOrder) }) }).then(async (response) => { const result = await response.json() as {error?:string}; if (!response.ok) throw new Error(result.error ?? "目次を更新できませんでした。"); await run(); }).catch((error) => { edit.disabled = false; alert(error instanceof Error ? error.message : "目次を更新できませんでした。"); }); } });
    let draggedId = "";
    root.addEventListener("dragstart", (event) => { const entry = (event.target as HTMLElement).closest<HTMLElement>("[data-outline-entry]"); if (!entry?.dataset.entryId) return; draggedId = entry.dataset.entryId; entry.classList.add("is-dragging"); event.dataTransfer?.setData("text/plain", draggedId); event.dataTransfer?.setDragImage(entry, 12, 12); });
    root.addEventListener("dragover", (event) => { const target = (event.target as HTMLElement).closest<HTMLElement>("[data-outline-entry]"); if (!target || !draggedId || target.dataset.entryId === draggedId) return; event.preventDefault(); root.querySelectorAll(".is-drop-target").forEach((item) => item.classList.remove("is-drop-target")); target.classList.add("is-drop-target"); });
    root.addEventListener("drop", (event) => { event.preventDefault(); const target = (event.target as HTMLElement).closest<HTMLElement>("[data-outline-entry]"); if (!target || !draggedId || target.dataset.entryId === draggedId) return; const source = root.querySelector<HTMLElement>(`[data-entry-id="${CSS.escape(draggedId)}"]`); if (!source) return; target.parentElement?.insertBefore(source, event.clientY < target.getBoundingClientRect().top + target.getBoundingClientRect().height / 2 ? target : target.nextElementSibling); const entries = [...target.parentElement!.querySelectorAll<HTMLElement>("[data-outline-entry][data-entry-id]")]; entries.forEach((item) => { if (item.dataset.entryId) orderDirty.add(item.dataset.entryId); }); target.classList.remove("is-drop-target"); draggedId = ""; updateToolbar(); });
    root.addEventListener("dragend", () => { root.querySelectorAll(".is-dragging,.is-drop-target").forEach((item) => item.classList.remove("is-dragging","is-drop-target")); draggedId = ""; });
    orderButton.addEventListener("click", () => { const items = [...root.querySelectorAll<HTMLElement>("[data-outline-category]")].flatMap((group) => [...group.querySelectorAll<HTMLElement>("[data-outline-entry][data-entry-id]")].map((item, index) => ({ id:item.dataset.entryId!, sortOrder:(index + 1) * 10 }))); orderButton.disabled = true; void fetch("/api/admin/editor/outline", { method:"PATCH", credentials:"same-origin", headers:{"content-type":"application/json"}, body:JSON.stringify({ action:"reorder", items }) }).then(async (response) => { const result = await response.json() as {error?:string}; if (!response.ok) throw new Error(result.error ?? "並び順を保存できませんでした。"); orderDirty.clear(); await run(); }).catch((error) => { orderButton.disabled = false; alert(error instanceof Error ? error.message : "並び順を保存できませんでした。"); }); });
    confirmButton.addEventListener("click", () => { const selected = allEntries().filter((entry) => selectedKeys.has(entry.key)); const summary = selected.map((entry) => `${entry.title}：${entryStatus(entry)}`).join("\n"); if (summary) alert(`選択した記事の状態\n\n${summary}`); });
    root.querySelector<HTMLFormElement>("[data-outline-form]")?.addEventListener("submit", async (event) => { event.preventDefault(); const form = event.currentTarget as HTMLFormElement; const output = form.querySelector<HTMLOutputElement>("[data-outline-form-message]")!; const values = Object.fromEntries(new FormData(form).entries()); const submit = form.querySelector<HTMLButtonElement>("button[type=submit]")!; submit.disabled = true; output.textContent = "追加しています…"; try { const response = await fetch("/api/admin/editor/outline",{method:"POST",credentials:"same-origin",headers:{"content-type":"application/json"},body:JSON.stringify(values)}); const result = await response.json() as {error?:string}; if (!response.ok) throw new Error(result.error ?? "目次を追加できませんでした。"); output.textContent = "目次に追加しました。"; form.reset(); fillSubjects(subjectSelect.value); await run(); } catch (error) { output.textContent = error instanceof Error ? error.message : "目次を追加できませんでした。"; } finally { submit.disabled = false; } });
    void run();
  };
  document.addEventListener("astro:page-load", initialize); initialize();
