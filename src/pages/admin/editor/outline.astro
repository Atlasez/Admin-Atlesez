  .outline-edit-dialog h2{font-size:1.1rem;margin:0;}
  .outline-edit-dialog label{display:grid;gap:.3rem;font-size:.78rem;font-weight:800;}
  .outline-edit-dialog input,.outline-edit-dialog select,.outline-edit-dialog textarea{background:var(--background-secondary);border:1px solid var(--border-default);color:var(--text-primary);font:inherit;padding:.55rem;}
  .outline-dialog-actions{display:flex;gap:.5rem;justify-content:flex-end;}
