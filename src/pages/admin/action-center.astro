---
import AdminLayout from "../../layouts/AdminLayout.astro";
import AdminRetryNotice from "../../components/admin/AdminRetryNotice.astro";
---

<AdminLayout title="アクションセンター" description="運営で対応が必要な項目をまとめて確認">
  <main class="action-center" data-action-center data-admin-load-surface aria-busy="true">
    <header class="action-center-heading">
      <h1>アクションセンター</h1>
      <button class="refresh-button" type="button" data-action-refresh>更新</button>
    </header>

    <section class="action-summary" aria-label="対応状況" data-action-summary></section>

    <div class="action-center-toolbar" role="toolbar" aria-label="表示する項目">
      <div class="action-filters" role="group" aria-label="項目の絞り込み">
        <button type="button" class="filter-button" data-action-filter="all" aria-pressed="false">すべて</button>
        <button type="button" class="filter-button is-active" data-action-filter="action" aria-pressed="true">未対応</button>
        <button type="button" class="filter-button" data-action-filter="urgent" aria-pressed="false">今日・期限間近</button>
        <button type="button" class="filter-button" data-action-filter="unread" aria-pressed="false">未読通知</button>
        <button type="button" class="filter-button" data-action-filter="assigned" aria-pressed="false">自分の担当</button>
        <button type="button" class="filter-button" data-action-filter="history" aria-pressed="false">完了・履歴</button>
        <label class="saved-view"><span class="visually-hidden">保存ビュー</span><select data-action-saved-view aria-label="保存ビュー"><option value="">保存ビュー</option></select></label>
        <button type="button" class="filter-button save-view-button" data-action-save-view>表示を保存</button>
      </div>
      <output data-action-updated aria-live="polite">読み込み中…</output>
    </div>

    <AdminRetryNotice message="アクションを読み込めませんでした。" />

    <div class="action-undo" data-action-undo hidden role="status" aria-live="polite">
      <span data-action-undo-message></span>
      <button type="button" class="item-action" data-action-undo-button>元に戻す</button>
    </div>

    <section class="action-list" aria-labelledby="action-list-heading">
      <div class="section-heading">
        <h2 id="action-list-heading" data-action-list-heading>対応が必要な項目</h2>
        <div class="section-heading-actions"><label class="select-visible"><input type="checkbox" data-action-select-visible />表示中を選択</label><span data-action-count>—</span></div>
      </div>
      <div class="action-bulkbar" data-action-bulkbar hidden role="toolbar" aria-label="選択項目の一括操作">
        <span data-action-selected-count>0件選択</span>
        <select data-action-bulk-action aria-label="一括操作" disabled><option value="">一括操作…</option></select>
        <button type="button" class="item-action" data-action-bulk-apply disabled>適用</button>
        <button type="button" class="item-action" data-action-clear-selection>選択解除</button>
      </div>
      <div class="action-items" data-action-items aria-live="polite"></div>
    </section>
  </main>
</AdminLayout>

<script>
  import { createAdminLoadRetry } from "../../scripts/admin-load-retry";
  type Action = { entityType: string; entityId: string; fromState: string; toState: string; label: string; expectedUpdatedAt?: string };
  type Item = { id: string; kind: string; title: string; detail: string; href: string; status: string; priority: string; updatedAt: string; dueAt: string | null; project: string | null; subject: string | null; read: boolean; groupCount?: number; notificationIds?: string[]; actions: Action[] };
  type Payload = { view?: "action" | "history"; items?: Item[]; history?: Item[]; counts?: { today?: number; dueSoon?: number; unread?: number; approvals?: number; assigned?: number }; generatedAt?: string };

  const initActionCenter = () => {
    const root = document.querySelector<HTMLElement>("[data-action-center]");
    if (!root || root.dataset.initialized === "true") return;
    root.dataset.initialized = "true";
    const itemsNode = root.querySelector<HTMLElement>("[data-action-items]")!;
    const summaryNode = root.querySelector<HTMLElement>("[data-action-summary]")!;
    const refresh = root.querySelector<HTMLButtonElement>("[data-action-refresh]")!;
    const updated = root.querySelector<HTMLOutputElement>("[data-action-updated]")!;
    const count = root.querySelector<HTMLElement>("[data-action-count]")!;
    const listHeading = root.querySelector<HTMLElement>("[data-action-list-heading]")!;
    const selectVisible = root.querySelector<HTMLInputElement>("[data-action-select-visible]")!;
    const bulkBar = root.querySelector<HTMLElement>("[data-action-bulkbar]")!;
    const selectedCount = root.querySelector<HTMLElement>("[data-action-selected-count]")!;
    const bulkAction = root.querySelector<HTMLSelectElement>("[data-action-bulk-action]")!;
    const bulkApply = root.querySelector<HTMLButtonElement>("[data-action-bulk-apply]")!;
    const clearSelection = root.querySelector<HTMLButtonElement>("[data-action-clear-selection]")!;
    const undoBar = root.querySelector<HTMLElement>("[data-action-undo]")!;
    const undoMessage = root.querySelector<HTMLElement>("[data-action-undo-message]")!;
    const undoButton = root.querySelector<HTMLButtonElement>("[data-action-undo-button]")!;
    const savedView = root.querySelector<HTMLSelectElement>("[data-action-saved-view]")!;
    const saveViewButton = root.querySelector<HTMLButtonElement>("[data-action-save-view]")!;
    const escape = (value: unknown) => String(value ?? "").replace(/[&<>\"']/g, (character) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", "\"": "&quot;", "'": "&#39;" }[character] ?? character));
    const formatTime = (value: string) => value ? new Intl.DateTimeFormat("ja-JP", { dateStyle: "medium", timeStyle: "short" }).format(new Date(value)) : "";
    const statusLabels: Record<string, string> = { open: "未着手", doing: "進行中", done: "完了", archived: "アーカイブ済み", draft: "下書き", "in-review": "査読中", approved: "承認済み", published: "公開済み", scheduled: "予約投稿", new: "新規", reviewing: "確認中", accepted: "受け入れ済み", rejected: "却下", pending: "承認待ち", unread: "未読", read: "既読" };
    const kindLabels: Record<string, string> = { task: "タスク", document: "記事", application: "応募", approval: "承認", notification: "通知" };
    const kindIcons: Record<string, string> = { task: "✓", document: "文", application: "人", approval: "承", notification: "!" };
    const priorityLabels: Record<string, string> = { urgent: "今日対応", "due-soon": "期限間近", new: "新着" };
    const statusTone = (status: string) => status === "done" || status === "approved" || status === "published" || status === "accepted" ? "success" : status === "rejected" ? "danger" : status === "unread" || status === "open" || status === "pending" ? "attention" : "neutral";
    let payload: Payload = {};
    const selected = new Map<string, Item>();
    type UndoEntry = { action: Action; expectedUpdatedAt?: string };
    let undoEntries: UndoEntry[] = [];
    // アクションセンターは、日常の作業に直結する未対応項目を初期表示する。
    // 完了済みを確認する場合は「完了・履歴」を明示的に選択する。
    let filter = "action";
    let controller: AbortController | null = null;
    let retryController: ReturnType<typeof createAdminLoadRetry> | null = null;

    const filteredItems = () => (filter === "history" ? (payload.history ?? []) : (payload.items ?? [])).filter((item) => {
      if (filter === "action") return item.kind !== "notification" || !item.read;
      if (filter === "urgent") return item.priority === "urgent" || item.priority === "due-soon";
      if (filter === "unread") return item.kind === "notification" && !item.read;
      if (filter === "assigned") return item.kind !== "notification";
      if (filter === "history") return true;
      return true;
    });
    const renderSummary = () => {
      const values = [
        ["今日の要対応", Number(payload.counts?.today ?? 0), "期限・緊急項目", "urgent"],
        ["期限が近いタスク", Number(payload.counts?.dueSoon ?? 0), "7日以内の期限", "due-soon"],
        ["未読通知", Number(payload.counts?.unread ?? 0), "確認が必要な通知", "unread"],
        ["承認待ち", Number(payload.counts?.approvals ?? 0), "承認・却下が必要", "approvals"],
        ["担当項目", Number(payload.counts?.assigned ?? 0), "自分に関係する項目", "assigned"],
      ];
      summaryNode.innerHTML = values.map(([label, value, detail, key]) => `<button type="button" class="summary-item" data-summary-filter="${key}"><span>${escape(label)}</span><strong>${value}</strong><small>${escape(detail)}</small></button>`).join("");
      summaryNode.querySelectorAll<HTMLButtonElement>("[data-summary-filter]").forEach((button) => button.addEventListener("click", () => {
        const key = button.dataset.summaryFilter;
        const filterMap: Record<string, string> = { urgent: "urgent", "due-soon": "urgent", unread: "unread", approvals: "action", assigned: "assigned" };
        setFilter(filterMap[key ?? ""] ?? "all");
      }));
    };
    const actionKey = (action: Action) => `${action.entityType}:${action.fromState}:${action.toState}:${action.label}`;
    const renderBulkBar = () => {
      const rows = filteredItems();
      for (const id of [...selected.keys()]) if (!rows.some((item) => item.id === id)) selected.delete(id);
      const selectedRows = rows.filter((item) => selected.has(item.id));
      selectedCount.textContent = `${selectedRows.length}件選択`;
      bulkBar.hidden = selectedRows.length === 0;
      selectVisible.checked = rows.length > 0 && selectedRows.length === rows.length;
      selectVisible.indeterminate = selectedRows.length > 0 && selectedRows.length < rows.length;
      const common = new Map<string, { action: Action; count: number }>();
      if (selectedRows.length) {
        const first = selectedRows[0];
        for (const action of first.actions ?? []) common.set(actionKey(action), { action, count: 1 });
        for (const row of selectedRows.slice(1)) {
          const keys = new Set((row.actions ?? []).map(actionKey));
          for (const key of [...common.keys()]) {
            const entry = common.get(key);
            if (!entry || !keys.has(key)) common.delete(key);
            else entry.count += 1;
          }
        }
      }
      const previous = bulkAction.value;
      bulkAction.innerHTML = `<option value="">一括操作…</option>${[...common.values()].map(({ action }) => `<option value="${escape(actionKey(action))}">${escape(action.label)}（${selectedRows.length}件）</option>`).join("")}`;
      bulkAction.value = [...common.keys()].includes(previous) ? previous : "";
      bulkAction.disabled = common.size === 0;
      bulkApply.disabled = !bulkAction.value || common.size === 0;
    };
    const renderItems = () => {
      const rows = filteredItems();
      count.textContent = `${rows.length}件`;
      if (!rows.length) {
        itemsNode.innerHTML = `<div class="action-empty"><strong>${filter === "history" ? "完了・アーカイブ済みの項目はありません。" : "対応が必要な項目はありません。"}</strong><span>${filter === "history" ? "対応を完了するとここに表示されます。" : "新しい項目が追加されるとここに表示されます。"}</span></div>`;
        renderBulkBar();
        return;
      }
      itemsNode.innerHTML = rows.map((item) => {
        const actions = (item.actions ?? []).map((action) => `<button type="button" class="item-action" data-transition='${escape(JSON.stringify(action))}'>${escape(action.label)}</button>`).join("");
        const due = item.dueAt ? `<span class="item-due ${item.priority === "urgent" ? "is-urgent" : ""}">期限 ${escape(formatTime(item.dueAt))}</span>` : "";
        const group = item.groupCount && item.groupCount > 1 ? `<span class="item-group">同じ通知 ${item.groupCount}件</span>` : "";
        const readButton = item.kind === "notification" && !item.read ? `<button type="button" class="item-read" data-read-notification='${escape(JSON.stringify(item.notificationIds ?? [item.id.replace(/^notification:/, "")]))}'>既読にする</button>` : "";
        const tone = statusTone(item.status);
        const isSelected = selected.has(item.id);
        return `<article class="action-item priority-${escape(item.priority)} status-${tone} ${item.read ? "is-read" : "is-unread"}">
          <div class="item-leading"><input class="item-select" type="checkbox" data-action-select="${escape(item.id)}" ${isSelected ? "checked" : ""} aria-label="${escape(item.title)}を選択" /><span class="item-kind-icon" aria-hidden="true">${escape(kindIcons[item.kind] ?? "・")}</span><span class="item-priority-dot" aria-hidden="true"></span></div>
          <div class="item-main"><div class="item-top"><span class="item-kind">${escape(kindLabels[item.kind] ?? item.kind)}</span><span class="item-status">${escape(statusLabels[item.status] ?? item.status)}</span>${priorityLabels[item.priority] ? `<span class="item-priority">${escape(priorityLabels[item.priority])}</span>` : ""}</div>
            <a class="item-title" href="${escape(item.href)}">${escape(item.title)}</a><p>${escape(item.detail)}</p>
            <div class="item-meta"><span>${escape(item.project ?? "")}</span>${item.subject ? `<span>${escape(item.subject)}</span>` : ""}<time datetime="${escape(item.updatedAt)}">${escape(formatTime(item.updatedAt))}</time>${due}${group}</div>
          </div><div class="item-actions">${actions}${readButton}<a class="item-open" href="${escape(item.href)}" aria-label="${escape(item.title)}を開く">開く</a></div>
        </article>`;
      }).join("");
      itemsNode.querySelectorAll<HTMLButtonElement>("[data-transition]").forEach((button) => button.addEventListener("click", () => {
        const raw = button.dataset.transition;
        if (!raw) return;
        let action: Action;
        try { action = JSON.parse(raw) as Action; } catch { return; }
        void performTransition(action, button);
      }));
      itemsNode.querySelectorAll<HTMLButtonElement>("[data-read-notification]").forEach((button) => button.addEventListener("click", () => {
        let ids: string[] = [];
        try { ids = JSON.parse(button.dataset.readNotification ?? "[]") as string[]; } catch { ids = []; }
        void markRead(ids).catch(() => { button.textContent = "既読にできません"; });
      }));
      itemsNode.querySelectorAll<HTMLInputElement>("[data-action-select]").forEach((checkbox) => checkbox.addEventListener("change", () => {
        const item = rows.find((candidate) => candidate.id === checkbox.dataset.actionSelect);
        if (!item) return;
        if (checkbox.checked) selected.set(item.id, item); else selected.delete(item.id);
        renderBulkBar();
      }));
      renderBulkBar();
    };
    const setFilter = (next: string) => {
      const changedView = (filter === "history") !== (next === "history");
      filter = next;
      selected.clear();
      listHeading.textContent = filter === "history" ? "完了・アーカイブ済み" : "対応が必要な項目";
      root.querySelectorAll<HTMLButtonElement>("[data-action-filter]").forEach((button) => { const active = button.dataset.actionFilter === filter; button.classList.toggle("is-active", active); button.setAttribute("aria-pressed", String(active)); });
      renderItems();
      if (changedView) void load(next === "history" ? "history" : "action");
    };
    const savedViewsKey = "atlasez-admin-action-center-views";
    const readSavedViews = (): Array<{ id: string; label: string; filter: string }> => {
      try {
        const parsed = JSON.parse(localStorage.getItem(savedViewsKey) ?? "[]");
        if (!Array.isArray(parsed)) return [];
        return parsed.filter((view): view is { id: string; label: string; filter: string } =>
          view && typeof view.id === "string" && typeof view.label === "string" && typeof view.filter === "string" && ["all", "action", "urgent", "unread", "assigned", "history"].includes(view.filter),
        ).slice(0, 8);
      } catch { return []; }
    };
    const renderSavedViews = () => {
      savedView.innerHTML = `<option value="">保存ビュー</option>${readSavedViews().map((view) => `<option value="${escape(view.id)}">${escape(view.label)}</option>`).join("")}`;
      savedView.value = "";
    };
    savedView.addEventListener("change", () => {
      const selected = readSavedViews().find((view) => view.id === savedView.value);
      if (selected) setFilter(selected.filter);
      savedView.value = "";
    });
    saveViewButton.addEventListener("click", () => {
      const label = window.prompt("この表示の名前を入力してください。", filter === "action" ? "未対応" : filter === "history" ? "完了・履歴" : "アクション表示");
      if (!label?.trim()) return;
      const views = readSavedViews().filter((view) => view.label !== label.trim());
      views.unshift({ id: crypto.randomUUID(), label: label.trim().slice(0, 40), filter });
      try { localStorage.setItem(savedViewsKey, JSON.stringify(views.slice(0, 8))); } catch { /* 保存できない環境でも通常の絞り込みは継続する */ }
      renderSavedViews();
    });
    renderSavedViews();
    const load = async (requestedView: "action" | "history" = filter === "history" ? "history" : "action") => {
      controller?.abort(); controller = new AbortController();
      retryController?.begin(); refresh.disabled = true; updated.value = "読み込み中…";
      try {
        const response = await fetch(`/api/admin/action-center?view=${requestedView}`, { credentials: "same-origin", cache: "no-store", signal: controller.signal });
        const data = await response.json().catch(() => ({})) as Payload & { error?: string };
        if (!response.ok) throw new Error(data.error || "アクションを読み込めませんでした。");
        // 履歴表示の応答は履歴だけ、通常表示の応答は未対応項目だけを返す。
        // 画面上のサマリーと、直前に表示していたもう一方の一覧は保持する。
        payload = requestedView === "history"
          ? { ...payload, ...data, items: payload.items ?? [], counts: payload.counts ?? data.counts }
          : { ...payload, ...data, history: payload.history ?? data.history };
        renderSummary(); renderItems(); updated.value = data.generatedAt ? `更新：${formatTime(data.generatedAt)}` : "更新済み"; retryController?.success();
      } catch (loadError) {
        if (loadError instanceof DOMException && loadError.name === "AbortError") return;
        retryController?.fail(loadError);
      } finally { refresh.disabled = false; }
    };
    const markRead = async (ids: string[]) => {
      ids = ids.filter(Boolean);
      if (!ids.length) return;
      const response = await fetch("/api/admin/notifications/read", { method: "POST", credentials: "same-origin", headers: { "content-type": "application/json" }, body: JSON.stringify({ ids }) });
      if (!response.ok) throw new Error("通知を既読にできませんでした。");
      await load();
    };
    const postTransition = async (action: Action) => {
      const response = await fetch("/api/admin/workflow/transition", { method: "POST", credentials: "same-origin", headers: { "content-type": "application/json" }, body: JSON.stringify({ ...action, idempotencyKey: crypto.randomUUID() }) });
      const result = await response.json().catch(() => ({})) as { error?: string; transition?: { updatedAt?: string } };
      if (!response.ok) throw new Error(result.error || "状態を変更できませんでした。");
      return result;
    };
    const offerUndo = (entries: UndoEntry[]) => {
      undoEntries = entries
        .filter((entry) => entry.action.entityType === "task" && entry.action.toState === "done")
        .map((entry) => ({
          expectedUpdatedAt: entry.expectedUpdatedAt,
          action: { ...entry.action, fromState: "done", toState: "open", label: "再開" },
        }));
      if (!undoEntries.length) { undoBar.hidden = true; return; }
      undoMessage.textContent = `${undoEntries.length}件を完了にしました。`;
      undoBar.hidden = false;
    };
    const performTransition = async (action: Action, button: HTMLButtonElement) => {
      if (action.toState === "rejected" && !window.confirm("この項目を見送りますか？")) return;
      button.disabled = true;
      try {
        const result = await postTransition(action);
        offerUndo([{ action, expectedUpdatedAt: result.transition?.updatedAt }]);
        await load();
      } catch (transitionError) { button.disabled = false; button.textContent = transitionError instanceof Error ? transitionError.message : "変更失敗"; }
    };
    bulkAction.addEventListener("change", () => { bulkApply.disabled = !bulkAction.value; });
    clearSelection.addEventListener("click", () => { selected.clear(); renderItems(); });
    selectVisible.addEventListener("change", () => {
      const rows = filteredItems();
      if (selectVisible.checked) rows.forEach((item) => selected.set(item.id, item)); else selected.clear();
      renderItems();
    });
    bulkApply.addEventListener("click", async () => {
      const rows = filteredItems().filter((item) => selected.has(item.id));
      const key = bulkAction.value;
      if (!key || !rows.length) return;
      const actions = rows.map((item) => (item.actions ?? []).find((action) => actionKey(action) === key)).filter((action): action is Action => Boolean(action));
      if (!actions.length) return;
      if (actions.some((action) => action.toState === "rejected") && !window.confirm(`${actions.length}件を見送りますか？`)) return;
      bulkApply.disabled = true;
      const undo: UndoEntry[] = [];
      let failed = 0;
      for (const action of actions) {
        try {
          const result = await postTransition(action);
          undo.push({ action, expectedUpdatedAt: result.transition?.updatedAt });
        } catch { failed += 1; }
      }
      selected.clear();
      offerUndo(undo);
      await load();
      if (failed) updated.value = `${failed}件は状態が変わっているため適用できませんでした。`;
    });
    undoButton.addEventListener("click", async () => {
      if (!undoEntries.length || !window.confirm(`${undoEntries.length}件を元に戻しますか？`)) return;
      undoButton.disabled = true;
      const entries = [...undoEntries];
      let failed = 0;
      for (const entry of entries) {
        try { await postTransition({ ...entry.action, expectedUpdatedAt: entry.expectedUpdatedAt }); } catch { failed += 1; }
      }
      undoEntries = [];
      undoBar.hidden = true;
      undoButton.disabled = false;
      await load();
      if (failed) updated.value = `${failed}件は最新状態が異なるため元に戻せませんでした。`;
    });
    root.querySelectorAll<HTMLButtonElement>("[data-action-filter]").forEach((button) => button.addEventListener("click", () => setFilter(button.dataset.actionFilter ?? "all")));
    retryController = createAdminLoadRetry(root, () => load(), "アクションを読み込めませんでした。");
    refresh.addEventListener("click", () => void load());
    document.addEventListener("visibilitychange", () => { if (document.visibilityState === "visible") void load(); });
    window.setInterval(() => { if (document.visibilityState === "visible") void load(); }, 45_000);
    void load();
  };
  document.addEventListener("astro:page-load", initActionCenter); initActionCenter();
</script>

<style is:global>
  .action-center { margin: 0 auto; max-width: 1180px; padding: 0 1.25rem 4rem; }
  .action-center-heading { align-items: center; border-bottom: 1px solid var(--border-default); display: flex; gap: 1rem; justify-content: space-between; padding: 1.35rem 0 .85rem; }
  .action-center-heading h1 { font-size: clamp(1.45rem, 2.5vw, 1.85rem); letter-spacing: -.03em; margin: 0; }
  .refresh-button, .filter-button, .item-action, .item-read { background: var(--background-secondary); border: 1px solid var(--border-default); border-radius: .35rem; color: var(--text-primary); cursor: pointer; font: inherit; font-size: .72rem; font-weight: 700; min-height: 2.2rem; padding: .35rem .65rem; }
  .refresh-button:hover, .filter-button:hover, .item-action:hover, .item-read:hover { border-color: var(--accent-primary); }
  .refresh-button:focus-visible, .filter-button:focus-visible, .item-action:focus-visible, .item-read:focus-visible, .item-open:focus-visible, .summary-item:focus-visible { outline: 2px solid var(--focus-ring); outline-offset: 2px; }
  .refresh-button:disabled, .item-action:disabled { cursor: wait; opacity: .6; }
  .action-summary { border: 1px solid var(--border-default); display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); margin: 1rem 0; }
  .summary-item { align-content: start; background: var(--background-secondary); border: 0; border-left: 1px solid var(--border-default); color: var(--text-primary); cursor: pointer; display: grid; gap: .25rem; min-height: 5.6rem; padding: .7rem .8rem; text-align: left; }
  .summary-item:first-child { border-left: 0; }
  .summary-item:hover, .summary-item:focus-visible { background: var(--background-inset); outline: 0; }
  .summary-item span { color: var(--text-secondary); font-size: .68rem; font-weight: 800; }
