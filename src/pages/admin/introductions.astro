---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { OPERATOR_INTRODUCTIONS } from "../../data/operator-introductions";

const introductions = OPERATOR_INTRODUCTIONS.map((entry) => {
  const roleIndex = entry.paragraphs.findIndex((paragraph) => paragraph.startsWith("役職・担当："));
  return {
    name: entry.name,
    affiliation: entry.paragraphs[0] ?? "",
    role: roleIndex >= 0 ? entry.paragraphs[roleIndex].replace(/^役職・担当：\s*/, "") : "",
    details: entry.paragraphs.filter((_, index) => index > 0 && index !== roleIndex),
  };
});
---

<AdminLayout title="運営内自己紹介" description="運営メンバーの自己紹介">
  <main class="introductions-page">
    <header class="page-heading">
      <h1>運営内自己紹介</h1>
      <span>運営メンバーの所属・担当・自己紹介を確認できます。</span>
    </header>
    <section class="introduction-list" aria-label="運営メンバー一覧">
      {introductions.map((person) => <article class="introduction-row">
        <div class="introduction-summary">
          <h2>{person.name}</h2>
          <p>{person.affiliation}</p>
          {person.role && <strong>{person.role}</strong>}
        </div>
        {person.details.length > 0 && <details open><summary>自己紹介</summary><div>{person.details.map((detail) => <p>{detail}</p>)}</div></details>}
      </article>)}
    </section>
  </main>
</AdminLayout>

<style is:global>
  .introductions-page{box-sizing:border-box;margin:0 auto;max-width:1200px;padding:0 1.25rem 4rem}
  .page-heading{border-bottom:1px solid var(--border-default);margin:0 auto;padding:2.6rem 0 1.5rem;text-align:center;width:min(100%,60rem)}
  .page-heading p{color:var(--accent-primary);font-size:.72rem;font-weight:800;letter-spacing:.08em;margin:0}.page-heading h1{font-size:clamp(1.8rem,4vw,2.4rem);margin:.35rem 0}.page-heading span{color:var(--text-secondary);font-size:.9rem}
  .introduction-list{margin:1.25rem auto 0;width:min(100%,60rem)}
  .introduction-row{border-bottom:1px solid var(--border-default);display:grid;gap:1.25rem;grid-template-columns:minmax(13rem,.7fr) minmax(0,1.5fr);padding:1rem .25rem}.introduction-row:first-child{border-top:1px solid var(--border-default)}
  .introduction-summary h2{font-size:1rem;margin:0 0 .25rem}.introduction-summary p,.introduction-summary strong{color:var(--text-secondary);display:block;font-size:.78rem;line-height:1.55;margin:0}.introduction-summary strong{color:var(--accent-primary);font-weight:800;margin-top:.2rem}
  .introduction-row details{min-width:0}.introduction-row summary{color:var(--accent-primary);cursor:pointer;font-size:.78rem;font-weight:800;list-style:none;margin-bottom:.35rem}.introduction-row summary::-webkit-details-marker{display:none}.introduction-row summary::before{content:"− ";font-size:1rem}.introduction-row details:not([open]) summary::before{content:"＋ "}.introduction-row details div{display:grid;gap:.35rem}.introduction-row details p{color:var(--text-secondary);font-size:.78rem;line-height:1.65;margin:0;overflow-wrap:anywhere;white-space:pre-wrap}
  @media(max-width:700px){.introductions-page{padding:0 .85rem 3rem}.page-heading{padding:2rem 0 1.2rem}.introduction-row{display:block;padding:.9rem .1rem}.introduction-row details{margin-top:.65rem}.introduction-row details[open] summary{border-bottom:1px solid var(--border-default);padding-bottom:.35rem}}
</style>
