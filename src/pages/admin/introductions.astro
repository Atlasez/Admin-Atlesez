---
import AdminLayout from "../../layouts/AdminLayout.astro";
import AdminRetryNotice from "../../components/admin/AdminRetryNotice.astro";

const requestedProject = Astro.url.searchParams.get("project") ?? "atlas";
const project = requestedProject === "secretariat" ? "secretariat" : requestedProject === "seminar-platform" ? "seminar-platform" : "atlas";
const projectLabel = project === "secretariat" ? "Atlasez運営事務局" : project === "seminar-platform" ? "ゼミプラットフォーム" : "学習サイト「アトラス」運営";
---

<AdminLayout title="運営内自己紹介" description={`${projectLabel}の運営メンバーの自己紹介`}>
  <main class="introductions-page" data-introductions-page data-project={project}>
    <header class="intro-hero">
      <div class="intro-hero-copy">
        <h1>運営内自己紹介</h1>
      </div>
      <a class="intro-primary-action" href={`/admin/workspace/?project=${project}`}>
        <span class="intro-primary-action-label">自分の自己紹介を変更する</span>
        <span class="intro-primary-action-note">プロフィール設定へ</span>
        <span class="intro-primary-action-arrow" aria-hidden="true">→</span>
      </a>
    </header>
    <section class="intro-directory-bar" aria-label="運営メンバーの検索">
      <label class="intro-search">
        <span>名前・所属・担当で検索</span>
        <input type="search" data-introduction-search placeholder="例：数学、東京大学" autocomplete="off" />
      </label>
      <output class="intro-member-count" data-member-count aria-live="polite">登録情報を確認中…</output>
    </section>
    <output class="intro-message" data-introductions-message aria-live="polite"></output>
    <section class="introduction-list" data-introduction-list aria-busy="true" aria-label="運営メンバー一覧">
      <p class="loading-state introduction-loading">最新のメンバー情報を読み込んでいます…</p>
    </section>
    <div class="introduction-pagination" data-introduction-pagination hidden>
      <span data-introduction-pagination-summary aria-live="polite"></span>
      <button type="button" data-introduction-load-more>さらに読み込む</button>
    </div>
    <AdminRetryNotice />
  </main>
</AdminLayout>

<style is:global>
  .introductions-page{background:#fff;box-sizing:border-box;color:#17324d;min-height:calc(100vh - 4.15rem);padding:0 max(1rem,calc((100vw - 1240px)/2)) 4.5rem}.intro-hero{align-items:center;border-bottom:1px solid #d7e2eb;display:flex;gap:2rem;justify-content:space-between;padding:2.4rem 0 1.8rem}.intro-hero h1{color:#123b5d;font-size:clamp(1.65rem,3vw,2.2rem);letter-spacing:.01em;margin:0}.intro-primary-action{align-items:center;background:#176ea6;border:1px solid #176ea6;border-radius:.35rem;box-shadow:0 .3rem .75rem rgb(23 110 166 / .2);color:#fff;display:grid;grid-template-columns:minmax(0,1fr) auto;min-width:15rem;padding:.85rem 1rem;text-decoration:none;transition:background .16s ease,box-shadow .16s ease,transform .16s ease}.intro-primary-action:hover{background:#0e5686;box-shadow:0 .45rem 1rem rgb(23 110 166 / .27);transform:translateY(-1px)}.intro-primary-action:focus-visible{outline:3px solid #8fc7e7;outline-offset:3px}.intro-primary-action-label{font-size:.88rem;font-weight:900}.intro-primary-action-note{color:#dbeef8;font-size:.67rem;grid-column:1;grid-row:2;margin-top:.22rem}.intro-primary-action-arrow{font-size:1.45rem;grid-column:2;grid-row:1 / span 2;margin-left:1rem}.intro-directory-bar{align-items:end;border-bottom:1px solid #d7e2eb;display:flex;gap:1rem;justify-content:flex-end;padding:1.35rem 0 1rem}.intro-search{display:grid;gap:.3rem;width:min(100%,23rem)}.intro-search span{color:#526b7d;font-size:.68rem;font-weight:800}.intro-search input{background:#fff;border:1px solid #b9cbd8;border-radius:.3rem;color:#17324d;font:inherit;font-size:.8rem;min-height:2.55rem;padding:.55rem .7rem;width:100%}.intro-search input::placeholder{color:#8193a0}.intro-search input:focus{border-color:#176ea6;box-shadow:0 0 0 3px rgb(23 110 166 / .14);outline:0}.intro-member-count{color:#526b7d;font-size:.72rem;font-variant-numeric:tabular-nums;font-weight:800;white-space:nowrap}.intro-message{color:#a24424;display:block;font-size:.74rem;min-height:1.25rem;padding-top:.7rem}.introduction-list{display:grid;gap:1rem;grid-template-columns:repeat(3,minmax(0,1fr));margin-top:.35rem}.introduction-row{min-height:19rem;perspective:1200px}.introduction-row[hidden]{display:none}.introduction-card-inner{height:100%;position:relative;transform-style:preserve-3d;transition:transform .38s cubic-bezier(.2,.7,.2,1)}.introduction-row.is-flipped .introduction-card-inner{transform:rotateY(180deg)}.introduction-face{backface-visibility:hidden;background:#fff;border:1px solid #cfdee8;border-radius:.5rem;box-shadow:0 .3rem 1rem rgb(22 58 87 / .1);box-sizing:border-box;display:flex;flex-direction:column;inset:0;justify-content:space-between;overflow:auto;padding:1.05rem;position:absolute;transform:rotateY(0deg)}.introduction-row:hover .introduction-front{border-color:#8dbbd6;box-shadow:0 .5rem 1.15rem rgb(22 87 126 / .15)}.introduction-row.is-flipped .introduction-back{border-color:#176ea6;box-shadow:0 .5rem 1.15rem rgb(22 87 126 / .18)}.introduction-back{transform:rotateY(180deg)}.person-card-top{align-items:center;display:flex;gap:.7rem}.person-card-top-back{border-bottom:1px solid #d7e2eb;margin-bottom:.85rem;padding-bottom:.75rem}.person-index{align-self:flex-start;color:#8aa0af;font-size:.68rem;font-variant-numeric:tabular-nums;font-weight:900;letter-spacing:.06em}.person-avatar{align-items:center;background:#e6f2f9;border:1px solid #9bc6dc;border-radius:50%;color:#176ea6;display:flex;flex:0 0 2.7rem;font-size:1.05rem;font-weight:900;height:2.7rem;justify-content:center;overflow:hidden;width:2.7rem}.person-avatar img{display:block;height:100%;object-fit:cover;width:100%}.person-card-name{min-width:0}.person-card-name h2{color:#173e60;font-size:1rem;line-height:1.35;margin:0;overflow-wrap:anywhere}.introduction-eyebrow{color:#176ea6!important;font-size:.63rem!important;font-weight:900;letter-spacing:.1em;margin:0 0 .22rem!important;text-transform:uppercase}.person-facts{border-top:1px solid #edf2f5;margin-top:1rem;padding-top:.8rem}.person-facts p{color:#526b7d;display:grid;font-size:.75rem;gap:.25rem;line-height:1.5;margin:0}.person-facts p span{color:#8496a3;font-size:.64rem;font-weight:900;letter-spacing:.06em}.assignment-list{display:flex;flex-wrap:wrap;gap:.35rem;margin-top:.7rem}.assignment-list:empty{display:none}.assignment-list strong{background:#eef6fb;border:1px solid #c3dcea;border-radius:.2rem;color:#155d87;display:inline-block;font-size:.68rem;line-height:1.35;padding:.28rem .42rem}.introduction-card-footer{align-items:center;border-top:1px solid #edf2f5;display:flex;gap:.6rem;justify-content:flex-end;margin-top:1rem;padding-top:.75rem}.introduction-card-toggle{align-items:center;background:#176ea6;border:1px solid #176ea6;border-radius:.3rem;color:#fff;cursor:pointer;display:inline-flex;font:inherit;font-size:.76rem;font-weight:900;gap:.7rem;justify-content:space-between;min-height:2.65rem;padding:.55rem .7rem}.introduction-card-toggle:hover{background:#0e5686;border-color:#0e5686}.introduction-card-toggle:focus-visible{outline:3px solid #8fc7e7;outline-offset:2px}.introduction-body{min-width:0}.introduction-body p:last-child{color:#29475d;font-size:.82rem;line-height:1.75;margin:0;overflow-wrap:anywhere;white-space:pre-wrap}.introduction-body a,.info-panel dd a{color:#176ea6;font-weight:800;text-decoration:underline;text-underline-offset:.16em}.introduction-body a:hover,.info-panel dd a:hover{color:#0e5686}.introduction-empty,.introduction-loading{border:1px dashed #a9c1cf;color:#526b7d;grid-column:1/-1;margin:0;padding:2rem;text-align:center}.introduction-empty[hidden]{display:none}.introduction-pagination{align-items:center;display:flex;gap:.7rem;justify-content:center;margin-top:1rem}.introduction-pagination[hidden]{display:none}.introduction-pagination span{color:#526b7d;font-size:.72rem;font-variant-numeric:tabular-nums}.introduction-pagination button{background:transparent;border:1px solid #b9cbd8;border-radius:.3rem;color:#17324d;cursor:pointer;font:inherit;font-size:.75rem;padding:.5rem .8rem}.introduction-pagination button:hover:not(:disabled){border-color:#176ea6;color:#176ea6}.introduction-pagination button:disabled{cursor:wait;opacity:.6}@media(max-width:1000px){.introduction-list{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:700px){.introductions-page{padding:0 .85rem 3rem}.intro-hero{align-items:stretch;display:grid;gap:1.2rem;padding:1.8rem 0 1.35rem}.intro-primary-action{min-width:0}.intro-directory-bar{align-items:stretch;display:grid;grid-template-columns:1fr;padding-top:1rem}.intro-member-count{justify-self:start}.introduction-list{grid-template-columns:1fr}.introduction-row{min-height:17rem}.introduction-pagination{align-items:stretch;flex-direction:column}.introduction-pagination button{width:100%}}@media(prefers-reduced-motion:reduce){.introduction-card-inner{transition:none}}
</style>

<style is:global>
  /* 自己紹介一覧も管理画面の共通ダークテーマに合わせる。 */
  [data-pref-bg="dark"] .introductions-page {
    background: var(--background-primary);
    color: var(--text-primary);
  }
  [data-pref-bg="dark"] .introductions-page .intro-hero,
  [data-pref-bg="dark"] .introductions-page .intro-directory-bar,
  [data-pref-bg="dark"] .introductions-page .person-card-top-back,
  [data-pref-bg="dark"] .introductions-page .person-facts,
  [data-pref-bg="dark"] .introductions-page .introduction-card-footer {
    border-color: var(--border-default);
  }
  [data-pref-bg="dark"] .introductions-page .intro-hero h1,
  [data-pref-bg="dark"] .introductions-page .person-card-name h2,
  [data-pref-bg="dark"] .introductions-page .introduction-body p:last-child {
    color: var(--text-primary);
  }
  [data-pref-bg="dark"] .introductions-page .intro-search span,
  [data-pref-bg="dark"] .introductions-page .intro-member-count,
  [data-pref-bg="dark"] .introductions-page .person-facts p,
  [data-pref-bg="dark"] .introductions-page .introduction-empty,
  [data-pref-bg="dark"] .introductions-page .introduction-loading {
    color: var(--text-secondary);
  }
  [data-pref-bg="dark"] .introductions-page .intro-search input,
  [data-pref-bg="dark"] .introductions-page .introduction-face {
    background: var(--background-secondary);
    border-color: var(--border-default);
    box-shadow: none;
    color: var(--text-primary);
  }
  [data-pref-bg="dark"] .introductions-page .intro-search input::placeholder {
    color: var(--text-muted);
  }
  [data-pref-bg="dark"] .introductions-page .person-avatar {
    background: var(--background-inset);
    border-color: var(--border-default);
    color: var(--accent-primary);
  }
  [data-pref-bg="dark"] .introductions-page .assignment-list strong {
    background: var(--background-inset);
    border-color: var(--border-default);
    color: var(--accent-primary);
  }
  [data-pref-bg="dark"] .introductions-page .introduction-row:hover .introduction-front,
  [data-pref-bg="dark"] .introductions-page .introduction-row.is-flipped .introduction-back {
    border-color: var(--accent-primary);
    box-shadow: none;
  }
  [data-pref-bg="dark"] .introductions-page .introduction-empty,
  [data-pref-bg="dark"] .introductions-page .introduction-loading {
    background: var(--background-secondary);
    border-color: var(--border-default);
  }
</style>

<script>
  import { renderSafeLinks } from "../../lib/safe-links";
  import { createAdminLoadRetry } from "../../scripts/admin-load-retry";

  type IntroductionEntry = { display_name?: string; university?: string; year?: string; internal_bio?: string; assignments?: string[]; avatar_url?: string };
  type Pagination = { nextCursor?: string | null; hasMore?: boolean };

  const initializeIntroductions = () => {
    const root = document.querySelector<HTMLElement>("[data-introductions-page]");
    if (!root || root.dataset.initialized === "true") return;
    root.dataset.initialized = "true";
    const project = root.dataset.project ?? "atlas";
    const list = root.querySelector<HTMLElement>("[data-introduction-list]")!;
    const message = root.querySelector<HTMLOutputElement>("[data-introductions-message]")!;
    const search = root.querySelector<HTMLInputElement>("[data-introduction-search]")!;
    const count = root.querySelector<HTMLOutputElement>("[data-member-count]")!;
    const pagination = root.querySelector<HTMLElement>("[data-introduction-pagination]")!;
    const paginationSummary = root.querySelector<HTMLElement>("[data-introduction-pagination-summary]")!;
    const loadMoreButton = root.querySelector<HTMLButtonElement>("[data-introduction-load-more]")!;
    const esc = (value: string) => value.replace(/[&<>"']/g, character => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", "\"": "&quot;", "'": "&#39;" }[character] ?? character));
    let entries: IntroductionEntry[] = [];
    let nextCursor: string | null = null;
    let loadingMore = false;

    const updateSearch = () => {
      const query = search.value.trim().toLocaleLowerCase();
      const cards = [...list.querySelectorAll<HTMLElement>("[data-introduction-card]")];
      let visible = 0;
      cards.forEach(card => {
        const matches = !query || (card.dataset.search ?? "").toLocaleLowerCase().includes(query);
        card.hidden = !matches;
        if (matches) visible += 1;
      });
      let empty = list.querySelector<HTMLElement>("[data-introduction-no-results]");
      if (!empty) { empty = document.createElement("p"); empty.className = "introduction-empty"; empty.dataset.introductionNoResults = ""; empty.textContent = "条件に一致するメンバーはいません。"; list.append(empty); }
      empty.hidden = cards.length === 0 || visible !== 0;
      count.value = cards.length ? `${visible} / ${cards.length}${nextCursor ? "+" : ""}人` : "0人";
      pagination.hidden = !nextCursor;
      paginationSummary.textContent = nextCursor ? `${entries.length}人を読み込み済み・続きがあります` : entries.length ? `${entries.length}人を表示中` : "";
      loadMoreButton.disabled = loadingMore;
      loadMoreButton.textContent = loadingMore ? "読み込み中…" : "さらに読み込む";
    };
    const retry = createAdminLoadRetry(root, () => { window.location.reload(); return new Promise(() => undefined); }, "自己紹介を読み込めませんでした。");

    const renderCard = (person: IntroductionEntry, index: number) => {
      const rawName = person.display_name?.trim() || "表示名未設定";
      const affiliation = esc([person.university, person.year].filter(Boolean).join(" / ") || "所属未登録");
      const assignments = (person.assignments ?? []).map(item => `<strong>${esc(item)}</strong>`).join("");
      const rawBio = person.internal_bio?.trim() || "自己紹介はまだ登録されていません。";
      const rawAvatar = person.avatar_url?.trim() || "";
      const name = esc(rawName);
      const searchText = esc(`${rawName} ${affiliation} ${(person.assignments ?? []).join(" ")} ${rawBio}`);
      const avatar = rawAvatar ? `<img src="${esc(rawAvatar)}" alt="" loading="lazy" decoding="async" />` : esc(rawName.charAt(0));
      const avatarClass = rawAvatar ? " has-image" : "";
      return `<article class="introduction-row" data-introduction-card data-search="${searchText}"><div class="introduction-card-inner"><section class="introduction-face introduction-front"><div><div class="person-card-top"><span class="person-index">${String(index + 1).padStart(2, "0")}</span><span class="person-avatar${avatarClass}" aria-hidden="true">${avatar}</span><div class="person-card-name"><h2>${name}</h2></div></div><div class="person-facts"><p><span>所属</span>${affiliation}</p><div class="assignment-list" aria-label="担当分野">${assignments}</div></div></div><div class="introduction-card-footer"><button class="introduction-card-toggle" type="button" data-card-toggle aria-pressed="false"><span>自己紹介を見る</span><span aria-hidden="true">→</span></button></div></section><section class="introduction-face introduction-back" aria-hidden="true"><div class="person-card-top person-card-top-back"><span class="person-avatar${avatarClass}" aria-hidden="true">${avatar}</span><div class="person-card-name"><h2>${name}</h2></div></div><div class="introduction-body"><p>${renderSafeLinks(rawBio)}</p></div><div class="introduction-card-footer"><button class="introduction-card-toggle" type="button" data-card-toggle aria-pressed="true"><span>基本情報に戻る</span><span aria-hidden="true">←</span></button></div></section></div></article>`;
    };
    const load = async (append = false) => {
      if (loadingMore || (append && !nextCursor)) return;
      loadingMore = append;
      if (!append) retry.begin();
      try {
        const params = new URLSearchParams({ project, limit: "100" });
        if (append && nextCursor) params.set("cursor", nextCursor);
        const response = await fetch(`/api/admin/project-introductions?${params.toString()}`, { credentials: "same-origin", cache: "no-store" });
        const data = await response.json() as { entries?: IntroductionEntry[]; pagination?: Pagination; error?: string };
        if (!response.ok) throw new Error(data.error ?? "自己紹介を読み込めませんでした。");
        const page = data.entries ?? [];
        entries = append ? [...entries, ...page] : page;
        nextCursor = data.pagination?.nextCursor ?? null;
        if (!append) list.innerHTML = "";
        list.insertAdjacentHTML("beforeend", page.map((person, index) => renderCard(person, entries.length - page.length + index)).join("") || (!append ? `<p class="introduction-empty">このプロジェクトのメンバーはまだ登録されていません。</p>` : ""));
        list.setAttribute("aria-busy", "false");
        message.value = append ? "追加のメンバーを読み込みました。" : "";
        retry.success();
        updateSearch();
      } catch (error) {
        list.setAttribute("aria-busy", "false");
        if (!append) list.innerHTML = `<p class="introduction-empty">最新のメンバー情報を読み込めませんでした。</p>`;
        message.value = error instanceof Error ? error.message : "読み込みに失敗しました。";
        if (!append) retry.fail(error);
      } finally { loadingMore = false; updateSearch(); }
    };

    search.addEventListener("input", updateSearch);
    loadMoreButton.addEventListener("click", () => { void load(true); });
    list.addEventListener("click", event => {
      const toggle = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-card-toggle]");
      const card = toggle?.closest<HTMLElement>(".introduction-row");
      if (!toggle || !card) return;
      const flipped = card.classList.toggle("is-flipped");
      card.querySelector<HTMLElement>(".introduction-front")?.setAttribute("aria-hidden", String(flipped));
      card.querySelector<HTMLElement>(".introduction-back")?.setAttribute("aria-hidden", String(!flipped));
      card.querySelectorAll<HTMLButtonElement>("[data-card-toggle]").forEach(button => button.setAttribute("aria-pressed", String(flipped)));
    });
    void load();
  };
  document.addEventListener("astro:page-load", initializeIntroductions);
  initializeIntroductions();
</script>
