---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { OPERATOR_INTRODUCTIONS } from "../../data/operator-introductions";

const requestedProject = Astro.url.searchParams.get("project") ?? "atlas";
const project = requestedProject === "secretariat" ? "secretariat" : requestedProject === "seminar-platform" ? "seminar-platform" : "atlas";
const projectLabel = project === "secretariat" ? "Atlasez運営事務局" : project === "seminar-platform" ? "ゼミプラットフォーム" : "学習サイト「アトラス」運営";
const legacyIntroductions = OPERATOR_INTRODUCTIONS.map((entry) => {
  const roleIndex = entry.paragraphs.findIndex((paragraph) => paragraph.startsWith("役職・担当："));
  return {
    name: entry.name,
    affiliation: entry.paragraphs[0] ?? "",
    assignments: roleIndex >= 0 ? [entry.paragraphs[roleIndex].replace(/^役職・担当：\s*/, "")] : [],
    internalBio: entry.paragraphs.filter((_, index) => index > 0 && index !== roleIndex).join("\n\n"),
  };
});
---

<AdminLayout title="運営内自己紹介" description={`${projectLabel}の運営メンバーの自己紹介`}>
  <main class="introductions-page" data-introductions-page data-project={project}>
    <header class="page-heading">
      <h1>運営内自己紹介</h1>
      <a href={`/admin/workspace/?project=${project}`}>自分の自己紹介を変更する</a>
    </header>
    <output data-introductions-message aria-live="polite"></output>
    <section class="introduction-list" data-introduction-list aria-label="運営メンバー一覧">
      {legacyIntroductions.map((person) => <article class="introduction-row">
        <div class="introduction-card-inner">
          <section class="introduction-face introduction-front">
            <div class="introduction-summary">
              <p class="introduction-eyebrow">運営メンバー</p>
              <h2>{person.name}</h2>
              <p>{person.affiliation}</p>
              {person.assignments.map((assignment) => <strong>{assignment}</strong>)}
            </div>
            <button class="introduction-card-toggle" type="button" data-card-toggle aria-pressed="false">自己紹介を見る</button>
          </section>
          <section class="introduction-face introduction-back" aria-hidden="true">
            <div class="introduction-body">
              <p class="introduction-eyebrow">自己紹介</p>
              <p>{person.internalBio || "自己紹介はまだ登録されていません。"}</p>
            </div>
            <button class="introduction-card-toggle" type="button" data-card-toggle aria-pressed="true">基本情報に戻る</button>
          </section>
        </div>
      </article>)}
    </section>
  </main>
</AdminLayout>

<style>
  .introductions-page{box-sizing:border-box;margin:0 auto;max-width:1200px;padding:0 1.25rem 4rem}.page-heading{align-items:end;border-bottom:1px solid var(--border-default);display:flex;gap:1rem;justify-content:space-between;margin:0 auto;padding:2rem 0 1.25rem;width:min(100%,60rem)}.page-heading h1{font-size:clamp(1.8rem,4vw,2.4rem);margin:0}.page-heading a{color:var(--accent-primary);font-size:.78rem;font-weight:800;text-decoration:none}.introductions-page>output{color:var(--text-secondary);display:block;font-size:.76rem;margin:.7rem auto 0;min-height:1.1em;width:min(100%,60rem)}.introduction-list{display:grid;gap:1rem;grid-template-columns:repeat(2,minmax(0,1fr));margin:1.25rem auto 0;width:min(100%,60rem)}.introduction-row{background:transparent;min-height:16rem;perspective:1100px}.introduction-card-inner{height:100%;position:relative;transform-style:preserve-3d;transition:transform .42s cubic-bezier(.2,.7,.2,1)}.introduction-row.is-flipped .introduction-card-inner{transform:rotateY(180deg)}.introduction-face{backface-visibility:hidden;background:var(--background-secondary);border:1px solid var(--border-default);border-radius:1rem;box-shadow:0 8px 22px color-mix(in srgb,var(--background-primary) 55%,transparent);box-sizing:border-box;display:flex;flex-direction:column;inset:0;justify-content:space-between;padding:1.25rem;position:absolute;transform:rotateY(0deg)}.introduction-back{transform:rotateY(180deg)}.introduction-summary h2{font-size:1.22rem;margin:0 0 .4rem}.introduction-summary p,.introduction-summary strong{color:var(--text-secondary);display:block;font-size:.84rem;line-height:1.55;margin:0}.introduction-summary strong{color:var(--accent-primary);font-weight:800;margin-top:.25rem}.introduction-eyebrow{color:var(--accent-primary)!important;font-size:.7rem!important;font-weight:900;letter-spacing:.08em;margin:0 0 .7rem!important;text-transform:uppercase}.introduction-body{min-width:0}.introduction-body p:last-child{color:var(--text-primary);font-size:.92rem;line-height:1.75;margin:0;overflow-wrap:anywhere;white-space:pre-wrap}.introduction-card-toggle{align-self:flex-start;background:transparent;border:1px solid var(--accent-primary);border-radius:.55rem;color:var(--accent-primary);cursor:pointer;font:inherit;font-size:.78rem;font-weight:800;padding:.55rem .75rem}.introduction-card-toggle:hover{background:color-mix(in srgb,var(--accent-primary) 13%,transparent)}.introduction-card-toggle:focus-visible{outline:3px solid color-mix(in srgb,var(--accent-primary) 45%,transparent);outline-offset:3px}.introduction-empty{color:var(--text-secondary);grid-column:1/-1;padding:2rem;text-align:center}@media(max-width:700px){.introductions-page{padding:0 .85rem 3rem}.page-heading{align-items:start;display:grid}.introduction-list{grid-template-columns:1fr}.introduction-row{min-height:15rem}}@media(prefers-reduced-motion:reduce){.introduction-card-inner{transition:none}}
</style>

<script>
  type IntroductionEntry={display_name?:string;university?:string;year?:string;internal_bio?:string;assignments?:string[]};
  const initializeIntroductions=()=>{const root=document.querySelector<HTMLElement>("[data-introductions-page]");if(!root||root.dataset.initialized==="true")return;root.dataset.initialized="true";const project=root.dataset.project??"atlas";const list=root.querySelector<HTMLElement>("[data-introduction-list]")!;const message=root.querySelector<HTMLOutputElement>("[data-introductions-message]")!;const esc=(value:string)=>value.replace(/[&<>"']/g,character=>({"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#39;"}[character]??character));
    list.addEventListener("click",(event)=>{const target=event.target as HTMLElement;const toggle=target.closest<HTMLButtonElement>("[data-card-toggle]");if(!toggle)return;const card=toggle.closest<HTMLElement>(".introduction-row");if(!card)return;const flipped=card.classList.toggle("is-flipped");card.querySelector<HTMLElement>(".introduction-front")?.setAttribute("aria-hidden",String(flipped));card.querySelector<HTMLElement>(".introduction-back")?.setAttribute("aria-hidden",String(!flipped));card.querySelectorAll<HTMLButtonElement>("[data-card-toggle]").forEach(button=>button.setAttribute("aria-pressed",String(flipped)));});
    void fetch(`/api/admin/project-introductions?project=${encodeURIComponent(project)}`,{credentials:"same-origin",cache:"no-store"}).then(async response=>{const data=await response.json() as {entries?:IntroductionEntry[];error?:string};if(!response.ok)throw new Error(data.error??"自己紹介を読み込めませんでした。");const entries=data.entries??[];list.innerHTML=entries.length?entries.map(person=>{const name=esc(person.display_name?.trim()||"表示名未設定");const affiliation=esc([person.university,person.year].filter(Boolean).join(" / ")||"所属未登録");const assignments=(person.assignments??[]).map(item=>`<strong>${esc(item)}</strong>`).join("");const bio=esc(person.internal_bio?.trim()||"自己紹介はまだ登録されていません。");return `<article class="introduction-row"><div class="introduction-card-inner"><section class="introduction-face introduction-front"><div class="introduction-summary"><p class="introduction-eyebrow">運営メンバー</p><h2>${name}</h2><p>${affiliation}</p>${assignments}</div><button class="introduction-card-toggle" type="button" data-card-toggle aria-pressed="false">自己紹介を見る</button></section><section class="introduction-face introduction-back" aria-hidden="true"><div class="introduction-body"><p class="introduction-eyebrow">自己紹介</p><p>${bio}</p></div><button class="introduction-card-toggle" type="button" data-card-toggle aria-pressed="true">基本情報に戻る</button></section></div></article>`}).join(""):"<p class=\"introduction-empty\">このプロジェクトのメンバーはまだ登録されていません。</p>";message.value=""}).catch(error=>{message.value=`最新情報を読み込めなかったため、登録済みの初期情報を表示しています。${error instanceof Error?` ${error.message}`:""}`});
  };document.addEventListener("astro:page-load",initializeIntroductions);initializeIntroductions();
</script>
