---
import AdminLayout from "../../layouts/AdminLayout.astro";
import AdminRetryNotice from "../../components/admin/AdminRetryNotice.astro";
---
<AdminLayout title="ポータル UIプロトタイプ" description="Atlasezの全プロジェクトへの入口">
  <main class="portal-xai" data-portal data-admin-load-surface aria-busy="true">
    <header>
      <div>
        <h1 data-admin-i18n data-admin-ja="Atlasezメンバー用サイト" data-admin-en="Atlasez member site">Atlasezメンバー用サイト</h1>
      </div>
      <a class="application-link" href="/apply/" data-admin-i18n data-admin-ja="応募フォームへ →" data-admin-en="Open application form →">応募フォームへ →</a>
    </header>

    <aside class="welcome-entry" aria-label="初参加の方へ">
      <div><strong>初参加の方へ</strong><p>プロフィール、相談先、最初の小タスクを確認しましょう。</p></div>
      <a href="/admin/getting-started/">参加後の案内 →</a>
      <a href="/admin/procedures/">休止・退会・再開の手続き →</a>
    </aside>

    <section class="my-intake" data-my-intake hidden aria-label="あなたの参加後フォロー">
      <h2>あなたの参加後フォロー</h2>
      <p data-my-intake-summary>読み込み中…</p>
      <div data-my-intake-entries></div>
      <button type="button" data-my-intake-retry hidden>参加後フォローを再読み込み</button>
    </section>

    <section class="portal-summary" aria-label="ポータルの概要" data-portal-summary>
      <a class="portal-summary-item portal-summary-item--action" href="/admin/action-center/">
        <span class="portal-summary-label">今日の要対応</span>
        <strong data-summary-value="today">—</strong>
        <small data-summary-detail="today">期限のあるタスクを確認</small>
      </a>
      <a class="portal-summary-item portal-summary-item--action" href="/admin/action-center/">
        <span class="portal-summary-label">期限が近いタスク</span>
        <strong data-summary-value="due-soon">—</strong>
        <small data-summary-detail="due-soon">7日以内の期限</small>
      </a>
      <button class="portal-summary-item portal-summary-item--action" type="button" data-summary-notifications>
        <span class="portal-summary-label">未読通知</span>
        <strong data-summary-value="unread">—</strong>
        <small data-summary-detail="unread">通知を確認</small>
      </button>
      <a class="portal-summary-item portal-summary-item--action" href="/admin/action-center/">
        <span class="portal-summary-label">承認待ち</span>
        <strong data-summary-value="approvals">—</strong>
        <small data-summary-detail="approvals">確認が必要な項目</small>
      </a>
      <a class="portal-summary-item" href="/admin/member-calendar/">
        <span class="portal-summary-label">次回予定</span>
        <strong data-summary-value="next">—</strong>
        <small data-summary-detail="next">予定を読み込み中…</small>
      </a>
    </section>

    <AdminRetryNotice message="ポータル情報を読み込めませんでした。" legacyPortal />

    <section class="project-entry" aria-labelledby="projects-entry-heading">
      <div class="project-entry-heading">
        <h2 id="projects-entry-heading" data-admin-i18n data-admin-ja="参加中のプロジェクト" data-admin-en="Your projects">参加中のプロジェクト</h2>
        <p data-admin-i18n data-admin-ja="あなたの権限に応じた参加中のプロジェクトです。" data-admin-en="Projects you are participating in, grouped by your role.">あなたの権限に応じた参加中のプロジェクトです。</p>
      </div>
      <div class="project-entry-groups">
        <section class="project-group" aria-labelledby="managed-projects-heading">
          <header class="project-group-heading"><h3 id="managed-projects-heading" data-admin-i18n data-admin-ja="運営として参加中" data-admin-en="As an operator">運営として参加中</h3><span data-project-count="managed">—</span></header>
          <div class="project-entry-cards" data-project-group="managed"><p class="project-empty" data-admin-i18n data-admin-ja="読み込み中…" data-admin-en="Loading…">読み込み中…</p></div>
        </section>
        <section class="project-group" aria-labelledby="member-projects-heading">
          <header class="project-group-heading"><h3 id="member-projects-heading" data-admin-i18n data-admin-ja="参加者として参加中" data-admin-en="As a participant">参加者として参加中</h3><span data-project-count="member">—</span></header>
          <div class="project-entry-cards" data-project-group="member"><p class="project-empty" data-admin-i18n data-admin-ja="読み込み中…" data-admin-en="Loading…">読み込み中…</p></div>
        </section>
      </div>
    </section>

    <div class="home-grid">
      <section class="home-section calendar-section">
        <div class="section-heading">
          <div><h2 data-admin-i18n data-admin-ja="同時作業会・交流会の日程" data-admin-en="Co-working & social events">同時作業会・交流会の日程</h2><small class="calendar-timezone-note" data-calendar-timezone-note></small></div>
          <a href="/admin/member-calendar/" data-admin-i18n data-admin-ja="→" data-admin-en="→" aria-label="横断カレンダーを開く">→</a>
        </div>
        <div class="calendar-toolbar" role="group" aria-label="今日のカレンダー"><div class="calendar-heading"><strong data-calendar-title>読み込み中…</strong><small data-calendar-range></small></div></div>
        <fieldset class="calendar-filters" aria-label="カレンダー表示対象"><legend data-admin-i18n data-admin-ja="表示する予定" data-admin-en="Show events">表示する予定</legend><label class="calendar-filter-option"><input type="checkbox" data-calendar-source="organization" checked /><span class="calendar-filter-mark" aria-hidden="true"></span><span class="calendar-filter-copy"><b data-admin-i18n data-admin-ja="同時作業会・交流会" data-admin-en="Co-working & socials">同時作業会・交流会</b><small data-admin-i18n data-admin-ja="全体の予定" data-admin-en="Organization">全体の予定</small></span></label><label class="calendar-filter-option"><input type="checkbox" data-calendar-source="personal" /><span class="calendar-filter-mark" aria-hidden="true"></span><span class="calendar-filter-copy"><b data-admin-i18n data-admin-ja="自分の期限" data-admin-en="My deadlines">自分の期限</b><small data-admin-i18n data-admin-ja="担当タスクの期限" data-admin-en="Assigned tasks">担当タスクの期限</small></span></label></fieldset>
        <div class="calendar-agenda" data-calendar-agenda aria-live="polite"></div>
      </section>
      <section class="home-section">
        <div class="section-heading">
          <div><h2 data-admin-i18n data-admin-ja="自分の未完了タスク" data-admin-en="My open tasks">自分の未完了タスク</h2><small class="todo-section-note" data-todo-summary>読み込み中…</small></div>
          <a href="/admin/member-tasks/" data-admin-i18n data-admin-ja="→" data-admin-en="→" aria-label="横断タスク管理を開く">→</a>
        </div>
        <div class="todo-list" data-todos aria-live="polite">読み込み中…</div>
      </section>
    </div>

    <section class="available-projects" data-available-projects aria-labelledby="available-projects-heading" hidden>
      <div class="section-heading">
        <div>
          <h2 id="available-projects-heading" data-admin-i18n data-admin-ja="未参加のプロジェクト" data-admin-en="Projects to join">未参加のプロジェクト</h2>
          <p data-admin-i18n data-admin-ja="参加したいプロジェクトを選んで応募できます。" data-admin-en="Choose a project to learn more and apply.">参加したいプロジェクトを選んで応募できます。</p>
        </div>
      </div>
      <div class="project-entry-cards" data-project-group="available"></div>
    </section>

    <footer class="portal-app-download" aria-label="macOSアプリ">
      <div>
        <strong data-admin-i18n data-admin-ja="Atlasez運営アプリ" data-admin-en="Atlasez Admin app">Atlasez運営アプリ</strong>
        <p data-admin-i18n data-admin-ja="テスト機能です。Mac用アプリをダウンロードできます。アプリ内から最新版へ更新できます。" data-admin-en="Test feature. Download the Mac app. You can update it from inside the app.">テスト機能です。Mac用アプリをダウンロードできます。アプリ内から最新版へ更新できます。</p>
      </div>
      <a href="https://github.com/Atlasez/Admin-Atlesez/releases/latest/download/Atlasez-Admin.dmg" rel="noreferrer">
        <span data-admin-i18n data-admin-ja="macOS版をダウンロード" data-admin-en="Download for macOS">macOS版をダウンロード</span>
        <span aria-hidden="true">↓</span>
      </a>
    </footer>
  </main>
</AdminLayout>

<style is:global>
  @font-face {
    font-family: "xVf";
    src: url("../../../prototypes/xai/src/assets/xvf-variable.woff2") format("woff2");
    font-style: normal;
    font-weight: 100 900;
    font-display: swap;
  }

  @font-face {
    font-family: "Geist Mono";
    src: url("../../../prototypes/xai/src/assets/geist-mono-variable.woff2") format("woff2");
    font-style: normal;
    font-weight: 100 900;
    font-display: swap;
  }

  body:has(.portal-xai) {
    background: #080808;
    color-scheme: dark;
    color: var(--text-primary);
    --text-primary: #f5f5f4;
    --text-secondary: #a0a09f;
    --text-muted: #777774;
    --background-primary: #080808;
    --background-secondary: #111111;
    --background-inset: #171717;
    --border-default: rgb(255 255 255 / 12%);
    --border-strong: rgb(255 255 255 / 22%);
    --accent-primary: #d6ff46;
    --accent-hover: #e4ff80;
    --accent-subtle: rgb(214 255 70 / 9%);
    --on-accent: #080808;
    --link: #d6ff46;
    --focus-ring: #d6ff46;
    --success: #d6ff46;
    --warning: #ffc15c;
    --danger: #ff8585;
    --surface: #080808;
    --surface-alt: #111111;
    --surface-inset: #171717;
    --border: rgb(255 255 255 / 12%);
    --text: #f5f5f4;
    --muted: #a0a09f;
    --accent: #d6ff46;
  }

  body:has(.portal-xai) .admin-layout-main {
    background: #080808;
  }

  body:has(.portal-xai) .admin-breadcrumbs[hidden] {
    display: none !important;
  }

  .portal-xai {
    --px-bg: #080808;
    --px-surface: #111111;
    --px-surface-raised: #171717;
    --px-line: rgb(255 255 255 / 12%);
    --px-line-strong: rgb(255 255 255 / 22%);
    --px-text: #f5f5f4;
    --px-muted: #a0a09f;
    --px-quiet: #777774;
    --px-accent: #d6ff46;
    background: var(--px-bg);
    color: var(--px-text);
    color-scheme: dark;
    font-family: "xVf", Inter, "Helvetica Neue", Arial, sans-serif;
    font-size: 14px;
    line-height: 1.55;
    margin: 0 auto;
    max-width: 1320px;
    min-height: calc(100vh - 4rem);
    padding: 1.2rem clamp(1rem, 4.7vw, 4.5rem) 4rem;
    -webkit-font-smoothing: antialiased;
  }

  .portal-xai *,
  .portal-xai *::before,
  .portal-xai *::after {
    box-sizing: border-box;
  }

  .portal-xai a {
    color: inherit;
    text-decoration: none;
  }

  .portal-xai button,
  .portal-xai input {
    font: inherit;
  }

  .portal-xai a:focus-visible,
  .portal-xai button:focus-visible,
  .portal-xai input:focus-visible {
    outline: 2px solid var(--px-accent);
    outline-offset: 3px;
  }

  .portal-xai > header {
    align-items: end;
    border-bottom: 1px solid var(--px-line);
    display: flex;
    gap: 1.5rem;
    justify-content: space-between;
    padding: 1.9rem 0 1.7rem;
  }

  .portal-xai > header > div::before {
    color: var(--px-quiet);
    content: "ATLASEZ / MEMBER SPACE";
    display: block;
    font-family: "Geist Mono", "SFMono-Regular", Consolas, monospace;
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    margin-bottom: 0.75rem;
  }

  .portal-xai h1 {
    color: var(--px-text);
    font-size: clamp(2rem, 4.5vw, 3.55rem);
    font-family: "xVf", Inter, "Helvetica Neue", Arial, sans-serif;
    font-weight: 450;
    letter-spacing: -0.055em;
    line-height: 1.06;
    margin: 0;
  }

  .portal-xai .application-link {
    align-items: center;
    align-self: end;
    background: #f1f1ee;
    border: 1px solid #f1f1ee;
    border-radius: 999px;
    color: #111;
    display: inline-flex;
    flex: 0 0 auto;
    font-size: 0.78rem;
    font-weight: 700;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0.65rem 1.1rem;
    transition: background 0.18s ease, transform 0.18s ease;
  }

  .portal-xai .application-link:hover {
    background: var(--px-accent);
    border-color: var(--px-accent);
    transform: translateY(-1px);
  }

  .portal-xai > header span,
  .portal-xai small {
    color: var(--px-muted);
    line-height: 1.5;
  }

  .portal-xai .welcome-entry {
    align-items: center;
    background: var(--px-surface);
    border: 1px solid var(--px-line);
    border-radius: 13px;
    display: grid;
    gap: 0.8rem 1.25rem;
    grid-template-columns: minmax(0, 1.5fr) repeat(2, minmax(10rem, 1fr));
    margin: 1rem 0 1.15rem;
    padding: 1rem 1.15rem;
  }

  .portal-xai .welcome-entry strong {
    color: var(--px-text);
    font-size: 0.86rem;
    font-weight: 650;
  }

  .portal-xai .welcome-entry p {
    color: var(--px-muted);
    font-size: 0.76rem;
    line-height: 1.5;
    margin: 0.22rem 0 0;
  }

  .portal-xai .welcome-entry a {
    align-items: center;
    border-left: 1px solid var(--px-line);
    color: var(--px-text);
    display: flex;
    font-size: 0.76rem;
    font-weight: 600;
    gap: 0.45rem;
    justify-content: space-between;
    min-height: 2.5rem;
    padding: 0.25rem 0 0.25rem 1rem;
    transition: color 0.18s ease;
  }

  .portal-xai .welcome-entry a::after {
    color: var(--px-accent);
    content: "↗";
    font-size: 0.9rem;
  }

  .portal-xai .welcome-entry a:hover,
  .portal-xai .section-heading a:hover {
    color: var(--px-accent);
  }

  .portal-xai .my-intake {
    background: var(--px-surface);
    border: 1px solid var(--px-line);
    border-left: 2px solid var(--px-accent);
    border-radius: 12px;
    margin: 0 0 1.15rem;
    padding: 0.9rem 1rem;
  }

  .portal-xai .my-intake h2 {
    font-size: 0.92rem;
    margin: 0 0 0.35rem;
  }

  .portal-xai .my-intake p,
  .portal-xai .my-intake li {
    color: var(--px-muted);
    font-size: 0.76rem;
    line-height: 1.55;
  }

  .portal-xai .my-intake p { margin: 0.2rem 0; }
  .portal-xai .my-intake ul { margin: 0.3rem 0 0; padding-left: 1.2rem; }
  .portal-xai .my-intake a { color: var(--px-accent); font-weight: 650; }

  .portal-xai .portal-summary {
    align-items: stretch;
    background: var(--px-surface);
    border: 1px solid var(--px-line);
    border-radius: 13px;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    margin: 0 0 1.4rem;
    overflow: hidden;
  }

  .portal-xai .portal-summary-item {
    background: transparent;
    border: 0;
    border-left: 1px solid var(--px-line);
    color: var(--px-text);
    display: grid;
    gap: 0.32rem;
    min-width: 0;
    padding: 0.9rem 1rem;
    text-align: left;
    text-decoration: none;
    transition: background 0.16s ease;
  }

  .portal-xai .portal-summary-item:first-child { border-left: 0; }
  .portal-xai .portal-summary-item--action { cursor: pointer; }
  .portal-xai .portal-summary-item--action:hover,
  .portal-xai .portal-summary-item--action:focus-visible { background: var(--px-surface-raised); }

  .portal-xai .portal-summary-label {
    color: var(--px-muted);
    font-family: "Geist Mono", "SFMono-Regular", Consolas, monospace;
    font-size: 0.62rem;
    letter-spacing: 0.035em;
    line-height: 1.45;
  }

  .portal-xai .portal-summary-item strong {
    color: var(--px-text);
    font-size: 1.45rem;
    font-variant-numeric: tabular-nums;
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 1.05;
  }

  .portal-xai .portal-summary-item[data-summary-state="attention"] strong { color: var(--px-accent); }
  .portal-xai .portal-summary-item[data-summary-state="success"] strong { color: var(--px-accent); }

  .portal-xai .portal-summary-item small {
    font-size: 0.65rem;
    min-height: 1.3em;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .portal-xai .project-entry {
    display: grid;
    gap: 1rem;
    margin: 0 0 1.35rem;
    min-width: 0;
  }

  .portal-xai .project-entry-heading {
    align-items: end;
    border-bottom: 1px solid var(--px-line);
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    padding: 0 0 0.75rem;
  }

  .portal-xai .project-entry h2,
  .portal-xai .section-heading h2 {
    color: var(--px-text);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .portal-xai .project-entry-heading p {
    color: var(--px-muted);
    font-size: 0.72rem;
    line-height: 1.45;
    margin: 0.25rem 0 0;
  }

  .portal-xai .project-entry-groups {
    align-items: start;
    display: grid;
    gap: 1.2rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .portal-xai .project-group { min-width: 0; }

  .portal-xai .project-group-heading {
    align-items: center;
    border-bottom: 1px solid var(--px-line);
    display: flex;
    gap: 0.7rem;
    justify-content: space-between;
    margin-bottom: 0.7rem;
    padding-bottom: 0.55rem;
  }

  .portal-xai .project-group-heading h3 {
    color: var(--px-muted);
    font-family: "Geist Mono", "SFMono-Regular", Consolas, monospace;
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.045em;
    line-height: 1.4;
    margin: 0;
  }

  .portal-xai .project-group-heading span {
    border: 1px solid var(--px-line);
    border-radius: 999px;
    color: var(--px-muted);
    font-family: "Geist Mono", "SFMono-Regular", Consolas, monospace;
    font-size: 0.62rem;
    padding: 0.15rem 0.45rem;
  }

  .portal-xai .project-entry-cards {
    display: grid;
    gap: 0.55rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    min-width: 0;
  }

  .portal-xai .project-entry-card {
    align-content: start;
    background: var(--px-surface);
    border: 1px solid var(--px-line);
    border-radius: 11px;
    color: var(--px-text);
    display: grid;
    gap: 0.35rem;
    grid-template-rows: auto 1fr auto;
    min-height: 7.2rem;
    min-width: 0;
    overflow-wrap: anywhere;
    padding: 0.85rem 0.9rem;
    transition: background 0.16s ease, border-color 0.16s ease, transform 0.16s ease;
  }

  .portal-xai .project-entry-card:hover,
  .portal-xai .project-entry-card:focus-visible {
    background: var(--px-surface-raised);
    border-color: var(--px-line-strong);
    transform: translateY(-1px);
  }

  .portal-xai .project-entry-card strong { font-size: 0.84rem; line-height: 1.45; }
  .portal-xai .project-entry-card small { font-size: 0.7rem; line-height: 1.45; }
  .portal-xai .project-entry-card span { align-self: end; color: var(--px-accent); font-size: 0.74rem; font-weight: 700; margin-top: 0.2rem; }
  .portal-xai .project-entry-card.is-available { border-style: dashed; }
  .portal-xai .project-empty { color: var(--px-muted); font-size: 0.74rem; margin: 0.35rem 0; }

  .portal-xai .home-grid {
    align-items: start;
    display: grid;
    gap: 0.8rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .portal-xai .home-section {
    background: var(--px-surface);
    border: 1px solid var(--px-line);
    border-radius: 13px;
    min-width: 0;
    overflow: hidden;
    padding: 0.95rem;
  }

  .portal-xai .section-heading {
    align-items: start;
    border-bottom: 1px solid var(--px-line);
    display: flex;
    gap: 0.75rem;
    justify-content: space-between;
    margin-bottom: 0.75rem;
    padding-bottom: 0.65rem;
  }

  .portal-xai .section-heading p { color: var(--px-muted); font-size: 0.73rem; margin: 0.3rem 0 0; }
  .portal-xai .section-heading a { color: var(--px-muted); font-size: 0.8rem; font-weight: 700; padding: 0.1rem 0.3rem; transition: color 0.16s ease; }
  .portal-xai .section-heading small { display: block; font-size: 0.65rem; margin-top: 0.18rem; }
  .portal-xai .calendar-section { min-width: 0; }

  .portal-xai .calendar-toolbar {
    align-items: center;
    background: var(--px-bg);
    border: 1px solid var(--px-line);
    border-radius: 9px;
    display: flex;
    justify-content: space-between;
    margin: 0 0 0.65rem;
    padding: 0.7rem 0.8rem;
  }

  .portal-xai .calendar-heading { display: grid; gap: 0.12rem; }
