<script>
  import { createAdminLoadRetry } from '../../scripts/admin-load-retry';
  import { taskDeadlineEpoch } from '../../lib/admin-deadline-summary';
  import { formatTaskDeadline } from '../../lib/task-deadline';
  type PortalProject = { id: string; slug?: string; name: string; description?: string | null; role?: string };
  type PortalTodo = { id?: string; project_id: string; project_name?: string; subject?: string | null; task_kind?: string; title: string; details?: string | null; status: string; due_at?: string | null; due_timezone?: string | null };
  type PortalCalendarEvent = { id: string; kind: 'organization' | 'personal'; title: string; details?: string | null; startsAt: string; endsAt?: string | null; timezone: string; projectName: string };
  type PortalNotification = { kind?: string; read?: boolean };
  type PortalData = { projects?: PortalProject[]; availableProjects?: PortalProject[]; todos?: PortalTodo[]; taskSummary?: { openCount?: number; dueToday?: number; dueSoon?: number }; calendar?: { rangeStart?: string; rangeEnd?: string; events?: PortalCalendarEvent[] }; notifications?: PortalNotification[]; notificationsTruncated?: boolean; notificationsUnavailable?: boolean; unreadNotificationsCount?: number; pendingApprovals?: number; error?: string };
  const initializePortal = () => {
    const root = document.querySelector<HTMLElement>('[data-portal]');
    if (!root || root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';
    const calendarAgenda = root.querySelector<HTMLElement>('[data-calendar-agenda]')!;
    const calendarTitle = root.querySelector<HTMLElement>('[data-calendar-title]')!;
    const calendarRange = root.querySelector<HTMLElement>('[data-calendar-range]')!;
    const timezoneNote = root.querySelector<HTMLElement>('[data-calendar-timezone-note]')!;
    const todosView = root.querySelector<HTMLElement>('[data-todos]')!;
    const todoSummary = root.querySelector<HTMLElement>('[data-todo-summary]')!;
    const myIntakeSection = root.querySelector<HTMLElement>('[data-my-intake]')!;
    const myIntakeSummary = root.querySelector<HTMLElement>('[data-my-intake-summary]')!;
    const myIntakeEntries = root.querySelector<HTMLElement>('[data-my-intake-entries]')!;
    const myIntakeRetry = root.querySelector<HTMLButtonElement>('[data-my-intake-retry]')!;
    const summary = root.querySelector<HTMLElement>('[data-portal-summary]')!;
    const portalError = root.querySelector<HTMLElement>('[data-portal-error]')!;
    const portalErrorMessage = root.querySelector<HTMLElement>('[data-portal-error-message]')!;
    const portalRetry = root.querySelector<HTMLButtonElement>('[data-portal-retry]')!;
    const managedProjectsView = root.querySelector<HTMLElement>('[data-project-group="managed"]')!;
    const memberProjectsView = root.querySelector<HTMLElement>('[data-project-group="member"]')!;
    const availableProjectsView = root.querySelector<HTMLElement>('[data-project-group="available"]')!;
    const availableProjectsSection = root.querySelector<HTMLElement>('[data-available-projects]')!;
    const managedProjectCount = root.querySelector<HTMLElement>('[data-project-count="managed"]')!;
    const memberProjectCount = root.querySelector<HTMLElement>('[data-project-count="member"]')!;
    const sourceInputs = [...root.querySelectorAll<HTMLInputElement>('[data-calendar-source]')];
    const lifecycle = new AbortController();
    let retry: ReturnType<typeof createAdminLoadRetry> | null = null;
    document.addEventListener('astro:before-swap', () => lifecycle.abort(), { once: true, signal: lifecycle.signal });
    const escapeHtml = (value: string) => value.replace(/[&<>"']/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[character] ?? character);
    type MyIntakeEntry = { project_name:string; contact_status:string; responsible_name?:string; consultation_name?:string; first_task_id?:string|null; first_task_title?:string; first_task_type?:string; first_task_status?:string|null; follow_up_at?:string|null; follow_up_completed_at?:string|null };
    const renderMyIntake = (entries: MyIntakeEntry[]) => {
      myIntakeRetry.hidden = true;
      myIntakeSection.hidden = entries.length === 0;
      if (!entries.length) return;
      myIntakeSummary.textContent = '運営と共有している連絡・初回タスク・次回フォローの記録です。';
      myIntakeEntries.innerHTML = entries.map((entry) => {
        const task = entry.first_task_title ? `<li>${entry.first_task_type === 'operator' ? '参加前の運営準備' : '初回の小さなタスク'}：${escapeHtml(entry.first_task_title)}${entry.first_task_id && entry.first_task_type !== 'operator' ? ` <a href="/admin/task-detail/?task=${encodeURIComponent(entry.first_task_id)}">タスクを開く →</a>` : ''}</li>` : '';
        const followup = entry.follow_up_completed_at ? `次回フォロー：完了（${escapeHtml(formatDate(entry.follow_up_completed_at))}）` : entry.follow_up_at ? `次回フォロー：${escapeHtml(formatDate(entry.follow_up_at))}` : '次回フォロー：未設定';
        const contact = entry.contact_status === 'replied' ? '返信あり' : entry.contact_status === 'contacted' ? '連絡済み' : '連絡前';
        return `<article><strong>${escapeHtml(entry.project_name)}</strong><ul><li>連絡状況：${contact}</li><li>担当運営者：${escapeHtml(entry.responsible_name || '未設定')}</li><li>相談先：${escapeHtml(entry.consultation_name || '未設定')}</li><li>${followup}</li>${task}</ul></article>`;
      }).join('');
    };
    type PortalLanguage = 'ja' | 'en';
    const getLanguage = (): PortalLanguage => {
      try {
        const preferences = JSON.parse(localStorage.getItem('atlasez-prefs') ?? '{}') as { lang?: string };
        if (preferences.lang === 'eng' || preferences.lang === 'en') return 'en';
      } catch { /* fall back to the legacy language key */ }
      return localStorage.getItem('atlasez-admin-language') === 'en' ? 'en' : 'ja';
    };
    const copy = {
      ja: { noTodos: '未完了のタスクはありません。', open: '未着手', doing: '進行中', done: '完了', feedback: 'フィードバック依頼', task: 'タスク依頼', openCount: (count: number) => `${count}件を確認`, today: '今日の予定', noTodayEvents: '今日の予定はありません。', personal: '自分の期限', organization: '同時作業会・交流会', timezone: '表示タイムゾーン' },
      en: { noTodos: 'There are no open tasks.', open: 'Open', doing: 'In progress', done: 'Done', feedback: 'Feedback request', task: 'Task request', openCount: (count: number) => `${count} to review`, today: "Today's schedule", noTodayEvents: 'There are no events today.', personal: 'My deadline', organization: 'Co-working & social event', timezone: 'Time zone' },
    } as const;
    let portalData: PortalData | null = null;
    const timezone = () => Intl.DateTimeFormat().resolvedOptions().timeZone || 'Asia/Tokyo';
    const dateParts = (value: Date | string, options: Intl.DateTimeFormatOptions = {}) => {
      try {
        const parts = new Intl.DateTimeFormat('en-US', { timeZone: timezone(), year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', hourCycle: 'h23', ...options }).formatToParts(new Date(value));
        return Object.fromEntries(parts.filter((part) => part.type !== 'literal').map((part) => [part.type, part.value]));
      } catch { return {}; }
    };
    const dateKey = (value: string) => { const parts = dateParts(value); return `${parts.year ?? ''}-${parts.month ?? ''}-${parts.day ?? ''}`; };
    const formatDate = (value: string) => new Intl.DateTimeFormat(getLanguage() === 'ja' ? 'ja-JP' : 'en-US', { dateStyle: 'medium', timeStyle: 'short', timeZone: timezone() }).format(new Date(value));
    const eventDateKeys = (event: PortalCalendarEvent) => {
      const start = new Date(event.startsAt);
      const end = new Date(event.endsAt || event.startsAt);
      if (Number.isNaN(start.getTime()) || Number.isNaN(end.getTime())) return [dateKey(event.startsAt)];
      const startKey = dateKey(start.toISOString());
      const endKey = dateKey(end.toISOString());
      const [startYear, startMonth, startDay] = startKey.split('-').map(Number);
      const [endYear, endMonth, endDay] = endKey.split('-').map(Number);
      const cursor = new Date(Date.UTC(startYear, startMonth - 1, startDay));
      const finish = new Date(Date.UTC(endYear, endMonth - 1, endDay));
      const keys: string[] = [];
      for (let index = 0; cursor <= finish && index < 62; index += 1) {
        keys.push(cursor.toISOString().slice(0, 10));
        cursor.setUTCDate(cursor.getUTCDate() + 1);
      }
      return keys;
    };
    const enabledKinds = () => new Set(sourceInputs.filter((input) => input.checked).map((input) => input.dataset.calendarSource));
    const visibleEvents = () => (portalData?.calendar?.events ?? []).filter((event) => enabledKinds().has(event.kind));
    const eventSort = (left: PortalCalendarEvent, right: PortalCalendarEvent) => new Date(left.startsAt).getTime() - new Date(right.startsAt).getTime();
    const eventCard = (event: PortalCalendarEvent, language: PortalLanguage) => {
      const parts = dateParts(event.startsAt);
      const time = parts.hour && parts.minute ? `${parts.hour}:${parts.minute}` : '—';
      const kind = event.kind === 'personal' ? copy[language].personal : copy[language].organization;
      const href = event.kind === 'organization' ? '/admin/member-calendar/' : '/admin/member-tasks/';
      return `<a class="calendar-agenda-item${event.kind === 'personal' ? ' is-personal' : ''}" href="${href}"><span class="calendar-agenda-time">${escapeHtml(time)}</span><span class="calendar-agenda-copy"><span class="calendar-agenda-top"><b>${escapeHtml(event.title)}</b><em>${escapeHtml(kind)}</em></span><small>${escapeHtml(event.projectName)} ・ ${escapeHtml(formatDate(event.startsAt))}</small></span><span class="calendar-agenda-arrow" aria-hidden="true">→</span></a>`;
    };
    const renderAgenda = (events: PortalCalendarEvent[], language: PortalLanguage) => {
      const today = dateKey(new Date().toISOString());
      const todayEvents = events.filter((event) => eventDateKeys(event).includes(today)).sort(eventSort);
      calendarTitle.textContent = new Intl.DateTimeFormat(language === 'ja' ? 'ja-JP' : 'en-US', { dateStyle: 'full', timeZone: timezone() }).format(new Date());
      calendarRange.textContent = `${todayEvents.length}${language === 'ja' ? '件' : ' events'}`;
      calendarAgenda.innerHTML = `<section class="calendar-agenda-section"><div class="calendar-agenda-heading"><h3>${copy[language].today}</h3><span>${todayEvents.length}${language === 'ja' ? '件' : ' events'}</span></div><div class="calendar-agenda-list">${todayEvents.length ? todayEvents.map((event) => eventCard(event, language)).join('') : `<p class="calendar-agenda-empty">${copy[language].noTodayEvents}</p>`}</div></section>`;
      calendarAgenda.hidden = false;
    };
    const renderCalendar = () => {
      const language = getLanguage();
      const events = visibleEvents();
      timezoneNote.textContent = `${copy[language].timezone}: ${timezone()}`;
      renderAgenda(events, language);
    };
    const projectHref = (project: PortalProject) => {
      const slug = project.slug ?? project.id;
      if (slug === 'atlas') return '/admin/atlas/';
      if (slug === 'secretariat') return '/admin/secretariat/';
      if (slug === 'seminar-platform' || slug === 'semi-platform') return '/admin/semi-platform/';
      if (slug === 'student-council-exchange') return '/admin/student-council/';
      if (slug === 'thinking-cafe') return '/admin/thinking-cafe/';
      return `/admin/workspace/?project=${encodeURIComponent(project.id)}`;
    };
    const projectCard = (project: PortalProject, available = false) => {
      const href = available ? `/apply/?project=${encodeURIComponent(project.slug ?? project.id)}` : projectHref(project);
      const action = available ? (getLanguage() === 'ja' ? '参加を申し込む →' : 'Apply to join →') : '→';
      return `<a class="project-entry-card${available ? ' is-available' : ''}" href="${href}"><strong>${escapeHtml(project.name)}</strong>${project.description ? `<small>${escapeHtml(project.description)}</small>` : ''}<span>${escapeHtml(action)}</span></a>`;
    };
    const renderProjectGroup = (container: HTMLElement, count: HTMLElement, projects: PortalProject[], language: PortalLanguage) => {
      count.textContent = `${projects.length}${language === 'ja' ? '件' : projects.length === 1 ? ' project' : ' projects'}`;
      container.classList.remove('loading-state');
      container.innerHTML = projects.length ? projects.map((project) => projectCard(project)).join('') : `<p class="project-empty">${language === 'ja' ? '該当するプロジェクトはありません。' : 'No projects in this group.'}</p>`;
    };
    const renderProjects = (data: PortalData) => {
      const language = getLanguage();
      const projects = data.projects ?? [];
      renderProjectGroup(managedProjectsView, managedProjectCount, projects.filter((project) => project.role === 'manager'), language);
      renderProjectGroup(memberProjectsView, memberProjectCount, projects.filter((project) => project.role !== 'manager'), language);
      const available = data.availableProjects ?? [];
      availableProjectsSection.hidden = available.length === 0;
      availableProjectsView.innerHTML = available.map((project) => projectCard(project, true)).join('');
    };
    const renderTodos = (data: PortalData) => {
      const language = getLanguage();
      const todos = data.todos ?? [];
      todosView.classList.remove('loading-state');
      const openCount = Number(data.taskSummary?.openCount);
      todoSummary.textContent = copy[language].openCount(Number.isFinite(openCount) ? Math.max(0, Math.trunc(openCount)) : todos.length);
      if (!todos.length) {
        todosView.innerHTML = `<div class="todo-empty"><p>${copy[language].noTodos}</p></div>`;
        return;
      }
      const statusLabel = (status: string) => status === 'done' ? copy[language].done : status === 'doing' ? copy[language].doing : copy[language].open;
      todosView.innerHTML = todos.map((todo) => {
        const kind = todo.task_kind === 'feedback' ? copy[language].feedback : copy[language].task;
        const status = todo.status === 'done' ? 'done' : todo.status === 'doing' ? 'doing' : 'open';
        const context = [todo.project_name ?? todo.project_id, todo.subject].filter(Boolean).join(' / ');
        const icon = todo.task_kind === 'feedback' ? '↗' : '✓';
        const due = todo.due_at ? formatTaskDeadline(todo.due_at, todo.due_timezone || 'Asia/Tokyo') : '';
        const href = todo.id ? `/admin/task-detail/?task=${encodeURIComponent(todo.id)}` : '/admin/member-tasks/';
        return `<a class="todo todo-card status-${status}" href="${escapeHtml(href)}" aria-label="${escapeHtml(todo.title)}をタスク管理で開く"><span class="todo-icon" aria-hidden="true">${icon}</span><span class="todo-card-body"><span class="todo-card-top"><span class="todo-kind">${escapeHtml(kind)}</span><span class="todo-status">${escapeHtml(statusLabel(todo.status))}</span></span><strong>${escapeHtml(todo.title)}</strong>${context ? `<span class="todo-context">${escapeHtml(context)}</span>` : ''}${todo.details ? `<span class="todo-details">${escapeHtml(todo.details)}</span>` : ''}${due ? `<span class="todo-deadline">${language === 'ja' ? '期限' : 'Due'}: ${escapeHtml(due)}</span>` : ''}</span><span class="todo-arrow" aria-hidden="true">→</span></a>`;
      }).join('');
    };
    const setSummary = (key: string, value: string | number, detail: string, state?: 'attention' | 'success') => {
      const item = summary.querySelector<HTMLElement>(`[data-summary-value="${key}"]`)?.closest<HTMLElement>('.portal-summary-item');
      const valueView = summary.querySelector<HTMLElement>(`[data-summary-value="${key}"]`);
      const detailView = summary.querySelector<HTMLElement>(`[data-summary-detail="${key}"]`);
      if (valueView) valueView.textContent = String(value);
      if (detailView) detailView.textContent = detail;
      if (item) {
        if (state) item.dataset.summaryState = state;
        else delete item.dataset.summaryState;
      }
    };
    const renderSummary = (data: PortalData) => {
      const now = Date.now();
      const todayEnd = new Date();
      todayEnd.setHours(23, 59, 59, 999);
      const dueDates = (data.todos ?? []).map((todo) => ({ todo, time: todo.due_at ? taskDeadlineEpoch(todo.due_at, todo.due_timezone || 'Asia/Tokyo') : NaN })).filter((item) => Number.isFinite(item.time));
      const serverDueToday = Number(data.taskSummary?.dueToday);
      const serverDueSoon = Number(data.taskSummary?.dueSoon);
      const dueToday = Number.isFinite(serverDueToday) ? Math.max(0, Math.trunc(serverDueToday)) : dueDates.filter((item) => item.time <= todayEnd.getTime() && item.todo.status !== 'done').length;
      const dueSoon = Number.isFinite(serverDueSoon) ? Math.max(0, Math.trunc(serverDueSoon)) : dueDates.filter((item) => item.time > todayEnd.getTime() && item.time <= now + 7 * 24 * 60 * 60 * 1000 && item.todo.status !== 'done').length;
      setSummary('today', dueToday, dueToday ? `${dueToday}件の期限を確認` : '期限のあるタスクはありません', dueToday ? 'attention' : 'success');
      setSummary('due-soon', dueSoon, dueSoon ? '7日以内に期限' : '7日以内の期限はありません', dueSoon ? 'attention' : 'success');
      const notifications = data.notifications ?? [];
      const serverUnread = Number(data.unreadNotificationsCount);
      const hasServerUnread = Number.isFinite(serverUnread);
      const unread = hasServerUnread ? Math.max(0, Math.trunc(serverUnread)) : notifications.filter((item) => !item.read).length;
      const notificationsUnavailable = data.notificationsUnavailable === true;
      const notificationsTruncated = data.notificationsTruncated === true;
      // 承認待ちは通知の残存数ではなく、承認ページと同じ pending 状態の申請数を使う。
      // 通知は既読・処理済みになっても履歴として残るため、ここで数えると実態とずれる。
      const approvalCount = Number(data.pendingApprovals ?? 0);
      const approvals = Number.isFinite(approvalCount) ? Math.max(0, Math.trunc(approvalCount)) : 0;
      if (notificationsUnavailable) {
        setSummary('unread', '—', '通知を取得できません', 'attention');
      } else if (hasServerUnread) {
        setSummary('unread', unread, unread ? '通知を確認' : '未読はありません', unread ? 'attention' : 'success');
      } else if (notificationsTruncated) {
        setSummary('unread', unread ? `${unread}+` : '0', unread ? '最新20件中の未読（続きあり）' : '最新20件を確認', unread ? 'attention' : undefined);
      } else {
        setSummary('unread', unread, unread ? '通知を確認' : '未読はありません', unread ? 'attention' : 'success');
      }
      setSummary('approvals', approvals, approvals ? '確認が必要な項目' : '承認待ちはありません', approvals ? 'attention' : 'success');
      const next = (data.calendar?.events ?? []).filter((event) => Number.isFinite(Date.parse(event.startsAt)) && Date.parse(event.startsAt) >= now).sort((left, right) => Date.parse(left.startsAt) - Date.parse(right.startsAt))[0];
      if (next) {
        const parts = dateParts(next.startsAt);
        setSummary('next', parts.hour && parts.minute ? `${parts.hour}:${parts.minute}` : '予定', next.title);
      } else {
        setSummary('next', '—', '予定はありません');
      }
    };
    const renderPortal = (data: PortalData) => { renderProjects(data); renderCalendar(); renderTodos(data); renderSummary(data); };
    sourceInputs.forEach((input) => input.addEventListener('change', renderCalendar, { signal: lifecycle.signal }));
    summary.querySelector<HTMLButtonElement>('[data-summary-notifications]')?.addEventListener('click', () => {
      const notificationButton = document.querySelector<HTMLButtonElement>('[data-admin-notifications]');
      notificationButton?.click();
    }, { signal: lifecycle.signal });
    window.addEventListener('atlasez-lang-change', () => { if (portalData) renderPortal(portalData); }, { signal: lifecycle.signal });
    const setLoadingState = () => {
      portalError.hidden = true;
      portalRetry.disabled = false;
      portalRetry.textContent = '再試行';
      managedProjectsView.classList.add('loading-state');
      memberProjectsView.classList.add('loading-state');
      managedProjectsView.innerHTML = '<p class="loading-state">読み込み中…</p>';
      memberProjectsView.innerHTML = '<p class="loading-state">読み込み中…</p>';
      availableProjectsSection.hidden = true;
      calendarAgenda.hidden = false;
      calendarAgenda.innerHTML = '<p class="loading-state">読み込み中…</p>';
      todosView.classList.add('loading-state');
      todosView.innerHTML = '<p class="loading-state">読み込み中…</p>';
    };
    const setLoadError = (error: unknown) => {
      const message = error instanceof Error ? error.message : 'Homeを読み込めませんでした。';
      portalErrorMessage.textContent = message;
      portalError.hidden = false;
      portalRetry.disabled = false;
      portalRetry.textContent = '再試行';
      managedProjectsView.classList.remove('loading-state');
      memberProjectsView.classList.remove('loading-state');
      managedProjectsView.innerHTML = '<p class="project-empty">データを読み込めませんでした。</p>';
      memberProjectsView.innerHTML = '<p class="project-empty">データを読み込めませんでした。</p>';
      availableProjectsSection.hidden = true;
      calendarAgenda.hidden = false;
      calendarAgenda.innerHTML = '<p class="calendar-agenda-empty">データを読み込めませんでした。</p>';
      todosView.classList.remove('loading-state');
      todosView.innerHTML = '<p class="empty">データを読み込めませんでした。</p>';
    };
    const loadMyIntake = async () => {
      myIntakeRetry.disabled = true;
      try {
        const ownResponse = await fetch('/api/admin/my-intake', { credentials: 'same-origin', cache: 'no-store', signal: lifecycle.signal });
        const ownData = ownResponse.headers.get('content-type')?.includes('application/json')
          ? await ownResponse.json() as { entries?: MyIntakeEntry[] } : null;
        if (!ownResponse.ok || !Array.isArray(ownData?.entries)) throw new Error('案内情報を読み込めませんでした。');
        if (!lifecycle.signal.aborted) renderMyIntake(ownData.entries);
      } catch {
        if (!lifecycle.signal.aborted) {
          myIntakeSection.hidden = false;
          myIntakeSummary.textContent = '参加後フォローを読み込めませんでした。再読み込みしてください。';
          myIntakeEntries.replaceChildren();
          myIntakeRetry.hidden = false;
        }
      } finally { if (!lifecycle.signal.aborted) myIntakeRetry.disabled = false; }
    };
    myIntakeRetry.addEventListener('click', () => void loadMyIntake());
    const loadPortal = async () => {
      if (lifecycle.signal.aborted) return;
      retry?.begin();
      setLoadingState();
      portalRetry.disabled = true;
      portalRetry.textContent = '再試行中…';
      try {
        const params = new URLSearchParams({ timezone: timezone() });
        const data = await fetch(`/api/admin/portal?${params.toString()}`, { credentials: 'same-origin', cache: 'no-store' }).then(async (response) => {
          const contentType = response.headers.get('content-type') ?? '';
          const data = contentType.includes('application/json') ? await response.json() as PortalData : null;
          if (!response.ok || !data) throw new Error(data?.error ?? '認証情報を確認できませんでした。');
          return data;
        });
        if (lifecycle.signal.aborted) return;
        portalData = data;
        renderPortal(portalData);
        await loadMyIntake();
        portalError.hidden = true;
        retry?.success();
      } catch (error) {
        if (!lifecycle.signal.aborted) {
          setLoadError(error);
          retry?.fail(error);
        }
      } finally {
        if (!lifecycle.signal.aborted) {
          portalRetry.disabled = false;
          portalRetry.textContent = '再試行';
        }
      }
    };
    retry = createAdminLoadRetry(root, () => loadPortal(), 'ポータル情報を読み込めませんでした。');
    void loadPortal();
  };
  document.addEventListener('astro:page-load', initializePortal);
  initializePortal();
</script>
