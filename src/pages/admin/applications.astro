<style is:global>
  .application-list .app{background:linear-gradient(145deg,var(--background-secondary),color-mix(in srgb,var(--background-secondary) 78%,var(--background-primary)));border:1px solid var(--border-default);border-radius:1rem;box-shadow:0 .55rem 1.5rem rgb(0 0 0 / .1);overflow:hidden;padding:0;position:relative}
  .application-list .app::before{background:var(--accent-primary);content:"";inset:0 auto 0 0;position:absolute;width:.3rem}
  .application-list .app[data-status="new"]::before{background:#d97706}.application-list .app[data-status="reviewing"]::before{background:#3478b7}.application-list .app[data-status="accepted"]::before{background:#2f8a58}.application-list .app[data-status="rejected"]::before{background:#9b5a5a}
