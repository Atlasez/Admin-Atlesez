---
import AdminLayout from "../../layouts/AdminLayout.astro";
const applicationProjects = [
  ["atlas", "学習サイト「アトラス」"],
  ["thinking-cafe", "考えるカフェ"],
  ["seminar-platform", "ゼミプラットフォーム"],
  ["student-council-exchange", "日本生徒会協会"],
  ["secretariat", "運営事務局"],
] as const;
const requestedProject = Astro.url.searchParams.get("project")?.trim().toLowerCase() ?? "";
const selectedProject = applicationProjects.find(([slug]) => slug === requestedProject);
const projectLabel = selectedProject?.[1] ?? "";
---
<AdminLayout title={selectedProject ? `${projectLabel}：応募管理` : "応募管理"} description="プロジェクト別の運営参加応募を確認">
  <main class="applications" data-applications data-project={selectedProject?.[0] ?? ""}>
    <section class="application-hero" aria-labelledby="applications-title">
      <header>
        <p>Application operations</p>
        <h2 class="project-context-title">{selectedProject ? `${projectLabel}：応募管理` : "応募管理"}</h2>
        <h1 id="applications-title">応募対応を、<br />ひとつの流れに。</h1>
        <span>{selectedProject ? `${projectLabel}に届いた応募を、確認から参加準備まで一つの画面で進めます。` : "応募管理を表示するプロジェクトを選択してください。"}</span>
        <div class="hero-actions" hidden={!selectedProject}>
          <a class="button button--light" href="#application-workspace">応募を確認する</a>
          <a class="hero-text-link" href="#application-flow-title">参加フローを見る <span aria-hidden="true">→</span></a>
        </div>
      </header>
      <section class="application-overview hero-product" aria-labelledby="application-list-title" hidden={!selectedProject}>
        <div class="product-chrome" aria-hidden="true">
          <div class="product-brand"><span class="atlas-mark">A</span><strong>Atlas applications</strong><span>⌄</span></div>
          <div class="product-tools"><span>⌕</span><span>•••</span></div>
        </div>
        <div class="hero-product-body">
          <aside class="product-rail" aria-hidden="true">
            <span class="is-active">受信トレイ</span>
            <span>確認中</span>
            <span>面談</span>
            <span>受入済み</span>
            <small>運営ワークスペース</small>
          </aside>
          <div class="product-workspace">
            <div class="section-heading"><div><p>Live workspace</p><h2 id="application-list-title">応募一覧</h2></div><span data-total-count>—</span></div>
            <div class="summary-grid" aria-label="応募状況">
              <div class="summary-card summary-card--new"><strong data-summary-new>0</strong><span>新規</span></div>
              <div class="summary-card summary-card--reviewing"><strong data-summary-reviewing>0</strong><span>確認中</span></div>
              <div class="summary-card summary-card--accepted"><strong data-summary-accepted>0</strong><span>受入済み</span></div>
              <div class="summary-card summary-card--rejected"><strong data-summary-rejected>0</strong><span>見送り</span></div>
            </div>
            <div class="filter-bar" role="search">
              <label>検索<input type="search" data-search placeholder="名前・メール・所属で検索" /></label>
              <label>状態<select data-filter-status><option value="all">すべての状態</option><option value="new">新規</option><option value="reviewing">確認中</option><option value="accepted">受入済み</option><option value="rejected">見送り</option></select></label>
              <button type="button" class="button button--quiet" data-clear-filter>解除</button>
            </div>
            <div class="product-preview" aria-hidden="true">
              <div><span class="preview-avatar">応</span><p><strong>応募内容を確認</strong><small>希望分野・記事案・参加理由</small></p><b>新規</b></div>
              <div><span class="preview-avatar preview-avatar--muted">面</span><p><strong>面談情報を整理</strong><small>日時・形式・案内を一か所に</small></p><b>確認中</b></div>
              <div><span class="preview-avatar preview-avatar--green">参</span><p><strong>参加環境へ接続</strong><small>受入・プロフィール・Discord</small></p><b>受入済み</b></div>
            </div>
          </div>
        </div>
      </section>
    </section>
    <nav class="project-switcher" aria-label="応募管理のプロジェクト切り替え">
      {applicationProjects.map(([slug, label]) => <a href={`/admin/applications/?project=${slug}`} aria-current={selectedProject?.[0] === slug ? "page" : undefined}>{label}</a>)}
    </nav>
    <section class="project-picker" hidden={Boolean(selectedProject)} aria-labelledby="project-picker-title">
      <p>プロジェクトを選択</p>
      <h2 id="project-picker-title">確認する応募先を選んでください</h2>
      <span>プロジェクトをまたいだ一括表示は行わず、各運営ページから個別に確認します。</span>
    </section>
    <section class="application-principles" hidden={!selectedProject} aria-labelledby="application-principles-title">
      <p class="principles-kicker">A focused path from interest to contribution</p>
      <h2 id="application-principles-title"><span>応募の背景を理解し、</span>次の一歩を迷わず決められる運営ワークスペース。</h2>
      <div class="principle-grid">
        <article><span class="figure-label">FIG 0.1</span><div class="principle-graphic principle-graphic--intake" aria-hidden="true"><i></i><i></i><i></i></div><h3>見落とさない</h3><p>新着、確認中、受入済みを同じリズムで追い、対応の停滞を見つけます。</p></article>
        <article><span class="figure-label">FIG 0.2</span><div class="principle-graphic principle-graphic--context" aria-hidden="true"><i></i><i></i><i></i></div><h3>背景を共有する</h3><p>応募内容、面談、担当候補を一つの文脈として、運営メンバーで共有します。</p></article>
        <article><span class="figure-label">FIG 0.3</span><div class="principle-graphic principle-graphic--handoff" aria-hidden="true"><i></i><i></i><i></i></div><h3>参加までつなぐ</h3><p>受入後のプロフィール入力とDiscord確認まで、途切れない手続きをつくります。</p></article>
      </div>
    </section>
    <section class="application-flow feature-section" aria-labelledby="application-flow-title" hidden={!selectedProject}>
      <div class="flow-heading"><div><p>Participation flow</p><h2 id="application-flow-title">応募から<br />参加まで</h2></div><div class="feature-copy"><span>確認、面談、受入、参加環境の準備まで。段階ごとの状態と次の操作を、同じワークスペースで扱えます。</span><a href="#application-workspace">応募者を確認 <span aria-hidden="true">→</span></a></div></div>
      <ol class="flow-steps">
        <li><span class="flow-step-number">1</span><div><strong>応募内容を確認</strong><small>希望分野、書きたい記事、参加理由を読み、対応の入口をそろえます。</small><em>Intake</em></div></li>
        <li><span class="flow-step-number">2</span><div><strong>確認中に変更</strong><small>追加確認が必要な応募を「確認中」として整理し、面談へつなぎます。</small><em>Review</em></div></li>
        <li><span class="flow-step-number">3</span><div><strong>受入を確定</strong><small>プロジェクト参加を登録し、本人へプロフィール入力を案内します。</small><em>Accept</em></div></li>
        <li><span class="flow-step-number">4</span><div><strong>Discord情報を確認</strong><small>本人同意後、サーバー参加と既存ロールを照合。失敗時は再試行します。</small><em>Connect</em></div></li>
      </ol>
    </section>
    <section class="application-feature-demo feature-section" hidden={!selectedProject} aria-labelledby="interview-demo-title">
      <div class="flow-heading"><div><p>Interview and review</p><h2 id="interview-demo-title">面談と<br />確認</h2></div><div class="feature-copy"><span>候補日時、形式、案内先を応募内容と並べて管理。会話の前後で必要な文脈が離れません。</span><a href="#application-workspace">面談情報を確認 <span aria-hidden="true">→</span></a></div></div>
      <div class="feature-demo-window interview-demo" aria-hidden="true">
        <div class="demo-window-bar"><span><i></i> 面談ワークスペース</span><span>•••</span></div>
        <div class="interview-demo-grid">
          <aside><p>確認する応募者</p><strong>応募内容から面談へ</strong><span class="demo-person is-current"><b>01</b><span>応募内容を確認<small>希望分野と記事案</small></span></span><span class="demo-person"><b>02</b><span>候補日時を調整<small>オンライン / 対面</small></span></span><span class="demo-person"><b>03</b><span>応募者へ通知<small>案内を送信</small></span></span></aside>
          <div class="demo-calendar"><div class="calendar-heading"><span>面談日時</span><strong>September 2026</strong></div><div class="calendar-week"><span>月<small>07</small></span><span>火<small>08</small></span><span class="is-selected">水<small>09</small></span><span>木<small>10</small></span><span>金<small>11</small></span></div><div class="calendar-slots"><span>14:00</span><div><i></i><b>応募者面談</b><small>Zoom ・ 45分</small></div><span>15:00</span><div class="is-muted"><i></i><b>面談メモ</b><small>確認事項を共有</small></div><span>16:00</span></div>
        </div>
      </div>
      </div>
    </section>
    <section class="application-feature-demo feature-section" hidden={!selectedProject} aria-labelledby="accept-demo-title">
      <div class="flow-heading"><div><p>Acceptance and guidance</p><h2 id="accept-demo-title">受入と<br />案内</h2></div><div class="feature-copy"><span>受入を確定したら、プロフィール入力と次の手続きを本人へ案内。状態変更と連絡を一続きにします。</span><a href="#application-workspace">受入状態を確認 <span aria-hidden="true">→</span></a></div></div>
      <div class="feature-demo-window acceptance-demo" aria-hidden="true">
        <div class="demo-window-bar"><span><i></i> 受入アクション</span><span>準備完了</span></div>
        <div class="acceptance-demo-body">
          <div class="acceptance-track"><span class="is-done"><i>✓</i><b>応募を確認</b><small>内容と希望分野を確認済み</small></span><span class="is-done"><i>✓</i><b>面談を実施</b><small>面談メモを共有済み</small></span><span class="is-current"><i>3</i><b>受入を確定</b><small>承認メールを準備</small></span><span><i>4</i><b>プロフィール入力</b><small>本人の入力を待機</small></span></div>
          <div class="acceptance-message"><p>Acceptance message</p><h3>参加のご案内</h3><span>プロジェクトへの参加を歓迎します。次に、プロフィール入力とDiscord連携を進めてください。</span><div><b>プロフィール入力</b><small>応募者専用画面</small><i>→</i></div><button type="button" tabindex="-1">受入してメールを送る</button></div>
        </div>
      </div>
    </section>
    <section class="application-feature-demo feature-section" hidden={!selectedProject} aria-labelledby="connect-demo-title">
      <div class="flow-heading"><div><p>Workspace connection</p><h2 id="connect-demo-title">参加環境へ<br />接続</h2></div><div class="feature-copy"><span>Discord同意、サーバー参加、既存ロールの照合を確認。失敗した処理も状態を保ったまま再試行できます。</span><a href="#application-workspace">連携状態を確認 <span aria-hidden="true">→</span></a></div></div>
      <div class="feature-demo-window connection-demo" aria-hidden="true">
        <div class="demo-window-bar"><span><i></i> Participation environment</span><span>Live status</span></div>
        <div class="connection-demo-body">
          <aside><p>参加環境</p><strong>セットアップ状況</strong><span class="connection-health"><i></i>すべてのサービスは正常です</span></aside>
          <div class="connection-steps"><span class="is-complete"><i>✓</i><p><b>受入済み</b><small>プロジェクト参加を登録</small></p><em>完了</em></span><span class="is-complete"><i>✓</i><p><b>Discord OAuth</b><small>本人の同意を確認</small></p><em>連携済み</em></span><span class="is-active"><i>↗</i><p><b>サーバーとロール</b><small>参加状況と既存ロールを照合</small></p><em>確認中</em></span><span><i>○</i><p><b>運営ワークスペース</b><small>必要な権限を別画面で設定</small></p><em>待機</em></span></div>
        </div>
      </div>
    </section>
    <section class="operations-timeline" hidden={!selectedProject} aria-labelledby="operations-timeline-title">
      <h2 id="operations-timeline-title">運営のチェックポイント</h2>
      <div><article><span></span><h3>内容</h3><p>応募者の希望とプロジェクトの活動を照合する。</p><small>REVIEW 01</small></article><article><span></span><h3>対話</h3><p>面談で期待、役割、参加方法をすり合わせる。</p><small>REVIEW 02</small></article><article><span></span><h3>受入</h3><p>参加登録と本人への案内を同じ操作で進める。</p><small>REVIEW 03</small></article><article><span></span><h3>接続</h3><p>プロフィールとDiscordの準備を最後まで確認する。</p><small>REVIEW 04</small></article></div>
    </section>
    <output class="notice" data-notice aria-live="polite" hidden={!selectedProject}></output>
    <section class="applications-workspace feature-section" id="application-workspace" hidden={!selectedProject} aria-labelledby="workspace-title">
      <div class="workspace-heading"><div><p>Application workspace</p><h2 id="workspace-title">一人ずつ、<br />丁寧に確認する。</h2></div><span>応募者を切り替えながら、面談情報、応募内容、受入状態を一つの画面で更新します。</span></div>
      <section class="application-navigator" data-application-navigator aria-label="応募者の切り替え" hidden>
        <button type="button" class="button button--quiet navigator-button" data-previous-application aria-label="前の応募者">← 前へ</button>
        <label class="application-picker">表示する応募者<select data-application-select aria-label="表示する応募者"></select></label>
        <span class="application-position" data-application-position aria-live="polite"></span>
        <button type="button" class="button button--quiet navigator-button" data-next-application aria-label="次の応募者">次へ →</button>
      </section>
      <div class="application-list" data-list>読み込み中…</div>
    </section>
    <section class="applications-closing" hidden={!selectedProject}>
      <p>Ready for the next conversation</p>
      <h2>次の参加者を、<br />チームへ迎える。</h2>
      <a class="button button--light" href="#application-workspace">応募ワークスペースへ</a>
    </section>
    <footer class="applications-footer" hidden={!selectedProject}>
      <a class="applications-footer-brand" href="/admin/atlas/"><span>A</span><strong>Atlas operations</strong></a>
      <div><h2>応募管理</h2><a href="#application-workspace">応募一覧</a><a href="#application-flow-title">参加フロー</a><a href="#operations-timeline-title">チェックポイント</a></div>
      <div><h2>運営機能</h2><a href="/admin/articles/">編集・フィードバック</a><a href="/admin/operations/?project=atlas">タスク管理</a><a href="/admin/calendar/?project=atlas">カレンダー</a></div>
      <div><h2>管理</h2><a href="/admin/manage/?project=atlas">管理トップ</a><a href="/admin/permissions/?project=atlas">運営者・担当管理</a><a href="/admin/reports/?project=atlas">問題報告</a></div>
      <small>Atlasez / Learning site Atlas</small>
    </footer>
    <dialog class="accept-dialog" data-accept-dialog aria-labelledby="accept-dialog-title" hidden={!selectedProject}>
      <h2 id="accept-dialog-title">受入を確定しますか？</h2>
      <p>「はい」を押すと、プロジェクト参加を登録し、応募者本人へ受入承認メールを送信します。本人にはプロフィール入力も案内されます。管理権限は別途「運営者・担当管理」から付与してください。</p>
      <div class="accept-dialog__actions">
        <button type="button" class="button button--quiet" data-accept-cancel>いいえ、戻る</button>
        <button type="button" class="button" data-accept-confirm>はい、受入してメールを送る</button>
      </div>
    </dialog>
  </main>
</AdminLayout>
<style>
  .applications{margin:0 auto;max-width:1100px;padding:0 1.25rem 4rem}.applications header{border-bottom:1px solid var(--border-default);padding:2rem 0 1.2rem}.applications header p{color:var(--accent-primary);font-size:.75rem;font-weight:800;letter-spacing:.08em;margin:0}.applications h1{font-size:2rem;margin:.3rem 0}.applications header span,.app small{color:var(--text-secondary)}.application-flow{border:1px solid var(--border-default);margin-top:1.25rem;padding:1rem}.flow-heading{align-items:end;display:flex;gap:1rem;justify-content:space-between}.flow-heading p{color:var(--accent-primary);font-size:.72rem;font-weight:800;letter-spacing:.08em;margin:0 0 .3rem}.flow-heading h2{font-size:1.15rem;margin:0}.flow-heading>span{color:var(--text-secondary);font-size:.76rem}.flow-steps{display:grid;gap:.65rem;grid-template-columns:repeat(4,minmax(0,1fr));list-style:none;margin:.9rem 0 0;padding:0}.flow-steps li{background:var(--background-secondary);border-top:3px solid var(--accent-primary);display:flex;gap:.55rem;min-height:7rem;padding:.75rem}.flow-step-number{align-items:center;background:var(--accent-primary);border-radius:50%;color:#fff;display:flex;flex:0 0 1.55rem;font-size:.78rem;font-weight:900;height:1.55rem;justify-content:center;width:1.55rem}.flow-steps strong{display:block;font-size:.82rem;line-height:1.35}.flow-steps small{color:var(--text-secondary);display:block;font-size:.7rem;line-height:1.55;margin-top:.35rem}.notice{display:block;min-height:1.5rem;padding-top:.75rem}.notice[data-error="true"]{color:#b42318}.app{border:1px solid var(--border-default);display:grid;gap:.75rem;margin-top:1rem;padding:1rem}.top{align-items:center;display:flex;gap:1rem;justify-content:space-between}.top h2{font-size:1rem;margin:0}.actions{align-items:center;display:flex;flex-wrap:wrap;gap:.5rem}.actions select,.actions button{font:inherit;padding:.45rem .65rem}.actions button{background:var(--accent-primary);border:1px solid var(--accent-primary);color:#fff;cursor:pointer;font-weight:700}.actions button:disabled{cursor:wait;opacity:.55}.badge{border:1px solid var(--border-default);border-radius:999px;font-size:.72rem;font-weight:700;padding:.25rem .5rem}.badge[data-state="synced"]{background:#e8f7ed;border-color:#78bd8b;color:#176b32}.badge[data-state="failed"]{background:#fff1f0;border-color:#f2a6a0;color:#9f211b}.badge[data-state="skipped"]{background:#fff8e1;border-color:#dfbd65;color:#765600}.facts{display:flex;flex-wrap:wrap;gap:.35rem}.facts span{background:var(--background-secondary);border:1px solid var(--border-default);border-radius:999px;font-size:.75rem;padding:.25rem .45rem}.app h3{font-size:.82rem;margin:.25rem 0 0}.app pre{font:inherit;line-height:1.65;margin:0;white-space:pre-wrap}.provisioning-error{background:#fff7f6;border-left:3px solid #b42318;color:#7a271a;font-size:.78rem;margin:0;padding:.6rem;white-space:pre-wrap}.member-link{color:var(--accent-primary);font-size:.78rem;font-weight:700}@media(max-width:650px){.applications{padding:0 .85rem 3rem}.top{align-items:start;display:grid}.actions,.actions select,.actions button{width:100%}.flow-heading{align-items:start;display:grid}.flow-steps{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:420px){.flow-steps{grid-template-columns:1fr}}
  .application-overview{background:var(--background-secondary);border:1px solid var(--border-default);border-radius:.55rem;margin-top:1.25rem;padding:1rem}.section-heading{align-items:end;display:flex;justify-content:space-between}.section-heading p{color:var(--accent-primary);font-size:.72rem;font-weight:900;letter-spacing:.1em;margin:0 0 .35rem}.section-heading h2{font-size:1.15rem;margin:0}.section-heading>span{color:var(--text-secondary);font-size:.76rem}.summary-grid{display:grid;gap:.55rem;grid-template-columns:repeat(4,1fr);margin-top:.9rem}.summary-card{background:var(--background-primary);border:1px solid var(--border-default);border-left:3px solid var(--border-default);display:grid;gap:.12rem;padding:.65rem .75rem}.summary-card strong{font-size:1.35rem;line-height:1.1}.summary-card span{color:var(--text-secondary);font-size:.72rem;font-weight:700}.summary-card--new{border-left-color:#d97706}.summary-card--reviewing{border-left-color:#2563a5}.summary-card--accepted{border-left-color:#27834f}.summary-card--rejected{border-left-color:#9b5a5a}.filter-bar{align-items:end;display:grid;gap:.55rem;grid-template-columns:minmax(220px,1.5fr) minmax(150px,.65fr) auto;margin-top:.85rem}.filter-bar label{color:var(--text-secondary);display:grid;font-size:.72rem;font-weight:800;gap:.28rem}.filter-bar input,.filter-bar select{appearance:auto;background:var(--background-primary);border:1px solid var(--border-default);border-radius:.3rem;color:var(--text-primary);font:inherit;min-height:2.35rem;padding:.45rem .55rem;width:100%}.button{appearance:none;background:var(--accent-primary);border:1px solid var(--accent-primary);border-radius:.35rem;color:#fff;cursor:pointer;font:inherit;font-size:.78rem;font-weight:800;line-height:1.2;min-height:2.35rem;padding:.55rem .75rem;white-space:nowrap}.button--quiet{background:transparent;border:1px solid var(--border-default);color:var(--accent-primary)}.button--quiet:hover,.button--quiet:focus-visible{background:var(--background-primary