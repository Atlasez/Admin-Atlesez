<style is:global>
  .application-list .app .top{align-items:flex-start;background:color-mix(in srgb,var(--background-primary) 38%,transparent);gap:1.25rem;padding:1.25rem 1.25rem 1.1rem 1.45rem}
  .app-identity{align-items:flex-start;gap:.85rem}.app-avatar{box-shadow:0 .25rem .7rem rgb(0 0 0 / .15);flex-basis:3.2rem;height:3.2rem;width:3.2rem}.app-kicker{margin-top:.05rem}.application-list .app .top h2{font-size:1.28rem;letter-spacing:-.01em}.app-subline{color:var(--text-secondary);font-size:.72rem;line-height:1.5;margin:.35rem 0 0}.app-project{background:color-mix(in srgb,var(--accent-primary) 14%,var(--background-primary));border:1px solid color-mix(in srgb,var(--accent-primary) 42%,var(--border-default));border-radius:999px;color:var(--text-primary);display:inline-flex;font-size:.68rem;font-weight:800;margin-top:.55rem;padding:.25rem .5rem}
  .application-list .app .actions{align-items:stretch;display:flex;gap:.55rem;justify-content:flex-end}.action-status,.status-control{display:grid;gap:.25rem}.action-caption,.status-control>span{color:var(--text-secondary);font-size:.65rem;font-weight:800;line-height:1}.action-status .badge{align-items:center;display:flex;justify-content:center}.status-control select{min-width:11.5rem}.application-list .app .actions button{align-self:end}
  .application-profile{background:color-mix(in srgb,var(--background-primary) 55%,transparent);border:1px solid color-mix(in srgb,var(--border-default) 80%,transparent);border-radius:.7rem;margin-top:1rem;padding:.95rem 1rem 1rem}.application-profile .application-section-heading{margin-bottom:.75rem}.application-profile .application-section-heading>div{display:grid;gap:.15rem}.application-profile .application-section-heading h3{font-size:.95rem;margin:0}.application-profile .application-section-heading>span{background:var(--background-secondary);border:1px solid var(--border-default);border-radius:999px;padding:.25rem .5rem}.application-profile .application-meta-grid{gap:.55rem}.application-profile .application-meta-item{background:var(--background-secondary);min-height:4.3rem}.application-profile .application-meta-item strong{font-size:.82rem}.application-profile .application-meta-item:first-child{border-color:color-mix(in srgb,var(--accent-primary) 45%,var(--border-default));border-left:3px solid var(--accent-primary)}
  @media(max-width:760px){.application-list .app .top{gap:.9rem}.application-list .app .actions{display:grid;grid-template-columns:minmax(8rem,auto) minmax(11rem,1fr);justify-content:stretch}.application-list .app .actions .status-control{min-width:0}.status-control select{min-width:0}.application-list .app .actions button{grid-column:1/-1;justify-self:start}}
  @media(max-width:480px){.application-list .app .top{padding:.95rem .85rem .9rem 1rem}.application-list .app .top h2{font-size:1.12rem}.application-list .app .actions{grid-template-columns:1fr}.application-list .app .actions button{grid-column:auto;justify-self:stretch}.application-profile{padding:.8rem .75rem}.application-profile .application-section-heading{align-items:flex-start;display:grid;gap:.45rem}.application-profile .application-section-heading>span{justify-self:start}}
</style>
<script>
  const root=document.querySelector<HTMLElement>('[data-applications]');
  if(root){
    const esc=(value:unknown)=>String(value??'').replace(/[&<>'"]/g,char=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[char]??char));
    const notice=root.querySelector<HTMLOutputElement>('[data-notice]')!;
    const list=root.querySelector<HTMLElement>('[data-list]')!;
    const navigator=root.querySelector<HTMLElement>('[data-application-navigator]')!;
    const applicationSelect=root.querySelector<HTMLSelectElement>('[data-application-select]')!;
    const previousApplication=root.querySelector<HTMLButtonElement>('[data-previous-application]')!;
    const nextApplication=root.querySelector<HTMLButtonElement>('[data-next-application]')!;
    const applicationPosition=root.querySelector<HTMLElement>('[data-application-position]')!;
    const search=root.querySelector<HTMLInputElement>('[data-search]')!;
    const statusFilter=root.querySelector<HTMLSelectElement>('[data-filter-status]')!;
    const clearFilter=root.querySelector<HTMLButtonElement>('[data-clear-filter]');
    const acceptDialog=root.querySelector<HTMLDialogElement>('[data-accept-dialog]')!;
    const acceptConfirm=root.querySelector<HTMLButtonElement>('[data-accept-confirm]')!;
    const acceptCancel=root.querySelector<HTMLButtonElement>('[data-accept-cancel]')!;
    const totalCount=root.querySelector<HTMLElement>('[data-total-count]')!;
    const summary={new:root.querySelector<HTMLElement>('[data-summary-new]')!,reviewing:root.querySelector<HTMLElement>('[data-summary-reviewing]')!,accepted:root.querySelector<HTMLElement>('[data-summary-accepted]')!,rejected:root.querySelector<HTMLElement>('[data-summary-rejected]')!};
    const provisioningLabel:Record<string,string>={not_started:'未実行',pending:'同期準備中',synced:'Discord同期済み',skipped:'Discord未連携',failed:'Discord同期要確認'};
    let subjectLabels:Record<string,string>={};
    let formLabels:Record<string,string>={};
    const setNotice=(message:string,error=false)=>{notice.value=message;notice.dataset.error=String(error)};
    const displayName=(application:any)=>{const split=[application.form_language==='en'?application.given_name:application.family_name,application.form_language==='en'?application.middle_name:'',application.form_language==='en'?application.family_name:application.given_name].filter(Boolean).join(' ');return split||application.name||'氏名未設定'};
    const formatDate=(value:unknown)=>{if(!value)return '日時未設定';const date=new Date(String(value));return Number.isNaN(date.getTime())?'日時未設定':new Intl.DateTimeFormat('ja-JP',{dateStyle:'medium',timeStyle:'short'}).format(date)};
    const answerLabels:Record<string,string>={theme:'参加してみたいテーマ',councilStatus:'生徒会への所属または所属経験',councilRole:'生徒会での役職名',councilPlans:'活動・企画案',strengths:'得意なこと・資格・実績',problemAwareness:'問題意識',plans:'本協議会で取り組みたいこと'};
    const projectAnswers=(application:any)=>{try{return JSON.parse(application.project_answers||'{}') as Record<string,string>}catch{return {}}};
    const fields=(application:any)=>{const answers=projectAnswers(application);const answerHtml=Object.entries(answers).map(([key,value])=>`<div class="response-block"><h3>${esc(answerLabels[key]??key)}</h3><pre>${esc(value||'—')}</pre></div>`).join('');const meta=(label:string,value:unknown)=>`<div class="application-meta-item"><span>${esc(label)}</span><strong>${esc(value||'—')}</strong></div>`;return `<section class="application-profile" aria-label="応募者の基本情報"><div class="application-section-heading"><div><p>応募者情報</p><h3>基本プロフィール</h3></div><span>${esc(formLabels[application.project_slug]??application.project_slug??'学習サイト「アトラス」')}</span></div><div class="application-meta-grid">${meta('所属',`${application.affiliation_type||'未設定'}：${application.institution||'—'}`)}${meta('所属先メール',application.affiliation_email)}${meta('学年',application.grade)}${meta('国・居住地',`${application.country||'—'} / ${application.residence_city||'都市未登録'}`)}${meta('生年月日',application.birth_date)}${meta('タイムゾーン',application.timezone)}${meta('Discord連携',application.verified_discord_user_id?'確認済み・ID登録済み':'未登録')}${meta('応募日時',formatDate(application.created_at))}</div></section><details class="application-original-fields"><summary>フォーム回答の詳細を開く</summary><div class="application-response-grid"><div class="response-block"><h3>知ったきっかけ</h3><pre>${esc(application.referral_source||'—')}</pre></div><div class="response-block"><h3>現在のサークル・学生団体</h3><pre>${esc(application.current_organizations||'—')}</pre></div><div class="response-block"><h3>参加理由</h3><pre>${esc(application.motivation_reasons||'—')}</pre></div><div class="response-block"><h3>希望担当</h3><pre>${esc(application.desired_roles||'—')}</pre></div><div class="response-block"><h3>面談候補日</h3><pre>${esc(application.interview_availability||'—')}</pre></div><div class="response-block"><h3>質問</h3><pre>${esc(application.applicant_questions||'—')}</pre></div>${answerHtml}</div></details>`};
    const actions=(application:any)=>{const accepted=application.status==='accepted';const state=application.provisioning_status||'not_started';const name=displayName(application);return `<div class="actions"><div class="action-status"><span class="action-caption">参加環境</span><span class="badge" data-state="${esc(state)}">${esc(provisioningLabel[state]??state)}</span></div><label class="status-control"><span>応募状態</span><select data-id="${esc(application.id)}" aria-label="${esc(name)}の応募状態" ${accepted?'disabled':''}><option value="new" ${application.status==='new'?'selected':''}>新規</option><option value="reviewing" ${application.status==='reviewing'?'selected':''}>確認中</option><option value="accepted" ${accepted?'selected':''}>受入・オンボーディング開始</option><option value="rejected" ${application.status==='rejected'?'selected':''}>見送り</option></select></label>${accepted&&state!=='synced'?`<button type="button" data-retry="${esc(application.id)}">Discord同期を再試行</button>`:''}</div>`};
    let applications:any[]=[];
    let visibleApplications:any[]=[];
    let selectedApplicationId='';
    let pendingAcceptanceId='';
    const renderSummary=()=>{totalCount.textContent=`${applications.length}件`;for(const key of ['new','reviewing','accepted','rejected'])summary[key as keyof typeof summary].textContent=String(applications.filter(application=>application.status===key).length)};
    const matches=(application:any)=>{const query=search.value.trim().toLocaleLowerCase();const status=statusFilter.value;const haystack=[displayName(application),application.email,application.institution,application.desired_subjects,formLabels[application.project_slug]].join(' ').toLocaleLowerCase();return (!query||haystack.includes(query))&&(status==='all'||application.status===status)};
    const applicationCard=(application:any)=>{const name=displayName(application);const initial=String(name).trim().slice(0,1)||'？';const email=String(application.email||'');const projectLabel=formLabels[application.project_slug]??application.project_slug??'学習サイト「アトラス」';const subjectTags=String(application.desired_subjects||'').split(',').filter(Boolean).map(subject=>`<span>${esc(subjectLabels[subject]??subject)}</span>`).join('')||'<span>旧形式応募：未設定</span>';return `<article class="app" data-status="${esc(application.status)}" aria-labelledby="application-${esc(application.id)}-name"><div class="top"><div class="app-identity"><span class="app-avatar" aria-hidden="true">${esc(initial)}</span><div><p class="app-kicker">応募者情報</p><h2 id="application-${esc(application.id)}-name">${esc(name)}</h2>${email?`<a class="app-email" href="mailto:${encodeURIComponent(email)}">${esc(email)}</a>`:''}<p class="app-subline">${esc(formatDate(application.created_at))}</p><span class="app-project">${esc(projectLabel)}</span></div></div>${actions(application)}</div>${fields(application)}<section class="application-section application-section--subjects" aria-label="希望分野"><div class="application-section-heading"><p>希望分野</p><span>担当候補</span></div><div class="facts">${subjectTags}</div></section><section class="application-response-grid application-response-grid--main" aria-label="応募内容"><div class="response-block"><h3>書きたい記事・テーマ</h3><pre>${esc(application.article_ideas||'—')}</pre></div><div class="response-block"><h3>できること・関心</h3><pre>${esc(application.interests||'—')}</pre></div><div class="response-block response-block--wide"><h3>参加理由・自己紹介</h3><pre>${esc(application.message||'—')}</pre></div>${application.availability_note?`<div class="response-block"><h3>参加可能な時間帯</h3><pre>${esc(application.availability_note)}</pre></div>`:''}</section>${application.provisioning_error?`<p class="provisioning-error">${esc(application.provisioning_error)}</p>`:''}${application.status==='accepted'&&!application.verified_discord_user_id?'<a class="member-link" href="/admin/permissions/">本人確認後、参加者一覧でDiscordユーザーIDを登録する →</a>':''}</article>`};
    const applicationOptionLabel=(application:any)=>`${displayName(application)}｜${application.email||'メール未設定'}`;
    const renderNavigator=()=>{if(!visibleApplications.length){navigator.hidden=true;return}const selectedIndex=Math.max(0,visibleApplications.findIndex(application=>application.id===selectedApplicationId));const selected=visibleApplications[selectedIndex];selectedApplicationId=selected.id;applicationSelect.innerHTML=visibleApplications.map(application=>`<option value="${esc(application.id)}">${esc(applicationOptionLabel(application))}</option>`).join('');applicationSelect.value=selectedApplicationId;applicationPosition.textContent=`${selectedIndex+1} / ${visibleApplications.length}人`;previousApplication.disabled=selectedIndex===0;nextApplication.disabled=selectedIndex===visibleApplications.length-1;navigator.hidden=false};
    const render=(items:any[])=>{visibleApplications=items.filter(matches);if(!visibleApplications.some(application=>application.id===selectedApplicationId))selectedApplicationId=visibleApplications[0]?.id??'';renderNavigator();const selected=visibleApplications.find(application=>application.id===selectedApplicationId);list.innerHTML=selected?applicationCard(selected):'<p class="application-empty">条件に一致する応募はありません。</p>'};
    const refresh=()=>render(applications);
    const resetSelectionAndRefresh=()=>{selectedApplicationId='';refresh()};
    const load=async()=>{try{const response=await fetch('/api/admin/applications',{credentials:'same-origin'});const data=await response.json();if(!response.ok)throw Error(data.error??'読み込めませんでした。');subjectLabels=data.subjectLabels??{};formLabels=data.formLabels??{};applications=Array.isArray(data.applications)?data.applications:[];renderSummary();refresh()}catch(error){navigator.hidden=true;list.textContent=error instanceof Error?error.message:'読み込めませんでした。'}};
    search.addEventListener('input',resetSelectionAndRefresh);statusFilter.addEventListener('change',resetSelectionAndRefresh);clearFilter?.addEventListener('click',()=>{search.value='';statusFilter.value='all';resetSelectionAndRefresh()});
    applicationSelect.addEventListener('change',()=>{selectedApplicationId=applicationSelect.value;refresh()});
    previousApplication.addEventListener('click',()=>{const index=visibleApplications.findIndex(application=>application.id===selectedApplicationId);if(index>0){selectedApplicationId=visibleApplications[index-1].id;refresh()}});
    nextApplication.addEventListener('click',()=>{const index=visibleApplications.findIndex(application=>application.id===selectedApplicationId);if(index>=0&&index<visibleApplications.length-1){selectedApplicationId=visibleApplications[index+1].id;refresh()}});
    const update=async(id:string,status:string,button?:HTMLButtonElement)=>{button?.setAttribute('disabled','');setNotice(status==='accepted'?'受入を確定し、承認メールを送信する準備中…':'状態を更新中…');try{const response=await fetch(`/api/admin/applications/${encodeURIComponent(id)}`,{method:'PATCH',credentials:'same-origin',headers:{'content-type':'application/json'},body:JSON.stringify({status})});const data=await response.json().catch(()=>({}));if(!response.ok)throw Error(data.error??'更新できませんでした。');const warning=Array.isArray(data.provisioning?.warnings)?data.provisioning.warnings.join(' '):'';const emailMessage=status==='accepted'?(data.acceptanceEmailQueued?'応募者への受入承認メールを送信キューに追加しました。':'受入は完了しましたが、承認メールを送信キューに追加できませんでした。'):'';setNotice(warning?`受入は完了しました。${emailMessage} ${warning}`:status==='accepted'?`受入が完了しました。${emailMessage}`:'状態を更新しました。',Boolean(warning||status==='accepted'&&!data.acceptanceEmailQueued));await load()}catch(error){setNotice(error instanceof Error?error.message:'更新できませんでした。',true);await load()}finally{button?.removeAttribute('disabled')}};
    root.addEventListener('change',event=>{const select=(event.target as HTMLElement).closest<HTMLSelectElement>('[data-id]');if(!select)return;if(select.value==='accepted'){pendingAcceptanceId=select.dataset.id??'';acceptDialog.showModal();return}void update(select.dataset.id??'',select.value)});
    acceptCancel.addEventListener('click',()=>{pendingAcceptanceId='';acceptDialog.close();void load()});
    acceptConfirm.addEventListener('click',()=>{const id=pendingAcceptanceId;pendingAcceptanceId='';acceptDialog.close();if(id)void update(id,'accepted',acceptConfirm)});
    root.addEventListener('click',event=>{const button=(event.target as HTMLElement).closest<HTMLButtonElement>('[data-retry]');if(button)void update(button.dataset.retry??'','accepted',button)});
    void load();
  }
</script>
