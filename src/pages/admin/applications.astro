  .app-identity{align-items:center;display:flex;gap:.75rem;min-width:0}.app-avatar{align-items:center;background:linear-gradient(145deg,var(--accent-primary),color-mix(in srgb,var(--accent-primary) 55%,#172b3b));border:2px solid color-mix(in srgb,var(--accent-primary) 28%,var(--border-default));border-radius:50%;color:#fff;display:flex;flex:0 0 2.9rem;font-size:1.15rem;font-weight:900;height:2.9rem;justify-content:center;width:2.9rem}.app-kicker{color:var(--accent-primary);font-size:.67rem;font-weight:900;letter-spacing:.1em;margin:0 0 .15rem}.application-list .app .top h2{font-size:1.12rem;line-height:1.3;margin:0}.app-email{color:var(--text-secondary);display:block;font-size:.76rem;margin-top:.2rem;overflow-wrap:anywhere;text-decoration:none}.app-email:hover{color:var(--accent-primary);text-decoration:underline}
  .application-list .app .actions{align-items:flex-end;display:flex;flex-wrap:wrap;gap:.4rem;justify-content:flex-end;margin-left:auto}.application-list .app .actions select{background:var(--background-primary);border:1px solid var(--border-default);border-radius:.4rem;color:var(--text-primary);min-height:2.25rem}.application-list .app .actions button{border-radius:.4rem;min-height:2.25rem}.application-list .app .badge{background:var(--background-primary);font-size:.68rem;line-height:1.2;min-height:2.25rem;padding:.62rem .55rem}.application-list .app .badge[data-state="synced"]{background:color-mix(in srgb,#2f8a58 14%,var(--background-primary));color:var(--text-primary)}
  .application-profile,.application-section,.application-response-grid,.application-original-fields,.provisioning-error,.member-link{margin-left:1.45rem;margin-right:1.25rem}.application-profile{padding:1.05rem 0 .95rem}.application-section-heading{align-items:baseline;display:flex;gap:.65rem;justify-content:space-between;margin-bottom:.65rem}.application-section-heading p{color:var(--accent-primary);font-size:.7rem;font-weight:900;letter-spacing:.1em;margin:0}.application-section-heading span{color:var(--text-secondary);font-size:.7rem}.application-meta-grid{display:grid;gap:.5rem;grid-template-columns:repeat(3,minmax(0,1fr))}.application-meta-item{background:var(--background-primary);border:1px solid var(--border-default);border-radius:.55rem;display:grid;gap:.2rem;min-width:0;padding:.65rem .7rem}.application-meta-item span{color:var(--text-secondary);font-size:.65rem;font-weight:800}.application-meta-item strong{font-size:.78rem;line-height:1.45;overflow-wrap:anywhere}.application-section{border-top:1px solid var(--border-default);padding:1rem 0}.application-section--subjects .facts{gap:.4rem}.application-section--subjects .facts span{background:color-mix(in srgb,var(--accent-primary) 13%,var(--background-primary));border-color:color-mix(in srgb,var(--accent-primary) 42%,var(--border-default));color:var(--text-primary);font-size:.76rem;font-weight:800;padding:.35rem .55rem}
  .application-response-grid{display:grid;gap:.75rem;grid-template-columns:repeat(2,minmax(0,1fr));padding:0 0 1rem}.application-response-grid--main{border-top:1px solid var(--border-default);padding-top:1rem}.response-block{background:var(--background-primary);border:1px solid var(--border-default);border-radius:.6rem;min-width:0;padding:.75rem}.response-block--wide{grid-column:1/-1}.application-list .app .response-block h3{font-size:.73rem;margin:0 0 .45rem}.application-list .app .response-block pre{background:transparent;border:0;border-top:1px solid color-mix(in srgb,var(--border-default) 70%,transparent);border-radius:0;color:var(--text-primary);font-size:.82rem;line-height:1.7;margin:0;padding:.55rem 0 0;overflow-wrap:anywhere;white-space:pre-wrap}.application-original-fields{margin-bottom:1rem;padding:.7rem .8rem}.application-original-fields summary{align-items:center;display:flex;justify-content:space-between}.application-original-fields summary::after{content:"＋";font-size:1rem}.application-original-fields[open] summary::after{content:"−"}.application-original-fields .application-response-grid{margin:0;padding-top:.15rem}.provisioning-error{background:color-mix(in srgb,#b42318 10%,var(--background-primary));border:1px solid color-mix(in srgb,#b42318 35%,var(--border-default));border-left:3px solid #b42318;border-radius:.45rem;color:var(--text-primary);margin-bottom:1rem;padding:.7rem .8rem}.member-link{display:block;margin-bottom:1rem}
  @media(max-width:760px){.application-list .app .top{display:grid;gap:.8rem}.application-list .app .actions{justify-content:flex-start;margin-left:0}.application-list .app .actions select,.application-list .app .actions button{flex:1;min-width:10rem}.application-meta-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.application-response-grid{grid-template-columns:1fr}.response-block--wide{grid-column:auto}}
  @media(max-width:480px){.application-profile,.application-section,.application-response-grid,.application-original-fields,.provisioning-error,.member-link{margin-left:.95rem;margin-right:.85rem}.application-list .app .top{padding-left:1rem;padding-right:.85rem}.application-meta-grid{grid-template-columns:1fr}.application-list .app .actions{display:grid;grid-template-columns:1fr;width:100%}.application-list .app .actions select,.application-list .app .actions button{width:100%}}
