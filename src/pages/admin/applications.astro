</style>
<script>
  const initializeApplications=()=>{const root=document.querySelector<HTMLElement>('[data-applications]');
  if(root && root.dataset.initialized !== 'true'){root.dataset.initialized='true';
    const esc=(value:unknown)=>String(value??'').replace(/[&<>'"]/g,char=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[char]??char));
    const projectLabels:Record<string,string>={atlas:'学習サイト「アトラス」','thinking-cafe':'考えるカフェ','seminar-platform':'ゼミプラットフォーム','student-council-exchange':'日本生徒会協会',secretariat:'運営事務局'};
    const projectSlugFromUrl=new URLSearchParams(window.location.search).get('project')?.trim().toLowerCase()??'';
    const projectSlug=projectLabels[projectSlugFromUrl]?projectSlugFromUrl:'';
    root.dataset.project=projectSlug;
    if(projectSlug){
      const label=projectLabels[projectSlug];
      const contextHeading=root.querySelector<HTMLElement>('.project-context-title');
      const description=root.querySelector<HTMLElement>('header>span');
      if(contextHeading)contextHeading.textContent=`${label}：応募管理`;
      if(description)description.textContent=`${label}に届いた応募を、確認から参加準備まで一つの画面で進めます。`;
      root.querySelector<HTMLElement>('.project-picker')?.setAttribute('hidden','');
      root.querySelectorAll<HTMLElement>('.hero-actions,.application-flow,.application-overview,.application-principles,.application-feature-demo,.operations-timeline,.applications-workspace,.applications-closing,.applications-footer,[data-notice],[data-list],[data-accept-dialog]').forEach(element=>element.removeAttribute('hidden'));
      root.querySelectorAll<HTMLAnchorElement>('.project-switcher a').forEach(link=>link.setAttribute('aria-current',new URL(link.href).searchParams.get('project')===projectSlug?'page':'false'));
    }
    const notice=root.querySelector<HTMLOutputElement>('[data-notice]')!;
    const list=root.querySelector<HTMLElement>('[data-list]')!;
    const navigator=root.querySelector<HTMLElement>('[data-application-navigator]')!;
    const applicationSelect=root.querySelector<HTMLSelectElement>('[data-application-select]')!;
    const previousApplication=root.querySelector<HTMLButtonElement>('[data-previous-application]')!;
    const nextApplication=root.querySelector<HTMLButtonElement>('[data-next-application]')!;
    const applicationPosition=root.querySelector<HTMLElement>('[data-application-position]')!;
    const search=root.querySelector<HTMLInputElement>('[data-search]')!;
    const statusFilter=root.querySelector<HTMLSelectElement>('[data-filter-status]')!;
    const clearFilter=root.querySelector<HTMLButtonElement>('[data-clear-filter]');
    const acceptDialog=root.querySelector<HTMLDialogElement>('[data-accept-dialog]')!;
    const acceptConfirm=root.querySelector<HTMLButtonElement>('[data-accept-confirm]')!;
    const acceptCancel=root.querySelector<HTMLButtonElement>('[data-accept-cancel]')!;
    const totalCount=root.querySelector<HTMLElement>('[data-total-count]')!;
    const summary={new:root.querySelector<HTMLElement>('[data-summary-new]')!,reviewing:root.querySelector<HTMLElement>('[data-summary-reviewing]')!,accepted:root.querySelector<HTMLElement>('[data-summary-accepted]')!,rejected:root.querySelector<HTMLElement>('[data-summary-rejected]')!};
    const provisioningLabel:Record<string,string>={not_started:'未実行',pending:'Discord同期準備中',synced:'Discord同期済み',skipped:'Discord未連携・未実行',failed:'Discord同期要確認'};
    let subjectLabels:Record<string,string>={};
    let formLabels:Record<string,string>={};
    const setNotice=(message:string,error=false)=>{notice.value=message;notice.dataset.error=String(error)};
    const displayName=(application:any)=>{const split=[application.form_language==='en'?application.given_name:application.family_name,application.form_language==='en'?application.middle_name:'',application.form_language==='en'?application.family_name:application.given_name].filter(Boolean).join(' ');return split||application.name||'氏名未設定'};
    const formatDate=(value:unknown)=>{if(!value)return '日時未設定';const date=new Date(String(value));return Number.isNaN(date.getTime())?'日時未設定':new Intl.DateTimeFormat('ja-JP',{dateStyle:'medium',timeStyle:'short'}).format(date)};
    const formatDateTimeLocal=(value:unknown)=>{if(!value)return '';const date=new Date(String(value));if(Number.isNaN(date.getTime()))return '';const offset=date.getTimezoneOffset();return new Date(date.getTime()-offset*60000).toISOString().slice(0,16)};
    const interviewFor=(application:any)=>application.interview??{scheduledAt:application.interview_scheduled_at,mode:application.interview_mode,zoomUrl:application.interview_zoom_url,location:application.interview_location,notifiedAt:application.interview_notified_at};
    const answerLabels:Record<string,string>={theme:'参加してみたいテーマ',councilStatus:'生徒会への所属または所属経験',councilRole:'生徒会での役職名',councilPlans:'活動・企画案',strengths:'得意なこと・資格・実績',problemAwareness:'問題意識',plans:'本協議会で取り組みたいこと'};
    const projectAnswers=(application:any)=>{try{return JSON.parse(application.project_answers||'{}') as Record<string,string>}catch{return {}}};
    const fields=(application:any)=>{const answers=projectAnswers(application);const answerHtml=Object.entries(answers).map(([key,value])=>`<div class="response-block"><h3>${esc(answerLabels[key]??key)}</h3><pre>${esc(value||'—')}</pre></div>`).join('');const meta=(label:string,value:unknown)=>`<div class="application-meta-item"><span>${esc(label)}</span><strong>${esc(value||'—')}</strong></div>`;const discordLabel=application.discord_oauth_connected_at?'OAuth同意済み・連携済み':application.verified_discord_user_id?'手動確認済み・ID登録済み':'未連携';return `<section class="application-profile" aria-label="応募者の基本情報"><div class="application-section-heading"><div><p>応募者情報</p><h3>基本プロフィール</h3></div><span>${esc(formLabels[application.project_slug]??application.project_slug??'学習サイト「アトラス」')}</span></div><div class="application-meta-grid">${meta('所属',`${application.affiliation_type||'未設定'}：${application.institution||'—'}`)}${meta('呼称（ニックネーム）',application.nickname)}${meta('所属先メール',application.affiliation_email)}${meta('学年',application.grade)}${meta('国・居住地',`${application.country||'—'} / ${application.residence_city||'都市未登録'}`)}${meta('生年月日',application.birth_date)}${meta('タイムゾーン',application.timezone)}${meta('Discord連携',discordLabel)}${meta('応募日時',formatDate(application.created_at))}</div></section><details class="application-original-fields"><summary>フォーム回答の詳細を開く</summary><div class="application-response-grid"><div class="response-block"><h3>知ったきっかけ</h3><pre>${esc(application.referral_source||'—')}</pre></div><div class="response-block"><h3>現在のサークル・学生団体</h3><pre>${esc(application.current_organizations||'—')}</pre></div><div class="response-block"><h3>参加理由</h3><pre>${esc(application.motivation_reasons||'—')}</pre></div><div class="response-block"><h3>希望担当</h3><pre>${esc(application.desired_roles||'—')}</pre></div><div class="response-block"><h3>面談候補日</h3><pre>${esc(application.interview_availability||'—')}</pre></div><div class="response-block"><h3>質問</h3><pre>${esc(application.applicant_questions||'—')}</pre></div>${answerHtml}</div></details>`};
    const actions=(application:any)=>{const accepted=application.status==='accepted';const state=application.provisioning_status||'not_started';const name=displayName(application);const attempt=Number(application.provisioning_attempt_count||0);const retryNote=state==='failed'&&application.provisioning_next_attempt_at?`（自動再試行 ${formatDate(application.provisioning_next_attempt_at)}）`:attempt?`（試行 ${attempt}回）`:'';return `<div class="actions"><div class="action-status"><span class="action-caption">参加環境</span><span class="badge" data-state="${esc(state)}">${esc(provisioningLabel[state]??state)}${esc(retryNote)}</span></div><label class="status-control"><span>応募状態</span><select data-id="${esc(application.id)}" aria-label="${esc(name)}の応募状態" ${accepted?'disabled':''}><option value="new" ${application.status==='new'?'selected':''}>新規</option><option value="reviewing" ${application.status==='reviewing'?'selected':''}>確認中</option><option value="accepted" ${accepted?'selected':''}>受入・オンボーディング開始</option><option value="rejected" ${application.status==='rejected'?'selected':''}>見送り</option></select></label>${accepted&&state!=='synced'?`<button type="button" data-retry="${esc(application.id)}">Discord情報を再確認</button>`:''}</div>`};
    let applications:any[]=[];
    let visibleApplications:any[]=[];
    let selectedApplicationId='';
    let pendingAcceptanceId='';
    const renderSummary=()=>{totalCount.textContent=`${applications.length}件`;for(const key of ['new','reviewing','accepted','rejected'])summary[key as keyof typeof summary].textContent=String(applications.filter(application=>application.status===key).length)};
    const matches=(application:any)=>{const query=search.value.trim().toLocaleLowerCase();const status=statusFilter.value;const haystack=[displayName(application),application.email,application.institution,application.desired_subjects,formLabels[application.project_slug]].join(' ').toLocaleLowerCase();return (!query||haystack.includes(query))&&(status==='all'||application.status===status)};
    const interviewFields=(application:any)=>{const interview=interviewFor(application);const mode=interview.mode??'online';return `<section class="interview-panel" data-mode="${esc(mode)}" aria-labelledby="interview-${esc(application.id)}-title"><div class="application-section-heading"><div><p>面談</p><h3 id="interview-${esc(application.id)}-title">面談情報</h3></div><span>${interview.notifiedAt?`通知済み：${esc(formatDate(interview.notifiedAt))}`:'応募者への通知は未送信'}</span></div><div class="interview-fields"><label>面談日時<input type="datetime-local" data-interview-date="${esc(application.id)}" value="${esc(formatDateTimeLocal(interview.scheduledAt))}" /></label><label>形式<select data-interview-format="${esc(application.id)}"><option value="online" ${mode==='online'?'selected':''}>オンライン（Zoom）</option><option value="in_person" ${mode==='in_person'?'selected':''}>対面</option></select></label><label class="interview-zoom-field">Zoomリンク<input type="url" inputmode="url" data-interview-zoom="${esc(application.id)}" value="${esc(interview.zoomUrl??'')}" placeholder="https://zoom.us/j/..." autocomplete="url" /></label><label class="interview-location-field">場所（対面）<input type="text" data-interview-location="${esc(application.id)}" value="${esc(interview.location??'')}" placeholder="建物名・部屋など" maxlength="500" /></label></div><div class="interview-actions"><button type="button" class="button" data-interview-save="${esc(application.id)}">面談情報を保存</button><button type="button" class="button button--quiet" data-interview-notify="${esc(application.id)}">${interview.notifiedAt?'面談情報を再通知':'応募者へ通知'}</button><a class="button button--quiet" href="/admin/application-interview/?application=${encodeURIComponent(application.id)}&project=${encodeURIComponent(projectSlug)}">面談メモを開く</a></div></section>`};
    const applicationCard=(application:any)=>{const name=displayName(application);const initial=String(name).trim().slice(0,1)||'？';const email=String(application.email||'');const projectLabel=formLabels[application.project_slug]??application.project_slug??'学習サイト「アトラス」';const subjectTags=String(application.desired_subjects||'').split(',').filter(Boolean).map(subject=>`<span>${esc(subjectLabels[subject]??subject)}</span>`).join('')||'<span>旧形式応募：未設定</span>';return `<article class="app" data-status="${esc(application.status)}" aria-labelledby="application-${esc(application.id)}-name"><div class="top"><div class="app-identity"><span class="app-avatar" aria-hidden="true">${esc(initial)}</span><div><p class="app-kicker">応募者情報</p><h2 id="application-${esc(application.id)}-name">${esc(name)}</h2>${email?`<a class="app-email" href="mailto:${encodeURIComponent(email)}">${esc(email)}</a>`:''}<p class="app-subline">${esc(formatDate(application.created_at))}</p><span class="app-project">${esc(projectLabel)}</span></div></div>${actions(application)}</div>${interviewFields(application)}${fields(application)}<section class="application-section application-section--subjects" aria-label="希望分野"><div class="application-section-heading"><p>希望分野</p><span>担当候補</span></div><div class="facts">${subjectTags}</div></section><section class="application-response-grid application-response-grid--main" aria-label="応募内容"><div class="response-block"><h3>書きたい記事・テーマ</h3><pre>${esc(application.article_ideas||'—')}</pre></div><div class="response-block"><h3>できること・関心</h3><pre>${esc(application.interests||'—')}</pre></div><div class="response-block response-block--wide"><h3>参加理由・自己紹介</h3><pre>${esc(application.message||'—')}</pre></div>${application.availability_note?`<div class="response-block"><h3>参加可能な時間帯</h3><pre>${esc(application.availability_note)}</pre></div>`:''}</section>${application.provisioning_error?`<p class="provisioning-error">${esc(application.provisioning_error)}</p>`:''}${application.status==='accepted'&&!application.verified_discord_user_id?'<a class="member-link" href="/applicant/">応募者画面から「Discordと連携」を案内する →</a>':''}</article>`};
    const applicationOptionLabel=(application:any)=>`${displayName(application)}｜${application.email||'メール未設定'}`;
    const renderNavigator=()=>{if(!visibleApplications.length){navigator.hidden=true;return}const selectedIndex=Math.max(0,visibleApplications.findIndex(application=>application.id===selectedApplicationId));const selected=visibleApplications[selectedIndex];selectedApplicationId=selected.id;applicationSelect.innerHTML=visibleApplications.map(application=>`<option value="${esc(application.id)}">${esc(applicationOptionLabel(application))}</option>`).join('');applicationSelect.value=selectedApplicationId;applicationPosition.textContent=`${selectedIndex+1} / ${visibleApplications.length}人`;previousApplication.disabled=selectedIndex===0;nextApplication.disabled=selectedIndex===visibleApplications.length-1;navigator.hidden=false};
    const render=(items:any[])=>{visibleApplications=items.filter(matches);if(!visibleApplications.some(application=>application.id===selectedApplicationId))selectedApplicationId=visibleApplications[0]?.id??'';renderNavigator();const selected=visibleApplications.find(application=>application.id===selectedApplicationId);list.innerHTML=selected?applicationCard(selected):'<p class="application-empty">条件に一致する応募はありません。</p>'};
    const refresh=()=>render(applications);
    const resetSelectionAndRefresh=()=>{selectedApplicationId='';refresh()};
    const load=async()=>{try{const response=await fetch(`/api/admin/applications?project=${encodeURIComponent(projectSlug)}`,{credentials:'same-origin'});const data=await response.json();if(!response.ok)throw Error(data.error??'読み込めませんでした。');subjectLabels=data.subjectLabels??{};formLabels=data.formLabels??{};applications=Array.isArray(data.applications)?data.applications:[];renderSummary();refresh()}catch{navigator.hidden=true;list.innerHTML='<p class="application-empty">応募データを読み込めませんでした。接続を確認して、ページを再読み込みしてください。</p>'}};
    search.addEventListener('input',resetSelectionAndRefresh);statusFilter.addEventListener('change',resetSelectionAndRefresh);clearFilter?.addEventListener('click',()=>{search.value='';statusFilter.value='all';resetSelectionAndRefresh()});
    applicationSelect.addEventListener('change',()=>{selectedApplicationId=applicationSelect.value;refresh()});
    previousApplication.addEventListener('click',()=>{const index=visibleApplications.findIndex(application=>application.id===selectedApplicationId);if(index>0){selectedApplicationId=visibleApplications[index-1].id;refresh()}});
    nextApplication.addEventListener('click',()=>{const index=visibleApplications.findIndex(application=>application.id===selectedApplicationId);if(index>=0&&index<visibleApplications.length-1){selectedApplicationId=visibleApplications[index+1].id;refresh()}});
    const update=async(id:string,status:string,button?:HTMLButtonElement)=>{button?.setAttribute('disabled','');setNotice(status==='accepted'?'受入を確定し、承認メールを送信する準備中…':'状態を更新中…');try{const response=await fetch(`/api/admin/applications/${encodeURIComponent(id)}?project=${encodeURIComponent(projectSlug)}`,{method:'PATCH',credentials:'same-origin',headers:{'content-type':'application/json'},body:JSON.stringify({status})});const data=await response.json().catch(()=>({}));if(!response.ok)throw Error(data.error??'更新できませんでした。');const warning=Array.isArray(data.provisioning?.warnings)?data.provisioning.warnings.join(' '):'';const emailMessage=status==='accepted'?(data.acceptanceEmailQueued?'応募者への受入承認メールを送信する準備ができました。':'受入は完了しましたが、承認メールを送信する準備に失敗しました。'):'';setNotice(warning?`受入は完了しました。${emailMessage} ${warning}`:status==='accepted'?`受入が完了しました。${emailMessage}`:'状態を更新しました。',Boolean(warning||status==='accepted'&&!data.acceptanceEmailQueued));await load()}catch(error){setNotice(error instanceof Error?error.message:'更新できませんでした。',true);await load()}finally{button?.removeAttribute('disabled')}};
    const retryDiscord=async(id:string,button:HTMLButtonElement)=>{button.setAttribute('disabled','');setNotice('Discord同期を再試行中…');try{const response=await fetch(`/api/admin/applications/${encodeURIComponent(id)}/discord-retry?project=${encodeURIComponent(projectSlug)}`,{method:'POST',credentials:'same-origin'});const data=await response.json().catch(()=>({}));if(!response.ok)throw Error(data.error??'Discord同期に失敗しました。');const warnings=Array.isArray(data.provisioning?.warnings)?data.provisioning.warnings.join(' '):'';setNotice(warnings?`Discord同期を再試行しました。${warnings}`:'Discord同期が完了しました。',Boolean(warnings));await load()}catch(error){setNotice(error instanceof Error?error.message:'Discord同期に失敗しました。',true);await load()}finally{button.removeAttribute('disabled')}};
    const interviewValues=(id:string)=>{const escapedId=CSS.escape(id);const date=root.querySelector<HTMLInputElement>(`[data-interview-date="${escapedId}"]`);const mode=root.querySelector<HTMLSelectElement>(`[data-interview-format="${escapedId}"]`);const zoom=root.querySelector<HTMLInputElement>(`[data-interview-zoom="${escapedId}"]`);const location=root.querySelector<HTMLInputElement>(`[data-interview-location="${escapedId}"]`);return {scheduledAt:date?.value?new Date(date.value).toISOString():null,timezone:Intl.DateTimeFormat().resolvedOptions().timeZone||'Asia/Tokyo',mode:mode?.value==='in_person'?'in_person':'online',zoomUrl:zoom?.value.trim()||'',location:location?.value.trim()||''}};
    const interviewRequest=async(id:string,action:'save'|'notify',button:HTMLButtonElement)=>{const values=interviewValues(id);if(action==='notify'&&!values.scheduledAt){setNotice('応募者へ通知する前に面談日時を設定してください。',true);return}if(values.mode==='online'){try{const url=new URL(values.zoomUrl);if(url.protocol!=='https:')throw Error()}catch{setNotice('オンライン面談にはHTTPSのZoomリンクを設定してください。',true);return}}if(values.mode==='in_person'&&!values.location){setNotice('対面面談の場所を入力してください。',true);return}button.setAttribute('aria-busy','true');button.setAttribute('disabled','');setNotice(action==='notify'?'面談情報を保存して応募者へ通知中…':'面談情報を保存中…');try{const saveResponse=await fetch(`/api/admin/applications/${encodeURIComponent(id)}/interview?project=${encodeURIComponent(projectSlug)}`,{method:'PUT',credentials:'same-origin',headers:{'content-type':'application/json'},body:JSON.stringify(values)});const saveData=await saveResponse.json().catch(()=>({}));if(!saveResponse.ok)throw Error(saveData.error??'面談情報を保存できませんでした。');if(action==='notify'){const notifyResponse=await fetch(`/api/admin/applications/${encodeURIComponent(id)}/interview/notify?project=${encodeURIComponent(projectSlug)}`,{method:'POST',credentials:'same-origin'});const notifyData=await notifyResponse.json().catch(()=>({}));if(!notifyResponse.ok)throw Error(notifyData.error??'面談通知を準備できませんでした。')}setNotice(action==='notify'?'面談情報を保存し、応募者へ通知しました。':'面談情報を保存しました。');await load()}catch(error){setNotice(error instanceof Error?error.message:'面談情報を保存できませんでした。',true)}finally{button.removeAttribute('aria-busy');button.removeAttribute('disabled')}};
    root.addEventListener('change',event=>{const select=(event.target as HTMLElement).closest<HTMLSelectElement>('[data-id]');if(!select)return;if(select.value==='accepted'){pendingAcceptanceId=select.dataset.id??'';acceptDialog.showModal();return}void update(select.dataset.id??'',select.value)});
    acceptCancel.addEventListener('click',()=>{pendingAcceptanceId='';acceptDialog.close();void load()});
    acceptConfirm.addEventListener('click',()=>{const id=pendingAcceptanceId;pendingAcceptanceId='';acceptDialog.close();if(id)void update(id,'accepted',acceptConfirm)});
    root.addEventListener('click',event=>{const target=event.target as HTMLElement;const retryButton=target.closest<HTMLButtonElement>('[data-retry]');if(retryButton){void retryDiscord(retryButton.dataset.retry??'',retryButton);return}const saveButton=target.closest<HTMLButtonElement>('[data-interview-save]');if(saveButton){void interviewRequest(saveButton.dataset.interviewSave??'','save',saveButton);return}const notifyButton=target.closest<HTMLButtonElement>('[data-interview-notify]');if(notifyButton)void interviewRequest(notifyButton.dataset.interviewNotify??'','notify',notifyButton)});
    root.addEventListener('change',event=>{const format=(event.target as HTMLElement).closest<HTMLSelectElement>('[data-interview-format]');if(!format)return;format.closest<HTMLElement>('.interview-panel')?.setAttribute('data-mode',format.value)});
    if(projectSlug) void load();
  }};
  document.addEventListener('astro:page-load',initializeApplications);
  initializeApplications();
</script>
