---
import AdminLayout from "../../layouts/AdminLayout.astro";
---
<AdminLayout title="運営参加応募" description="運営参加応募の確認">
  <main class="applications" data-applications>
    <header class="applications-header">
      <h1>運営参加応募</h1>
      <a class="application-form-link" href="/apply/">応募フォームへ →</a>
    </header>
    <section class="application-flow" aria-labelledby="application-flow-title">
      <div class="flow-heading"><div><p>参加手続き</p><h2 id="application-flow-title">応募から参加までの流れ</h2></div><span>各段階の確認内容を見ながら対応できます。</span></div>
      <ol class="flow-steps">
        <li><span class="flow-step-number">1</span><div><strong>応募内容を確認</strong><small>希望分野、書きたい記事、参加理由を確認します。</small></div></li>
        <li><span class="flow-step-number">2</span><div><strong>確認中に変更</strong><small>追加確認が必要な応募を確認中として整理します。</small></div></li>
        <li><span class="flow-step-number">3</span><div><strong>受入を確定</strong><small>プロジェクト参加を登録し、プロフィール入力を案内します。</small></div></li>
        <li><span class="flow-step-number">4</span><div><strong>参加環境を整える</strong><small>Discord連携を確認し、必要なら同期を再試行します。</small></div></li>
      </ol>
    </section>
    <section class="application-overview" aria-labelledby="application-list-title">
      <div class="section-heading"><div><p>応募状況</p><h2 id="application-list-title">応募一覧</h2></div><span data-total-count>—</span></div>
      <div class="summary-grid" aria-label="応募状況">
        <div class="summary-card summary-card--new"><strong data-summary-new>0</strong><span>新規</span></div>
        <div class="summary-card summary-card--reviewing"><strong data-summary-reviewing>0</strong><span>確認中</span></div>
        <div class="summary-card summary-card--accepted"><strong data-summary-accepted>0</strong><span>受入済み</span></div>
        <div class="summary-card summary-card--rejected"><strong data-summary-rejected>0</strong><span>見送り</span></div>
      </div>
      <div class="filter-bar" role="search">
        <label>検索<input type="search" data-search placeholder="名前・メール・所属で検索" /></label>
        <label>状態<select data-filter-status><option value="all">すべての状態</option><option value="new">新規</option><option value="reviewing">確認中</option><option value="accepted">受入済み</option><option value="rejected">見送り</option></select></label>
        <button type="button" class="button button--quiet" data-clear-filter>絞り込みを解除</button>
      </div>
    </section>
    <output class="notice" data-notice aria-live="polite"></output>
    <section class="application-navigator" data-application-navigator aria-label="応募者の切り替え" hidden>
      <button type="button" class="button button--quiet navigator-button" data-previous-application aria-label="前の応募者">← 前へ</button>
      <label class="application-picker">表示する応募者<select data-application-select aria-label="表示する応募者"></select></label>
      <span class="application-position" data-application-position aria-live="polite"></span>
      <button type="button" class="button button--quiet navigator-button" data-next-application aria-label="次の応募者">次へ →</button>
    </section>
    <div class="application-list" data-list>読み込み中…</div>
    <dialog class="accept-dialog" data-accept-dialog aria-labelledby="accept-dialog-title">
      <h2 id="accept-dialog-title">受入を確定しますか？</h2>
      <p>「はい」を押すと、プロジェクト参加を登録し、応募者本人へ受入承認メールを送信します。本人にはプロフィール入力も案内されます。管理権限は別途「運営者・担当管理」から付与してください。</p>
      <div class="accept-dialog__actions">
        <button type="button" class="button button--quiet" data-accept-cancel>いいえ、戻る</button>
        <button type="button" class="button" data-accept-confirm>はい、受入してメールを送る</button>
      </div>
    </dialog>
  </main>
</AdminLayout>
<style>
  .applications{margin:0 auto;max-width:1100px;padding:0 1.25rem 4rem}.applications header{border-bottom:1px solid var(--border-default);padding:2rem 0 1.2rem}.applications-header{align-items:center;display:flex;gap:1rem;justify-content:space-between}.applications header p{color:var(--accent-primary);font-size:.75rem;font-weight:800;letter-spacing:.08em;margin:0}.applications h1{font-size:2rem;margin:.3rem 0}.applications header span,.app small{color:var(--text-secondary)}.application-form-link{background:var(--accent-primary);color:#fff;font-size:.8rem;font-weight:800;padding:.7rem .9rem;text-decoration:none;white-space:nowrap}.application-form-link:hover{filter:brightness(.94);transform:translateY(-1px)}.application-flow{border:1px solid var(--border-default);margin-top:1.25rem;padding:1rem}.flow-heading{align-items:end;display:flex;gap:1rem;justify-content:space-between}.flow-heading p{color:var(--accent-primary);font-size:.72rem;font-weight:800;letter-spacing:.08em;margin:0 0 .3rem}.flow-heading h2{font-size:1.15rem;margin:0}.flow-heading>span{color:var(--text-secondary);font-size:.76rem}.flow-steps{display:grid;gap:.65rem;grid-template-columns:repeat(4,minmax(0,1fr));list-style:none;margin:.9rem 0 0;padding:0}.flow-steps li{background:var(--background-secondary);border-top:3px solid var(--accent-primary);display:flex;gap:.55rem;min-height:7rem;padding:.75rem}.flow-step-number{align-items:center;background:var(--accent-primary);border-radius:50%;color:#fff;display:flex;flex:0 0 1.55rem;font-size:.78rem;font-weight:900;height:1.55rem;justify-content:center;width:1.55rem}.flow-steps strong{display:block;font-size:.82rem;line-height:1.35}.flow-steps small{color:var(--text-secondary);display:block;font-size:.7rem;line-height:1.55;margin-top:.35rem}.notice{display:block;min-height:1.5rem;padding-top:.75rem}.notice[data-error="true"]{color:#b42318}.app{border:1px solid var(--border-default);display:grid;gap:.75rem;margin-top:1rem;padding:1rem}.top{align-items:center;display:flex;gap:1rem;justify-content:space-between}.top h2{font-size:1rem;margin:0}.actions{align-items:center;display:flex;flex-wrap:wrap;gap:.5rem}.actions select,.actions button{font:inherit;padding:.45rem .65rem}.actions button{background:var(--accent-primary);border:1px solid var(--accent-primary);color:#fff;cursor:pointer;font-weight:700}.actions button:disabled{cursor:wait;opacity:.55}.badge{border:1px solid var(--border-default);border-radius:999px;font-size:.72rem;font-weight:700;padding:.25rem .5rem}.badge[data-state="synced"]{background:#e8f7ed;border-color:#78bd8b;color:#176b32}.badge[data-state="failed"]{background:#fff1f0;border-color:#f2a6a0;color:#9f211b}.badge[data-state="skipped"]{background:#fff8e1;border-color:#dfbd65;color:#765600}.facts{display:flex;flex-wrap:wrap;gap:.35rem}.facts span{background:var(--background-secondary);border:1px solid var(--border-default);border-radius:999px;font-size:.75rem;padding:.25rem .45rem}.app h3{font-size:.82rem;margin:.25rem 0 0}.app pre{font:inherit;line-height:1.65;margin:0;white-space:pre-wrap}.provisioning-error{background:#fff7f6;border-left:3px solid #b42318;color:#7a271a;font-size:.78rem;margin:0;padding:.6rem;white-space:pre-wrap}.member-link{color:var(--accent-primary);font-size:.78rem;font-weight:700}@media(max-width:650px){.applications{padding:0 .85rem 3rem}.applications-header{align-items:flex-start;flex-direction:column}.application-form-link{align-self:stretch;text-align:center}.top{align-items:start;display:grid}.actions,.actions select,.actions button{width:100%}.flow-heading{align-items:start;display:grid}.flow-steps{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:420px){.flow-steps{grid-template-columns:1fr}}
  .application-overview{background:var(--background-secondary);border:1px solid var(--border-default);border-radius:.55rem;margin-top:1.25rem;padding:1rem}.section-heading{align-items:end;display:flex;justify-content:space-between}.section-heading p{color:var(--accent-primary);font-size:.72rem;font-weight:900;letter-spacing:.1em;margin:0 0 .35rem}.section-heading h2{font-size:1.15rem;margin:0}.section-heading>span{color:var(--text-secondary);font-size:.76rem}.summary-grid{display:grid;gap:.55rem;grid-template-columns:repeat(4,1fr);margin-top:.9rem}.summary-card{background:var(--background-primary);border:1px solid var(--border-default);border-left:3px solid var(--border-default);display:grid;gap:.12rem;padding:.65rem .75rem}.summary-card strong{font-size:1.35rem;line-height:1.1}.summary-card span{color:var(--text-secondary);font-size:.72rem;font-weight:700}.summary-card--new{border-left-color:#d97706}.summary-card--reviewing{border-left-color:#2563a5}.summary-card--accepted{border-left-color:#27834f}.summary-card--rejected{border-left-color:#9b5a5a}.filter-bar{align-items:end;display:grid;gap:.55rem;grid-template-columns:minmax(220px,1.5fr) minmax(150px,.65fr) auto;margin-top:.85rem}.filter-bar label{color:var(--text-secondary);display:grid;font-size:.72rem;font-weight:800;gap:.28rem}.filter-bar input,.filter-bar select{appearance:auto;background:var(--background-primary);border:1px solid var(--border-default);border-radius:.3rem;color:var(--text-primary);font:inherit;min-height:2.35rem;padding:.45rem .55rem;width:100%}.button{appearance:none;background:var(--accent-primary);border:1px solid var(--accent-primary);border-radius:.35rem;color:#fff;cursor:pointer;font:inherit;font-size:.78rem;font-weight:800;line-height:1.2;min-height:2.35rem;padding:.55rem .75rem;white-space:nowrap}.button--quiet{background:transparent;border:1px solid var(--border-default);color:var(--accent-primary)}.button--quiet:hover,.button--quiet:focus-visible{background:var(--background-primary);border-color:var(--accent-primary)}.application-list{display:grid;gap:.7rem}.application-empty{border:1px dashed var(--border-default);color:var(--text-secondary);padding:2.2rem 1rem;text-align:center}.application-list .app{margin-top:0}.accept-dialog{background:var(--background-primary);border:1px solid var(--border-default);color:var(--text-primary);max-width:34rem;padding:1.25rem}.accept-dialog::backdrop{background:rgb(0 0 0 / .55)}.accept-dialog h2{font-size:1.1rem;margin:0}.accept-dialog p{color:var(--text-secondary);font-size:.84rem;line-height:1.7}.accept-dialog__actions{display:flex;flex-wrap:wrap;gap:.55rem;justify-content:flex-end}@media(max-width:650px){.summary-grid{grid-template-columns:repeat(2,1fr)}.filter-bar{grid-template-columns:1fr}.filter-bar .button{justify-self:start}}
</style>
<style>
  .application-navigator{align-items:center;background:var(--background-secondary);border:1px solid var(--border-default);border-radius:.55rem;display:grid;gap:.65rem;grid-template-columns:auto minmax(12rem,1fr) auto auto;margin-top:.4rem;padding:.7rem}.application-navigator[hidden]{display:none}.application-picker{color:var(--text-secondary);display:grid;font-size:.7rem;font-weight:800;gap:.25rem}.application-picker select{background:var(--background-primary);border:1px solid var(--border-default);border-radius:.35rem;color:var(--text-primary);font:inherit;font-size:.8rem;min-height:2.35rem;padding:.45rem .55rem;width:100%}.navigator-button{min-width:5rem}.navigator-button:disabled{cursor:not-allowed;opacity:.45}.application-position{color:var(--text-secondary);font-size:.75rem;font-variant-numeric:tabular-nums;white-space:nowrap}@media(max-width:650px){.application-navigator{grid-template-columns:1fr 1fr}.application-picker{grid-column:1/-1;grid-row:1}.application-position{justify-self:center;grid-column:1/-1;grid-row:2}.navigator-button{width:100%;grid-row:3}.application-navigator .navigator-button:first-child{grid-column:1}.application-navigator .navigator-button:last-child{grid-column:2}}
  .application-list{margin-top:.75rem}.application-list .app{background:var(--background-secondary);border-radius:.7rem;box-shadow:0 .35rem 1.2rem rgb(0 0 0 / .08);padding:1.25rem}.application-list .app .top{border-bottom:1px solid var(--border-default);padding-bottom:.85rem}.application-list .app .top h2{font-size:1.15rem;line-height:1.4}.application-list .app h3{color:var(--accent-primary);font-size:.78rem;letter-spacing:.03em}.application-list .app pre{background:var(--background-primary);border-left:2px solid var(--border-default);border-radius:.25rem;padding:.55rem .7rem}.application-original-fields{background:var(--background-primary);border:1px solid var(--border-default);border-radius:.45rem;padding:.65rem .8rem}.application-original-fields summary{color:var(--accent-primary);cursor:pointer;font-size:.8rem;font-weight:800}.application-original-fields[open] summary{margin-bottom:.7rem}
