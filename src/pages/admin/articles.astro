<script>
  import { createAdminLoadRetry } from "../../scripts/admin-load-retry";
  import { readAdminApiJson } from "../../lib/admin-api";
  import { isTestArticleTitle } from "../../lib/article-test-classification";
  type Article={id:string;source_article_id?:string|null;subject:string;category:string;slug?:string;title:string;status:"draft"|"in-review"|"on-hold"|"approved";updated_at:string;published_at:string|null;scheduled_publish_at?:string|null;archived_at?:string|null;archive_expires_at?:string|null;created_by?:string;updated_by?:string;reviewer_email?:string|null;active_editors?:Array<{sessionId:string;email:string;displayName:string;field:string}>};
  type ArticleFilterState={query:string;subject:string;category:string;status:string;publication:string;test:string;workflow:string;archive:string};
  type ArticleScope={email:string;subjects?:string[];coordinatorSubjects?:string[];allSubjects?:boolean;isManager?:boolean;isProjectLeader?:boolean};
  type ArticlePagination={limit:number;nextCursor:string|null;hasMore:boolean};
  type PublicArticle={articleId:string;subject:string;category:string;slug:string;title:string};
  type PublicArticleCatalogEntry={locale?:unknown;public_status?:unknown;source_article_id?:unknown;subject?:unknown;category?:unknown;slug?:unknown;title?:unknown};
  type CatalogRow={article:Article;publicArticle?:PublicArticle};
  const initializeArticleIndex = () => {
    const root = document.querySelector<HTMLElement>("[data-article-index]");
    if (!root || root.dataset.ready === "true") return;
    root.dataset.ready = "true";
    const list = root.querySelector<HTMLElement>("[data-list]")!;
    const query = root.querySelector<HTMLInputElement>("[data-query]")!;
    const subject = root.querySelector<HTMLSelectElement>("[data-subject]")!;
    const category = root.querySelector<HTMLSelectElement>("[data-category]")!;
    const status = root.querySelector<HTMLSelectElement>("[data-status]")!;
    const publication = root.querySelector<HTMLSelectElement>("[data-public]")!;
    const test = root.querySelector<HTMLSelectElement>("[data-test]")!;
    const workflow = root.querySelector<HTMLSelectElement>("[data-workflow-filter]")!;
    const archive = root.querySelector<HTMLSelectElement>("[data-archive]")!;
    const count = root.querySelector<HTMLOutputElement>("[data-count]")!;
    const filterSummary = root.querySelector<HTMLElement>("[data-filter-summary]")!;
    const scopeNote = root.querySelector<HTMLElement>("[data-scope-note]")!;
    const resetFiltersButton = root.querySelector<HTMLButtonElement>("[data-reset-filters]")!;
    const subjectBrowser = root.querySelector<HTMLElement>("[data-subject-browser]")!;
    const subjectBrowserSummary = root.querySelector<HTMLElement>("[data-subject-browser-summary]");
    const subjectBrowserAll = root.querySelector<HTMLButtonElement>("[data-subject-browser-all]")!;
    const pagination = root.querySelector<HTMLElement>("[data-article-pagination]")!;
    const paginationStatus = root.querySelector<HTMLElement>("[data-article-pagination-status]")!;
    const loadMoreButton = root.querySelector<HTMLButtonElement>("[data-article-load-more]")!;
    const subjectOptions = [...subject.options].map((option) => ({ value: option.value, label: option.textContent ?? "", subjects: option.dataset.subjects }));
    const subjectNameBySlug = new Map(subjectOptions.filter((option) => option.value !== "all").map((option) => [option.value, option.label]));
    const categoryNameBySlug = new Map([...category.options].filter((option) => option.value !== "all").map((option) => [option.value, option.textContent ?? option.value]));
    let retry: ReturnType<typeof createAdminLoadRetry> | null = null;
    const catalogElement = root.querySelector<HTMLScriptElement>("[data-public-articles]");
    let publicArticles = catalogElement ? JSON.parse(catalogElement.textContent ?? "[]") as PublicArticle[] : [];
    let catalogReady = false;
    let items: Article[] = [];
    let subjectBrowserItems: Article[] = [];
    let scopeEmail = "";
    let nextCursor: string | null = null;
    let hasMore = false;
    let loadedPageCount = 0;
    let loadedSubject: string | null = null;
    let loadingAllSubject = false;
    let selectionLoadVersion = 0;
    const expandedArticleGroups = new Set<string>();
    const filterStorageKey = "atlasez-admin-article-filters";
    const defaultFilterState: ArticleFilterState = { query: "", subject: "all", category: "all", status: "all", publication: "all", test: "exclude", workflow: "all", archive: "active" };

    const requestedMode = new URLSearchParams(location.search).get("mode");
    const readStoredFilters = (): Partial<ArticleFilterState> => {
      try {
        const raw = localStorage.getItem(filterStorageKey);
        if (!raw) return {};
        const parsed = JSON.parse(raw) as unknown;
        if (!parsed || typeof parsed !== "object") return {};
        return parsed as Partial<ArticleFilterState>;
      } catch {
        return {};
      }
    };
    const storedFilters = readStoredFilters();
    const assignSelectValue = (element: HTMLSelectElement, value: unknown, fallback: string) => {
      const next = typeof value === "string" && [...element.options].some((option) => option.value === value) ? value : fallback;
      element.value = next;
    };
    query.value = typeof storedFilters.query === "string" ? storedFilters.query : defaultFilterState.query;
    assignSelectValue(subject, storedFilters.subject, defaultFilterState.subject);
    assignSelectValue(category, storedFilters.category, defaultFilterState.category);
    assignSelectValue(status, storedFilters.status, defaultFilterState.status);
    assignSelectValue(publication, storedFilters.publication, defaultFilterState.publication);
    assignSelectValue(test, storedFilters.test, defaultFilterState.test);
    assignSelectValue(workflow, requestedMode === "review" || requestedMode === "revise" || requestedMode === "request" ? requestedMode : storedFilters.workflow, defaultFilterState.workflow);
    assignSelectValue(archive, storedFilters.archive, defaultFilterState.archive);
    if (requestedMode === "review" || requestedMode === "revise" || requestedMode === "request") workflow.value = requestedMode;
    const esc = (value: string) => value.replace(/[&<>"']/g, (character) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[character] ?? character));
    const labels = { draft: "下書き", "in-review": "フィードバック中", "on-hold": "保留", approved: "フィードバック済み" };
    const assignedToScope = (article: Article) => article.reviewer_email?.split(",").some((email) => email.trim().toLowerCase() === scopeEmail.toLowerCase()) ?? false;
    const activeEditorFieldLabels: Record<string, string> = { title: "タイトル", summary: "要約", body: "本文" };
    const activeEditorsFor = (article: Article) => (article.active_editors ?? []).filter((editor) => editor && typeof editor.displayName === "string");
    const activeEditorLabel = (editor: { displayName: string; email: string; field: string }) => {
      const name = editor.displayName.trim() || editor.email.split("@")[0] || "メンバー";
      const field = activeEditorFieldLabels[editor.field];
      return `${name}${field ? `（${field}）` : ""}`;
    };
    const activeEditorSummary = (article: Article) => {
      const editors = activeEditorsFor(article);
      if (!editors.length) return "";
      const labels = editors.slice(0, 3).map(activeEditorLabel);
      if (editors.length > labels.length) labels.push(`ほか${editors.length - labels.length}人`);
      return `編集中：${labels.join("、")}`;
    };
    const currentWorkflow = () => workflow.value as "all" | "revise" | "review" | "request";
    const isArchived = (article: Article) => Boolean(article.archived_at);
    const archiveExpired = (article: Article) => Boolean(article.archive_expires_at && Date.parse(article.archive_expires_at) <= Date.now());
    const updateCategoryOptions = () => {
      const selectedSubject = subject.value;
      const selectedCategory = category.value;
      for (const option of category.options) {
        if (option.value === "all") {
          option.hidden = false;
          continue;
        }
        const subjectsForCategory = option.dataset.subjects?.split(",") ?? [];
        option.hidden = selectedSubject !== "all" && !subjectsForCategory.includes(selectedSubject);
      }
      if (selectedCategory !== "all" && category.selectedOptions[0]?.hidden) category.value = "all";
    };
    const saveFilterState = () => {
      const state: ArticleFilterState = {
        query: query.value,
        subject: subject.value,
        category: category.value,
        status: status.value,
        publication: publication.value,
        test: test.value,
        workflow: workflow.value,
        archive: archive.value,
      };
      try {
        localStorage.setItem(filterStorageKey, JSON.stringify(state));
      } catch {
        // プライベートブラウジングなどで保存できない場合も一覧操作は継続する。
      }
    };
    const applySubjectScope = (scope: ArticleScope) => {
      scopeNote.dataset.state = "ready";
      const directSubjects = Array.isArray(scope.subjects) ? scope.subjects.filter((value) => typeof value === "string" && value && value !== "*") : [];
      const coordinatorSubjects = Array.isArray(scope.coordinatorSubjects) ? scope.coordinatorSubjects.filter((value) => typeof value === "string" && value && value !== "*") : [];
      const unrestricted = Boolean(scope.allSubjects || scope.isManager || scope.isProjectLeader || (scope.subjects === undefined && scope.coordinatorSubjects === undefined));
      const subjectLabels = new Map(subjectOptions.map((option) => [option.value, option.label]));
      const requestedSubject = subject.value;
      if (unrestricted) {
        subject.replaceChildren(...subjectOptions.map((option) => new Option(option.value === "all" ? "すべての分野（全権限）" : option.label, option.value)));
        subject.value = subjectOptions.some((option) => option.value === requestedSubject) ? requestedSubject : "all";
        subject.disabled = false;
        subject.removeAttribute("aria-busy");
        scopeNote.textContent = "担当範囲：全分野（管理権限）";
        return;
      }
      const allowedSubjects = new Set([...directSubjects, ...coordinatorSubjects]);
      const scopedValues = [...allowedSubjects].filter((value) => subjectLabels.has(value));
      const scopedOptions = scopedValues.map((value) => new Option(subjectLabels.get(value) ?? value, value));
      const outOfScopeOptions = subjectOptions.filter((option) => option.value !== "all" && !allowedSubjects.has(option.value)).map((option) => new Option(option.label, option.value));
      subject.replaceChildren(new Option(scopedOptions.length ? "すべての分野" : "担当分野がありません", "all"), ...scopedOptions, ...outOfScopeOptions);
      for (const option of subject.options) {
        const allowed = option.value === "all" || allowedSubjects.has(option.value);
        option.hidden = !allowed;
        option.disabled = !allowed;
      }
      subject.disabled = false;
      subject.removeAttribute("aria-busy");
      subject.value = allowedSubjects.has(requestedSubject) ? requestedSubject : "all";
      const scopeNames = scopedOptions.map((option) => option.textContent ?? option.value);
      scopeNote.textContent = scopeNames.length ? `担当範囲：${scopeNames.join("、")}（${scopeNames.length}分野）` : "担当範囲：担当分野が登録されていません";
      if (subject.value !== "all" && !allowedSubjects.has(subject.value)) {
        subject.value = "all";
        category.value = "all";
      }
      updateCategoryOptions();
      saveFilterState();
    };
    const updateWorkflowButtons = () => root.querySelectorAll<HTMLButtonElement>("[data-workflow-action]").forEach((button) => button.setAttribute("aria-pressed", String(button.dataset.workflowAction === currentWorkflow())));
    const publicArticleKey = (article: PublicArticle) => `${article.subject}/${article.category}/${article.slug}`;
    const catalogRows = (sourceItems: Article[] = items): CatalogRow[] => {
      return sourceItems.map((article) => {
        const pathMatch = publicArticles.find((source) => publicArticleKey(source) === `${article.subject}/${article.category}/${article.slug}`);
        const publicArticle = pathMatch && (!article.source_article_id || article.source_article_id === pathMatch.articleId) ? pathMatch : undefined;
        return { article, publicArticle };
      });
    };
    const rowTitle = (row: CatalogRow) => row.article.title;
    const rowSubject = (row: CatalogRow) => row.article.subject;
    const rowCategory = (row: CatalogRow) => row.article.category;
    const rowUpdatedAt = (row: CatalogRow) => row.article.updated_at;
    const subjectDisplayName = (slug: string) => subjectNameBySlug.get(slug) ?? slug.replaceAll("-", " ");
    const categoryDisplayName = (slug: string) => categoryNameBySlug.get(slug) ?? slug.replaceAll("-", " ");
    const renderSubjectBrowser = (matchingAllSubjects: CatalogRow[]) => {
      const counts = new Map<string, CatalogRow[]>();
      for (const row of matchingAllSubjects) counts.set(rowSubject(row), [...(counts.get(rowSubject(row)) ?? []), row]);
      const options = [...subject.options].filter((option) => option.value !== "all" && !option.hidden && !option.disabled);
      const renderButton = (value: string, label: string, rows: CatalogRow[]) => {
        const empty = rows.length === 0;
        return `<button type="button" class="subject-browser__item${empty ? " subject-browser__item--empty" : ""}" data-subject-quick="${esc(value)}" aria-pressed="${String(subject.value === value)}" aria-label="${esc(label)}（${rows.length}件）"><strong>${esc(label)}</strong><small>${rows.length}件</small></button>`;
      };
      subjectBrowser.innerHTML = options.map((option) => renderButton(option.value, option.textContent ?? option.value, counts.get(option.value) ?? [])).join("");
      if (subjectBrowserSummary) {
        const hasAllSubjects = options.length === subjectOptions.filter((option) => option.value !== "all").length;
        subjectBrowserSummary.textContent = hasAllSubjects
          ? `全${options.length}分野・0件の分野も表示`
          : `担当分野 ${options.length}分野・0件も表示`;
      }
      subjectBrowserAll.hidden = subject.value === "all";
    };
    const hasUnpublishedPublicationChanges = (article: Pick<Article, "published_at" | "updated_at">) => {
      if (!article.published_at) return false;
      const updatedAt = Date.parse(article.updated_at);
      const publishedAt = Date.parse(article.published_at);
      return Number.isFinite(updatedAt) && Number.isFinite(publishedAt) && updatedAt > publishedAt;
    };
    const render = () => {
      list.classList.remove("loading-state", "error-state");
      saveFilterState();
      const mode = currentWorkflow();
      const normalizedQuery = query.value.toLowerCase();
      const rows = catalogRows();
      const matchesFilters = (row: CatalogRow, ignoreSelectedSubject = false) => {
        const article = row.article;
        if (archive.value === "active" && isArchived(article)) return false;
        if (archive.value === "archived" && !isArchived(article)) return false;
        if (mode === "review" && article.status === "approved") return false;
        if (mode === "request" && !([article.created_by, article.updated_by].includes(scopeEmail) && article.status !== "approved" && !article.published_at)) return false;
        if (!ignoreSelectedSubject && subject.value !== "all" && rowSubject(row) !== subject.value) return false;
        if (category.value !== "all" && rowCategory(row) !== category.value) return false;
        if (status.value !== "all" && article.status !== status.value) return false;
        if (publication.value === "published" && !(row.publicArticle || article.published_at)) return false;
        if (publication.value === "scheduled" && (row.publicArticle || article.published_at || !article.scheduled_publish_at)) return false;
        if (publication.value === "unpublished" && (row.publicArticle || article.published_at || article.scheduled_publish_at)) return false;
        const testMatch = isTestArticleTitle(rowTitle(row));
        if (test.value === "only" && !testMatch) return false;
        if (test.value === "exclude" && testMatch) return false;
        return `${rowTitle(row)} ${rowSubject(row)} ${rowCategory(row)}`.toLowerCase().includes(normalizedQuery);
      };
      const filtered = rows.filter((row) => matchesFilters(row));
      const matchingAllSubjects = catalogRows(subjectBrowserItems).filter((row) => matchesFilters(row, true));
      const sorted = [...filtered].sort((left, right) => {
        const leftArticle = left.article;
        const rightArticle = right.article;
        const leftPriority = (mode === "revise" || mode === "request") && [leftArticle.created_by, leftArticle.updated_by].includes(scopeEmail) ? 0 : mode === "review" && assignedToScope(leftArticle) ? 0 : 1;
        const rightPriority = (mode === "revise" || mode === "request") && [rightArticle.created_by, rightArticle.updated_by].includes(scopeEmail) ? 0 : mode === "review" && assignedToScope(rightArticle) ? 0 : 1;
        return leftPriority - rightPriority || new Date(rowUpdatedAt(right)).getTime() - new Date(rowUpdatedAt(left)).getTime();
      });
      const uniqueRows = (candidates: CatalogRow[]) => [...new Map(candidates.map((row) => [row.article.source_article_id || row.article.id, row])).values()];
      const shown = uniqueRows(sorted);
      const matchingAllSubjectsShown = uniqueRows(matchingAllSubjects);
      count.textContent = `${shown.length}件`;
      const activeScope = subject.value === "all" ? "全分野" : subjectDisplayName(subject.value);
      const activeCategory = category.value === "all" ? "" : ` › ${categoryDisplayName(category.value)}`;
      const activeStatus = status.value === "all" ? "" : ` ・ 編集状況：${labels[status.value as keyof typeof labels] ?? status.value}`;
      const activePublication = publication.value === "all" ? "" : ` ・ 学習サイト：${publication.selectedOptions[0]?.textContent ?? publication.value}`;
      const activeTest = test.value === "exclude" ? "" : ` ・ テスト原稿：${test.selectedOptions[0]?.textContent ?? test.value}`;
      const activeWorkflow = mode === "all" ? "" : ` ・ 作業対象：${workflow.selectedOptions[0]?.textContent ?? workflow.value}`;
      const activeArchive = archive.value === "active" ? "" : ` ・ ${archive.selectedOptions[0]?.textContent ?? archive.value}`;
      const activeQuery = query.value.trim() ? ` ・ キーワード：「${query.value.trim()}」` : "";
      filterSummary.textContent = `${activeScope}${activeCategory}${activeStatus}${activePublication}${activeTest}${activeWorkflow}${activeArchive}${activeQuery}`;
      renderSubjectBrowser(matchingAllSubjectsShown);
      const formatDate = (value: string) => new Intl.DateTimeFormat("ja-JP", { dateStyle: "medium" }).format(new Date(value));
      const formatSchedule = (value: string) => {
        const instant = new Date(value);
        if (!Number.isFinite(instant.getTime())) return "日時未設定";
        return new Intl.DateTimeFormat("ja-JP", { year: "numeric", month: "2-digit", day: "2-digit", hour: "2-digit", minute: "2-digit", hourCycle: "h23", timeZone: "Asia/Tokyo" }).format(instant);
      };
      const renderRow = (row: CatalogRow) => {
        const article = row.article;
        const title = rowTitle(row);
        const editedAt = formatDate(rowUpdatedAt(row));
        const publicState = row.publicArticle
          ? '<span class="badge public-live">公開中</span>'
          : article.published_at
            ? '<span class="badge public-live">公開中</span>'
            : article.scheduled_publish_at
              ? `<span class="badge public-scheduled">公開予約・${esc(formatSchedule(article.scheduled_publish_at))}</span>`
              : '<span class="badge public-draft">未公開</span>';
        const editorialState = `<span class="article-status-group"><span class="article-status-group__label">編集</span><span class="badge ${article.status}">${labels[article.status]}</span></span>`;
        const updatedLabel = "最終更新";
        const archiveBadge = article && isArchived(article) ? '<span class="badge archived">アーカイブ済み</span>' : "";
        const testBadge = isTestArticleTitle(title) ? '<span class="badge">テスト原稿</span>' : "";
        const updateInProgress = Boolean(article.published_at && hasUnpublishedPublicationChanges(article));
        const updateActionLabel = updateInProgress ? "更新案作成中" : "更新案を作成";
        const updateAction = article.published_at
          ? `<a class="proposal-action" href="/admin/editor/?document=${encodeURIComponent(article.id)}&mode=update&from=articles" aria-label="${esc(title || "無題の記事")}の${updateActionLabel}" data-update-proposal-state="${updateInProgress ? "in-progress" : "available"}">${updateActionLabel}</a>`
          : "";
        const archiveAction = article && article.status === "draft" && !article.published_at
          ? isArchived(article)
            ? archiveExpired(article)
              ? '<button type="button" class="article-action" disabled title="アーカイブ期限を過ぎています">期限切れ</button>'
              : `<button type="button" class="article-action" data-archive-action="unarchive" data-archive-document-id="${esc(article.id)}">復元</button>`
            : `<button type="button" class="article-action" data-archive-action="archive" data-archive-document-id="${esc(article.id)}">アーカイブ</button>`
          : "";
        const editingSummary = activeEditorSummary(article);
        const editingBadge = activeEditorsFor(article).length
          ? `<span class="badge editing" aria-label="${activeEditorsFor(article).length}人が編集中">● ${activeEditorsFor(article).length}人が編集中</span>`
          : "";
        const statusMarkup = `<div class="article-statuses">${editorialState}<span class="article-status-group"><span class="article-status-group__label">学習サイト</span>${publicState}</span>${editingBadge}${archiveBadge}${testBadge}</div>`;
        const presenceMarkup = editingSummary
          ? `<span class="article-presence" data-active-editors="${esc(article.id)}"><span class="presence-dot" aria-hidden="true"></span>${esc(editingSummary)}</span>`
          : "";
        const clickAttributes = ` role="link" tabindex="0" data-document-id="${esc(article.id)}" data-href="/admin/editor/?document=${encodeURIComponent(article.id)}"`;
        return `<article class="article"${clickAttributes} aria-label="${esc(title)}"><div class="article-main"><div class="article-identity"><h2>${esc(title || "無題の原稿")}</h2><p class="article-meta"><span class="article-meta__updated">${updatedLabel} ${editedAt}</span></p></div>${statusMarkup}${presenceMarkup}</div><div class="article-actions">${archiveAction}${updateAction}</div></article>`;
      };
      if (shown.length) {
        const groups = new Map<string, { subject: string; category: string; rows: CatalogRow[] }>();
        for (const row of shown) {
          const key = `${rowSubject(row)}/${rowCategory(row)}`;
          const group = groups.get(key) ?? { subject: rowSubject(row), category: rowCategory(row), rows: [] };
          group.rows.push(row);
          groups.set(key, group);
        }
        const orderedGroups = [...groups.entries()].sort(([, left], [, right]) => right.rows.length - left.rows.length || categoryDisplayName(left.category).localeCompare(categoryDisplayName(right.category), "ja"));
        const groupMarkup = orderedGroups.map(([key, group], index) => {
          const showAllRows = subject.value !== "all";
          const expanded = showAllRows || expandedArticleGroups.has(key);
          const remaining = Math.max(0, group.rows.length - 4);
          const categoryLabel = subject.value === "all"
            ? `${subjectDisplayName(group.subject)} › ${categoryDisplayName(group.category)}`
            : categoryDisplayName(group.category);
          const visibleRows = expanded ? group.rows : group.rows.slice(0, 4);
          const moreButton = !showAllRows && remaining
            ? `<button type="button" class="article-group__more" data-expand-category="${esc(key)}" aria-expanded="${String(expanded)}" aria-controls="article-group-items-${index}">${expanded ? "先頭4件に戻す" : `残り${remaining}件を表示`}　${expanded ? "⌃" : "⌄"}</button>`
            : "";
          return `<section class="article-group"><h3 class="article-group__heading"><span class="article-group__caret" aria-hidden="true">▼</span><strong>${esc(categoryLabel)}</strong><small>${group.rows.length}件</small></h3><div class="article-group__items" id="article-group-items-${index}">${visibleRows.map(renderRow).join("")}</div>${moreButton}</section>`;
        }).join("");
        list.innerHTML = `<header class="article-list__heading"><h2>${esc(activeScope)}</h2><span>${shown.length}件</span><small>${orderedGroups.length}カテゴリ</small></header>${groupMarkup}`;
      } else {
        list.innerHTML = `<header class="article-list__heading"><h2>${esc(activeScope)}</h2><span>0件</span><small>0カテゴリ</small></header><div class="article-empty"><strong>条件に一致する原稿はありません。</strong><span>条件をリセットするか、別の分野を選んでください。</span></div>`;
      }
      pagination.hidden = !hasMore && !loadingAllSubject;
      paginationStatus.textContent = loadingAllSubject
        ? `${items.length}件を読み込み中…`
        : loadedPageCount ? `${items.length}件を読み込み済み${hasMore ? "・続きがあります" : "・すべて読み込み済み"}` : "";
      loadMoreButton.hidden = loadingAllSubject;
      loadMoreButton.disabled = loadingAllSubject;
      updateWorkflowButtons();
    };
    const normalizeCatalog = (raw: unknown): PublicArticle[] | null => {
      if (!Array.isArray(raw)) return null;
      return raw.flatMap((item) => {
        if (!item || typeof item !== "object") return [];
        const entry = item as PublicArticleCatalogEntry;
        const locale = typeof entry.locale === "string" ? entry.locale : "";
        const publicStatus = typeof entry.public_status === "string" ? entry.public_status : "";
        const articleId = typeof entry.source_article_id === "string" ? entry.source_article_id : "";
        const subject = typeof entry.subject === "string" ? entry.subject : "";
        const category = typeof entry.category === "string" ? entry.category : "";
        const slug = typeof entry.slug === "string" ? entry.slug : "";
        const title = typeof entry.title === "string" ? entry.title : "";
        if (locale !== "ja" || publicStatus !== "published" || !articleId || !subject || !category || !slug || !title) return [];
        return [{ articleId, subject, category, slug, title }];
      });
    };
    const loadCatalog = async (abortSignal?: AbortSignal) => {
      try {
        const timeoutSignal = AbortSignal.timeout(10000);
        const signal = abortSignal ? AbortSignal.any([abortSignal, timeoutSignal]) : timeoutSignal;
        const response = await fetch("/api/admin/editor/catalog", { credentials: "same-origin", cache: "no-store", signal });
        const contentType = response.headers.get("content-type") ?? "";
        const data = contentType.includes("application/json") ? await response.json() as { catalog?: unknown[]; error?: string } : {};
        if (!response.ok) throw new Error(data.error ?? `公開記事カタログを取得できませんでした（${response.status}）。`);
        const normalized = normalizeCatalog(data.catalog);
        if (!normalized) throw new Error("公開記事カタログの形式を確認できませんでした。");
        publicArticles = normalized;
      } catch (error) {
        if (abortSignal?.aborted) throw error;
        // API障害時は古い公開カタログを混ぜず、原稿側の公開状態を表示する。
        publicArticles = [];
        console.warn("published article catalog unavailable", error);
      } finally {
        if (!abortSignal?.aborted) catalogReady = true;
      }
    };
    let loadRequest: Promise<void> | null = null;
    let activeLoadController: AbortController | null = null;
    let disposed = false;
    let loadingFallbackTimer: number | null = null;
    type LoadOptions = { silent?: boolean; preserveLoadedPages?: boolean; loadAllForSelectedSubject?: boolean };
    const load = (append = false, options: LoadOptions = {}) => {
      // pageshow and visibility events can arrive together on a cold load.
      // Share the in-flight request so the same list is not fetched twice.
      if (disposed || loadRequest) return loadRequest ?? Promise.resolve();
      const silent = Boolean(options.silent);
      const preserveLoadedPages = Boolean(options.preserveLoadedPages && silent && !append && (loadedPageCount > 1 || loadedSubject === subject.value));
      const selectedSubject = subject.value === "all" ? null : subject.value;
      let querySubject = selectedSubject;
      let completeSubject = Boolean(options.loadAllForSelectedSubject && selectedSubject);
      let pageCursor = append ? nextCursor : null;
      let pageIndex = 0;
      let scopeResolved = false;
      let catalogPromise: Promise<void> = Promise.resolve();
      const controller = new AbortController();
      activeLoadController = controller;
      const request = (async () => {
        try {
          if (!silent) retry?.begin();
          if (!append && !silent) list.classList.add("loading-state");
          if (!append && !silent) {
            subject.disabled = true;
            subject.setAttribute("aria-busy", "true");
            scopeNote.dataset.state = "loading";
            scopeNote.textContent = "担当範囲を確認しています…";
          }
          const includeArchived = archive.value !== "active";
          if (!append && !preserveLoadedPages) {
            nextCursor = null;
            hasMore = false;
            loadedPageCount = 0;
            loadedSubject = null;
            if (!silent) items = [];
          }
          if (completeSubject) loadingAllSubject = true;
          while (true) {
            const params = new URLSearchParams();
            if (includeArchived) params.set("includeArchived", "1");
            if (querySubject) params.set("subject", querySubject);
            if (pageCursor) params.set("cursor", pageCursor);
            if (append) params.set("limit", "50");
            else if (completeSubject) params.set("limit", "100");
            const queryString = params.toString();
            const endpoint = queryString ? `/api/admin/editor/documents?${queryString}` : "/api/admin/editor/documents";
            const response = await fetch(endpoint, { credentials: "same-origin", cache: "no-store", signal: controller.signal });
            const data = await readAdminApiJson<{ documents?: Article[]; scope?: ArticleScope; pagination?: ArticlePagination; error?: string }>(response, "原稿一覧を読み込めませんでした。");
            if (!response.ok) throw Error(data.error ?? `原稿一覧の読み込みに失敗しました。（HTTP ${response.status}）`);
            if (!data.scope) throw new Error("ログイン状態または担当範囲を確認できません。ログインを確認して再試行してください。");
            if (!scopeResolved) {
              scopeEmail = data.scope.email ?? "";
              applySubjectScope(data.scope);
              scopeResolved = true;
              catalogPromise = catalogReady ? Promise.resolve() : loadCatalog(controller.signal);
              // A remembered subject can become unavailable after permissions
              // change. Fall back to the ordinary first page in that case.
              if (querySubject && subject.value !== querySubject) {
                querySubject = null;
                completeSubject = false;
                pageCursor = null;
                pageIndex = 0;
                nextCursor = null;
                hasMore = false;
                loadedPageCount = 0;
                loadedSubject = null;
                items = [];
                loadingAllSubject = false;
                continue;
              }
            }
            const pageDocuments = data.documents ?? [];
            if (!querySubject && !append && !preserveLoadedPages) {
              subjectBrowserItems = pageDocuments;
            } else {
              const knownItems = new Map(subjectBrowserItems.map((article) => [article.id, article]));
              for (const article of pageDocuments) knownItems.set(article.id, article);
              subjectBrowserItems = [...knownItems.values()];
            }
            const pageHasMore = Boolean(data.pagination?.hasMore);
            const nextPageCursor = data.pagination?.nextCursor ?? null;
            if (append) {
              items = [...items, ...pageDocuments];
              nextCursor = nextPageCursor;
              hasMore = pageHasMore;
              loadedPageCount += 1;
            } else if (preserveLoadedPages && pageIndex === 0) {
              const refreshedIds = new Set(pageDocuments.map((article) => article.id));
              items = [...pageDocuments, ...items.filter((article) => !refreshedIds.has(article.id))];
            } else if (pageIndex === 0) {
              items = pageDocuments;
              nextCursor = nextPageCursor;
              hasMore = pageHasMore;
              loadedPageCount = 1;
            } else {
              items = [...items, ...pageDocuments];
              nextCursor = nextPageCursor;
              hasMore = pageHasMore;
              loadedPageCount += 1;
            }
            // Render the editorial rows immediately; catalog enrichment must
            // not block the first useful screen or subsequent page requests.
            render();
            if (!completeSubject) break;
            if (!pageHasMore) break;
            if (!nextPageCursor || nextPageCursor === pageCursor) throw new Error("続きの原稿を読み込めませんでした。再試行してください。");
            pageCursor = nextPageCursor;
            pageIndex += 1;
          }
          loadingAllSubject = false;
          loadedSubject = completeSubject ? querySubject : null;
          if (completeSubject) {
            nextCursor = null;
            hasMore = false;
          }
          await catalogPromise;
          render();
          if (!silent) retry?.success();
        } catch (error) {
          if (disposed || controller.signal.aborted || silent) return;
          loadingAllSubject = false;
          list.classList.remove("loading-state");
          list.classList.add("error-state");
          list.textContent = error instanceof Error ? error.message : "原稿一覧を取得できませんでした。";
          pagination.hidden = !hasMore;
          loadMoreButton.hidden = false;
          loadMoreButton.disabled = false;
          if (!append && !scopeResolved) {
            subject.disabled = true;
            subject.removeAttribute("aria-busy");
            scopeNote.dataset.state = "error";
            scopeNote.textContent = "担当範囲を確認できませんでした。原稿一覧を再試行してください。";
          }
          retry?.fail(error);
        } finally {
          if (activeLoadController === controller) activeLoadController = null;
        }
      })();
      const wrapped = request.finally(() => { if (loadRequest === wrapped) loadRequest = null; });
      loadRequest = wrapped;
      return wrapped;
    };
    const reloadForSelection = async () => {
      const version = ++selectionLoadVersion;
      activeLoadController?.abort();
      const selectedSubject = subject.value;
      const loadAllForSubject = selectedSubject !== "all";
      loadingAllSubject = loadAllForSubject;
      items = [];
      nextCursor = null;
      hasMore = false;
      loadedPageCount = 0;
      loadedSubject = null;
      list.classList.remove("error-state");
      list.classList.add("loading-state");
      list.textContent = loadAllForSubject ? "選択した分野の記事をすべて読み込んでいます…" : "原稿一覧を取得しています…";
      pagination.hidden = !loadAllForSubject;
      paginationStatus.textContent = loadAllForSubject ? "0件を読み込み中…" : "";
      loadMoreButton.hidden = loadAllForSubject;
      loadMoreButton.disabled = loadAllForSubject;
      const pendingRequest = loadRequest;
      if (pendingRequest) await pendingRequest;
      if (disposed || version !== selectionLoadVersion) return;
      return load(false, { loadAllForSelectedSubject: subject.value !== "all" });
    };
    retry = createAdminLoadRetry(root, () => reloadForSelection(), "原稿一覧を読み込めませんでした。");
    resetFiltersButton.addEventListener("click", () => {
      const previousSubject = subject.value;
      const previousArchive = archive.value;
      query.value = defaultFilterState.query;
      assignSelectValue(subject, defaultFilterState.subject, defaultFilterState.subject);
      assignSelectValue(category, defaultFilterState.category, defaultFilterState.category);
      assignSelectValue(status, defaultFilterState.status, defaultFilterState.status);
      assignSelectValue(publication, defaultFilterState.publication, defaultFilterState.publication);
      assignSelectValue(test, defaultFilterState.test, defaultFilterState.test);
      assignSelectValue(workflow, defaultFilterState.workflow, defaultFilterState.workflow);
      assignSelectValue(archive, defaultFilterState.archive, defaultFilterState.archive);
      expandedArticleGroups.clear();
      root.querySelector<HTMLDetailsElement>(".advanced-filters")!.open = false;
      updateCategoryOptions();
      saveFilterState();
      history.replaceState({}, "", `${location.pathname}#article-list`);
      if (previousSubject !== subject.value || previousArchive !== archive.value) void reloadForSelection();
      else render();
    });
    const selectSubjectFromBrowser = (value: string) => {
      if (![...subject.options].some((option) => option.value === value && !option.disabled && !option.hidden)) return;
      if (subject.value !== value) expandedArticleGroups.clear();
      subject.value = value;
      if (value !== "all") category.value = "all";
      updateCategoryOptions();
      saveFilterState();
      void reloadForSelection();
      root.querySelector("#article-list")?.scrollIntoView({ behavior: "smooth", block: "start" });
    };
    subjectBrowser.addEventListener("click", (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-subject-quick]");
      if (!button) return;
      selectSubjectFromBrowser(button.dataset.subjectQuick ?? "all");
    });
    subjectBrowserAll.addEventListener("click", () => selectSubjectFromBrowser("all"));
    loadingFallbackTimer = window.setTimeout(() => { if (list.textContent?.includes("取得しています")) list.textContent = "原稿一覧を取得できませんでした。ページを再読み込みしてください。"; }, 6_000);
    subject.addEventListener("change", () => { updateCategoryOptions(); saveFilterState(); void reloadForSelection(); });
    query.addEventListener("input", render);
    [category, status, publication, test, workflow].forEach((element) => element.addEventListener("change", render));
    archive.addEventListener("change", () => { saveFilterState(); void reloadForSelection(); });
    loadMoreButton.addEventListener("click", () => { if (!hasMore || loadMoreButton.disabled) return; loadMoreButton.disabled = true; paginationStatus.textContent = "次の原稿を読み込んでいます…"; void load(true); });
    list.addEventListener("click", async (event) => {
      const target = event.target as HTMLElement;
      const expandButton = target.closest<HTMLButtonElement>("[data-expand-category]");
      if (expandButton) {
        const key = expandButton.dataset.expandCategory;
        if (!key) return;
        if (expandedArticleGroups.has(key)) expandedArticleGroups.delete(key);
        else expandedArticleGroups.add(key);
        render();
        return;
      }
      const button = target.closest<HTMLButtonElement>("[data-archive-action]");
      if (!button) return;
      event.preventDefault();
      const documentId = button.dataset.archiveDocumentId;
      const action = button.dataset.archiveAction;
      if (!documentId || (action !== "archive" && action !== "unarchive")) return;
      button.disabled = true;
      try {
        const response = await fetch(`/api/admin/editor/documents/${encodeURIComponent(documentId)}/${action}`, { method: "POST", credentials: "same-origin", headers: { "content-type": "application/json" } });
        const data = await response.json().catch(() => ({}));
        if (!response.ok) throw Error(data.error ?? "アーカイブ操作に失敗しました。");
        const article = items.find((item) => item.id === documentId);
        if (article) {
          article.archived_at = data.archived_at ?? null;
          article.archive_expires_at = data.archive_expires_at ?? null;
        }
        render();
      } catch (error) {
        button.disabled = false;
        window.alert(error instanceof Error ? error.message : "アーカイブ操作に失敗しました。");
      }
    });
    root.querySelectorAll<HTMLButtonElement>("[data-workflow-action]").forEach((button) => button.addEventListener("click", () => {
      workflow.value = button.dataset.workflowAction ?? "all";
      history.replaceState({}, "", `${location.pathname}?mode=${encodeURIComponent(workflow.value)}#article-list`);
      render();
      root.querySelector("#article-list")?.scrollIntoView({ behavior: "smooth", block: "start" });
    }));
    updateCategoryOptions();
    void load(false, { loadAllForSelectedSubject: subject.value !== "all" });
    const handlePageShow = () => { void load(false, { silent: true, preserveLoadedPages: true }); };
    const refreshPresence = () => { if (document.visibilityState === "visible") void load(false, { silent: true, preserveLoadedPages: true }); };
    const presenceTimer = window.setInterval(refreshPresence, 15_000);
    window.addEventListener("pageshow", handlePageShow);
    document.addEventListener("visibilitychange", refreshPresence);
    const cleanup = () => {
      disposed = true;
      activeLoadController?.abort();
      window.clearInterval(presenceTimer);
      if (loadingFallbackTimer !== null) window.clearTimeout(loadingFallbackTimer);
      window.removeEventListener("pageshow", handlePageShow);
      document.removeEventListener("visibilitychange", refreshPresence);
    };
    document.addEventListener("astro:before-swap", cleanup, { once: true });
  };
  document.addEventListener("astro:page-load", initializeArticleIndex);
  initializeArticleIndex();
</script>
<script>
  import { navigate } from "astro:transitions/client";

  document.addEventListener('astro:page-load', () => {
    const list = document.querySelector<HTMLElement>('[data-article-index] [data-list]');
    if (!list || list.dataset.tileLinksReady === 'true') return;
    list.dataset.tileLinksReady = 'true';
    const openCard = (card: HTMLElement | null) => { if (card?.dataset.href) void navigate(card.dataset.href); };
    list.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      if (target.closest('[data-archive-action]')) return;
      if (target.closest('a, button')) return;
      const card = target.closest<HTMLElement>('.article');
      openCard(card);
    });
    list.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter' && event.key !== ' ') return;
      event.preventDefault();
      openCard((event.target as HTMLElement).closest<HTMLElement>('.article'));
    });
  });
</script>
