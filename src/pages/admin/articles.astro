      const uniqueRows = (candidates: CatalogRow[]) => [...new Map(candidates.map((row) => [row.kind === "editorial" ? row.article.source_article_id || row.article.id : `public:${row.publicArticle.articleId}`, row])).values()];
      const shown = uniqueRows(sorted);
      const matchingAllSubjectsShown = uniqueRows(matchingAllSubjects);
