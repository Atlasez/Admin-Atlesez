---
import AdminLayout from "../../layouts/AdminLayout.astro";
import AdminReviewQueue from "../../components/AdminReviewQueue.astro";
const activeView = Astro.url.searchParams.get("view") ?? (Astro.url.searchParams.get("mode") === "review" ? "review" : "drafts");
---
<AdminLayout title="編集・査読" description="原稿の編集・査読と状態管理">
  <main class="admin-page" data-article-index>
    <header><div><h1>編集・査読</h1><span data-mode-description>原稿を一覧で確認し、加筆・修正する記事を選べます。</span></div></header>
    <nav class="article-view-tabs" aria-label="原稿の表示切り替え">
      <a href="/admin/articles/?view=drafts&mode=revise" data-article-view="drafts" aria-current={activeView === "drafts" ? "page" : undefined}>加筆・修正</a>
      <a href="/admin/articles/?view=review&mode=review" data-article-view="review" aria-current={activeView === "review" ? "page" : undefined}>査読</a>
      <a href="/admin/articles/?view=published&mode=published" data-article-view="published" aria-current={activeView === "published" ? "page" : undefined}>公開済み</a>
    </nav>
    <AdminReviewQueue />
    <section data-article-library>
      <section class="filters"><input data-query placeholder="タイトル・分野・カテゴリで検索" /><select data-status><option value="all">すべての状態</option><option value="draft">下書き</option><option value="in-review">査読中</option><option value="on-hold">保留</option><option value="approved">査読済み</option></select><select data-public><option value="all">公開状況：すべて</option><option value="published">公開済み</option><option value="unpublished">未公開</option></select><select data-test><option value="exclude">テスト原稿を除く</option><option value="all">テスト原稿を含む</option><option value="only">テスト原稿のみ</option></select><output data-count></output></section>
      <section class="list" data-list>原稿一覧を取得しています…</section>
    </section>
  </main>
</AdminLayout>
<style is:global>
.admin-page{margin:0 auto;max-width:1200px;padding:0 1.25rem 4rem}.admin-page > header:not(.admin-nav){align-items:end;border-bottom:1px solid var(--border-default);display:flex;justify-content:space-between;gap:1rem;padding:2rem 0 1.25rem}.admin-page > header:not(.admin-nav) p{color:var(--accent-primary);font-size:.76rem;font-weight:800;letter-spacing:.08em;margin:0}.admin-page h1{font-size:2rem;margin:.25rem 0}.admin-page > header:not(.admin-nav) span{color:var(--text-secondary)}.filters{display:flex;flex-wrap:wrap;gap:.6rem;margin:1.25rem 0}.filters input,.filters select{background:var(--background-primary);border:1px solid var(--border-default);font:inherit;padding:.65rem}.filters input{flex:1 1 18rem}.filters output{align-self:center;color:var(--text-secondary);font-size:.82rem}.list{display:grid;gap:.45rem}.article{align-items:center;border:1px solid var(--border-default);display:grid;gap:.6rem;grid-template-columns:1fr auto;padding:.8rem .9rem}.article:hover{border-color:var(--accent-primary)}.article h2{font-size:1rem;margin:0}.article p{color:var(--text-secondary);font-size:.78rem;margin:.3rem 0 0}.article a{color:var(--accent-primary);font-size:.82rem;font-weight:800;text-decoration:none}.badges{display:flex;gap:.35rem;justify-content:end}.badge{border:1px solid var(--border-default);border-radius:999px;font-size:.68rem;font-weight:800;padding:.18rem .4rem}.draft{background:#edf1f5}.in-review{background:#fff0c6}.on-hold{background:#f5e5e7}.approved{background:#def4e6}.published{background:#e7f1fb;color:#185c86}[data-article-library][hidden]{display:none!important}@media(max-width:600px){.admin-page{padding:0 .8rem 3rem}.admin-page > header:not(.admin-nav),.article{align-items:start;display:grid}.badges{justify-content:start}}
.admin-page > header:not(.admin-nav){align-items:center;border-bottom:0;display:grid;justify-items:center;padding:3.4rem 0 1.8rem;text-align:center}.admin-page > header:not(.admin-nav) p{font-size:.72rem}.admin-page h1{font-size:clamp(1.9rem,4vw,2.5rem);margin:.35rem 0}.admin-page > header:not(.admin-nav) span{font-size:1rem;max-width:48rem}.admin-page > header:not(.admin-nav) a{border-radius:.65rem;margin-top:.8rem;padding:.75rem 1rem}.filters{background:var(--background-secondary);border:1px solid var(--border-default);border-radius:1rem;gap:.7rem;margin:0 auto 1.25rem;max-width:60rem;padding:1rem}.filters input,.filters select{border-radius:.6rem;min-height:2.75rem}.list{margin:0 auto;max-width:60rem}.article{background:var(--background-primary);border-radius:.65rem;padding:.7rem .85rem}.article a{border:1px solid var(--border-default);border-radius:.45rem;padding:.4rem .55rem}.article a:hover{border-color:var(--accent-primary);background:var(--background-secondary)}@media(max-width:600px){.admin-page{padding:0 .8rem 3rem}.admin-page > header:not(.admin-nav){padding:2.5rem 0 1.35rem}.filters{border-radius:.75rem;padding:.8rem}.admin-page > header:not(.admin-nav),.article{align-items:start;display:grid}.badges{justify-content:start}}
.article-view-tabs{border-bottom:1px solid var(--border-default);display:flex;gap:.35rem;margin:0 auto 1.25rem;max-width:60rem;overflow-x:auto}.article-view-tabs a{border-bottom:3px solid transparent;color:var(--text-secondary);font-size:.85rem;font-weight:800;padding:.65rem .9rem;text-decoration:none;white-space:nowrap}.article-view-tabs a:hover,.article-view-tabs a.is-active,.article-view-tabs a[aria-current="page"]{border-bottom-color:var(--accent-primary);color:var(--accent-primary)}
</style>
<style is:global>
  .admin-page > header.admin-nav a.admin-nav-brand { background: transparent; color: var(--accent-primary); padding: 0; }
  .admin-page > header.admin-nav nav > a { background: transparent; color: var(--text-primary); padding: 0 .62rem; }
  .admin-page > header:not(.admin-nav) { width: min(100%, 60rem); margin-inline: auto; }
  .admin-page > header:not(.admin-nav) > div { width: 100%; }
  .list { gap: .28rem; }
  .article { gap: .45rem; padding: .55rem .7rem; }
  .article h2 { font-size: .93rem; }
  .article p { font-size: .72rem; margin-top: .18rem; }
  .badges { gap: .25rem; }
  .badge { font-size: .64rem; padding: .14rem .32rem; }
  .article { color: var(--text); cursor: pointer; text-decoration: none; }
  .article a, .article-link-label { font-size: .76rem; }
  .article:hover { border-color: var(--accent); box-shadow: 0 .2rem .7rem #153c6615; }
  /* 他の管理ページと同じ左寄せの見出しに揃え、一覧の操作領域だけを中央幅にする。 */
  .admin-page > header:not(.admin-nav) {
    align-items: flex-start;
    border-bottom: 1px solid var(--border-default);
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-inline: 0;
    padding: 2rem 0 1.25rem;
    text-align: left;
    width: auto;
  }
  .admin-page > header:not(.admin-nav) > div { width: auto; }
  .admin-page > header:not(.admin-nav) span { display: block; max-width: 48rem; }
  @media(max-width:600px){
    .admin-page > header:not(.admin-nav) { align-items: start; display: grid; padding: 1.6rem 0 1.1rem; }
  }
</style>
<script>
  const syncArticleViewTabs = () => {
    const tabs = document.querySelectorAll<HTMLAnchorElement>('[data-article-index] [data-article-view]');
    if (!tabs.length) return;
    const params = new URLSearchParams(location.search);
    const view = params.get('view') ?? (params.get('mode') === 'review' ? 'review' : 'drafts');
    tabs.forEach((tab) => {
      const active = tab.dataset.articleView === view;
      tab.classList.toggle('is-active', active);
      if (active) tab.setAttribute('aria-current', 'page');
      else tab.removeAttribute('aria-current');
    });
  };
  document.addEventListener('astro:page-load', syncArticleViewTabs);
  syncArticleViewTabs();
</script>
<script>
  type Article = {
    id: string;
    source_article_id?: string | null;
    subject: string;
    category: string;
    slug?: string;
    title: string;
    status: "draft" | "in-review" | "on-hold" | "approved";
    updated_at: string;
    published_at: string | null;
    created_by?: string;
    updated_by?: string;
  };

  const initializeArticleIndex = () => {
    const root = document.querySelector<HTMLElement>("[data-article-index]");
    if (!root || root.dataset.ready === "true") return;
    root.dataset.ready = "true";
    const list = root.querySelector<HTMLElement>("[data-list]")!;
    const query = root.querySelector<HTMLInputElement>("[data-query]")!;
    const status = root.querySelector<HTMLSelectElement>("[data-status]")!;
    const publication = root.querySelector<HTMLSelectElement>("[data-public]")!;
    const test = root.querySelector<HTMLSelectElement>("[data-test]")!;
    const count = root.querySelector<HTMLOutputElement>("[data-count]")!;
    let items: Article[] = [];
    let scopeEmail = "";
    const mode = new URLSearchParams(location.search).get("mode") ?? "revise";
    const returnContext = mode === "published" ? "published" : "revise";
    if (mode === "review") return;
    const escapeHtml = (value: string) => value.replace(/[&<>"']/g, (character) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[character] ?? character);
    const labels = { draft: "下書き", "in-review": "査読中", "on-hold": "保留", approved: "査読済み" };
    const isTest = (item: Article) => /(^|[\s_-])test($|[\s_-])|テスト/i.test(item.title);

    const render = () => {
      const searchText = query.value.toLowerCase();
      const filtered = items.filter((item) =>
        (status.value === "all" || item.status === status.value) &&
        (publication.value === "all" || (publication.value === "published" ? Boolean(item.published_at) : !item.published_at)) &&
        (test.value === "all" || (test.value === "only" ? isTest(item) : !isTest(item))) &&
        `${item.title} ${item.subject} ${item.category}`.toLowerCase().includes(searchText),
      );
      const sorted = [...filtered].sort((left, right) => {
        const leftPriority = mode === "revise" && [left.created_by, left.updated_by].includes(scopeEmail) ? 0 : 1;
        const rightPriority = mode === "revise" && [right.created_by, right.updated_by].includes(scopeEmail) ? 0 : 1;
        return leftPriority - rightPriority || new Date(right.updated_at).getTime() - new Date(left.updated_at).getTime();
      });
      const shown = [...new Map(sorted.map((item) => [item.source_article_id || `${item.subject}/${item.category}/${item.slug || item.title}`, item])).values()];
      count.textContent = `${shown.length}件`;
      list.innerHTML = shown.length
        ? shown.map((item) => `<article class="article"><div><h2>${escapeHtml(item.title || "無題の原稿")}</h2><p>${escapeHtml(item.subject)} / ${escapeHtml(item.category)} ・ 最終更新 ${new Intl.DateTimeFormat("ja-JP", { dateStyle: "medium" }).format(new Date(item.updated_at))}</p></div><div><div class="badges"><span class="badge ${item.status}">${labels[item.status]}</span>${isTest(item) ? '<span class="badge">テスト</span>' : ""}${item.published_at ? '<span class="badge published">公開済み</span>' : ""}</div><a href="/admin/editor/?document=${encodeURIComponent(item.id)}&from=${returnContext}">編集・査読を開く →</a></div></article>`).join("")
        : "<p>条件に一致する原稿はありません。</p>";
    };

    const load = async () => {
      try {
        const response = await fetch("/api/admin/editor/documents", { credentials: "same-origin", cache: "no-store" });
        const contentType = response.headers.get("content-type") ?? "";
        const data = contentType.includes("application/json") ? await response.json() as { documents?: Article[]; scope?: { email?: string }; error?: string } : {};
        if (!response.ok) throw new Error(data.error ?? "認証情報を取得できませんでした。ページを再読み込みしてください。");
        items = data.documents ?? [];
        scopeEmail = data.scope?.email ?? "";
        render();
      } catch (error) {
        list.textContent = error instanceof Error ? error.message : "原稿一覧を取得できませんでした。";
      }
    };
    window.setTimeout(() => {
      if (list.textContent?.includes("取得しています")) list.textContent = "原稿一覧を取得できませんでした。ページを再読み込みしてください。";
    }, 6_000);
    [query, status, publication, test].forEach((input) => input.addEventListener("input", render));
    void load();
  };

  document.addEventListener("astro:page-load", initializeArticleIndex);
  initializeArticleIndex();
</script>
<script>
  const applyArticleView = () => {
    const root = document.querySelector<HTMLElement>("[data-article-index]");
    if (!root) return;
    const params = new URLSearchParams(location.search);
    const view = params.get("view") ?? "drafts";
    const status = root.querySelector<HTMLSelectElement>("[data-status]");
    const publication = root.querySelector<HTMLSelectElement>("[data-public]");
    const description = root.querySelector<HTMLElement>("[data-mode-description]");
    const library = root.querySelector<HTMLElement>("[data-article-library]");
    if (!status || !publication) return;
    if (library) library.hidden = view === "review";
    if (view === "review") {
      status.value = "in-review";
      publication.value = "unpublished";
      if (description) description.textContent = "査読依頼を確認し、自分への依頼から優先して査読できます。";
    } else if (view === "published") {
      status.value = "all";
      publication.value = "published";
      if (description) description.textContent = "公開済みの記事を確認できます。";
    } else {
      status.value = "all";
      publication.value = "all";
      if (description) description.textContent = "既存の原稿を一覧で確認し、重複を避けて加筆・修正できます。";
    }
    status.dispatchEvent(new Event("input", { bubbles: true }));
    publication.dispatchEvent(new Event("input", { bubbles: true }));
  };
  document.addEventListener("astro:page-load", applyArticleView);
  applyArticleView();
</script>
<script>
  import { navigate } from "astro:transitions/client";

  document.addEventListener('astro:page-load', () => {
    const list = document.querySelector<HTMLElement>('[data-article-index] [data-list]');
    if (!list || list.dataset.tileLinksReady === 'true') return;
    list.dataset.tileLinksReady = 'true';
    list.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      if (target.closest('a')) return;
      const card = target.closest<HTMLElement>('.article');
      const link = card?.querySelector<HTMLAnchorElement>('a');
      if (link) void navigate(link.href);
    });
  });
</script>
