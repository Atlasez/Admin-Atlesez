        managed: { label: "公開記事と連携済み", tone: "linked" },
        "needs-registration": { label: "原稿あり・公開記事ID未連携", tone: "linkage-attention" },
        unmanaged: { label: "運営原稿未登録", tone: "linkage-missing" },
        conflict: { label: "重複・紐付け要確認", tone: "linkage-conflict" },
