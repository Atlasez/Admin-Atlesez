    const normalizeCatalog = (raw: unknown): PublicArticle[] | null => {
      if (!Array.isArray(raw)) return null;
      return raw.flatMap((item) => {
        if (!item || typeof item !== "object") return [];
        const entry = item as PublicArticleCatalogEntry;
        const locale = typeof entry.locale === "string" ? entry.locale : "";
        const publicStatus = typeof entry.public_status === "string" ? entry.public_status : "";
        const articleId = typeof entry.source_article_id === "string" ? entry.source_article_id : "";
        const subject = typeof entry.subject === "string" ? entry.subject : "";
        const category = typeof entry.category === "string" ? entry.category : "";
        const slug = typeof entry.slug === "string" ? entry.slug : "";
        const title = typeof entry.title === "string" ? entry.title : "";
        if (locale !== "ja" || publicStatus !== "published" || !articleId || !subject || !category || !slug || !title) return [];
        const updatedAt = typeof entry.public_updated_at === "string" ? entry.public_updated_at : typeof entry.editorial_updated_at === "string" ? entry.editorial_updated_at : new Date().toISOString();
        const managementState = typeof entry.state === "string" ? entry.state : undefined;
        const documentId = typeof entry.editorial_document_id === "string" ? entry.editorial_document_id : undefined;
        const duplicateDocumentIds = Array.isArray(entry.duplicate_document_ids) ? entry.duplicate_document_ids.filter((id): id is string => typeof id === "string") : [];
        return [{ articleId, subject, category, slug, title, updatedAt, managementState, documentId, ...(duplicateDocumentIds.length ? { duplicateDocumentIds } : {}) }];
      });
    };
    const loadCatalog = async (abortSignal?: AbortSignal) => {
      catalogSummary.dataset.state = "loading";
      catalogSummary.textContent = "公開記事カタログを確認しています…";
      try {
        const timeoutSignal = AbortSignal.timeout(10000);
        const signal = abortSignal ? AbortSignal.any([abortSignal, timeoutSignal]) : timeoutSignal;
        const response = await fetch("/api/admin/editor/catalog", { credentials: "same-origin", cache: "no-store", signal });
        const contentType = response.headers.get("content-type") ?? "";
        const data = contentType.includes("application/json") ? await response.json() as { catalog?: unknown[]; error?: string } : {};
        if (!response.ok) throw new Error(data.error ?? `公開記事カタログを取得できませんでした（${response.status}）。`);
        const normalized = normalizeCatalog(data.catalog);
        if (!normalized) throw new Error("公開記事カタログの形式を確認できませんでした。");
        publicArticles = normalized;
        catalogSource = "api";
        catalogSummary.dataset.state = "ready";
        catalogSummary.textContent = `公開記事カタログを確認しました（${publicArticles.length}件）。原稿一覧と照合しています…`;
      } catch (error) {
        if (abortSignal?.aborted) throw error;
        // APIに接続できない場合は、ビルド時の古いカタログを混ぜない。
        // 原稿一覧の状態と公開サイトの状態が食い違うため、未確認の公開記事を
        // 運営原稿として表示するよりも、カタログを空にして診断を促す。
        publicArticles = [];
        catalogSource = "unavailable";
        catalogSummary.dataset.state = "error";
        catalogSummary.textContent = "公開記事カタログを確認できませんでした。";
        setCatalogFeedback(`公開記事カタログAPIに接続できないため、公開記事カタログを表示できません。${error instanceof Error ? `（${error.message}）` : ""}`);
      } finally {
        catalogReady = true;
      }
    };
    let loadRequest: Promise<void> | null = null;
    let activeLoadController: AbortController | null = null;
    let disposed = false;
    let loadingFallbackTimer: number | null = null;
    type LoadOptions = { silent?: boolean; preserveLoadedPages?: boolean };
    const load = (append = false, options: LoadOptions = {}) => {
      // pageshow and visibility events can arrive together on a cold load.
      // Share the in-flight request so the same list is not fetched twice.
      if (disposed || loadRequest) return loadRequest ?? Promise.resolve();
      const silent = Boolean(options.silent);
      const preserveLoadedPages = Boolean(options.preserveLoadedPages && silent && !append && loadedPageCount > 1);
      const controller = new AbortController();
      activeLoadController = controller;
      const request = (async () => {
        try {
          if (!silent) retry?.begin();
          if (!append && !silent) list.classList.add("loading-state");
          if (!append && !silent) {
            subject.disabled = true;
            subject.setAttribute("aria-busy", "true");
            scopeNote.dataset.state = "loading";
            scopeNote.textContent = "担当範囲を確認しています…";
          }
          const includeArchived = archive.value !== "active";
          if (!append && !preserveLoadedPages) {
            nextCursor = null;
            hasMore = false;
            loadedPageCount = 0;
            if (!silent) items = [];
          }
          const params = new URLSearchParams();
          if (includeArchived) params.set("includeArchived", "1");
          if (append && nextCursor) params.set("cursor", nextCursor);
          if (append) params.set("limit", "50");
          const queryString = params.toString();
          const endpoint = queryString ? `/api/admin/editor/documents?${queryString}` : "/api/admin/editor/documents";
          const response = await fetch(endpoint, { credentials: "same-origin", cache: "no-store", signal: controller.signal });
          const data = await readAdminApiJson<{ documents?: Article[]; scope?: ArticleScope; pagination?: ArticlePagination; error?: string }>(response, "原稿一覧を読み込めませんでした。");
          if (!response.ok) throw Error(data.error ?? `原稿一覧の読み込みに失敗しました。（HTTP ${response.status}）`);
          if (!data.scope) throw new Error("ログイン状態または担当範囲を確認できません。ログインを確認して再試行してください。");
          const pageDocuments = data.documents ?? [];
          if (append) {
            items = [...items, ...pageDocuments];
            nextCursor = data.pagination?.nextCursor ?? null;
            hasMore = Boolean(data.pagination?.hasMore);
            loadedPageCount += 1;
          } else if (preserveLoadedPages) {
            const refreshedIds = new Set(pageDocuments.map((article) => article.id));
            items = [...pageDocuments, ...items.filter((article) => !refreshedIds.has(article.id))];
          } else {
            items = pageDocuments;
            nextCursor = data.pagination?.nextCursor ?? null;
            hasMore = Boolean(data.pagination?.hasMore);
            loadedPageCount = 1;
          }
          scopeEmail = data.scope?.email ?? "";
          const catalogPromise = catalogReady ? Promise.resolve() : loadCatalog(controller.signal);
          applySubjectScope(data.scope);
          // Render the editorial rows immediately. The remote catalog is an
          // enrichment step and must not block the first useful screen.
          render();
          await catalogPromise;
          render();
          if (!silent) retry?.success();
        } catch (error) {
          if (disposed || controller.signal.aborted || silent) return;
          list.classList.remove("loading-state");
          list.classList.add("error-state");
          list.textContent = error instanceof Error ? error.message : "原稿一覧を取得できませんでした。";
          if (!append) {
            subject.disabled = true;
            subject.removeAttribute("aria-busy");
            scopeNote.dataset.state = "error";
            scopeNote.textContent = "担当範囲を確認できませんでした。原稿一覧を再試行してください。";
            if (!catalogReady) {
              catalogSummary.dataset.state = "error";
              catalogSummary.textContent = "原稿一覧を取得できないため、公開記事との対応状態を確認できません。";
            }
          }
          retry?.fail(error);
        } finally {
          if (activeLoadController === controller) activeLoadController = null;
        }
      })();
      const wrapped = request.finally(() => { if (loadRequest === wrapped) loadRequest = null; });
      loadRequest = wrapped;
      return wrapped;
    };
    retry = createAdminLoadRetry(root, () => load(), "原稿一覧を読み込めませんでした。");
    const setCatalogFeedback = (message: string, isError = false) => {
      catalogFeedback.textContent = message;
      catalogFeedback.classList.toggle("is-error", isError);
    };
    const runCatalogDiagnostics = async () => {
      if (catalogDiagnosticsButton.disabled) return;
      catalogDiagnosticsButton.disabled = true;
      catalogDiagnosticsButton.textContent = "診断中…";
      catalogDiagnostics.hidden = false;
      catalogDiagnostics.open = true;
      catalogDiagnostics.classList.remove("is-error");
      catalogDiagnosticsSummary.textContent = "公開記事と運営原稿の対応を確認しています…";
      catalogDiagnosticsIssues.replaceChildren();
      try {
        const response = await fetch("/api/admin/editor/catalog/diagnostics", { credentials: "same-origin", cache: "no-store" });
        const contentType = response.headers.get("content-type") ?? "";
        const data = contentType.includes("application/json")
          ? await response.json() as { checked_articles?: number; issue_count?: number; healthy?: boolean; issues?: Array<{ code?: string; severity?: string; title?: string; identity_key?: string; message?: string }> }
          : {};
        if (!response.ok) throw new Error(`カタログ診断に失敗しました（${response.status}）。`);
        const checked = Number(data.checked_articles ?? 0);
        const issueCount = Number(data.issue_count ?? 0);
        catalogDiagnosticsSummary.textContent = data.healthy
          ? `${checked}件を確認しました。重複・未登録・同一性の問題はありません。`
          : `${checked}件を確認し、${issueCount}件の確認事項を検出しました。登録や更新の前に内容を確認してください。`;
        const issues = Array.isArray(data.issues) ? data.issues : [];
        for (const issue of issues.slice(0, 50)) {
          const item = document.createElement("li");
          const title = issue.title || issue.identity_key || "対象記事";
          item.innerHTML = `<strong>${esc(issue.severity === "error" ? "要停止" : "確認")}</strong> ${esc(title)}：${esc(issue.message || issue.code || "診断項目")}`;
          catalogDiagnosticsIssues.append(item);
        }
        if (issues.length > 50) {
          const item = document.createElement("li");
          item.textContent = `その他${issues.length - 50}件（表示上限50件）`;
          catalogDiagnosticsIssues.append(item);
        }
      } catch (error) {
        catalogDiagnostics.classList.add("is-error");
        catalogDiagnosticsSummary.textContent = error instanceof Error ? error.message : "カタログ診断に失敗しました。";
      } finally {
        catalogDiagnosticsButton.disabled = false;
        catalogDiagnosticsButton.textContent = "カタログを診断";
      }
    };
    const readApiResponse = async <T extends { error?: string }>(response: Response): Promise<T> => {
      const contentType = response.headers.get("content-type") ?? "";
      if (contentType.includes("application/json")) return await response.json() as T;
      const text = await response.text();
      return { error: text || undefined } as T;
    };
    const registerUnregisteredArticles = async () => {
      const pending = bulkRegistrationCandidates();
      if (!pending.length || bulkRegistrationInFlight) return;
      bulkRegistrationInFlight = true;
      render();
      setCatalogFeedback("");
      const totals = { registered: 0, alreadyManaged: 0, conflict: 0, failed: 0 };
      const errors: string[] = [];
      try {
        for (let offset = 0; offset < pending.length; offset += 20) {
          const batch = pending.slice(offset, offset + 20);
          const response = await fetch("/api/admin/editor/catalog/register-bulk", {
            method: "POST",
            headers: { "content-type": "application/json" },
            credentials: "same-origin",
            body: JSON.stringify({ articles: batch.map(({ subject, category, slug }) => ({ locale: "ja", subject, category, slug })) }),
          });
          const data = await readApiResponse<{ error?: string; results?: Array<{ identityKey?: string; status?: "registered" | "already-managed" | "conflict" | "failed"; documentId?: string; error?: string }> }>(response);
          if (!response.ok || !Array.isArray(data.results)) throw new Error(data.error ?? `一括登録に失敗しました（${response.status}）。`);
          for (const result of data.results) {
            const identity = (result.identityKey ?? "").split("/").slice(1).join("/");
            const article = batch.find((item) => `${item.subject}/${item.category}/${item.slug}` === identity);
            if (result.status === "registered") {
              totals.registered += 1;
              if (article) registeredPublicArticleIds.set(publicArticleKey(article), result.documentId);
            } else if (result.status === "already-managed") {
              totals.alreadyManaged += 1;
              if (article) registeredPublicArticleIds.set(publicArticleKey(article), result.documentId);
            } else if (result.status === "conflict") {
              totals.conflict += 1;
              errors.push(`${article?.title ?? identity}：${result.error ?? "既存原稿との紐付けを確認してください。"}`);
            } else {
              totals.failed += 1;
              errors.push(`${article?.title ?? identity}：${result.error ?? "登録に失敗しました。"}`);
            }
          }
        }
        render();
        const summary = `一括処理：新規登録${totals.registered}件、登録済み${totals.alreadyManaged}件、競合${totals.conflict}件、失敗${totals.failed}件。通知・メール・タスク・コメント・公開処理は行いません。`;
        setCatalogFeedback([summary, ...errors].join("\n"), totals.failed > 0 || totals.conflict > 0);
      } catch (error) {
        setCatalogFeedback(error instanceof Error ? error.message : "一括登録に失敗しました。", true);
      } finally {
        bulkRegistrationInFlight = false;
        render();
      }
    };
    registerUnregisteredButton.addEventListener("click", () => { void registerUnregisteredArticles(); });
    const registerPublicArticle = async (link: HTMLAnchorElement) => {
      const articleId = link.dataset.articleId;
      const source = publicArticles.find((article) => article.articleId === articleId);
      if (!source || link.dataset.registering === "true") return;
      link.dataset.registering = "true";
      link.setAttribute("aria-busy", "true");
      link.classList.add("is-loading");
      link.textContent = "登録中…";
      setCatalogFeedback("");
      try {
        const response = await fetch("/api/admin/editor/catalog/register", {
          method: "POST",
          headers: { "content-type": "application/json" },
          credentials: "same-origin",
          body: JSON.stringify({ locale: "ja", subject: source.subject, category: source.category, slug: source.slug }),
        });
        const data = await readApiResponse<{ ok?: boolean; registered?: boolean; documentId?: string; identityKey?: string; error?: string }>(response);
        if (!response.ok || data.ok !== true) throw new Error(data.error ?? "公開記事を運営管理へ登録できませんでした。");
        registeredPublicArticleIds.set(publicArticleKey(source), data.documentId);
        setCatalogFeedback(data.registered === false ? `「${source.title}」の運営原稿はすでに登録されています。外部公開やPRは開始していません。` : `「${source.title}」の運営原稿を作成しました。外部公開やPRは開始していません。`);
        // Registration already returns the authoritative document id. Update
        // the local catalog immediately instead of reloading the editorial
        // list and GitHub catalog after every item; repeated reloads can
        // exhaust the Worker CPU budget during bulk registration.
        render();
      } catch (error) {
        setCatalogFeedback(error instanceof Error ? error.message : "公開記事を運営管理へ登録できませんでした。", true);
        link.textContent = "運営原稿を作成";
      } finally {
        delete link.dataset.registering;
        link.removeAttribute("aria-busy");
        link.classList.remove("is-loading");
      }
    };
    catalogDiagnosticsButton.addEventListener("click", () => { void runCatalogDiagnostics(); });
    resetFiltersButton.addEventListener("click", () => {
      query.value = defaultFilterState.query;
      assignSelectValue(subject, defaultFilterState.subject, defaultFilterState.subject);
      assignSelectValue(category, defaultFilterState.category, defaultFilterState.category);
      assignSelectValue(status, defaultFilterState.status, defaultFilterState.status);
      assignSelectValue(publication, defaultFilterState.publication, defaultFilterState.publication);
      assignSelectValue(linkage, defaultFilterState.linkage, defaultFilterState.linkage);
      assignSelectValue(test, defaultFilterState.test, defaultFilterState.test);
      assignSelectValue(workflow, defaultFilterState.workflow, defaultFilterState.workflow);
      assignSelectValue(archive, defaultFilterState.archive, defaultFilterState.archive);
      root.querySelector<HTMLDetailsElement>(".advanced-filters")!.open = false;
      updateCategoryOptions();
      saveFilterState();
      history.replaceState({}, "", `${location.pathname}#article-list`);
      render();
    });
    const selectSubjectFromBrowser = (value: string) => {
      if (![...subject.options].some((option) => option.value === value && !option.disabled && !option.hidden)) return;
      subject.value = value;
      category.value = "all";
      updateCategoryOptions();
      saveFilterState();
      render();
      root.querySelector("#article-list")?.scrollIntoView({ behavior: "smooth", block: "start" });
    };
    subjectBrowser.addEventListener("click", (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-subject-quick]");
      if (!button) return;
      selectSubjectFromBrowser(button.dataset.subjectQuick ?? "all");
    });
    catalogCounts.addEventListener("click", (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-catalog-filter]");
      const value = button?.dataset.catalogFilter;
      if (!value || ![...linkage.options].some((option) => option.value === value)) return;
      linkage.value = linkage.value === value ? "all" : value;
      saveFilterState();
      render();
      root.querySelector("#article-list")?.scrollIntoView({ behavior: "smooth", block: "start" });
    });
    subjectBrowserAll.addEventListener("click", () => selectSubjectFromBrowser("all"));
    loadingFallbackTimer = window.setTimeout(() => { if (list.textContent?.includes("取得しています")) list.textContent = "原稿一覧を取得できませんでした。ページを再読み込みしてください。"; }, 6_000);
    subject.addEventListener("change", () => { updateCategoryOptions(); render(); });
    query.addEventListener("input", render);
    [category, status, publication, linkage, test, workflow].forEach((element) => element.addEventListener("change", render));
    archive.addEventListener("change", () => { render(); void load(false, { silent: true }); });
    loadMoreButton.addEventListener("click", () => { if (!hasMore || loadMoreButton.disabled) return; loadMoreButton.disabled = true; paginationStatus.textContent = "次の原稿を読み込んでいます…"; void load(true); });
    list.addEventListener("click", async (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-archive-action]");
      if (!button) return;
      event.preventDefault();
      const documentId = button.dataset.archiveDocumentId;
      const action = button.dataset.archiveAction;
      if (!documentId || (action !== "archive" && action !== "unarchive")) return;
      button.disabled = true;
      try {
        const response = await fetch(`/api/admin/editor/documents/${encodeURIComponent(documentId)}/${action}`, { method: "POST", credentials: "same-origin", headers: { "content-type": "application/json" } });
        const data = await response.json().catch(() => ({}));
        if (!response.ok) throw Error(data.error ?? "アーカイブ操作に失敗しました。");
        const article = items.find((item) => item.id === documentId);
        if (article) {
          article.archived_at = data.archived_at ?? null;
          article.archive_expires_at = data.archive_expires_at ?? null;
        }
        render();
      } catch (error) {
        button.disabled = false;
        window.alert(error instanceof Error ? error.message : "アーカイブ操作に失敗しました。");
      }
    });
    root.querySelectorAll<HTMLButtonElement>("[data-workflow-action]").forEach((button) => button.addEventListener("click", () => {
      workflow.value = button.dataset.workflowAction ?? "all";
      history.replaceState({}, "", `${location.pathname}?mode=${encodeURIComponent(workflow.value)}#article-list`);
      render();
      root.querySelector("#article-list")?.scrollIntoView({ behavior: "smooth", block: "start" });
    }));
    updateCategoryOptions();
    void load();
    list.addEventListener("click", (event) => {
      const link = (event.target as HTMLElement).closest<HTMLAnchorElement>("a[data-register-link]");
      if (!link) return;
      event.preventDefault();
      void registerPublicArticle(link);
    });
    const handlePageShow = () => { void load(false, { silent: true, preserveLoadedPages: true }); };
    const refreshPresence = () => { if (document.visibilityState === "visible") void load(false, { silent: true, preserveLoadedPages: true }); };
    const presenceTimer = window.setInterval(refreshPresence, 15_000);
    window.addEventListener("pageshow", handlePageShow);
    document.addEventListener("visibilitychange", refreshPresence);
    const cleanup = () => {
      disposed = true;
      activeLoadController?.abort();
      window.clearInterval(presenceTimer);
      if (loadingFallbackTimer !== null) window.clearTimeout(loadingFallbackTimer);
      window.removeEventListener("pageshow", handlePageShow);
      document.removeEventListener("visibilitychange", refreshPresence);
    };
    document.addEventListener("astro:before-swap", cleanup, { once: true });
  };
  document.addEventListener("astro:page-load", initializeArticleIndex);
  initializeArticleIndex();
</script>
<script>
  import { navigate } from "astro:transitions/client";

  document.addEventListener('astro:page-load', () => {
    const list = document.querySelector<HTMLElement>('[data-article-index] [data-list]');
    if (!list || list.dataset.tileLinksReady === 'true') return;
    list.dataset.tileLinksReady = 'true';
    const openCard = (card: HTMLElement | null) => { if (card?.dataset.href) void navigate(card.dataset.href); };
    list.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      if (target.closest('[data-archive-action]')) return;
      if (target.closest('a, button')) return;
      const card = target.closest<HTMLElement>('.article');
      openCard(card);
    });
    list.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter' && event.key !== ' ') return;
      event.preventDefault();
      openCard((event.target as HTMLElement).closest<HTMLElement>('.article'));
    });
  });
</script>
