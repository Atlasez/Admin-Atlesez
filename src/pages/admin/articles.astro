        catalogCounts.innerHTML = metrics.map((metric) => `<button type="button" class="catalog-status-card catalog-status-card--${metric.tone}" data-catalog-filter="${metric.value}" aria-pressed="${String(linkage.value === metric.value)}"><span class="catalog-status-card__label">${metric.label}</span><strong>${metric.count}件</strong><small>${metric.note}</small></button>`).join("");
      }
      const matchesFilters = (row: CatalogRow, ignoreSelectedSubject = false) => {
        const isUnregistered = row.kind === "unregistered" || row.kind === "conflict";
        const article = row.kind === "editorial" ? row.article : null;
        if (isUnregistered && mode !== "all") return false;
        if (article && archive.value === "active" && isArchived(article)) return false;
        if (article && archive.value === "archived" && !isArchived(article)) return false;
        if (article && mode === "review" && article.status === "approved") return false;
        if (article && mode === "request" && !([article.created_by, article.updated_by].includes(scopeEmail) && article.status !== "approved" && !article.published_at)) return false;
        if (!ignoreSelectedSubject && subject.value !== "all" && rowSubject(row) !== subject.value) return false;
        if (category.value !== "all" && rowCategory(row) !== category.value) return false;
        if (status.value !== "all" && (!article || article.status !== status.value)) return false;
        if (linkage.value !== "all" && rowLinkageState(row) !== linkage.value) return false;
        if (publication.value === "published" && (isUnregistered ? true : !article?.published_at)) return false;
        if (publication.value === "scheduled" && (isUnregistered || Boolean(article?.published_at) || !article?.scheduled_publish_at)) return false;
        if (publication.value === "unpublished" && (isUnregistered || Boolean(article?.published_at) || Boolean(article?.scheduled_publish_at))) return false;
        const testMatch = isTestArticleTitle(rowTitle(row));
        if (test.value === "only" && !testMatch) return false;
        if (test.value === "exclude" && testMatch) return false;
        return `${rowTitle(row)} ${rowSubject(row)} ${rowCategory(row)}`.toLowerCase().includes(normalizedQuery);
      };
