---
import AdminLayout from "../../layouts/AdminLayout.astro";
---

<AdminLayout title="編集・フィードバック" description="原稿の編集・フィードバックと状態管理">
  <main class="admin-page" data-article-index>
    <header>
      <div>
        <h1>編集・フィードバック</h1>
      </div>
    </header>
    <nav class="workflow-actions" aria-label="編集・フィードバックの作業入口">
      <a href="/admin/editor/?new=1&from=articles"><strong>新規記事作成</strong><span>新しい原稿を作る</span></a>
      <button type="button" data-workflow-action="revise"><strong>加筆・修正</strong><span>自分の作業対象を表示</span></button>
      <button type="button" data-workflow-action="review"><strong>査読</strong><span>フィードバック対象を表示</span></button>
      <button type="button" data-workflow-action="request"><strong>フィードバック依頼</strong><span>依頼する原稿を表示</span></button>
    </nav>
    <section class="filters" id="article-list">
      <input data-query placeholder="タイトル・分野・カテゴリで検索" /><select
        data-status
      >
        <option value="all">すべての状態</option>
        <option value="draft">下書き</option>
        <option value="in-review">フィードバック中</option>
        <option value="on-hold">保留</option>
        <option value="approved">フィードバック済み</option></select
      ><select data-public>
        <option value="all">公開状況：すべて</option>
        <option value="published">公開済み</option>
        <option value="unpublished">未公開</option></select
      ><select data-test>
        <option value="exclude">テスト原稿を除く</option>
        <option value="all">テスト原稿を含む</option>
        <option value="only">テスト原稿のみ</option></select
      ><select data-workflow-filter aria-label="作業対象">
        <option value="all">作業対象：すべて</option>
        <option value="revise">作業対象：自分が加筆・修正する記事</option>
        <option value="review">作業対象：フィードバック対象</option>
        <option value="request">作業対象：フィードバックを依頼する記事</option></select
      ><output data-count></output>
    </section>
    <section class="list" data-list>原稿一覧を取得しています…</section>
  </main>
</AdminLayout>
<style is:global>
  .admin-page {
    margin: 0 auto;
    max-width: 1200px;
    padding: 0 1.25rem 4rem;
  }
  .admin-page > header:not(.admin-nav) {
    align-items: end;
    border-bottom: 1px solid var(--border-default);
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 2rem 0 1.25rem;
  }
  .admin-page > header:not(.admin-nav) p {
    color: var(--accent-primary);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    margin: 0;
  }
  .admin-page h1 {
    font-size: 2rem;
    margin: 0.25rem 0;
  }
  .admin-page > header:not(.admin-nav) span {
    color: var(--text-secondary);
  }
  .admin-page > header:not(.admin-nav) a {
    background: var(--accent-primary);
    color: #fff;
    font-weight: 800;
    padding: 0.65rem 0.85rem;
    text-decoration: none;
  }
  .header-actions {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    justify-content: end;
  }
  .workflow-actions {
    display: grid;
    gap: 0.65rem;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 1.25rem auto;
    max-width: 60rem;
  }
  .workflow-actions a,
  .workflow-actions button {
    background: var(--background-secondary);
    border: 1px solid var(--border-default);
    border-top: 3px solid var(--accent-primary);
    border-radius: 0.65rem;
    color: var(--text-primary);
    cursor: pointer;
    display: grid;
    font: inherit;
    gap: 0.3rem;
    min-height: 5.5rem;
    padding: 0.85rem;
    text-align: left;
    text-decoration: none;
  }
  .workflow-actions a:hover,
  .workflow-actions button:hover,
  .workflow-actions button[aria-pressed="true"] {
    border-color: var(--accent-primary);
    box-shadow: 0 0.25rem 0.8rem #153c6618;
  }
  .workflow-actions strong { font-size: 0.95rem; }
  .workflow-actions span { color: var(--text-secondary); font-size: 0.72rem; }
  .admin-page > header:not(.admin-nav) .quiet-header-action {
    background: var(--background-primary);
    border: 1px solid var(--border-default);
    color: var(--text-primary);
  }
  .admin-page > header:not(.admin-nav) .quiet-header-action:hover {
    border-color: var(--accent-primary);
    color: var(--accent-primary);
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 1.25rem 0;
  }
  .filters input,
  .filters select {
    background: var(--background-primary);
    border: 1px solid var(--border-default);
    font: inherit;
    padding: 0.65rem;
  }
  .filters input {
    flex: 1 1 18rem;
  }
  .filters output {
    align-self: center;
    color: var(--text-secondary);
    font-size: 0.82rem;
  }
  .list {
    display: grid;
    gap: 0.45rem;
  }
  .article {
    align-items: center;
    border: 1px solid var(--border-default);
    display: grid;
    gap: 0.6rem;
    grid-template-columns: 1fr auto;
    padding: 0.8rem 0.9rem;
  }
  .article:hover {
    border-color: var(--accent-primary);
  }
  .article h2 {
    font-size: 1rem;
    margin: 0;
  }
  .article p {
    color: var(--text-secondary);
    font-size: 0.78rem;
    margin: 0.3rem 0 0;
  }
  .article a {
    color: var(--accent-primary);
    font-size: 0.82rem;
    font-weight: 800;
    text-decoration: none;
  }
  .badges {
    display: flex;
    gap: 0.35rem;
    justify-content: end;
  }
  .badge {
    border: 1px solid var(--border-default);
    border-radius: 999px;
    font-size: 0.68rem;
    font-weight: 800;
    padding: 0.18rem 0.4rem;
  }
  .draft {
    background: #edf1f5;
  }
  .in-review {
    background: #fff0c6;
  }
  .on-hold {
    background: #f5e5e7;
  }
  .approved {
    background: #def4e6;
  }
  .published {
    background: #e7f1fb;
    color: #185c86;
  }
  @media (max-width: 600px) {
    .admin-page {
      padding: 0 0.8rem 3rem;
    }
    .admin-page > header:not(.admin-nav),
    .article {
      align-items: start;
      display: grid;
    }
    .badges {
      justify-content: start;
    }
    .workflow-actions { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  .admin-page > header:not(.admin-nav) {
    align-items: center;
    border-bottom: 0;
    display: grid;
    justify-items: center;
    padding: 3.4rem 0 1.8rem;
    text-align: center;
  }
  .admin-page > header:not(.admin-nav) p {
    font-size: 0.72rem;
  }
  .admin-page h1 {
    font-size: clamp(1.9rem, 4vw, 2.5rem);
    margin: 0.35rem 0;
  }
  .admin-page > header:not(.admin-nav) span {
    font-size: 1rem;
    max-width: 48rem;
  }
  .admin-page > header:not(.admin-nav) a {
    border-radius: 0.65rem;
    margin-top: 0.8rem;
    padding: 0.75rem 1rem;
  }
  .filters {
    background: var(--background-secondary);
    border: 1px solid var(--border-default);
    border-radius: 1rem;
    gap: 0.7rem;
    margin: 0 auto 1.25rem;
    max-width: 60rem;
    padding: 1rem;
  }
  .filters input,
  .filters select {
    border-radius: 0.6rem;
    min-height: 2.75rem;
  }
  .list {
    margin: 0 auto;
    max-width: 60rem;
  }
  .article {
    background: var(--background-primary);
    border-radius: 0.65rem;
    padding: 0.7rem 0.85rem;
  }
  .article a {
    border: 1px solid var(--border-default);
    border-radius: 0.45rem;
    padding: 0.4rem 0.55rem;
  }
  .article a:hover {
    border-color: var(--accent-primary);
    background: var(--background-secondary);
  }
  @media (max-width: 600px) {
    .admin-page {
      padding: 0 0.8rem 3rem;
    }
    .admin-page > header:not(.admin-nav) {
      padding: 2.5rem 0 1.35rem;
    }
    .filters {
      border-radius: 0.75rem;
      padding: 0.8rem;
    }
    .admin-page > header:not(.admin-nav),
    .article {
      align-items: start;
      display: grid;
    }
    .badges {
      justify-content: start;
    }
  }
</style>
<style is:global>
  .admin-page > header.admin-nav a.admin-nav-brand {
    background: transparent;
    color: var(--accent-primary);
    padding: 0;
  }
  .admin-page > header.admin-nav nav > a {
    background: transparent;
    color: var(--text-primary);
    padding: 0 0.62rem;
  }
  .admin-page > header:not(.admin-nav) {
    width: min(100%, 60rem);
    margin-inline: auto;
  }
  .admin-page > header:not(.admin-nav) > div {
    width: 100%;
  }
  .list {
    gap: 0.28rem;
  }
  .article {
    gap: 0.45rem;
    padding: 0.55rem 0.7rem;
  }
  .article h2 {
    font-size: 0.93rem;
  }
  .article p {
    font-size: 0.72rem;
    margin-top: 0.18rem;
  }
  .badges {
    gap: 0.25rem;
  }
  .badge {
    font-size: 0.64rem;
    padding: 0.14rem 0.32rem;
  }
  .article {
    color: var(--text);
    cursor: pointer;
    text-decoration: none;
  }
  .article a,
  .article-link-label {
    font-size: 0.76rem;
  }
  .article:hover {
    border-color: var(--accent);
    box-shadow: 0 0.2rem 0.7rem #153c6615;
  }
  /* 他の管理ページと同じ左寄せの見出しに揃え、一覧の操作領域だけを中央幅にする。 */
  .admin-page > header:not(.admin-nav) {
    align-items: flex-start;
    border-bottom: 1px solid var(--border-default);
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-inline: 0;
    padding: 2rem 0 1.25rem;
    text-align: left;
    width: auto;
  }
  .admin-page > header:not(.admin-nav) > div {
    width: auto;
  }
  .admin-page > header:not(.admin-nav) span {
    display: block;
    max-width: 48rem;
  }
  @media (max-width: 600px) {
    .admin-page > header:not(.admin-nav) {
      align-items: start;
      display: grid;
      padding: 1.6rem 0 1.1rem;
    }
  }
</style>
<script>
  type Article={id:string;source_article_id?:string|null;subject:string;category:string;slug?:string;title:string;status:"draft"|"in-review"|"on-hold"|"approved";updated_at:string;published_at:string|null;created_by?:string;updated_by?:string;reviewer_email?:string|null};
  const initializeArticleIndex = () => {
    const root = document.querySelector<HTMLElement>("[data-article-index]");
    if (!root || root.dataset.ready === "true") return;
    root.dataset.ready = "true";
    const list = root.querySelector<HTMLElement>("[data-list]")!;
    const query = root.querySelector<HTMLInputElement>("[data-query]")!;
    const status = root.querySelector<HTMLSelectElement>("[data-status]")!;
    const publication = root.querySelector<HTMLSelectElement>("[data-public]")!;
    const test = root.querySelector<HTMLSelectElement>("[data-test]")!;
    const workflow = root.querySelector<HTMLSelectElement>("[data-workflow-filter]")!;
    const count = root.querySelector<HTMLOutputElement>("[data-count]")!;
    let items: Article[] = [];
    let scopeEmail = "";

    const requestedMode = new URLSearchParams(location.search).get("mode");
    if (requestedMode === "review" || requestedMode === "revise" || requestedMode === "request") workflow.value = requestedMode;
    const esc = (value: string) => value.replace(/[&<>"']/g, (character) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[character] ?? character));
    const labels = { draft: "下書き", "in-review": "フィードバック中", "on-hold": "保留", approved: "フィードバック済み" };
    const isTest = (article: Article) => /(^|[\\s_-])test($|[\\s_-])|テスト/i.test(article.title);
    const currentWorkflow = () => workflow.value as "all" | "revise" | "review" | "request";
    const updateWorkflowButtons = () => root.querySelectorAll<HTMLButtonElement>("[data-workflow-action]").forEach((button) => button.setAttribute("aria-pressed", String(button.dataset.workflowAction === currentWorkflow())));
    const render = () => {
      const mode = currentWorkflow();
      const normalizedQuery = query.value.toLowerCase();
      const filtered = items.filter((article) => (mode !== "review" || article.status !== "approved") && (mode !== "request" || ([article.created_by, article.updated_by].includes(scopeEmail) && article.status !== "approved" && !article.published_at)) && (status.value === "all" || article.status === status.value) && (publication.value === "all" || (publication.value === "published" ? Boolean(article.published_at) : !article.published_at)) && (test.value === "all" || (test.value === "only" ? isTest(article) : !isTest(article))) && `${article.title} ${article.subject} ${article.category}`.toLowerCase().includes(normalizedQuery));
      const sorted = [...filtered].sort((left, right) => {
        const leftPriority = (mode === "revise" || mode === "request") && [left.created_by, left.updated_by].includes(scopeEmail) ? 0 : mode === "review" && left.reviewer_email === scopeEmail ? 0 : 1;
        const rightPriority = (mode === "revise" || mode === "request") && [right.created_by, right.updated_by].includes(scopeEmail) ? 0 : mode === "review" && right.reviewer_email === scopeEmail ? 0 : 1;
        return leftPriority - rightPriority || new Date(right.updated_at).getTime() - new Date(left.updated_at).getTime();
      });
      const shown = [...new Map(sorted.map((article) => [article.source_article_id || `${article.subject}/${article.category}/${article.slug || article.title}`, article])).values()];
      count.textContent = `${shown.length}件`;
      list.innerHTML = shown.length ? shown.map((article) => `<article class="article" role="link" tabindex="0" data-href="/admin/editor/?document=${encodeURIComponent(article.id)}" aria-label="${esc(article.title || "無題の原稿")}を開く"><div><h2>${esc(article.title || "無題の原稿")}</h2><p>${esc(article.subject)} / ${esc(article.category)} ・ 最終更新 ${new Intl.DateTimeFormat("ja-JP", { dateStyle: "medium" }).format(new Date(article.updated_at))}${mode === "review" && article.reviewer_email === scopeEmail ? " ・ 自分へのフィードバック依頼" : ""}</p></div><div class="badges"><span class="badge ${article.status}">${labels[article.status]}</span>${isTest(article) ? '<span class="badge">テスト</span>' : ""}${article.published_at ? '<span class="badge published">公開済み</span>' : ""}</div></article>`).join("") : "<p>条件に一致する原稿はありません。</p>";
      updateWorkflowButtons();
    };
    const load = async () => {
      try {
        const response = await fetch("/api/admin/editor/documents", { credentials: "same-origin", cache: "no-store" });
        const contentType = response.headers.get("content-type") ?? "";
        const data = contentType.includes("application/json") ? await response.json() : {};
        if (!response.ok) throw Error(data.error ?? "認証情報を取得できませんでした。ページを再読み込みしてください。");
        items = data.documents ?? [];
        scopeEmail = data.scope?.email ?? "";
        render();
      } catch (error) {
        list.textContent = error instanceof Error ? error.message : "原稿一覧を取得できませんでした。";
      }
    };
    window.setTimeout(() => { if (list.textContent?.includes("取得しています")) list.textContent = "原稿一覧を取得できませんでした。ページを再読み込みしてください。"; }, 6_000);
    [query, status, publication, test, workflow].forEach((element) => element.addEventListener("input", render));
    root.querySelectorAll<HTMLButtonElement>("[data-workflow-action]").forEach((button) => button.addEventListener("click", () => {
      workflow.value = button.dataset.workflowAction ?? "all";
      history.replaceState({}, "", `${location.pathname}?mode=${encodeURIComponent(workflow.value)}#article-list`);
      render();
      root.querySelector("#article-list")?.scrollIntoView({ behavior: "smooth", block: "start" });
    }));
    void load();
  };
  document.addEventListener("astro:page-load", initializeArticleIndex);
  initializeArticleIndex();
</script>
<script>
  import { navigate } from "astro:transitions/client";

  document.addEventListener('astro:page-load', () => {
    const list = document.querySelector<HTMLElement>('[data-article-index] [data-list]');
    if (!list || list.dataset.tileLinksReady === 'true') return;
    list.dataset.tileLinksReady = 'true';
    const openCard = (card: HTMLElement | null) => { if (card?.dataset.href) void navigate(card.dataset.href); };
    list.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      const card = target.closest<HTMLElement>('.article');
      openCard(card);
    });
    list.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter' && event.key !== ' ') return;
      event.preventDefault();
      openCard((event.target as HTMLElement).closest<HTMLElement>('.article'));
    });
  });
</script>
