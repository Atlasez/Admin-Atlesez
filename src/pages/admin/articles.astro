---
import AdminLayout from "../../layouts/AdminLayout.astro";
import AdminRetryNotice from "../../components/admin/AdminRetryNotice.astro";
import { getCollection } from "astro:content";

const subjects = (await getCollection("subjects"))
  .sort((left, right) => left.data.order - right.data.order)
  .map((subject) => ({
    slug: subject.data.slug,
    name: subject.data.name.ja,
    categories: subject.data.categories
      .slice()
      .sort((left, right) => left.order - right.order),
  }));
const categoryMap = new Map<string, { slug: string; name: string; subjects: string[] }>();
for (const subject of subjects) {
  for (const category of subject.categories) {
    const existing = categoryMap.get(category.slug);
    if (existing) {
      if (!existing.subjects.includes(subject.slug)) existing.subjects.push(subject.slug);
    } else {
      categoryMap.set(category.slug, {
        slug: category.slug,
        name: category.name.ja,
        subjects: [subject.slug],
      });
    }
  }
}
const categories = [...categoryMap.values()].sort((left, right) =>
  left.name.localeCompare(right.name, "ja"),
);
const publicArticles = (await getCollection("articles"))
  .filter((article) => article.data.locale === "ja" && article.data.status === "published")
  .map((article) => ({
    articleId: article.data.articleId,
    subject: article.data.subject,
    category: article.data.category,
    slug: article.data.slug,
    title: article.data.title,
    updatedAt: article.data.updatedAt.toISOString(),
  }));
const publicArticlesPayload = JSON.stringify(publicArticles).replace(/</g, "\\u003c");
---

<AdminLayout title="編集・フィードバック" description="原稿の編集・フィードバックと状態管理">
  <main class="admin-page" data-article-index>
    <header>
      <div>
        <h1>編集・フィードバック</h1>
      </div>
    </header>
    <nav class="workflow-actions" aria-label="編集・フィードバックの作業入口">
      <a href="/admin/editor/?new=1&choose=1&from=articles"><strong>新規記事作成</strong></a>
      <button type="button" data-workflow-action="revise"><strong>加筆・修正</strong></button>
      <button type="button" data-workflow-action="review"><strong>フィードバック</strong></button>
    </nav>
    <section class="catalog-overview" aria-labelledby="catalog-overview-heading">
      <div class="catalog-overview__heading">
        <div>
          <h2 id="catalog-overview-heading">学習サイト公開記事との連携</h2>
          <p data-catalog-summary data-state="loading" aria-live="polite">公開記事カタログを確認しています…</p>
        </div>
        <div class="catalog-overview__tools">
          <button type="button" class="article-action" data-run-catalog-diagnostics>連携状態を診断</button>
          <button type="button" class="article-action" data-register-unregistered hidden>運営原稿を一括作成</button>
        </div>
      </div>
      <div class="catalog-statuses" data-catalog-counts aria-label="公開記事の運営原稿との連携状況"></div>
    </section>
    <details class="catalog-diagnostics" data-catalog-diagnostics hidden>
      <summary>公開記事カタログの診断結果</summary>
      <p data-catalog-diagnostics-summary>診断を実行してください。</p>
      <ul data-catalog-diagnostics-issues></ul>
    </details>
    <section class="filters" id="article-list" aria-label="原稿一覧の絞り込み">
      <div class="filters__primary">
        <label class="filter-control filter-control-search">
          <span>キーワード</span>
          <input data-query placeholder="タイトル・分野・カテゴリで検索" />
        </label>
        <label class="filter-control">
          <span>分野</span>
          <select data-subject disabled aria-busy="true">
            <option value="all">すべての分野</option>
            {subjects.map((subject) => <option value={subject.slug}>{subject.name}</option>)}
          </select>
        </label>
        <label class="filter-control">
          <span>カテゴリ</span>
          <select data-category>
            <option value="all">すべてのカテゴリ</option>
            {categories.map((category) => <option value={category.slug} data-subjects={category.subjects.join(",")}>{category.name}</option>)}
          </select>
        </label>
        <label class="filter-control">
          <span>編集状況</span>
          <select data-status>
            <option value="all">すべて</option>
            <option value="draft">下書き</option>
            <option value="in-review">フィードバック中</option>
            <option value="on-hold">保留</option>
            <option value="approved">フィードバック済み</option>
          </select>
        </label>
      </div>
      <section class="subject-browser" aria-labelledby="subject-browser-heading">
        <div class="subject-browser__heading">
          <div>
            <h2 id="subject-browser-heading">分野・カテゴリから探す</h2>
            <p data-subject-browser-summary>件数は現在の表示条件に一致する記事です。</p>
          </div>
          <button type="button" class="article-action" data-subject-browser-all>すべて表示</button>
        </div>
        <div class="subject-browser__items" data-subject-browser></div>
      </section>
      <div class="filters__result">
        <div>
          <output data-count aria-live="polite">—件</output>
          <span data-filter-summary>現在の表示条件</span>
        </div>
        <div class="filters__tools">
          <button type="button" class="article-action" data-reset-filters>条件をリセット</button>
          <details class="advanced-filters">
            <summary>詳細な絞り込み</summary>
            <div class="advanced-filters__grid">
              <label class="filter-control">
                <span>学習サイトの公開状況</span>
                <select data-public>
                  <option value="all">すべて</option>
                  <option value="published">公開中</option>
                  <option value="scheduled">公開予約済み</option>
                  <option value="unpublished">未公開</option>
                </select>
              </label>
              <label class="filter-control">
                <span>運営原稿との連携</span>
                <select data-linkage>
                  <option value="all">すべて</option>
                  <option value="managed">公開記事と連携済み</option>
                  <option value="needs-registration">原稿あり・公開記事ID未連携</option>
                  <option value="unmanaged">運営原稿未登録</option>
                  <option value="conflict">重複・紐付け要確認</option>
                  <option value="unknown">連携状態を判定できない</option>
                </select>
              </label>
              <label class="filter-control">
                <span>テスト原稿</span>
                <select data-test>
                  <option value="exclude">除く</option>
                  <option value="all">含める</option>
                  <option value="only">テスト原稿のみ</option>
                </select>
              </label>
              <label class="filter-control">
                <span>作業対象</span>
                <select data-workflow-filter aria-label="作業対象">
                  <option value="all">すべての原稿</option>
                  <option value="revise">自分が加筆・修正する記事</option>
                  <option value="review">フィードバック対象</option>
                  <option value="request">フィードバックを依頼する記事</option>
                </select>
              </label>
              <label class="filter-control">
                <span>アーカイブ</span>
                <select data-archive aria-label="アーカイブ表示">
                  <option value="active">未アーカイブ</option>
                  <option value="archived">アーカイブ済み</option>
                  <option value="all">すべて</option>
                </select>
              </label>
            </div>
          </details>
        </div>
      </div>
    </section>
    <p class="catalog-feedback" data-catalog-feedback role="status" aria-live="polite"></p>
    <section class="list loading-state" data-list data-admin-load-surface aria-busy="true">原稿一覧を取得しています…</section>
    <p class="article-scope-note" data-scope-note data-state="loading" role="status" aria-live="polite">担当範囲を確認しています…</p>
    <AdminRetryNotice />
    <div class="article-pagination" data-article-pagination hidden>
      <span data-article-pagination-status aria-live="polite"></span>
      <button type="button" class="article-action" data-article-load-more>次の原稿を読み込む</button>
    </div>
    <script is:inline type="application/json" data-public-articles set:html={publicArticlesPayload}></script>
  </main>
</AdminLayout>
