          if (state === "managed") totals.managed += 1;
          else if (state === "needs-registration") totals["needs-registration"] += 1;
          else if (state === "unmanaged") totals.unmanaged += 1;
          else if (state === "duplicate" || state === "identity-conflict") totals.conflict += 1;
          else totals.unknown += 1;
        }
        const metrics = [
          { value: "managed", label: "公開記事と連携済み", note: "運営原稿あり", count: totals.managed, tone: "linked" },
          { value: "needs-registration", label: "原稿あり・未連携", note: "公開記事IDの確認が必要", count: totals["needs-registration"], tone: "needs-registration" },
          { value: "unmanaged", label: "運営原稿未登録", note: "公開記事から原稿を作成できます", count: totals.unmanaged, tone: "unmanaged" },
          { value: "conflict", label: "重複・紐付け要確認", note: "対応する原稿を確認してください", count: totals.conflict, tone: "conflict" },
