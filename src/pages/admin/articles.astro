<script>
  type Article={id:string;source_article_id?:string|null;subject:string;category:string;slug?:string;title:string;status:"draft"|"in-review"|"on-hold"|"approved";updated_at:string;published_at:string|null;archived_at?:string|null;archive_expires_at?:string|null;created_by?:string;updated_by?:string;reviewer_email?:string|null;active_editors?:Array<{sessionId:string;email:string;displayName:string;field:string}>};
  type PublicArticle={articleId:string;subject:string;category:string;slug:string;title:string;updatedAt:string};
  type PublicArticleCatalogEntry={locale?:unknown;public_status?:unknown;source_article_id?:unknown;subject?:unknown;category?:unknown;slug?:unknown;title?:unknown;public_updated_at?:unknown;editorial_updated_at?:unknown};
  type CatalogRow={kind:"editorial";article:Article;publicArticle?:PublicArticle;management:"managed"} | {kind:"unregistered";publicArticle:PublicArticle;management:"unregistered"} | {kind:"registered";publicArticle:PublicArticle;documentId?:string;management:"managed"};
  const initializeArticleIndex = () => {
    const root = document.querySelector<HTMLElement>("[data-article-index]");
    if (!root || root.dataset.ready === "true") return;
    root.dataset.ready = "true";
    const list = root.querySelector<HTMLElement>("[data-list]")!;
    const query = root.querySelector<HTMLInputElement>("[data-query]")!;
    const subject = root.querySelector<HTMLSelectElement>("[data-subject]")!;
    const category = root.querySelector<HTMLSelectElement>("[data-category]")!;
    const status = root.querySelector<HTMLSelectElement>("[data-status]")!;
    const publication = root.querySelector<HTMLSelectElement>("[data-public]")!;
    const management = root.querySelector<HTMLSelectElement>("[data-management]")!;
    const test = root.querySelector<HTMLSelectElement>("[data-test]")!;
    const workflow = root.querySelector<HTMLSelectElement>("[data-workflow-filter]")!;
    const archive = root.querySelector<HTMLSelectElement>("[data-archive]")!;
    const count = root.querySelector<HTMLOutputElement>("[data-count]")!;
    const catalogSummary = root.querySelector<HTMLElement>("[data-catalog-summary]")!;
    const catalogFeedback = root.querySelector<HTMLElement>("[data-catalog-feedback]")!;
    const catalogElement = root.querySelector<HTMLScriptElement>("[data-public-articles]");
    let publicArticles = catalogElement ? JSON.parse(catalogElement.textContent ?? "[]") as PublicArticle[] : [];
    let catalogSource: "api" | "static" = "static";
    const registeredPublicArticleIds = new Map<string, string | undefined>();
    let items: Article[] = [];
    let scopeEmail = "";

    const requestedMode = new URLSearchParams(location.search).get("mode");
    if (requestedMode === "review" || requestedMode === "revise" || requestedMode === "request") workflow.value = requestedMode;
    const esc = (value: string) => value.replace(/[&<>"']/g, (character) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[character] ?? character));
    const labels = { draft: "下書き", "in-review": "フィードバック中", "on-hold": "保留", approved: "フィードバック済み" };
    const assignedToScope = (article: Article) => article.reviewer_email?.split(",").some((email) => email.trim().toLowerCase() === scopeEmail.toLowerCase()) ?? false;
    const activeEditorFieldLabels: Record<string, string> = { title: "タイトル", summary: "要約", body: "本文" };
    const activeEditorsFor = (article: Article) => (article.active_editors ?? []).filter((editor) => editor && typeof editor.displayName === "string");
    const activeEditorLabel = (editor: { displayName: string; email: string; field: string }) => {
      const name = editor.displayName.trim() || editor.email.split("@")[0] || "メンバー";
      const field = activeEditorFieldLabels[editor.field];
      return `${name}${field ? `（${field}）` : ""}`;
    };
    const activeEditorSummary = (article: Article) => {
      const editors = activeEditorsFor(article);
      if (!editors.length) return "";
      const labels = editors.slice(0, 3).map(activeEditorLabel);
      if (editors.length > labels.length) labels.push(`ほか${editors.length - labels.length}人`);
      return `編集中：${labels.join("、")}`;
    };
    const currentWorkflow = () => workflow.value as "all" | "revise" | "review" | "request";
    const isArchived = (article: Article) => Boolean(article.archived_at);
    const archiveExpired = (article: Article) => Boolean(article.archive_expires_at && Date.parse(article.archive_expires_at) <= Date.now());
    const updateCategoryOptions = () => {
      const selectedSubject = subject.value;
      const selectedCategory = category.value;
      for (const option of category.options) {
        if (option.value === "all") {
          option.hidden = false;
          continue;
        }
        const subjectsForCategory = option.dataset.subjects?.split(",") ?? [];
        option.hidden = selectedSubject !== "all" && !subjectsForCategory.includes(selectedSubject);
      }
      if (selectedCategory !== "all" && category.selectedOptions[0]?.hidden) category.value = "all";
    };
    const updateWorkflowButtons = () => root.querySelectorAll<HTMLButtonElement>("[data-workflow-action]").forEach((button) => button.setAttribute("aria-pressed", String(button.dataset.workflowAction === currentWorkflow())));
    const publicArticleKey = (article: PublicArticle) => `${article.subject}/${article.category}/${article.slug}`;
    const catalogRows = (): CatalogRow[] => {
      const rows: CatalogRow[] = items.map((article) => ({ kind: "editorial", article, publicArticle: publicArticles.find((source) => article.source_article_id === source.articleId || publicArticleKey(source) === `${article.subject}/${article.category}/${article.slug}`), management: "managed" }));
      const managedKeys = new Set(rows.flatMap((row) => row.publicArticle ? [publicArticleKey(row.publicArticle)] : []));
      for (const publicArticle of publicArticles) {
        const key = publicArticleKey(publicArticle);
        if (managedKeys.has(key)) continue;
        if (registeredPublicArticleIds.has(key)) rows.push({ kind: "registered", publicArticle, documentId: registeredPublicArticleIds.get(key), management: "managed" });
        else rows.push({ kind: "unregistered", publicArticle, management: "unregistered" });
      }
      return rows;
    };
    const isTestTitle = (title: string) => /(^|[\s_-])test($|[\s_-])|テスト/i.test(title);
    const rowTitle = (row: CatalogRow) => row.kind === "editorial" ? row.article.title : row.publicArticle.title;
    const rowSubject = (row: CatalogRow) => row.kind === "editorial" ? row.article.subject : row.publicArticle.subject;
    const rowCategory = (row: CatalogRow) => row.kind === "editorial" ? row.article.category : row.publicArticle.category;
    const rowUpdatedAt = (row: CatalogRow) => row.kind === "editorial" ? row.article.updated_at : row.publicArticle.updatedAt;
    const render = () => {
      const mode = currentWorkflow();
      const normalizedQuery = query.value.toLowerCase();
      const rows = catalogRows();
      const registeredCount = rows.filter((row) => (row.kind === "editorial" && row.publicArticle) || row.kind === "registered").length;
      const unregisteredCount = rows.filter((row) => row.kind === "unregistered").length;
      catalogSummary.textContent = `公開記事 ${publicArticles.length}件 ・ 運営原稿と紐付け済み ${registeredCount}件 ・ 未登録 ${unregisteredCount}件（${catalogSource === "api" ? "APIカタログ" : "静的データ"}）`;
      const filtered = rows.filter((row) => {
        const isUnregistered = row.kind === "unregistered";
        const article = row.kind === "editorial" ? row.article : null;
        if (isUnregistered && mode !== "all") return false;
        if (article && archive.value === "active" && isArchived(article)) return false;
        if (article && archive.value === "archived" && !isArchived(article)) return false;
        if (article && mode === "review" && article.status === "approved") return false;
        if (article && mode === "request" && !([article.created_by, article.updated_by].includes(scopeEmail) && article.status !== "approved" && !article.published_at)) return false;
        if (subject.value !== "all" && rowSubject(row) !== subject.value) return false;
        if (category.value !== "all" && rowCategory(row) !== category.value) return false;
        if (status.value !== "all" && (!article || article.status !== status.value)) return false;
        if (management.value !== "all" && row.management !== management.value) return false;
        if (publication.value === "published" && (isUnregistered ? true : !article?.published_at)) return false;
        if (publication.value === "unpublished" && (isUnregistered || Boolean(article?.published_at))) return false;
        const testMatch = isTestTitle(rowTitle(row));
        if (test.value === "only" && !testMatch) return false;
        if (test.value === "exclude" && testMatch) return false;
        return `${rowTitle(row)} ${rowSubject(row)} ${rowCategory(row)}`.toLowerCase().includes(normalizedQuery);
      });
      const sorted = [...filtered].sort((left, right) => {
        const leftArticle = left.kind === "editorial" ? left.article : null;
        const rightArticle = right.kind === "editorial" ? right.article : null;
        const leftPriority = leftArticle && (mode === "revise" || mode === "request") && [leftArticle.created_by, leftArticle.updated_by].includes(scopeEmail) ? 0 : leftArticle && mode === "review" && assignedToScope(leftArticle) ? 0 : left.kind === "unregistered" ? 2 : 1;
        const rightPriority = rightArticle && (mode === "revise" || mode === "request") && [rightArticle.created_by, rightArticle.updated_by].includes(scopeEmail) ? 0 : rightArticle && mode === "review" && assignedToScope(rightArticle) ? 0 : right.kind === "unregistered" ? 2 : 1;
        return leftPriority - rightPriority || new Date(rowUpdatedAt(right)).getTime() - new Date(rowUpdatedAt(left)).getTime();
      });
      // 公開記事由来の原稿だけは source_article_id または公開パスでまとめる。
      // 未登録の公開記事も同じ一覧に補い、公開記事の管理漏れを見える化する。
      const shown = [...new Map(sorted.map((row) => [row.kind === "editorial" ? row.article.source_article_id || row.article.id : `public:${row.publicArticle.articleId}`, row])).values()];
      count.textContent = `${shown.length}件`;
      const formatDate = (value: string) => new Intl.DateTimeFormat("ja-JP", { dateStyle: "medium" }).format(new Date(value));
      list.innerHTML = shown.length ? shown.map((row) => {
        if (row.kind === "unregistered") return `<article class="article article-unregistered" aria-label="${esc(row.publicArticle.title)}は公開済み・運営管理未登録"><div><h2>${esc(row.publicArticle.title)}</h2><p>${esc(row.publicArticle.subject)} / ${esc(row.publicArticle.category)} ・ 学習サイトで公開中 ・ 最終更新 ${formatDate(row.publicArticle.updatedAt)}</p></div><div class="badges"><span class="badge published">公開済み</span><span class="badge unregistered">運営管理未登録</span><a class="catalog-action" href="/admin/editor/?sourceArticle=${encodeURIComponent(row.publicArticle.articleId)}&from=articles" data-register-link data-article-id="${esc(row.publicArticle.articleId)}" data-catalog-subject="${esc(row.publicArticle.subject)}" data-catalog-category="${esc(row.publicArticle.category)}" data-catalog-slug="${esc(row.publicArticle.slug)}">運営管理へ登録</a></div></article>`;
        if (row.kind === "registered") return `<article class="article article-unregistered" aria-label="${esc(row.publicArticle.title)}は公開済み・運営管理登録済み"><div><h2>${esc(row.publicArticle.title)}</h2><p>${esc(row.publicArticle.subject)} / ${esc(row.publicArticle.category)} ・ 学習サイトで公開中 ・ 最終更新 ${formatDate(row.publicArticle.updatedAt)}</p></div><div class="badges"><span class="badge published">公開済み</span><span class="badge published">運営管理登録済み</span>${row.documentId ? `<a class="catalog-action" href="/admin/editor/?document=${encodeURIComponent(row.documentId)}&mode=update&from=articles">更新案を作成</a>` : '<span class="badge">運営原稿を準備中</span>'}</div></article>`;
        const article = row.article;
        const editing = activeEditorsFor(article);
        const editingSummary = activeEditorSummary(article);
        const editingBadge = editing.length ? `<span class="badge editing" aria-label="${editing.length}人が編集中">● ${editing.length}人が編集中</span>` : "";
        const archiveBadge = isArchived(article) ? `<span class="badge archived">アーカイブ済み</span>` : "";
        const archiveSummary = isArchived(article) && article.archive_expires_at ? ` ・ 復元期限 ${new Intl.DateTimeFormat("ja-JP", { dateStyle: "medium" }).format(new Date(article.archive_expires_at))}` : "";
        const archiveAction = article.status === "draft" && !article.published_at ? (isArchived(article) ? (archiveExpired(article) ? '<button type="button" class="article-action" disabled title="アーカイブ期限を過ぎています">期限切れ</button>' : `<button type="button" class="article-action" data-archive-action="unarchive" data-archive-document-id="${esc(article.id)}">復元</button>`) : `<button type="button" class="article-action" data-archive-action="archive" data-archive-document-id="${esc(article.id)}">アーカイブ</button>`) : "";
        const updateAction = article.published_at ? `<a class="catalog-action" href="/admin/editor/?document=${encodeURIComponent(article.id)}&mode=update&from=articles" aria-label="${esc(article.title || "無題の記事")}の更新案を作成">更新案を作成</a>` : "";
        return `<article class="article" role="link" tabindex="0" data-document-id="${esc(article.id)}" data-href="/admin/editor/?document=${encodeURIComponent(article.id)}" aria-label="${esc(article.title || "無題の原稿")}を開く${editingSummary ? `・${esc(editingSummary)}` : ""}"><div><h2>${esc(article.title || "無題の原稿")}</h2><p>${esc(article.subject)} / ${esc(article.category)} ・ 最終更新 ${formatDate(article.updated_at)}${archiveSummary}${mode === "review" && assignedToScope(article) ? " ・ 自分へのフィードバック依頼" : ""}${editingSummary ? `<span class="article-presence" data-active-editors="${esc(article.id)}"><span class="presence-dot" aria-hidden="true"></span>${esc(editingSummary)}</span>` : ""}</p></div><div class="article-actions"><div class="badges">${editingBadge}<span class="badge ${article.status}">${labels[article.status]}</span>${archiveBadge}${isTestTitle(article.title) ? '<span class="badge">テスト</span>' : ""}${article.published_at ? '<span class="badge published">公開済み・運営管理中</span>' : ""}</div>${archiveAction}${updateAction}</div></article>`;
      }).join("") : "<p>条件に一致する原稿はありません。</p>";
      updateWorkflowButtons();
    };
    const normalizeCatalog = (raw: unknown): PublicArticle[] | null => {
      if (!Array.isArray(raw)) return null;
      return raw.flatMap((item) => {
        if (!item || typeof item !== "object") return [];
        const entry = item as PublicArticleCatalogEntry;
        const locale = typeof entry.locale === "string" ? entry.locale : "";
        const publicStatus = typeof entry.public_status === "string" ? entry.public_status : "";
        const articleId = typeof entry.source_article_id === "string" ? entry.source_article_id : "";
        const subject = typeof entry.subject === "string" ? entry.subject : "";
        const category = typeof entry.category === "string" ? entry.category : "";
        const slug = typeof entry.slug === "string" ? entry.slug : "";
        const title = typeof entry.title === "string" ? entry.title : "";
        if (locale !== "ja" || publicStatus !== "published" || !articleId || !subject || !category || !slug || !title) return [];
        const updatedAt = typeof entry.public_updated_at === "string" ? entry.public_updated_at : typeof entry.editorial_updated_at === "string" ? entry.editorial_updated_at : new Date().toISOString();
        return [{ articleId, subject, category, slug, title, updatedAt }];
      });
    };
    const loadCatalog = async () => {
      try {
        const response = await fetch("/api/admin/editor/catalog", { credentials: "same-origin", cache: "no-store" });
        const contentType = response.headers.get("content-type") ?? "";
        const data = contentType.includes("application/json") ? await response.json() as { catalog?: unknown[]; error?: string } : {};
        if (!response.ok) throw new Error(data.error ?? `公開記事カタログを取得できませんでした（${response.status}）。`);
        const normalized = normalizeCatalog(data.catalog);
        if (!normalized) throw new Error("公開記事カタログの形式を確認できませんでした。");
        publicArticles = normalized;
        catalogSource = "api";
      } catch (error) {
        // APIに接続できない場合は、ビルド時の古いカタログを混ぜない。
        // 原稿一覧の状態と公開サイトの状態が食い違うため、未確認の公開記事を
        // 運営原稿として表示するよりも、カタログを空にして診断を促す。
        publicArticles = [];
        catalogSource = "static";
        setCatalogFeedback(`公開記事カタログAPIに接続できないため、公開記事カタログを表示できません。${error instanceof Error ? `（${error.message}）` : ""}`);
      }
    };
    const load = async () => {
      try {
        const includeArchived = archive.value !== "active";
        const response = await fetch(`/api/admin/editor/documents${includeArchived ? "?includeArchived=1" : ""}`, { credentials: "same-origin", cache: "no-store" });
        const catalogPromise = loadCatalog();
        const contentType = response.headers.get("content-type") ?? "";
        const data = contentType.includes("application/json") ? await response.json() : {};
        if (!response.ok) throw Error(data.error ?? "認証情報を取得できませんでした。ページを再読み込みしてください。");
        items = data.documents ?? [];
        scopeEmail = data.scope?.email ?? "";
        await catalogPromise;
        render();
      } catch (error) {
        list.textContent = error instanceof Error ? error.message : "原稿一覧を取得できませんでした。";
      }
    };
    const setCatalogFeedback = (message: string, isError = false) => {
      catalogFeedback.textContent = message;
      catalogFeedback.classList.toggle("is-error", isError);
    };
    const readApiResponse = async <T extends { error?: string }>(response: Response): Promise<T> => {
      const contentType = response.headers.get("content-type") ?? "";
      if (contentType.includes("application/json")) return await response.json() as T;
      const text = await response.text();
      return { error: text || undefined } as T;
    };
    const registerPublicArticle = async (link: HTMLAnchorElement) => {
      const articleId = link.dataset.articleId;
      const source = publicArticles.find((article) => article.articleId === articleId);
      if (!source || link.dataset.registering === "true") return;
      link.dataset.registering = "true";
      link.setAttribute("aria-busy", "true");
      link.classList.add("is-loading");
      link.textContent = "登録中…";
      setCatalogFeedback("");
      try {
        const response = await fetch("/api/admin/editor/catalog/register", {
          method: "POST",
          headers: { "content-type": "application/json" },
          credentials: "same-origin",
          body: JSON.stringify({ locale: "ja", subject: source.subject, category: source.category, slug: source.slug }),
        });
        const data = await readApiResponse<{ ok?: boolean; registered?: boolean; documentId?: string; identityKey?: string; error?: string }>(response);
        if (!response.ok || data.ok !== true) throw new Error(data.error ?? "公開記事を運営管理へ登録できませんでした。");
        registeredPublicArticleIds.set(publicArticleKey(source), data.documentId);
        setCatalogFeedback(data.registered === false ? `「${source.title}」はすでに運営管理へ登録されています。外部公開やPRは開始していません。` : `「${source.title}」を運営管理へ登録しました。外部公開やPRは開始していません。`);
        await load();
      } catch (error) {
        setCatalogFeedback(error instanceof Error ? error.message : "公開記事を運営管理へ登録できませんでした。", true);
        link.textContent = "運営管理へ登録";
      } finally {
        delete link.dataset.registering;
        link.removeAttribute("aria-busy");
        link.classList.remove("is-loading");
      }
    };
    window.setTimeout(() => { if (list.textContent?.includes("取得しています")) list.textContent = "原稿一覧を取得できませんでした。ページを再読み込みしてください。"; }, 6_000);
    subject.addEventListener("change", () => { updateCategoryOptions(); render(); });
    [query, category, status, publication, test, workflow, archive].forEach((element) => element.addEventListener("input", render));
    archive.addEventListener("change", () => { void load(); });
    list.addEventListener("click", async (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-archive-action]");
      if (!button) return;
      event.preventDefault();
      const documentId = button.dataset.archiveDocumentId;
      const action = button.dataset.archiveAction;
      if (!documentId || (action !== "archive" && action !== "unarchive")) return;
      button.disabled = true;
      try {
        const response = await fetch(`/api/admin/editor/documents/${encodeURIComponent(documentId)}/${action}`, { method: "POST", credentials: "same-origin", headers: { "content-type": "application/json" } });
        const data = await response.json().catch(() => ({}));
        if (!response.ok) throw Error(data.error ?? "アーカイブ操作に失敗しました。");
        const article = items.find((item) => item.id === documentId);
        if (article) {
          article.archived_at = data.archived_at ?? null;
          article.archive_expires_at = data.archive_expires_at ?? null;
        }
        render();
      } catch (error) {
        button.disabled = false;
        window.alert(error instanceof Error ? error.message : "アーカイブ操作に失敗しました。");
      }
    });
    [query, category, status, publication, management, test, workflow, archive].forEach((element) => element.addEventListener("input", render));
    root.querySelectorAll<HTMLButtonElement>("[data-workflow-action]").forEach((button) => button.addEventListener("click", () => {
      workflow.value = button.dataset.workflowAction ?? "all";
      history.replaceState({}, "", `${location.pathname}?mode=${encodeURIComponent(workflow.value)}#article-list`);
      render();
      root.querySelector("#article-list")?.scrollIntoView({ behavior: "smooth", block: "start" });
    }));
    updateCategoryOptions();
    void load();
    list.addEventListener("click", (event) => {
      const link = (event.target as HTMLElement).closest<HTMLAnchorElement>("a[data-register-link]");
      if (!link) return;
      event.preventDefault();
      void registerPublicArticle(link);
    });
    window.addEventListener("pageshow", () => { void load(); });
    const refreshPresence = () => { if (document.visibilityState === "visible") void load(); };
    window.setInterval(refreshPresence, 15_000);
    document.addEventListener("visibilitychange", refreshPresence);
  };
  document.addEventListener("astro:page-load", initializeArticleIndex);
  initializeArticleIndex();
</script>
<script>
  import { navigate } from "astro:transitions/client";

  document.addEventListener('astro:page-load', () => {
    const list = document.querySelector<HTMLElement>('[data-article-index] [data-list]');
    if (!list || list.dataset.tileLinksReady === 'true') return;
    list.dataset.tileLinksReady = 'true';
    const openCard = (card: HTMLElement | null) => { if (card?.dataset.href) void navigate(card.dataset.href); };
    list.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      if (target.closest('[data-archive-action]')) return;
      if (target.closest('a, button')) return;
      const card = target.closest<HTMLElement>('.article');
      openCard(card);
    });
    list.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter' && event.key !== ' ') return;
      event.preventDefault();
      openCard((event.target as HTMLElement).closest<HTMLElement>('.article'));
    });
  });
</script>
