---
import AdminLayout from "../../layouts/AdminLayout.astro";
import AdminNav from "../../components/AdminNav.astro";
import AdminErrorActions from "../../components/AdminErrorActions.astro";
---
<AdminLayout title="編集・査読" description="記事の作成、加筆・修正、査読をまとめて管理">
  <main class="admin-page" data-article-index>
    <AdminNav current="articles" />
    <AdminErrorActions />
    <header><div><p>ATLASEZ / 原稿管理</p><h1>編集・査読</h1><span>記事の作成、加筆・修正、査読をここから始められます。</span></div></header>
    <nav class="workflow-grid" aria-label="記事作業を選択">
      <a class="workflow-card workflow-card-primary" href="/admin/editor/?new=1"><strong>新規記事作成</strong><small>新しい記事を書き始める</small><span class="workflow-card-action">作成する →</span></a>
      <a class="workflow-card" href="/admin/articles/?workflow=edit"><strong>加筆・修正</strong><small>自分が関わった記事を優先して表示</small><span class="workflow-card-action">記事を選ぶ →</span></a>
      <a class="workflow-card" href="/admin/articles/?workflow=review"><strong>査読</strong><small>査読前の記事を優先して表示</small><span class="workflow-card-action">査読する →</span></a>
    </nav>
    <p class="workflow-note" data-workflow-note hidden></p>
    <section class="filters"><input data-query placeholder="タイトル・分野・カテゴリで検索" /><select data-status><option value="all">すべての状態</option><option value="draft">下書き</option><option value="in-review">査読中</option><option value="on-hold">保留</option><option value="approved">査読済み</option></select><select data-public><option value="all">公開状況：すべて</option><option value="published">公開済み</option><option value="unpublished">未公開</option></select><select data-review-filter aria-label="査読担当で絞り込み"><option value="all">査読担当：すべて</option><option value="mine">自分への依頼</option><option value="unassigned">未担当</option></select><select data-test><option value="exclude">テスト原稿を除く</option><option value="all">テスト原稿を含む</option><option value="only">テスト原稿のみ</option></select><output data-count></output></section>
    <section class="list" data-list>原稿一覧を取得しています…</section>
  </main>
</AdminLayout>
<style is:global>
.admin-page{margin:0 auto;max-width:1200px;padding:0 1.25rem 4rem}.admin-page > header:not(.admin-nav){align-items:end;border-bottom:1px solid var(--border-default);display:flex;justify-content:space-between;gap:1rem;padding:2rem 0 1.25rem}.admin-page > header:not(.admin-nav) p{color:var(--accent-primary);font-size:.76rem;font-weight:800;letter-spacing:.08em;margin:0}.admin-page h1{font-size:2rem;margin:.25rem 0}.admin-page > header:not(.admin-nav) span{color:var(--text-secondary)}.admin-page > header:not(.admin-nav) a{background:var(--accent-primary);color:#fff;font-weight:800;padding:.65rem .85rem;text-decoration:none}.filters{display:flex;flex-wrap:wrap;gap:.6rem;margin:1.25rem 0}.filters input,.filters select{background:var(--background-primary);border:1px solid var(--border-default);font:inherit;padding:.65rem}.filters input{flex:1 1 18rem}.filters output{align-self:center;color:var(--text-secondary);font-size:.82rem}.list{display:grid;gap:.45rem}.article{align-items:center;border:1px solid var(--border-default);display:grid;gap:.6rem;grid-template-columns:1fr auto;padding:.8rem .9rem}.article:hover{border-color:var(--accent-primary)}.article h2{font-size:1rem;margin:0}.article p{color:var(--text-secondary);font-size:.78rem;margin:.3rem 0 0}.article a{color:var(--accent-primary);font-size:.82rem;font-weight:800;text-decoration:none}.badges{display:flex;gap:.35rem;justify-content:end}.badge{border:1px solid var(--border-default);border-radius:999px;font-size:.68rem;font-weight:800;padding:.18rem .4rem}.draft{background:#edf1f5}.in-review{background:#fff0c6}.on-hold{background:#f5e5e7}.approved{background:#def4e6}.published{background:#e7f1fb;color:#185c86}.assigned{background:#e7f1fb;border-color:#7aaed0;color:#185c86}@media(max-width:600px){.admin-page{padding:0 .8rem 3rem}.admin-page > header:not(.admin-nav),.article{align-items:start;display:grid}.badges{justify-content:start}}
.admin-page > header:not(.admin-nav){align-items:center;border-bottom:0;display:grid;justify-items:center;padding:3.4rem 0 1.8rem;text-align:center}.admin-page > header:not(.admin-nav) p{font-size:.72rem}.admin-page h1{font-size:clamp(1.9rem,4vw,2.5rem);margin:.35rem 0}.admin-page > header:not(.admin-nav) span{font-size:1rem;max-width:48rem}.admin-page > header:not(.admin-nav) a{border-radius:.65rem;margin-top:.8rem;padding:.75rem 1rem}.filters{background:var(--background-secondary);border:1px solid var(--border-default);border-radius:1rem;gap:.7rem;margin:0 auto 1.25rem;max-width:60rem;padding:1rem}.filters input,.filters select{border-radius:.6rem;min-height:2.75rem}.list{margin:0 auto;max-width:60rem}.article{background:var(--background-primary);border-radius:.65rem;padding:.7rem .85rem}.article a{border:1px solid var(--border-default);border-radius:.45rem;padding:.4rem .55rem}.article a:hover{border-color:var(--accent-primary);background:var(--background-secondary)}@media(max-width:600px){.admin-page{padding:0 .8rem 3rem}.admin-page > header:not(.admin-nav){padding:2.5rem 0 1.35rem}.filters{border-radius:.75rem;padding:.8rem}.admin-page > header:not(.admin-nav),.article{align-items:start;display:grid}.badges{justify-content:start}}
</style>
<style is:global>
  .workflow-grid{display:grid;gap:.8rem;grid-template-columns:repeat(3,minmax(0,1fr));margin:1.35rem auto 1.15rem;max-width:60rem}
  .workflow-card{background:var(--background-secondary);border:1px solid var(--border-default);border-top:3px solid var(--accent-primary);border-radius:.8rem;color:var(--text-primary);display:grid;gap:.35rem;min-height:9rem;padding:1.1rem;text-decoration:none;transition:border-color .15s ease,box-shadow .15s ease,transform .15s ease}
  .workflow-card:hover,.workflow-card:focus-visible{border-color:var(--accent-primary);box-shadow:0 .35rem 1rem #153c6620;transform:translateY(-2px)}
  .workflow-card-primary{background:var(--accent-primary);border-color:var(--accent-primary);color:#fff}
  .workflow-card-kicker{font-size:.68rem;font-weight:900;letter-spacing:.08em;opacity:.72}.workflow-card strong{font-size:1.15rem}.workflow-card small{color:var(--text-secondary);font-size:.76rem;line-height:1.45}.workflow-card-primary small{color:#fff;opacity:.86}.workflow-card-action{color:var(--accent-primary);font-size:.76rem;font-weight:900;margin-top:auto}.workflow-card-primary .workflow-card-action{color:#fff}.workflow-note{color:var(--accent-primary);font-size:.78rem;font-weight:800;margin:0 auto .8rem;max-width:60rem}.workflow-note[hidden]{display:none}
  @media(max-width:720px){.workflow-grid{grid-template-columns:1fr}.workflow-card{min-height:auto}.workflow-card strong{font-size:1.05rem}}
</style>
<style is:global>
  .admin-page > header.admin-nav a.admin-nav-brand { background: transparent; color: var(--accent-primary); padding: 0; }
  .admin-page > header.admin-nav nav > a { background: transparent; color: var(--text-primary); padding: 0 .62rem; }
  .admin-page > header:not(.admin-nav) { width: min(100%, 60rem); margin-inline: auto; }
  .admin-page > header:not(.admin-nav) > div { width: 100%; }
  .list { gap: .28rem; }
  .article { gap: .45rem; padding: .55rem .7rem; }
  .article h2 { font-size: .93rem; }
  .article p { font-size: .72rem; margin-top: .18rem; }
  .badges { gap: .25rem; }
  .badge { font-size: .64rem; padding: .14rem .32rem; }
  .article { color: var(--text); cursor: pointer; text-decoration: none; }
  .article a, .article-link-label { font-size: .76rem; }
  .article:hover { border-color: var(--accent); box-shadow: 0 .2rem .7rem #153c6615; }
  /* 他の管理ページと同じ左寄せの見出しに揃え、一覧の操作領域だけを中央幅にする。 */
  .admin-page > header:not(.admin-nav) {
    align-items: flex-start;
    border-bottom: 1px solid var(--border-default);
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-inline: 0;
    padding: 2rem 0 1.25rem;
    text-align: left;
    width: auto;
  }
  .admin-page > header:not(.admin-nav) > div { width: auto; }
  .admin-page > header:not(.admin-nav) span { display: block; max-width: 48rem; }
  @media(max-width:600px){
    .admin-page > header:not(.admin-nav) { align-items: start; display: grid; padding: 1.6rem 0 1.1rem; }
  }
</style>
<script>
type Article={id:string;source_article_id?:string|null;subject:string;category:string;slug?:string;title:string;status:"draft"|"in-review"|"on-hold"|"approved";updated_at:string;published_at:string|null;created_by?:string|null;updated_by?:string|null;reviewAssignedToMe?:boolean;reviewAssigned?:boolean;reviewDueAt?:string|null};
const initializeArticleIndex=()=>{const root=document.querySelector<HTMLElement>("[data-article-index]");if(!root||root.dataset.ready==='true')return;root.dataset.ready='true';const list=root.querySelector<HTMLElement>("[data-list]")!,query=root.querySelector<HTMLInputElement>("[data-query]")!,status=root.querySelector<HTMLSelectElement>("[data-status]")!,pub=root.querySelector<HTMLSelectElement>("[data-public]")!,reviewFilter=root.querySelector<HTMLSelectElement>("[data-review-filter]")!,test=root.querySelector<HTMLSelectElement>("[data-test]")!,count=root.querySelector<HTMLOutputElement>("[data-count]")!,note=root.querySelector<HTMLElement>("[data-workflow-note]")!;let items:Article[]=[];let currentEmail="";const workflow=new URLSearchParams(window.location.search).get("workflow");const esc=(v:string)=>v.replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#39;"}[c]??c));const showError=(message:string)=>{list.textContent=message;window.dispatchEvent(new CustomEvent("atlasez-admin-error",{detail:{message}}));};const labels={draft:"下書き","in-review":"査読中","on-hold":"保留",approved:"査読済み"};const isTest=(x:Article)=>/(^|[\\s_-])test($|[\\s_-])|テスト/i.test(x.title);const priority=(x:Article)=>workflow==="edit"?((x.created_by===currentEmail?3:0)+(x.updated_by===currentEmail?2:0)):workflow==="review"?((x.reviewAssignedToMe?8:0)+(x.status==="in-review"?4:0)+(x.status!=="approved"?2:0)+(x.updated_by!==currentEmail?1:0)):0;const render=()=>{const q=query.value.toLowerCase();const filtered=items.filter(x=>(workflow!=="review"||x.status!=="approved")&&(status.value==="all"||x.status===status.value)&&(pub.value==="all"||(pub.value==="published"?!!x.published_at:!x.published_at))&&(reviewFilter.value==="all"||(reviewFilter.value==="mine"&&x.reviewAssignedToMe)||(reviewFilter.value==="unassigned"&&!x.reviewAssigned))&&(test.value==="all"||(test.value==="only"?isTest(x):!isTest(x)))&&`${x.title} ${x.subject} ${x.category}`.toLowerCase().includes(q));const shown=[...new Map(filtered.map(x=>[x.source_article_id||`${x.subject}/${x.category}/${x.slug||x.title}`,x])).values()].sort((a,b)=>priority(b)-priority(a)||b.updated_at.localeCompare(a.updated_at));count.textContent=`${shown.length}件`;list.innerHTML=shown.length?shown.map(x=>`<article class="article"><div><h2>${esc(x.title||"無題の原稿")}</h2><p>${esc(x.subject)} / ${esc(x.category)} ・ 最終更新 ${new Intl.DateTimeFormat("ja-JP",{dateStyle:"medium"}).format(new Date(x.updated_at))}</p></div><div><div class="badges"><span class="badge ${x.status}">${labels[x.status]}</span>${x.reviewAssignedToMe?'<span class="badge assigned">自分への査読依頼</span>':''}${isTest(x)?'<span class="badge">テスト</span>':''}${x.published_at?'<span class="badge published">公開済み</span>':''}</div><a href="/admin/editor/?document=${encodeURIComponent(x.id)}">編集・査読を開く →</a></div></article>`).join(""):'<p>条件に一致する原稿はありません。</p>'};const load=async()=>{try{const r=await fetch('/api/admin/editor/documents',{credentials:'same-origin',cache:'no-store'});const type=r.headers.get('content-type')??'';const d=type.includes('application/json')?await r.json() as {documents?:Article[];scope?:{email?:string};error?:string}:{};if(!r.ok)throw Error(d.error??'認証情報を取得できませんでした。ページを再読み込みしてください。');items=d.documents??[];currentEmail=d.scope?.email??"";render()}catch(e){showError(e instanceof Error?e.message:'原稿一覧を取得できませんでした。')}};if(workflow==="edit"){note.textContent="加筆・修正：自分が作成・更新した記事を優先して表示しています。";note.hidden=false}else if(workflow==="review"){note.textContent="査読：査読済みでない記事を表示し、査読中のものを優先しています。";note.hidden=false}window.setTimeout(()=>{if(list.textContent?.includes('取得しています'))showError('原稿一覧を取得できませんでした。ページを再読み込みしてください。')},6_000);[query,status,pub,reviewFilter,test].forEach(x=>x.addEventListener('input',render));void load();};document.addEventListener('astro:page-load',initializeArticleIndex);initializeArticleIndex();
</script>
<script>
  document.addEventListener('astro:page-load', () => {
    const list = document.querySelector<HTMLElement>('[data-article-index] [data-list]');
    if (!list || list.dataset.tileLinksReady === 'true') return;
    list.dataset.tileLinksReady = 'true';
    list.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      if (target.closest('a')) return;
      const card = target.closest<HTMLElement>('.article');
      const link = card?.querySelector<HTMLAnchorElement>('a');
      if (link) window.location.assign(link.href);
    });
  });
</script>
