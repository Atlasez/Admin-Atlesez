---
import AdminLayout from "../../layouts/AdminLayout.astro";
import AdminRetryNotice from "../../components/admin/AdminRetryNotice.astro";
import { getCollection } from "astro:content";

const subjects = (await getCollection("subjects"))
  .sort((a, b) => a.data.order - b.data.order)
  .map((subject) => ({ slug: subject.data.slug, name: subject.data.name.ja }));
---

<AdminLayout title="権限管理" description="アトラス運営のアクセス定義と変更履歴">
  <main class="permission-management" data-permission-management>
    <header class="page-heading">
      <div>
        <p class="eyebrow">アクセスの境界</p>
        <h1>権限管理</h1>
        <p class="lead">APIが実際に参照する記事権限と、変更履歴を確認します。プロフィール・メンバーの追加編集は名簿、ジャンルと役割の担当設定は専用ページで行います。</p>
      </div>
      <nav class="page-links" aria-label="管理ページ">
        <a href="/admin/manage/?project=atlas">管理トップ</a>
        <a href="/admin/member-management/?project=atlas">メンバー管理</a>
        <a href="/admin/genre-roles/?project=atlas&view=genres">ジャンル管理</a>
        <a href="/admin/roles/?project=atlas">役割管理</a>
      </nav>
    </header>

    <section class="compatibility-note" aria-labelledby="compatibility-title">
      <strong id="compatibility-title">旧URLの互換性</strong>
      <p><code>/admin/permissions/</code> は既存ブックマークと権限チェックの入口として維持しています。画面の責務だけを分割しており、既存の権限・記事・監査履歴は削除していません。</p>
    </section>

    <section class="action-grid" aria-label="権限管理の操作">
      <a class="action-card action-card--primary" href="/admin/member-management/?project=atlas"><span class="action-card__number">01</span><strong>メンバーのアクセスを編集</strong><small>記事権限、プロフィール、分野統括、Discord連携</small></a>
      <a class="action-card" href="/admin/genre-roles/?project=atlas&view=genres"><span class="action-card__number">02</span><strong>ジャンルの担当を編集</strong><small>ジャンル情報と担当メンバー</small></a>
      <a class="action-card" href="/admin/roles/?project=atlas"><span class="action-card__number">03</span><strong>役割の担当を編集</strong><small>役割カタログと担当メンバー</small></a>
    </section>

    <section class="access-model" aria-labelledby="access-model-title">
      <div class="section-heading"><div><p class="section-kicker">実効権限の定義</p><h2 id="access-model-title">何がアクセスを許可するか</h2></div></div>
      <div class="model-grid">
        <article><span class="model-key">記事権限</span><h3>担当分野の閲覧・編集</h3><p><code>report_admin_permissions</code> の分野slugが記事の可視・編集範囲になります。<code>*</code> は全分野管理者です。</p></article>
        <article><span class="model-key">公開フロー</span><h3>分野審査の担当</h3><p><code>editorial_workflow_roles</code> を別に持ち、記事権限とは独立して分野統括を割り当てます。</p></article>
        <article><span class="model-key">表示上の役割</span><h3>運用ラベル</h3><p>ジャンル・役割カタログは担当範囲の表示と運用整理です。単独ではAPIアクセス権を付与しません。</p></article>
      </div>
      <details class="subject-reference"><summary>現在の分野slugを確認</summary><div class="chips">{subjects.map((subject) => <span>{subject.name} <code>{subject.slug}</code></span>)}</div></details>
    </section>

    <section class="audit-panel" aria-labelledby="audit-title">
      <div class="section-heading"><div><p class="section-kicker">追跡可能性</p><h2 id="audit-title">権限変更履歴</h2><p>誰が、誰のアクセス範囲を、いつ変更したかを保持します。</p></div><label class="archive-toggle"><input type="checkbox" data-include-archived /> アーカイブも表示</label></div>
      <div class="audit-list" data-audit-list aria-live="polite"><p class="loading">履歴を読み込んでいます…</p></div>
      <AdminRetryNotice scope="permission-audit" message="権限変更履歴を読み込めませんでした。" />
      <div class="audit-pagination" data-audit-pagination hidden><span data-audit-summary></span><button type="button" class="secondary" data-load-more>さらに読み込む</button></div>
    </section>
  </main>
</AdminLayout>

<style>
.permission-management{--surface:var(--background-secondary);--surface-raised:var(--background-primary);--border:var(--border-default);--text:var(--text-primary);--muted:var(--text-secondary);--accent:var(--accent-primary);box-sizing:border-box;color:var(--text);margin:0 auto;max-width:1160px;padding:0 clamp(.8rem,3vw,1.5rem) 4rem}.permission-management *{box-sizing:border-box}.page-heading{align-items:end;border-bottom:1px solid var(--border);display:flex;gap:1.2rem;justify-content:space-between;padding:2rem 0 1.25rem}.eyebrow,.section-kicker{color:var(--accent);font-size:.7rem;font-weight:800;letter-spacing:.08em;margin:0 0 .35rem}.page-heading h1{font-size:clamp(1.7rem,4vw,2.35rem);margin:0}.lead{color:var(--muted);font-size:.82rem;line-height:1.7;margin:.5rem 0 0;max-width:58rem}.page-links{display:flex;flex-wrap:wrap;gap:.45rem;justify-content:flex-end}.page-links a{border:1px solid var(--border);color:var(--accent);font-size:.72rem;font-weight:800;padding:.48rem .6rem;text-decoration:none;white-space:nowrap}.page-links a:hover,.page-links a:focus-visible{border-color:var(--accent)}.compatibility-note{background:color-mix(in srgb,var(--accent) 7%,var(--surface));border:1px solid color-mix(in srgb,var(--accent) 35%,var(--border));margin-top:1rem;padding:.75rem .85rem}.compatibility-note strong{font-size:.78rem}.compatibility-note p{color:var(--muted);font-size:.74rem;line-height:1.6;margin:.25rem 0 0}.compatibility-note code,.access-model code{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.86em}.action-grid{display:grid;gap:.65rem;grid-template-columns:repeat(3,minmax(0,1fr));margin-top:1rem}.action-card{background:var(--surface);border:1px solid var(--border);color:var(--text);display:grid;gap:.25rem;min-width:0;padding:.85rem;text-decoration:none}.action-card:hover,.action-card:focus-visible{border-color:var(--accent);outline:none}.action-card--primary{border-color:var(--accent)}.action-card__number{color:var(--accent);font-size:.65rem;font-weight:900;letter-spacing:.08em}.action-card strong{font-size:.86rem}.action-card small{color:var(--muted);font-size:.7rem;line-height:1.45}.access-model,.audit-panel{background:var(--surface);border:1px solid var(--border);margin-top:1rem;padding:1rem}.section-heading{align-items:end;display:flex;gap:1rem;justify-content:space-between}.section-heading h2{font-size:1.1rem;margin:0}.section-heading>span,.section-heading p:not(.section-kicker){color:var(--muted);font-size:.72rem;margin:.25rem 0 0}.model-grid{display:grid;gap:.6rem;grid-template-columns:repeat(3,minmax(0,1fr));margin-top:.8rem}.model-grid article{background:var(--surface-raised);border:1px solid var(--border);display:grid;gap:.35rem;padding:.7rem}.model-key{color:var(--accent);font-size:.65rem;font-weight:900}.model-grid h3{font-size:.8rem;margin:0}.model-grid p{color:var(--muted);font-size:.7rem;line-height:1.55;margin:0}.subject-reference{border-top:1px solid var(--border);margin-top:.75rem;padding-top:.65rem}.subject-reference summary{color:var(--accent);cursor:pointer;font-size:.72rem;font-weight:800}.chips{display:flex;flex-wrap:wrap;gap:.3rem;margin-top:.55rem}.chips span{background:var(--surface-raised);border:1px solid var(--border);color:var(--muted);font-size:.67rem;padding:.28rem .4rem}.chips code{margin-left:.25rem}.archive-toggle{align-items:center;color:var(--muted);display:flex;font-size:.7rem;gap:.3rem;white-space:nowrap}.archive-toggle input{accent-color:var(--accent)}.audit-list{display:grid;gap:.5rem;margin-top:.8rem;min-height:8rem}.audit-entry{background:var(--surface-raised);border:1px solid var(--border);display:grid;gap:.35rem;padding:.7rem}.audit-entry__top{align-items:baseline;display:flex;flex-wrap:wrap;gap:.5rem;justify-content:space-between}.audit-entry strong{font-size:.78rem}.audit-entry time,.audit-entry small{color:var(--muted);font-size:.67rem}.audit-entry p{color:var(--muted);font-size:.7rem;line-height:1.45;margin:0}.audit-entry code{color:var(--accent);font-size:.9em}.audit-entry[data-archived="true"]{opacity:.72}.loading,.empty{color:var(--muted);font-size:.76rem}.empty{border:1px dashed var(--border);padding:1.5rem;text-align:center}.audit-pagination{align-items:center;border-top:1px solid var(--border);display:flex;gap:.7rem;justify-content:space-between;margin-top:.75rem;padding-top:.7rem}.audit-pagination span{color:var(--muted);font-size:.7rem}.secondary{background:transparent;border:1px solid var(--border);color:var(--accent);cursor:pointer;font:inherit;font-size:.7rem;font-weight:800;min-height:2.15rem;padding:.4rem .6rem}.secondary:hover,.secondary:focus-visible{border-color:var(--accent)}@media(max-width:760px){.page-heading{align-items:start;display:grid}.page-links{justify-content:flex-start}.action-grid,.model-grid{grid-template-columns:1fr}.section-heading{align-items:start;display:grid}.archive-toggle{white-space:normal}}
</style>

<script>
  import { createAdminLoadRetry } from "../../scripts/admin-load-retry";
  import { readAdminApiJson } from "../../lib/admin-api";

  type Entry = { id: string; actor_email: string; target_email: string; action: string; before_subjects: string; after_subjects: string; created_at: string; archived_at: string | null };
  type Data = { entries?: Entry[]; pagination?: { hasMore?: boolean; nextCursor?: string | null }; error?: string };
  const initialize = () => {
    const root = document.querySelector<HTMLElement>("[data-permission-management]");
    if (!root || root.dataset.ready === "true") return;
    root.dataset.ready = "true";
    const list = root.querySelector<HTMLElement>("[data-audit-list]")!;
    const includeArchived = root.querySelector<HTMLInputElement>("[data-include-archived]")!;
    const pagination = root.querySelector<HTMLElement>("[data-audit-pagination]")!;
    const summary = root.querySelector<HTMLElement>("[data-audit-summary]")!;
    const loadMore = root.querySelector<HTMLButtonElement>("[data-load-more]")!;
    let cursor = "";
    let entries: Entry[] = [];
    let load: () => Promise<void>;
    const retry = createAdminLoadRetry(root, () => load(), "権限変更履歴を読み込めませんでした。", { scope: "permission-audit" });
    const esc = (value: unknown) => String(value ?? "").replace(/[&<>"']/g, (character) => ({ "&":"&amp;", "<":"&lt;", ">":"&gt;", '"':"&quot;", "'":"&#39;" })[character] ?? character);
    const actionLabel = (action: string) => ({ grant: "付与", replace: "置換", revoke: "削除" }[action] ?? action);
    const subjectLabel = (value: string) => value.split(",").filter(Boolean).map((item) => item === "*" ? "全分野" : item).join("、") || "なし";
    const render = () => {
      list.innerHTML = entries.length ? entries.map((entry) => `<article class="audit-entry" data-archived="${entry.archived_at ? "true" : "false"}"><div class="audit-entry__top"><strong>${esc(actionLabel(entry.action))}：<code>${esc(entry.target_email)}</code></strong><time datetime="${esc(entry.created_at)}">${esc(new Date(entry.created_at).toLocaleString("ja-JP"))}</time></div><p>実行者：${esc(entry.actor_email)} ／ 変更前：${esc(subjectLabel(entry.before_subjects))} → 変更後：${esc(subjectLabel(entry.after_subjects))}</p>${entry.archived_at ? `<small>アーカイブ日時：${esc(entry.archived_at)}</small>` : ""}</article>`).join("") : '<p class="empty">権限変更履歴はありません。</p>';
      pagination.hidden = !cursor;
      summary.textContent = entries.length + "件" + (cursor ? "（続きあり）" : "");
    };
    load = async () => {
      retry.begin();
      const query = new URLSearchParams({ limit: "30" });
      if (includeArchived.checked) query.set("includeArchived", "1");
      if (cursor) query.set("cursor", cursor);
      try {
        const response = await fetch("/api/admin/permission-audit?" + query, { credentials: "same-origin", cache: "no-store" });
        const data = await readAdminApiJson<Data>(response, "権限変更履歴を読み込めませんでした。");
        if (!response.ok) throw new Error(data.error ?? "権限変更履歴を読み込めませんでした。");
        entries = cursor ? entries.concat(data.entries ?? []) : (data.entries ?? []);
        cursor = data.pagination?.nextCursor ?? "";
        render();
        retry.success();
      } catch (error) {
        list.innerHTML = `<p class="empty">${esc(error instanceof Error ? error.message : "権限変更履歴を読み込めませんでした。")}</p>`;
        retry.fail(error);
      }
    };
    includeArchived.addEventListener("change", () => { cursor = ""; entries = []; void load(); });
    loadMore.addEventListener("click", () => { if (!loadMore.disabled) void load(); });
    void load();
  };
  document.addEventListener("astro:page-load", initialize);
  initialize();
</script>
