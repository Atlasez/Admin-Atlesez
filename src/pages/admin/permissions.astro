---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { getCollection } from "astro:content";
const subjects = (await getCollection("subjects")).sort((a,b)=>a.data.order-b.data.order);
---
<AdminLayout title="運営者・担当分野管理" description="運営内運営専用の参加者管理">
  <main class="member-admin" data-member-admin>
    <header class="member-admin__header">
      <div>
        <p class="member-admin__eyebrow">権限管理</p>
        <h1>運営者・担当分野管理</h1>
        <p class="member-admin__lead">参加者を選び、運営権限・担当分野・Discord役職を個人単位で管理します。</p>
      </div>
      <div class="member-admin__header-meta"><span>管理者専用</span><a class="member-admin__self-discord" href="/auth/discord/start?returnTo=%2Fadmin%2Fpermissions%2F%3Fproject%3Datlas">自分のDiscordを連携</a><small>個人設定の保存時にDiscordへ同期します</small></div>
    </header>

    <section class="member-admin__summary" aria-label="権限管理の概要">
      <div class="summary-card"><span>参加者</span><strong data-summary-member-count>—</strong><small>登録済み</small></div>
      <div class="summary-card"><span>Discord連携</span><strong data-summary-linked-count>—</strong><small>連携済み</small></div>
      <div class="summary-card"><span>Discordロール</span><strong data-summary-role-count>—</strong><small>読み込み済み</small></div>
      <div class="summary-card"><span>分野統括</span><strong data-summary-workflow-count>—</strong><small>割り当て済み分野</small></div>
    </section>

    <section class="member-admin__members" aria-labelledby="member-list-title">
      <div class="member-admin__section-heading"><div><p class="member-admin__eyebrow">運営メンバー</p><h2 id="member-list-title">参加者一覧</h2><small>参加者を選択すると、権限・プロフィール・Discord役職をまとめて編集できます。</small></div><span class="member-admin__count" data-member-count></span></div>
      <div class="member-toolbar" aria-label="参加者の検索と絞り込み">
        <label class="member-toolbar__search">参加者を検索<input type="search" data-member-search placeholder="名前・メールアドレスで検索" autocomplete="off" /></label>
        <label>表示を絞り込む<select data-member-filter><option value="all">すべての参加者</option><option value="unconnected">Discord未連携</option><option value="no-roles">Discord役職なし</option><option value="has-roles">Discord役職あり</option></select></label>
        <button type="button" class="member-toolbar__reset" data-member-filter-reset>条件をクリア</button>
        <span class="member-toolbar__summary" data-member-filter-summary aria-live="polite"></span>
      </div>
      <div class="member-list-heading" aria-hidden="true"><span>参加者</span><span>運営権限・登録情報</span><span>Discord</span><span>操作</span></div>
      <div class="member-grid" data-member-list>読み込み中…</div>
    </section>

    <section class="member-admin__tools" aria-labelledby="admin-tools-title">
      <div class="member-admin__section-heading"><div><p class="member-admin__eyebrow">管理ツール</p><h2 id="admin-tools-title">追加・連携・公開フロー</h2><small>必要な項目だけを開いて操作できます。Discord側のロール定義は変更しません。</small></div></div>
      <output class="member-admin__global-message" data-message aria-live="polite"></output>
      <div class="member-admin__workspace">
        <details class="member-admin__add action-card action-card--primary">
          <summary><span class="action-card__step">01</span><span class="action-card__summary-copy"><small>参加者を追加</small><strong id="add-member-title">運営権限の付与</strong></span><span class="action-card__chevron" aria-hidden="true">⌄</span></summary>
          <div class="action-card__body">
            <p class="action-card__description">メールアドレスと担当範囲を選択してください。</p>
            <form data-add-form>
              <label>メールアドレス<input type="email" name="email" required maxlength="320" placeholder="editor@example.com" /></label>
              <label>担当権限（複数選択可）<select name="subject" multiple required size="4"><option value="*">全分野管理者</option>{subjects.map(s => <option value={s.data.slug}>{s.data.name.ja}（担当）</option>)}</select></label>
              <button type="submit" class="button-primary">運営者を追加</button>
            </form>
          </div>
        </details>

        <details class="member-admin__add action-card discord-role-catalog">
          <summary><span class="action-card__step">02</span><span class="action-card__summary-copy"><small>Discord連携</small><strong id="discord-role-catalog-title">既存ロールのカタログ</strong></span><span class="action-card__summary-status" data-discord-role-count>未同期</span><span class="action-card__chevron" aria-hidden="true">⌄</span></summary>
          <div class="action-card__body">
            <p class="action-card__description">Discordに存在する既存ロールを読み込み、参加者へ複数選択で割り当てます。Discord側で管理対象ロールが外された場合は、定期同期で運営サイト側の権限・割当も無効化します。</p>
            <div class="discord-role-catalog__body"><div data-discord-role-list>「既存ロールを読み込む」を押すと一覧を更新します。</div></div>
            <div class="member-admin__sync"><div><strong>Discordロール対応表</strong><small>Discord側を読み取り、運営サイトと照合します。</small></div><div class="member-admin__sync-actions"><button type="button" class="member-provision" data-provision-roles>既存ロールを読み込む</button><button type="button" class="member-provision member-provision--secondary" data-discord-readiness>運用事前チェック</button></div></div>
            <output class="discord-readiness-message" data-discord-readiness-message aria-live="polite"></output>
          </div>
        </details>

        <details class="member-admin__add action-card workflow-role-admin">
          <summary><span class="action-card__step">03</span><span class="action-card__summary-copy"><small>公開フロー</small><strong id="workflow-role-title">分野統括の割り当て</strong></span><span class="action-card__chevron" aria-hidden="true">⌄</span></summary>
          <div class="action-card__body">
            <p class="action-card__description">「執筆完了」後の公開審査を担当します。同じ分野に複数人、1人に複数分野を割り当てられます。</p>
            <form data-add-workflow-role>
              <label>担当者のメールアドレス<input type="email" name="email" required maxlength="320" list="workflow-coordinator-members" placeholder="coordinator@example.com" /><datalist id="workflow-coordinator-members" data-workflow-coordinator-members></datalist><small>既存メンバーは候補から選べます。</small></label>
              <label class="workflow-role-field--subjects">統括する分野（複数選択可）<select name="subject" multiple required size="5" aria-describedby="workflow-role-subject-help">{subjects.map(s => <option value={s.data.slug}>{s.data.name.ja}</option>)}</select><small id="workflow-role-subject-help">Ctrl（Windows）または⌘（Mac）を押しながら複数選択できます。</small><output data-workflow-role-selection aria-live="polite">0分野を選択中</output></label>
              <button type="submit" class="button-primary">統括を追加</button>
            </form>
            <div class="workflow-role-list" data-workflow-role-list><small>読み込み中…</small></div>
          </div>
        </details>
      </div>
    </section>
    <dialog class="member-modal" data-member-modal aria-labelledby="member-modal-title">
      <div class="member-modal__shell">
        <header class="member-modal__header">
          <div><p>個人設定</p><h2 id="member-modal-title" data-member-modal-title>参加者の設定</h2><small data-member-modal-email></small></div>
          <button type="button" class="member-modal__close" data-member-modal-close aria-label="閉じる">×</button>
        </header>
        <div class="member-modal__body" data-member-modal-content></div>
        <footer class="member-modal__footer"><output data-member-modal-message aria-live="polite"></output><button type="button" class="member-modal__cancel" data-member-modal-close>閉じる</button><button type="button" class="member-modal__save" data-member-modal-save>保存してDiscordへ同期</button></footer>
      </div>
    </dialog>
  </main>
</AdminLayout>

<style is:global>
  .member-admin{box-sizing:border-box;margin:0 auto;max-width:1180px;padding:0 1.25rem 4rem;color:var(--text-primary)}
  .member-admin *{box-sizing:border-box}.member-admin__header{border-bottom:1px solid var(--border-default);padding:2rem 0 1.2rem}.member-admin__header p,.member-admin__section-heading p{color:var(--accent-primary);font-size:.74rem;font-weight:800;letter-spacing:.09em;margin:0 0 .35rem}.member-admin__header h1{font-size:clamp(1.65rem,3vw,2.2rem);margin:0}.member-admin__header span{color:var(--text-secondary);display:block;font-size:.88rem;line-height:1.6;margin-top:.5rem}
  .member-admin__add{background:var(--background-secondary);border:1px solid var(--border-default);display:grid;gap:.8rem;grid-template-columns:185px 1fr;margin:1.2rem 0 1.5rem;padding:.9rem 1rem}.member-admin__add p{color:var(--accent-primary);font-size:.72rem;font-weight:800;letter-spacing:.08em;margin:0 0 .2rem}.member-admin__add h2{font-size:1rem;margin:0}.member-admin__add form{align-items:end;display:grid;gap:.55rem;grid-template-columns:minmax(0,1fr) minmax(160px,.7fr) auto}.member-admin__add label{align-self:start;color:var(--text-secondary);display:grid;font-size:.72rem;font-weight:800;gap:.28rem}.member-admin input,.member-admin select{appearance:auto;background:var(--background-primary)!important;border:1px solid var(--border-default)!important;border-radius:0!important;color:var(--text-primary)!important;font:inherit!important;line-height:1.2!important;min-height:2.35rem!important;outline:none;padding:.45rem .55rem!important;width:100%!important}.member-admin input:focus,.member-admin select:focus{border-color:var(--accent-primary)!important;box-shadow:0 0 0 2px color-mix(in srgb,var(--accent-primary) 18%,transparent)}.member-admin button{appearance:none;border-radius:0!important;cursor:pointer;font:inherit!important;font-size:.78rem!important;font-weight:800!important;line-height:1.2!important;min-height:2.35rem!important;padding:.45rem .65rem!important}.member-admin__add button,.member-action--sync,.member-modal__save{background:var(--accent-primary)!important;border:1px solid var(--accent-primary)!important;color:#fff!important}.member-admin__add output{color:var(--text-secondary);font-size:.78rem;grid-column:2/-1;min-height:1em}
