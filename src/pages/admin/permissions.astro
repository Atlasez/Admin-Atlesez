</style>

<script>
  const initializeMemberAdmin = () => {
  const root = document.querySelector<HTMLElement>("[data-member-admin]");
  if (root && root.dataset.initialized !== "true") {
    root.dataset.initialized = "true";
    const form = root.querySelector<HTMLFormElement>("[data-add-form]")!;
    const list = root.querySelector<HTMLElement>("[data-member-list]")!;
    const message = root.querySelector<HTMLOutputElement>("[data-message]")!;
    const count = root.querySelector<HTMLElement>("[data-member-count]")!;
    const memberSearch = root.querySelector<HTMLInputElement>("[data-member-search]")!;
    const memberFilter = root.querySelector<HTMLSelectElement>("[data-member-filter]")!;
    const memberFilterReset = root.querySelector<HTMLButtonElement>("[data-member-filter-reset]")!;
    const memberFilterSummary = root.querySelector<HTMLElement>("[data-member-filter-summary]")!;
    const summaryMemberCount = root.querySelector<HTMLElement>("[data-summary-member-count]")!;
    const summaryLinkedCount = root.querySelector<HTMLElement>("[data-summary-linked-count]")!;
    const summaryRoleCount = root.querySelector<HTMLElement>("[data-summary-role-count]")!;
    const summaryWorkflowCount = root.querySelector<HTMLElement>("[data-summary-workflow-count]")!;
    const workflowRoleForm = root.querySelector<HTMLFormElement>("[data-add-workflow-role]")!;
    const workflowRoleList = root.querySelector<HTMLElement>("[data-workflow-role-list]")!;
    const workflowRoleSelection = root.querySelector<HTMLOutputElement>("[data-workflow-role-selection]")!;
    const workflowCoordinatorMembers = root.querySelector<HTMLDataListElement>("[data-workflow-coordinator-members]")!;
    let discordRoles: Array<{ discord_role_id: string; name: string; position: number; is_managed: number }> = [];
    let memberRecords: any[] = [];
    let memberQuery = "";
    let memberViewFilter = "all";
    const memberModal = root.querySelector<HTMLDialogElement>("[data-member-modal]")!;
    const memberModalTitle = root.querySelector<HTMLElement>("[data-member-modal-title]")!;
    const memberModalEmail = root.querySelector<HTMLElement>("[data-member-modal-email]")!;
    const memberModalContent = root.querySelector<HTMLElement>("[data-member-modal-content]")!;
    const memberModalMessage = root.querySelector<HTMLOutputElement>("[data-member-modal-message]")!;
    const setMemberModalMessage = (value: string, state: "idle" | "error" = "idle") => { memberModalMessage.value = value; memberModalMessage.dataset.state = state; };
    const memberModalSave = root.querySelector<HTMLButtonElement>("[data-member-modal-save]")!;
    let activeMemberEmail = "";
    const discordRoleCount = root.querySelector<HTMLElement>("[data-discord-role-count]")!;
    const discordRoleList = root.querySelector<HTMLElement>("[data-discord-role-list]")!;
    const esc = (value: string) => value.replace(/[&<>"']/g, char => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[char] ?? char));
    const subjectLabels = new Map(Array.from(form.querySelectorAll("option")).map(option => [option.value, option.textContent ?? option.value]));
    const workflowSubjectLabels = new Map(Array.from(subjectLabels.entries()).map(([value, label]) => [value, label.replace(/（担当）$/, "")]));
    const universities = ["北海道大学","東北大学","東京大学","東京科学大学","東京都立大学","早稲田大学","横浜国立大学","静岡大学","新潟大学","岐阜大学","立命館大学","京都大学","大阪大学","大阪公立大学","神戸大学","広島大学","九州大学","長崎大学","東洋大学","UCL","国立台湾大学","山口大学","慶應義塾大学","東京理科大学","中央大学","名古屋大学","筑波大学","名古屋市立大学","名城大学","Korea university, School of biomedical engineering","立教大学","Swarthmore College","北見工業大学","ZEN大学"];
    const years = ["中1","中2","中3","高1","高2","高3","高専1","高専2","高専3","高専4","高専5","B1","B2","B3","B4","M1","M2","D1","D2","D3","教職員・研究者","社会人","その他"];
    const fields = ["漢字","古文","漢文","地理","日本史","世界史","哲学","考古学","数学","物理","化学","地質","気象","海洋","天文","生物","情報","水産学","建築","薬学","中国語（普通話）","台湾華語","言語学","ページデザイン"];
    const opts = (items: string[], selected: string, multiple = false) => items.map(item => `<option value="${esc(item)}" ${multiple ? selected.split(",").includes(item) : selected === item ? "selected" : ""}>${esc(item)}</option>`).join("");
    const avatar = (member: any) => member.avatar_url ? `<img class="member-avatar" src="${esc(member.avatar_url)}" alt="" />` : `<span class="member-avatar member-avatar--fallback">${esc((member.display_name || "名").slice(0,1))}</span>`;
    const renderWorkflowRoles = (roles: any[]) => {
      const coordinators = roles.filter(role => role.role === "subject-coordinator" && role.subject);
      const leaders = roles.filter(role => role.role === "project-leader");
      const grouped = new Map<string, any[]>();
      coordinators.forEach(role => grouped.set(role.subject, [...(grouped.get(role.subject) ?? []), role]));
      const subjectsWithAssignments = Array.from(grouped.entries()).sort((left, right) => (workflowSubjectLabels.get(left[0]) ?? left[0]).localeCompare(workflowSubjectLabels.get(right[0]) ?? right[0], "ja"));
      const assignedEmails = new Set(coordinators.map(role => String(role.email).toLowerCase()));
      const subjectCount = subjectsWithAssignments.length;
      summaryWorkflowCount.textContent = String(subjectCount);
      const multiSubjectCount = Array.from(new Set(coordinators.map(role => String(role.email).toLowerCase()))).filter(email => coordinators.filter(role => String(role.email).toLowerCase() === email).length > 1).length;
      const unassignedSubjects = Array.from(subjectLabels.keys()).filter(subject => subject !== "*" && !grouped.has(subject));
      const chip = (role: any) => `<span class="workflow-role-chip" title="${esc(role.email)}"><span class="workflow-role-chip__identity"><b>${esc(role.display_name || role.email)}</b><small>${esc(role.email)}</small></span><button type="button" data-remove-workflow-role data-email="${esc(role.email)}" data-subject="${esc(role.subject)}" aria-label="${esc(role.display_name || role.email)}の${esc(workflowSubjectLabels.get(role.subject) ?? role.subject)}統括を削除">×</button></span>`;
      const groups = subjectsWithAssignments.map(([subject, assigned]) => `<section class="workflow-role-group" data-workflow-subject-group="${esc(subject)}"><header class="workflow-role-group__heading"><h3>${esc(workflowSubjectLabels.get(subject) ?? subject)}</h3><span>${assigned.length}人（共同担当）</span></header><div class="workflow-role-assignees">${assigned.sort((left, right) => String(left.display_name || left.email).localeCompare(String(right.display_name || right.email), "ja")).map(chip).join("")}</div></section>`).join("");
      const leaderMarkup = leaders.length ? `<section class="workflow-role-group"><header class="workflow-role-group__heading"><h3>プロジェクトリーダー</h3><span>${leaders.length}人</span></header><div class="workflow-role-assignees">${leaders.map(role => `<span class="workflow-role-chip" title="${esc(role.email)}"><span class="workflow-role-chip__identity"><b>${esc(role.display_name || role.email)}</b><small>${esc(role.email)}</small></span></span>`).join("")}</div></section>` : "";
      const unassignedMarkup = unassignedSubjects.length ? `<details class="workflow-role-unassigned"><summary>未割り当て：${unassignedSubjects.length}分野</summary><span>${unassignedSubjects.map(subject => esc(workflowSubjectLabels.get(subject) ?? subject)).join("、")}</span></details>` : `<small class="workflow-role-unassigned">全分野に少なくとも1人の統括が割り当てられています。</small>`;
      const coordinatorOptions = new Map<string, string>();
      memberRecords.forEach(member => coordinatorOptions.set(String(member.email).toLowerCase(), String(member.display_name || member.email)));
      coordinators.forEach(role => coordinatorOptions.set(String(role.email).toLowerCase(), String(role.display_name || role.email)));
      workflowCoordinatorMembers.innerHTML = Array.from(coordinatorOptions.entries()).map(([email, displayName]) => `<option value="${esc(email)}">${esc(displayName)}</option>`).join("");
      workflowRoleList.innerHTML = `<div class="workflow-role-summary"><strong>${subjectCount}分野</strong>・<strong>${assignedEmails.size}人</strong>を割り当て中${multiSubjectCount ? `（${multiSubjectCount}人が兼任）` : ""}。各分野は複数人の共同担当にできます。</div>${groups || "<small>分野統括はまだ割り当てられていません。</small>"}${leaderMarkup}${unassignedMarkup}`;
    };
    const modalMarkup = (member: any) => {
      const memberSubjects = String(member.subjects ?? "").split(",").filter(Boolean);
      const memberRoleIds = String(member.discord_role_ids ?? "").split(",").filter(Boolean);
      const institutionOptions = member.university && !universities.includes(member.university) ? [...universities, member.university] : universities;
      const permissionOptions = Array.from(subjectLabels.entries()).map(([value, label]) => `<option value="${esc(value)}" ${memberSubjects.includes(value) ? "selected" : ""}>${esc(label)}</option>`).join("");
      const selectedInterests = String(member.interests ?? "").split(",").filter(Boolean);
      const interestOptions = fields.map(field => `<label><input type="checkbox" data-modal-interest value="${esc(field)}" ${selectedInterests.includes(field) ? "checked" : ""} />${esc(field)}</label>`).join("");
      const discordRoleOptions = discordRoles.map((role: any) => `<label class="member-role-option${role.is_managed ? " member-role-option--managed" : ""}" data-modal-role-option data-role-name="${esc(role.name.toLocaleLowerCase())}"><input type="checkbox" data-modal-discord-role value="${esc(role.discord_role_id)}" ${memberRoleIds.includes(role.discord_role_id) ? "checked" : ""} ${role.is_managed ? "disabled" : ""} /><span>${esc(role.name)}${role.is_managed ? "（管理対象外）" : ""}</span></label>`).join("");
      const linked = Boolean(member.discord_user_id);
      return `<div class="member-modal__grid"><label>所属機関<select data-modal-university><option value="" ${member.university ? "" : "selected"}>未設定</option>${opts(institutionOptions, member.university ?? "")}</select></label><label>学年<select data-modal-year><option value="" ${member.year ? "" : "selected"}>未設定</option>${opts(years, member.year ?? "")}</select></label><label class="member-modal__wide">担当権限（複数選択可）<select data-modal-permission-subjects multiple>${permissionOptions}</select></label><div class="member-modal__section member-modal__wide"><h3>担当・関心分野</h3><div class="member-interest-picker member-modal__interest-picker">${interestOptions}</div></div><section class="member-modal__section member-modal__wide" aria-labelledby="member-modal-discord-title"><h3 id="member-modal-discord-title">Discord連携 <span class="member-modal__discord-status" data-state="${linked ? "connected" : "unconnected"}">${linked ? "連携済み" : "未連携"}</span></h3><p>対象ユーザーのDiscord IDを入力して、サーバー内の本人確認とロール同期を行います。</p><div class="member-modal__link-row"><label>DiscordユーザーID<input inputmode="numeric" maxlength="22" data-modal-discord-id placeholder="15〜22桁の数字" value="${esc(member.discord_user_id ?? "")}" /></label><button type="button" class="member-modal__link-button" data-link-discord>${linked ? "Discord連携を更新" : "Discordと連携"}</button></div><p class="member-modal__help">Discordのユーザー設定で「開発者モード」を有効にすると、ユーザー名を右クリックしてIDをコピーできます。対象ユーザーが連携先サーバーに参加している必要があります。</p></section><section class="member-role-picker member-modal__wide" aria-labelledby="member-modal-role-title"><strong id="member-modal-role-title">Discord役職（複数選択可）</strong><div class="member-role-picker__tools"><input type="search" data-modal-role-search placeholder="役職名で検索" autocomplete="off" /><span class="member-role-picker__count" data-modal-role-visible-count>${discordRoles.length}件</span></div><div class="member-role-options" data-modal-role-options>${discordRoleOptions || "<small>ロールが読み込まれていません。</small>"}</div><small>既存ロールだけを割り当てます。Discord側のロール定義は変更しません。</small></section></div>`;
    };
    const openMemberModal = (email: string) => {
      const member = memberRecords.find(item => String(item.email).toLowerCase() === email.toLowerCase());
      if (!member) return;
      activeMemberEmail = email;
      memberModalTitle.textContent = member.display_name || "表示名未設定";
      memberModalEmail.textContent = member.email;
      memberModalContent.innerHTML = modalMarkup(member);
      setMemberModalMessage("");
      if (!memberModal.open) memberModal.showModal();
    };
    const closeMemberModal = () => { if (memberModal.open) memberModal.close(); activeMemberEmail = ""; };
    memberModal.querySelectorAll<HTMLButtonElement>("[data-member-modal-close]").forEach(button => button.addEventListener("click", closeMemberModal));
    memberModal.addEventListener("click", event => { if (event.target === memberModal) closeMemberModal(); });
    memberModalContent.addEventListener("input", event => {
      const target = event.target as HTMLInputElement;
      if (!target.matches("[data-modal-role-search]")) return;
      const query = target.value.trim().toLocaleLowerCase();
      const options = Array.from(memberModalContent.querySelectorAll<HTMLElement>("[data-modal-role-option]"));
      let visible = 0;
      options.forEach(option => { const matches = !query || (option.dataset.roleName ?? "").includes(query); option.hidden = !matches; if (matches) visible += 1; });
      const visibleCount = memberModalContent.querySelector<HTMLElement>("[data-modal-role-visible-count]");
      if (visibleCount) visibleCount.textContent = `${visible}件`;
    });
    memberModalContent.addEventListener("click", async event => {
      const target = event.target as HTMLElement;
      const linkButton = target.closest<HTMLButtonElement>("[data-link-discord]");
      if (!linkButton || !activeMemberEmail) return;
      const input = memberModalContent.querySelector<HTMLInputElement>("[data-modal-discord-id]");
      if (!input) return;
      linkButton.disabled = true;
      setMemberModalMessage("Discordユーザーを確認中…");
      try {
        const response = await fetch("/api/admin/member-discord-user", {method:"PUT",credentials:"same-origin",headers:{"content-type":"application/json"},body:JSON.stringify({email:activeMemberEmail,discordUserId:input.value.trim()})});
        const data = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(data.error ?? "Discord連携に失敗しました。");
        setMemberModalMessage(discordSyncMessage("Discord連携を保存しました。", data.provisioning));
        closeMemberModal();
        await load();
      } catch (error) { setMemberModalMessage(error instanceof Error ? error.message : "Discord連携に失敗しました。", "error"); }
      finally { linkButton.disabled = false; }
    });
    memberModalSave.addEventListener("click", async () => {
      if (!activeMemberEmail) return;
      const permissions = Array.from(memberModalContent.querySelector<HTMLSelectElement>("[data-modal-permission-subjects]")?.selectedOptions ?? []).map(option => option.value);
      const interests = Array.from(memberModalContent.querySelectorAll<HTMLInputElement>("[data-modal-interest]:checked")).map(input => input.value);
      const discordRoleIds = Array.from(memberModalContent.querySelectorAll<HTMLInputElement>("[data-modal-discord-role]:checked")).map(input => input.value);
      memberModalSave.disabled = true;
      setMemberModalMessage("保存・Discord同期中…");
      try {
        const response = await fetch("/api/admin/member-settings", {method:"PUT",credentials:"same-origin",headers:{"content-type":"application/json"},body:JSON.stringify({email:activeMemberEmail,subjects:permissions,roleIds:discordRoleIds,university:memberModalContent.querySelector<HTMLSelectElement>("[data-modal-university]")?.value ?? "",year:memberModalContent.querySelector<HTMLSelectElement>("[data-modal-year]")?.value ?? "",interests})});
        const result = await response.json().catch(() => ({}));
        if (!response.ok) {
          setMemberModalMessage(result.error ?? discordSyncMessage("Discord同期に失敗しました。", result.provisioning), "error");
          return;
        }
        setMemberModalMessage(discordSyncMessage("個人設定を保存しました。", result.provisioning));
        closeMemberModal();
        await load();
      } catch (error) { setMemberModalMessage(error instanceof Error ? error.message : "保存・同期できませんでした。", "error"); }
      finally { memberModalSave.disabled = false; }
    });
    const filteredMembers = () => {
      const query = memberQuery.trim().toLocaleLowerCase();
      return memberRecords.filter(member => {
        const roleIds = String(member.discord_role_ids ?? "").split(",").filter(Boolean);
        const searchable = `${member.display_name ?? ""} ${member.email ?? ""} ${member.discord_user_id ?? ""}`.toLocaleLowerCase();
        const matchesQuery = !query || searchable.includes(query);
        const matchesFilter = memberViewFilter === "all" || (memberViewFilter === "unconnected" && !member.discord_user_id) || (memberViewFilter === "no-roles" && roleIds.length === 0) || (memberViewFilter === "has-roles" && roleIds.length > 0);
        return matchesQuery && matchesFilter;
      });
    };
    const render = (members: any[]) => {
      count.textContent = `${members.length} 名`;
      summaryMemberCount.textContent = String(memberRecords.length);
      summaryLinkedCount.textContent = `${memberRecords.filter(member => Boolean(member.discord_user_id)).length}/${memberRecords.length}`;
      memberFilterSummary.textContent = members.length === memberRecords.length ? `全${memberRecords.length}名を表示` : `${members.length}名を表示 / 全${memberRecords.length}名`;
      list.innerHTML = members.length ? members.map(member => {
        const memberSubjects = String(member.subjects ?? "").split(",").filter(Boolean);
        const isGlobalManager = memberSubjects.includes("*");
        const roles = memberSubjects.map((id: string) => subjectLabels.get(id) ?? id);
        const interests = String(member.interests ?? "").split(",").filter(Boolean);
        const memberRoleIds = String(member.discord_role_ids ?? "").split(",").filter(Boolean);
        const memberRoleLabels = memberRoleIds.map(id => discordRoles.find(role => role.discord_role_id === id)?.name ?? `役職ID ${id.slice(0, 8)}…`);
        const shownRoleLabels = memberRoleLabels.slice(0, 3);
        const roleChips = memberRoleLabels.length ? `${shownRoleLabels.map(name => `<span class="member-role-chip">${esc(name)}</span>`).join("")}${memberRoleLabels.length > shownRoleLabels.length ? `<span class="member-role-chip member-role-chip--more">他${memberRoleLabels.length - shownRoleLabels.length}件</span>` : ""}` : `<span class="member-role-chip member-role-chip--empty">未付与</span>`;
        const displayName = member.display_name || "表示名未設定";
        return `<article class="member-card" data-email="${esc(member.email)}"><div class="member-card__top">${avatar(member)}<div class="member-card__identity"><button type="button" class="member-card__name" data-open-member aria-label="${esc(displayName)}の個人設定を開く">${esc(displayName)}</button><div class="member-card__email">${esc(member.email)}</div></div></div><div class="member-card__access"><span class="member-card__role">${esc(roles.join("・") || "担当未設定")}</span><div class="member-card__facts"><span class="member-fact"><b>所属</b> ${esc(member.university || "未登録")}</span><span class="member-fact"><b>学年</b> ${esc(member.year || "未登録")}</span><span class="member-fact"><b>分野</b> ${esc(interests.join("・") || "未登録")}</span></div></div><div class="member-card__discord"><div class="member-card__discord-heading"><strong>Discord</strong><span class="member-card__discord-state" data-state="${member.discord_user_id ? "connected" : "unconnected"}">${member.discord_user_id ? "連携済み" : "未連携"}</span></div><div class="member-role-chips">${roleChips}</div></div><div class="member-card__actions"><button type="button" class="member-action--edit" data-open-member>設定</button><details class="member-action-menu"><summary aria-label="${esc(displayName)}のその他の操作">•••</summary><div>${isGlobalManager ? "" : `<button type="button" class="member-action--promote" data-promote-manager>全分野管理者に変更</button>`}<button type="button" class="member-action--sync" data-sync>Discordロールを再同期</button><button type="button" class="member-action--remove" data-remove data-subject="${esc(memberSubjects[0] ?? "")}">権限を削除</button></div></details></div></article>`;
      }).join("") : '<p class="member-empty">登録されている参加者はいません。</p>';
    };
    const discordSyncMessage = (prefix: string, provisioning: any) => { const warnings = Array.isArray(provisioning?.warnings) ? provisioning.warnings.join(" ") : ""; const notices = Array.isArray(provisioning?.notices) ? provisioning.notices.join(" ") : ""; const added = Number(provisioning?.applied ?? 0); const removed = Number(provisioning?.removed ?? 0); return `${prefix} Discord同期: 追加${added}件・削除${removed}件${warnings ? `。${warnings}` : ""}${notices ? `。確認: ${notices}` : ""}`; };
    const load = async () => {
      root.setAttribute("aria-busy", "true");
      list.textContent = "参加者一覧を読み込んでいます…";
      try {
        const response = await fetch("/api/admin/report-admin-permissions", {credentials:"same-origin", cache:"no-store"});
        const data = await response.json().catch(() => ({}));
        if (response.status === 403) {
          list.textContent = "このページは全分野管理者のみ利用できます。";
          form.hidden = true;
          workflowRoleForm.hidden = true;
          return;
        }
        if (!response.ok) throw new Error(data.error ?? "参加者一覧を読み込めませんでした。");

        // Discordロールの取得は初期表示から切り離す。ページを開くだけで
        // Discord API/D1へ書き込まず、必要なときだけ明示操作で同期する。
        discordRoles = Array.isArray(data.discordRoles) ? data.discordRoles : [];
        const manageableRoles = discordRoles.filter(role => !role.is_managed);
        const previewRoles = manageableRoles.slice(0, 12);
        discordRoleCount.textContent = discordRoles.length ? `${discordRoles.length}件` : "未同期";
        summaryRoleCount.textContent = discordRoles.length ? String(discordRoles.length) : "—";
        discordRoleList.innerHTML = discordRoles.length
          ? `<div class="discord-role-catalog__meta">管理可能 ${manageableRoles.length}件・管理対象外 ${discordRoles.length - manageableRoles.length}件</div><div class="discord-role-catalog__chips">${previewRoles.map(role => `<span>${esc(role.name)}</span>`).join("")}${manageableRoles.length > previewRoles.length ? `<span class="discord-role-catalog__more">ほか${manageableRoles.length - previewRoles.length}件</span>` : ""}</div>`
          : "「既存ロールを読み込む」を押すと一覧を更新します。";
        memberRecords = Array.isArray(data.permissions) ? data.permissions : [];
        render(filteredMembers());
        renderWorkflowRoles(data.workflowRoles ?? []);
      } finally {
        root.removeAttribute("aria-busy");
      }
    };
    memberSearch.addEventListener("input", () => { memberQuery = memberSearch.value; render(filteredMembers()); });
    memberFilter.addEventListener("change", () => { memberViewFilter = memberFilter.value; render(filteredMembers()); });
    memberFilterReset.addEventListener("click", () => { memberQuery = ""; memberViewFilter = "all"; memberSearch.value = ""; memberFilter.value = "all"; render(filteredMembers()); memberSearch.focus(); });
    root.addEventListener("discord-roles-updated", () => void load());
    const updateWorkflowRoleSelection = () => { const selected = Array.from(workflowRoleForm.querySelector<HTMLSelectElement>('select[name="subject"]')?.selectedOptions ?? []); const label = `${selected.length}分野を選択中`; workflowRoleSelection.value = label; workflowRoleSelection.textContent = label; };
    workflowRoleForm.querySelector<HTMLSelectElement>('select[name="subject"]')?.addEventListener("change", updateWorkflowRoleSelection);
    updateWorkflowRoleSelection();
    workflowRoleForm.addEventListener("submit", async event => { event.preventDefault(); const values = new FormData(workflowRoleForm); const selectedSubjects = values.getAll("subject").map(value => String(value)).filter(Boolean); const submit = workflowRoleForm.querySelector<HTMLButtonElement>('button[type="submit"]'); if (!selectedSubjects.length) return; if (submit) { submit.disabled = true; submit.textContent = "割り当て中…"; } const response = await fetch("/api/admin/editorial-workflow-roles", {method:"POST",credentials:"same-origin",headers:{"content-type":"application/json"},body:JSON.stringify({email:values.get("email"),role:"subject-coordinator",subjects:selectedSubjects})}); const data = await response.json().catch(() => ({})); message.value = response.ok ? `${selectedSubjects.length}分野の分野統括を追加しました。` : (data.error ?? "分野統括を追加できませんでした。"); if (response.ok) { workflowRoleForm.reset(); updateWorkflowRoleSelection(); await load(); } if (submit) { submit.disabled = false; submit.textContent = "統括を追加"; } });
    form.addEventListener("submit", async event => { event.preventDefault(); const values = new FormData(form); const selectedSubjects = values.getAll("subject"); const response = await fetch("/api/admin/report-admin-permissions", {method:"POST",credentials:"same-origin",headers:{"content-type":"application/json"},body:JSON.stringify({email:values.get("email"),subjects:selectedSubjects})}); const data = await response.json().catch(() => ({})); message.value = response.ok ? discordSyncMessage(`${selectedSubjects.length}件の担当権限を追加しました。`, data.provisioning) : (data.error ?? "追加できませんでした。"); if (response.ok) { form.reset(); await load(); } });
    list.addEventListener("click", async event => {
      const target = event.target as HTMLElement;
      const card = target.closest<HTMLElement>("[data-email]");
      if (!card) return;
      const email = card.dataset.email ?? "";
      const open = target.closest<HTMLElement>("[data-open-member], .member-card__name");
      const promote = target.closest<HTMLButtonElement>("[data-promote-manager]");
      const sync = target.closest<HTMLButtonElement>("[data-sync]");
      const remove = target.closest<HTMLButtonElement>("[data-remove]");
      if (open) { openMemberModal(email); return; }
      if (promote) {
        if (!confirm(`${email} を全分野管理者に変更しますか？`)) return;
        promote.disabled = true;
        try {
          const response = await fetch("/api/admin/report-admin-permissions", { method:"POST", credentials:"same-origin", headers:{"content-type":"application/json"}, body:JSON.stringify({email, subject:"*"}) });
          const result = await response.json().catch(() => ({}));
          message.value = response.ok ? "全分野管理者に変更しました。" : (result.error ?? "変更できませんでした。");
          if (response.ok) await load();
        } finally { promote.disabled = false; }
        return;
      }
      if (sync) {
        sync.disabled = true; sync.textContent = "同期中…";
        try {
          const response = await fetch("/api/admin/discord-member-roles", {method:"POST",credentials:"same-origin",headers:{"content-type":"application/json"},body:JSON.stringify({email})});
          const result = await response.json().catch(() => ({}));
          if (!response.ok) throw new Error(result.error ?? "Discord役職を再同期できませんでした。");
          message.value = discordSyncMessage("Discord役職を再同期しました。", result.provisioning); await load();
        } catch (error) { message.value = error instanceof Error ? error.message : "保存・同期できませんでした。"; }
        finally { sync.disabled = false; sync.textContent = "Discordロールを再同期"; }
        return;
      }
      if (remove) { if (!confirm(`${email} の権限を削除しますか？`)) return; const query = new URLSearchParams({email,subject:remove.dataset.subject ?? ""}); const response = await fetch(`/api/admin/report-admin-permissions?${query}`, {method:"DELETE",credentials:"same-origin"}); const data = await response.json().catch(() => ({})); message.value = response.ok ? discordSyncMessage("権限を削除しました。", data.provisioning) : (data.error ?? "削除できませんでした。"); if (response.ok) await load(); }
    });
    workflowRoleList.addEventListener("click", async event => { const remove = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-remove-workflow-role]"); if (!remove) return; remove.disabled = true; const query = new URLSearchParams({email:remove.dataset.email ?? "",role:"subject-coordinator",subject:remove.dataset.subject ?? ""}); const response = await fetch(`/api/admin/editorial-workflow-roles?${query}`, {method:"DELETE",credentials:"same-origin"}); message.value = response.ok ? "分野統括の割り当てを削除しました。" : "分野統括の割り当てを削除できませんでした。"; if (response.ok) await load(); else remove.disabled = false; });
    void load().catch(error => { list.textContent = error instanceof Error ? error.message : "参加者一覧を読み込めませんでした。"; });
  }};
  document.addEventListener("astro:page-load", initializeMemberAdmin);
  initializeMemberAdmin();
</script>

<script>
  const initializeDiscordTools = () => {
  const provisionButton = document.querySelector<HTMLButtonElement>("[data-provision-roles]");
  if (provisionButton?.dataset.initialized === "true") return;
  if (provisionButton) provisionButton.dataset.initialized = "true";
  const provisionMessage = document.querySelector<HTMLOutputElement>("[data-message]");
  provisionButton?.addEventListener("click", async () => {
    if (!confirm("Discord対象サーバーの既存ロールを読み込み、運営サイト側の対応表を更新しますか？Discord側は変更しません。")) return;
    provisionButton.disabled = true;
    const response = await fetch("/api/admin/discord-provision-roles", { method: "POST", credentials: "same-origin" });
    const data = await response.json().catch(() => ({}));
    if (provisionMessage) {
      if (!response.ok) provisionMessage.value = `HTTP ${response.status}: ${data.error ?? "Discordロールを読み込めませんでした。"}`;
      else {
        const missing = Array.isArray(data.missing) ? data.missing.length : 0;
        const ambiguous = Array.isArray(data.ambiguous) ? data.ambiguous.length : 0;
        const unknown = Array.isArray(data.unknownDiscordRoles) ? data.unknownDiscordRoles.length : 0;
        provisionMessage.value = `Discord「${data.guildName}」の既存ロール${data.discordRoles?.length ?? 0}件を読み込みました（対応${data.matched ?? 0}件${missing ? `、定義なし${missing}件` : ""}${ambiguous ? `、同名のためID指定が必要${ambiguous}件` : ""}${unknown ? `、追加選択可${unknown}件` : ""}）。Discord側は変更していません。`;
        provisionButton.dispatchEvent(new CustomEvent("discord-roles-updated"));
      }
    }
    provisionButton.disabled = false;
  });
  const readinessButton = document.querySelector<HTMLButtonElement>("[data-discord-readiness]");
  const readinessMessage = document.querySelector<HTMLOutputElement>("[data-discord-readiness-message]");
  readinessButton?.addEventListener("click", async () => {
    readinessButton.disabled = true;
    readinessButton.textContent = "確認中…";
    if (readinessMessage) readinessMessage.value = "Discord、対応表、メール設定を読み取り確認しています。";
    try {
      const response = await fetch("/api/admin/discord-readiness", { credentials: "same-origin", cache: "no-store" });
      const data = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(data.error ?? `HTTP ${response.status}`);
      const checks = data.checks ?? {};
      const configured = data.configured ?? {};
      const warningText = Array.isArray(data.warnings) && data.warnings.length ? ` 注意: ${data.warnings.join(" ")}` : "";
      const status = data.ready ? "本番運用の前提条件を確認できました。" : "未完了の項目があります。";
      const detail = `Bot API ${checks.botApi ? "OK" : "未確認"} / サーバー ${checks.guildApi ? "OK" : "未確認"} / ロール ${checks.rolesApi ? "OK" : "未確認"} / Botメンバー ${checks.botMember ? "OK" : "未確認"} / ロール管理権限 ${checks.manageRoles ? "OK" : "不足"} / 階層 ${checks.roleHierarchy ? "OK" : "要確認"} / 対応表 ${checks.roleMappings ? "OK" : "未設定"} / メール設定 ${configured.emailDelivery ? "あり（送信自体は未実行）" : "不足"}`;
      if (readinessMessage) readinessMessage.value = `${status} ${detail}.${warningText}`;
    } catch (error) {
      if (readinessMessage) readinessMessage.value = error instanceof Error ? error.message : "事前チェックに失敗しました。";
    } finally {
      readinessButton.disabled = false;
      readinessButton.textContent = "運用事前チェック";
    }
  });
  };
  document.addEventListener("astro:page-load", initializeDiscordTools);
  initializeDiscordTools();
</script>
<style is:global>
  /* 既存の運営サイト（各ジャンル概要等）と同じ余白・罫線・面の扱いに揃える。 */
  .member-admin { max-width: 1280px !important; padding: 0 1.5rem 4rem !important; }
  .member-admin__header { align-items: end !important; background: transparent !important; border: 0 !important; border-bottom: 1px solid var(--border-default) !important; box-shadow: none !important; display: flex !important; gap: 2rem; justify-content: space-between; margin: 1.7rem 0 1.25rem !important; min-height: 0 !important; padding: 0 0 1.25rem !important; }
  .member-admin__header h1 { font-size: clamp(1.75rem, 3vw, 2.25rem) !important; line-height: 1.15 !important; }
