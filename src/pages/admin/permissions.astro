---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { getCollection } from "astro:content";
const subjects = (await getCollection("subjects")).sort((a,b)=>a.data.order-b.data.order);
---
<AdminLayout title="運営者・担当分野管理" description="運営内運営専用の参加者管理" darkReaderLock={true}>
  <main class="member-admin" data-member-admin>
    <header class="member-admin__header">
      <div>
        <p class="member-admin__eyebrow">ATLAS / ACCESS CONTROL</p>
        <h1>運営者・担当分野管理</h1>
        <p class="member-admin__lead">運営メンバーの権限、担当分野、公開フローの統括をまとめて管理します。</p>
      </div>
      <div class="member-admin__header-meta"><span>管理者専用</span><small>変更は保存時に反映</small></div>
    </header>

    <div class="member-admin__workspace">
    <section class="member-admin__add action-card action-card--primary" aria-labelledby="add-member-title">
      <div class="action-card__heading"><span class="action-card__step">01</span><div><p>参加者を追加</p><h2 id="add-member-title">運営権限の付与</h2><small>メールアドレスと担当範囲を選択してください。</small></div></div>
      <form data-add-form>
        <label>メールアドレス<input type="email" name="email" required maxlength="320" placeholder="editor@example.com" /></label>
        <label>担当権限（複数選択可）<select name="subject" multiple required size="4"><option value="*">全分野管理者</option>{subjects.map(s => <option value={s.data.slug}>{s.data.name.ja}（担当）</option>)}</select></label>
        <button type="submit" class="button-primary">運営者を追加</button>
      </form>
      <div class="member-admin__sync"><div><strong>Discordロール対応表</strong><small>Discord側の既存ロールを読み取り、運営サイトと照合します。</small></div><button type="button" class="member-provision" data-provision-roles>既存ロールを読み込む</button></div>
      <output data-message aria-live="polite"></output>
    </section>

    <section class="member-admin__add action-card discord-role-catalog" aria-labelledby="discord-role-catalog-title">
      <div class="action-card__heading"><span class="action-card__step">02</span><div><p>Discord連携</p><h2 id="discord-role-catalog-title">既存ロールのカタログ</h2><small>Discordに存在するロールを読み込み、メンバーへ複数選択で割り当てます。Discord側のロール定義は変更しません。</small></div></div>
      <div class="discord-role-catalog__body"><strong data-discord-role-count>未同期</strong><span data-discord-role-list>「既存ロールを読み込む」を押すと一覧を更新します。</span></div>
    </section>

    <section class="member-admin__add action-card workflow-role-admin" aria-labelledby="workflow-role-title">
      <div class="action-card__heading"><span class="action-card__step">03</span><div><p>公開フロー</p><h2 id="workflow-role-title">分野統括の割り当て</h2><small>「執筆完了」後の公開審査を担当するロールです。</small></div></div>
      <form data-add-workflow-role>
        <label>メールアドレス<input type="email" name="email" required maxlength="320" placeholder="coordinator@example.com" /></label>
        <label>統括する分野<select name="subject" required>{subjects.map(s => <option value={s.data.slug}>{s.data.name.ja}</option>)}</select></label>
        <button type="submit" class="button-primary">統括を追加</button>
      </form>
      <div class="workflow-role-list" data-workflow-role-list><small>読み込み中…</small></div>
    </section>
    </div>

    <section class="member-admin__members" aria-labelledby="member-list-title">
      <div class="member-admin__section-heading"><div><p class="member-admin__eyebrow">運営メンバー</p><h2 id="member-list-title">参加者一覧</h2><small>登録済みメンバーの担当権限とプロフィールを確認できます。</small></div><span class="member-admin__count" data-member-count></span></div>
      <div class="member-toolbar" aria-label="参加者の検索と絞り込み">
        <label class="member-toolbar__search">参加者を検索<input type="search" data-member-search placeholder="名前・メールアドレスで検索" autocomplete="off" /></label>
        <label>表示を絞り込む<select data-member-filter><option value="all">すべての参加者</option><option value="unconnected">Discord未連携</option><option value="no-roles">Discord役職なし</option><option value="has-roles">Discord役職あり</option></select></label>
        <button type="button" class="member-toolbar__reset" data-member-filter-reset>条件をクリア</button>
        <span class="member-toolbar__summary" data-member-filter-summary aria-live="polite"></span>
      </div>
      <div class="member-grid" data-member-list>読み込み中…</div>
    </section>
  </main>
</AdminLayout>

<style is:global>
  .member-admin{box-sizing:border-box;margin:0 auto;max-width:1180px;padding:0 1.25rem 4rem;color:var(--text-primary)}
  .member-admin *{box-sizing:border-box}.member-admin__header{border-bottom:1px solid var(--border-default);padding:2rem 0 1.2rem}.member-admin__header p,.member-admin__section-heading p{color:var(--accent-primary);font-size:.74rem;font-weight:800;letter-spacing:.09em;margin:0 0 .35rem}.member-admin__header h1{font-size:clamp(1.65rem,3vw,2.2rem);margin:0}.member-admin__header span{color:var(--text-secondary);display:block;font-size:.88rem;line-height:1.6;margin-top:.5rem}
  .member-admin__add{background:var(--background-secondary);border:1px solid var(--border-default);display:grid;gap:.8rem;grid-template-columns:185px 1fr;margin:1.2rem 0 1.5rem;padding:.9rem 1rem}.member-admin__add p{color:var(--accent-primary);font-size:.72rem;font-weight:800;letter-spacing:.08em;margin:0 0 .2rem}.member-admin__add h2{font-size:1rem;margin:0}.member-admin__add form{align-items:end;display:grid;gap:.55rem;grid-template-columns:minmax(0,1fr) minmax(160px,.7fr) auto}.member-admin__add label,.member-edit-form label{align-self:start;color:var(--text-secondary);display:grid;font-size:.72rem;font-weight:800;gap:.28rem}.member-admin input,.member-admin select{appearance:auto;background:var(--background-primary)!important;border:1px solid var(--border-default)!important;border-radius:0!important;color:var(--text-primary)!important;font:inherit!important;line-height:1.2!important;min-height:2.35rem!important;outline:none;padding:.45rem .55rem!important;width:100%!important}.member-admin input:focus,.member-admin select:focus{border-color:var(--accent-primary)!important;box-shadow:0 0 0 2px color-mix(in srgb,var(--accent-primary) 18%,transparent)}.member-admin button{appearance:none;border-radius:0!important;cursor:pointer;font:inherit!important;font-size:.78rem!important;font-weight:800!important;line-height:1.2!important;min-height:2.35rem!important;padding:.45rem .65rem!important}.member-admin__add button,.member-action--sync,.member-edit-form__save{background:var(--accent-primary)!important;border:1px solid var(--accent-primary)!important;color:#fff!important}.member-admin__add output{color:var(--text-secondary);font-size:.78rem;grid-column:2/-1;min-height:1em}
  .member-admin__add select[multiple]{min-height:7.2rem!important}.discord-role-catalog{border-left:3px solid var(--accent-primary)}.discord-role-catalog small{color:var(--text-secondary);display:block;font-size:.7rem;line-height:1.5;margin-top:.35rem}.discord-role-catalog__body{align-items:start;display:grid;gap:.35rem;min-width:0}.discord-role-catalog__body strong{color:var(--accent-primary);font-size:.8rem}.discord-role-catalog__body span{color:var(--text-secondary);font-size:.72rem;line-height:1.55;max-height:5.3rem;overflow:auto}
  .member-provision{background:transparent!important;border:1px solid var(--accent-primary)!important;color:var(--accent-primary)!important;justify-self:start}.member-provision:disabled{cursor:wait;opacity:.6}.member-admin__add output{grid-column:2/-1}
  .workflow-role-admin{border-left:3px solid var(--accent-primary)}.workflow-role-admin small{color:var(--text-secondary);display:block;font-size:.7rem;line-height:1.5;margin-top:.35rem}.workflow-role-list{border-top:1px solid var(--border-default);display:flex;flex-wrap:wrap;gap:.4rem;grid-column:2/-1;padding-top:.6rem}.workflow-role-chip{align-items:center;background:var(--background-primary);border:1px solid var(--border-default);display:inline-flex;gap:.35rem;padding:.35rem .5rem}.workflow-role-chip small{color:var(--text-secondary);margin:0}.workflow-role-chip button{background:transparent!important;border:0!important;color:var(--accent-primary)!important;min-height:auto!important;padding:.1rem!important}
  .member-interest-picker{border:1px solid var(--border-default);display:flex;flex-wrap:wrap;gap:.28rem;padding:.4rem}.member-interest-picker label{align-items:center;background:var(--background-secondary);border:1px solid var(--border-default);border-radius:999px;color:var(--text-secondary);display:flex;font-size:.68rem;font-weight:700;gap:.25rem;padding:.25rem .4rem}.member-interest-picker input{accent-color:var(--accent-primary);min-height:auto!important;width:auto!important}.member-edit-form select[data-interests]{display:none}
  .member-admin__section-heading{align-items:end;display:flex;justify-content:space-between;margin-bottom:.7rem}.member-admin__section-heading h2{font-size:1.2rem;margin:0}.member-admin__section-heading span{color:var(--text-secondary);font-size:.78rem}.member-grid{align-items:start;display:grid;gap:.75rem;grid-template-columns:repeat(auto-fill,minmax(320px,1fr))}.member-card{align-self:start;background:var(--background-primary);border:1px solid var(--border-default);display:grid;gap:.7rem;min-width:0;padding:.85rem}.member-card:hover{border-color:var(--accent-primary)}.member-card__top{align-items:center;display:flex;gap:.65rem;min-width:0}.member-avatar{background:var(--background-secondary);border:1px solid var(--border-default);border-radius:50%;display:grid;flex:0 0 2.8rem;height:2.8rem;object-fit:cover;place-items:center;width:2.8rem}.member-avatar--fallback{color:var(--accent-primary);font-size:1rem;font-weight:800}.member-card__identity{min-width:0}.member-card__name{font-size:.98rem;font-weight:800;line-height:1.3}.member-card__email{color:var(--text-secondary);font-size:.72rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.member-card__role{background:var(--background-secondary);border:1px solid var(--border-default);border-radius:999px;font-size:.7rem;margin-left:auto;padding:.22rem .42rem;white-space:nowrap}.member-card__facts{align-self:start;display:flex;flex-wrap:wrap;gap:.35rem}.member-fact{background:var(--background-secondary);border:1px solid var(--border-default);border-radius:999px;color:var(--text-secondary);font-size:.7rem;line-height:1.2;padding:.25rem .42rem}.member-fact b{color:var(--accent-primary)}.member-card__actions{align-self:start;display:flex;gap:.4rem}.member-action--sync{flex:1}.member-action--remove{background:transparent!important;border:1px solid var(--border-default)!important;color:var(--text-secondary)!important}.member-card details{border-top:1px solid var(--border-default);padding-top:.62rem}.member-card summary{color:var(--accent-primary);cursor:pointer;font-size:.76rem;font-weight:800;list-style:none}.member-card summary::-webkit-details-marker{display:none}.member-card summary::before{content:"＋ ";font-size:.9rem}.member-card details[open] summary::before{content:"− "}.member-edit-form{align-items:start;display:grid;gap:.65rem;grid-template-columns:minmax(0,1.45fr) minmax(96px,.55fr);margin-top:.65rem}.member-edit-form .member-edit-form__subjects{grid-column:1/-1}.member-edit-form select[multiple]{height:7.4rem!important;min-height:7.4rem!important;padding:.2rem!important}.member-edit-form small{color:var(--text-secondary);font-size:.66rem;line-height:1.4}.member-edit-form__save{grid-column:1/-1;justify-self:start}.member-empty{border:1px dashed var(--border-default);color:var(--text-secondary);padding:2rem;text-align:center}
  @media(max-width:720px){.member-admin{padding:0 .85rem 3rem}.member-admin__header{padding-top:1.25rem}.member-admin__add{display:block;padding:.85rem}.member-admin__add form{display:grid;grid-template-columns:1fr;margin-top:.8rem}.member-admin__add output{display:block;margin-top:.55rem}.member-grid{grid-template-columns:1fr}.member-card{padding:.75rem}.member-card__top{align-items:flex-start}.member-card__role{margin-left:0}.member-card__top{flex-wrap:wrap}.member-card__actions{display:grid;grid-template-columns:1fr 1fr}.member-edit-form{grid-template-columns:1fr}.member-edit-form .member-edit-form__subjects,.member-edit-form__save{grid-column:auto}.member-admin__section-heading{align-items:start;display:block}.member-admin__section-heading span{display:block;margin-top:.25rem}}
</style>

<style is:global>
  /* 保存操作はカード上部の保存ボタンに統合。編集欄は閉じるだけにする。 */
  .member-edit-form__close {
    background: transparent !important;
    border: 1px solid var(--border-default) !important;
    color: var(--text-secondary) !important;
    grid-column: 1 / -1;
    justify-self: start;
  }
  .member-action--promote {
    background: var(--background-secondary) !important;
    border: 1px solid var(--accent-primary) !important;
    color: var(--accent-primary) !important;
  }
</style>

<style is:global>
  /* 運営者管理は、操作の確実性を優先した白背景のトランザクションUIに統一する。 */
  html:has(.member-admin) {
    --text-primary: #17324d !important;
    --text-secondary: #526779 !important;
    --background-primary: #ffffff !important;
    --background-secondary: #f3f7fb !important;
    --background-inset: #e9f1f7 !important;
    --border-default: #cddce7 !important;
    --border-strong: #7894aa !important;
    --accent-primary: #075a91 !important;
    --accent-hover: #064b78 !important;
    --accent-subtle: #e4f1f9 !important;
    --link: #075a91 !important;
    color-scheme: light;
  }
  body:has(.member-admin) { background: #f3f7fb; color: #17324d; }
  body:has(.member-admin) .admin-layout-main { background: #f3f7fb; }
  .member-admin { max-width: 1240px; padding: 2rem 1.25rem 5rem; }
  .member-admin__header { align-items: center; background: #fff; border: 1px solid #cddce7; border-top: 4px solid #075a91; box-shadow: 0 2px 8px rgb(18 62 91 / 6%); display: flex; gap: 1.5rem; justify-content: space-between; margin: 0 0 1.25rem; padding: 1.35rem 1.5rem 1.2rem; }
  .member-admin__eyebrow { color: #075a91 !important; font-size: .7rem !important; font-weight: 900 !important; letter-spacing: .1em; margin: 0 0 .3rem !important; }
  .member-admin__header h1 { color: #17324d; font-size: clamp(1.55rem, 2.8vw, 2.1rem); letter-spacing: .01em; margin: 0; }
  .member-admin__lead { color: #526779; font-size: .82rem; line-height: 1.65; margin: .45rem 0 0; }
  .member-admin__header-meta { align-items: flex-end; display: grid; flex: 0 0 auto; gap: .2rem; text-align: right; }
  .member-admin__header-meta span { background: #e4f1f9; border: 1px solid #9fc5dd; color: #075a91; font-size: .7rem; font-weight: 900; padding: .35rem .55rem; }
  .member-admin__header-meta small { color: #526779; font-size: .68rem; }
  /* 横並びカードは内容の高さで止め、背の高い左カードに右カードを引き伸ばさない。 */
  .member-admin__workspace { align-items: start; display: grid; gap: 1rem; grid-template-columns: minmax(0, 1.08fr) minmax(0, .92fr); margin-bottom: 2rem; }
  .member-admin__workspace .action-card { align-content: start; background: #fff; border: 1px solid #cddce7; border-top: 3px solid #075a91; box-shadow: 0 2px 7px rgb(18 62 91 / 5%); display: grid; gap: 1rem; margin: 0; padding: 1.1rem 1.2rem 1rem; }
  .member-admin__workspace .workflow-role-admin { border-top-color: #2d78a8; }
  .action-card__heading { align-items: flex-start; display: flex; gap: .75rem; }
  .action-card__step { align-items: center; background: #075a91; color: #fff; display: inline-flex; flex: 0 0 2rem; font-size: .75rem; font-weight: 900; height: 2rem; justify-content: center; letter-spacing: .04em; }
  .workflow-role-admin .action-card__step { background: #2d78a8; }
  .action-card__heading p { color: #075a91; font-size: .68rem; font-weight: 900; letter-spacing: .08em; margin: 0 0 .15rem; }
  .action-card__heading h2 { color: #17324d; font-size: 1.08rem; margin: 0; }
  .action-card__heading small { color: #526779; display: block; font-size: .72rem; line-height: 1.55; margin-top: .28rem; }
  .member-admin__workspace .action-card form { align-items: end; display: grid; gap: .65rem; grid-column: 1 / -1; grid-template-columns: minmax(0, 1fr) minmax(9.5rem, .72fr) auto; }
  .member-admin label { color: #526779 !important; font-size: .7rem !important; font-weight: 800 !important; gap: .3rem !important; }
  .member-admin input, .member-admin select { background: #fff !important; border: 1px solid #b9ccda !important; border-radius: 4px !important; color: #17324d !important; min-height: 2.65rem !important; padding: .55rem .65rem !important; }
  .member-admin input::placeholder { color: #8396a5; }
  .member-admin input:focus, .member-admin select:focus { border-color: #075a91 !important; box-shadow: 0 0 0 3px rgb(7 90 145 / 15%) !important; }
  .member-admin button { border-radius: 4px !important; min-height: 2.65rem !important; padding: .55rem .85rem !important; }
  .member-admin .button-primary, .member-admin .member-action--sync, .member-admin .member-edit-form__save { background: #075a91 !important; border: 1px solid #075a91 !important; color: #fff !important; }
  .member-admin .button-primary { box-shadow: 0 2px 4px rgb(7 90 145 / 18%); white-space: nowrap; }
  .member-admin .button-primary:hover, .member-admin .member-action--sync:hover { background: #064b78 !important; }
  .member-admin__sync { align-items: center; border-top: 1px solid #dbe7ef; display: flex; gap: 1rem; grid-column: 1 / -1; justify-content: space-between; padding-top: .9rem; }
  .member-admin__sync div { display: grid; gap: .15rem; }
  .member-admin__sync strong { color: #17324d; font-size: .78rem; }
  .member-admin__sync small { color: #526779; font-size: .68rem; line-height: 1.45; }
  .member-admin .member-provision { background: #fff !important; border: 1px solid #075a91 !important; color: #075a91 !important; font-size: .72rem !important; white-space: nowrap; }
  .member-admin .member-provision:hover { background: #e4f1f9 !important; }
  .member-admin__workspace .action-card output { color: #526779; font-size: .72rem; grid-column: 1 / -1; min-height: 1.1em; }
  .member-admin__workspace .workflow-role-list { border-top: 1px solid #dbe7ef; display: flex; flex-wrap: wrap; gap: .45rem; grid-column: 1 / -1; padding-top: .85rem; }
  .workflow-role-chip { background: #f3f7fb !important; border: 1px solid #b9ccda !important; border-radius: 3px; color: #17324d; padding: .38rem .55rem !important; }
  .workflow-role-chip small { color: #526779 !important; }
  .workflow-role-chip button { color: #075a91 !important; }
  .member-admin__members { background: #fff; border: 1px solid #cddce7; box-shadow: 0 2px 7px rgb(18 62 91 / 5%); padding: 1.15rem 1.2rem 1.3rem; }
  .member-admin__section-heading { align-items: end; border-bottom: 2px solid #075a91; margin-bottom: 1rem; padding-bottom: .7rem; }
  .member-admin__section-heading h2 { color: #17324d; font-size: 1.22rem; margin: 0; }
  .member-admin__section-heading small { color: #526779; display: block; font-size: .72rem; line-height: 1.5; margin-top: .22rem; }
  .member-admin__count { background: #e4f1f9; border: 1px solid #9fc5dd; color: #075a91 !important; font-size: .78rem !important; font-weight: 900; padding: .35rem .6rem; }
  .member-grid { gap: .8rem; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); }
  .member-card { background: #fff !important; border: 1px solid #cddce7 !important; border-top: 3px solid #dbe7ef !important; box-shadow: 0 1px 4px rgb(18 62 91 / 4%); padding: 1rem !important; }
  .member-card:hover { border-color: #9fc5dd !important; border-top-color: #075a91 !important; box-shadow: 0 3px 9px rgb(18 62 91 / 9%); }
  .member-avatar { background: #eaf2f7 !important; border-color: #b9ccda !important; }
  .member-card__name { color: #17324d; }
  .member-card__email { color: #526779; }
  .member-card__role { background: #e4f1f9 !important; border: 1px solid #9fc5dd !important; border-radius: 3px !important; color: #075a91; font-weight: 800; }
  .member-fact { background: #f3f7fb !important; border: 1px solid #d3e0e9 !important; border-radius: 3px !important; color: #526779 !important; }
  .member-fact b { color: #075a91 !important; }
  .member-card__actions { border-top: 1px solid #dbe7ef; display: grid; gap: .45rem; grid-template-columns: repeat(2, minmax(0, 1fr)); padding-top: .75rem; }
  .member-card__actions .member-action--sync { grid-column: 1 / -1; }
  .member-card__actions .member-action--promote, .member-card__actions .member-action--remove { font-size: .7rem !important; min-height: 2.15rem !important; padding: .36rem .5rem !important; white-space: nowrap; }
  .member-admin .member-action--remove, .member-admin .member-action--promote { background: #fff !important; border: 1px solid #b9ccda !important; color: #526779 !important; }
  .member-admin .member-action--promote { color: #075a91 !important; }
  .member-admin .member-action--remove:hover, .member-admin .member-action--promote:hover { background: #f3f7fb !important; border-color: #075a91 !important; }
  .member-card details { border-top: 1px solid #dbe7ef; }
  .member-card summary { color: #075a91 !important; }
  .member-interest-picker { background: #f3f7fb; border: 1px solid #b9ccda; border-radius: 4px; padding: .5rem !important; }
  .member-interest-picker label { background: #fff !important; border: 1px solid #cddce7 !important; border-radius: 3px !important; color: #526779 !important; padding: .34rem .45rem !important; }
  .member-interest-picker label:has(input:checked) { background: #e4f1f9 !important; border-color: #2d78a8 !important; box-shadow: inset 0 0 0 1px #2d78a8; color: #075a91 !important; }
  .member-interest-picker input { accent-color: #075a91; }
  .member-empty { background: #f3f7fb; border: 1px dashed #9fb4c4; color: #526779; padding: 2.5rem; }
  @media (max-width: 820px) {
    .member-admin { padding: 1.25rem .85rem 3rem; }
    .member-admin__header { align-items: flex-start; display: grid; padding: 1.1rem; }
    .member-admin__header-meta { align-items: start; text-align: left; }
    .member-admin__workspace { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .member-admin__members { padding: .9rem .8rem 1rem; }
    .member-admin__workspace .action-card { padding: .9rem; }
    .member-admin__workspace .action-card form { grid-template-columns: 1fr; }
    .member-admin__sync { align-items: flex-start; display: grid; }
    .member-admin__section-heading { align-items: start; display: grid; gap: .5rem; }
    .member-admin__count { justify-self: start; }
    .member-card__actions { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .member-card__actions .member-action--sync { grid-column: 1 / -1; }
  }
</style>

<style is:global>
  /* 個人単位の管理を主役にした、検索可能なロール操作パネル。 */
  .member-admin__workspace .workflow-role-admin { grid-column: 1 / -1; }
  .member-toolbar {
    align-items: end;
    background: #f3f7fb;
    border: 1px solid #d3e0e9;
    display: grid;
    gap: .7rem;
    grid-template-columns: minmax(220px, 1.5fr) minmax(180px, .8fr) auto;
    margin-bottom: 1rem;
    padding: .8rem;
  }
  .member-toolbar label { display: grid; gap: .3rem; }
  .member-toolbar__reset {
    background: #fff !important;
    border: 1px solid #b9ccda !important;
    color: #526779 !important;
    white-space: nowrap;
  }
  .member-toolbar__reset:hover { border-color: #075a91 !important; color: #075a91 !important; }
  .member-toolbar__summary { color: #526779; font-size: .7rem; grid-column: 1 / -1; min-height: 1em; }
  .member-card__discord {
    background: #f3f7fb;
    border: 1px solid #d3e0e9;
    border-left: 3px solid #2d78a8;
    display: grid;
