      if (remove) { if (!confirm(`${email} の権限を削除しますか？`)) return; const query = new URLSearchParams({email,subject:remove.dataset.subject ?? ""}); const response = await fetch(`/api/admin/report-admin-permissions?${query}`, {method:"DELETE",credentials:"same-origin"}); const data = await response.json().catch(() => ({})); message.value = response.ok ? discordSyncMessage("権限を削除しました。", data.provisioning) : (data.error ?? "削除できませんでした。"); if (response.ok) await load(); }
    });
    workflowRoleList.addEventListener("click", async event => { const remove = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-remove-workflow-role]"); if (!remove) return; remove.disabled = true; const query = new URLSearchParams({email:remove.dataset.email ?? "",role:"subject-coordinator",subject:remove.dataset.subject ?? ""}); const response = await fetch(`/api/admin/editorial-workflow-roles?${query}`, {method:"DELETE",credentials:"same-origin"}); message.value = response.ok ? "分野統括の割り当てを削除しました。" : "分野統括の割り当てを削除できませんでした。"; if (response.ok) await load(); else remove.disabled = false; });
    void load().catch(error => { list.textContent = error instanceof Error ? error.message : "参加者一覧を読み込めませんでした。"; });
  }};
  document.addEventListener("astro:page-load", initializeMemberAdmin);
  initializeMemberAdmin();
</script>

<script>
  const initializePermissionAudit = () => {
    const list = document.querySelector<HTMLElement>("[data-permission-audit-list]");
    if (!list || list.dataset.ready === "true") return;
    list.dataset.ready = "true";
    const pagination = document.querySelector<HTMLElement>("[data-permission-audit-pagination]");
    const summary = document.querySelector<HTMLElement>("[data-permission-audit-summary]");
    const loadMore = document.querySelector<HTMLButtonElement>("[data-permission-audit-load-more]");
    const includeArchived = document.querySelector<HTMLInputElement>("[data-permission-audit-include-archived]");
    const escape = (value: unknown) => String(value ?? "").replace(/[&<>\"']/g, (char) => ({ "&":"&amp;", "<":"&lt;", ">":"&gt;", '\"':"&quot;", "'":"&#39;" }[char] ?? char));
    const actionLabel = (value: string) => value === "grant" ? "権限を付与" : value === "revoke" ? "権限を削除" : "権限を置換";
    let nextCursor = "";
    let loading = false;
    let loadedCount = 0;
    const renderEntries = (entries: Array<{ action?: string; actor_email?: string; target_email?: string; before_subjects?: string; after_subjects?: string; created_at?: string; archived_at?: string | null }>) => entries.map((entry) => {
      const before = String(entry.before_subjects ?? "").trim() || "なし";
      const after = String(entry.after_subjects ?? "").trim() || "なし";
      const time = entry.created_at ? new Date(entry.created_at).toLocaleString("ja-JP", { dateStyle: "short", timeStyle: "short" }) : "—";
      return `<div class="permission-audit__entry${entry.archived_at ? " permission-audit__entry--archived" : ""}"><strong>${escape(actionLabel(String(entry.action ?? "replace")))}${entry.archived_at ? "（アーカイブ）" : ""}</strong><span>${escape(entry.target_email)}<small>（実行者: ${escape(entry.actor_email)}）</small><br><small>${escape(before)} → ${escape(after)}</small></span><time datetime="${escape(entry.created_at)}">${escape(time)}</time></div>`;
    }).join("");
    const fetchPage = async (append = false) => {
      if (loading || (append && !nextCursor)) return;
      loading = true;
      if (loadMore) { loadMore.disabled = true; loadMore.textContent = "読み込み中…"; }
      try {
        const query = new URLSearchParams({ limit: "30" });
        if (includeArchived?.checked) query.set("includeArchived", "1");
        if (append) query.set("cursor", nextCursor);
        const response = await fetch(`/api/admin/permission-audit?${query.toString()}`, { credentials: "same-origin", cache: "no-store" });
        const data = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(data.error ?? "履歴を読み込めませんでした。");
        const entries = Array.isArray(data.entries) ? data.entries : [];
        list.classList.remove("loading-state");
        if (append) list.insertAdjacentHTML("beforeend", renderEntries(entries));
        else list.innerHTML = entries.length ? renderEntries(entries) : '<p class="permission-audit__empty">権限変更履歴はまだありません。</p>';
        loadedCount += entries.length;
        nextCursor = String(data.pagination?.nextCursor ?? "");
        if (summary) summary.textContent = loadedCount ? `${loadedCount}件を表示中` : "";
        if (pagination) pagination.hidden = !nextCursor;
      } catch (error) {
        list.classList.remove("loading-state");
        if (!loadedCount) list.innerHTML = `<p class="permission-audit__empty">${escape(error instanceof Error ? error.message : "履歴を読み込めませんでした。")}</p>`;
      } finally {
        loading = false;
        if (loadMore) { loadMore.disabled = false; loadMore.textContent = "さらに読み込む"; }
      }
    };
    loadMore?.addEventListener("click", () => void fetchPage(true));
    includeArchived?.addEventListener("change", () => { nextCursor = ""; loadedCount = 0; void fetchPage(); });
    void fetchPage();
  };
  document.addEventListener("astro:page-load", initializePermissionAudit);
  initializePermissionAudit();
</script>

<script>
  const initializeDiscordTools = () => {
  const provisionButton = document.querySelector<HTMLButtonElement>("[data-provision-roles]");
  if (provisionButton?.dataset.initialized === "true") return;
  if (provisionButton) provisionButton.dataset.initialized = "true";
  const provisionMessage = document.querySelector<HTMLOutputElement>("[data-message]");
  provisionButton?.addEventListener("click", async () => {
    if (!confirm("Discord対象サーバーの既存ロールを読み込み、運営サイト側の対応表を更新しますか？Discord側は変更しません。")) return;
    provisionButton.disabled = true;
    const response = await fetch("/api/admin/discord-provision-roles", { method: "POST", credentials: "same-origin" });
    const data = await response.json().catch(() => ({}));
    if (provisionMessage) {
      if (!response.ok) provisionMessage.value = `HTTP ${response.status}: ${data.error ?? "Discordロールを読み込めませんでした。"}`;
      else {
        const missing = Array.isArray(data.missing) ? data.missing.length : 0;
        const ambiguous = Array.isArray(data.ambiguous) ? data.ambiguous.length : 0;
        const unknown = Array.isArray(data.unknownDiscordRoles) ? data.unknownDiscordRoles.length : 0;
        provisionMessage.value = `Discord「${data.guildName}」の既存ロール${data.discordRoles?.length ?? 0}件を読み込みました（対応${data.matched ?? 0}件${missing ? `、定義なし${missing}件` : ""}${ambiguous ? `、同名のためID指定が必要${ambiguous}件` : ""}${unknown ? `、追加選択可${unknown}件` : ""}）。Discord側は変更していません。`;
        provisionButton.dispatchEvent(new CustomEvent("discord-roles-updated"));
      }
    }
    provisionButton.disabled = false;
  });
  const readinessButton = document.querySelector<HTMLButtonElement>("[data-discord-readiness]");
  const readinessMessage = document.querySelector<HTMLOutputElement>("[data-discord-readiness-message]");
  readinessButton?.addEventListener("click", async () => {
    readinessButton.disabled = true;
    readinessButton.textContent = "確認中…";
    if (readinessMessage) readinessMessage.value = "Discord、対応表、メール設定を読み取り確認しています。";
    try {
      const response = await fetch("/api/admin/discord-readiness", { credentials: "same-origin", cache: "no-store" });
      const data = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(data.error ?? `HTTP ${response.status}`);
      const checks = data.checks ?? {};
      const configured = data.configured ?? {};
      const warningText = Array.isArray(data.warnings) && data.warnings.length ? ` 注意: ${data.warnings.join(" ")}` : "";
      const status = data.ready ? "本番運用の前提条件を確認できました。" : "未完了の項目があります。";
      const detail = `Bot API ${checks.botApi ? "OK" : "未確認"} / サーバー ${checks.guildApi ? "OK" : "未確認"} / ロール ${checks.rolesApi ? "OK" : "未確認"} / Botメンバー ${checks.botMember ? "OK" : "未確認"} / ロール管理権限 ${checks.manageRoles ? "OK" : "不足"} / 階層 ${checks.roleHierarchy ? "OK" : "要確認"} / 対応表 ${checks.roleMappings ? "OK" : "未設定"} / メール設定 ${configured.emailDelivery ? "あり（送信自体は未実行）" : "不足"}`;
      if (readinessMessage) readinessMessage.value = `${status} ${detail}.${warningText}`;
    } catch (error) {
      if (readinessMessage) readinessMessage.value = error instanceof Error ? error.message : "事前チェックに失敗しました。";
    } finally {
      readinessButton.disabled = false;
      readinessButton.textContent = "運用事前チェック";
    }
  });
  };
  document.addEventListener("astro:page-load", initializeDiscordTools);
  initializeDiscordTools();
</script>
