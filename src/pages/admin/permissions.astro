  .member-provision{background:transparent!important;border:1px solid var(--accent-primary)!important;color:var(--accent-primary)!important;justify-self:start}.member-provision:disabled{cursor:wait;opacity:.6}.member-admin__add output{grid-column:2/-1}
  .workflow-role-admin{border-left:3px solid var(--accent-primary)}.workflow-role-admin small{color:var(--text-secondary);display:block;font-size:.7rem;line-height:1.5;margin-top:.35rem}.workflow-role-list{border-top:1px solid var(--border-default);display:grid;gap:.65rem;grid-column:2/-1;padding-top:.6rem}.workflow-role-summary{color:var(--text-secondary);font-size:.72rem}.workflow-role-summary strong{color:var(--accent-primary)}.workflow-role-group{background:var(--background-primary);border:1px solid var(--border-default);display:grid;gap:.45rem;padding:.55rem .65rem}.workflow-role-group__heading{align-items:center;display:flex;gap:.5rem;justify-content:space-between}.workflow-role-group__heading h3{font-size:.78rem;margin:0}.workflow-role-group__heading span{color:var(--text-secondary);font-size:.68rem}.workflow-role-assignees{display:flex;flex-wrap:wrap;gap:.35rem}.workflow-role-chip{align-items:center;background:var(--background-secondary);border:1px solid var(--border-default);display:inline-flex;gap:.35rem;padding:.35rem .5rem}.workflow-role-chip__identity{display:grid;gap:.08rem}.workflow-role-chip__identity b{font-size:.74rem}.workflow-role-chip__identity small{color:var(--text-secondary);font-size:.64rem;margin:0}.workflow-role-chip button{background:transparent!important;border:0!important;color:var(--accent-primary)!important;min-height:auto!important;padding:.1rem!important}.workflow-role-unassigned{color:var(--text-secondary);font-size:.7rem}.workflow-role-unassigned summary{cursor:pointer;font-weight:800}.workflow-role-unassigned span{display:block;line-height:1.55;margin-top:.35rem}
  .member-interest-picker{border:1px solid var(--border-default);display:flex;flex-wrap:wrap;gap:.28rem;padding:.4rem}.member-interest-picker label{align-items:center;background:var(--background-secondary);border:1px solid var(--border-default);border-radius:999px;color:var(--text-secondary);display:flex;font-size:.68rem;font-weight:700;gap:.25rem;padding:.25rem .4rem}.member-interest-picker input{accent-color:var(--accent-primary);min-height:auto!important;width:auto!important}
  .member-admin__section-heading{align-items:end;display:flex;justify-content:space-between;margin-bottom:.7rem}.member-admin__section-heading h2{font-size:1.2rem;margin:0}.member-admin__section-heading span{color:var(--text-secondary);font-size:.78rem}.member-grid{align-items:start;display:grid;gap:.75rem;grid-template-columns:repeat(auto-fill,minmax(320px,1fr))}.member-card{align-self:start;background:var(--background-primary);border:1px solid var(--border-default);display:grid;gap:.7rem;min-width:0;padding:.85rem}.member-card:hover{border-color:var(--accent-primary)}.member-card__top{align-items:center;display:flex;gap:.65rem;min-width:0}.member-avatar{background:var(--background-secondary);border:1px solid var(--border-default);border-radius:50%;display:grid;flex:0 0 2.8rem;height:2.8rem;object-fit:cover;place-items:center;width:2.8rem}.member-avatar--fallback{color:var(--accent-primary);font-size:1rem;font-weight:800}.member-card__identity{min-width:0}.member-card__name{font-size:.98rem;font-weight:800;line-height:1.3}.member-card__email{color:var(--text-secondary);font-size:.72rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.member-card__role{background:var(--background-secondary);border:1px solid var(--border-default);border-radius:999px;font-size:.7rem;margin-left:auto;padding:.22rem .42rem;white-space:nowrap}.member-card__facts{align-self:start;display:flex;flex-wrap:wrap;gap:.35rem}.member-fact{background:var(--background-secondary);border:1px solid var(--border-default);border-radius:999px;color:var(--text-secondary);font-size:.7rem;line-height:1.2;padding:.25rem .42rem}.member-fact b{color:var(--accent-primary)}.member-card__actions{align-self:start;display:flex;gap:.4rem}.member-action--sync{flex:1}.member-action--remove{background:transparent!important;border:1px solid var(--border-default)!important;color:var(--text-secondary)!important}.member-empty{border:1px dashed var(--border-default);color:var(--text-secondary);padding:2rem;text-align:center}
  @media(max-width:720px){.member-admin{padding:0 .85rem 3rem}.member-admin__header{padding-top:1.25rem}.member-admin__add{display:block;padding:.85rem}.member-admin__add form{display:grid;grid-template-columns:1fr;margin-top:.8rem}.member-admin__add output{display:block;margin-top:.55rem}.member-grid{grid-template-columns:1fr}.member-card{padding:.75rem}.member-card__top{align-items:flex-start}.member-card__role{margin-left:0}.member-card__top{flex-wrap:wrap}.member-card__actions{display:grid;grid-template-columns:1fr 1fr}.member-admin__section-heading{align-items:start;display:block}.member-admin__section-heading span{display:block;margin-top:.25rem}}
