---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { getCollection } from "astro:content";
const subjects = (await getCollection("subjects")).sort((a,b)=>a.data.order-b.data.order);
---
<AdminLayout title="運営者・担当分野管理" description="運営内運営専用の参加者管理">
  <main class="member-admin" data-member-admin>
    <header class="member-admin__header">
      <h1>運営者・担当分野管理</h1>
      <span>参加者の権限・所属・学年・分野を管理します。メールアドレスは全分野管理者のみに表示されます。</span>
    </header>

    <section class="member-admin__add" aria-labelledby="add-member-title">
      <div><p>参加者を追加</p><h2 id="add-member-title">運営権限の付与</h2></div>
      <form data-add-form>
        <label>メールアドレス<input type="email" name="email" required maxlength="320" placeholder="editor@example.com" /></label>
        <label>担当権限<select name="subject" required><option value="*">全分野管理者</option>{subjects.map(s => <option value={s.data.slug}>{s.data.name.ja}（担当）</option>)}</select></label>
        <button type="submit">追加する</button>
      </form>
      <button type="button" class="member-provision" data-provision-roles>Bot test serverのロールを準備</button>
      <output data-message aria-live="polite"></output>
    </section>

    <section class="member-admin__members" aria-labelledby="member-list-title">
      <div class="member-admin__section-heading"><div><p>参加者</p><h2 id="member-list-title">参加者一覧</h2></div><span data-member-count></span></div>
      <div class="member-grid" data-member-list>読み込み中…</div>
    </section>
  </main>
</AdminLayout>

<style is:global>
  .member-admin{box-sizing:border-box;margin:0 auto;max-width:1180px;padding:0 1.25rem 4rem;color:var(--text-primary)}
  .member-admin *{box-sizing:border-box}.member-admin__header{border-bottom:1px solid var(--border-default);padding:2rem 0 1.2rem}.member-admin__header p,.member-admin__section-heading p{color:var(--accent-primary);font-size:.74rem;font-weight:800;letter-spacing:.09em;margin:0 0 .35rem}.member-admin__header h1{font-size:clamp(1.65rem,3vw,2.2rem);margin:0}.member-admin__header span{color:var(--text-secondary);display:block;font-size:.88rem;line-height:1.6;margin-top:.5rem}
  .member-admin__add{background:var(--background-secondary);border:1px solid var(--border-default);display:grid;gap:.8rem;grid-template-columns:185px 1fr;margin:1.2rem 0 1.5rem;padding:.9rem 1rem}.member-admin__add p{color:var(--accent-primary);font-size:.72rem;font-weight:800;letter-spacing:.08em;margin:0 0 .2rem}.member-admin__add h2{font-size:1rem;margin:0}.member-admin__add form{align-items:end;display:grid;gap:.55rem;grid-template-columns:minmax(0,1fr) minmax(160px,.7fr) auto}.member-admin__add label,.member-edit-form label{align-self:start;color:var(--text-secondary);display:grid;font-size:.72rem;font-weight:800;gap:.28rem}.member-admin input,.member-admin select{appearance:auto;background:var(--background-primary)!important;border:1px solid var(--border-default)!important;border-radius:0!important;color:var(--text-primary)!important;font:inherit!important;line-height:1.2!important;min-height:2.35rem!important;outline:none;padding:.45rem .55rem!important;width:100%!important}.member-admin input:focus,.member-admin select:focus{border-color:var(--accent-primary)!important;box-shadow:0 0 0 2px color-mix(in srgb,var(--accent-primary) 18%,transparent)}.member-admin button{appearance:none;border-radius:0!important;cursor:pointer;font:inherit!important;font-size:.78rem!important;font-weight:800!important;line-height:1.2!important;min-height:2.35rem!important;padding:.45rem .65rem!important}.member-admin__add button,.member-action--sync,.member-edit-form__save{background:var(--accent-primary)!important;border:1px solid var(--accent-primary)!important;color:#fff!important}.member-admin__add output{color:var(--text-secondary);font-size:.78rem;grid-column:2/-1;min-height:1em}
  .member-provision{background:transparent!important;border:1px solid var(--accent-primary)!important;color:var(--accent-primary)!important;justify-self:start}.member-provision:disabled{cursor:wait;opacity:.6}.member-admin__add output{grid-column:2/-1}
  .member-discord-id{border-top:1px solid var(--border-default);display:grid;gap:.3rem;padding-top:.55rem}.member-discord-id label{color:var(--text-secondary);font-size:.68rem;font-weight:800}.member-discord-id__row{display:flex;gap:.35rem}.member-discord-id input{min-width:0!important;min-height:2rem!important}.member-discord-id button{background:var(--background-secondary)!important;border:1px solid var(--border-default)!important;color:var(--accent-primary)!important;min-height:2rem!important;white-space:nowrap}.member-discord-id output{color:var(--text-secondary);font-size:.66rem;min-height:1em}
  .member-interest-picker{border:1px solid var(--border-default);display:flex;flex-wrap:wrap;gap:.28rem;padding:.4rem}.member-interest-picker label{align-items:center;background:var(--background-secondary);border:1px solid var(--border-default);border-radius:999px;color:var(--text-secondary);display:flex;font-size:.68rem;font-weight:700;gap:.25rem;padding:.25rem .4rem}.member-interest-picker input{accent-color:var(--accent-primary);min-height:auto!important;width:auto!important}.member-edit-form select[data-interests]{display:none}
  .member-admin__section-heading{align-items:end;display:flex;justify-content:space-between;margin-bottom:.7rem}.member-admin__section-heading h2{font-size:1.2rem;margin:0}.member-admin__section-heading span{color:var(--text-secondary);font-size:.78rem}.member-grid{align-items:start;display:grid;gap:.75rem;grid-template-columns:repeat(auto-fill,minmax(320px,1fr))}.member-card{align-self:start;background:var(--background-primary);border:1px solid var(--border-default);display:grid;gap:.7rem;min-width:0;padding:.85rem}.member-card:hover{border-color:var(--accent-primary)}.member-card__top{align-items:center;display:flex;gap:.65rem;min-width:0}.member-avatar{background:var(--background-secondary);border:1px solid var(--border-default);border-radius:50%;display:grid;flex:0 0 2.8rem;height:2.8rem;object-fit:cover;place-items:center;width:2.8rem}.member-avatar--fallback{color:var(--accent-primary);font-size:1rem;font-weight:800}.member-card__identity{min-width:0}.member-card__name{font-size:.98rem;font-weight:800;line-height:1.3}.member-card__email{color:var(--text-secondary);font-size:.72rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.member-card__role{background:var(--background-secondary);border:1px solid var(--border-default);border-radius:999px;font-size:.7rem;margin-left:auto;padding:.22rem .42rem;white-space:nowrap}.member-card__facts{align-self:start;display:flex;flex-wrap:wrap;gap:.35rem}.member-fact{background:var(--background-secondary);border:1px solid var(--border-default);border-radius:999px;color:var(--text-secondary);font-size:.7rem;line-height:1.2;padding:.25rem .42rem}.member-fact b{color:var(--accent-primary)}.member-card__actions{align-self:start;display:flex;gap:.4rem}.member-action--sync{flex:1}.member-action--remove{background:transparent!important;border:1px solid var(--border-default)!important;color:var(--text-secondary)!important}.member-card details{border-top:1px solid var(--border-default);padding-top:.62rem}.member-card summary{color:var(--accent-primary);cursor:pointer;font-size:.76rem;font-weight:800;list-style:none}.member-card summary::-webkit-details-marker{display:none}.member-card summary::before{content:"＋ ";font-size:.9rem}.member-card details[open] summary::before{content:"− "}.member-edit-form{align-items:start;display:grid;gap:.65rem;grid-template-columns:minmax(0,1.45fr) minmax(96px,.55fr);margin-top:.65rem}.member-edit-form .member-edit-form__subjects{grid-column:1/-1}.member-edit-form select[multiple]{height:7.4rem!important;min-height:7.4rem!important;padding:.2rem!important}.member-edit-form small{color:var(--text-secondary);font-size:.66rem;line-height:1.4}.member-edit-form__save{grid-column:1/-1;justify-self:start}.member-empty{border:1px dashed var(--border-default);color:var(--text-secondary);padding:2rem;text-align:center}
  @media(max-width:720px){.member-admin{padding:0 .85rem 3rem}.member-admin__header{padding-top:1.25rem}.member-admin__add{display:block;padding:.85rem}.member-admin__add form{display:grid;grid-template-columns:1fr;margin-top:.8rem}.member-admin__add output{display:block;margin-top:.55rem}.member-grid{grid-template-columns:1fr}.member-card{padding:.75rem}.member-card__top{align-items:flex-start}.member-card__role{margin-left:0}.member-card__top{flex-wrap:wrap}.member-card__actions{display:grid;grid-template-columns:1fr 1fr}.member-edit-form{grid-template-columns:1fr}.member-edit-form .member-edit-form__subjects,.member-edit-form__save{grid-column:auto}.member-admin__section-heading{align-items:start;display:block}.member-admin__section-heading span{display:block;margin-top:.25rem}}
</style>

<style is:global>
  /* 保存操作はカード上部のDiscord同期ボタンに統合。編集欄は閉じるだけにする。 */
  .member-edit-form__close {
    background: transparent !important;
    border: 1px solid var(--border-default) !important;
    color: var(--text-secondary) !important;
    grid-column: 1 / -1;
    justify-self: start;
  }
  .member-action--promote {
    background: var(--background-secondary) !important;
    border: 1px solid var(--accent-primary) !important;
    color: var(--accent-primary) !important;
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-member-admin]");
  if (root) {
    const form = root.querySelector<HTMLFormElement>("[data-add-form]")!;
    const list = root.querySelector<HTMLElement>("[data-member-list]")!;
    const message = root.querySelector<HTMLOutputElement>("[data-message]")!;
    const count = root.querySelector<HTMLElement>("[data-member-count]")!;
    const esc = (value: string) => value.replace(/[&<>"']/g, char => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[char] ?? char));
    const subjectLabels = new Map(Array.from(form.querySelectorAll("option")).map(option => [option.value, option.textContent ?? option.value]));
    const universities = ["北海道大学","東北大学","東京大学","東京科学大学","東京都立大学","早稲田大学","横浜国立大学","静岡大学","新潟大学","岐阜大学","立命館大学","京都大学","大阪大学","大阪公立大学","神戸大学","広島大学","九州大学","長崎大学","東洋大学","UCL","国立台湾大学","山口大学","慶應義塾大学","東京理科大学","中央大学","名古屋大学","筑波大学","名古屋市立大学","名城大学","Korea university, School of biomedical engineering","立教大学","Swarthmore College","北見工業大学","ZEN大学"];
    const years = ["中1","中2","中3","高1","高2","高3","高専1","高専2","高専3","高専4","高専5","B1","B2","B3","B4","M1","M2","D1","D2","D3","教職員・研究者","社会人","その他"];
    const fields = ["漢字","古文","漢文","地理","日本史","世界史","哲学","考古学","数学","物理","化学","地質","気象","海洋","天文","生物","情報","水産学","建築","薬学","中国語（普通話）","台湾華語","言語学","ページデザイン"];
    const opts = (items: string[], selected: string, multiple = false) => items.map(item => `<option value="${esc(item)}" ${multiple ? selected.split(",").includes(item) : selected === item ? "selected" : ""}>${esc(item)}</option>`).join("");
    const avatar = (member: any) => member.avatar_url ? `<img class="member-avatar" src="${esc(member.avatar_url)}" alt="" />` : `<span class="member-avatar member-avatar--fallback">${esc((member.display_name || "名").slice(0,1))}</span>`;
    const render = (members: any[]) => {
      count.textContent = `${members.length} 名`;
      list.innerHTML = members.length ? members.map(member => {
        const memberSubjects = String(member.subjects ?? "").split(",").filter(Boolean);
        const isGlobalManager = memberSubjects.includes("*");
        const roles = memberSubjects.map((id: string) => subjectLabels.get(id) ?? id);
        const interests = String(member.interests ?? "").split(",").filter(Boolean);
        const institutionOptions = member.university && !universities.includes(member.university) ? [...universities, member.university] : universities;
        return `<article class="member-card" data-email="${esc(member.email)}"><div class="member-card__top">${avatar(member)}<div class="member-card__identity"><div class="member-card__name">${esc(member.display_name || "表示名未設定")}</div><div class="member-card__email">${esc(member.email)}</div></div><span class="member-card__role">${esc(roles.join("・") || "担当未設定")}</span></div><div class="member-card__facts"><span class="member-fact"><b>所属</b> ${esc(member.university || "未登録")}</span><span class="member-fact"><b>学年</b> ${esc(member.year || "未登録")}</span><span class="member-fact"><b>分野</b> ${esc(interests.join("・") || "未登録")}</span></div><div class="member-card__actions">${isGlobalManager ? "" : `<button type="button" class="member-action--promote" data-promote-manager>全分野管理者に変更</button>`}<button type="button" class="member-action--sync" data-sync>変更を保存してDiscordロールを同期</button><button type="button" class="member-action--remove" data-remove data-subject="${esc(memberSubjects[0] ?? "")}">権限を削除</button></div><details><summary>登録情報を編集</summary><div class="member-edit-form"><label>所属機関<select data-university><option value="">未登録</option>${opts(institutionOptions, member.university ?? "")}</select></label><label>学年<select data-year><option value="">未登録</option>${opts(years, member.year ?? "")}</select></label><label class="member-edit-form__subjects">担当・関心分野<select data-interests multiple>${opts(fields, String(member.interests ?? ""), true)}</select><small>変更内容はカード上部の同期ボタンで保存・Discordへ反映されます。</small></label><button type="button" class="member-edit-form__close" data-close-editor>閉じる</button></div></details></article>`;
      }).join("") : '<p class="member-empty">登録されている参加者はいません。</p>';
    };
    const load = async () => { const response = await fetch("/api/admin/report-admin-permissions", {credentials:"same-origin", cache:"no-store"}); const data = await response.json().catch(() => ({})); if (response.status === 403) { list.textContent = "このページは全分野管理者のみ利用できます。"; form.hidden = true; return; } if (!response.ok) throw new Error(data.error ?? "参加者一覧を読み込めませんでした。"); render(data.permissions ?? []); };
    form.addEventListener("submit", async event => { event.preventDefault(); const values = new FormData(form); const response = await fetch("/api/admin/report-admin-permissions", {method:"POST",credentials:"same-origin",headers:{"content-type":"application/json"},body:JSON.stringify({email:values.get("email"),subject:values.get("subject")})}); const data = await response.json().catch(() => ({})); message.value = response.ok ? "運営者を追加しました。" : (data.error ?? "追加できませんでした。"); if (response.ok) { form.reset(); await load(); } });
    list.addEventListener("click", async event => {
      const target = event.target as HTMLElement;
      const card = target.closest<HTMLElement>("[data-email]");
      if (!card) return;
      const email = card.dataset.email ?? "";
      const promote = target.closest<HTMLButtonElement>("[data-promote-manager]");
      const sync = target.closest<HTMLButtonElement>("[data-sync]");
      const close = target.closest<HTMLButtonElement>("[data-close-editor]");
      const remove = target.closest<HTMLButtonElement>("[data-remove]");
      if (close) { const details = close.closest("details"); if (details) details.open = false; return; }
      if (promote) {
        if (!confirm(`${email} を全分野管理者に変更しますか？`)) return;
        promote.disabled = true;
        try {
          const response = await fetch("/api/admin/report-admin-permissions", { method:"POST", credentials:"same-origin", headers:{"content-type":"application/json"}, body:JSON.stringify({email, subject:"*"}) });
          const result = await response.json().catch(() => ({}));
          message.value = response.ok ? "全分野管理者に変更しました。" : (result.error ?? "変更できませんでした。");
          if (response.ok) await load();
        } finally { promote.disabled = false; }
        return;
      }
      if (sync) {
        sync.disabled = true; sync.textContent = "保存・同期中…";
        const interests = Array.from(card.querySelector<HTMLSelectElement>("[data-interests]")!.selectedOptions).map(option => option.value);
        try {
          const attributes = await fetch("/api/admin/member-attributes", {method:"PUT",credentials:"same-origin",headers:{"content-type":"application/json"},body:JSON.stringify({email,university:card.querySelector<HTMLSelectElement>("[data-university]")!.value,year:card.querySelector<HTMLSelectElement>("[data-year]")!.value,interests})});
          const attributeResult = await attributes.json().catch(() => ({})); if (!attributes.ok) throw new Error(attributeResult.error ?? "登録情報を保存できませんでした。");
          const response = await fetch("/api/admin/discord-member-roles", {method:"POST",credentials:"same-origin",headers:{"content-type":"application/json"},body:JSON.stringify({email})});
          const result = await response.json().catch(() => ({})); if (!response.ok) throw new Error(result.error ?? "Discordロールを同期できませんでした。");
          message.value = `登録情報を保存し、Discordロールを同期しました（${result.roleCount ?? 0}件）。`; await load();
        } catch (error) { message.value = error instanceof Error ? error.message : "保存・同期できませんでした。"; }
        finally { sync.disabled = false; sync.textContent = "変更を保存してDiscordロールを同期"; }
        return;
      }
      if (remove) { if (!confirm(`${email} の権限を削除しますか？`)) return; const query = new URLSearchParams({email,subject:remove.dataset.subject ?? ""}); const response = await fetch(`/api/admin/report-admin-permissions?${query}`, {method:"DELETE",credentials:"same-origin"}); message.value = response.ok ? "権限を削除しました。" : "削除できませんでした。"; if (response.ok) await load(); }
    });
    void load().catch(error => { list.textContent = error instanceof Error ? error.message : "参加者一覧を読み込めませんでした。"; });
  }
</script>

<script>
  const memberListForDiscord = document.querySelector<HTMLElement>("[data-member-list]");
  const decorateDiscordIds = async () => {
    if (!memberListForDiscord) return;
    const ids = new Map<string, string>();
    try { const response = await fetch("/api/admin/report-admin-permissions", { credentials: "same-origin", cache: "no-store" }); const data = await response.json() as { permissions?: Array<{ email: string; discord_user_id?: string }> }; for (const item of data.permissions ?? []) ids.set(item.email, item.discord_user_id ?? ""); } catch { /* 一覧描画を優先し、IDは空欄で表示する。 */ }
    memberListForDiscord.querySelectorAll<HTMLElement>("[data-email]").forEach(card => {
      if (card.querySelector("[data-member-discord-id]")) return;
      const email = card.dataset.email ?? "";
      const wrap = document.createElement("div"); wrap.className = "member-discord-id"; wrap.dataset.memberDiscordId = "true";
      wrap.innerHTML = `<label>DiscordユーザーID（全分野管理者が設定）</label><div class="member-discord-id__row"><input data-discord-id-input inputmode="numeric" maxlength="22" placeholder="15〜22桁の数字" value="${String(ids.get(email) ?? "").replace(/[^0-9]/g, "")}"><button type="button" data-save-discord-id>保存</button></div><output data-discord-id-message></output>`;
      const details = card.querySelector("details"); details ? card.insertBefore(wrap, details) : card.appendChild(wrap);
      wrap.querySelector<HTMLButtonElement>("[data-save-discord-id]")!.addEventListener("click", async () => {
        const input = wrap.querySelector<HTMLInputElement>("[data-discord-id-input]")!; const button = wrap.querySelector<HTMLButtonElement>("[data-save-discord-id]")!; const output = wrap.querySelector<HTMLOutputElement>("[data-discord-id-message]")!;
        button.disabled = true;
        const save = await fetch("/api/admin/member-discord-user", { method: "PUT", credentials: "same-origin", headers: { "content-type": "application/json" }, body: JSON.stringify({ email, discordUserId: input.value.trim() }) });
        const result = await save.json().catch(() => ({})); output.value = save.ok ? "DiscordユーザーIDを保存しました。" : (result.error ?? "保存できませんでした。"); button.disabled = false;
      });
    });
  };
  if (memberListForDiscord) { const observer = new MutationObserver(() => void decorateDiscordIds()); observer.observe(memberListForDiscord, { childList: true }); void decorateDiscordIds(); setTimeout(() => void decorateDiscordIds(), 1500); }
</script>

<script>
  const provisionButton = document.querySelector<HTMLButtonElement>("[data-provision-roles]");
  const provisionMessage = document.querySelector<HTMLOutputElement>("[data-message]");
  provisionButton?.addEventListener("click", async () => {
    if (!confirm("Bot test serverに大学・学年・関心分野のロールを追加しますか？")) return;
    provisionButton.disabled = true;
    const response = await fetch("/api/admin/discord-provision-roles", { method: "POST", credentials: "same-origin" });
    const data = await response.json().catch(() => ({}));
    if (provisionMessage) provisionMessage.value = response.ok ? `Discord「${data.guildName}」にロールを準備しました（新規${data.created ?? 0}件、既存${data.reused ?? 0}件）。` : `HTTP ${response.status}: ${data.error ?? "ロールを準備できませんでした。"}`;
    provisionButton.disabled = false;
  });
</script>

<script>
  const interestList = document.querySelector<HTMLElement>("[data-member-list]");
  const enhanceInterestSelectors = () => interestList?.querySelectorAll<HTMLSelectElement>("select[data-interests]").forEach(select => {
    if (select.dataset.enhanced === "true") return;
    select.dataset.enhanced = "true";
    const picker = document.createElement("div"); picker.className = "member-interest-picker"; picker.setAttribute("aria-label", "担当・関心分野");
    Array.from(select.options).forEach((option) => { const label = document.createElement("label"); const input = document.createElement("input"); input.type = "checkbox"; input.value = option.value; input.checked = option.selected; input.addEventListener("change", () => { option.selected = input.checked; }); label.append(input, document.createTextNode(option.textContent ?? option.value)); picker.append(label); });
    select.parentElement?.insertBefore(picker, select);
  });
  if (interestList) { new MutationObserver(() => enhanceInterestSelectors()).observe(interestList, { childList: true }); setTimeout(enhanceInterestSelectors, 1500); }
</script>
