    color: var(--ref-muted) !important;
    font-size: .78rem;
    line-height: 1.55;
  }

  .member-admin__count {
    background: var(--ref-surface-muted) !important;
    border: 1px solid var(--ref-border) !important;
    border-radius: 999px;
    color: var(--ref-accent) !important;
    font-size: .75rem !important;
    padding: .38rem .65rem;
  }

  .member-toolbar {
    background: var(--ref-surface-muted) !important;
    border: 1px solid var(--ref-border) !important;
    border-radius: 10px;
    gap: .75rem;
    margin-bottom: 1rem;
    padding: .8rem !important;
  }

  .member-toolbar label {
    color: var(--ref-muted) !important;
    font-size: .72rem !important;
  }

  .member-admin input,
  .member-admin select {
    background: var(--ref-surface) !important;
    border: 1px solid var(--ref-border-strong) !important;
    border-radius: 8px !important;
    color: var(--ref-text) !important;
    min-height: 2.55rem !important;
    padding: .55rem .7rem !important;
  }

  html[data-pref-bg="dark"] .member-admin input,
  html[data-pref-bg="dark"] .member-admin select {
    background: #191a1c !important;
    border-color: #3d3e42 !important;
    color: #e8e6e1 !important;
  }

  .member-admin input:focus,
  .member-admin select:focus {
    border-color: var(--ref-accent) !important;
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--ref-accent) 20%, transparent) !important;
  }

  .member-toolbar__reset,
  .member-admin .member-provision,
  .member-admin .member-action--promote,
  .member-admin .member-action--remove,
  .member-modal__cancel {
    background: transparent !important;
    border: 1px solid var(--ref-border-strong) !important;
    border-radius: 8px !important;
    color: var(--ref-muted) !important;
  }

  .member-toolbar__reset:hover,
  .member-admin .member-provision:hover,
  .member-admin .member-action--promote:hover,
  .member-admin .member-action--remove:hover,
  .member-modal__cancel:hover {
    background: var(--ref-surface-active) !important;
    border-color: var(--ref-accent) !important;
    color: var(--ref-accent) !important;
