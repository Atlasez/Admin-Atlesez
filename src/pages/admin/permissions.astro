<style is:global>
  /* Refero Styles の Apple 系トークンを、権限管理に適用する最終デザインレイヤー。
   * 既存のDOM・API・操作は変えず、余白・階層・コントラストだけを整える。 */
  .member-admin {
    --ref-canvas: #f5f5f7;
    --ref-surface: #ffffff;
    --ref-surface-muted: #f2f2f7;
    --ref-surface-active: #e5f1ff;
    --ref-border: #d2d2d7;
    --ref-border-strong: #b8b8bf;
    --ref-text: #1d1d1f;
    --ref-muted: #6e6e73;
    --ref-accent: #0071e3;
    --ref-accent-strong: #0066cc;
    color: var(--ref-text);
    max-width: 1320px !important;
    padding: clamp(1.35rem, 3vw, 2.5rem) clamp(1rem, 3vw, 2.75rem) 5rem !important;
  }

  html[data-pref-bg="dark"] .member-admin {
    --ref-canvas: #191a1c;
    --ref-surface: #232427;
    --ref-surface-muted: #2b2c30;
    --ref-surface-active: #263d52;
    --ref-border: #3d3e42;
    --ref-border-strong: #5b5d63;
    --ref-text: #e8e6e1;
    --ref-muted: #b5b1a8;
    --ref-accent: #0a84ff;
    --ref-accent-strong: #409cff;
  }

  html:not([data-pref-bg="dark"]) body:has(.member-admin),
  html:not([data-pref-bg="dark"]) body:has(.member-admin) .admin-layout-main {
    background: var(--ref-canvas) !important;
  }

  html[data-pref-bg="dark"] body:has(.member-admin),
  html[data-pref-bg="dark"] body:has(.member-admin) .admin-layout-main {
    background: #191a1c !important;
    color: #e8e6e1;
  }

  .member-admin__header {
    align-items: flex-start;
    border-bottom: 1px solid var(--ref-border) !important;
    gap: 2rem;
    margin-bottom: 1.35rem;
    padding: .4rem 0 1.5rem;
  }

  .member-admin__header h1 {
    color: var(--ref-text) !important;
    font-size: clamp(1.75rem, 3vw, 2.35rem);
    font-weight: 700;
    letter-spacing: -.03em;
    line-height: 1.12;
  }

  .member-admin__eyebrow {
    color: var(--ref-accent) !important;
    font-size: .7rem !important;
    font-weight: 700 !important;
    letter-spacing: .08em;
  }

  .member-admin__lead,
  .member-admin__header-meta small {
    color: var(--ref-muted) !important;
    font-size: .9rem;
    line-height: 1.55;
  }

  .member-admin__header-meta {
    align-items: flex-end;
    gap: .55rem;
  }

  .member-admin__header-meta span {
    background: var(--ref-surface-muted) !important;
    border: 1px solid var(--ref-border) !important;
    border-radius: 999px;
    color: var(--ref-muted) !important;
    font-size: .72rem;
    font-weight: 600;
    padding: .38rem .65rem;
  }

  .member-admin__self-discord {
    background: var(--ref-accent) !important;
    border: 1px solid var(--ref-accent) !important;
    border-radius: 999px;
    font-size: .8rem;
    font-weight: 700;
    min-height: 2.45rem;
    padding: .55rem .9rem;
  }

  .member-admin__summary {
    gap: .75rem;
    margin-bottom: 1.25rem;
  }

  .summary-card {
    background: var(--ref-surface) !important;
    border: 1px solid var(--ref-border) !important;
    border-radius: 12px;
    padding: 1rem 1.1rem;
  }

  .summary-card span,
  .summary-card small {
    color: var(--ref-muted) !important;
    font-size: .72rem;
  }

  .summary-card strong {
    color: var(--ref-text) !important;
    font-size: 1.65rem;
    letter-spacing: -.04em;
  }

  .summary-card:first-child { border-left: 3px solid var(--ref-accent) !important; }

  .member-admin__members,
  .member-admin__tools {
    background: var(--ref-surface) !important;
    border: 1px solid var(--ref-border) !important;
    border-radius: 14px;
    padding: 1.2rem 1.25rem 1.35rem !important;
  }

  .member-admin__members { margin-bottom: 1.1rem; }

  .member-admin__section-heading {
    align-items: flex-start;
    margin-bottom: .95rem;
  }

