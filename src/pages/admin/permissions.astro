---
import "../../styles/admin-permissions.css";
import AdminLayout from "../../layouts/AdminLayout.astro";
import AdminRetryNotice from "../../components/admin/AdminRetryNotice.astro";
import { getCollection } from "astro:content";
const subjects = (await getCollection("subjects")).sort((a,b)=>a.data.order-b.data.order);
---
<AdminLayout title="権限管理" description="運営権限とアクセス範囲の管理">
  <main class="member-admin" data-member-admin>
    <header class="member-admin__header">
      <div>
        <p class="member-admin__eyebrow">権限管理</p>
        <h1>権限管理</h1>
      </div>
      <div class="member-admin__header-meta"><span>管理者専用</span><a class="member-admin__self-discord" href="/auth/discord/start?returnTo=%2Fadmin%2Fpermissions%2F%3Fproject%3Datlas">自分のDiscordを連携</a><small>個人設定の保存時にDiscordへ同期します</small></div>
    </header>

    <section class="member-admin__summary" aria-label="権限管理の概要">
      <div class="summary-card"><span>参加者</span><strong data-summary-member-count>—</strong><small>登録済み</small></div>
      <div class="summary-card"><span>Discord連携</span><strong data-summary-linked-count>—</strong><small>連携済み</small></div>
      <div class="summary-card"><span>Discordロール</span><strong data-summary-role-count>—</strong><small>読み込み済み</small></div>
      <div class="summary-card"><span>分野統括</span><strong data-summary-workflow-count>—</strong><small>割り当て済み分野</small></div>
    </section>

    <output class="member-admin__global-message" data-message aria-live="polite"></output>

    <section class="member-admin__members" data-admin-load-surface aria-labelledby="member-list-title">
      <div class="member-admin__section-heading"><div><h2 id="member-list-title">参加者一覧</h2><small>参加者を選択すると、運営権限・プロフィール・Discord役職をまとめて編集できます。</small></div><span class="member-admin__count" data-member-count></span></div>
      <details class="member-admin__add action-card action-card--primary">
        <summary><span class="action-card__step">01</span><span class="action-card__summary-copy"><small>参加者を追加</small><strong id="add-member-title">運営権限の付与</strong></span><span class="action-card__chevron" aria-hidden="true">⌄</span></summary>
        <div class="action-card__body">
          <p class="action-card__description">メールアドレスと担当範囲を選択してください。</p>
          <form data-add-form>
            <label>メールアドレス<input type="email" name="email" required maxlength="320" placeholder="editor@example.com" /></label>
            <label>担当権限（複数選択可）<select name="subject" multiple required size="4"><option value="*">全分野管理者</option>{subjects.map(s => <option value={s.data.slug}>{s.data.name.ja}（担当）</option>)}</select></label>
            <button type="submit" class="button-primary">運営者を追加</button>
          </form>
        </div>
      </details>
      <div class="member-toolbar" aria-label="参加者の検索と絞り込み">
        <label class="member-toolbar__search">参加者を検索<input type="search" data-member-search placeholder="名前・メールアドレスで検索" autocomplete="off" /></label>
        <label>表示を絞り込む<select data-member-filter><option value="all">すべての参加者</option><option value="unconnected">Discord未連携</option><option value="no-roles">Discord役職なし</option><option value="has-roles">Discord役職あり</option></select></label>
        <button type="button" class="member-toolbar__reset" data-member-filter-reset>条件をクリア</button>
        <span class="member-toolbar__summary" data-member-filter-summary aria-live="polite"></span>
      </div>
      <div class="member-list-heading" aria-hidden="true"><span>参加者</span><span>担当権限</span><span>Discord役職</span><span>連携状況</span><span>操作</span></div>
      <div class="member-grid loading-state" data-member-list>読み込み中…<span data-admin-load-skeleton hidden aria-hidden="true"></span></div>
      <AdminRetryNotice scope="members" message="参加者一覧を読み込めませんでした。" />
      <div class="member-list-pagination" data-member-pagination hidden><span data-member-pagination-summary></span><button type="button" class="member-toolbar__reset" data-member-load-more>さらに読み込む</button></div>
    </section>

    <section class="member-admin__tools" aria-labelledby="admin-tools-title">
      <div class="member-admin__section-heading"><div><h2 id="admin-tools-title">Discord連携・公開フロー</h2><small>必要な項目だけを開いて操作できます。Discord側のロール定義は変更しません。</small></div></div>
      <div class="member-admin__workspace">
        <details class="member-admin__add action-card discord-role-catalog">
          <summary><span class="action-card__step">02</span><span class="action-card__summary-copy"><small>Discord連携</small><strong id="discord-role-catalog-title">既存ロールのカタログ</strong></span><span class="action-card__summary-status" data-discord-role-count>未同期</span><span class="action-card__chevron" aria-hidden="true">⌄</span></summary>
          <div class="action-card__body">
            <p class="action-card__description">Discordに存在する既存ロールを読み込み、参加者へ複数選択で割り当てます。Discord側で管理対象ロールが外された場合は、定期同期で運営サイト側の権限・割当も無効化します。</p>
            <div class="discord-permission-map" aria-labelledby="discord-permission-map-title">
              <strong id="discord-permission-map-title">Discordロールと運営サイト権限の対応</strong>
              <p>Discordのロール構成を基準に、運営サイトで必要な操作へ置き換えています。Discord側のロール・設定は変更しません。</p>
              <div class="discord-permission-map__scroll">
                <table>
                  <thead><tr><th scope="col">Discordロール</th><th scope="col">運営サイトでの扱い</th><th scope="col">権限範囲</th></tr></thead>
                  <tbody>
                    <tr><th scope="row">運営内運営</th><td>全分野管理者</td><td>全分野の記事・運営権限を管理。全分野権限へ対応する唯一のロール。</td></tr>
                    <tr><th scope="row">数学・物理など分野名と完全一致するロール</th><td>分野担当</td><td>一致した分野だけ。既存ロールの読み込み時に対応づけます。</td></tr>
                    <tr><th scope="row">運営メンバー</th><td>基本メンバーの識別</td><td>管理権限は付与しません。全分野管理者の代替にもなりません。</td></tr>
                    <tr><th scope="row">Newton力学・電磁気学などの細分ロール</th><td>Discord内のチャンネル・活動区分</td><td>運営サイトは分野より細かい権限を持たないため、親分野へ拡張しません。</td></tr>
                    <tr><th scope="row">所属・学校・学年・関心分野</th><td>プロフィール情報</td><td>記事の閲覧・編集・承認権限には変換しません。</td></tr>
                    <tr><th scope="row">Bot・個人用・未対応ロール</th><td>権限対応なし</td><td>対応表にないロールから運営権限を推測しません。</td></tr>
                  </tbody>
                </table>
              </div>
            </div>
            <div class="discord-role-catalog__body"><div data-discord-role-list>「既存ロールを読み込む」を押すと一覧を更新します。</div></div>
            <div class="member-admin__sync"><div><strong>Discordロール対応表</strong><small>Discord側を読み取り、運営サイトと照合します。</small></div><div class="member-admin__sync-actions"><button type="button" class="member-provision" data-provision-roles>既存ロールを読み込む</button><button type="button" class="member-provision member-provision--secondary" data-discord-readiness>運用事前チェック</button></div></div>
            <output class="discord-readiness-message" data-discord-readiness-message aria-live="polite"></output>
          </div>
        </details>

        <details class="member-admin__add action-card workflow-role-admin">
          <summary><span class="action-card__step">03</span><span class="action-card__summary-copy"><small>公開フロー</small><strong id="workflow-role-title">分野統括の割り当て</strong></span><span class="action-card__chevron" aria-hidden="true">⌄</span></summary>
          <div class="action-card__body">
            <p class="action-card__description">「執筆完了」後の公開審査を担当します。同じ分野に複数人、1人に複数分野を割り当てられます。</p>
            <form data-add-workflow-role>
              <label>担当者のメールアドレス<input type="email" name="email" required maxlength="320" list="workflow-coordinator-members" placeholder="coordinator@example.com" /><datalist id="workflow-coordinator-members" data-workflow-coordinator-members></datalist><small>既存メンバーは候補から選べます。</small></label>
              <label class="workflow-role-field--subjects">統括する分野（複数選択可）<select name="subject" multiple required size="5" aria-describedby="workflow-role-subject-help">{subjects.map(s => <option value={s.data.slug}>{s.data.name.ja}</option>)}</select><small id="workflow-role-subject-help">チェックを入れて複数の分野を選択できます。</small><output data-workflow-role-selection aria-live="polite">0分野を選択中</output></label>
              <button type="submit" class="button-primary">統括を追加</button>
            </form>
            <div class="workflow-role-list loading-state" data-workflow-role-list><small>読み込み中…</small></div>
          </div>
        </details>
      </div>
    </section>
    <section class="permission-audit" aria-labelledby="permission-audit-title">
      <div class="member-admin__section-heading"><div><h2 id="permission-audit-title">権限変更履歴</h2><small>誰が、誰のアクセス範囲を変更したかを直近30件まで表示します。</small></div><label class="permission-audit__archive-toggle"><input type="checkbox" data-permission-audit-include-archived /> アーカイブを含む</label></div>
      <div class="permission-audit__list loading-state" data-permission-audit-list aria-live="polite">読み込み中…</div>
      <div class="permission-audit__pagination" data-permission-audit-pagination hidden>
        <span data-permission-audit-summary aria-live="polite"></span>
        <button type="button" data-permission-audit-load-more>さらに読み込む</button>
      </div>
    </section>

    <dialog class="member-modal" data-member-modal aria-labelledby="member-modal-title">
      <div class="member-modal__shell">
        <header class="member-modal__header">
          <div><p>個人設定</p><h2 id="member-modal-title" data-member-modal-title>参加者の設定</h2><small data-member-modal-email></small></div>
          <button type="button" class="member-modal__close" data-member-modal-close aria-label="閉じる">×</button>
        </header>
        <div class="member-modal__body" data-member-modal-content></div>
        <footer class="member-modal__footer"><output data-member-modal-message aria-live="polite"></output><button type="button" class="member-modal__cancel" data-member-modal-close>閉じる</button><button type="button" class="member-modal__save" data-member-modal-save>保存してDiscordへ同期</button></footer>
      </div>
    </dialog>
    <dialog class="access-preview-modal" data-access-preview aria-labelledby="access-preview-title">
      <div class="access-preview-modal__shell">
        <header class="access-preview-modal__header">
          <div><p>実効権限</p><h2 id="access-preview-title" data-access-preview-title>アクセス範囲</h2><small data-access-preview-email></small></div>
          <button type="button" class="member-modal__close" data-access-preview-close aria-label="閉じる">×</button>
        </header>
        <div class="access-preview-modal__body" data-access-preview-content></div>
        <footer class="access-preview-modal__footer"><small>現在の担当・公開フロー設定から計算した表示です。</small><button type="button" class="member-modal__cancel" data-access-preview-close>閉じる</button></footer>
      </div>
    </dialog>
  </main>
</AdminLayout>

<script>
    import { lockAdminForm } from "../../scripts/admin-form-submit-lock";
    import { createAdminLoadRetry } from "../../scripts/admin-load-retry";
  const initializeMemberAdmin = () => {
  const root = document.querySelector<HTMLElement>("[data-member-admin]");
  if (root && root.dataset.initialized !== "true") {
    root.dataset.initialized = "true";
    const form = root.querySelector<HTMLFormElement>("[data-add-form]")!;
    const list = root.querySelector<HTMLElement>("[data-member-list]")!;
    const memberPagination = root.querySelector<HTMLElement>("[data-member-pagination]")!;
    const memberPaginationSummary = root.querySelector<HTMLElement>("[data-member-pagination-summary]")!;
    const memberLoadMore = root.querySelector<HTMLButtonElement>("[data-member-load-more]")!;
    const message = root.querySelector<HTMLOutputElement>("[data-message]")!;
    const count = root.querySelector<HTMLElement>("[data-member-count]")!;
    const memberSearch = root.querySelector<HTMLInputElement>("[data-member-search]")!;
    const memberFilter = root.querySelector<HTMLSelectElement>("[data-member-filter]")!;
    const memberFilterReset = root.querySelector<HTMLButtonElement>("[data-member-filter-reset]")!;
    const memberFilterSummary = root.querySelector<HTMLElement>("[data-member-filter-summary]")!;
    const summaryMemberCount = root.querySelector<HTMLElement>("[data-summary-member-count]")!;
    const summaryLinkedCount = root.querySelector<HTMLElement>("[data-summary-linked-count]")!;
    const summaryRoleCount = root.querySelector<HTMLElement>("[data-summary-role-count]")!;
    const summaryWorkflowCount = root.querySelector<HTMLElement>("[data-summary-workflow-count]")!;
    const workflowRoleForm = root.querySelector<HTMLFormElement>("[data-add-workflow-role]")!;
    const workflowRoleList = root.querySelector<HTMLElement>("[data-workflow-role-list]")!;
    const workflowRoleSelection = root.querySelector<HTMLOutputElement>("[data-workflow-role-selection]")!;
    const workflowCoordinatorMembers = root.querySelector<HTMLDataListElement>("[data-workflow-coordinator-members]")!;
    let discordRoles: Array<{ discord_role_id: string; name: string; position: number; is_managed: number }> = [];
    let memberRecords: any[] = [];
    let workflowRoleRecords: any[] = [];
    let memberQuery = "";
    let memberViewFilter = "all";
    let memberNextCursor: string | null = null;
    let memberTotal = 0;
    let memberLoading = false;
    let memberRetry: ReturnType<typeof createAdminLoadRetry> | null = null;
    const memberModal = root.querySelector<HTMLDialogElement>("[data-member-modal]")!;
    const memberModalTitle = root.querySelector<HTMLElement>("[data-member-modal-title]")!;
    const memberModalEmail = root.querySelector<HTMLElement>("[data-member-modal-email]")!;
    const memberModalContent = root.querySelector<HTMLElement>("[data-member-modal-content]")!;
    const memberModalMessage = root.querySelector<HTMLOutputElement>("[data-member-modal-message]")!;
    const setMemberModalMessage = (value: string, state: "idle" | "error" = "idle") => { memberModalMessage.value = value; memberModalMessage.dataset.state = state; };
    const memberModalSave = root.querySelector<HTMLButtonElement>("[data-member-modal-save]")!;
    const accessPreview = root.querySelector<HTMLDialogElement>("[data-access-preview]")!;
    const accessPreviewTitle = root.querySelector<HTMLElement>("[data-access-preview-title]")!;
    const accessPreviewEmail = root.querySelector<HTMLElement>("[data-access-preview-email]")!;
    const accessPreviewContent = root.querySelector<HTMLElement>("[data-access-preview-content]")!;
    let activeMemberEmail = "";
    const discordRoleCount = root.querySelector<HTMLElement>("[data-discord-role-count]")!;
    const discordRoleList = root.querySelector<HTMLElement>("[data-discord-role-list]")!;
    const esc = (value: string) => value.replace(/[&<>"']/g, char => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[char] ?? char));
    const subjectLabels = new Map(Array.from(form.querySelectorAll("option")).map(option => [option.value, option.textContent ?? option.value]));
    const workflowSubjectLabels = new Map(Array.from(subjectLabels.entries()).map(([value, label]) => [value, label.replace(/（担当）$/, "")]));
    const subjectNames = (values: string[]) => values.map(value => workflowSubjectLabels.get(value) ?? value).filter(Boolean);
    const scopeMarkup = (values: string[], empty = "なし") => {
      const unique = Array.from(new Set(values));
      return unique.length ? `<div class="access-preview-scope">${unique.map(value => `<span>${esc(value)}</span>`).join("")}</div>` : `<p>${esc(empty)}</p>`;
    };
    const openAccessPreview = (email: string) => {
      const member = memberRecords.find(item => String(item.email).toLowerCase() === email.toLowerCase());
      if (!member) return;
      const permissions = String(member.subjects ?? "").split(",").filter(Boolean);
      const allSubjects = permissions.includes("*");
      const directSubjects = permissions.filter(value => value !== "*");
      const coordinatorSubjects = workflowRoleRecords.filter(role => String(role.email).toLowerCase() === email.toLowerCase() && role.role === "subject-coordinator" && role.subject && role.subject !== "*").map(role => String(role.subject));
      const isProjectLeader = workflowRoleRecords.some(role => String(role.email).toLowerCase() === email.toLowerCase() && role.role === "project-leader");
      const displayName = member.display_name || "表示名未設定";
      const viewScopes = allSubjects ? ["全分野"] : subjectNames(Array.from(new Set([...directSubjects, ...coordinatorSubjects])));
      const editScopes = allSubjects ? ["全分野"] : subjectNames(directSubjects);
      const approvalScopes = allSubjects || isProjectLeader ? ["全分野"] : subjectNames(coordinatorSubjects);
      accessPreviewTitle.textContent = `${displayName}のアクセス範囲`;
      accessPreviewEmail.textContent = String(member.email);
      accessPreviewContent.innerHTML = `<section class="access-preview-row"><div class="access-preview-row__heading"><strong>記事の閲覧・コメント</strong><span>${viewScopes.length ? "許可" : "対象なし"}</span></div>${scopeMarkup(viewScopes, "担当・統括する分野がありません。")}${isProjectLeader && !allSubjects ? `<p>プロジェクトリーダーとして、公開審査中の記事も全分野を確認できます。</p>` : ""}</section><section class="access-preview-row"><div class="access-preview-row__heading"><strong>本文・記事情報の編集</strong><span>${editScopes.length ? "許可" : "対象なし"}</span></div>${scopeMarkup(editScopes, "本文を編集できる分野がありません。分野統括のみの場合は査読結果とコメントを扱えます。")}</section><section class="access-preview-row"><div class="access-preview-row__heading"><strong>公開審査の承認</strong><span>${approvalScopes.length ? "許可" : "対象なし"}</span></div>${scopeMarkup(approvalScopes, "公開審査を承認できる分野がありません。")}${isProjectLeader && !allSubjects ? `<p>プロジェクトリーダーとして最終審査を処理できます。</p>` : ""}</section><section class="access-preview-row"><div class="access-preview-row__heading"><strong>Discord</strong><span>${member.discord_user_id ? "連携済み" : "未連携"}</span></div><p>${member.discord_user_id ? "Discordユーザーと役職同期の対象です。" : "Discord連携前のため、役職同期はできません。"}</p></section>`;
      if (typeof accessPreview.showModal === "function") accessPreview.showModal();
      else accessPreview.setAttribute("open", "");
    };
    const universities = ["北海道大学","東北大学","東京大学","東京科学大学","東京都立大学","早稲田大学","横浜国立大学","静岡大学","新潟大学","岐阜大学","立命館大学","京都大学","大阪大学","大阪公立大学","神戸大学","広島大学","九州大学","長崎大学","東洋大学","UCL","国立台湾大学","山口大学","慶應義塾大学","東京理科大学","中央大学","名古屋大学","筑波大学","名古屋市立大学","名城大学","Korea university, School of biomedical engineering","立教大学","Swarthmore College","北見工業大学","ZEN大学"];
    const years = ["中1","中2","中3","高1","高2","高3","高専1","高専2","高専3","高専4","高専5","B1","B2","B3","B4","M1","M2","D1","D2","D3","教職員・研究者","社会人","その他"];
    const fields = ["漢字","古文","漢文","地理","日本史","世界史","哲学","考古学","数学","物理","化学","地質","気象","海洋","天文","生物","情報","水産学","建築","薬学","中国語（普通話）","台湾華語","言語学","ページデザイン"];
    const opts = (items: string[], selected: string, multiple = false) => items.map(item => `<option value="${esc(item)}" ${multiple ? selected.split(",").includes(item) : selected === item ? "selected" : ""}>${esc(item)}</option>`).join("");
    const avatar = (member: any) => member.avatar_url ? `<img class="member-avatar" src="${esc(member.avatar_url)}" alt="" />` : `<span class="member-avatar member-avatar--fallback">${esc((member.display_name || "名").slice(0,1))}</span>`;
    const renderWorkflowRoles = (roles: any[]) => {
      workflowRoleList.classList.remove("loading-state");
      const coordinators = roles.filter(role => role.role === "subject-coordinator" && role.subject);
      const leaders = roles.filter(role => role.role === "project-leader");
      const grouped = new Map<string, any[]>();
      coordinators.forEach(role => grouped.set(role.subject, [...(grouped.get(role.subject) ?? []), role]));
      const subjectsWithAssignments = Array.from(grouped.entries()).sort((left, right) => (workflowSubjectLabels.get(left[0]) ?? left[0]).localeCompare(workflowSubjectLabels.get(right[0]) ?? right[0], "ja"));
      const assignedEmails = new Set(coordinators.map(role => String(role.email).toLowerCase()));
      const subjectCount = subjectsWithAssignments.length;
      summaryWorkflowCount.textContent = String(subjectCount);
      const multiSubjectCount = Array.from(new Set(coordinators.map(role => String(role.email).toLowerCase()))).filter(email => coordinators.filter(role => String(role.email).toLowerCase() === email).length > 1).length;
      const unassignedSubjects = Array.from(subjectLabels.keys()).filter(subject => subject !== "*" && !grouped.has(subject));
      const chip = (role: any) => `<span class="workflow-role-chip" title="${esc(role.email)}"><span class="workflow-role-chip__identity"><b>${esc(role.display_name || role.email)}</b><small>${esc(role.email)}</small></span><button type="button" data-remove-workflow-role data-email="${esc(role.email)}" data-subject="${esc(role.subject)}" aria-label="${esc(role.display_name || role.email)}の${esc(workflowSubjectLabels.get(role.subject) ?? role.subject)}統括を削除">×</button></span>`;
