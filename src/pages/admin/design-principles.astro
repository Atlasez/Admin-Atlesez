---
import AdminLayout from "../../layouts/AdminLayout.astro";
import AdminRetryNotice from "../../components/admin/AdminRetryNotice.astro";
---
<AdminLayout title="設計原則" description="フィードバックから共通の設計方針を整理します">
  <main class="design-principles-page" data-design-principles data-admin-load-surface aria-busy="true">
    <header class="page-heading">
      <div><p class="eyebrow">ATLASEZ ADMIN</p><h1>設計原則</h1></div>
      <a href="/admin/manage/?project=atlas">管理トップへ戻る</a>
    </header>
    <p class="intro">個別のフィードバックから、今回のサイトに限らない設計方針を抽出して管理します。原則ごとに分類し、元フィードバックへリンクできます。</p>

    <section class="editor-panel" aria-labelledby="principle-editor-heading">
      <h2 id="principle-editor-heading" data-editor-heading>設計原則を追加</h2>
      <form data-principle-form>
        <input name="id" type="hidden" />
        <input name="updatedAt" type="hidden" />
        <label>原則名<input name="title" maxlength="160" required placeholder="例：候補が多い複数選択" /></label>
        <div class="field-row">
          <label>分類<select name="category" required>
            <option value="selection">入力・選択</option>
            <option value="information">情報設計</option>
            <option value="feedback">状態・フィードバック</option>
            <option value="accessibility">アクセシビリティ</option>
            <option value="consistency">一貫性・拡張性</option>
            <option value="other">その他</option>
          </select></label>
          <label>状態<select name="status" required>
            <option value="candidate">候補</option>
            <option value="active">運用中</option>
            <option value="archived">アーカイブ</option>
          </select></label>
        </div>
        <label>設計原則<textarea name="statement" rows="3" maxlength="2000" required placeholder="フィードバックから一般化した、再利用できる方針を書きます。"></textarea></label>
        <label>背景・判断理由<textarea name="rationale" rows="3" maxlength="4000" placeholder="どのような場面で適用するか、理由や例外を補足します。"></textarea></label>
        <fieldset>
          <legend>元フィードバック</legend>
          <p>この原則を導いたフィードバックへのADMIN内リンクを1件以上登録してください。</p>
          <div class="source-list" data-source-list></div>
          <button type="button" class="secondary-button" data-add-source>元フィードバックを追加</button>
        </fieldset>
        <div class="form-actions"><button type="submit" data-save-principle>保存</button><button type="button" class="secondary-button" data-reset-principle>新規入力に戻す</button><output data-principle-message role="status" aria-live="polite"></output></div>
      </form>
    </section>

    <section class="principle-list-panel" aria-labelledby="principle-list-heading">
      <div class="list-heading"><div><h2 id="principle-list-heading">登録済みの設計原則</h2><p data-principle-count>読み込み中…</p></div>
        <div class="filters"><label>分類<select data-filter-category><option value="all">すべて</option><option value="selection">入力・選択</option><option value="information">情報設計</option><option value="feedback">状態・フィードバック</option><option value="accessibility">アクセシビリティ</option><option value="consistency">一貫性・拡張性</option><option value="other">その他</option></select></label><label>状態<select data-filter-status><option value="all">すべて</option><option value="candidate">候補</option><option value="active">運用中</option><option value="archived">アーカイブ</option></select></label></div>
      </div>
      <div class="principle-list" data-principle-list></div>
      <AdminRetryNotice message="設計原則を読み込めませんでした。" />
    </section>
  </main>
</AdminLayout>
<script>import "../../scripts/admin-design-principles";</script>
<style>
  .design-principles-page{max-width:1100px;margin:0 auto;padding:1.5rem 1.25rem 4rem;color:var(--text-primary)}
  .page-heading,.list-heading,.form-actions,.field-row,.filters{display:flex;align-items:center;justify-content:space-between;gap:1rem}
  .page-heading{border-bottom:1px solid var(--border-default);padding-bottom:1rem}.page-heading h1{margin:.2rem 0;font-size:2rem}.page-heading a,.source-link{color:var(--accent-primary)}.eyebrow{color:var(--accent-primary);font-size:.7rem;font-weight:900;letter-spacing:.12em;margin:0}
  .intro{color:var(--text-secondary);line-height:1.7;max-width:60rem}
  .editor-panel,.principle-list-panel{border:1px solid var(--border-default);background:var(--background-secondary);margin-top:1.2rem;padding:1.2rem}
  h2{font-size:1.15rem;margin:.1rem 0 .8rem}.editor-panel form{display:grid;gap:.8rem}.editor-panel label,.filters label{display:grid;gap:.35rem;font-size:.8rem;font-weight:800}.editor-panel input,.editor-panel select,.editor-panel textarea,.filters select{box-sizing:border-box;width:100%;background:var(--background-primary);border:1px solid var(--border-default);color:var(--text-primary);font:inherit;padding:.6rem}.editor-panel textarea{resize:vertical;line-height:1.6}.field-row>*{flex:1}
  fieldset{border:1px solid var(--border-default);padding:1rem;min-width:0}legend{font-weight:900}fieldset>p,.principle-list-panel .list-heading p{color:var(--text-secondary);font-size:.78rem;line-height:1.55;margin:.25rem 0 .7rem}.source-list{display:grid;gap:.6rem}.source-row{border:1px solid var(--border-default);padding:.75rem;display:grid;grid-template-columns:1fr 1.4fr auto;gap:.6rem;align-items:start}.source-row label{font-size:.74rem}.source-row textarea{grid-column:1/3}.source-row button{align-self:end}.source-row input,.source-row textarea{min-width:0}
  button{background:var(--accent-primary);border:1px solid var(--accent-primary);color:var(--on-accent);cursor:pointer;font:inherit;font-weight:800;padding:.55rem .85rem}.secondary-button{background:var(--background-primary);border-color:var(--border-default);color:var(--text-primary)}.form-actions{justify-content:flex-start;flex-wrap:wrap}.form-actions output{color:var(--text-secondary);font-size:.82rem}
  .list-heading{align-items:end}.filters{align-items:end}.filters label{min-width:10rem}.principle-list{display:grid;gap:.7rem}.principle-card{border:1px solid var(--border-default);background:var(--background-primary);padding:1rem}.principle-card header{display:flex;gap:.7rem;align-items:start;justify-content:space-between}.principle-card h3{margin:0;font-size:1rem}.principle-meta{display:flex;flex-wrap:wrap;gap:.35rem;margin:.45rem 0}.principle-meta span{border:1px solid var(--border-default);color:var(--text-secondary);font-size:.7rem;padding:.2rem .45rem}.principle-statement{font-weight:800;line-height:1.65;white-space:pre-wrap}.principle-rationale{color:var(--text-secondary);font-size:.85rem;line-height:1.65;white-space:pre-wrap}.principle-sources{border-top:1px solid var(--border-default);display:grid;gap:.45rem;margin-top:.8rem;padding-top:.6rem}.principle-source{font-size:.8rem}.principle-source p{color:var(--text-secondary);font-size:.76rem;line-height:1.5;margin:.2rem 0}.principle-actions{display:flex;gap:.45rem;flex-shrink:0}.principle-actions button{font-size:.75rem}.empty-state{border:1px dashed var(--border-default);color:var(--text-secondary);padding:1.5rem;text-align:center}
  @media(max-width:680px){.design-principles-page{padding-inline:.8rem}.page-heading,.list-heading{align-items:start;flex-direction:column}.field-row,.filters{align-items:stretch;flex-direction:column}.filters,.filters label{width:100%}.source-row{grid-template-columns:1fr}.source-row textarea{grid-column:auto}.principle-card header{flex-direction:column}.principle-actions{width:100%}}
</style>
