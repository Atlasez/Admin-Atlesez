---
const statusOptions = [
  { id: "draft", label: "公開準備完了", detail: "原稿", tone: "neutral" },
  { id: "unpublished", label: "公開済み（変更未反映）", detail: "公開", tone: "muted" },
];
---

<html lang="ja" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>編集ヘッダー拡大範囲 | UIチェック用プロトタイプ</title>
  </head>
  <body>
    <main class="prototype-page">
      <header class="prototype-header">
        <div class="crumbs"><a href="/admin/ui-prototype/">UIプロトタイプ</a><span>/</span><strong>編集ヘッダー拡大範囲</strong></div>
        <div class="header-actions"><span class="badge"><i></i>本番未反映</span><button class="theme-button" type="button" data-theme-toggle aria-label="テーマを切り替え"><span data-theme-icon>◐</span><span data-theme-label>ホワイト</span></button><a class="back-link" href="/admin/ui-prototype/editor-toolbar/">前の案を見る</a></div>
      </header>

      <section class="intro" aria-labelledby="page-title">
        <div><h1 id="page-title">記事編集ワークスペース</h1></div>
        <div class="intro-tools"><div class="mode-switch" role="tablist" aria-label="状態バリエーション"><button class="mode-button" type="button" data-mode="draft" aria-selected="false">下書き案</button><button class="mode-button is-active" type="button" data-mode="published" aria-selected="true">公開済み案</button></div><button class="outline-button" type="button" data-density>表示密度: 標準</button></div>
      </section>

      <section class="editor-card" aria-label="記事編集上部のUI案">
        <div class="context-row">
          <div class="context"><span class="context-icon">A</span><div><span class="context-path">Atlasez / mathematics / 概要</span><strong>統計的機械学習の基礎: 確率モデルと正則化</strong></div></div>
          <div class="context-actions"><button type="button" class="quiet-button" data-help>手順 <span>↗</span></button><button type="button" class="icon-button" data-menu aria-label="その他">•••</button></div>
        </div>

        <div class="control-row">
          <div class="state-group" role="group" aria-label="記事の公開状態">
            {statusOptions.map((status, index) => <button class:list={["state-button", index === 0 && "is-active"]} type="button" data-state={status.id} aria-pressed={index === 0 ? "true" : "false"}><span class="state-detail">{status.detail}</span><span>{status.label}</span></button>)}
          </div>
          <div class="connection"><span class="signal"></span><span>自動公開: 接続済み</span></div>
          <div class="control-spacer"></div>
          <label class="autosave"><input type="checkbox" checked data-autosave /><span class="check" aria-hidden="true"></span><span>下書きを自動保存</span></label>
          <label class="select-wrap"><span class="sr-only">Webプレビュー形式</span><select><option>Webプレビュー — 組版</option><option>Webプレビュー — 簡易</option></select><span aria-hidden="true">⌄</span></label>
          <label class="select-wrap math-select"><span class="sr-only">数式エンジン</span><select><option>KaTeX（高速）</option><option>MathJax</option></select><span aria-hidden="true">⌄</span></label>
          <div class="presence"><span class="presence-dot"></span><span>同期編集: 1人が接続中</span><span class="person">上杉和輝</span></div>
        </div>

        <div class="action-row">
          <div class="article-meta"><span class="meta-label">記事設定</span><span>数学</span><span class="slash">/</span><span>概要</span><span class="slash">/</span><span>日本語</span><span class="slash">/</span><span data-meta-status>公開準備完了</span><button type="button" class="edit-button" data-edit>編集</button></div>
          <div class="action-buttons is-hidden" data-action-set="draft"><button type="button" class="secondary-button" data-feedback>フィードバックを依頼</button><button type="button" class="secondary-button" data-review>フィードバック完了・公開審査へ</button><button type="button" class="primary-button" data-save>保存する</button></div>
          <div class="action-buttons" data-action-set="published"><button type="button" class="primary-button" data-update>更新案を作成</button><button type="button" class="secondary-button" data-feedback>フィードバックを依頼</button><button type="button" class="primary-button" data-retry>公開内容を更新して再試行</button><button type="button" class="danger-button" data-unpublish>公開を取り消す</button><button type="button" class="primary-button" data-save>変更を保存</button></div>
        </div>

        <div class="publish-notice" data-published-note><span class="notice-mark">i</span><p>公開中の記事を保持したまま更新案を作成できます。既存原稿を編集して同じ公開先へ更新する場合は「更新案を作成」を選択してください。</p></div>

        <div class="memo-row"><button type="button" class="disclosure" data-memo aria-expanded="false"><span class="triangle">›</span><strong>自分用メモ帳</strong><span class="memo-hint">必要なときだけ開く</span></button><div class="memo-panel is-hidden" data-memo-panel><textarea aria-label="自分用メモ" placeholder="この下書きについてのメモ…">公開前に定義の参照先を確認する。</textarea><button type="button" class="mini-save" data-memo-save>メモを保存</button></div></div>
      </section>

      <section class="rationale" aria-label="設計意図"><div><strong>文脈 → 状態 → 操作</strong></div><p>左側は記事の文脈、中央は状態と接続情報、右側は実行操作に固定。記事設定とメモは下段へ分離し、視線の往復を減らします。</p></section>
    </main>

    <div class="popover is-hidden" data-popover><button type="button">ショートカット一覧</button><button type="button">記事設定を開く</button><button type="button">変更履歴を見る</button></div>
    <div class="toast is-hidden" data-toast role="status"></div>

    <script is:inline>
      const root = document.documentElement;
      const toggle = document.querySelector('[data-theme-toggle]');
      const themeLabel = document.querySelector('[data-theme-label]'); const themeIcon = document.querySelector('[data-theme-icon]');
      toggle?.addEventListener('click', () => { const dark = root.dataset.theme === 'dark'; root.dataset.theme = dark ? 'light' : 'dark'; if (themeLabel) themeLabel.textContent = dark ? 'ダーク' : 'ホワイト'; if (themeIcon) themeIcon.textContent = dark ? '☾' : '◐'; notify(dark ? 'ホワイトモードに切り替えました' : 'ダークモードに切り替えました'); });
      const toast = document.querySelector('[data-toast]'); let timer;
      const notify = (message) => { if (!toast) return; toast.textContent = message; toast.classList.remove('is-hidden'); clearTimeout(timer); timer = setTimeout(() => toast.classList.add('is-hidden'), 2000); };
      const publishedCopy = { state: [{ detail: '原稿', label: '公開準備完了' }, { detail: '公開', label: '公開済み（変更未反映）' }], meta: '公開準備完了' };
      const draftCopy = { state: [{ detail: '原稿', label: '下書き' }, { detail: '公開', label: '未公開' }], meta: '下書き' };
      document.querySelectorAll('[data-mode]').forEach((button) => button.addEventListener('click', () => { const mode = button.dataset.mode; const copy = mode === 'published' ? publishedCopy : draftCopy; document.querySelectorAll('[data-mode]').forEach((item) => { item.classList.toggle('is-active', item === button); item.setAttribute('aria-selected', item === button ? 'true' : 'false'); }); document.querySelectorAll('[data-state]').forEach((item, index) => { item.querySelector('.state-detail').textContent = copy.state[index].detail; item.querySelector('span:last-child').textContent = copy.state[index].label; }); document.querySelector('[data-meta-status]').textContent = copy.meta; document.querySelectorAll('[data-action-set]').forEach((set) => set.classList.toggle('is-hidden', set.dataset.actionSet !== mode)); document.querySelector('[data-published-note]')?.classList.toggle('is-hidden', mode !== 'published'); notify(mode === 'published' ? '公開済み記事の操作案を表示しました' : '下書き記事の操作案を表示しました'); }));
      document.querySelectorAll('[data-state]').forEach((button) => button.addEventListener('click', () => { document.querySelectorAll('[data-state]').forEach((item) => { item.classList.toggle('is-active', item === button); item.setAttribute('aria-pressed', item === button ? 'true' : 'false'); }); notify(`${button.textContent.trim()}を選択しました`); }));
      document.querySelector('[data-save]')?.addEventListener('click', () => notify('保存しました（チェック用）'));
      document.querySelector('[data-feedback]')?.addEventListener('click', () => notify('フィードバック依頼を作成しました'));
      document.querySelector('[data-review]')?.addEventListener('click', () => notify('公開審査の確認画面を開く想定です'));
      document.querySelector('[data-update]')?.addEventListener('click', () => notify('更新案を作成しました'));
      document.querySelector('[data-retry]')?.addEventListener('click', () => notify('公開内容の更新を再試行しました'));
      document.querySelector('[data-unpublish]')?.addEventListener('click', () => notify('公開取り消しの確認を開きました'));
      document.querySelector('[data-help]')?.addEventListener('click', () => notify('手順パネルを開く想定です'));
      document.querySelector('[data-edit]')?.addEventListener('click', () => notify('記事設定の編集を開く想定です'));
      document.querySelector('[data-autosave]')?.addEventListener('change', (event) => notify(event.target.checked ? '自動保存を有効にしました' : '自動保存を無効にしました'));
      const popover = document.querySelector('[data-popover]'); document.querySelector('[data-menu]')?.addEventListener('click', () => popover?.classList.toggle('is-hidden')); document.addEventListener('click', (event) => { if (!(event.target instanceof Element)) return; if (!event.target.closest('[data-menu]') && !event.target.closest('[data-popover]')) popover?.classList.add('is-hidden'); });
      const memo = document.querySelector('[data-memo]'); const panel = document.querySelector('[data-memo-panel]'); memo?.addEventListener('click', () => { const open = panel?.classList.toggle('is-hidden') === false; memo.setAttribute('aria-expanded', String(open)); memo.querySelector('.triangle')?.classList.toggle('is-open', open); }); document.querySelector('[data-memo-save]')?.addEventListener('click', () => notify('メモを保存しました（チェック用）'));
      document.querySelector('[data-density]')?.addEventListener('click', (event) => { document.body.classList.toggle('is-compact'); event.currentTarget.textContent = document.body.classList.contains('is-compact') ? '表示密度: コンパクト' : '表示密度: 標準'; });
    </script>
  </body>
</html>

<style>
  :root { color-scheme: dark; --bg: #151515; --surface: #191919; --surface-2: #1d1d1d; --surface-3: #222; --text: #ededeb; --text-2: rgba(255,255,255,.66); --text-3: rgba(255,255,255,.44); --border: rgba(255,255,255,.09); --border-subtle: rgba(255,255,255,.06); --accent: #6ba6ff; --green: #72c98b; --yellow: #e8b84a; --shadow: 0 16px 40px rgba(0,0,0,.25); }
  :root[data-theme="light"] { color-scheme: light; --bg: #f4f4f1; --surface: #fff; --surface-2: #f8f8f5; --surface-3: #ededeb; --text: #242522; --text-2: #64655f; --text-3: #92938d; --border: rgba(35,36,32,.13); --border-subtle: rgba(35,36,32,.08); --accent: #2a74c4; --green: #258a5a; --yellow: #b67a14; --shadow: 0 14px 34px rgba(29,30,26,.09); }
  * { box-sizing: border-box; } body { margin: 0; background: var(--bg); color: var(--text); font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Hiragino Sans", "Yu Gothic", sans-serif; font-size: 14px; -webkit-font-smoothing: antialiased; }.prototype-page { max-width: 1280px; margin: 0 auto; padding: 0 32px 72px; }.prototype-header { height: 60px; border-bottom: 1px solid var(--border-subtle); display: flex; align-items: center; justify-content: space-between; }.crumbs { display: flex; gap: 10px; align-items: center; color: var(--text-3); font-size: 12px; }.crumbs a { color: var(--accent); text-decoration: none; }.crumbs strong { color: var(--text-2); font-weight: 560; }.header-actions { display: flex; align-items: center; gap: 10px; }.badge { color: var(--text-3); font-size: 11px; display: inline-flex; align-items: center; gap: 6px; }.badge i { width: 6px; height: 6px; border-radius: 50%; background: var(--green); }.icon-button { width: 31px; height: 31px; border: 1px solid var(--border); border-radius: 6px; display: grid; place-items: center; background: transparent; color: var(--text-2); }.icon-button:hover { background: var(--surface-3); }.back-link { color: var(--accent); font-size: 11px; text-decoration: none; }.intro { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; padding: 42px 0 28px; }.intro-tools { display: flex; align-items: center; gap: 10px; }.mode-switch { display: inline-flex; border: 1px solid var(--border); border-radius: 7px; overflow: hidden; }.mode-button { height: 34px; border: 0; border-right: 1px solid var(--border); background: transparent; color: var(--text-3); padding: 0 11px; font-size: 11px; }.mode-button:last-child { border-right: 0; }.mode-button:hover,.mode-button.is-active { background: var(--surface-3); color: var(--text); }.eyebrow { margin: 0; color: var(--text-3); font-size: 10px; letter-spacing: .13em; font-weight: 700; }.intro h1 { margin: 10px 0 8px; font-size: 26px; line-height: 1.2; font-weight: 650; letter-spacing: -.03em; }.intro p:not(.eyebrow) { margin: 0; color: var(--text-2); line-height: 1.65; }.outline-button,.quiet-button,.secondary-button,.primary-button,.edit-button,.danger-button { height: 34px; border: 1px solid var(--border); border-radius: 6px; padding: 0 11px; background: transparent; color: var(--text-2); font-size: 12px; font-weight: 570; }.outline-button:hover,.quiet-button:hover,.secondary-button:hover,.edit-button:hover { background: var(--surface-3); }.editor-card { border: 1px solid var(--border); border-radius: 9px; background: var(--surface); box-shadow: var(--shadow); overflow: hidden; }.context-row { min-height: 78px; padding: 15px 20px; display: flex; align-items: center; justify-content: space-between; gap: 18px; border-bottom: 1px solid var(--border-subtle); }.context { display: flex; align-items: center; gap: 12px; min-width: 0; }.context-icon { width: 34px; height: 34px; border: 1px solid var(--border); border-radius: 7px; display: grid; place-items: center; background: var(--surface-2); color: var(--text-2); font-weight: 700; }.context div { display: grid; gap: 4px; min-width: 0; }.context-path { color: var(--text-3); font-size: 11px; }.context strong { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size: 16px; font-weight: 640; }.context-actions { display: flex; gap: 8px; }.quiet-button span { color: var(--text-3); margin-left: 5px; }.control-row { min-height: 64px; padding: 12px 20px; display: flex; align-items: center; gap: 10px; border-bottom: 1px solid var(--border-subtle); }.state-group { display: inline-flex; border: 1px solid var(--border); border-radius: 7px; overflow: hidden; }.state-button { height: 36px; min-width: 99px; border: 0; border-right: 1px solid var(--border); background: transparent; color: var(--text-2); display: inline-flex; align-items: center; justify-content: center; gap: 7px; }.state-button:last-child { border-right: 0; }.state-button:hover,.state-button.is-active { background: var(--surface-3); color: var(--text); }.state-detail { color: var(--text-3); font-size: 10px; }.connection { display: inline-flex; align-items: center; gap: 7px; color: var(--green); font-size: 11px; white-space: nowrap; }.signal,.presence-dot { width: 7px; height: 7px; background: var(--green); border-radius: 50%; }.control-spacer { flex: 1; }.autosave { display: inline-flex; align-items: center; gap: 7px; color: var(--text-2); font-size: 11px; white-space: nowrap; cursor: pointer; }.autosave input { position: absolute; opacity: 0; }.check { width: 15px; height: 15px; border: 1px solid var(--border); border-radius: 4px; display: grid; place-items: center; }.autosave input:checked + .check { background: var(--accent); border-color: var(--accent); }.autosave input:checked + .check::after { content: "✓"; color: white; font-size: 10px; }.select-wrap { position: relative; }.select-wrap select { appearance: none; min-width: 174px; height: 36px; padding: 0 28px 0 11px; border: 1px solid var(--border); border-radius: 6px; background: var(--surface-2); color: var(--text-2); font-size: 11px; }.select-wrap > span:last-child { position: absolute; right: 9px; top: 9px; color: var(--text-3); pointer-events: none; }.math-select select { min-width: 130px; }.presence { height: 36px; padding: 0 9px; border: 1px solid var(--border); border-radius: 18px; display: inline-flex; align-items: center; gap: 7px; color: var(--text-2); font-size: 11px; white-space: nowrap; }.person { color: var(--accent); border-left: 1px solid var(--border); padding-left: 8px; font-weight: 620; }.action-row { min-height: 64px; padding: 12px 20px; display: flex; align-items: center; justify-content: space-between; gap: 18px; border-bottom: 1px solid var(--border-subtle); }.article-meta { display: flex; align-items: center; gap: 8px; color: var(--text-2); font-size: 12px; white-space: nowrap; }.meta-label { color: var(--text); font-weight: 650; }.slash { color: var(--text-3); }.edit-button { margin-left: 8px; height: 30px; color: var(--accent); border-color: color-mix(in srgb, var(--accent) 45%, transparent); }.action-buttons { display: flex; gap: 8px; }.primary-button { background: var(--accent); border-color: var(--accent); color: white; min-width: 84px; }.primary-button:hover { filter: brightness(1.08); }.danger-button { background: rgba(190,62,45,.22); border-color: rgba(231,108,89,.58); color: #f09b8a; }.danger-button:hover { background: rgba(190,62,45,.34); }.publish-notice { margin: 0 20px 16px; padding: 11px 13px; border: 1px solid color-mix(in srgb, var(--accent) 70%, transparent); border-left: 3px solid var(--accent); background: color-mix(in srgb, var(--accent) 8%, var(--surface)); display: flex; gap: 10px; align-items: flex-start; }.notice-mark { width: 17px; height: 17px; border: 1px solid var(--accent); color: var(--accent); border-radius: 50%; display: grid; place-items: center; flex: 0 0 auto; font-size: 11px; font-weight: 700; }.publish-notice p { margin: 0; color: var(--text-2); line-height: 1.6; font-size: 12px; }.memo-row { padding: 13px 20px; }.disclosure { width: 100%; min-height: 38px; border: 0; background: transparent; display: flex; align-items: center; gap: 9px; color: var(--text); text-align: left; }.triangle { color: var(--accent); font-size: 22px; line-height: 1; transform: rotate(0deg); transition: transform 120ms ease; }.triangle.is-open { transform: rotate(90deg); }.memo-hint { color: var(--text-3); font-size: 11px; margin-left: 4px; }.memo-panel { display: flex; gap: 9px; align-items: flex-end; padding: 8px 0 2px 24px; }.memo-panel textarea { flex: 1; min-height: 70px; resize: vertical; border: 1px solid var(--border); border-radius: 6px; background: var(--surface-2); color: var(--text-2); padding: 9px 10px; font: inherit; font-size: 12px; }.mini-save { height: 30px; border: 1px solid var(--border); background: transparent; border-radius: 5px; color: var(--text-2); padding: 0 9px; font-size: 11px; }.rationale { margin-top: 22px; padding: 17px 2px; border-top: 1px solid var(--border-subtle); display: flex; justify-content: space-between; gap: 30px; }.rationale div { display: grid; gap: 7px; }.rationale strong { font-size: 13px; font-weight: 620; }.rationale p { max-width: 590px; margin: 0; color: var(--text-2); line-height: 1.65; font-size: 12px; }.popover { position: fixed; top: 76px; right: 45px; z-index: 4; width: 190px; padding: 6px; border: 1px solid var(--border); border-radius: 7px; background: var(--surface); box-shadow: var(--shadow); }.popover button { display: block; width: 100%; height: 31px; border: 0; border-radius: 4px; background: transparent; color: var(--text-2); text-align: left; padding: 0 9px; font-size: 12px; }.popover button:hover { background: var(--surface-3); color: var(--text); }.toast { position: fixed; left: 50%; bottom: 24px; transform: translateX(-50%); padding: 9px 13px; border: 1px solid var(--border); border-radius: 6px; background: var(--surface); box-shadow: var(--shadow); color: var(--text-2); font-size: 12px; }.is-hidden { display: none !important; }.sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }.is-compact .context-row { min-height: 64px; padding-block: 10px; }.is-compact .control-row,.is-compact .action-row { min-height: 54px; padding-block: 7px; }.is-compact .state-button,.is-compact .select-wrap select,.is-compact .presence { height: 31px; }.is-compact .action-row { gap: 10px; }.is-compact .article-meta { font-size: 11px; }
  @media (max-width: 1120px) { body { min-width: 980px; }.prototype-page { padding-inline: 22px; }.control-row { flex-wrap: wrap; }.control-spacer { display: none; }.action-row { align-items: flex-start; flex-direction: column; }.rationale { flex-direction: column; gap: 12px; } }
</style>

<style>
  /* Codex-like refinements: adjacent neutral surfaces, compact chrome, visible light mode. */
  .theme-button { height: 31px; display: inline-flex; align-items: center; gap: 7px; padding: 0 9px; border: 1px solid var(--border); border-radius: 6px; background: transparent; color: var(--text-2); font-size: 11px; }
  .theme-button:hover { background: var(--surface-3); color: var(--text); }
  .theme-button span:first-child { font-size: 14px; line-height: 1; }
  :root { --surface: #1a1a1a; --surface-2: #1d1d1d; --surface-3: #232323; --border: rgba(255,255,255,.075); --border-subtle: rgba(255,255,255,.05); --shadow: 0 10px 28px rgba(0,0,0,.2); }
  :root[data-theme="light"] { --surface: #fff; --surface-2: #fafaf8; --surface-3: #f1f1ee; --border: rgba(35,36,32,.11); --border-subtle: rgba(35,36,32,.065); --shadow: 0 10px 26px rgba(29,30,26,.07); }
  .editor-card { border-radius: 8px; }
  .context-row { min-height: 72px; }
  .control-row { min-height: 60px; }
  .action-row { min-height: 60px; }
  .context strong { font-weight: 600; }
  .article-meta { font-size: 11px; }
  .secondary-button, .primary-button, .danger-button { height: 32px; }
  .presence { border-radius: 6px; }
  .publish-notice { background: color-mix(in srgb, var(--accent) 5%, var(--surface)); }
</style>
