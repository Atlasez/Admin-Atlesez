---
import AdminLayout from "../../../../layouts/AdminLayout.astro";
---

<AdminLayout title="記事編集ヘッダー | 運営サイト適用プレビュー" description="運営サイトの見た目に合わせた独立UIプレビュー">
  <main class="admin-header-prototype" aria-label="運営サイト適用プレビュー">
    <div class="prototype-crumb"><a href="/admin/ui-prototype/">UIプロトタイプ</a><span aria-hidden="true">›</span><span>記事編集ヘッダー適用プレビュー</span></div>
    <section class="editor-card" aria-label="記事編集ワークスペース上部">
      <div class="context-row">
        <div class="workspace-context"><span class="context-mark" aria-hidden="true">文</span><div><span class="context-label">Atlas / mathematics</span><strong>統計的機械学習の基礎</strong></div></div>
        <div class="context-actions"><button class="command-button" type="button" data-command><span aria-hidden="true">⌘ K</span><span>操作を検索</span></button><button class="more-button" type="button" data-menu aria-label="その他の操作">•••</button></div>
      </div>
      <div class="status-row">
        <div class="segmented" role="group" aria-label="記事状態"><button class="segment is-active" type="button" data-state="draft" aria-pressed="true"><span>原稿</span><strong>下書き</strong></button><button class="segment" type="button" data-state="unpublished" aria-pressed="false"><span>公開</span><strong>未公開</strong></button></div>
        <div class="publish-status"><i class="status-orb" aria-hidden="true"></i><span data-publish-label>自動公開: 接続済み</span></div>
        <div class="status-spacer"></div>
        <button class="utility-button" type="button" data-guide>手順 <span aria-hidden="true">↗</span></button>
        <label class="check-control"><input type="checkbox" checked data-autosave /><i aria-hidden="true"></i><span data-autosave-label>下書きを自動保存</span></label>
        <label class="select-control"><select aria-label="Webプレビュー形式"><option>Webプレビュー — 組版</option><option>Webプレビュー — 簡易</option></select><span aria-hidden="true">⌄</span></label>
        <label class="select-control math"><select aria-label="数式エンジン"><option>KaTeX（高速）</option><option>MathJax</option></select><span aria-hidden="true">⌄</span></label>
        <div class="presence"><i class="presence-orb" data-presence-orb aria-hidden="true"></i><span data-presence-label>同期編集: 1人が接続中</span><button type="button" data-user>上杉和輝</button></div>
      </div>
      <div class="title-row">
        <div class="title-copy"><h1>統計的機械学習の基礎: 確率モデルと正則化</h1><span>最終更新 2分前 · 下書き</span><span class="created-by">初回作成: <strong>上杉 和輝</strong> · 2026/09/02</span></div>
        <div class="collab"><div class="history-avatars" aria-label="編集履歴のメンバー"><button type="button" class="history-avatar avatar-uk" data-editor="上杉 和輝 · 初回作成">UK</button><button type="button" class="history-avatar avatar-ms" data-editor="三浦 さき · 3時間前に編集">MS</button><button type="button" class="history-avatar avatar-kt" data-editor="加藤 拓 · 昨日に編集">KT</button></div><button type="button" class="history-link" data-history>編集履歴 <span>3</span></button><span class="collab-separator" aria-hidden="true"></span><span class="collab-presence"><i class="presence-orb" aria-hidden="true"></i><span data-collab-label>同期編集: 1人が接続中</span></span></div>
      </div>
      <div class="action-row"><div class="tab-list" role="tablist" aria-label="表示範囲"><button class="tab is-active" type="button" role="tab" aria-selected="true">本文</button><button class="tab" type="button" role="tab" aria-selected="false">プレビュー</button><button class="tab" type="button" role="tab" aria-selected="false">コメント <span>3</span></button><button class="tab" type="button" role="tab" aria-selected="false">執筆メモ</button></div><div class="primary-actions"><button class="secondary-button" type="button" data-feedback>フィードバックを依頼</button><button class="primary-button" type="button" data-save>保存する</button></div></div>
    </section>
  </main>
  <div class="history-popover is-hidden" data-history-panel role="dialog" aria-label="編集履歴"><strong>編集履歴</strong><span>上杉 和輝 · 三浦 さき · 加藤 拓</span></div>
  <div class="menu-popover is-hidden" data-popover role="menu"><button type="button">ショートカット一覧</button><button type="button">変更履歴を見る</button></div>
  <div class="toast is-hidden" data-toast role="status"></div>
</AdminLayout>

<script is:inline>
  const toast = document.querySelector('[data-toast]'); let toastTimer;
  const showToast = (message) => { if (!toast) return; toast.textContent = message; toast.classList.remove('is-hidden'); clearTimeout(toastTimer); toastTimer = setTimeout(() => toast.classList.add('is-hidden'), 1900); };
  document.querySelectorAll('[data-state]').forEach((button) => button.addEventListener('click', () => { document.querySelectorAll('[data-state]').forEach((item) => { item.classList.toggle('is-active', item === button); item.setAttribute('aria-pressed', item === button ? 'true' : 'false'); }); showToast(`${button.textContent.trim()}を選択しました`); }));
  document.querySelector('[data-autosave]')?.addEventListener('change', (event) => showToast(event.target.checked ? '自動保存を有効にしました' : '自動保存を無効にしました'));
  document.querySelector('[data-guide]')?.addEventListener('click', () => showToast('手順パネルを開く想定です')); document.querySelector('[data-command]')?.addEventListener('click', () => showToast('操作を検索（⌘K）')); document.querySelector('[data-feedback]')?.addEventListener('click', () => showToast('フィードバック依頼を作成しました')); document.querySelector('[data-save]')?.addEventListener('click', () => showToast('保存しました（チェック用）')); document.querySelector('[data-user]')?.addEventListener('click', () => showToast('上杉和輝 · 同期中'));
  const popover = document.querySelector('[data-popover]'); document.querySelector('[data-menu]')?.addEventListener('click', () => popover?.classList.toggle('is-hidden')); document.addEventListener('click', (event) => { if (!(event.target instanceof Element)) return; if (!event.target.closest('[data-menu]') && !event.target.closest('[data-popover]')) popover?.classList.add('is-hidden'); });
  const historyPanel = document.querySelector('[data-history-panel]'); document.querySelector('[data-history]')?.addEventListener('click', () => historyPanel?.classList.toggle('is-hidden')); document.querySelectorAll('[data-editor]').forEach((avatar) => avatar.addEventListener('click', () => showToast(avatar.dataset.editor)));
  const publishLabel = document.querySelector('[data-publish-label]'); const presenceLabel = document.querySelector('[data-presence-label]'); const collabLabel = document.querySelector('[data-collab-label]'); const autosaveLabel = document.querySelector('[data-autosave-label]'); const syncTargets = [document.querySelector('.publish-status'), document.querySelector('.presence'), document.querySelector('.collab-presence')]; const orbs = document.querySelectorAll('.presence-orb, .status-orb'); let liveIndex = 0;
  const liveStates = [{ publish: '自動公開: 接続済み', presence: '同期編集: 1人が接続中', collab: '同期編集: 1人が接続中', active: false, tone: 'ready' }, { publish: '自動公開: 同期中…', presence: '同期編集: 2人が接続中', collab: '同期編集: 2人が接続中', active: true, tone: 'syncing' }, { publish: '自動公開: 保存済み', presence: '同期編集: 1人が接続中', collab: '同期編集: 1人が接続中', active: false, tone: 'saved' }, { publish: '自動公開: 再接続中…', presence: '同期編集: 接続を確認中', collab: '同期編集: 接続を確認中', active: true, tone: 'reconnecting' }];
  const animateLabel = (element, value) => { if (!element) return; element.classList.remove('is-changing'); void element.offsetWidth; element.textContent = value; element.classList.add('is-changing'); setTimeout(() => element.classList.remove('is-changing'), 620); };
  const tick = () => { const state = liveStates[liveIndex % liveStates.length]; liveIndex += 1; animateLabel(publishLabel, state.publish); animateLabel(presenceLabel, state.presence); animateLabel(collabLabel, state.collab); orbs.forEach((orb) => orb.classList.toggle('is-spinning', state.active)); syncTargets.forEach((target) => { target?.classList.toggle('is-syncing', state.active); target?.classList.toggle('is-reconnecting', state.tone === 'reconnecting'); target?.classList.toggle('is-saved', state.tone === 'saved'); }); if (autosaveLabel && document.querySelector('[data-autosave]')?.checked) animateLabel(autosaveLabel, state.active ? '自動保存: 同期中…' : '下書きを自動保存'); };
  tick(); setInterval(tick, 2400);
</script>

<style>
  .admin-header-prototype { max-width: 1260px; margin: 0 auto; padding: 0 1.25rem 3rem; color: var(--text-primary); }
  .prototype-crumb { display: flex; align-items: center; gap: .55rem; padding: .8rem 0 .4rem; color: var(--text-secondary); font-size: .75rem; }.prototype-crumb a { color: var(--link); }.prototype-crumb span[aria-hidden] { color: var(--text-muted); }
  .editor-card { overflow: hidden; border: 1px solid var(--border-default); border-radius: .4rem; background: var(--background-primary); box-shadow: 0 .7rem 1.6rem #001a2c12; }
  .context-row { min-height: 76px; padding: 0 1rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; border-bottom: 1px solid var(--border-default); }.workspace-context { display: flex; align-items: center; gap: .7rem; min-width: 0; }.context-mark { width: 2.2rem; height: 2.2rem; display: grid; place-items: center; flex: 0 0 auto; border: 1px solid var(--border-default); border-radius: .35rem; background: var(--background-secondary); color: var(--text-secondary); font-size: .95rem; }.workspace-context div { display: grid; gap: .12rem; min-width: 0; }.context-label { color: var(--text-secondary); font-size: .72rem; }.workspace-context strong { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 1rem; font-weight: 800; }.context-actions { display: flex; gap: .45rem; flex: 0 0 auto; }
  .command-button, .more-button, .utility-button, .secondary-button, .primary-button { height: 2.25rem; border: 1px solid var(--border-default); border-radius: .35rem; background: transparent; color: var(--text-primary); cursor: pointer; font: inherit; font-size: .78rem; }.command-button { display: inline-flex; align-items: center; gap: .5rem; padding: 0 .7rem; }.command-button span:first-child { color: var(--text-secondary); }.command-button span:last-child { color: var(--text-secondary); }.more-button { width: 2.25rem; color: var(--text-secondary); font-size: 1rem; letter-spacing: .12em; }.command-button:hover, .more-button:hover, .utility-button:hover, .secondary-button:hover { background: var(--background-secondary); color: var(--accent-primary); }
  .status-row { min-height: 68px; padding: .7rem 1rem; display: flex; align-items: center; gap: .55rem; border-bottom: 1px solid var(--border-default); }.segmented { display: inline-flex; overflow: hidden; border: 1px solid var(--border-default); border-radius: .35rem; flex: 0 0 auto; }.segment { height: 2.15rem; min-width: 6.4rem; padding: 0 .65rem; display: inline-flex; align-items: center; justify-content: center; gap: .45rem; border: 0; border-right: 1px solid var(--border-default); background: transparent; color: var(--text-secondary); cursor: pointer; }.segment:last-child { border-right: 0; }.segment:hover, .segment.is-active { background: var(--background-secondary); color: var(--text-primary); }.segment span { color: var(--text-muted); font-size: .68rem; }.segment strong { font-size: .8rem; font-weight: 800; }.status-spacer { flex: 1; min-width: .5rem; }.publish-status { min-height: 2.15rem; max-width: 20rem; padding: 0 .7rem; display: inline-flex; align-items: center; gap: .45rem; border-radius: .35rem; background: color-mix(in srgb, var(--success) 10%, var(--background-secondary)); color: var(--success); font-size: .74rem; white-space: nowrap; }.utility-button, .secondary-button, .primary-button { padding: 0 .7rem; white-space: nowrap; }.utility-button { color: var(--text-secondary); }.check-control { display: inline-flex; align-items: center; gap: .4rem; color: var(--text-secondary); font-size: .74rem; white-space: nowrap; cursor: pointer; }.check-control input { position: absolute; opacity: 0; }.check-control i { width: 1rem; height: 1rem; display: grid; place-items: center; border: 1px solid var(--border-default); border-radius: .25rem; }.check-control input:checked + i { border-color: var(--accent-primary); background: var(--accent-primary); }.check-control input:checked + i::after { content: "✓"; color: #fff; font-size: .65rem; }.select-control { position: relative; flex: 0 0 auto; }.select-control select { appearance: none; height: 2.15rem; min-width: 9.5rem; padding: 0 1.7rem 0 .6rem; border: 1px solid var(--border-default); border-radius: .35rem; background: var(--background-secondary); color: var(--text-secondary); font: inherit; font-size: .72rem; }.select-control.math select { min-width: 8.2rem; }.select-control > span { position: absolute; top: .48rem; right: .55rem; color: var(--text-muted); pointer-events: none; }.presence { min-height: 2.15rem; padding: 0 .6rem; display: inline-flex; align-items: center; gap: .42rem; border: 1px solid var(--border-default); border-radius: .35rem; color: var(--text-secondary); font-size: .72rem; white-space: nowrap; }.presence button { padding-left: .5rem; border: 0; border-left: 1px solid var(--border-default); background: transparent; color: var(--accent-primary); cursor: pointer; font: inherit; font-size: .72rem; font-weight: 800; }
  .title-row { min-height: 116px; padding: 1.15rem 1rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; }.title-copy { display: grid; gap: .24rem; min-width: 0; }.title-copy h1 { margin: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 1.45rem; line-height: 1.35; font-weight: 800; letter-spacing: -.02em; }.title-copy span { color: var(--text-secondary); font-size: .76rem; }.created-by { font-size: .72rem !important; }.created-by strong { color: var(--text-primary); }.collab { display: flex; align-items: center; gap: .55rem; color: var(--text-secondary); white-space: nowrap; }.history-avatars { display: inline-flex; align-items: center; }.history-avatar { width: 1.85rem; height: 1.85rem; margin-left: -.4rem; display: grid; place-items: center; border: 2px solid var(--background-primary); border-radius: 50%; color: #fff; cursor: pointer; font-size: .62rem; font-weight: 800; transition: transform 150ms ease; }.history-avatar:first-child { margin-left: 0; }.history-avatar:hover { z-index: 1; transform: translateY(-2px); }.avatar-uk { background: #2d6ea8; }.avatar-ms { background: #a35d4a; }.avatar-kt { background: #668953; }.history-link { padding: 0; border: 0; background: transparent; color: var(--text-secondary); cursor: pointer; font: inherit; font-size: .72rem; }.history-link span { color: var(--text-muted); margin-left: .15rem; }.collab-separator { width: 1px; height: 1rem; background: var(--border-default); }.collab-presence { display: inline-flex; align-items: center; gap: .4rem; }
  .action-row { min-height: 59px; padding: 0 1rem; display: flex; align-items: flex-end; justify-content: space-between; gap: 1rem; border-top: 1px solid var(--border-default); }.tab-list { display: flex; gap: 1.25rem; }.tab { position: relative; height: 3rem; padding: 0; border: 0; background: transparent; color: var(--text-secondary); cursor: pointer; font: inherit; font-size: .78rem; }.tab:hover, .tab.is-active { color: var(--text-primary); }.tab.is-active::after { content: ""; position: absolute; right: 0; bottom: -.05rem; left: 0; height: 2px; background: var(--accent-primary); }.tab span { color: var(--text-muted); margin-left: .15rem; }.primary-actions { display: flex; gap: .45rem; padding-bottom: .55rem; }.primary-button { border-color: var(--accent-primary); background: var(--accent-primary); color: #fff; }.primary-button:hover { background: var(--accent-hover); }
  .status-orb, .presence-orb { position: relative; display: inline-block; width: .6rem; height: .6rem; flex: 0 0 auto; border: 2px solid color-mix(in srgb, var(--success) 35%, transparent); border-top-color: var(--success); border-radius: 50%; }.status-orb::after, .presence-orb::after { content: ""; position: absolute; inset: -.3rem; border: 1px solid color-mix(in srgb, var(--accent-primary) 26%, transparent); border-radius: 50%; opacity: 0; }.is-spinning { animation: spin 800ms linear infinite; }.is-spinning::after { animation: ripple 1.2s ease-out infinite; }.publish-status.is-syncing, .presence.is-syncing, .collab-presence.is-syncing { color: var(--accent-primary); }.publish-status.is-syncing .status-orb, .presence.is-syncing .presence-orb, .collab-presence.is-syncing .presence-orb { border-color: color-mix(in srgb, var(--accent-primary) 35%, transparent); border-top-color: var(--accent-primary); }.is-reconnecting .status-orb, .is-reconnecting .presence-orb { border-color: color-mix(in srgb, #b97812 35%, transparent); border-top-color: #b97812; }.is-saved { color: var(--success) !important; }.is-changing { animation: label-in 620ms cubic-bezier(.22,.8,.28,1) both; }.publish-status.is-syncing [data-publish-label], .presence.is-syncing [data-presence-label], .collab-presence.is-syncing [data-collab-label] { background: linear-gradient(105deg, var(--accent-primary) 12%, #7eaed2 50%, var(--accent-primary) 88%); background-size: 230% 100%; background-clip: text; -webkit-background-clip: text; color: transparent; animation: sweep 1.45s ease-in-out infinite; }
  .history-popover, .menu-popover { position: fixed; z-index: 10; padding: .7rem .8rem; display: grid; gap: .25rem; border: 1px solid var(--border-default); border-radius: .4rem; background: var(--background-primary); box-shadow: 0 .8rem 2rem #001a2c26; color: var(--text-secondary); font-size: .7rem; }.history-popover { top: 17rem; right: 2rem; }.history-popover strong { color: var(--text-primary); }.menu-popover { top: 8.1rem; right: 2rem; width: 12rem; }.menu-popover button { height: 1.9rem; border: 0; border-radius: .25rem; background: transparent; color: var(--text-secondary); cursor: pointer; text-align: left; font: inherit; font-size: .7rem; }.menu-popover button:hover { background: var(--background-secondary); color: var(--accent-primary); }.toast { position: fixed; bottom: 1.2rem; left: 50%; z-index: 11; padding: .55rem .75rem; transform: translateX(-50%); border: 1px solid var(--border-default); border-radius: .35rem; background: var(--background-primary); box-shadow: 0 .6rem 1.2rem #001a2c22; color: var(--text-secondary); font-size: .72rem; }.is-hidden { display: none !important; }
  @keyframes spin { to { transform: rotate(360deg); } } @keyframes ripple { 0% { opacity: .6; transform: scale(.7); } 100% { opacity: 0; transform: scale(1.5); } } @keyframes sweep { 0%, 100% { background-position: 100% 0; } 50% { background-position: 0 0; } } @keyframes label-in { 0% { opacity: .35; transform: translateY(3px); } 100% { opacity: 1; transform: translateY(0); } }
  @media (max-width: 1000px) { .status-row { flex-wrap: wrap; }.status-spacer { display: none; }.title-row { align-items: flex-start; flex-direction: column; gap: .8rem; }.collab { align-self: flex-start; }.action-row { align-items: center; }.primary-actions { padding-bottom: 0; } }
  @media (prefers-reduced-motion: reduce) { .is-spinning, .is-spinning::after, .is-changing, .publish-status.is-syncing [data-publish-label], .presence.is-syncing [data-presence-label], .collab-presence.is-syncing [data-collab-label] { animation: none; } }
</style>
