---
const candidates = [
  { id: "codex", name: "A · Codex compact", note: "状態を最短距離で確認", className: "candidate-codex" },
  { id: "split", name: "B · Split actions", note: "設定と実行を二段に分離", className: "candidate-split" },
  { id: "quiet", name: "C · Quiet surface", note: "情報量を保ちつつ静かに", className: "candidate-quiet" },
];
---

<html lang="ja" data-theme="dark">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>編集ヘッダー比較 | UIチェック用プロトタイプ</title></head>
  <body>
    <main class="page">
      <header class="topbar"><div class="crumbs"><a href="/admin/ui-prototype/">UIプロトタイプ</a><span>/</span><strong>編集ヘッダー比較</strong></div><div class="top-actions"><span class="scope"><i></i>本番未反映</span><button class="theme-button" type="button" data-theme-toggle><span data-theme-icon>◐</span><span data-theme-label>ホワイト</span></button><a href="/admin/ui-prototype/editor-header/">単体案へ</a></div></header>
      <section class="intro"><div><p class="eyebrow">COMPARISON BOARD · SCREEN 02</p><h1>3つの候補を並べて比較</h1></div><div class="legend"><span><b class="dot blue"></b>実行操作</span><span><b class="dot green"></b>接続状態</span><span><b class="dot red"></b>破棄操作</span></div></section>
      <section class="board" aria-label="編集ヘッダー候補比較">
        {candidates.map((candidate) => <article class:list={["candidate", candidate.className]}><header class="candidate-head"><div><span class="candidate-name">{candidate.name}</span><span class="candidate-note">{candidate.note}</span></div><button class="more" type="button" aria-label="候補メニュー">•••</button></header><div class="mini-context"><span class="doc-icon">A</span><div><span>Atlas / mathematics / 概要</span><strong>統計的機械学習の基礎</strong></div></div><div class="mini-controls"><div class="mini-state"><span>原稿</span><strong>公開準備完了</strong><span>公開</span><strong>公開済み</strong></div><span class="connected"><i></i>接続済み</span><label class="mini-check"><input type="checkbox" checked /><span></span>自動保存</label><select aria-label="数式エンジン"><option>KaTeX</option><option>MathJax</option></select></div><div class="mini-actions"><button class="action-primary" type="button" data-demo="更新案を作成">更新案を作成</button><button type="button" data-demo="フィードバックを依頼">フィードバック</button><button class="action-primary" type="button" data-demo="変更を保存">保存</button></div><div class="mini-meta"><strong>記事設定</strong><span>数学 / 概要 / 日本語 / 公開準備完了</span><button type="button" data-demo="記事設定を編集">編集</button></div><div class="mini-notice"><span>i</span>公開中の記事を保持したまま更新案を作成できます。</div><div class="mini-memo"><span>›</span><strong>自分用メモ帳</strong><small>必要なときだけ開く</small></div><footer class="candidate-footer"><span>向いている場面</span><p>{candidate.id === "codex" ? "常時操作する執筆者向け。最小の移動で実行できます。" : candidate.id === "split" ? "公開操作が多いチーム向け。誤操作を分けて防ぎます。" : "レビュー中心の運用向け。本文への集中を優先します。"}</p></footer></article>)}
      </section>
      <section class="decision"><span class="eyebrow">DECISION NOTE</span><strong>候補を選んだら、単体案で詳細操作を確認</strong><p>この比較ページ自体も本番にはリンクされていない独立プロトタイプです。</p></section>
    </main>
    <div class="toast is-hidden" data-toast role="status"></div>
    <script is:inline>
      const root = document.documentElement; const toggle = document.querySelector('[data-theme-toggle]'); const label = document.querySelector('[data-theme-label]'); const icon = document.querySelector('[data-theme-icon]'); const toast = document.querySelector('[data-toast]'); let timer;
      const notify = (message) => { toast.textContent = message; toast.classList.remove('is-hidden'); clearTimeout(timer); timer = setTimeout(() => toast.classList.add('is-hidden'), 1800); };
      toggle?.addEventListener('click', () => { const dark = root.dataset.theme === 'dark'; root.dataset.theme = dark ? 'light' : 'dark'; label.textContent = dark ? 'ダーク' : 'ホワイト'; icon.textContent = dark ? '☾' : '◐'; notify(dark ? 'ホワイトモードに切り替えました' : 'ダークモードに切り替えました'); });
      document.querySelectorAll('[data-demo]').forEach((button) => button.addEventListener('click', () => notify(`${button.dataset.demo}（チェック用）`)));
    </script>
  </body>
</html>

<style>
  :root { color-scheme: dark; --bg: #151515; --surface: #191919; --surface-2: #1d1d1d; --surface-3: #222; --text: #ededeb; --text-2: rgba(255,255,255,.64); --text-3: rgba(255,255,255,.42); --border: rgba(255,255,255,.08); --border-subtle: rgba(255,255,255,.05); --blue: #6ba6ff; --green: #72c98b; --red: #e27676; --shadow: 0 10px 26px rgba(0,0,0,.2); }
  :root[data-theme="light"] { color-scheme: light; --bg: #f3f3f0; --surface: #fff; --surface-2: #fafaf8; --surface-3: #f0f0ec; --text: #242522; --text-2: #64655f; --text-3: #92938d; --border: rgba(35,36,32,.12); --border-subtle: rgba(35,36,32,.07); --blue: #2a74c4; --green: #258a5a; --red: #b84a45; --shadow: 0 10px 26px rgba(29,30,26,.07); }
  * { box-sizing: border-box; } body { margin: 0; background: var(--bg); color: var(--text); font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Hiragino Sans", "Yu Gothic", sans-serif; font-size: 13px; -webkit-font-smoothing: antialiased; }.page { max-width: 1440px; margin: 0 auto; padding: 0 28px 64px; }.topbar { height: 58px; border-bottom: 1px solid var(--border-subtle); display: flex; align-items: center; justify-content: space-between; }.crumbs,.top-actions { display: flex; align-items: center; gap: 10px; }.crumbs { color: var(--text-3); font-size: 11px; }.crumbs a,.top-actions a { color: var(--blue); text-decoration: none; }.crumbs strong { color: var(--text-2); font-weight: 560; }.top-actions { color: var(--text-3); font-size: 11px; }.scope { display: inline-flex; align-items: center; gap: 6px; }.scope i { width: 6px; height: 6px; border-radius: 50%; background: var(--green); }.theme-button { height: 30px; border: 1px solid var(--border); border-radius: 6px; padding: 0 9px; display: inline-flex; align-items: center; gap: 7px; background: transparent; color: var(--text-2); font-size: 11px; }.theme-button:hover { background: var(--surface-3); }.intro { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; padding: 38px 0 25px; }.eyebrow { margin: 0; color: var(--text-3); letter-spacing: .13em; font-size: 9px; font-weight: 700; }.intro h1 { margin: 9px 0 7px; font-size: 24px; line-height: 1.2; letter-spacing: -.03em; font-weight: 650; }.intro p:not(.eyebrow) { max-width: 690px; margin: 0; color: var(--text-2); line-height: 1.6; }.legend { display: flex; align-items: center; gap: 13px; color: var(--text-3); font-size: 10px; white-space: nowrap; }.legend span { display: inline-flex; align-items: center; gap: 5px; }.dot { width: 6px; height: 6px; border-radius: 50%; display: inline-block; }.dot.blue { background: var(--blue); }.dot.green { background: var(--green); }.dot.red { background: var(--red); }.board { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }.candidate { min-width: 0; background: var(--surface); border: 1px solid var(--border); border-radius: 8px; box-shadow: var(--shadow); overflow: hidden; }.candidate-head { min-height: 57px; padding: 13px 15px; border-bottom: 1px solid var(--border-subtle); display: flex; align-items: center; justify-content: space-between; }.candidate-name { display: block; font-size: 13px; font-weight: 650; }.candidate-note { display: block; color: var(--text-3); font-size: 10px; margin-top: 4px; }.more { width: 28px; height: 28px; border: 1px solid var(--border); border-radius: 5px; background: transparent; color: var(--text-2); letter-spacing: 1px; }.mini-context { min-height: 66px; padding: 13px 15px; display: flex; align-items: center; gap: 9px; border-bottom: 1px solid var(--border-subtle); }.doc-icon { width: 27px; height: 27px; display: grid; place-items: center; border: 1px solid var(--border); border-radius: 6px; color: var(--text-2); font-weight: 700; font-size: 11px; }.mini-context div { display: grid; gap: 3px; min-width: 0; }.mini-context span { color: var(--text-3); font-size: 10px; }.mini-context strong { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; font-size: 13px; font-weight: 620; }.mini-controls { min-height: 55px; padding: 10px 15px; display: flex; align-items: center; gap: 8px; border-bottom: 1px solid var(--border-subtle); flex-wrap: wrap; }.mini-state { display: inline-flex; align-items: center; border: 1px solid var(--border); border-radius: 5px; overflow: hidden; }.mini-state span,.mini-state strong { height: 28px; padding: 0 7px; display: inline-flex; align-items: center; font-size: 9px; }.mini-state span { color: var(--text-3); }.mini-state strong { border-right: 1px solid var(--border); font-size: 10px; }.mini-state strong:last-child { border-right: 0; }.connected { display: inline-flex; align-items: center; gap: 5px; color: var(--green); font-size: 10px; }.connected i { width: 6px; height: 6px; border-radius: 50%; background: var(--green); }.mini-check { display: inline-flex; align-items: center; gap: 5px; color: var(--text-2); font-size: 10px; }.mini-check input { position: absolute; opacity: 0; }.mini-check span { width: 13px; height: 13px; border: 1px solid var(--border); border-radius: 3px; display: grid; place-items: center; }.mini-check input:checked + span { background: var(--blue); border-color: var(--blue); }.mini-check input:checked + span::after { content: "✓"; color: white; font-size: 9px; }.mini-controls select { height: 28px; min-width: 66px; border: 1px solid var(--border); border-radius: 5px; background: var(--surface-2); color: var(--text-2); font-size: 10px; padding: 0 5px; }.mini-actions { min-height: 53px; padding: 10px 15px; display: flex; gap: 6px; border-bottom: 1px solid var(--border-subtle); }.mini-actions button { height: 30px; flex: 1; min-width: 0; border: 1px solid var(--border); border-radius: 5px; padding: 0 5px; background: transparent; color: var(--text-2); font-size: 10px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }.mini-actions button:hover { background: var(--surface-3); }.mini-actions .action-primary { background: var(--blue); border-color: var(--blue); color: white; }.mini-meta { min-height: 48px; padding: 10px 15px; display: flex; align-items: center; gap: 7px; color: var(--text-3); font-size: 10px; border-bottom: 1px solid var(--border-subtle); }.mini-meta strong { color: var(--text); font-weight: 630; }.mini-meta span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.mini-meta button { margin-left: auto; height: 25px; border: 1px solid var(--border); border-radius: 5px; background: transparent; color: var(--blue); font-size: 10px; padding: 0 7px; }.mini-notice { margin: 11px 15px 2px; padding: 9px 10px; border-left: 2px solid var(--blue); background: color-mix(in srgb, var(--blue) 6%, var(--surface)); color: var(--text-2); font-size: 10px; line-height: 1.5; display: flex; gap: 7px; }.mini-notice span { width: 14px; height: 14px; border: 1px solid var(--blue); border-radius: 50%; display: grid; place-items: center; color: var(--blue); flex: 0 0 auto; }.mini-memo { min-height: 44px; padding: 10px 15px; display: flex; align-items: center; gap: 7px; }.mini-memo > span { color: var(--blue); font-size: 18px; line-height: 1; }.mini-memo strong { font-size: 11px; }.mini-memo small { color: var(--text-3); font-size: 9px; }.candidate-footer { border-top: 1px solid var(--border-subtle); padding: 12px 15px 14px; }.candidate-footer span { color: var(--text-3); font-size: 9px; letter-spacing: .08em; text-transform: uppercase; }.candidate-footer p { margin: 6px 0 0; color: var(--text-2); font-size: 10px; line-height: 1.55; }.candidate-split .mini-actions { background: var(--surface-2); }.candidate-split .mini-meta { background: var(--surface-2); }.candidate-quiet .mini-controls { border-bottom: 0; }.candidate-quiet .mini-actions { border-top: 1px solid var(--border-subtle); }.decision { margin-top: 24px; padding: 17px 2px; border-top: 1px solid var(--border-subtle); display: grid; gap: 7px; }.decision strong { font-size: 13px; font-weight: 620; }.decision p { margin: 0; color: var(--text-2); font-size: 11px; }.toast { position: fixed; left: 50%; bottom: 22px; transform: translateX(-50%); padding: 9px 13px; border: 1px solid var(--border); border-radius: 6px; background: var(--surface); box-shadow: var(--shadow); color: var(--text-2); font-size: 11px; }.is-hidden { display: none !important; }
  @media (max-width: 1120px) { body { min-width: 940px; }.page { padding-inline: 18px; }.board { gap: 10px; }.intro { align-items: flex-start; flex-direction: column; }.legend { align-self: flex-end; } }
</style>
