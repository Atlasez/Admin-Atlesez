---
import AdminLayout from "../../../../layouts/AdminLayout.astro";
---

<AdminLayout title="記事編集ヘッダー | 操作性比較プレビュー" description="JR東日本の操作パターンを参考にした独立プレビュー">
  <main class="jr-prototype" aria-label="記事編集ヘッダー操作性比較プレビュー">
    <div class="breadcrumb"><a href="/admin/ui-prototype/">UIプロトタイプ</a><span aria-hidden="true">›</span><span>操作性比較プレビュー</span></div>
    <section class="editor-shell" aria-label="記事編集上部の操作エリア">
      <header class="context"><div class="context-copy"><span class="context-icon" aria-hidden="true">文</span><div><small>Atlas / mathematics</small><strong>統計的機械学習の基礎</strong></div></div><div class="context-actions"><button type="button" data-command>⌘ K <span>操作を検索</span></button><button class="more" type="button" data-menu aria-label="その他の操作">•••</button></div></header>
      <nav class="purpose-tabs" aria-label="編集情報の切り替え" role="tablist"><button class="purpose-tab is-active" type="button" role="tab" aria-selected="true" aria-controls="purpose-status" tabindex="0" data-purpose="status">状態</button><button class="purpose-tab" type="button" role="tab" aria-selected="false" aria-controls="purpose-sync" tabindex="-1" data-purpose="sync">同期</button><button class="purpose-tab" type="button" role="tab" aria-selected="false" aria-controls="purpose-view" tabindex="-1" data-purpose="view">表示</button><button class="purpose-tab" type="button" role="tab" aria-selected="false" aria-controls="purpose-actions" tabindex="-1" data-purpose="actions">操作</button></nav>
      <p class="purpose-caption" data-purpose-caption>公開・編集状態を確認できます。カード内の操作はすぐに反映されます。</p>
      <section class="status-grid" id="purpose-status" aria-label="現在の状態" data-purpose-section="status"><article class="status-card"><div class="status-card-head"><span>記事状態</span><i class="status-dot"></i></div><strong>下書き</strong><small>未公開 · 原稿を編集中</small><div class="segmented"><button class="segment is-active" type="button" data-state="draft" aria-pressed="true">下書き</button><button class="segment" type="button" data-state="unpublished" aria-pressed="false">未公開</button></div></article><article class="status-card" data-purpose-section="sync"><div class="status-card-head"><span>自動公開</span><i class="status-orb" data-publish-orb></i></div><strong data-publish>接続済み</strong><small data-publish-detail>変更は安全に同期されます</small><button class="refresh" type="button" data-refresh>更新 <span aria-hidden="true">↻</span></button></article><article class="status-card" data-purpose-section="sync"><div class="status-card-head"><span>共同編集</span><i class="status-orb" data-presence-orb></i></div><strong data-presence>1人が接続中</strong><small data-presence-detail>上杉和輝 · 編集履歴 3</small><button class="refresh" type="button" data-history>履歴を見る <span aria-hidden="true">→</span></button></article></section>
      <section class="title-row"><div class="title-copy"><h1>統計的機械学習の基礎: 確率モデルと正則化</h1><span>最終更新 2分前 · 下書き</span><span>初回作成: <b>上杉 和輝</b> · 2026/09/02</span></div><div class="avatars" aria-label="編集履歴のメンバー"><button type="button" class="avatar uk" data-avatar="上杉 和輝 · 初回作成">UK</button><button type="button" class="avatar ms" data-avatar="三浦 さき · 3時間前に編集">MS</button><button type="button" class="avatar kt" data-avatar="加藤 拓 · 昨日に編集">KT</button></div></section>
      <div class="controls" id="purpose-view" data-purpose-section="view"><div class="control-group"><label class="check"><input type="checkbox" checked data-autosave /><i></i><span data-autosave-label>下書きを自動保存</span></label><label class="select"><span>プレビュー</span><select aria-label="Webプレビュー形式"><option>組版</option><option>簡易</option></select><b>⌄</b></label><label class="select"><span>数式</span><select aria-label="数式エンジン"><option>KaTeX（高速）</option><option>MathJax</option></select><b>⌄</b></label></div><div class="actions" id="purpose-actions" data-purpose-section="actions"><button class="secondary" type="button" data-feedback>フィードバックを依頼</button><button class="primary" type="button" data-save>保存する</button></div></div>
    </section>
  </main>
  <div class="menu is-hidden" data-menu-panel role="menu"><button type="button">ショートカット一覧</button><button type="button">変更履歴を見る</button></div><div class="toast is-hidden" data-toast role="status"></div>
</AdminLayout>

<script is:inline>
  const toast = document.querySelector('[data-toast]'); let toastTimer; const showToast = (message) => { if (!toast) return; toast.textContent = message; toast.classList.remove('is-hidden'); clearTimeout(toastTimer); toastTimer = setTimeout(() => toast.classList.add('is-hidden'), 1800); };
  const purposeDescriptions = { status: '公開・編集状態を確認できます。カード内の操作はすぐに反映されます。', sync: '同期と共同編集の状態を確認できます。更新で最新情報を取得します。', view: '表示と下書き保存の設定を変更できます。', actions: 'フィードバック依頼と保存をここから実行できます。' };
  const purposeTabs = [...document.querySelectorAll('[data-purpose]')]; const purposeCaption = document.querySelector('[data-purpose-caption]');
  const activatePurpose = (button, announce = true) => { const purpose = button.dataset.purpose || 'status'; purposeTabs.forEach((item) => { const active = item === button; item.classList.toggle('is-active', active); item.setAttribute('aria-selected', active ? 'true' : 'false'); item.setAttribute('tabindex', active ? '0' : '-1'); }); document.querySelectorAll('[data-purpose-section]').forEach((section) => section.classList.toggle('is-focused', section.dataset.purposeSection === purpose)); if (purposeCaption) purposeCaption.textContent = purposeDescriptions[purpose]; if (announce) showToast(`${button.textContent}の情報を表示しました`); };
  purposeTabs.forEach((button, index) => { button.addEventListener('click', () => activatePurpose(button)); button.addEventListener('keydown', (event) => { if (!['ArrowRight', 'ArrowLeft', 'Home', 'End'].includes(event.key)) return; event.preventDefault(); const next = event.key === 'Home' ? 0 : event.key === 'End' ? purposeTabs.length - 1 : (index + (event.key === 'ArrowRight' ? 1 : -1) + purposeTabs.length) % purposeTabs.length; purposeTabs[next].focus(); activatePurpose(purposeTabs[next], false); }); });
  document.querySelectorAll('[data-state]').forEach((button) => button.addEventListener('click', () => { document.querySelectorAll('[data-state]').forEach((item) => { item.classList.toggle('is-active', item === button); item.setAttribute('aria-pressed', item === button ? 'true' : 'false'); }); showToast(`${button.textContent}を選択しました`); }));
  document.querySelector('[data-command]')?.addEventListener('click', () => showToast('操作を検索（⌘K）')); document.querySelector('[data-feedback]')?.addEventListener('click', () => showToast('フィードバック依頼を作成しました')); document.querySelector('[data-save]')?.addEventListener('click', () => showToast('保存しました（チェック用）')); document.querySelector('[data-refresh]')?.addEventListener('click', (event) => { const button = event.currentTarget; button.classList.add('is-refreshing'); liveIndex = 1; tick(); showToast('状態を更新しました'); setTimeout(() => button.classList.remove('is-refreshing'), 700); }); document.querySelector('[data-history]')?.addEventListener('click', () => showToast('編集履歴を開く想定です')); document.querySelector('[data-autosave]')?.addEventListener('change', (event) => showToast(event.target.checked ? '自動保存を有効にしました' : '自動保存を無効にしました')); document.querySelectorAll('[data-avatar]').forEach((button) => button.addEventListener('click', () => showToast(button.dataset.avatar)));
  const menu = document.querySelector('[data-menu-panel]'); document.querySelector('[data-menu]')?.addEventListener('click', () => menu?.classList.toggle('is-hidden')); document.addEventListener('click', (event) => { if (!(event.target instanceof Element)) return; if (!event.target.closest('[data-menu]') && !event.target.closest('[data-menu-panel]')) menu?.classList.add('is-hidden'); });
  const publish = document.querySelector('[data-publish]'); const publishDetail = document.querySelector('[data-publish-detail]'); const presence = document.querySelector('[data-presence]'); const presenceDetail = document.querySelector('[data-presence-detail]'); const dockTargets = document.querySelectorAll('.status-card, .status-orb'); let liveIndex = 0; const states = [{ publish: '接続済み', publishDetail: '変更は安全に同期されます', presence: '1人が接続中', presenceDetail: '上杉和輝 · 編集履歴 3', active: false }, { publish: '同期中…', publishDetail: '変更を同期しています', presence: '2人が接続中', presenceDetail: '上杉和輝 +1 · 編集履歴 3', active: true }, { publish: '保存済み', publishDetail: '最新の状態です', presence: '1人が接続中', presenceDetail: '上杉和輝 · 編集履歴 3', active: false }, { publish: '再接続中…', publishDetail: '接続を確認しています', presence: '接続を確認中', presenceDetail: '再接続を試行しています', active: true }]; const animate = (node, value) => { if (!node) return; node.classList.remove('changing'); void node.offsetWidth; node.textContent = value; node.classList.add('changing'); setTimeout(() => node.classList.remove('changing'), 540); }; function tick() { const state = states[liveIndex % states.length]; liveIndex += 1; animate(publish, state.publish); animate(publishDetail, state.publishDetail); animate(presence, state.presence); animate(presenceDetail, state.presenceDetail); dockTargets.forEach((target) => target.classList.toggle('syncing', state.active)); document.querySelectorAll('[data-publish-orb], [data-presence-orb]').forEach((orb) => orb.classList.toggle('spinning', state.active)); } tick(); setInterval(tick, 2600);
</script>

<style>
  :root { --jr-blue: #176ea6; --jr-blue-hover: #0e5686; --jr-ink: #182027; --jr-muted: #56616a; --jr-faint: #66727b; --jr-border: #d5dde2; --jr-surface: #f5f7f8; }.jr-prototype { max-width: 1220px; margin: 0 auto; padding: 0 1.25rem 3rem; }.breadcrumb { display: flex; align-items: center; gap: .55rem; padding: .75rem 0 .5rem; color: var(--jr-muted); font-size: .75rem; }.breadcrumb a { color: var(--link); }.breadcrumb span[aria-hidden] { color: var(--jr-faint); }.editor-shell { overflow: hidden; border: 1px solid var(--jr-border); border-radius: .45rem; background: #fff; box-shadow: 0 .75rem 1.8rem rgba(0,26,44,.1); }.context { min-height: 72px; padding: 0 1rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; border-bottom: 1px solid var(--jr-border); }.context-copy { display: flex; align-items: center; gap: .7rem; min-width: 0; }.context-icon { width: 2.1rem; height: 2.1rem; display: grid; place-items: center; border: 1px solid var(--jr-border); border-radius: .35rem; background: var(--jr-surface); color: var(--jr-muted); }.context-copy div { display: grid; gap: .15rem; min-width: 0; }.context-copy small { color: var(--jr-muted); font-size: .7rem; }.context-copy strong { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--jr-ink); font-size: 1rem; font-weight: 800; }.context-actions { display: flex; gap: .45rem; }.context-actions button, .refresh, .secondary, .primary { height: 2.2rem; border: 1px solid var(--jr-border); border-radius: .35rem; background: transparent; color: var(--jr-ink); cursor: pointer; font: inherit; font-size: .77rem; }.context-actions button:first-child { padding: 0 .7rem; color: var(--jr-muted); }.context-actions button:first-child span { margin-left: .35rem; color: var(--jr-faint); }.context-actions button:hover, .refresh:hover, .secondary:hover { background: var(--jr-surface); color: var(--jr-blue); }.more { width: 2.25rem; color: var(--jr-muted)!important; font-size: 1rem!important; letter-spacing: .1em; }
  .purpose-tabs { display: flex; align-items: stretch; gap: .2rem; min-height: 48px; padding: 0 1rem; border-bottom: 1px solid var(--jr-border); }.purpose-tab { position: relative; height: 48px; padding: 0 .75rem; border: 0; background: transparent; color: var(--jr-muted); cursor: pointer; font: inherit; font-size: .78rem; font-weight: 800; }.purpose-tab:hover, .purpose-tab.is-active { color: var(--jr-blue); }.purpose-tab.is-active::after { content: ""; position: absolute; right: .7rem; bottom: -.05rem; left: .7rem; height: 3px; border-radius: 3px 3px 0 0; background: var(--jr-blue); }.purpose-tab:focus-visible, .context-actions button:focus-visible, .refresh:focus-visible, .secondary:focus-visible, .primary:focus-visible, .segment:focus-visible, .avatar:focus-visible, .select select:focus-visible, .check input:focus-visible + i { outline: 3px solid color-mix(in srgb,var(--jr-blue) 38%,transparent); outline-offset: 2px; }.purpose-caption { margin: 0; padding: .55rem 1rem .65rem; border-bottom: 1px solid var(--jr-border); background: #fff; color: var(--jr-muted); font-size: .7rem; line-height: 1.5; }
  .status-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: .75rem; padding: 1rem; background: var(--jr-surface); border-bottom: 1px solid var(--jr-border); }.status-card { min-height: 132px; padding: .75rem; display: grid; align-content: start; gap: .25rem; border: 1px solid var(--jr-border); border-radius: .35rem; background: #fff; transition: border-color 140ms ease, box-shadow 140ms ease, transform 140ms ease; }.status-card:hover, .status-card.is-focused { border-color: color-mix(in srgb,var(--jr-blue) 42%,var(--jr-border)); box-shadow: 0 .25rem .7rem rgba(0,26,44,.08); }.status-card.is-focused { transform: translateY(-1px); }.status-card-head { display: flex; align-items: center; justify-content: space-between; color: var(--jr-muted); font-size: .7rem; }.status-card>strong { color: var(--jr-ink); font-size: 1.05rem; }.status-card>small { min-height: 1.2em; color: var(--jr-muted); font-size: .7rem; }.status-dot { width: .5rem; height: .5rem; border-radius: 50%; background: #2c6e49; }.segmented { display: inline-flex; width: max-content; margin-top: .3rem; overflow: hidden; border: 1px solid var(--jr-border); border-radius: .3rem; }.segment { min-height: 1.75rem; padding: 0 .55rem; border: 0; border-right: 1px solid var(--jr-border); background: transparent; color: var(--jr-muted); cursor: pointer; font: inherit; font-size: .68rem; }.segment:last-child { border-right: 0; }.segment:hover, .segment.is-active { background: var(--jr-surface); color: var(--jr-blue); }.refresh { width: max-content; min-height: 1.75rem; height: 1.75rem; margin-top: .3rem; padding: 0 .55rem; color: var(--jr-blue); font-size: .68rem; }.refresh span { margin-left: .25rem; display: inline-block; font-size: .9rem; }.refresh.is-refreshing span { animation: spin .7s linear infinite; }
  .title-row { min-height: 118px; padding: 1rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; }.title-copy { display: grid; gap: .22rem; min-width: 0; }.title-copy h1 { margin: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--jr-ink); font-size: 1.4rem; line-height: 1.35; font-weight: 800; }.title-copy span { color: var(--jr-muted); font-size: .75rem; }.title-copy b { color: var(--jr-ink); }.avatars { display: inline-flex; align-items: center; }.avatar { width: 1.9rem; height: 1.9rem; margin-left: -.4rem; display: grid; place-items: center; border: 2px solid #fff; border-radius: 50%; color: #fff; cursor: pointer; font-size: .62rem; font-weight: 800; transition: transform 140ms ease; }.avatar:first-child { margin-left: 0; }.avatar:hover { z-index: 1; transform: translateY(-2px); }.uk { background: #2d6ea8; }.ms { background: #a35d4a; }.kt { background: #668953; }
  .controls { min-height: 62px; padding: .75rem 1rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; border-top: 1px solid var(--jr-border); transition: background 140ms ease; }.controls.is-focused { background: color-mix(in srgb,var(--jr-blue) 4%,#fff); }.control-group, .actions { display: flex; align-items: center; gap: .65rem; }.actions.is-focused { padding: .25rem; border-radius: .35rem; background: color-mix(in srgb,var(--jr-blue) 7%,#fff); }.check { display: inline-flex; align-items: center; gap: .4rem; color: var(--jr-muted); font-size: .72rem; white-space: nowrap; cursor: pointer; }.check input { position: absolute; opacity: 0; }.check i { width: 1rem; height: 1rem; display: grid; place-items: center; border: 1px solid var(--jr-border); border-radius: .25rem; }.check input:checked + i { border-color: var(--jr-blue); background: var(--jr-blue); }.check input:checked + i::after { content: "✓"; color: #fff; font-size: .65rem; }.select { position: relative; display: inline-flex; align-items: center; gap: .35rem; color: var(--jr-muted); font-size: .7rem; }.select select { appearance: none; height: 2rem; min-width: 7rem; padding: 0 1.4rem 0 .5rem; border: 1px solid var(--jr-border); border-radius: .3rem; background: var(--jr-surface); color: var(--jr-ink); font: inherit; }.select>b { position: absolute; right: .45rem; color: var(--jr-faint); pointer-events: none; }.secondary { padding: 0 .7rem; color: var(--jr-muted); }.primary { padding: 0 .85rem; border-color: var(--jr-blue); background: var(--jr-blue); color: #fff; font-weight: 800; }.primary:hover { background: var(--jr-blue-hover); }.status-orb { position: relative; display: inline-block; width: .62rem; height: .62rem; border: 2px solid color-mix(in srgb,var(--jr-blue) 30%,transparent); border-top-color: var(--jr-blue); border-radius: 50%; }.status-orb::after { content: ""; position: absolute; inset: -.3rem; border: 1px solid color-mix(in srgb,var(--jr-blue) 25%,transparent); border-radius: 50%; opacity: 0; }.spinning { animation: spin .8s linear infinite; }.spinning::after { animation: ripple 1.2s ease-out infinite; }.syncing strong, .syncing [data-publish], .syncing [data-presence] { color: var(--jr-blue)!important; }.syncing [data-publish], .syncing [data-presence] { background: linear-gradient(105deg,var(--jr-blue) 10%,#80b4d8 50%,var(--jr-blue) 90%); background-size: 220% 100%; background-clip: text; -webkit-background-clip: text; color: transparent!important; animation: sweep 1.45s ease-in-out infinite; }.changing { animation: enter .54s cubic-bezier(.22,.8,.28,1) both; }.menu { position: fixed; top: 8rem; right: 2rem; z-index: 5; width: 12rem; padding: .35rem; display: grid; gap: .15rem; border: 1px solid var(--jr-border); border-radius: .4rem; background: #fff; box-shadow: 0 .8rem 2rem rgba(0,26,44,.18); }.menu button { height: 1.9rem; border: 0; border-radius: .25rem; background: transparent; color: var(--jr-muted); cursor: pointer; text-align: left; font: inherit; font-size: .7rem; }.menu button:hover { background: var(--jr-surface); color: var(--jr-blue); }.toast { position: fixed; bottom: 1.2rem; left: 50%; z-index: 6; padding: .55rem .75rem; transform: translateX(-50%); border: 1px solid var(--jr-border); border-radius: .35rem; background: #fff; box-shadow: 0 .6rem 1.2rem rgba(0,26,44,.18); color: var(--jr-muted); font-size: .72rem; }.is-hidden { display: none!important; }
  @keyframes spin { to { transform: rotate(360deg); } } @keyframes ripple { 0% { opacity: .6; transform: scale(.7); } 100% { opacity: 0; transform: scale(1.5); } } @keyframes sweep { 0%,100% { background-position: 100% 0; } 50% { background-position: 0 0; } } @keyframes enter { 0% { opacity: .3; transform: translateY(3px); } 100% { opacity: 1; transform: translateY(0); } }
  @media (max-width: 980px) { .status-grid { grid-template-columns: 1fr; }.status-row { flex-wrap: wrap; }.title-row { align-items: flex-start; flex-direction: column; }.controls { align-items: flex-start; flex-direction: column; }.control-group { flex-wrap: wrap; }.actions { width: 100%; justify-content: flex-end; } }
  @media (prefers-reduced-motion: reduce) { .spinning, .spinning::after, .changing, .syncing [data-publish], .syncing [data-presence] { animation: none; } }
</style>
