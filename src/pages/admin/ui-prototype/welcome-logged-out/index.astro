---
import AdminScreenPrototype from "../../../../layouts/AdminScreenPrototype.astro";
---

<AdminScreenPrototype title="ログアウトしました（画面案）" description="ログアウト後の画面案">
  <main class="gate">
    <p class="mark">Atlasez運営</p>
    <h1>ログアウトしました</h1>
    <p>再度利用する場合は、管理サイトへ戻ってログインしてください。</p>
    <a class="primary" href="/admin/ui-prototype/welcome-login/">管理サイトへ戻る</a>
  </main>
</AdminScreenPrototype>

<style>
  .gate { margin: 0 auto; max-width: 28rem; padding: 4.5rem 1.25rem 5rem; }
  .mark { color: var(--accent-primary); font-size: .78rem; font-weight: 800; margin: 0; }
  .gate h1 { font-size: clamp(1.7rem, 4vw, 2.2rem); letter-spacing: -.03em; margin: .4rem 0 .8rem; }
  .gate p { color: var(--text-secondary); line-height: 1.75; margin: 0; }
  .primary { background: var(--accent-primary); color: var(--on-accent); display: inline-block; font-weight: 800; margin-top: 1.4rem; padding: .8rem 1rem; text-decoration: none; }
</style>
