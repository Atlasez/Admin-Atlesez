  .editor-document-tabs button:hover { background: var(--hover); color: var(--secondary); }
  .editor-document-tabs button.is-selected { background: var(--active); border-color: var(--soft-border); color: var(--text); }
  .editor-document-tabs small { color: var(--muted); display: block; font-size: 9px; margin-top: 2px; }

  .editor-save-state {
    color: var(--muted);
    font-size: 10px;
    white-space: nowrap;
  }

  .editor-autosave {
    align-items: center;
    color: var(--muted);
    display: inline-flex;
    font-size: 10px;
    gap: 4px;
    white-space: nowrap;
  }

  .editor-autosave input {
    accent-color: var(--accent);
    margin: 0;
  }

  .editor-preview-engine {
    background: var(--surface-raised);
    border: 1px solid var(--soft-border);
    border-radius: 4px;
    color: var(--secondary);
    font: inherit;
    font-size: 10px;
    min-height: 29px;
    padding: 4px 6px;
  }

  .editor-concept-advanced { border-top: 1px solid var(--soft-border); margin-top: 11px; padding-top: 9px; }
  .editor-concept-advanced summary { color: var(--muted); cursor: pointer; font-size: 10px; }
  .editor-concept-advanced-grid { display: grid; gap: 8px; grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: 9px; }
  .editor-concept-advanced-grid label { color: var(--secondary); display: grid; font-size: 10px; gap: 4px; }
  .editor-concept-advanced-grid input { background: var(--surface-raised); border: 1px solid var(--soft-border); border-radius: 4px; color: var(--text); font: inherit; font-size: 10px; min-height: 29px; padding: 5px 7px; width: 100%; }
