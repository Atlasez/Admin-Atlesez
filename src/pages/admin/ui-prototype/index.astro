          <section class="prototype-view hub-view" data-view="portal" aria-labelledby="portal-heading" hidden>
            <div class="page-heading"><div><p>Atlasez</p><h1 id="portal-heading">運営ポータル</h1></div><button class="quiet-action" type="button" data-portal-apply>応募フォームを確認</button></div>
