                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3"/><path d="M5 20a7 7 0 0 1 14 0" /></svg>
                  </span>
                  <span class="review-avatar review-avatar-green" title="M. Sato">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8Z"/><path d="M19 16v5M16.5 18.5h5" /></svg>
                  </span>
                  <span class="review-avatar review-avatar-violet" title="K. Tanaka">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="5" width="14" height="14" rx="2"/><path d="M8 12h8M12 8v8" /></svg>
                  </span>
