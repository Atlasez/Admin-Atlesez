  }

  .settings-row:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .settings-row span {
    display: grid;
    gap: 2px;
  }

  .settings-row strong {
    font-size: 12px;
    font-weight: 600;
  }

  .settings-row small {
    color: var(--muted);
    font-size: 10px;
  }

  .settings-row input {
