    <div class="toast-stack" data-toast-stack aria-live="polite" aria-atomic="true"></div>

    <script>
      const root = document.querySelector<HTMLElement>("[data-prototype-shell]");
      const popover = document.querySelector<HTMLElement>("[data-popover]");
      const modal = document.querySelector<HTMLElement>("[data-modal]");
      const modalTitle = document.querySelector<HTMLElement>("[data-modal-title]");
      const modalBody = document.querySelector<HTMLElement>("[data-modal-body]");
      const modalActions = document.querySelector<HTMLElement>("[data-modal-actions]");
      const toastStack = document.querySelector<HTMLElement>("[data-toast-stack]");
      const workspaceNames = document.querySelectorAll<HTMLElement>("[data-workspace-name]");
      const workspaceButton = document.querySelector<HTMLButtonElement>("[data-workspace-menu]");
      const searchButton = document.querySelector<HTMLButtonElement>("[data-search-open]");
      const notificationButton = document.querySelector<HTMLButtonElement>("[data-notification-menu]");
      let popoverAnchor: HTMLElement | null = null;
      let lastFocusedElement: HTMLElement | null = null;
      let unreadNotifications = 2;
      let currentWorkspace = "Atlas";

      const setNavOpen = (open: boolean) => {
        if (!root) return;
        root.classList.toggle("nav-open", open);
        document.body.classList.toggle("nav-lock", open);
      };

      document.querySelector("[data-nav-open]")?.addEventListener("click", () => setNavOpen(true));
      document.querySelector("[data-nav-close]")?.addEventListener("click", () => setNavOpen(false));
      document.querySelector("[data-nav-scrim]")?.addEventListener("click", () => setNavOpen(false));

      const themeToggle = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
      const syncThemeLabel = () => {
        if (!themeToggle) return;
        const isDark = document.documentElement.dataset.theme === "dark";
        themeToggle.setAttribute("aria-label", isDark ? "ライトテーマを使う" : "ダークテーマを使う");
        themeToggle.setAttribute("title", isDark ? "ライトテーマに切り替え" : "ダークテーマに切り替え");
      };

      syncThemeLabel();
      themeToggle?.addEventListener("click", () => {
        const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem("atlasez-prototype-theme", next);
        } catch {
          // The prototype still works when storage is unavailable.
        }
        syncThemeLabel();
        showToast(`${next === "dark" ? "ダーク" : "ライト"}テーマに切り替えました`);
      });

      const escapeHtml = (value: string) =>
        value.replace(/[&<>'"]/g, (character) => ({
          "&": "&amp;",
          "<": "&lt;",
          ">": "&gt;",
          "'": "&#39;",
          '"': "&quot;",
        })[character] || character);

      const showToast = (message: string) => {
        if (!toastStack) return;
        const toast = document.createElement("div");
        toast.className = "toast";
        toast.textContent = message;
        toastStack.append(toast);
        window.setTimeout(() => {
          toast.classList.add("toast-leaving");
          window.setTimeout(() => toast.remove(), 180);
        }, 2600);
      };

      const closePopover = () => {
        if (!popover) return;
        popover.hidden = true;
        popover.innerHTML = "";
        popoverAnchor = null;
      };

      const positionPopover = () => {
        if (!popover || popover.hidden || !popoverAnchor) return;
        const anchorRect = popoverAnchor.getBoundingClientRect();
        const panelRect = popover.getBoundingClientRect();
        const left = Math.max(12, Math.min(anchorRect.right - panelRect.width, window.innerWidth - panelRect.width - 12));
        const top = Math.max(12, Math.min(anchorRect.bottom + 7, window.innerHeight - panelRect.height - 12));
        popover.style.left = `${left}px`;
        popover.style.top = `${top}px`;
      };

      const openPopover = (anchor: HTMLElement, content: string) => {
        if (!popover) return;
        if (!popover.hidden && popoverAnchor === anchor) {
          closePopover();
          return;
        }
        popover.innerHTML = content;
        popoverAnchor = anchor;
        popover.hidden = false;
        positionPopover();
        popover.querySelector<HTMLElement>("button")?.focus();
      };

      const closeModal = () => {
        if (!modal) return;
        modal.hidden = true;
        document.body.classList.remove("modal-lock");
        modalTitle && (modalTitle.textContent = "");
        modalBody && (modalBody.innerHTML = "");
        modalActions && (modalActions.innerHTML = "");
        lastFocusedElement?.focus();
        lastFocusedElement = null;
      };

      const openModal = (title: string, body: string, actions = "") => {
        if (!modal || !modalTitle || !modalBody || !modalActions) return;
        closePopover();
        lastFocusedElement = document.activeElement instanceof HTMLElement ? document.activeElement : null;
        modalTitle.textContent = title;
        modalBody.innerHTML = body;
        modalActions.innerHTML = actions || '<button class="modal-secondary" type="button" data-modal-close>閉じる</button>';
        modal.hidden = false;
        document.body.classList.add("modal-lock");
        modal.querySelector<HTMLElement>("[data-modal-close], input, button")?.focus();
      };

      const workspaceMenu = () => {
        const options = [
