                    data-article-management={item.tone === "published" ? "managed" : "unmanaged"}
                    data-article-test="false"
                    data-article-workflow={item.tone === "in-review" ? "reviewing" : item.tone === "published" ? "requesting" : "editing"}
                    data-article-archive="active"
                    data-detail-type="article"
                    data-detail-title={item.title}
                    data-detail-meta={`${item.subject} · ${item.excerpt}`}
