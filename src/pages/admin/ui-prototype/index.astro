  .review-avatar-blue {
    color: var(--blue);
  }

  .review-avatar-green {
    color: var(--green);
  }

  .review-avatar-violet {
    color: var(--violet);
  }

  .review-avatar:hover,
  .review-avatar:focus-visible {
