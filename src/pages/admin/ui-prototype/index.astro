  .editor-back:hover {
    color: var(--text);
  }

  .editor-view-actions {
    align-items: center;
    display: flex;
    gap: 7px;
  }

  .editor-document-bar { align-items: center; border-bottom: 1px solid var(--soft-border); display: flex; gap: 10px; justify-content: space-between; margin-bottom: 12px; padding: 0 0 10px; }
  .editor-document-tabs { align-items: center; display: flex; gap: 4px; min-width: 0; overflow-x: auto; }
  .editor-document-tabs .panel-kicker { flex: 0 0 auto; margin-right: 3px; }
