import { getCollection } from "astro:content";

const subjectCatalog = (await getCollection("subjects"))
  .sort((left, right) => left.data.order - right.data.order)
  .map((subject) => ({
    slug: subject.data.slug,
    name: subject.data.name.ja,
    status: subject.data.status,
    categories: subject.data.categories.length,
    categoryOptions: subject.data.categories
      .slice()
      .sort((left, right) => left.order - right.order)
      .map((category) => ({ slug: category.slug, name: category.name.ja })),
  }));
const publishedArticles = (await getCollection("articles")).filter(
  (article) => article.data.locale === "ja" && article.data.status === "published",
);
const publishedArticleCount = publishedArticles.length;
const articleCountBySubject = new Map<string, number>();
for (const article of publishedArticles) {
  articleCountBySubject.set(article.data.subject, (articleCountBySubject.get(article.data.subject) ?? 0) + 1);
}
const publishedSubjectCount = subjectCatalog.filter((subject) => subject.status === "published").length;
const categoryCount = subjectCatalog.reduce((total, subject) => total + subject.categories, 0);
const subjectPreview = subjectCatalog.filter((subject) => subject.status === "published").slice(0, 8);
const categoryCatalog = subjectCatalog.flatMap((subject) => subject.categoryOptions.map((category) => ({ ...category, subject: subject.name })));
const genreEntries = subjectCatalog
  .filter((subject) => subject.status === "published")
  .map((subject) => ({
    ...subject,
    articles: articleCountBySubject.get(subject.slug) ?? 0,
  }));

