    border-bottom: 0;
  }

  .editor-writing-panel > .editor-pane:nth-child(even):not([hidden]) {
    border-right: 0;
  }

  .editor-panel-heading {
    align-items: baseline;
    border-bottom: 1px solid var(--soft-border);
    display: flex;
    justify-content: space-between;
    padding: 11px 13px;
  }

  .editor-panel-heading h2 {
    font-size: 12px;
    font-weight: 550;
    margin: 3px 0 0;
  }

  .panel-kicker {
    color: var(--muted);
    font-size: 9px;
    letter-spacing: 0.08em;
  }

  .required-note,
  .editor-side-count {
    color: var(--muted);
    font-size: 10px;
  }

  .editor-metadata-grid {
    display: grid;
    gap: 10px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    padding: 12px;
  }

  .editor-field {
    display: grid;
    gap: 5px;
    min-width: 0;
  }

  .editor-field-wide {
    grid-column: 1 / -1;
  }

  .editor-field > span {
    color: var(--secondary);
    font-size: 10px;
  }

  .editor-field i {
    color: var(--red);
    font-style: normal;
  }

  .editor-field input,
  .editor-field select {
    background: var(--surface-raised);
    border: 1px solid var(--soft-border);
    border-radius: 4px;
    color: var(--text);
    font: inherit;
    min-height: 32px;
    padding: 7px 8px;
  }

  .editor-field input:focus,
  .editor-field select:focus,
  .editor-body-input:focus {
    border-color: var(--accent);
    outline: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
  }

  .editor-field-help {
    color: var(--muted);
    font-size: 9px;
  }

  .editor-tabs {
    align-items: center;
    border-bottom: 1px solid var(--soft-border);
    display: flex;
    gap: 3px;
    padding: 8px 10px;
  }

  .editor-pane-switcher {
    align-items: center;
    background: var(--surface-raised);
    border-bottom: 1px solid var(--soft-border);
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    padding: 7px 10px;
  }

  .editor-pane-switcher > span {
    color: var(--muted);
    font-size: 9px;
    margin-right: 4px;
  }

  .editor-pane-switcher button {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    color: var(--muted);
    cursor: pointer;
    font: inherit;
    font-size: 9px;
    padding: 4px 7px;
  }

  .editor-pane-switcher button.is-selected,
  .editor-pane-switcher button:hover {
    background: var(--active);
    border-color: var(--soft-border);
    color: var(--text);
  }

  .editor-tab,
  .editor-format-toolbar button {
    background: transparent;
    border: 0;
    border-radius: 4px;
    color: var(--muted);
    cursor: pointer;
    font: inherit;
    font-size: 10px;
    padding: 6px 8px;
  }

  .editor-tab.is-selected,
  .editor-tab:hover,
  .editor-format-toolbar button:hover {
    background: var(--active);
    color: var(--text);
  }

  .editor-word-count {
    color: var(--muted);
    font-size: 10px;
    margin-left: auto;
  }

  .editor-format-toolbar {
    align-items: center;
    border-bottom: 1px solid var(--soft-border);
    display: flex;
    flex-wrap: wrap;
    gap: 3px;
    padding: 7px 10px;
  }

  .editor-code-search {
    align-items: center;
    background: var(--surface-raised);
    border-bottom: 1px solid var(--soft-border);
    display: flex;
    gap: 6px;
    padding: 6px 10px;
  }

  .editor-code-search[hidden] {
    display: none;
  }

  .editor-code-search label {
    align-items: center;
    color: var(--muted);
    display: flex;
    font-size: 10px;
    gap: 7px;
    min-width: 0;
  }

  .editor-code-search input {
    background: var(--surface);
    border: 1px solid var(--soft-border);
    border-radius: 3px;
    color: var(--text);
    font: 11px var(--font-mono, ui-monospace);
    min-height: 27px;
    min-width: 180px;
    outline: 0;
    padding: 4px 7px;
  }

  .editor-code-search input:focus {
    border-color: var(--accent);
    outline: 1px solid color-mix(in srgb, var(--accent) 28%, transparent);
  }

  .editor-code-search > span {
    color: var(--muted);
    font-size: 10px;
    margin-left: auto;
    white-space: nowrap;
  }

  .editor-code-search button {
    background: transparent;
    border: 1px solid var(--soft-border);
    border-radius: 3px;
    color: var(--secondary);
    cursor: pointer;
    font: inherit;
    font-size: 10px;
    min-height: 27px;
    padding: 3px 7px;
  }

  .editor-code-search button:hover,
  .editor-code-search button:focus-visible {
    background: var(--active);
    color: var(--text);
  }

  .editor-code-editor {
    background: var(--surface);
    display: grid;
    grid-template-columns: 42px minmax(0, 1fr);
    height: 420px;
    max-height: 70vh;
    min-height: 300px;
    overflow: hidden;
    resize: vertical;
  }

  .editor-line-numbers {
    background: color-mix(in srgb, var(--surface-raised) 72%, var(--surface));
    border-right: 1px solid var(--soft-border);
    color: var(--muted);
    font: 12px/1.75 var(--font-mono, ui-monospace);
    margin: 0;
    overflow: hidden;
    padding: 15px 9px 15px 0;
    text-align: right;
    user-select: none;
    white-space: pre;
  }

  .editor-line-numbers span {
    display: block;
    height: 1.75em;
  }

  .editor-line-numbers span.is-current {
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    color: var(--accent);
  }

  .editor-body-input {
    background: var(--surface);
    border: 0;
    color: var(--text);
    font: 12px/1.75 var(--font-mono, ui-monospace);
    height: 100%;
    min-height: 0;
    outline: 0;
    overflow: auto;
    padding: 15px;
    resize: none;
    width: 100%;
  }

  .editor-code-status {
    align-items: center;
    background: var(--surface-raised);
    border-top: 1px solid var(--soft-border);
    color: var(--muted);
    display: flex;
    flex-wrap: wrap;
    font: 10px/1.4 var(--font-mono, ui-monospace);
    gap: 14px;
    justify-content: flex-end;
    padding: 5px 12px;
  }

  .editor-code-status span:first-child {
    color: var(--secondary);
    margin-right: auto;
  }

  .editor-preview-pane {
    color: var(--text);
    font-size: 13px;
    line-height: 1.75;
    min-height: 420px;
    padding: 17px;
  }

  .editor-preview-pane h1,
  .editor-preview-pane h2,
  .editor-preview-pane h3 {
    font-weight: 560;
    line-height: 1.35;
    margin: 0.8em 0 0.45em;
  }

  .editor-preview-pane h1 { font-size: 20px; }
  .editor-preview-pane h2 { font-size: 17px; }
  .editor-preview-pane h3 { font-size: 14px; }

  .editor-preview-pane p {
    margin: 0.45em 0;
  }

  .editor-preview-pane li {
    margin-left: 1.25em;
  }

  .editor-preview-pane blockquote {
    border-left: 2px solid var(--accent);
    color: var(--secondary);
    margin: 12px 0;
    padding-left: 12px;
  }

  .editor-heading-outline,
  .editor-notebook {
    border-top: 1px solid var(--soft-border);
    color: var(--secondary);
    font-size: 10px;
    padding: 9px 13px;
  }

  .editor-heading-outline summary,
  .editor-notebook summary {
    color: var(--muted);
    cursor: pointer;
  }

  .editor-heading-outline nav {
    display: grid;
    gap: 5px;
    margin-top: 8px;
  }

  .editor-heading-outline a {
    color: var(--secondary);
    text-decoration: none;
  }

  .editor-heading-outline a:hover {
    color: var(--accent);
  }

  .editor-notebook textarea,
  .editor-comment-compose textarea,
  .editor-comment-thread textarea {
    background: var(--surface-raised);
    border: 1px solid var(--soft-border);
    border-radius: 4px;
    box-sizing: border-box;
    color: var(--text);
    display: block;
    font: inherit;
    font-size: 10px;
    line-height: 1.55;
    margin-top: 8px;
    min-height: 66px;
    padding: 7px;
    resize: vertical;
    width: 100%;
  }

  .editor-notebook > div {
    align-items: center;
    display: flex;
    gap: 8px;
    margin-top: 7px;
  }

  .editor-notebook small {
    color: var(--muted);
    font-size: 9px;
  }

  .editor-comments-pane {
    display: grid;
    gap: 10px;
    min-height: 420px;
    padding: 13px;
  }

  .editor-comment-filters { display: flex; gap: 7px; }
  .editor-comment-filters input,
  .editor-comment-filters select { background: var(--surface-raised); border: 1px solid var(--soft-border); border-radius: 4px; color: var(--secondary); font: inherit; font-size: 10px; min-height: 29px; padding: 5px 7px; }
  .editor-comment-filters input { flex: 1 1 auto; min-width: 0; }
  .editor-comment-thread[hidden] { display: none !important; }

  .editor-comment-guide {
    background: var(--surface-raised);
    border-left: 2px solid var(--accent);
    display: grid;
    gap: 3px;
    padding: 9px 10px;
  }

  .editor-comment-guide strong {
    font-size: 11px;
    font-weight: 550;
  }

  .editor-comment-guide span,
  .editor-comment-thread p {
    color: var(--secondary);
    font-size: 10px;
    line-height: 1.55;
    margin: 0;
  }

  .editor-comment-thread {
    border: 1px solid var(--soft-border);
    border-left: 2px solid var(--accent);
    border-radius: 4px;
    display: grid;
    gap: 8px;
    padding: 10px;
  }

  .editor-comment-thread.is-resolved {
    border-left-color: var(--green);
    opacity: 0.78;
  }

  .editor-comment-meta {
    align-items: center;
    display: flex;
    gap: 8px;
  }

  .editor-comment-meta strong {
    font-size: 10px;
    font-weight: 550;
  }

  .editor-comment-meta span,
  .editor-comment-meta b {
    color: var(--muted);
    font-size: 9px;
    font-weight: 450;
  }

  .editor-comment-meta b {
    color: var(--amber);
    margin-left: auto;
  }

  .editor-comment-thread.is-resolved .editor-comment-meta b {
    color: var(--green);
  }

  .editor-comment-compose {
    border-top: 1px solid var(--soft-border);
    padding-top: 10px;
  }

  .editor-media-pane,
  .editor-memo-pane {
    min-height: 250px;
    padding: 13px;
  }

  .editor-media-toolbar {
    align-items: end;
    display: grid;
    gap: 8px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .editor-media-toolbar label {
    color: var(--secondary);
    display: grid;
    font-size: 10px;
    gap: 5px;
  }

  .editor-media-toolbar input,
  .editor-memo-pane textarea {
    background: var(--surface-raised);
    border: 1px solid var(--soft-border);
    border-radius: 4px;
    box-sizing: border-box;
    color: var(--text);
    font: inherit;
    font-size: 10px;
    min-height: 30px;
    padding: 6px 7px;
    width: 100%;
  }

  .editor-media-toolbar button {
    min-height: 30px;
    width: auto;
  }

  .editor-media-hint,
  .editor-memo-pane > p {
    color: var(--muted);
    font-size: 10px;
    line-height: 1.6;
    margin: 11px 0;
  }

  .editor-media-empty {
    border: 1px dashed var(--soft-border);
    color: var(--muted);
    font-size: 10px;
    padding: 28px 12px;
    text-align: center;
  }

  .editor-media-list[hidden] { display: none !important; }
  .editor-media-item { align-items: center; border: 1px solid var(--soft-border); border-radius: 4px; display: flex; gap: 8px; padding: 9px 10px; }
  .editor-media-item strong { font-size: 11px; font-weight: 550; }
  .editor-media-item small { color: var(--muted); font-size: 9px; margin-right: auto; }

  .editor-memo-pane textarea {
    min-height: 165px;
    resize: vertical;
  }

  .editor-memo-pane > div {
    align-items: center;
    display: flex;
    gap: 8px;
    margin-top: 8px;
  }

  .editor-memo-pane small {
    color: var(--muted);
    font-size: 9px;
  }

  .editor-preview-pane code,
  .editor-inline-math {
    background: var(--active);
    border-radius: 3px;
    color: var(--accent);
    font-family: var(--font-mono, ui-monospace);
    font-size: 0.9em;
    padding: 2px 4px;
  }

  .editor-side-panel {
    display: grid;
    gap: 12px;
  }

  .editor-side-card {
    padding: 0 0 12px;
  }

  .editor-checklist {
    display: grid;
    gap: 10px;
    list-style: none;
    margin: 0;
    padding: 10px 13px 0;
  }

  .editor-checklist li {
    align-items: start;
    color: var(--muted);
    display: grid;
    gap: 7px;
    grid-template-columns: 22px 1fr;
  }

  .editor-checklist li > span {
    align-items: center;
    border: 1px solid var(--soft-border);
    border-radius: 50%;
    display: flex;
    font-size: 10px;
    height: 18px;
    justify-content: center;
    width: 18px;
  }

  .editor-checklist li.is-current {
    color: var(--text);
  }

  .editor-checklist li.is-current > span {
    border-color: var(--accent);
    color: var(--accent);
  }

  .editor-checklist strong {
    display: block;
    font-size: 11px;
    font-weight: 550;
  }

  .editor-checklist small {
    color: var(--muted);
    display: block;
    font-size: 10px;
    margin-top: 2px;
  }

  .editor-side-copy {
    color: var(--secondary);
    font-size: 10px;
    line-height: 1.6;
    margin: 11px 13px;
  }

  .editor-side-action {
    margin: 0 13px;
    width: calc(100% - 26px);
  }

  .editor-side-actions {
    display: grid;
    gap: 6px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0 13px;
  }

  .editor-side-actions .quiet-action {
    margin: 0;
    width: 100%;
  }

  .editor-reference-card {
    display: grid;
    gap: 7px;
    padding: 13px;
  }

  .editor-reference-card > strong {
    font-size: 12px;
    font-weight: 550;
  }

  .editor-reference-card p {
    color: var(--secondary);
    font-size: 10px;
    line-height: 1.6;
    margin: 0 0 4px;
  }

  .revision-list {
    border-top: 1px solid var(--soft-border);
    display: grid;
    gap: 0;
    margin-top: 8px;
  }

  .revision-list > div {
    border-bottom: 1px solid var(--soft-border);
    display: grid;
    gap: 3px;
    padding: 9px 0;
  }

  .revision-list strong {
    font-size: 11px;
    font-weight: 550;
  }

  .revision-list small,
  .revision-list span {
    color: var(--muted);
    font-size: 10px;
  }

  .article-heading {
    margin-bottom: 18px;
  }

  .article-create {
    min-height: 31px;
  }

  .article-toolbar {
    align-items: center;
    border-bottom: 1px solid var(--soft-border);
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    margin-bottom: 17px;
    padding-bottom: 10px;
  }

  .article-filter-details {
    border-bottom: 1px solid var(--soft-border);
    margin: -6px 0 17px;
  }

  .article-filter-details summary {
    color: var(--muted);
    cursor: pointer;
    font-size: 11px;
    list-style: none;
    padding: 0 0 10px;
  }

  .article-filter-details summary::-webkit-details-marker { display: none; }
  .article-filter-details summary::before { content: "⌄"; display: inline-block; margin-right: 6px; transition: transform 140ms ease; }
  .article-filter-details[open] summary::before { transform: rotate(180deg); }
  .article-filter-details summary:hover { color: var(--text); }
  .article-filter-grid { display: grid; gap: 9px; grid-template-columns: repeat(4, minmax(0, 1fr)); padding: 0 0 12px; }
  .article-filter-grid label { color: var(--muted); display: grid; font-size: 10px; gap: 5px; }
  .article-filter-grid input, .article-filter-grid select { background: var(--surface-raised); border: 1px solid var(--soft-border); border-radius: 4px; color: var(--secondary); font: inherit; font-size: 11px; min-height: 31px; padding: 5px 7px; width: 100%; }
  .article-filter-actions { align-items: center; display: flex; gap: 9px; justify-content: flex-end; padding: 0 0 11px; }
  .article-filter-actions span { color: var(--muted); font-size: 10px; margin-right: auto; }

  @media (max-width: 760px) {
    .article-filter-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  .filter-chip {
    align-items: center;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 5px;
    color: var(--muted);
    display: inline-flex;
    font-size: 11px;
    gap: 5px;
    min-height: 28px;
    padding: 0 8px;
  }

  .filter-chip span {
    color: var(--muted);
    font-size: 10px;
    font-variant-numeric: tabular-nums;
  }

  .filter-chip:hover,
  .filter-chip.active {
    background: var(--active);
    border-color: var(--soft-border);
    color: var(--text);
  }

  .filter-chip.active span {
    color: var(--secondary);
  }

  .article-table {
    border-bottom: 1px solid var(--border);
    border-top: 1px solid var(--border);
  }

  .article-table-header,
  .article-row {
    display: grid;
    gap: 12px;
    grid-template-columns: 148px minmax(240px, 1fr) 150px 100px;
  }

  .article-table-header {
    color: var(--muted);
    font-size: 10px;
    padding: 8px;
  }

  .article-row {
    align-items: center;
    background: transparent;
    border: 0;
    border-top: 1px solid var(--soft-border);
    cursor: pointer;
    min-height: 58px;
    padding: 6px 8px;
    text-align: left;
    width: 100%;
  }

  .article-row[hidden],
  .prototype-list-row[hidden],
  .calendar-event-list[hidden],
  .calendar-grid[hidden] {
    display: none !important;
  }

  .article-row:hover {
    background: var(--hover);
  }

  .article-row > span {
    align-items: center;
    color: var(--secondary);
    display: flex;
    font-size: 11px;
    gap: 7px;
    min-width: 0;
  }

  .article-row > span:last-child {
    justify-content: space-between;
  }

  .article-row > span:last-child svg {
    color: var(--muted);
    height: 14px;
    width: 14px;
  }

  .article-title {
    align-items: initial !important;
    display: grid !important;
  }

  .article-title strong {
    color: var(--text);
    font-size: 12px;
    font-weight: 550;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .article-title small {
    color: var(--muted);
    font-size: 11px;
  }

  .prototype-view[hidden] {
    display: none;
  }

  .prototype-toolbar {
    align-items: center;
    border-bottom: 1px solid var(--soft-border);
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    margin-bottom: 17px;
    padding-bottom: 10px;
  }

  .prototype-list {
    border-bottom: 1px solid var(--border);
    border-top: 1px solid var(--border);
  }

  .prototype-list-row,
  .permission-row,
  .analytics-row {
    align-items: center;
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--soft-border);
    color: var(--text);
    cursor: pointer;
    display: grid;
    gap: 14px;
    min-height: 66px;
    padding: 9px 7px;
    text-align: left;
    width: 100%;
  }

  .prototype-list-row:last-child,
  .permission-row:last-child,
  .analytics-row:last-child {
    border-bottom: 0;
  }

  .prototype-list-row:hover,
  .permission-row:hover,
  .analytics-row:hover {
    background: var(--hover);
  }

  .review-list .prototype-list-row,
  .report-list .prototype-list-row,
  .task-list .prototype-list-row {
    grid-template-columns: 72px minmax(0, 1fr) 110px 15px;
  }

  .list-leading {
    align-items: center;
    color: var(--secondary);
    display: flex;
    gap: 7px;
  }

  .list-leading small {
    color: var(--muted);
    font-size: 10px;
  }

  .list-main {
    display: grid;
    gap: 3px;
    min-width: 0;
  }

  .list-main strong {
    font-size: 12px;
    font-weight: 550;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .list-main small,
  .list-meta small {
    color: var(--muted);
    font-size: 10px;
  }

  .list-meta {
    color: var(--secondary);
    display: grid;
    font-size: 11px;
    gap: 3px;
    text-align: right;
    white-space: nowrap;
  }

  .row-chevron {
    color: var(--muted);
    font-size: 16px;
    justify-self: end;
  }

  .view-lede {
    color: var(--secondary);
    font-size: 12px;
    margin: -17px 0 17px;
  }

  .view-badge {
    border: 1px solid var(--soft-border);
    border-radius: 999px;
    color: var(--secondary);
    font-size: 10px;
    padding: 4px 8px;
  }

  .hub-project-grid,
  .management-tool-grid {
    display: grid;
    gap: 8px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-bottom: 24px;
  }

  .hub-project-card,
  .management-tool-card {
    align-items: start;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--text);
    cursor: pointer;
    display: grid;
    gap: 7px;
