          body = `<p class="modal-copy">${escapeHtml(meta)}</p><dl class="detail-list"><div><dt>変更種別</dt><dd>${escapeHtml(button.dataset.detailStatus || "")}</dd></div><div><dt>更新者</dt><dd>${escapeHtml(button.dataset.detailOwner || "")}</dd></div><div><dt>反映状況</dt><dd>本番サイトへ反映済み</dd></div></dl><p class="modal-copy">この更新に関連する運営ページ・記事の導線を確認できます。</p>`;
          actions = '<button class="modal-primary" type="button" data-modal-action="history-open">関連画面を確認</button><button class="quiet-action" type="button" data-modal-action="history-rollback">ロールバックを確認</button><button class="modal-secondary" type="button" data-modal-close>閉じる</button>';
        } else if (["review", "report", "task", "calendar", "genre", "analytics", "permission"].includes(type)) {
          body = `<p class="modal-copy">${escapeHtml(meta)}</p><dl class="detail-list"><div><dt>状態</dt><dd>${escapeHtml(button.dataset.detailStatus || "")}</dd></div><div><dt>担当</dt><dd>${escapeHtml(button.dataset.detailOwner || "")}</dd></div><div><dt>更新</dt><dd>${escapeHtml(button.dataset.detailUpdated || "")}</dd></div></dl>`;
          const action = type === "review" ? "レビューを開始" : type === "report" ? "問題報告を確認" : type === "task" ? "タスクを開く" : type === "calendar" ? "予定を確認" : type === "permission" ? "権限を編集" : "詳細を確認";
          actions = `<button class="modal-primary" type="button" data-modal-action="${type}">${action}</button><button class="modal-secondary" type="button" data-modal-close>閉じる</button>`;
        } else {
          body = `<p class="modal-copy">${escapeHtml(meta)}</p><div class="modal-stat-row"><span>件数</span><strong>${escapeHtml(button.dataset.detailCount || "0")}件</strong></div>`;
          actions = '<button class="modal-primary" type="button" data-modal-action="work">一覧を開く</button><button class="modal-secondary" type="button" data-modal-close>閉じる</button>';
        }
        openModal(title, body, actions);
      };

      document.addEventListener("click", (event) => {
        const target = event.target instanceof Element ? event.target : null;
        if (!target) return;
        if (target.closest("[data-calendar-rsvp]")) return;
        const detailButton = target.closest<HTMLElement>("[data-detail-type]");
        if (detailButton) {
          openDetail(detailButton);
          return;
        }
        const listButton = target.closest<HTMLElement>("[data-open-list]");
        if (listButton) {
          openList(listButton.dataset.openList || "queue");
          return;
        }
        const workspaceChoice = target.closest<HTMLButtonElement>("[data-workspace-choice]");
        if (workspaceChoice) {
          const name = workspaceChoice.dataset.workspaceChoice || "Atlas";
          currentWorkspace = name;
          workspaceNames.forEach((element) => (element.textContent = name));
          workspaceButton?.setAttribute("aria-label", `現在のワークスペース: ${name}`);
          closePopover();
          showToast(`ワークスペースを「${name}」に切り替えました`);
          return;
        }
        const notificationRead = target.closest<HTMLButtonElement>("[data-notification-read]");
        if (notificationRead) {
          unreadNotifications = 0;
          document.querySelector("[data-notification-dot]")?.setAttribute("hidden", "true");
          notificationButton?.setAttribute("aria-label", "通知、未読なし");
          closePopover();
          showToast("通知をすべて既読にしました");
          return;
        }
        const notificationItem = target.closest<HTMLButtonElement>("[data-notification-item]");
        if (notificationItem) {
          closePopover();
          openModal("通知", '<p class="modal-copy">この通知に関連する記事を確認できます。</p>', '<button class="modal-primary" type="button" data-modal-action="article">関連する記事を開く</button><button class="modal-secondary" type="button" data-modal-close>閉じる</button>');
          return;
        }
        const accountAction = target.closest<HTMLButtonElement>("[data-account-action]");
        if (accountAction) {
          const action = accountAction.dataset.accountAction;
          closePopover();
          if (action === "settings") openSettings();
          else if (action === "profile") openModal("プロフィール", '<p class="modal-copy">Atlas運営チームのメンバー情報です。</p><dl class="detail-list"><div><dt>表示名</dt><dd>近藤 葵</dd></div><div><dt>役割</dt><dd>Atlas運営</dd></div></dl>');
          else showToast("デモを終了する操作を確認しました");
          return;
        }
        if (target.closest("[data-modal-close]") || target === modal) closeModal();
        const modalAction = target.closest<HTMLButtonElement>("[data-modal-action]");
        if (modalAction) {
          const actionMessages: Record<string, string> = { review: "レビューを開始しました", report: "問題報告を確認しました", "report-save": "問題報告の対応状況を保存しました", task: "タスクを開きました", "task-create": "タスクの下書きを作成しました", calendar: "予定を確認しました", "calendar-add": "日程を追加しました", "calendar-availability": "参加可能な時間を登録しました", "calendar-settings": "カレンダー設定を保存しました", reference: "参考文献を本文へ引用しました", "reference-save": "参考文献をリストへ保存しました", revision: "更新案を作成しました", schedule: "公開予約を保存しました", "publication-review": "公開審査を依頼しました", publish: "記事を公開しました", "complete-writing": "公開審査へ進めました", "editor-import": "公開記事を下書きへ読み込みました", article: "記事の詳細を開きました", "article-create": "新規記事の下書きを作成しました", project: "運営サイトの導線を確認しました", permission: "権限編集画面を開きました", genre: "分野の詳細を確認しました", analytics: "記事の統計を確認しました", history: "アップデート履歴を確認しました", "history-open": "関連画面を確認しました", "history-rollback": "ロールバック手順を確認しました", work: "担当タスク一覧を開きました", list: "一覧を開きました", settings: "設定を保存しました", application: "応募管理を開きました", "application-accept": "受入フローへ進みました", interview: "面談情報を保存しました", introduction: "自己紹介の変更を申請しました", discord: "Discord連携を確認しました" };
          const action = modalAction.dataset.modalAction || "";
          closeModal();
          if (action === "article" || action === "article-create") {
            openEditorView();
            showToast(action === "article-create" ? "新規記事の下書きを開きました" : "記事執筆画面を開きました");
          } else {
            showToast(actionMessages[action] || "操作を完了しました");
          }
        }
        if (target.closest("[data-search-result]")) {
          const result = target.closest<HTMLElement>("[data-search-result]");
          closeModal();
          showToast(`「${result?.querySelector("strong")?.textContent || "項目"}」を開きました`);
        }
      });

      const openSettings = () => {
        openModal("設定", '<form class="settings-form" data-settings-form><label class="settings-row"><span><strong>通知を表示</strong><small>新しいレビューや問題報告を知らせる</small></span><input type="checkbox" checked data-setting-notifications /></label><label class="settings-row"><span><strong>コンパクト表示</strong><small>一覧の行間を狭くして情報量を増やす</small></span><input type="checkbox" data-setting-compact /></label></form>', '<button class="modal-primary" type="button" data-modal-action="settings">保存する</button><button class="modal-secondary" type="button" data-modal-close>閉じる</button>');
      };

      document.querySelectorAll<HTMLElement>('[data-open-panel="settings"]').forEach((button) => {
        button.addEventListener("click", openSettings);
      });

      window.addEventListener("resize", positionPopover);
      window.addEventListener("scroll", positionPopover, true);
      window.addEventListener("keydown", (event) => {
        if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
          event.preventDefault();
          openSearch();
