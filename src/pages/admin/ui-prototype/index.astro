  }

  .article-view[hidden] {
    display: none;
  }

  .editor-view[hidden] {
    display: none;
  }

  .editor-view-header {
    align-items: flex-end;
    display: flex;
    gap: 16px;
    justify-content: space-between;
    margin-bottom: 14px;
  }

  .editor-view-header p {
    color: var(--muted);
    font-size: 10px;
    margin: 2px 0 3px;
  }

  .editor-view-header h1 {
    font-size: 20px;
    font-weight: 560;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .editor-back {
    background: transparent;
    border: 0;
    color: var(--muted);
    cursor: pointer;
    font: inherit;
    font-size: 11px;
    padding: 0 0 4px;
