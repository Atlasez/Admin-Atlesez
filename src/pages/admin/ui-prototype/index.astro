            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"></path></svg>
          </button>
        </div>
        <div class="modal-body" data-modal-body></div>
        <div class="modal-actions" data-modal-actions></div>
