    font-size: 9px;
    letter-spacing: 0.08em;
  }

  .catalog-summary-copy strong {
    font-size: 12px;
    font-weight: 550;
  }

  .catalog-summary-copy small {
    color: var(--muted);
    font-size: 10px;
  }

  .catalog-stats {
    display: flex;
    gap: 14px;
    white-space: nowrap;
