                    <span role="cell"><i class:list={["status-dot", item.tone]}></i>{item.status}</span>
                    <span class="queue-title" role="cell"><strong>{item.title}</strong><small>{item.subject}</small></span>
                    <span role="cell">{item.owner}</span>
                    <span role="cell">{item.updated}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></span>
