          </section>

          <section class="prototype-view hub-view" data-view="projects" aria-labelledby="projects-heading" hidden>
            <div class="page-heading"><div><p>Atlasez / プロジェクト</p><h1 id="projects-heading">プロジェクト</h1></div><span class="view-badge">3サイト</span></div>
