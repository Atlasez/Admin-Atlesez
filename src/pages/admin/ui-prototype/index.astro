            <div class="prototype-toolbar"><button class="filter-chip active" type="button" data-approval-filter="pending">承認待ち <span>2</span></button><button class="filter-chip" type="button" data-approval-filter="all">すべて <span>3</span></button><button class="filter-chip" type="button" data-approval-filter="approved">承認済み <span>1</span></button></div>
            <div class="approval-prototype-list">{approvalQueue.map((request, index) => <article class="approval-prototype-card" data-approval-card data-approval-status={request.tone}><div class="application-identity"><span class="profile-avatar-small">{request.name.slice(0, 1)}</span><div><strong>{request.name}</strong><small>{request.email}</small><small>{request.kind} · {request.submitted}</small></div></div><div class="approval-change"><span class="panel-kicker">変更内容</span><p>{request.summary}</p></div><span class:list={["application-status", request.tone]}>{request.status}</span>{request.tone === "pending" ? <div class="approval-actions"><button class="modal-primary" type="button" data-approval-action="approve" data-approval-index={index}>承認</button><button class="quiet-action" type="button" data-approval-action="reject" data-approval-index={index}>却下</button></div> : <span class="approval-processed">処理済み</span>}</article>)}</div>
          </section>

