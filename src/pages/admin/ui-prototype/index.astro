                        {item.icon === "published" && <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="m8 12 2.5 2.5L16 9"/></svg>}
                        {item.icon === "assigned" && <svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="4"/><path d="M3 21v-2a6 6 0 0 1 12 0v2M18 8v6M15 11h6"/></svg>}
                      </span>
                      <span class="activity-copy">
                        <span><strong>{item.action}</strong><b>{item.title}</b></span>
                        <small>{item.meta}</small>
                      </span>
                      <svg class="row-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
                    </button>
