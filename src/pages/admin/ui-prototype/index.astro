            <div class="prototype-toolbar"><label class="inline-search">名前・メール・所属で検索<input type="search" placeholder="応募者を検索" data-application-search /></label><select data-application-filter aria-label="応募状態"><option value="all">すべての状態</option><option value="new">新規</option><option value="reviewing">確認中</option><option value="accepted">受入済み</option></select><button class="filter-chip active" type="button" data-application-project="all">全プロジェクト</button><button class="filter-chip" type="button" data-application-project="atlas">アトラス</button></div>
            <div class="application-prototype-list">{applicationQueue.map((app, index) => <article class="application-prototype-card" data-application-card data-application-status={app.tone} data-application-project={index === 1 ? "seminar-platform" : index === 2 ? "secretariat" : "atlas"} data-application-text={`${app.name} ${app.affiliation} ${app.desired}`}><div class="application-identity"><span class="profile-avatar-small">{app.name.slice(0, 1)}</span><div><strong>{app.name}</strong><small>{app.affiliation}</small><small>{app.project} · {app.received}</small></div></div><div class="application-facts"><span>希望：{app.desired}</span><span class:list={["application-status", app.tone]}>{app.status}</span><select class="application-status-select" data-application-status-select aria-label={`${app.name}の応募状態`}><option value="new" selected={app.tone === "new"}>新規</option><option value="reviewing" selected={app.tone === "reviewing"}>確認中</option><option value="accepted" selected={app.tone === "accepted"}>受入済み</option><option value="rejected">却下</option></select></div><div class="application-actions"><button class="quiet-action" type="button" data-application-interview={index}>面談を設定</button><button class="modal-primary" type="button" data-application-detail={index}>応募内容を開く</button></div></article>)}</div>
          </section>

          <section class="prototype-view hub-view" data-view="approvals" aria-labelledby="approvals-heading" hidden>
