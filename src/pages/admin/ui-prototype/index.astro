<!-- Prototype-only route. Delete this directory and public/images/atlasez-logo-og.png to remove it. -->

<!doctype html>
<html lang="ja" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="darkreader-lock" />
    <meta
      name="description"
      content="Atlasez運営画面の将来像を検討するためのUIプロトタイプ。"
    />
    <title>Atlasez 運営UIプロトタイプ</title>
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem("atlasez-prototype-theme");
          const theme = saved || (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
          document.documentElement.dataset.theme = theme;
        } catch {
          document.documentElement.dataset.theme = "light";
        }
      })();
    </script>
  </head>
  <body>
    <div class="prototype-shell" data-prototype-shell>
      <div class="mobile-scrim" data-nav-scrim></div>

      <aside class="sidebar" aria-label="プロトタイプのナビゲーション" data-sidebar>
        <div class="sidebar-header">
          <div class="product-mark" aria-hidden="true">
            <img src="/images/atlasez-logo-og.png" alt="" />
          </div>
          <div class="product-copy">
            <strong>Atlasez</strong>
            <button type="button" aria-label="現在のワークスペース: Atlas" data-workspace-menu>
              <span data-workspace-name>Atlas</span>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m8 10 4 4 4-4"></path></svg>
            </button>
          </div>
          <button class="sidebar-close icon-button" type="button" aria-label="ナビゲーションを閉じる" data-nav-close>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"></path></svg>
          </button>
        </div>

        <nav class="sidebar-nav">
          {
            navigation.map((group) => (
              <section class="nav-group" aria-label={group.label || "メイン"}>
                {group.label && <h2>{group.label}</h2>}
                <div class="nav-items">
                  {group.items.map((item) => (
                    <button
                      class:list={["nav-item", { active: "active" in item && item.active }]}
                      type="button"
                      data-nav-item={item.label}
                      data-nav-group={group.label || "ホーム"}
                      aria-current={"active" in item && item.active ? "page" : undefined}
                    >
                      <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons[item.icon]} />
                      <span>{item.label}</span>
                      {"count" in item && <small>{item.count}</small>}
                    </button>
                  ))}
                </div>
              </section>
            ))
          }
        </nav>

        <div class="sidebar-footer">
          <button class="nav-item" type="button" data-open-panel="settings">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="3"></circle>
              <path d="M19.4 15a1.7 1.7 0 0 0 .34 1.88l.06.06-2.83 2.83-.06-.06A1.7 1.7 0 0 0 15 19.4a1.7 1.7 0 0 0-1 .6 1.7 1.7 0 0 0-.4 1.1V21H9.6v-.1A1.7 1.7 0 0 0 8.6 19.4a1.7 1.7 0 0 0-1.88.34l-.06.06-2.83-2.83.06-.06A1.7 1.7 0 0 0 4.6 15a1.7 1.7 0 0 0-.6-1 1.7 1.7 0 0 0-1.1-.4H3V9.6h.1A1.7 1.7 0 0 0 4.6 8.6a1.7 1.7 0 0 0-.34-1.88l-.06-.06 2.83-2.83.06.06A1.7 1.7 0 0 0 9 4.6a1.7 1.7 0 0 0 1-.6 1.7 1.7 0 0 0 .4-1.1V3h4v.1A1.7 1.7 0 0 0 15.4 4.6a1.7 1.7 0 0 0 1.88-.34l.06-.06 2.83 2.83-.06.06A1.7 1.7 0 0 0 19.4 9c.14.38.34.72.6 1 .3.28.68.42 1.1.4h.1v4h-.1a1.7 1.7 0 0 0-1.7.6Z"></path>
            </svg>
            <span>設定</span>
          </button>
          <button class="account" type="button" data-account-menu>
            <span class="avatar" aria-hidden="true">AK</span>
            <span class="account-copy">
              <strong>近藤 葵</strong>
              <small>Atlas運営</small>
            </span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="5" cy="12" r="1"></circle><circle cx="12" cy="12" r="1"></circle><circle cx="19" cy="12" r="1"></circle></svg>
          </button>
