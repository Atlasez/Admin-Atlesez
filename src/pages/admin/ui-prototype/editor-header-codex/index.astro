---
---

<html lang="ja" data-theme="dark">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>Codex風編集ヘッダー | UIチェック</title></head>
  <body>
    <main class="codex-page">
      <div class="crumb"><a href="/admin/ui-prototype/">UIプロトタイプ</a><span aria-hidden="true">›</span><span>Codex風 編集ヘッダー</span></div>
      <section class="editor-card" aria-label="記事編集ヘッダーのCodex風独立プロトタイプ">
        <div class="context-row"><div class="workspace-context"><span class="context-mark" aria-hidden="true">文</span><div><span>Atlas / mathematics</span><strong>統計的機械学習の基礎</strong></div></div><div class="context-actions"><button type="button" data-command><span>⌘ K</span>操作を検索</button><button class="more" type="button" data-menu aria-label="その他の操作">•••</button></div></div>
        <div class="status-row"><div class="segmented" role="group" aria-label="記事状態"><button class="segment is-active" type="button" data-state="draft" aria-pressed="true"><small>原稿</small><strong>下書き</strong></button><button class="segment" type="button" data-state="unpublished" aria-pressed="false"><small>公開</small><strong>未公開</strong></button></div><div class="publish-status"><i class="orb"></i><span data-publish>自動公開: 接続済み</span></div><div class="spacer"></div><button class="quiet" type="button" data-guide>手順 ↗</button><label class="check"><input type="checkbox" checked data-autosave /><i></i><span data-autosave-label>下書きを自動保存</span></label><label class="select"><select aria-label="Webプレビュー形式"><option>Webプレビュー — 組版</option><option>Webプレビュー — 簡易</option></select><b>⌄</b></label><label class="select math"><select aria-label="数式エンジン"><option>KaTeX（高速）</option><option>MathJax</option></select><b>⌄</b></label><div class="presence"><i class="orb" data-presence-orb></i><span data-presence>同期編集: 1人が接続中</span><button type="button" data-user>上杉和輝</button></div></div>
        <div class="title-row"><div class="title-copy"><h1>統計的機械学習の基礎: 確率モデルと正則化</h1><span>最終更新 2分前 · 下書き</span><span>初回作成: <em>上杉 和輝</em> · 2026/09/02</span></div><div class="collab"><div class="avatars" aria-label="編集履歴のメンバー"><button class="avatar uk" type="button" data-avatar="上杉 和輝 · 初回作成">UK</button><button class="avatar ms" type="button" data-avatar="三浦 さき · 3時間前に編集">MS</button><button class="avatar kt" type="button" data-avatar="加藤 拓 · 昨日に編集">KT</button></div><button class="history" type="button" data-history>編集履歴 <span>3</span></button><i class="divider"></i><span class="collab-live"><i class="orb"></i><span data-collab>同期編集: 1人が接続中</span></span></div></div>
        <div class="action-row"><div class="tabs" role="tablist" aria-label="表示範囲"><button class="tab is-active" type="button" role="tab" aria-selected="true">本文</button><button class="tab" type="button" role="tab" aria-selected="false">プレビュー</button><button class="tab" type="button" role="tab" aria-selected="false">コメント <span>3</span></button><button class="tab" type="button" role="tab" aria-selected="false">執筆メモ</button></div><div class="actions"><button class="secondary" type="button" data-feedback>フィードバックを依頼</button><button class="primary" type="button" data-save>保存する</button></div></div>
      </section>
      <section class="codex-dock" aria-label="リアルタイム操作トレイ"><div class="dock-copy"><span class="dock-kicker">リアルタイム操作</span><strong data-dock-label>同期状態を確認しています…</strong></div><div class="dock-controls"><button class="model" type="button" data-model aria-label="操作設定"><span aria-hidden="true">操作設定</span><i>⌄</i></button><button class="mic" type="button" data-mic aria-label="音声入力"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="8" y="3" width="8" height="12" rx="4"></rect><path d="M5 11a7 7 0 0 0 14 0M12 18v3M8 21h8"></path></svg></button><button class="stop" type="button" data-stop aria-label="同期を停止"><i></i></button></div></section>
    </main>
    <div class="toast is-hidden" data-toast role="status"></div>
    <script is:inline>
      const toast = document.querySelector('[data-toast]'); let toastTimer;
      const showToast = (message) => { if (!toast) return; toast.textContent = message; toast.classList.remove('is-hidden'); clearTimeout(toastTimer); toastTimer = setTimeout(() => toast.classList.add('is-hidden'), 1800); };
      document.querySelectorAll('[data-state]').forEach((button) => button.addEventListener('click', () => { document.querySelectorAll('[data-state]').forEach((item) => { item.classList.toggle('is-active', item === button); item.setAttribute('aria-pressed', item === button ? 'true' : 'false'); }); showToast(`${button.textContent.trim()}を選択しました`); }));
      document.querySelector('[data-guide]')?.addEventListener('click', () => showToast('手順パネルを開く想定です')); document.querySelector('[data-command]')?.addEventListener('click', () => showToast('操作を検索（⌘K）')); document.querySelector('[data-feedback]')?.addEventListener('click', () => showToast('フィードバック依頼を作成しました')); document.querySelector('[data-save]')?.addEventListener('click', () => showToast('保存しました（チェック用）')); document.querySelector('[data-user]')?.addEventListener('click', () => showToast('上杉和輝 · 同期中')); document.querySelector('[data-model]')?.addEventListener('click', () => showToast('モデル選択を開く想定です')); document.querySelector('[data-mic]')?.addEventListener('click', () => showToast('音声入力を開始しました')); document.querySelector('[data-stop]')?.addEventListener('click', () => showToast('同期アニメーションを一時停止しました')); document.querySelector('[data-autosave]')?.addEventListener('change', (event) => showToast(event.target.checked ? '自動保存を有効にしました' : '自動保存を無効にしました')); document.querySelectorAll('[data-avatar]').forEach((button) => button.addEventListener('click', () => showToast(button.dataset.avatar)));
      const publish = document.querySelector('[data-publish]'); const presence = document.querySelector('[data-presence]'); const collab = document.querySelector('[data-collab]'); const dock = document.querySelector('[data-dock-label]'); const targets = document.querySelectorAll('.publish-status, .presence, .collab-live, .codex-dock'); const orbs = document.querySelectorAll('.orb'); let index = 0; const states = [{ publish: '自動公開: 接続済み', presence: '同期編集: 1人が接続中', collab: '同期編集: 1人が接続中', dock: '同期状態を確認しています…', active: false }, { publish: '自動公開: 同期中…', presence: '同期編集: 2人が接続中', collab: '同期編集: 2人が接続中', dock: 'リアルタイム同期中…', active: true }, { publish: '自動公開: 保存済み', presence: '同期編集: 1人が接続中', collab: '同期編集: 1人が接続中', dock: 'すべての変更を保存しました', active: false }, { publish: '自動公開: 再接続中…', presence: '同期編集: 接続を確認中', collab: '同期編集: 接続を確認中', dock: '接続を再確立しています…', active: true }];
      const setText = (node, value) => { if (!node) return; node.classList.remove('changing'); void node.offsetWidth; node.textContent = value; node.classList.add('changing'); setTimeout(() => node.classList.remove('changing'), 540); }; const tick = () => { const state = states[index % states.length]; index += 1; setText(publish, state.publish); setText(presence, state.presence); setText(collab, state.collab); setText(dock, state.dock); orbs.forEach((orb) => orb.classList.toggle('spinning', state.active)); targets.forEach((target) => target.classList.toggle('syncing', state.active)); }; tick(); setInterval(tick, 2400);
    </script>
  </body>
</html>

<style>
  :root { color-scheme: dark; --bg: #111213; --surface: #18191a; --surface-2: #1d1e20; --surface-3: #242528; --text: #e8e9ed; --muted: #9b9ea8; --faint: #686b75; --border: rgba(255,255,255,.09); --blue: #79a9ff; --violet: #a986ff; --green: #72d08d; --shadow: 0 18px 45px rgba(0,0,0,.28); }
  * { box-sizing: border-box; } body { margin: 0; min-width: 980px; background: var(--bg); color: var(--text); font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Hiragino Sans", "Yu Gothic", sans-serif; -webkit-font-smoothing: antialiased; }.codex-page { width: min(100% - 40px, 1540px); margin: 0 auto; padding: 14px 0 44px; }.crumb { display: flex; gap: 9px; align-items: center; margin: 0 0 12px; color: var(--faint); font-size: 11px; }.crumb a { color: var(--blue); text-decoration: none; }.editor-card { overflow: hidden; border: 1px solid var(--border); border-radius: 12px; background: var(--surface); box-shadow: var(--shadow); }.context-row, .status-row, .title-row, .action-row { display: flex; align-items: center; }.context-row { min-height: 82px; justify-content: space-between; gap: 16px; padding: 0 22px; border-bottom: 1px solid var(--border); }.workspace-context { display: flex; align-items: center; gap: 12px; min-width: 0; }.context-mark { width: 38px; height: 38px; display: grid; place-items: center; flex: 0 0 auto; border: 1px solid var(--border); border-radius: 9px; background: var(--surface-2); color: var(--muted); font-size: 16px; }.workspace-context div { display: grid; gap: 3px; min-width: 0; }.workspace-context div span { color: var(--faint); font-size: 12px; }.workspace-context strong { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 17px; font-weight: 650; }.context-actions { display: flex; gap: 8px; }.context-actions button, .quiet, .secondary, .primary, .history, .model, .mic { height: 36px; border: 1px solid var(--border); border-radius: 8px; background: transparent; color: var(--muted); cursor: pointer; font: inherit; font-size: 12px; }.context-actions button:first-child { padding: 0 12px; display: inline-flex; gap: 9px; align-items: center; }.context-actions button:first-child span { color: var(--faint); }.more { width: 38px; font-size: 16px !important; letter-spacing: 3px; }.context-actions button:hover, .quiet:hover, .secondary:hover, .history:hover, .model:hover, .mic:hover { background: var(--surface-3); color: var(--text); }
  .status-row { min-height: 72px; gap: 10px; padding: 14px 22px; border-bottom: 1px solid var(--border); }.segmented { display: inline-flex; overflow: hidden; flex: 0 0 auto; border: 1px solid var(--border); border-radius: 8px; }.segment { height: 38px; min-width: 112px; padding: 0 12px; display: inline-flex; align-items: center; justify-content: center; gap: 8px; border: 0; border-right: 1px solid var(--border); background: transparent; color: var(--muted); cursor: pointer; }.segment:last-child { border-right: 0; }.segment:hover, .segment.is-active { background: var(--surface-3); color: var(--text); }.segment small { color: var(--faint); font-size: 10px; }.segment strong { font-size: 14px; font-weight: 620; }.publish-status { min-height: 38px; padding: 0 12px; display: inline-flex; align-items: center; gap: 8px; border-radius: 8px; background: color-mix(in srgb, var(--green) 12%, var(--surface-2)); color: var(--green); font-size: 12px; white-space: nowrap; }.spacer { flex: 1; }.quiet, .secondary, .primary { padding: 0 12px; white-space: nowrap; }.quiet { color: var(--muted); }.check { display: inline-flex; align-items: center; gap: 8px; color: var(--muted); font-size: 12px; white-space: nowrap; cursor: pointer; }.check input { position: absolute; opacity: 0; }.check i { width: 16px; height: 16px; display: grid; place-items: center; border: 1px solid var(--border); border-radius: 4px; }.check input:checked + i { background: var(--blue); border-color: var(--blue); }.check input:checked + i::after { content: "✓"; color: #101114; font-size: 10px; font-weight: 800; }.select { position: relative; }.select select { appearance: none; height: 38px; min-width: 160px; padding: 0 28px 0 11px; border: 1px solid var(--border); border-radius: 8px; background: var(--surface-2); color: var(--muted); font: inherit; font-size: 12px; }.select.math select { min-width: 134px; }.select b { position: absolute; top: 9px; right: 10px; color: var(--faint); pointer-events: none; }.presence { min-height: 38px; padding: 0 10px; display: inline-flex; align-items: center; gap: 8px; border: 1px solid var(--border); border-radius: 8px; color: var(--muted); font-size: 12px; white-space: nowrap; }.presence button { padding-left: 9px; border: 0; border-left: 1px solid var(--border); background: transparent; color: var(--blue); cursor: pointer; font: inherit; font-size: 12px; font-weight: 620; }
  .title-row { min-height: 126px; justify-content: space-between; gap: 20px; padding: 22px; }.title-copy { display: grid; gap: 6px; min-width: 0; }.title-copy h1 { margin: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 25px; line-height: 1.3; font-weight: 650; letter-spacing: -.025em; }.title-copy span { color: var(--faint); font-size: 13px; }.title-copy em { color: var(--muted); font-style: normal; }.collab { display: flex; align-items: center; gap: 10px; color: var(--muted); white-space: nowrap; }.avatars { display: inline-flex; }.avatar { width: 32px; height: 32px; margin-left: -7px; display: grid; place-items: center; border: 2px solid var(--surface); border-radius: 50%; color: #fff; cursor: pointer; font-size: 10px; font-weight: 800; transition: transform 140ms ease; }.avatar:first-child { margin-left: 0; }.avatar:hover { z-index: 1; transform: translateY(-3px); }.uk { background: #4c7fac; }.ms { background: #a56753; }.kt { background: #78936b; }.history { height: auto; padding: 0; border: 0; color: var(--muted); font-size: 12px; }.history span { color: var(--faint); margin-left: 3px; }.divider { width: 1px; height: 17px; background: var(--border); }.collab-live { display: inline-flex; align-items: center; gap: 7px; }
  .action-row { min-height: 66px; align-items: flex-end; justify-content: space-between; gap: 16px; padding: 0 22px; border-top: 1px solid var(--border); }.tabs { display: flex; gap: 24px; }.tab { position: relative; height: 53px; padding: 0; border: 0; background: transparent; color: var(--faint); cursor: pointer; font: inherit; font-size: 13px; }.tab:hover, .tab.is-active { color: var(--text); }.tab.is-active::after { content: ""; position: absolute; right: 0; bottom: -1px; left: 0; height: 2px; background: var(--blue); }.tab span { color: var(--faint); margin-left: 3px; }.actions { display: flex; gap: 9px; padding-bottom: 11px; }.secondary { color: var(--muted); }.primary { border-color: var(--blue); background: var(--blue); color: #101114; font-weight: 650; }.primary:hover { filter: brightness(1.08); }
  .orb { position: relative; display: inline-block; width: 10px; height: 10px; flex: 0 0 auto; border: 2px solid color-mix(in srgb, var(--green) 35%, transparent); border-top-color: var(--green); border-radius: 50%; }.orb::after { content: ""; position: absolute; inset: -5px; border: 1px solid color-mix(in srgb, var(--blue) 30%, transparent); border-radius: 50%; opacity: 0; }.spinning { animation: spin .8s linear infinite; }.spinning::after { animation: ripple 1.2s ease-out infinite; }.syncing { color: var(--blue) !important; }.syncing .orb { border-color: color-mix(in srgb, var(--blue) 35%, transparent); border-top-color: var(--blue); }.syncing [data-publish], .syncing [data-presence], .syncing [data-collab] { background: linear-gradient(105deg, var(--blue) 10%, #cadcff 50%, var(--blue) 90%); background-size: 230% 100%; background-clip: text; -webkit-background-clip: text; color: transparent !important; animation: sweep 1.45s ease-in-out infinite; }.changing { animation: enter .54s cubic-bezier(.22,.8,.28,1) both; }
  .codex-dock { min-height: 94px; margin-top: 16px; padding: 0 18px 0 22px; display: flex; align-items: center; justify-content: space-between; gap: 16px; border: 1px solid rgba(255,255,255,.14); border-radius: 20px 20px 26px 26px; background: #202123; box-shadow: 0 14px 32px rgba(0,0,0,.35); }.dock-copy { display: grid; gap: 4px; min-width: 0; }.dock-kicker { color: #777a84; font-size: 10px; letter-spacing: .14em; }.dock-copy strong { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #d8dae0; font-size: 13px; font-weight: 560; }.dock-controls { display: flex; align-items: center; gap: 14px; }.model { height: 48px; padding: 0 15px; display: inline-flex; align-items: center; gap: 8px; border-color: transparent; color: #f0f1f4; font-size: 15px; }.model b { color: var(--violet); font-weight: 560; }.model i { color: #8e9199; font-style: normal; font-size: 18px; }.mic { width: 43px; height: 43px; display: grid; place-items: center; border-color: transparent; color: #eef0f4; }.mic svg { width: 23px; height: 23px; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.8; }.stop { width: 56px; height: 56px; display: grid; place-items: center; border: 0; border-radius: 50%; background: #f4f5f7; cursor: pointer; box-shadow: 0 0 0 1px rgba(255,255,255,.22); }.stop i { width: 17px; height: 17px; border-radius: 3px; background: #1d1e20; }.codex-dock.syncing .dock-copy strong { background: linear-gradient(105deg, #b9cfff 10%, #fff 50%, #b9cfff 90%); background-size: 220% 100%; background-clip: text; -webkit-background-clip: text; color: transparent; animation: sweep 1.45s ease-in-out infinite; }.toast { position: fixed; bottom: 22px; left: 50%; z-index: 4; padding: 9px 13px; transform: translateX(-50%); border: 1px solid var(--border); border-radius: 8px; background: var(--surface-2); color: var(--muted); font-size: 11px; box-shadow: var(--shadow); }.is-hidden { display: none !important; }
  @keyframes spin { to { transform: rotate(360deg); } } @keyframes ripple { 0% { opacity: .6; transform: scale(.7); } 100% { opacity: 0; transform: scale(1.45); } } @keyframes sweep { 0%, 100% { background-position: 100% 0; } 50% { background-position: 0 0; } } @keyframes enter { 0% { opacity: .3; transform: translateY(3px); } 100% { opacity: 1; transform: translateY(0); } }
  @media (max-width: 1180px) { .status-row { flex-wrap: wrap; }.spacer { display: none; }.title-row { align-items: flex-start; flex-direction: column; gap: 13px; }.collab { align-self: flex-start; } }
  @media (prefers-reduced-motion: reduce) { .spinning, .spinning::after, .changing, .syncing [data-publish], .syncing [data-presence], .syncing [data-collab], .codex-dock.syncing .dock-copy strong { animation: none; } }
</style>
