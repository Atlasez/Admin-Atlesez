---
const states = [
  { id: "draft", detail: "原稿", label: "下書き" },
  { id: "unpublished", detail: "公開", label: "未公開" },
];
---

<html lang="ja" data-theme="dark">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>編集ヘッダー範囲 | UIチェック</title></head>
  <body>
    <main class="focus-page">
      <section class="editor-card" aria-label="記事編集ワークスペース上部">
        <div class="hero-row">
          <div class="state-column"><div class="states" role="group" aria-label="記事状態">{states.map((state, index) => <button class:list={["state", index === 0 && "is-active"]} type="button" data-state={state.id} aria-pressed={index === 0 ? "true" : "false"}><span>{state.detail}</span><strong>{state.label}</strong></button>)}</div><div class="publish-status"><span></span><span>自動公開: 接続済み（Atlasez / Atlasez01）</span></div><h1>統計的機械学習の基礎: 確率モデルと正則化</h1></div>
          <div class="tools-column"><div class="tool-line"><button class="outline-button" type="button" data-guide>手順 <span>↗</span></button><label class="checkbox"><input type="checkbox" checked data-autosave /><i></i><span>下書きを自動保存</span></label><label class="select"><select aria-label="Webプレビュー形式"><option>Webプレビュー — 組版</option><option>Webプレビュー — 簡易</option></select><span>⌄</span></label><label class="select math"><select aria-label="数式エンジン"><option>KaTeX（高速）</option><option>MathJax</option></select><span>⌄</span></label><div class="presence"><b></b><span>同期編集: 1人が接続中</span><button type="button" data-user>上杉和輝</button></div><button class="theme-button" type="button" data-theme-toggle aria-label="テーマ切替">◐</button></div><div class="actions-line"><button class="secondary" type="button" data-feedback>フィードバックを依頼する</button><button class="secondary" type="button" data-review>フィードバック完了・公開審査へ</button><button class="primary" type="button" data-save>保存する</button><div class="sync-note"><i></i>共同編集の変更をリアルタイム同期しました。</div></div></div>
        </div>
      </section>
      <section class="settings-bar" aria-label="記事設定"><button class="disclosure" type="button" data-settings aria-expanded="false"><span>›</span><strong>記事設定</strong><small>数学 / 概要 / 日本語 / 下書き</small></button><button class="edit" type="button" data-edit>編集</button></section>
      <div class="settings-popover is-hidden" data-settings-panel><strong>記事設定</strong><p>分野・カテゴリ・言語・公開状態を確認できます。</p><button type="button" data-close-settings>閉じる</button></div>
    </main>
    <div class="toast is-hidden" data-toast role="status"></div>
    <script is:inline>
      const root = document.documentElement; const toast = document.querySelector('[data-toast]'); let timer;
      const notify = (message) => { toast.textContent = message; toast.classList.remove('is-hidden'); clearTimeout(timer); timer = setTimeout(() => toast.classList.add('is-hidden'), 1900); };
      document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => { const dark = root.dataset.theme === 'dark'; root.dataset.theme = dark ? 'light' : 'dark'; notify(dark ? 'ホワイトモードに切り替えました' : 'ダークモードに切り替えました'); });
      document.querySelectorAll('[data-state]').forEach((button) => button.addEventListener('click', () => { document.querySelectorAll('[data-state]').forEach((item) => { item.classList.toggle('is-active', item === button); item.setAttribute('aria-pressed', item === button ? 'true' : 'false'); }); notify(`${button.textContent.trim()}を選択しました`); }));
      document.querySelector('[data-autosave]')?.addEventListener('change', (event) => notify(event.target.checked ? '自動保存を有効にしました' : '自動保存を無効にしました'));
      document.querySelector('[data-guide]')?.addEventListener('click', () => notify('手順パネルを開く想定です')); document.querySelector('[data-feedback]')?.addEventListener('click', () => notify('フィードバック依頼を作成しました')); document.querySelector('[data-review]')?.addEventListener('click', () => notify('公開審査を開く想定です')); document.querySelector('[data-save]')?.addEventListener('click', () => notify('保存しました（チェック用）')); document.querySelector('[data-user]')?.addEventListener('click', () => notify('上杉和輝 · 同期中'));
      const panel = document.querySelector('[data-settings-panel]'); const settings = document.querySelector('[data-settings]'); settings?.addEventListener('click', () => { const open = panel.classList.toggle('is-hidden') === false; settings.setAttribute('aria-expanded', String(open)); settings.querySelector('span').classList.toggle('is-open', open); }); document.querySelector('[data-close-settings]')?.addEventListener('click', () => panel.classList.add('is-hidden')); document.querySelector('[data-edit]')?.addEventListener('click', () => notify('記事設定の編集を開く想定です'));
    </script>
  </body>
</html>

<style>
  :root { color-scheme: dark; --bg: #141414; --surface: #191a1a; --surface-2: #1d1e1e; --surface-3: #232424; --text: #ececea; --text-2: rgba(255,255,255,.68); --text-3: rgba(255,255,255,.43); --border: rgba(255,255,255,.09); --border-subtle: rgba(255,255,255,.055); --blue: #6ba6ff; --green: #72c98b; --shadow: 0 10px 26px rgba(0,0,0,.25); }
  :root[data-theme="light"] { color-scheme: light; --bg: #f3f3f0; --surface: #fff; --surface-2: #fafaf8; --surface-3: #f0f0ec; --text: #252623; --text-2: #62635d; --text-3: #92938d; --border: rgba(35,36,32,.12); --border-subtle: rgba(35,36,32,.07); --blue: #2b74c2; --green: #258a5a; --shadow: 0 10px 24px rgba(29,30,26,.08); }
  * { box-sizing: border-box; } body { margin: 0; min-width: 980px; background: var(--bg); color: var(--text); font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Hiragino Sans", "Yu Gothic", sans-serif; -webkit-font-smoothing: antialiased; }.focus-page { width: min(100% - 34px, 1540px); margin: 0 auto; padding: 12px 0 28px; }.editor-card,.settings-bar { border: 1px solid var(--border); background: var(--surface); border-radius: 9px; box-shadow: var(--shadow); }.editor-card { overflow: hidden; }.hero-row { min-height: 178px; padding: 13px 15px; display: grid; grid-template-columns: minmax(360px, 1fr) minmax(650px, 1.45fr); gap: 24px; }.state-column { min-width: 0; display: flex; flex-direction: column; align-items: flex-start; }.states { display: inline-flex; gap: 8px; }.state { height: 56px; min-width: 158px; padding: 0 13px; border: 1px solid var(--border); border-radius: 9px; display: inline-flex; align-items: center; justify-content: center; gap: 9px; background: transparent; color: var(--text-2); }.state span { border: 1px solid var(--border); border-radius: 999px; padding: 5px 8px; color: var(--text-3); font-size: 10px; }.state strong { font-size: 16px; font-weight: 650; }.state:hover,.state.is-active { background: var(--surface-3); color: var(--text); }.publish-status { width: min(100%, 410px); min-height: 37px; margin-top: 10px; padding: 0 10px; border-radius: 6px; background: color-mix(in srgb, var(--green) 18%, var(--surface-2)); color: var(--green); display: flex; align-items: center; gap: 7px; font-size: 11px; }.publish-status > span:first-child { width: 7px; height: 7px; border-radius: 50%; background: var(--green); }.state-column h1 { margin: 9px 0 0; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 18px; line-height: 1.25; font-weight: 640; letter-spacing: -.02em; }.tools-column { min-width: 0; display: flex; flex-direction: column; justify-content: flex-start; gap: 10px; padding-top: 2px; }.tool-line,.actions-line { display: flex; align-items: center; gap: 9px; min-width: 0; }.tool-line { min-height: 47px; }.outline-button,.secondary,.primary,.theme-button,.edit { height: 36px; border: 1px solid var(--border); border-radius: 6px; padding: 0 11px; background: transparent; color: var(--text-2); font-size: 12px; font-weight: 580; white-space: nowrap; }.outline-button:hover,.secondary:hover,.theme-button:hover,.edit:hover { background: var(--surface-3); color: var(--text); }.outline-button span { color: var(--text-3); margin-left: 5px; }.checkbox { display: inline-flex; align-items: center; gap: 7px; color: var(--text-2); font-size: 11px; white-space: nowrap; cursor: pointer; }.checkbox input { position: absolute; opacity: 0; }.checkbox i { width: 16px; height: 16px; border: 1px solid var(--border); border-radius: 4px; display: grid; place-items: center; }.checkbox input:checked + i { background: var(--blue); border-color: var(--blue); }.checkbox input:checked + i::after { content: "✓"; color: #fff; font-size: 10px; }.select { position: relative; }.select select { appearance: none; height: 36px; min-width: 166px; padding: 0 26px 0 10px; border: 1px solid var(--border); border-radius: 6px; background: var(--surface-2); color: var(--text-2); font-size: 11px; }.select > span { position: absolute; top: 9px; right: 9px; color: var(--text-3); pointer-events: none; }.select.math select { min-width: 128px; }.presence { height: 36px; padding: 0 9px; border: 1px solid var(--border); border-radius: 6px; display: inline-flex; align-items: center; gap: 7px; color: var(--text-2); font-size: 11px; white-space: nowrap; }.presence b,.sync-note i { width: 7px; height: 7px; background: var(--green); border-radius: 50%; }.presence button { color: var(--blue); border: 0; border-left: 1px solid var(--border); background: transparent; padding: 0 0 0 8px; font-weight: 620; font-size: 11px; cursor: pointer; }.theme-button { width: 34px; padding: 0; display: grid; place-items: center; }.actions-line { justify-content: flex-end; flex-wrap: wrap; }.actions-line .secondary { color: var(--text-2); }.primary { background: var(--blue); border-color: var(--blue); color: #fff; }.primary:hover { filter: brightness(1.08); }.sync-note { min-height: 36px; padding: 0 11px; border: 1px solid color-mix(in srgb, var(--blue) 65%, var(--border)); border-left: 3px solid var(--blue); border-radius: 6px; display: inline-flex; align-items: center; gap: 8px; color: var(--text-2); font-size: 11px; white-space: nowrap; }.sync-note i { background: var(--blue); }.settings-bar { min-height: 58px; margin-top: 10px; padding: 0 13px; display: flex; align-items: center; justify-content: space-between; }.disclosure { display: inline-flex; align-items: center; gap: 9px; border: 0; background: transparent; color: var(--text); }.disclosure > span { color: var(--blue); font-size: 23px; line-height: 1; transition: transform 120ms ease; }.disclosure > span.is-open { transform: rotate(90deg); }.disclosure strong { font-size: 14px; font-weight: 640; }.disclosure small { color: var(--text-2); font-size: 12px; }.edit { color: var(--blue); border-color: color-mix(in srgb, var(--blue) 55%, transparent); height: 32px; }.settings-popover { margin-top: 8px; padding: 14px; border: 1px solid var(--border); border-radius: 7px; background: var(--surface); box-shadow: var(--shadow); }.settings-popover strong { font-size: 12px; }.settings-popover p { margin: 6px 0 10px; color: var(--text-2); font-size: 11px; }.settings-popover button { height: 28px; border: 1px solid var(--border); border-radius: 5px; background: transparent; color: var(--text-2); font-size: 11px; padding: 0 9px; }.toast { position: fixed; left: 50%; bottom: 20px; transform: translateX(-50%); padding: 9px 13px; border: 1px solid var(--border); border-radius: 6px; background: var(--surface); box-shadow: var(--shadow); color: var(--text-2); font-size: 11px; }.is-hidden { display: none !important; }
  @media (max-width: 1180px) { .hero-row { grid-template-columns: 1fr; gap: 10px; }.tool-line { flex-wrap: wrap; }.actions-line { justify-content: flex-start; } }
</style>
