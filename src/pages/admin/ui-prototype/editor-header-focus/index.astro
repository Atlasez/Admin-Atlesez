---
const states = [
  { id: "draft", detail: "原稿", label: "下書き" },
  { id: "unpublished", detail: "公開", label: "未公開" },
];
---

<html lang="ja" data-theme="dark">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>編集ヘッダー範囲 | UIチェック</title></head>
  <body>
    <main class="focus-page">
      <section class="editor-card" aria-label="記事編集ワークスペース上部の独立プロトタイプ">
        <div class="context-row">
          <div class="workspace-context"><span class="context-mark" aria-hidden="true">文</span><div><span class="context-label">Atlas / mathematics</span><strong>統計的機械学習の基礎</strong></div></div>
          <div class="context-actions"><button class="command-button" type="button" data-command><span aria-hidden="true">⌘ K</span><span>操作を検索</span></button><button class="more-button" type="button" data-menu aria-label="その他の操作">•••</button></div>
        </div>
        <div class="status-row">
          <div class="segmented" role="group" aria-label="記事状態">{states.map((state, index) => <button class:list={["segment", index === 0 && "is-active"]} type="button" data-state={state.id} aria-pressed={index === 0 ? "true" : "false"}><span>{state.detail}</span><strong>{state.label}</strong></button>)}</div>
          <div class="publish-status"><i class="status-orb" aria-hidden="true"></i><span data-publish-label>自動公開: 接続済み（Atlasez / Atlasez01）</span></div>
          <div class="status-spacer"></div>
          <button class="utility-button" type="button" data-guide>手順 <span aria-hidden="true">↗</span></button>
          <label class="check-control"><input type="checkbox" checked data-autosave /><i aria-hidden="true"></i><span data-autosave-label>下書きを自動保存</span></label>
          <label class="select-control"><select aria-label="Webプレビュー形式"><option>Webプレビュー — 組版</option><option>Webプレビュー — 簡易</option></select><span aria-hidden="true">⌄</span></label>
          <label class="select-control math"><select aria-label="数式エンジン"><option>KaTeX（高速）</option><option>MathJax</option></select><span aria-hidden="true">⌄</span></label>
          <div class="presence"><i class="presence-orb" data-presence-orb aria-hidden="true"></i><span data-presence-label>同期編集: 1人が接続中</span><button type="button" data-user>上杉和輝</button></div>
          <button class="theme-button" type="button" data-theme-toggle aria-label="テーマ切替">◐</button>
        </div>
        <div class="title-row">
          <div class="title-copy"><h1>統計的機械学習の基礎: 確率モデルと正則化</h1><span>最終更新 2分前 · 下書き</span><span class="created-by">初回作成: <strong>上杉 和輝</strong> · 2026/09/02</span></div>
          <div class="collab"><div class="history-avatars" aria-label="編集履歴のメンバー"><button type="button" class="history-avatar avatar-uk" data-editor="上杉 和輝 · 初回作成">UK</button><button type="button" class="history-avatar avatar-ms" data-editor="三浦 さき · 3時間前に編集">MS</button><button type="button" class="history-avatar avatar-kt" data-editor="加藤 拓 · 昨日に編集">KT</button></div><button type="button" class="history-link" data-history>編集履歴 <span>3</span></button><span class="collab-separator" aria-hidden="true"></span><span class="collab-presence"><i class="presence-orb" aria-hidden="true"></i><span data-collab-label>同期編集: 1人が接続中</span></span></div>
        </div>
        <div class="action-row"><div class="tab-list" role="tablist" aria-label="表示範囲"><button class="tab is-active" type="button" role="tab" aria-selected="true">本文</button><button class="tab" type="button" role="tab" aria-selected="false">プレビュー</button><button class="tab" type="button" role="tab" aria-selected="false">コメント <span>3</span></button><button class="tab" type="button" role="tab" aria-selected="false">執筆メモ</button></div><div class="primary-actions"><button class="secondary-button" type="button" data-feedback>フィードバックを依頼</button><button class="primary-button" type="button" data-save>保存する</button></div></div>
      </section>
    </main>
    <div class="history-popover is-hidden" data-history-panel role="dialog" aria-label="編集履歴"><strong>編集履歴</strong><span>上杉 和輝 · 三浦 さき · 加藤 拓</span></div>
    <div class="menu-popover is-hidden" data-popover role="menu"><button type="button">ショートカット一覧</button><button type="button">変更履歴を見る</button></div>
    <div class="toast is-hidden" data-toast role="status"></div>
    <script is:inline>
      const root = document.documentElement; const toast = document.querySelector('[data-toast]'); let toastTimer;
      const showToast = (message) => { if (!toast) return; toast.textContent = message; toast.classList.remove('is-hidden'); clearTimeout(toastTimer); toastTimer = setTimeout(() => toast.classList.add('is-hidden'), 1900); };
      document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => { const dark = root.dataset.theme === 'dark'; root.dataset.theme = dark ? 'light' : 'dark'; showToast(dark ? 'ホワイトモードに切り替えました' : 'ダークモードに切り替えました'); });
      document.querySelectorAll('[data-state]').forEach((button) => button.addEventListener('click', () => { document.querySelectorAll('[data-state]').forEach((item) => { item.classList.toggle('is-active', item === button); item.setAttribute('aria-pressed', item === button ? 'true' : 'false'); }); showToast(`${button.textContent.trim()}を選択しました`); }));
      document.querySelector('[data-autosave]')?.addEventListener('change', (event) => showToast(event.target.checked ? '自動保存を有効にしました' : '自動保存を無効にしました'));
      document.querySelector('[data-guide]')?.addEventListener('click', () => showToast('手順パネルを開く想定です')); document.querySelector('[data-command]')?.addEventListener('click', () => showToast('操作を検索（⌘K）')); document.querySelector('[data-feedback]')?.addEventListener('click', () => showToast('フィードバック依頼を作成しました')); document.querySelector('[data-save]')?.addEventListener('click', () => showToast('保存しました（チェック用）')); document.querySelector('[data-user]')?.addEventListener('click', () => showToast('上杉和輝 · 同期中'));
      const popover = document.querySelector('[data-popover]'); document.querySelector('[data-menu]')?.addEventListener('click', () => popover?.classList.toggle('is-hidden')); document.addEventListener('click', (event) => { if (!(event.target instanceof Element)) return; if (!event.target.closest('[data-menu]') && !event.target.closest('[data-popover]')) popover?.classList.add('is-hidden'); });
      const historyPanel = document.querySelector('[data-history-panel]'); document.querySelector('[data-history]')?.addEventListener('click', () => historyPanel?.classList.toggle('is-hidden')); document.querySelectorAll('[data-editor]').forEach((avatar) => avatar.addEventListener('click', () => showToast(avatar.dataset.editor)));
      const publishLabel = document.querySelector('[data-publish-label]'); const presenceLabel = document.querySelector('[data-presence-label]'); const collabLabel = document.querySelector('[data-collab-label]'); const autosaveLabel = document.querySelector('[data-autosave-label]'); const syncTargets = [document.querySelector('.publish-status'), document.querySelector('.presence'), document.querySelector('.collab-presence')]; const orbs = document.querySelectorAll('.presence-orb, .status-orb'); let liveIndex = 0;
      const liveStates = [{ publish: '自動公開: 接続済み（Atlasez / Atlasez01）', presence: '同期編集: 1人が接続中', collab: '同期編集: 1人が接続中', active: false, tone: 'ready' }, { publish: '自動公開: 同期中…', presence: '同期編集: 2人が接続中', collab: '同期編集: 2人が接続中', active: true, tone: 'syncing' }, { publish: '自動公開: 保存済み', presence: '同期編集: 1人が接続中', collab: '同期編集: 1人が接続中', active: false, tone: 'saved' }, { publish: '自動公開: 再接続中…', presence: '同期編集: 接続を確認中', collab: '同期編集: 接続を確認中', active: true, tone: 'reconnecting' }];
      const animateLabel = (element, value) => { if (!element) return; element.classList.remove('is-changing'); void element.offsetWidth; element.textContent = value; element.classList.add('is-changing'); setTimeout(() => element.classList.remove('is-changing'), 620); };
      const tick = () => { const state = liveStates[liveIndex % liveStates.length]; liveIndex += 1; animateLabel(publishLabel, state.publish); animateLabel(presenceLabel, state.presence); animateLabel(collabLabel, state.collab); orbs.forEach((orb) => orb.classList.toggle('is-spinning', state.active)); syncTargets.forEach((target) => { target?.classList.toggle('is-syncing', state.active); target?.classList.toggle('is-reconnecting', state.tone === 'reconnecting'); target?.classList.toggle('is-saved', state.tone === 'saved'); }); if (autosaveLabel && document.querySelector('[data-autosave]')?.checked) animateLabel(autosaveLabel, state.active ? '自動保存: 同期中…' : '下書きを自動保存'); };
      tick(); setInterval(tick, 2400);
    </script>
  </body>
</html>

<style>
  :root { color-scheme: dark; --bg: #141414; --surface: #191a1a; --surface-2: #1d1e1e; --surface-3: #232424; --text: #ececea; --text-2: rgba(255,255,255,.68); --text-3: rgba(255,255,255,.43); --border: rgba(255,255,255,.09); --border-subtle: rgba(255,255,255,.055); --blue: #6ba6ff; --green: #72c98b; --shadow: 0 10px 26px rgba(0,0,0,.25); }
  :root[data-theme="light"] { color-scheme: light; --bg: #f3f3f0; --surface: #fff; --surface-2: #fafaf8; --surface-3: #f0f0ec; --text: #252623; --text-2: #62635d; --text-3: #92938d; --border: rgba(35,36,32,.12); --border-subtle: rgba(35,36,32,.07); --blue: #2b74c2; --green: #258a5a; --shadow: 0 10px 24px rgba(29,30,26,.08); }
  * { box-sizing: border-box; } body { margin: 0; min-width: 980px; background: var(--bg); color: var(--text); font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Hiragino Sans", "Yu Gothic", sans-serif; -webkit-font-smoothing: antialiased; }.focus-page { width: min(100% - 34px, 1540px); margin: 0 auto; padding: 12px 0 28px; }.editor-card,.settings-bar { border: 1px solid var(--border); background: var(--surface); border-radius: 9px; box-shadow: var(--shadow); }.editor-card { overflow: hidden; }.hero-row { min-height: 178px; padding: 13px 15px; display: grid; grid-template-columns: minmax(360px, 1fr) minmax(650px, 1.45fr); gap: 24px; }.state-column { min-width: 0; display: flex; flex-direction: column; align-items: flex-start; }.states { display: inline-flex; gap: 8px; }.state { height: 56px; min-width: 158px; padding: 0 13px; border: 1px solid var(--border); border-radius: 9px; display: inline-flex; align-items: center; justify-content: center; gap: 9px; background: transparent; color: var(--text-2); }.state span { border: 1px solid var(--border); border-radius: 999px; padding: 5px 8px; color: var(--text-3); font-size: 10px; }.state strong { font-size: 16px; font-weight: 650; }.state:hover,.state.is-active { background: var(--surface-3); color: var(--text); }.publish-status { width: min(100%, 410px); min-height: 37px; margin-top: 10px; padding: 0 10px; border-radius: 6px; background: color-mix(in srgb, var(--green) 18%, var(--surface-2)); color: var(--green); display: flex; align-items: center; gap: 7px; font-size: 11px; }.publish-status > span:first-child { width: 7px; height: 7px; border-radius: 50%; background: var(--green); }.state-column h1 { margin: 9px 0 0; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 18px; line-height: 1.25; font-weight: 640; letter-spacing: -.02em; }.tools-column { min-width: 0; display: flex; flex-direction: column; justify-content: flex-start; gap: 10px; padding-top: 2px; }.tool-line,.actions-line { display: flex; align-items: center; gap: 9px; min-width: 0; }.tool-line { min-height: 47px; }.outline-button,.secondary,.primary,.theme-button,.edit { height: 36px; border: 1px solid var(--border); border-radius: 6px; padding: 0 11px; background: transparent; color: var(--text-2); font-size: 12px; font-weight: 580; white-space: nowrap; }.outline-button:hover,.secondary:hover,.theme-button:hover,.edit:hover { background: var(--surface-3); color: var(--text); }.outline-button span { color: var(--text-3); margin-left: 5px; }.checkbox { display: inline-flex; align-items: center; gap: 7px; color: var(--text-2); font-size: 11px; white-space: nowrap; cursor: pointer; }.checkbox input { position: absolute; opacity: 0; }.checkbox i { width: 16px; height: 16px; border: 1px solid var(--border); border-radius: 4px; display: grid; place-items: center; }.checkbox input:checked + i { background: var(--blue); border-color: var(--blue); }.checkbox input:checked + i::after { content: "✓"; color: #fff; font-size: 10px; }.select { position: relative; }.select select { appearance: none; height: 36px; min-width: 166px; padding: 0 26px 0 10px; border: 1px solid var(--border); border-radius: 6px; background: var(--surface-2); color: var(--text-2); font-size: 11px; }.select > span { position: absolute; top: 9px; right: 9px; color: var(--text-3); pointer-events: none; }.select.math select { min-width: 128px; }.presence { height: 36px; padding: 0 9px; border: 1px solid var(--border); border-radius: 6px; display: inline-flex; align-items: center; gap: 7px; color: var(--text-2); font-size: 11px; white-space: nowrap; }.presence b,.sync-note i { width: 7px; height: 7px; background: var(--green); border-radius: 50%; }.presence button { color: var(--blue); border: 0; border-left: 1px solid var(--border); background: transparent; padding: 0 0 0 8px; font-weight: 620; font-size: 11px; cursor: pointer; }.theme-button { width: 34px; padding: 0; display: grid; place-items: center; }.actions-line { justify-content: flex-end; flex-wrap: wrap; }.actions-line .secondary { color: var(--text-2); }.primary { background: var(--blue); border-color: var(--blue); color: #fff; }.primary:hover { filter: brightness(1.08); }.sync-note { min-height: 36px; padding: 0 11px; border: 1px solid color-mix(in srgb, var(--blue) 65%, var(--border)); border-left: 3px solid var(--blue); border-radius: 6px; display: inline-flex; align-items: center; gap: 8px; color: var(--text-2); font-size: 11px; white-space: nowrap; }.sync-note i { background: var(--blue); }.settings-bar { min-height: 58px; margin-top: 10px; padding: 0 13px; display: flex; align-items: center; justify-content: space-between; }.disclosure { display: inline-flex; align-items: center; gap: 9px; border: 0; background: transparent; color: var(--text); }.disclosure > span { color: var(--blue); font-size: 23px; line-height: 1; transition: transform 120ms ease; }.disclosure > span.is-open { transform: rotate(90deg); }.disclosure strong { font-size: 14px; font-weight: 640; }.disclosure small { color: var(--text-2); font-size: 12px; }.edit { color: var(--blue); border-color: color-mix(in srgb, var(--blue) 55%, transparent); height: 32px; }.settings-popover { margin-top: 8px; padding: 14px; border: 1px solid var(--border); border-radius: 7px; background: var(--surface); box-shadow: var(--shadow); }.settings-popover strong { font-size: 12px; }.settings-popover p { margin: 6px 0 10px; color: var(--text-2); font-size: 11px; }.settings-popover button { height: 28px; border: 1px solid var(--border); border-radius: 5px; background: transparent; color: var(--text-2); font-size: 11px; padding: 0 9px; }.toast { position: fixed; left: 50%; bottom: 20px; transform: translateX(-50%); padding: 9px 13px; border: 1px solid var(--border); border-radius: 6px; background: var(--surface); box-shadow: var(--shadow); color: var(--text-2); font-size: 11px; }.is-hidden { display: none !important; }
  @media (max-width: 1180px) { .hero-row { grid-template-columns: 1fr; gap: 10px; }.tool-line { flex-wrap: wrap; }.actions-line { justify-content: flex-start; } }
</style>

<style>
  /* Standalone header-only check surface. No editor body, preview, comments, or memo panels are rendered. */
  :root { color-scheme: dark; --bg: #141515; --surface: #191a1a; --surface-2: #1d1e1e; --surface-3: #232424; --text: #e8e9e7; --text-2: rgba(255,255,255,.68); --text-3: rgba(255,255,255,.43); --border: rgba(255,255,255,.085); --border-subtle: rgba(255,255,255,.055); --blue: #72a8ff; --green: #72c98b; --yellow: #e8b84a; --shadow: 0 16px 34px rgba(0,0,0,.28); }
  :root[data-theme="light"] { color-scheme: light; --bg: #f4f4f1; --surface: #fff; --surface-2: #fafaf8; --surface-3: #f0f0ed; --text: #262724; --text-2: #656660; --text-3: #92938d; --border: rgba(35,36,32,.12); --border-subtle: rgba(35,36,32,.07); --blue: #2d73c0; --green: #258a5a; --yellow: #bd7715; --shadow: 0 10px 24px rgba(29,30,26,.08); }
  * { box-sizing: border-box; }
  body { margin: 0; min-width: 980px; background: var(--bg); color: var(--text); font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Hiragino Sans", "Yu Gothic", sans-serif; -webkit-font-smoothing: antialiased; }
  button, input, select { font: inherit; } button { color: inherit; cursor: pointer; }
  .focus-page { width: min(100% - 46px, 1680px); margin: 0 auto; padding: 12px 0 28px; }
  .editor-card { overflow: hidden; border: 1px solid var(--border); border-radius: 10px; background: var(--surface); box-shadow: var(--shadow); }
  .context-row { min-height: 86px; padding: 0 22px; display: flex; align-items: center; justify-content: space-between; gap: 18px; border-bottom: 1px solid var(--border-subtle); }
  .workspace-context { display: flex; align-items: center; gap: 12px; min-width: 0; }
  .context-mark { width: 36px; height: 36px; display: grid; place-items: center; flex: 0 0 auto; border: 1px solid var(--border); border-radius: 8px; background: var(--surface-3); color: var(--text-2); font-size: 15px; }
  .workspace-context div { display: grid; gap: 4px; min-width: 0; }
  .context-label { color: var(--text-3); font-size: 12px; }
  .workspace-context strong { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 17px; font-weight: 630; letter-spacing: -.015em; }
  .context-actions { display: flex; align-items: center; gap: 9px; flex: 0 0 auto; }
  .command-button, .more-button, .utility-button, .secondary-button, .primary-button { height: 36px; border: 1px solid var(--border); border-radius: 7px; background: transparent; white-space: nowrap; }
  .command-button { padding: 0 12px; display: inline-flex; align-items: center; gap: 9px; color: var(--text-2); font-size: 12px; }
  .command-button span:first-child { color: var(--text-3); font-size: 13px; letter-spacing: .03em; }
  .command-button:hover, .more-button:hover, .utility-button:hover, .secondary-button:hover, .theme-button:hover { background: var(--surface-3); color: var(--text); }
  .more-button { width: 38px; color: var(--text-2); font-size: 16px; letter-spacing: 3px; }
  .status-row { min-height: 72px; padding: 14px 22px; display: flex; align-items: center; gap: 11px; border-bottom: 1px solid var(--border-subtle); }
  .segmented { display: inline-flex; overflow: hidden; border: 1px solid var(--border); border-radius: 8px; flex: 0 0 auto; }
  .segment { height: 38px; min-width: 112px; padding: 0 13px; display: inline-flex; align-items: center; justify-content: center; gap: 8px; border: 0; border-right: 1px solid var(--border); background: transparent; color: var(--text-2); }
  .segment:last-child { border-right: 0; }.segment:hover, .segment.is-active { background: var(--surface-3); color: var(--text); }.segment span { color: var(--text-3); font-size: 11px; }.segment strong { font-size: 14px; font-weight: 620; }
  .publish-status { min-height: 38px; max-width: 420px; padding: 0 12px; display: inline-flex; align-items: center; gap: 8px; border-radius: 7px; background: color-mix(in srgb, var(--green) 14%, var(--surface-2)); color: var(--green); font-size: 12px; white-space: nowrap; }
  .status-spacer { flex: 1; min-width: 10px; }.utility-button, .secondary-button, .primary-button { padding: 0 12px; color: var(--text-2); font-size: 12px; font-weight: 580; }.utility-button { flex: 0 0 auto; }
  .check-control { display: inline-flex; align-items: center; gap: 8px; color: var(--text-2); font-size: 12px; white-space: nowrap; cursor: pointer; }.check-control input { position: absolute; opacity: 0; }.check-control i { width: 16px; height: 16px; display: grid; place-items: center; border: 1px solid var(--border); border-radius: 4px; }.check-control input:checked + i { border-color: var(--blue); background: var(--blue); }.check-control input:checked + i::after { content: "✓"; color: #fff; font-size: 10px; }
  .select-control { position: relative; flex: 0 0 auto; }.select-control select { appearance: none; height: 38px; min-width: 158px; padding: 0 29px 0 11px; border: 1px solid var(--border); border-radius: 7px; background: var(--surface-2); color: var(--text-2); font-size: 12px; }.select-control.math select { min-width: 136px; }.select-control > span { position: absolute; top: 9px; right: 10px; color: var(--text-3); pointer-events: none; }
  .presence, .collab-presence { display: inline-flex; align-items: center; gap: 8px; color: var(--text-2); font-size: 12px; white-space: nowrap; }.presence { height: 38px; padding: 0 10px; border: 1px solid var(--border); border-radius: 7px; }.presence button { padding: 0 0 0 9px; border: 0; border-left: 1px solid var(--border); background: transparent; color: var(--blue); font-size: 12px; font-weight: 620; }
  .theme-button { width: 38px; height: 38px; display: grid; place-items: center; padding: 0; border: 1px solid var(--border); border-radius: 7px; background: transparent; color: var(--text-2); }
  .title-row { min-height: 126px; padding: 22px; display: flex; align-items: center; justify-content: space-between; gap: 20px; }.title-copy { display: grid; gap: 6px; min-width: 0; }.title-copy h1 { margin: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 25px; line-height: 1.25; font-weight: 650; letter-spacing: -.025em; }.title-copy span { color: var(--text-3); font-size: 13px; }.created-by { font-size: 12px !important; }.created-by strong { color: var(--text-2); font-weight: 600; }
  .collab { display: flex; align-items: center; gap: 10px; color: var(--text-2); white-space: nowrap; }.history-avatars { display: inline-flex; align-items: center; }.history-avatar { width: 31px; height: 31px; margin-left: -7px; display: grid; place-items: center; border: 2px solid var(--surface); border-radius: 50%; color: #fff; font-size: 10px; font-weight: 700; transition: transform 150ms ease; }.history-avatar:first-child { margin-left: 0; }.history-avatar:hover { z-index: 1; transform: translateY(-3px); }.avatar-uk { background: #4e7dab; }.avatar-ms { background: #a76855; }.avatar-kt { background: #789368; }.history-link { padding: 0; border: 0; background: transparent; color: var(--text-2); font-size: 12px; }.history-link:hover { color: var(--text); }.history-link span { color: var(--text-3); margin-left: 3px; }.collab-separator { width: 1px; height: 17px; background: var(--border); }
