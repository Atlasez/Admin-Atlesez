---
import AdminLayout from "../../layouts/AdminLayout.astro";
---

<AdminLayout title="諸手続き" description="アトラス学習サイトの活動休止・退会手続き">
  <main class="procedures-page" data-procedures-page>
    <header class="procedures-heading">
      <div class="procedures-breadcrumb"><a href="/admin/atlas/">運営サイト</a><span aria-hidden="true">›</span><span>諸手続き</span></div>
      <div class="procedures-heading-row">
        <div>
          <h1>諸手続き</h1>
          <p class="lead">活動を一時的に休止したい場合や、アトラスを退会したい場合の申請を送信できます。</p>
        </div>
        <a class="back-link" href="/admin/atlas/">運営情報へ戻る <span aria-hidden="true">→</span></a>
      </div>
    </header>

    <section class="procedure-start" aria-label="申請の流れ">
      <div>
        <h2>必要な申請を選択</h2>
        <p>内容を入力して送信すると、運営が確認したうえで手続きを進めます。</p>
      </div>
      <ol class="procedure-steps">
        <li><b>1</b><span>申請内容を入力</span></li>
        <li><b>2</b><span>運営が確認</span></li>
        <li><b>3</b><span>結果をお知らせ</span></li>
      </ol>
    </section>

    <aside class="notice" role="note">
      <strong>申請について</strong>
      <span>ここで送信した内容は運営が確認してから反映されます。送信しただけでアカウントや記事が削除されることはありません。</span>
    </aside>

    <div class="procedure-grid">
      <section class="procedure-card" aria-labelledby="pause-heading">
        <div class="card-heading"><span class="card-icon card-icon--pause" aria-hidden="true">Ⅱ</span><div><h2 id="pause-heading">活動休止</h2></div></div>
        <p class="card-description">学業や仕事などの事情で、一定期間活動をお休みする申請です。再開予定が未定の場合は空欄にできます。</p>
        <form data-procedure-form="pause">
          <input type="hidden" name="type" value="pause" />
          <label>活動休止開始日<span class="required">必須</span><input name="effectiveFrom" type="date" required /></label>
          <label>活動再開予定日<span class="optional">任意</span><input name="effectiveUntil" type="date" /></label>
          <label>理由<span class="required">必須</span><select name="reason" required><option value="">選択してください</option><option>学業・試験</option><option>仕事・進路</option><option>健康上の都合</option><option>家庭の事情</option><option>その他</option></select></label>
          <label>運営への申し送り<span class="optional">任意</span><textarea name="note" rows="4" maxlength="2000" placeholder="担当中の記事や、連絡可能な時期など"></textarea></label>
          <button type="submit">活動休止を申請</button>
          <output data-form-message aria-live="polite"></output>
        </form>
      </section>

      <section class="procedure-card procedure-card--withdrawal" aria-labelledby="withdrawal-heading">
        <div class="card-heading"><span class="card-icon card-icon--withdrawal" aria-hidden="true">×</span><div><h2 id="withdrawal-heading">退会</h2></div></div>
        <p class="card-description">アトラスでの活動を終了する申請です。運営が確認し、必要な引き継ぎを行ってから退会処理を進めます。</p>
        <form data-procedure-form="withdrawal">
          <input type="hidden" name="type" value="withdrawal" />
          <label>退会希望日<span class="required">必須</span><input name="effectiveFrom" type="date" required /></label>
          <label>理由<span class="required">必須</span><select name="reason" required><option value="">選択してください</option><option>活動方針の変更</option><option>学業・仕事の都合</option><option>健康上の都合</option><option>その他</option></select></label>
          <label>運営への申し送り<span class="optional">任意</span><textarea name="note" rows="4" maxlength="2000" placeholder="担当中の記事や引き継ぎに関するメモ"></textarea></label>
          <label class="confirm"><input name="confirm" type="checkbox" required /><span>退会申請であることを確認しました</span></label>
          <button class="danger-button" type="submit">退会を申請</button>
          <output data-form-message aria-live="polite"></output>
        </form>
      </section>
    </div>

    <section class="history" aria-labelledby="history-heading">
      <div class="history-heading"><div><h2 id="history-heading">過去の申請</h2></div><span>最新20件</span></div>
      <div data-history><p class="empty">申請履歴を読み込んでいます…</p></div>
    </section>
  </main>
</AdminLayout>

<style>
  .procedures-page{margin:0 auto;max-width:1050px;padding:0 1.25rem 4rem;color:var(--text-primary)}
  .page-heading{align-items:end;border-bottom:1px solid var(--border-default);display:flex;gap:1rem;justify-content:space-between;padding:2rem 0 1.35rem}
  .eyebrow,.card-kicker{color:var(--accent-primary);font-size:.7rem;font-weight:800;letter-spacing:.11em;margin:0}
  .page-heading h1{font-size:clamp(2rem,4vw,2.7rem);margin:.25rem 0 .5rem}.lead{color:var(--text-secondary);line-height:1.7;margin:0;max-width:48rem}.back-link{color:var(--accent-primary);font-size:.82rem;font-weight:800;text-decoration:none;white-space:nowrap}.notice{background:color-mix(in srgb,var(--accent-primary) 8%,var(--background-secondary));border-left:3px solid var(--accent-primary);display:grid;gap:.25rem;margin:1.2rem 0;padding:.8rem 1rem}.notice span{color:var(--text-secondary);font-size:.85rem;line-height:1.65}.procedure-grid{display:grid;gap:1rem;grid-template-columns:repeat(2,minmax(0,1fr))}.procedure-card{background:var(--background-secondary);border:1px solid var(--border-default);display:grid;gap:1rem;padding:1.15rem}.procedure-card--withdrawal{border-top:2px solid #d26767}.card-heading{align-items:center;display:flex;gap:.75rem}.card-heading h2{font-size:1.35rem;margin:.15rem 0 0}.card-icon{align-items:center;border:1px solid var(--border-default);border-radius:50%;display:inline-flex;font-size:1rem;font-weight:800;height:2.2rem;justify-content:center;width:2.2rem}.card-icon--pause{color:#e8b84a}.card-icon--withdrawal{color:#e27676}.card-description{color:var(--text-secondary);font-size:.88rem;line-height:1.7;margin:0;min-height:3.1em}form{display:grid;gap:.75rem}label{display:grid;gap:.35rem;font-size:.8rem;font-weight:700}label input:not([type="checkbox"]),label select,label textarea{background:var(--background-primary);border:1px solid var(--border-default);border-radius:.25rem;color:var(--text-primary);font:inherit;padding:.58rem .65rem;width:100%}label textarea{line-height:1.55;resize:vertical}.required,.optional{color:var(--text-secondary);font-size:.68rem;font-weight:500;margin-left:.45rem}.required{color:#e8b84a}.confirm{align-items:center;display:flex;gap:.5rem;margin-top:.15rem}.confirm input{accent-color:var(--accent-primary);height:1rem;width:1rem}.confirm span{font-size:.78rem;font-weight:600}button{background:var(--accent-primary);border:1px solid var(--accent-primary);border-radius:.25rem;color:#fff;cursor:pointer;font:inherit;font-size:.82rem;font-weight:800;padding:.65rem .85rem}button:hover{filter:brightness(1.08)}.danger-button{background:#9f4d56;border-color:#9f4d56}output{color:var(--text-secondary);font-size:.8rem;min-height:1.2em}.history{border-top:1px solid var(--border-default);margin-top:2rem;padding-top:1.1rem}.history-heading{align-items:end;display:flex;justify-content:space-between}.history-heading h2{font-size:1.25rem;margin:.2rem 0 0}.history-heading>span{color:var(--text-muted);font-size:.75rem}.history-list{display:grid;gap:.45rem;margin-top:.8rem}.history-row{align-items:center;background:var(--background-secondary);border:1px solid var(--border-subtle,var(--border-default));display:grid;gap:.7rem;grid-template-columns:6.5rem 1fr auto;padding:.7rem .8rem}.history-type{font-size:.78rem;font-weight:800}.history-type--pause{color:#e8b84a}.history-type--withdrawal{color:#e27676}.history-detail{color:var(--text-secondary);font-size:.8rem}.history-status{border:1px solid var(--border-default);border-radius:999px;color:var(--text-secondary);font-size:.7rem;padding:.2rem .5rem}.empty{color:var(--text-muted);font-size:.82rem}.error{color:#e27676}
  @media(max-width:760px){.procedures-page{padding:0 .8rem 3rem}.page-heading{align-items:start;display:grid}.back-link{justify-self:start}.procedure-grid{grid-template-columns:1fr}.history-row{grid-template-columns:1fr auto}.history-detail{grid-column:1/-1;grid-row:2}}
</style>

<style is:global>
  .procedures-page {
    max-width: 1180px;
    padding: 0 1.25rem 3rem;
  }

  .procedures-page .procedures-heading {
    border-bottom: 1px solid var(--border-default);
    padding: 0.6rem 0 1rem;
  }

  .procedures-page .procedures-breadcrumb {
    align-items: center;
    color: var(--text-secondary);
    display: flex;
    font-size: 0.72rem;
    gap: 0.45rem;
    margin-bottom: 1rem;
  }

  .procedures-page .procedures-breadcrumb a {
    color: var(--accent-primary);
    text-decoration: none;
  }

  .procedures-page .procedures-heading-row {
    align-items: flex-end;
    display: flex;
    gap: 1rem;
    justify-content: space-between;
  }

  .procedures-page .procedures-heading h1 {
    font-size: clamp(1.65rem, 3vw, 2.2rem);
    line-height: 1.15;
    margin: 0 0 0.25rem;
  }

  .procedures-page .lead {
    font-size: 0.86rem;
    line-height: 1.55;
  }

  .procedures-page .back-link {
    align-items: center;
    border: 1px solid var(--border-default);
    border-radius: 0.35rem;
    display: inline-flex;
    gap: 0.45rem;
    min-height: 2.25rem;
    padding: 0 0.75rem;
  }

  .procedures-page .back-link:hover {
    background: var(--background-secondary);
    border-color: var(--accent-primary);
  }

  .procedures-page .procedure-start {
    align-items: center;
    border-bottom: 1px solid var(--border-default);
    display: grid;
    gap: 1rem;
    grid-template-columns: minmax(13rem, 0.75fr) minmax(0, 2fr);
    padding: 1rem 0 1.1rem;
  }

  .procedures-page .procedure-start h2 {
    font-size: 1rem;
    margin: 0 0 0.25rem;
  }

  .procedures-page .procedure-start p {
    color: var(--text-secondary);
    font-size: 0.78rem;
    line-height: 1.5;
    margin: 0;
  }

  .procedures-page .procedure-steps {
    display: grid;
    gap: 0.5rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .procedures-page .procedure-steps li {
    align-items: center;
    background: var(--background-secondary);
    border: 1px solid var(--border-default);
    border-radius: 0.35rem;
    display: flex;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.45rem 0.55rem;
    position: relative;
  }

  .procedures-page .procedure-steps li:not(:last-child)::after {
    color: var(--accent-primary);
    content: "→";
    font-size: 0.9rem;
    position: absolute;
    right: -0.55rem;
    z-index: 1;
  }

  .procedures-page .procedure-steps b {
    align-items: center;
    background: color-mix(in srgb, var(--accent-primary) 13%, transparent);
    border-radius: 50%;
    color: var(--accent-primary);
    display: inline-flex;
    flex: 0 0 auto;
    font-size: 0.7rem;
    height: 1.35rem;
    justify-content: center;
    width: 1.35rem;
  }

  .procedures-page .procedure-steps span {
    font-size: 0.75rem;
    font-weight: 700;
  }

  .procedures-page .notice {
    margin: 1rem 0;
  }

  .procedures-page .procedure-grid {
    gap: 0.8rem;
  }

  .procedures-page .procedure-card {
    background: var(--background-primary);
    border-radius: 0.45rem;
    gap: 0.85rem;
    padding: 1rem;
  }

  .procedures-page .procedure-card--withdrawal {
    border-left: 2px solid #e27676;
    border-top: 1px solid var(--border-default);
  }

  .procedures-page .card-heading {
    gap: 0.65rem;
  }

  .procedures-page .card-heading h2 {
    font-size: 1.15rem;
    margin: 0;
  }

  .procedures-page .card-description {
    font-size: 0.82rem;
    line-height: 1.6;
    min-height: 0;
  }

  .procedures-page form {
    gap: 0.65rem;
  }

  .procedures-page form label {
    font-size: 0.78rem;
  }

  .procedures-page .history {
    margin-top: 1.5rem;
    padding-top: 1rem;
  }

  .procedures-page .history-heading h2 {
    font-size: 1.1rem;
    margin: 0;
  }

  @media (max-width: 880px) {
    .procedures-page .procedure-start {
      grid-template-columns: 1fr;
    }

    .procedures-page .procedure-steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .procedures-page {
      padding-inline: 0.85rem;
    }

    .procedures-page .procedures-heading-row {
      align-items: flex-start;
      flex-direction: column;
    }

    .procedures-page .back-link {
      align-self: flex-start;
    }

    .procedures-page .procedure-grid {
      grid-template-columns: 1fr;
    }

    .procedures-page .procedure-steps li:not(:last-child)::after {
      display: none;
    }
  }

  @media (max-width: 520px) {
    .procedures-page .procedure-steps {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
import { readAdminApiJson } from "../../lib/admin-api";

type ProcedureRequest = { procedure_type: "pause" | "withdrawal"; effective_from: string; effective_until?: string; reason: string; status: string; created_at: string };
type ProcedureResponse = { requests?: ProcedureRequest[]; request?: ProcedureRequest; error?: string };

const initialize = () => {
  const root = document.querySelector<HTMLElement>("[data-procedures-page]");
  if (!root || root.dataset.ready) return;
  root.dataset.ready = "true";
  const history = root.querySelector<HTMLElement>("[data-history]")!;
  const statusLabel: Record<string, string> = { pending: "運営確認待ち", reviewing: "確認中", completed: "処理済み", cancelled: "取り下げ" };
  const escapeHtml = (value: unknown) => String(value ?? "").replace(/[&<>\"']/g, (character) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[character] ?? character);
  const renderHistory = (requests: ProcedureRequest[]) => {
    if (!requests.length) { history.innerHTML = '<p class="empty">まだ申請履歴はありません。</p>'; return; }
    history.innerHTML = `<div class="history-list">${requests.map((item) => { const type = item.procedure_type === "pause" ? "活動休止" : "退会"; const date = item.effective_until ? `${item.effective_from}〜${item.effective_until}` : item.effective_from; return `<div class="history-row"><span class="history-type history-type--${item.procedure_type}">${type}</span><span class="history-detail">${escapeHtml(date)} ・ ${escapeHtml(item.reason)}</span><span class="history-status">${escapeHtml(statusLabel[item.status] ?? item.status)}</span></div>`; }).join("")}</div>`;
  };
  const load = async () => { try { const response = await fetch("/api/admin/member-procedures?project=atlas", { credentials: "same-origin", cache: "no-store" }); const data = await readAdminApiJson<ProcedureResponse>(response, "申請履歴を読み込めませんでした。"); if (!response.ok) throw new Error(data.error); renderHistory(data.requests ?? []); } catch (error) { history.innerHTML = `<p class="error">${error instanceof Error ? error.message : "申請履歴を読み込めませんでした。"}</p>`; } };
  root.querySelectorAll<HTMLFormElement>("[data-procedure-form]").forEach((form) => { form.addEventListener("submit", async (event) => { event.preventDefault(); const button = form.querySelector<HTMLButtonElement>("button"); const output = form.querySelector<HTMLOutputElement>("[data-form-message]")!; const values = Object.fromEntries(new FormData(form).entries()); const payload = { type: values.type, effectiveFrom: values.effectiveFrom, effectiveUntil: values.effectiveUntil ?? "", reason: values.reason, note: values.note ?? "", confirm: form.querySelector<HTMLInputElement>("[name=confirm]")?.checked ?? false }; button!.disabled = true; output.textContent = "送信しています…"; try { const response = await fetch("/api/admin/member-procedures?project=atlas", { method: "POST", credentials: "same-origin", headers: { "content-type": "application/json" }, body: JSON.stringify(payload) }); const data = await readAdminApiJson<ProcedureResponse>(response, "申請を送信できませんでした。"); if (!response.ok) throw new Error(data.error); output.textContent = "申請を受け付けました。運営の確認をお待ちください。"; form.reset(); await load(); } catch (error) { output.textContent = error instanceof Error ? error.message : "申請を送信できませんでした。"; } finally { button!.disabled = false; } }); });
  void load();
};
document.addEventListener("astro:page-load", initialize); initialize();
</script>
