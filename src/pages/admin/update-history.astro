---
import AdminLayout from "../../layouts/AdminLayout.astro";
import AdminRetryNotice from "../../components/admin/AdminRetryNotice.astro";
---

<AdminLayout title="アップデート履歴" description="運営サイトの更新履歴">
  <main class="update-history" data-update-history data-admin-load-surface aria-busy="true">
    <header class="page-heading"><div><h1>アップデート履歴</h1></div><a href="/admin/atlas/">← 管理トップ</a></header>
    <section class="history-summary" aria-label="更新履歴の概要">
      <div><span>掲載件数</span><strong data-summary-total>—</strong></div>
      <div><span>機能追加</span><strong data-summary-features>—</strong></div>
      <div><span>改善・運用</span><strong data-summary-improvements>—</strong></div>
      <div><span>最終更新</span><strong data-summary-latest>—</strong></div>
    </section>
    <section class="history-panel" aria-labelledby="history-list-heading">
      <div class="panel-heading"><h2 id="history-list-heading">変更内容</h2><output data-result-count aria-live="polite">読み込み中</output></div>
      <form class="history-filters" data-history-filters role="search">
        <label class="search-field">キーワード<input type="search" name="q" placeholder="変更内容・バージョンを検索" autocomplete="off" /></label>
        <label>種別<select name="kind"><option value="all">すべての種別</option></select></label>
        <label>対象<select name="project"><option value="all">全プロジェクト</option></select></label>
        <button type="reset" class="reset-button">条件をリセット</button>
      </form>
      <div class="history-list" data-history-list aria-live="polite">
        <div class="history-skeleton" data-admin-load-skeleton aria-hidden="true">
          {Array.from({ length: 6 }, () => <div class="history-skeleton-row"><i class="skeleton-date"></i><i class="skeleton-icon"></i><span class="skeleton-copy"><i></i><i></i></span><i class="skeleton-kind"></i><i class="skeleton-project"></i><i class="skeleton-chevron"></i></div>)}
        </div>
      </div>
      <AdminRetryNotice message="アップデート履歴を読み込めませんでした。" />
      <div class="history-pagination" data-history-pagination hidden>
        <span data-history-pagination-summary>30件を表示中</span>
        <button type="button" data-history-load-more>さらに読み込む</button>
      </div>
    </section>
    <dialog class="history-dialog" data-history-dialog aria-labelledby="history-dialog-title">
      <form method="dialog" class="dialog-close-form"><button class="dialog-close" aria-label="詳細を閉じる">×</button></form>
      <p class="dialog-kicker" data-dialog-version></p><h2 id="history-dialog-title" data-dialog-title>更新内容</h2>
      <dl class="dialog-meta"><div><dt>日付</dt><dd data-dialog-date>—</dd></div><div><dt>種別</dt><dd data-dialog-kind>—</dd></div><div><dt>対象</dt><dd data-dialog-project>—</dd></div><div><dt>担当</dt><dd data-dialog-author>—</dd></div></dl>
      <p class="dialog-summary" data-dialog-summary></p><div class="dialog-actions"><a class="dialog-link" data-dialog-link hidden>関連画面を開く →</a><button type="submit" class="dialog-secondary">閉じる</button></div>
    </dialog>
  </main>
</AdminLayout>

<script>
  import { createAdminLoadRetry } from "../../scripts/admin-load-retry";

  const initializeUpdateHistory = () => {
    const root = document.querySelector<HTMLElement>("[data-update-history]");
    if (!root || root.dataset.initialized === "true") return;
    root.dataset.initialized = "true";
    const pageRoot = root;
    const form = root.querySelector<HTMLFormElement>("[data-history-filters]")!;
    let rows = [...root.querySelectorAll<HTMLButtonElement>("[data-history-row]")];
    const list = root.querySelector<HTMLElement>("[data-history-list]")!;
    const count = root.querySelector<HTMLOutputElement>("[data-result-count]")!;
    const dialog = root.querySelector<HTMLDialogElement>("[data-history-dialog]")!;
    const pagination = root.querySelector<HTMLElement>("[data-history-pagination]")!;
    const loadMore = root.querySelector<HTMLButtonElement>("[data-history-load-more]")!;
    const paginationSummary = root.querySelector<HTMLElement>("[data-history-pagination-summary]")!;
    const value = (selector: string) => root.querySelector<HTMLElement>(selector)!;
    const escape = (value: unknown) => String(value ?? "").replace(/[&<>\'"]/g, (character) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", "'": "&#39;", '"': "&quot;" }[character] ?? character));
    const openRow = (row: HTMLButtonElement) => { value("[data-dialog-version]").textContent = `${row.dataset.version} · ${row.dataset.date?.replaceAll("-", "/") ?? ""}`; value("[data-dialog-title]").textContent = row.dataset.title ?? "更新内容"; value("[data-dialog-date]").textContent = row.dataset.date?.replaceAll("-", "/") ?? "—"; value("[data-dialog-kind]").textContent = row.dataset.kind ?? "—"; value("[data-dialog-project]").textContent = row.dataset.project ?? "—"; value("[data-dialog-author]").textContent = row.dataset.author ?? "—"; value("[data-dialog-summary]").textContent = row.dataset.summary ?? ""; const link = root.querySelector<HTMLAnchorElement>("[data-dialog-link]")!; link.hidden = !row.dataset.href; if (row.dataset.href) link.href = row.dataset.href; if (typeof dialog.showModal === "function") dialog.showModal(); };
    const bindRows = () => { rows = [...root.querySelectorAll<HTMLButtonElement>("[data-history-row]")]; rows.forEach((row) => row.addEventListener("click", () => openRow(row))); };
    const entryMarkup = (entry: Record<string, unknown>) => `<button class="history-row" type="button" data-history-row data-kind="${escape(entry.kind)}" data-project="${escape(entry.project)}" data-search="${escape(`${entry.version ?? ""} ${entry.title ?? ""} ${entry.summary ?? ""} ${entry.project ?? ""} ${entry.author ?? ""}`)}" data-version="${escape(entry.version)}" data-date="${escape(entry.date)}" data-title="${escape(entry.title)}" data-summary="${escape(entry.summary)}" data-author="${escape(entry.author)}" data-href="${escape(entry.href)}"><time datetime="${escape(entry.date)}">${escape(String(entry.date ?? "").replaceAll("-", "/"))}<small>${escape(entry.version)}</small></time><span class="history-icon ${escape(entry.tone)}" aria-hidden="true">↗</span><span class="history-copy"><strong>${escape(entry.title)}</strong><small>${escape(entry.summary)}</small></span><span class="history-kind ${escape(entry.tone)}">${escape(entry.kind)}</span><span class="history-project">${escape(entry.project)}</span><span class="row-chevron" aria-hidden="true">›</span></button>`;
    const renderEntries = (entries: Array<Record<string, unknown>>, replace: boolean) => {
      const empty = root.querySelector<HTMLElement>("[data-empty-state]");
      if (replace) list.innerHTML = `${entries.map(entryMarkup).join("")}<p class="empty-state" data-empty-state data-admin-empty-state hidden>条件に一致する更新履歴はありません。</p>`;
      else if (empty) empty.insertAdjacentHTML("beforebegin", entries.map(entryMarkup).join(""));
      bindRows();
      filter();
    };
    const filter = () => {
      const data = new FormData(form);
      const query = String(data.get("q") ?? "").trim().toLocaleLowerCase("ja-JP");
      const kind = String(data.get("kind") ?? "all");
      const project = String(data.get("project") ?? "all");
      let visible = 0;
      rows.forEach((row) => { const matches = (!query || String(row.dataset.search).toLocaleLowerCase("ja-JP").includes(query)) && (kind === "all" || row.dataset.kind === kind) && (project === "all" || row.dataset.project === project); row.hidden = !matches; if (matches) visible += 1; });
      if (root.getAttribute("aria-busy") !== "true") {
        count.value = `${visible}件`;
      }
      const empty = root.querySelector<HTMLElement>("[data-empty-state]");
      if (empty) empty.hidden = visible !== 0;
    };
    form.addEventListener("input", filter); form.addEventListener("change", filter); form.addEventListener("reset", () => requestAnimationFrame(filter));
    bindRows();
    filter();
    let page = 1;
    let loadedCount = 0;
    let allEntries: Array<Record<string, unknown>> = [];
    let hasMore = false;
    let loading = false;
    const retryController = createAdminLoadRetry(root, () => loadPage(true), "アップデート履歴を読み込めませんでした。");
    const loadPage = async (replace: boolean) => {
      if (loading || (!replace && !hasMore)) return;
      loading = true;
      if (replace) {
        page = 1;
        retryController.begin();
      }
      loadMore.disabled = true;
      if (!replace) loadMore.textContent = "読み込み中…";
      try {
        const response = await fetch(`/api/admin/update-history?limit=30&page=${page}`, { credentials: "same-origin", cache: "no-store" });
        const data = await response.json().catch(() => ({})) as { entries?: Array<Record<string, unknown>>; pagination?: { hasMore?: boolean; nextPage?: number | null } };
        if (!response.ok) throw new Error(String((data as { error?: string }).error || "アップデート履歴を読み込めませんでした。"));
        const entries = Array.isArray(data.entries) ? data.entries : [];
        if (replace || entries.length) {
          allEntries = replace ? entries : [...allEntries, ...entries];
          renderEntries(entries, replace);
          loadedCount = replace ? entries.length : loadedCount + entries.length;
          updateSummary(allEntries);
        }
        hasMore = Boolean(data.pagination?.hasMore);
        page = Number(data.pagination?.nextPage ?? page + 1);
        pagination.hidden = !hasMore;
        if (hasMore) pagination.style.removeProperty("display");
        else pagination.style.setProperty("display", "none", "important");
        paginationSummary.textContent = `${loadedCount}件を表示中`;
        loadMore.textContent = "さらに読み込む";
        retryController.success();
        filter();
      } catch (error) {
        retryController.fail(error);
        count.value = "取得できません";
      } finally {
        loading = false;
        loadMore.disabled = !hasMore;
        if (!hasMore) {
          pagination.hidden = true;
          pagination.style.setProperty("display", "none", "important");
        }
      }
    };
    loadMore.addEventListener("click", () => void loadPage(false));
    void loadPage(true);
    function updateSummary(entries: Array<Record<string, unknown>>) {
      const kindSelect = form.elements.namedItem("kind") as HTMLSelectElement | null;
      const projectSelect = form.elements.namedItem("project") as HTMLSelectElement | null;
      const ensureOptions = (select: HTMLSelectElement | null, key: "kind" | "project") => {
        if (!select) return;
        const known = new Set([...select.options].map((option) => option.value));
        entries.map((entry) => String(entry[key] ?? "")).filter(Boolean).forEach((optionValue) => {
          if (known.has(optionValue)) return;
          select.add(new Option(optionValue, optionValue));
        });
      };
      ensureOptions(kindSelect, "kind");
      ensureOptions(projectSelect, "project");
      const featureCount = entries.filter((entry) => entry.kind === "機能追加").length;
      const improvementCount = entries.filter((entry) => entry.kind === "改善" || entry.kind === "運用").length;
      pageRoot.querySelector<HTMLElement>("[data-summary-total]")!.textContent = String(entries.length);
      pageRoot.querySelector<HTMLElement>("[data-summary-features]")!.textContent = String(featureCount);
      pageRoot.querySelector<HTMLElement>("[data-summary-improvements]")!.textContent = String(improvementCount);
      pageRoot.querySelector<HTMLElement>("[data-summary-latest]")!.textContent = String(entries[0]?.date ?? "—").replaceAll("-", "/");
    }
  };
  document.addEventListener("astro:page-load", initializeUpdateHistory); initializeUpdateHistory();
</script>

<style>
.update-history{margin:0 auto;max-width:1120px;padding:0 1.25rem 4rem}.page-heading{align-items:end;border-bottom:1px solid var(--border-default);display:flex;gap:1rem;justify-content:space-between;padding:2rem 0 1.25rem}.page-heading h1{font-size:clamp(1.8rem,4vw,2.5rem);margin:0}.page-heading>a{color:var(--accent-primary);font-size:.8rem;font-weight:800;text-decoration:none;white-space:nowrap}.history-summary{display:grid;gap:.7rem;grid-template-columns:repeat(4,minmax(0,1fr));margin:1.15rem 0}.history-summary>div{background:var(--background-secondary);border:1px solid var(--border-default);display:grid;gap:.25rem;padding:.8rem}.history-summary span{color:var(--text-secondary);font-size:.72rem}.history-summary strong{font-size:1.25rem;font-variant-numeric:tabular-nums}.history-panel{border:1px solid var(--border-default);padding:1rem}.panel-heading{align-items:center;border-bottom:1px solid var(--border-default);display:flex;justify-content:space-between;padding-bottom:.7rem}.panel-heading h2{font-size:1.1rem;margin:0}.panel-heading output{color:var(--text-secondary);font-size:.75rem}.history-filters{align-items:end;display:grid;gap:.6rem;grid-template-columns:minmax(14rem,1fr) 10rem 12rem auto;padding:1rem 0}.history-filters label{color:var(--text-secondary);display:grid;font-size:.72rem;font-weight:800;gap:.3rem}.history-filters input,.history-filters select{background:var(--background-primary);border:1px solid var(--border-default);border-radius:.3rem;color:var(--text-primary);font:inherit;min-height:2.35rem;padding:.45rem .55rem}.reset-button,.dialog-secondary{background:transparent;border:1px solid var(--border-default);border-radius:.3rem;color:var(--text-secondary);cursor:pointer;font:inherit;font-size:.72rem;min-height:2.35rem;padding:.45rem .65rem}.reset-button:hover{border-color:var(--accent-primary);color:var(--text-primary)}.history-list{border-bottom:1px solid var(--border-default);border-top:1px solid var(--border-default)}.history-row{align-items:center;background:transparent;border:0;border-bottom:1px solid var(--border-default);color:var(--text-primary);cursor:pointer;display:grid;gap:.8rem;grid-template-columns:7.2rem 2rem minmax(0,1fr) 5.2rem 9rem 1rem;min-height:4.5rem;padding:.65rem .4rem;text-align:left;width:100%}.history-row:hover{background:var(--background-secondary)}.history-row[hidden]{display:none}.history-row time{color:var(--text-secondary);display:grid;font-size:.72rem;gap:.2rem;white-space:nowrap}.history-row time small{color:var(--text-muted);font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.68rem}.history-icon{align-items:center;border:1px solid currentColor;border-radius:.3rem;display:flex;font-size:.9rem;height:1.8rem;justify-content:center;width:1.8rem}.history-icon.blue,.history-kind.blue{color:#6ba6ff}.history-icon.green,.history-kind.green{color:#72c98b}.history-icon.violet,.history-kind.violet{color:#ac8cf4}.history-icon.amber,.history-kind.amber{color:#e8b84a}.history-icon.cyan,.history-kind.cyan{color:#67c3ce}.history-copy{min-width:0}.history-copy strong{display:block;font-size:.84rem;font-weight:800}.history-copy small{color:var(--text-secondary);display:block;font-size:.73rem;line-height:1.5;margin-top:.2rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.history-kind,.history-project{font-size:.72rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.row-chevron{color:var(--accent-primary);font-size:1.2rem}.empty-state{color:var(--text-secondary);margin:0;padding:2.5rem;text-align:center}.history-pagination{align-items:center;display:flex;gap:.7rem;justify-content:space-between;padding-top:.8rem}.history-pagination span{color:var(--text-secondary);font-size:.72rem}.history-pagination button{background:var(--background-secondary);border:1px solid var(--border-default);border-radius:.3rem;color:var(--text-primary);cursor:pointer;font:inherit;font-size:.72rem;font-weight:750;min-height:2.2rem;padding:.4rem .7rem}.history-pagination button:hover:not(:disabled),.history-pagination button:focus-visible{border-color:var(--accent-primary);color:var(--accent-primary)}.history-pagination button:disabled{cursor:wait;opacity:.6}.history-dialog{background:var(--background-secondary);border:1px solid var(--border-default);border-radius:.5rem;color:var(--text-primary);max-width:34rem;padding:1.25rem;width:calc(100% - 2rem)}.history-dialog::backdrop{background:rgb(0 0 0 / .55)}.dialog-close-form{display:flex;justify-content:flex-end}.dialog-close{background:transparent;border:0;color:var(--text-secondary);cursor:pointer;font-size:1.25rem}.dialog-kicker{color:var(--text-secondary);font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.72rem;margin:.2rem 0}.history-dialog h2{font-size:1.25rem;margin:.3rem 0 1rem}.dialog-meta{border-bottom:1px solid var(--border-default);border-top:1px solid var(--border-default);display:grid;gap:.6rem;grid-template-columns:repeat(2,1fr);margin:0;padding:.8rem 0}.dialog-meta div{display:grid;gap:.15rem}.dialog-meta dt{color:var(--text-secondary);font-size:.68rem;font-weight:800}.dialog-meta dd{font-size:.78rem;margin:0}.dialog-summary{font-size:.82rem;line-height:1.7;margin:1rem 0}.dialog-actions{display:flex;gap:.5rem;justify-content:flex-end}.dialog-link{border:1px solid var(--accent-primary);border-radius:.3rem;color:var(--accent-primary);font-size:.74rem;font-weight:800;padding:.5rem .7rem;text-decoration:none}@media(max-width:760px){.update-history{padding:0 .8rem 3rem}.page-heading{align-items:start;display:grid}.history-summary{grid-template-columns:repeat(2,minmax(0,1fr))}.history-filters{grid-template-columns:1fr 1fr}.history-filters .search-field{grid-column:1/-1}.history-row{gap:.55rem;grid-template-columns:5.4rem 1.8rem minmax(0,1fr) 1rem}.history-kind,.history-project{display:none}.history-pagination{align-items:stretch;display:grid}.history-pagination button{width:100%}}@media(max-width:420px){.history-filters{grid-template-columns:1fr}.history-filters .search-field{grid-column:auto}}
</style>

<style>
  .update-history {
    max-width: 1280px;
    padding: 0 clamp(1rem, 2.5vw, 2rem) 3.5rem;
  }

  .page-heading {
    padding: clamp(1.4rem, 3vw, 2.25rem) 0 1rem;
  }

  .page-heading h1 {
    letter-spacing: -0.035em;
  }

  .page-heading > a {
    align-items: center;
    border: 1px solid var(--border-default);
    border-radius: 0.45rem;
    display: inline-flex;
    min-height: 2.4rem;
    padding: 0.45rem 0.7rem;
    transition:
      border-color 140ms ease,
      color 140ms ease,
      background-color 140ms ease;
  }

  .page-heading > a:hover,
  .page-heading > a:focus-visible {
    background: var(--background-secondary);
    border-color: var(--accent-primary);
    color: var(--text-primary);
  }

  .history-summary {
    gap: 0.75rem;
    margin: 1rem 0 1.25rem;
  }

  .history-summary > div {
    border-radius: 0.65rem;
    min-height: 5.2rem;
    padding: 0.8rem 1rem;
  }

  .history-summary strong {
    font-size: clamp(1.15rem, 2vw, 1.45rem);
  }

  .history-panel {
    background: color-mix(in srgb, var(--background-secondary) 28%, transparent);
    border-radius: 0.8rem;
    padding: clamp(0.8rem, 2vw, 1.25rem);
  }

  .panel-heading {
    gap: 1rem;
  }

  .panel-heading output {
    background: var(--background-secondary);
    border: 1px solid var(--border-default);
    border-radius: 999px;
    padding: 0.2rem 0.55rem;
  }

  .history-filters {
    gap: 0.75rem;
    grid-template-columns: minmax(12rem, 1fr) minmax(9rem, 0.35fr) minmax(9rem, 0.4fr) auto;
    padding: 1rem 0.1rem;
  }

  .history-filters input,
  .history-filters select {
    border-radius: 0.45rem;
    min-height: 2.65rem;
    transition: border-color 140ms ease;
  }

  .history-filters input:focus-visible,
  .history-filters select:focus-visible {
    border-color: var(--accent-primary);
    outline: 2px solid color-mix(in srgb, var(--accent-primary) 22%, transparent);
    outline-offset: 1px;
  }

  .reset-button,
  .history-pagination button,
  .dialog-secondary {
    border-radius: 0.45rem;
    transition:
      border-color 140ms ease,
      color 140ms ease,
      background-color 140ms ease;
  }

  .history-list {
    border: 1px solid var(--border-default);
    border-radius: 0.65rem;
    overflow: hidden;
  }

  :global(.history-list .history-row) {
    align-items: center;
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--border-default);
    color: var(--text-primary);
    cursor: pointer;
    display: grid;
    gap: 0.85rem;
    grid-template-columns: 7.4rem 2rem minmax(0, 1fr) 5.5rem 8.5rem 1rem;
    min-height: 4.8rem;
    padding: 0.7rem 0.85rem;
    text-align: left;
    width: 100%;
  }

  :global(.history-list .history-row:last-of-type) {
    border-bottom: 0;
  }

  :global(.history-list .history-row:hover) {
    background: color-mix(in srgb, var(--accent-primary) 7%, var(--background-secondary));
  }

  :global(.history-list .history-row:focus-visible) {
    outline: 2px solid var(--accent-primary);
    outline-offset: -2px;
    position: relative;
    z-index: 1;
  }

  :global(.history-list .history-row[hidden]) {
    display: none;
  }

  :global(.history-list .history-row time) {
    color: var(--text-secondary);
    display: grid;
    font-size: 0.72rem;
    gap: 0.2rem;
    white-space: nowrap;
  }

  :global(.history-list .history-row time small) {
    color: var(--text-muted);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.68rem;
  }

  :global(.history-list .history-icon) {
    align-items: center;
    border: 1px solid currentColor;
    border-radius: 0.4rem;
    display: flex;
    font-size: 0.9rem;
    height: 1.8rem;
    justify-content: center;
    width: 1.8rem;
  }

  :global(.history-list .history-copy) {
    min-width: 0;
  }

  :global(.history-list .history-copy strong) {
    display: block;
    font-size: 0.88rem;
    font-weight: 800;
    line-height: 1.4;
  }

  :global(.history-list .history-copy small) {
    color: var(--text-secondary);
    display: block;
    font-size: 0.73rem;
    line-height: 1.45;
    margin-top: 0.2rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  :global(.history-list .history-kind),
  :global(.history-list .history-project) {
    font-size: 0.72rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  :global(.history-list .history-kind) {
    background: color-mix(in srgb, currentColor 10%, transparent);
    border-radius: 999px;
    font-weight: 750;
    justify-self: start;
    padding: 0.25rem 0.55rem;
  }

  :global(.history-list .history-icon.blue),
  :global(.history-list .history-kind.blue) {
    color: #6ba6ff;
  }

  :global(.history-list .history-icon.green),
  :global(.history-list .history-kind.green) {
    color: #72c98b;
  }

  :global(.history-list .history-icon.violet),
  :global(.history-list .history-kind.violet) {
    color: #ac8cf4;
  }

  :global(.history-list .history-icon.amber),
  :global(.history-list .history-kind.amber) {
    color: #e8b84a;
  }

  :global(.history-list .history-icon.cyan),
  :global(.history-list .history-kind.cyan) {
    color: #67c3ce;
  }

  :global(.history-list .row-chevron) {
    color: var(--accent-primary);
    font-size: 1.2rem;
  }

  .history-skeleton-row {
    gap: 0.85rem;
    grid-template-columns: 7.4rem 2rem minmax(0, 1fr) 5.5rem 8.5rem 1rem;
    min-height: 4.8rem;
    padding: 0.7rem 0.85rem;
  }

