---
import AdminLayout from "../../layouts/AdminLayout.astro";
const memberPortal = Astro.url.searchParams.get("project") === "portal";
---

<AdminLayout title={memberPortal ? "メンバー用マイページ" : "マイページ"} description="プロフィールと自分の作業を確認します">
  <main class="personal-workspace" data-personal-workspace>
    <header class="workspace-heading">
      <div><h1>{memberPortal ? "メンバー用マイページ" : "マイページ"}</h1><p>{memberPortal ? "所属などの基本情報を確認・編集できます。" : "登録情報、個人メモ、担当原稿を一つの画面で確認できます。"}</p></div>
      {!memberPortal && <a class="primary-action" href="/admin/articles/">原稿一覧を開く</a>}
    </header>

    <section class="profile-card" aria-labelledby="profile-heading">
      <div class="profile-card__top">
        <button type="button" class="avatar-preview" data-avatar-preview data-avatar-open aria-label="プロフィール画像を変更">A</button>
        <div class="profile-identity">
          <p class="eyebrow">登録情報</p><h2 id="profile-heading" data-profile-name>読み込み中…</h2>
          <div class="profile-facts"><span><b>所属</b><strong data-profile-university>確認中…</strong></span><span><b>学年</b><strong data-profile-year>確認中…</strong></span><span><b>権限・担当</b><strong data-my-subjects>確認中…</strong></span></div>
          <small>表示名・所属・学年は下のフォームから本人が更新できます。</small>
        </div>
      </div>
      <output data-profile-message aria-live="polite"></output>
      <form class="profile-editor" data-profile-editor>
        <label>表示名<input name="displayName" autocomplete="name" maxlength="120" /></label>
        <label>所属先<input name="university" autocomplete="organization" maxlength="160" /></label>
        <label>学年・立場<input name="year" maxlength="80" /></label>
        <label>所属区分<input name="affiliationType" maxlength="80" /></label>
        <label>居住国・地域<input name="country" autocomplete="country-name" maxlength="100" /></label>
        <label>タイムゾーン<input name="timezone" list="workspace-timezones" maxlength="80" value="Asia/Tokyo" /></label>
        <label class="profile-editor__wide">運営内自己紹介<textarea name="bio" rows="5" maxlength="2000" placeholder="担当、興味、活動の紹介など"></textarea></label>
        <datalist id="workspace-timezones"><option value="Asia/Tokyo"></option><option value="Asia/Kathmandu"></option><option value="Europe/London"></option><option value="America/New_York"></option></datalist>
        <button type="submit" class="primary-action">基本情報を保存</button>
      </form>
      <div class="avatar-setting" data-avatar-setting hidden>
        <label>プロフィール画像を選択（PNG・JPEG・WebP、2MB以下）<input data-profile-avatar type="file" accept="image/png,image/jpeg,image/webp" /></label>
        <small>円形プレビューを確認し、必要なら画像をドラッグ・拡大縮小してから保存してください。</small>
      </div>
      <div class="avatar-crop" data-avatar-crop hidden><div class="avatar-crop-stage"><canvas data-avatar-crop-canvas width="260" height="260" aria-label="プロフィール画像の切り抜き範囲"></canvas></div><div class="avatar-crop-controls"><label>表示範囲<input data-avatar-zoom type="range" min="0.25" max="3" step="0.01" value="1" /></label><button type="button" class="quiet-action" data-avatar-reset>位置と倍率をリセット</button></div></div>
      <div class="avatar-actions"><button type="button" class="primary-action" data-save-avatar disabled>プロフィール画像を保存</button><button type="button" class="quiet-action" data-delete-avatar disabled>画像を削除</button></div>
    </section>

    <button type="button" class="theme-profile-toggle" data-theme-toggle aria-pressed="false">☾ ダークモード</button>

    <div class="workspace-grid">
      <section class="personal-note" aria-labelledby="note-heading"><div class="section-heading"><div><p class="eyebrow">本人専用</p><h2 id="note-heading">個人メモ</h2><p>記事案、次に行うこと、個人的な下調べなどを記録できます。</p></div><output data-note-message aria-live="polite"></output></div><textarea data-private-note maxlength="12000" placeholder="例：次は群作用の記事の具体例を追加する。参考文献：…"></textarea><div class="note-actions"><small data-note-updated></small><button type="button" class="primary-action" data-save-note>個人メモを保存</button></div></section>
      <section class="my-documents" aria-labelledby="documents-heading"><div class="section-heading"><div><p class="eyebrow">自分が作成した原稿</p><h2 id="documents-heading">担当原稿</h2><p>自分が作成した原稿だけを一覧できます。</p></div></div><div class="document-list" data-my-documents>読み込み中…</div></section>
    </div>
  </main>
</AdminLayout>

<style>
  .personal-workspace{--surface:var(--background-primary);--alt:var(--background-secondary);--border:var(--border-default);--text:var(--text-primary);--muted:var(--text-secondary);--accent:var(--accent-primary);box-sizing:border-box;color:var(--text);margin:0 auto;max-width:1100px;padding:0 1.25rem 4rem}.workspace-heading{align-items:start;border-bottom:1px solid var(--border);display:flex;gap:1rem;justify-content:space-between;padding:2rem 0 1.25rem}.eyebrow{color:var(--accent);font-size:.76rem;font-weight:800;letter-spacing:.08em;margin:0 0 .35rem}.workspace-heading h1{font-size:clamp(1.8rem,4vw,2.35rem);margin:0}.workspace-heading p:last-child,.section-heading p{color:var(--muted);line-height:1.6;margin:.45rem 0 0}.primary-action{background:var(--accent);border:1px solid var(--accent);color:#fff;cursor:pointer;font:inherit;font-size:.84rem;font-weight:800;min-height:2.35rem;padding:.48rem .7rem;text-decoration:none}.quiet-action{background:var(--surface);border:1px solid var(--border);color:var(--text);cursor:pointer;font:inherit;font-size:.8rem;font-weight:700;min-height:2.35rem;padding:.48rem .7rem}.profile-card,.personal-note,.my-documents{border:1px solid var(--border);border-top:2px solid var(--accent);display:grid;gap:.8rem;margin:1.25rem 0;padding:1rem}.profile-card__top{align-items:center;display:flex;gap:1rem}.profile-identity{display:grid;gap:.25rem;min-width:0}.profile-identity h2{font-size:1.3rem;margin:0;overflow-wrap:anywhere}.profile-identity small{color:var(--muted);line-height:1.55}.avatar-preview{align-items:center;background:linear-gradient(145deg,#2d6ea8,#153c66);background-position:center;background-size:cover;border:1px solid var(--border);border-radius:50%;color:#fff;cursor:pointer;display:flex;flex:0 0 8rem;font:inherit;font-size:2.1rem;font-weight:800;height:8rem;justify-content:center;overflow:hidden;padding:0;width:8rem}.profile-facts{display:flex;flex-wrap:wrap;gap:.45rem}.profile-facts span{background:var(--alt);border:1px solid var(--border);display:grid;gap:.08rem;min-width:7rem;padding:.35rem .5rem}.profile-facts b{color:var(--muted);font-size:.66rem}.profile-facts strong{font-size:.82rem;overflow-wrap:anywhere}.profile-card>output{color:var(--muted);font-size:.78rem;min-height:1.1em}.avatar-setting{align-items:start;display:grid;gap:.35rem}.avatar-setting[hidden]{display:none}.avatar-setting label{display:grid;font-size:.8rem;font-weight:800;gap:.3rem}.avatar-setting input{background:var(--surface);border:1px solid var(--border);box-sizing:border-box;color:var(--text);font:inherit;padding:.5rem;width:100%}.avatar-setting small{color:var(--muted);font-size:.72rem}.avatar-crop{align-items:center;background:var(--alt);border:1px solid var(--border);display:flex;gap:1rem;padding:.75rem}.avatar-crop[hidden]{display:none}.avatar-crop-stage{background:linear-gradient(45deg,#dfe7ee 25%,transparent 25%,transparent 75%,#dfe7ee 75%),linear-gradient(45deg,#dfe7ee 25%,transparent 25%,transparent 75%,#dfe7ee 75%);background-position:0 0,8px 8px;background-size:16px 16px;border:2px solid var(--accent);border-radius:50%;height:13rem;overflow:hidden;width:13rem}.avatar-crop-stage canvas{display:block;height:100%;width:100%}.avatar-crop-controls{display:grid;gap:.6rem;min-width:12rem}.avatar-crop-controls label{display:grid;gap:.3rem;font-size:.76rem;font-weight:800}.avatar-crop-controls input{width:100%}.avatar-actions{align-items:center;display:flex;flex-wrap:wrap;gap:.5rem}.avatar-actions button:disabled{cursor:not-allowed;opacity:.55}.theme-profile-toggle{background:var(--alt);border:1px solid var(--border);color:var(--text);cursor:pointer;font:inherit;font-size:.8rem;font-weight:800;padding:.5rem .7rem}.workspace-grid{display:grid;gap:1rem;grid-template-columns:minmax(0,1fr) minmax(0,1fr);margin-top:1.25rem}.section-heading{align-items:start;display:flex;gap:.75rem;justify-content:space-between}.section-heading h2{font-size:1.1rem;margin:0}.section-heading output{color:var(--muted);font-size:.78rem;max-width:12rem;text-align:right}.personal-note textarea{background:var(--surface);border:1px solid var(--border);box-sizing:border-box;color:var(--text);font:inherit;line-height:1.65;min-height:18rem;padding:.7rem;resize:vertical;width:100%}.note-actions{align-items:center;display:flex;gap:.65rem;justify-content:space-between}.note-actions small{color:var(--muted)}.document-list{display:grid;gap:.5rem}.document-card{background:var(--alt);border-left:3px solid var(--accent);color:var(--text);display:grid;gap:.3rem;padding:.65rem .7rem;text-decoration:none}.document-card:hover{box-shadow:inset 0 0 0 1px var(--accent)}.document-card-top{align-items:center;display:flex;gap:.5rem;justify-content:space-between}.document-card b{font-size:.9rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.document-card small{color:var(--muted);font-size:.74rem}.document-edit-link{color:var(--accent);font-size:.74rem;font-weight:800}.state{border:1px solid var(--border);border-radius:999px;color:var(--muted);font-size:.68rem;font-weight:800;padding:.12rem .35rem;white-space:nowrap}.state-in-review{background:#fff0c6}.state-on-hold{background:#f4e5e7}.state-approved{background:#def4e6}.empty{color:var(--muted);padding:2rem 0;text-align:center}@media(max-width:760px){.personal-workspace{padding:0 .9rem 3rem}.workspace-heading{display:grid}.workspace-heading .primary-action{justify-self:start}.workspace-grid{grid-template-columns:1fr}.profile-card__top{align-items:flex-start}.avatar-preview{flex-basis:6rem;font-size:1.7rem;height:6rem;width:6rem}.avatar-crop{align-items:start;display:grid;justify-items:center}.avatar-crop-controls{min-width:0;width:100%}.avatar-actions{display:grid}.avatar-actions button{width:100%}.note-actions{align-items:start;display:grid}.section-heading{display:grid}.section-heading output{text-align:left}}
  .profile-editor{display:grid;gap:.65rem;grid-template-columns:repeat(2,minmax(0,1fr))}.profile-editor label{display:grid;font-size:.76rem;font-weight:800;gap:.25rem}.profile-editor input,.profile-editor textarea{background:var(--surface);border:1px solid var(--border);box-sizing:border-box;color:var(--text);font:inherit;padding:.55rem;width:100%}.profile-editor__wide{grid-column:1/-1}.profile-editor .primary-action{justify-self:start}.state-in-review{border-color:#efd38a;color:#805500}.state-on-hold{border-color:#dfbbc1;color:#8a3b49}.state-approved{border-color:#a8d8b7;color:#267143}@media(max-width:760px){.profile-editor{grid-template-columns:1fr}}
  .operator-introductions{border:1px solid var(--border);border-top:2px solid var(--accent);display:grid;gap:1rem;margin:1.25rem 0;padding:1rem}.operator-introductions__heading{align-items:center;border-bottom:1px solid var(--border);padding-bottom:.75rem}.operator-introductions__heading .quiet-action{display:inline-flex;align-items:center;text-decoration:none;white-space:nowrap}.operator-introduction-grid{display:grid;gap:.6rem;grid-template-columns:repeat(auto-fill,minmax(17rem,1fr))}.operator-introduction-card{background:var(--alt);border:1px solid var(--border);display:grid;gap:.3rem;padding:.75rem}.operator-introduction-card h3{font-size:.96rem;margin:0}.operator-introduction-affiliation,.operator-introduction-role{color:var(--muted);font-size:.75rem;line-height:1.45;margin:0}.operator-introduction-role{color:var(--accent);font-weight:800}.operator-introduction-card details{border-top:1px solid var(--border);margin-top:.25rem;padding-top:.4rem}.operator-introduction-card summary{color:var(--accent);cursor:pointer;font-size:.72rem;font-weight:800;list-style:none}.operator-introduction-card summary::-webkit-details-marker{display:none}.operator-introduction-card summary::before{content:"＋ ";font-size:.9rem}.operator-introduction-card details[open] summary::before{content:"− ";}.operator-introduction-card details div{display:grid;gap:.25rem;margin-top:.45rem}.operator-introduction-card details p{color:var(--muted);font-size:.72rem;line-height:1.55;margin:0;white-space:pre-wrap;overflow-wrap:anywhere}@media(max-width:760px){.operator-introductions{padding:.8rem}.operator-introductions__heading{align-items:start}.operator-introduction-grid{grid-template-columns:1fr}.operator-introductions__heading .quiet-action{justify-self:start}}
</style>

<script>
  type PersonalDocument={id:string;subject:string;category:string;title:string;status:"draft"|"in-review"|"on-hold"|"approved";updated_at:string;published_at:string|null};
  const initializePersonalWorkspace=()=>{const root=document.querySelector<HTMLElement>("[data-personal-workspace]");if(!root||root.dataset.personalWorkspaceInitialized==="true")return;root.dataset.personalWorkspaceInitialized="true";
    const email=root.querySelector<HTMLElement>("[data-workspace-email]");const note=root.querySelector<HTMLTextAreaElement>("[data-private-note]")!;const noteMessage=root.querySelector<HTMLOutputElement>("[data-note-message]")!;const noteUpdated=root.querySelector<HTMLElement>("[data-note-updated]")!;const documents=root.querySelector<HTMLElement>("[data-my-documents]")!;const saveNote=root.querySelector<HTMLButtonElement>("[data-save-note]")!;const message=root.querySelector<HTMLOutputElement>("[data-profile-message]")!;const profileName=root.querySelector<HTMLElement>("[data-profile-name]")!;const university=root.querySelector<HTMLElement>("[data-profile-university]")!;const year=root.querySelector<HTMLElement>("[data-profile-year]")!;const subjects=root.querySelector<HTMLElement>("[data-my-subjects]")!;const avatarFile=root.querySelector<HTMLInputElement>("[data-profile-avatar]")!;const preview=root.querySelector<HTMLElement>("[data-avatar-preview]")!;const avatarSetting=root.querySelector<HTMLElement>("[data-avatar-setting]")!;const crop=root.querySelector<HTMLElement>("[data-avatar-crop]")!;const canvas=root.querySelector<HTMLCanvasElement>("[data-avatar-crop-canvas]")!;const zoom=root.querySelector<HTMLInputElement>("[data-avatar-zoom]")!;const reset=root.querySelector<HTMLButtonElement>("[data-avatar-reset]")!;const saveAvatar=root.querySelector<HTMLButtonElement>("[data-save-avatar]")!;const deleteAvatar=root.querySelector<HTMLButtonElement>("[data-delete-avatar]")!;
    const esc=(v:string)=>v.replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#39;"}[c]??c));const formatDate=(v:string)=>new Intl.DateTimeFormat("ja-JP",{dateStyle:"medium",timeStyle:"short"}).format(new Date(v));const read=async<T,>(r:Response)=>{if(!(r.headers.get("content-type")??"").includes("application/json"))throw new Error("認証が切れました。ページを再読み込みしてください。");return await r.json() as T};
    let image:HTMLImageElement|null=null,dataUrl="",scale=1,offsetX=0,offsetY=0,drag:{x:number;y:number;ox:number;oy:number}|null=null;
    const draw=()=>{if(!image)return;const ctx=canvas.getContext("2d");if(!ctx)return;const size=canvas.width;const base=Math.max(size/image.naturalWidth,size/image.naturalHeight);const s=base*scale;ctx.clearRect(0,0,size,size);ctx.drawImage(image,(size-image.naturalWidth*s)/2+offsetX,(size-image.naturalHeight*s)/2+offsetY,image.naturalWidth*s,image.naturalHeight*s);dataUrl=canvas.toDataURL("image/jpeg",.84);preview.style.backgroundImage=`url(${JSON.stringify(dataUrl)})`;preview.textContent="";saveAvatar.disabled=false;deleteAvatar.disabled=false;};
    const loadProfile=async()=>{try{const r=await fetch("/api/admin/profile",{credentials:"same-origin",cache:"no-store"});const d=await read<{profile?:{display_name?:string;avatar_url?:string;university?:string;year?:string};subjects?:string[];roles?:string[];error?:string}>(r);if(!r.ok)throw new Error(d.error??"プロフィールを読み込めませんでした。");profileName.textContent=d.profile?.display_name?.trim()||"表示名未設定";university.textContent=d.profile?.university?.trim()||"未登録";year.textContent=d.profile?.year?.trim()||"未登録";subjects.textContent=(d.roles?.length?d.roles:d.subjects)?.join("・")||"未設定";dataUrl=d.profile?.avatar_url??"";preview.style.backgroundImage=dataUrl?`url(${JSON.stringify(dataUrl)})`:"";preview.textContent=dataUrl?"":"A";deleteAvatar.disabled=!dataUrl;}catch(e){message.value=e instanceof Error?e.message:"プロフィールを読み込めませんでした。";}};
    const saveAvatarData=async()=>{message.value="保存中…";const r=await fetch("/api/admin/profile",{method:"PUT",credentials:"same-origin",headers:{"content-type":"application/json"},body:JSON.stringify({avatarUrl:dataUrl})});const d=await read<{error?:string}>(r);if(!r.ok)throw new Error(d.error??"プロフィール画像を保存できませんでした。");message.value="プロフィール画像を保存しました。";document.dispatchEvent(new CustomEvent("atlasez-profile-updated"));};
    preview.addEventListener("click",()=>{avatarSetting.hidden=false;avatarFile.click()});avatarFile.addEventListener("change",()=>{const f=avatarFile.files?.[0];if(!f)return;if(f.size>2_000_000){message.value="画像は2MB以下にしてください。";avatarFile.value="";return}const reader=new FileReader();reader.onload=()=>{const next=new Image();next.onload=()=>{image=next;scale=1;offsetX=0;offsetY=0;zoom.value="1";crop.hidden=false;draw();message.value="表示範囲を調整して保存してください。"};next.src=String(reader.result??"")};reader.readAsDataURL(f)});zoom.addEventListener("input",()=>{scale=Number(zoom.value);draw()});reset.addEventListener("click",()=>{scale=1;offsetX=0;offsetY=0;zoom.value="1";draw()});canvas.addEventListener("pointerdown",e=>{if(!image)return;drag={x:e.clientX,y:e.clientY,ox:offsetX,oy:offsetY};canvas.setPointerCapture(e.pointerId)});canvas.addEventListener("pointermove",e=>{if(!drag)return;offsetX=drag.ox+(e.clientX-drag.x)*2;offsetY=drag.oy+(e.clientY-drag.y)*2;draw()});canvas.addEventListener("pointerup",()=>{drag=null});saveAvatar.addEventListener("click",()=>{saveAvatar.disabled=true;void saveAvatarData().catch(e=>{message.value=e instanceof Error?e.message:"保存できませんでした。"}).finally(()=>{saveAvatar.disabled=false})});deleteAvatar.addEventListener("click",()=>{dataUrl="";image=null;crop.hidden=true;avatarFile.value="";preview.style.backgroundImage="";preview.textContent="A";deleteAvatar.disabled=true;void saveAvatarData().catch(e=>{message.value=e instanceof Error?e.message:"削除できませんでした。"})});
    const load=async()=>{try{const r=await fetch("/api/admin/personal-workspace",{credentials:"same-origin",cache:"no-store"});const d=await read<{email?:string;privateNote?:string;privateNoteUpdatedAt?:string|null;documents?:PersonalDocument[];error?:string}>(r);if(!r.ok)throw new Error(d.error??"個人ワークスペースを読み込めませんでした。");if(email&&d.email)email.textContent=d.email;note.value=d.privateNote??"";noteUpdated.textContent=d.privateNoteUpdatedAt?`最終保存：${formatDate(d.privateNoteUpdatedAt)}`:"まだ保存されていません";const labels={draft:"下書き","in-review":"査読中","on-hold":"保留",approved:"査読済み"} as const;documents.innerHTML=(d.documents??[]).length?(d.documents??[]).map(i=>`<a class="document-card" href="/admin/editor/?document=${encodeURIComponent(i.id)}"><div class="document-card-top"><b>${esc(i.title||"無題の原稿")}</b><span class="state state-${i.status}">${labels[i.status]}</span></div><small>${esc(i.subject)} / ${esc(i.category)} ・ 最終更新 ${formatDate(i.updated_at)}${i.published_at?" ・ 公開済み":""}</small><span class="document-edit-link">編集画面を開く →</span></a>`).join(""):"<p class=\"empty\">自分が作成した原稿はまだありません。</p>"}catch(e){documents.innerHTML=`<p class="empty">${esc(e instanceof Error?e.message:"読み込めませんでした")}</p>`}};saveNote.addEventListener("click",async()=>{saveNote.disabled=true;noteMessage.value="保存中…";try{const r=await fetch("/api/admin/personal-workspace",{method:"PUT",credentials:"same-origin",headers:{"content-type":"application/json"},body:JSON.stringify({privateNote:note.value})});const d=await read<{updatedAt?:string;error?:string}>(r);if(!r.ok)throw new Error(d.error??"保存できませんでした。");noteUpdated.textContent=d.updatedAt?`最終保存：${formatDate(d.updatedAt)}`:"保存しました";noteMessage.value="保存しました。"}catch(e){noteMessage.value=e instanceof Error?e.message:"保存できませんでした。"}finally{saveNote.disabled=false}});void loadProfile();void load();
  };document.addEventListener("astro:page-load",initializePersonalWorkspace);initializePersonalWorkspace();
</script>

<script>
  const initializeEditableProfile = () => {
    const form = document.querySelector<HTMLFormElement>("[data-profile-editor]");
    const message = document.querySelector<HTMLOutputElement>("[data-profile-message]");
    if (!form || !message || form.dataset.initialized === "true") return;
    form.dataset.initialized = "true";
    const read = async (response: Response) => {
      if (!(response.headers.get("content-type") ?? "").includes("application/json")) throw new Error("認証が切れました。ページを再読み込みしてください。");
      return await response.json() as { profile?: Record<string, string>; error?: string };
    };
    void fetch("/api/admin/profile", { credentials: "same-origin", cache: "no-store" }).then(read).then(({ profile = {} }) => {
      const values = { displayName: profile.display_name, university: profile.university, year: profile.year, affiliationType: profile.affiliation_type, country: profile.country, timezone: profile.timezone || "Asia/Tokyo", bio: profile.bio };
      for (const [name, value] of Object.entries(values)) {
        const input = form.elements.namedItem(name);
        if (input instanceof HTMLInputElement || input instanceof HTMLTextAreaElement) input.value = value ?? "";
      }
    }).catch(() => undefined);
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const button = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
      button.disabled = true;
      message.value = "保存中…";
      try {
        const response = await fetch("/api/admin/profile", { method: "PUT", credentials: "same-origin", headers: { "content-type": "application/json" }, body: JSON.stringify(Object.fromEntries(new FormData(form))) });
        const data = await read(response);
        if (!response.ok) throw new Error(data.error ?? "基本情報を保存できませんでした。");
        message.value = "基本情報を保存しました。";
        document.dispatchEvent(new CustomEvent("atlasez-profile-updated"));
      } catch (error) {
        message.value = error instanceof Error ? error.message : "保存できませんでした。";
      } finally {
        button.disabled = false;
      }
    });
  };
  document.addEventListener("astro:page-load", initializeEditableProfile);
  initializeEditableProfile();
</script>
