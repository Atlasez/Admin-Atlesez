---
import AdminLayout from "../../layouts/AdminLayout.astro";

const requestedProject = Astro.url.searchParams.get("project") ?? "atlas";
if (requestedProject === "portal") return Astro.redirect("/admin/member-profile/", 302);
const project = requestedProject === "secretariat" ? "secretariat" : requestedProject === "seminar-platform" ? "seminar-platform" : "atlas";
const projectLabel = project === "secretariat" ? "Atlasez運営事務局" : project === "seminar-platform" ? "ゼミプラットフォーム" : "学習サイト「アトラス」運営";
const isAtlas = project === "atlas";
const projectApprovalHref = isAtlas ? "/admin/profile-requests/?section=atlas" : `/admin/project-profile-requests/?project=${project}`;
---

<AdminLayout title={`${projectLabel} マイページ`} description="プロジェクト内の自己紹介と担当を確認します">
  <main class="personal-workspace" data-personal-workspace data-project={project} data-atlas={String(isAtlas)}>
    <header class="workspace-heading">
      <div><h1>マイページ</h1></div>
      {isAtlas && <a class="primary-action" href="/admin/articles/" aria-label="原稿一覧を開く">→</a>}
    </header>

    <section class="profile-card" aria-labelledby="profile-heading">
      <div class="profile-card__top">
        <a class="avatar-preview" data-avatar-preview href="/admin/member-profile/" aria-label="共通プロフィールを開く">A</a>
        <div class="profile-identity">
          <h2 id="profile-heading" data-profile-name>読み込み中…</h2>
          <div class="profile-facts">
            <span><b>所属</b><strong data-profile-university>確認中…</strong></span>
            <span><b>学年</b><strong data-profile-year>確認中…</strong></span>
          </div>
          <a class="common-profile-link" href="/admin/member-profile/">共通の基本情報を確認・変更する</a>
        </div>
      </div>
      <section class="assignment-panel" aria-labelledby="assignment-heading">
        <h3 id="assignment-heading">プロジェクト内での担当</h3>
        <ul data-assignments><li>確認中…</li></ul>
      </section>
      <form class="project-profile-editor" data-project-profile-form>
        <label>運営内自己紹介<textarea name="internalBio" rows="7" maxlength="4000" placeholder="プロジェクト内のメンバーに向けて、担当・関心・作業可能なことなどを入力してください。"></textarea></label>
        <div class="form-actions">
          <button type="submit" class="primary-action">変更を承認申請</button>
          <a class="quiet-action" href={`/admin/introductions/?project=${project}`}>自己紹介一覧を見る</a>
          <a class="quiet-action project-approval-link" data-project-approval-link href={projectApprovalHref} hidden>承認画面を開く →</a>
        </div>
      </form>
      <output data-profile-message aria-live="polite"></output>
    </section>

    <button type="button" class="theme-profile-toggle" data-theme-toggle aria-pressed="false">☾ ダークモード</button>

    {isAtlas && <div class="workspace-grid">
      <section class="personal-note" aria-labelledby="note-heading">
        <div class="section-heading"><div><h2 id="note-heading">個人メモ</h2></div><output data-note-message aria-live="polite"></output></div>
        <textarea data-private-note maxlength="12000" placeholder="例：次は群作用の記事の具体例を追加する。参考文献：…"></textarea>
        <div class="note-actions"><small data-note-updated></small><button type="button" class="primary-action" data-save-note>個人メモを保存</button></div>
      </section>
      <section class="my-documents" aria-labelledby="documents-heading">
        <div class="section-heading"><div><h2 id="documents-heading">担当原稿</h2></div></div>
        <div class="document-list" data-my-documents>読み込み中…</div>
      </section>
    </div>}
  </main>
</AdminLayout>

<style>
  .personal-workspace{--surface:var(--background-primary);--alt:var(--background-secondary);--border:var(--border-default);--text:var(--text-primary);--muted:var(--text-secondary);--accent:var(--accent-primary);box-sizing:border-box;color:var(--text);margin:0 auto;max-width:1100px;padding:0 1.25rem 4rem}.workspace-heading{align-items:start;border-bottom:1px solid var(--border);display:flex;gap:1rem;justify-content:space-between;padding:2rem 0 1.25rem}.workspace-heading h1{font-size:clamp(1.8rem,4vw,2.35rem);margin:0}.primary-action{background:var(--accent);border:1px solid var(--accent);color:#fff;cursor:pointer;font:inherit;font-size:.84rem;font-weight:800;min-height:2.35rem;padding:.48rem .7rem;text-decoration:none}.quiet-action{background:var(--surface);border:1px solid var(--border);color:var(--text);cursor:pointer;font:inherit;font-size:.8rem;font-weight:700;min-height:2.35rem;padding:.48rem .7rem;text-decoration:none}.profile-card,.personal-note,.my-documents{border:1px solid var(--border);border-top:2px solid var(--accent);display:grid;gap:1rem;margin:1.25rem 0;padding:1rem}.profile-card__top{align-items:center;display:flex;gap:1rem}.profile-identity{display:grid;gap:.35rem;min-width:0}.profile-identity h2{font-size:1.3rem;margin:0;overflow-wrap:anywhere}.avatar-preview{align-items:center;background:linear-gradient(145deg,#2d6ea8,#153c66);background-position:center;background-size:cover;border:1px solid var(--border);border-radius:50%;color:#fff;display:flex;flex:0 0 7rem;font-size:2rem;font-weight:800;height:7rem;justify-content:center;overflow:hidden;text-decoration:none;width:7rem}.profile-facts{display:flex;flex-wrap:wrap;gap:.45rem}.profile-facts span{background:var(--alt);border:1px solid var(--border);display:grid;gap:.08rem;min-width:7rem;padding:.35rem .5rem}.profile-facts b{color:var(--muted);font-size:.66rem}.profile-facts strong{font-size:.82rem;overflow-wrap:anywhere}.common-profile-link{color:var(--accent);font-size:.76rem;font-weight:800;text-decoration:none}.assignment-panel{background:var(--alt);border:1px solid var(--border);display:grid;gap:.5rem;padding:.75rem}.assignment-panel h3{font-size:.88rem;margin:0}.assignment-panel ul{display:flex;flex-wrap:wrap;gap:.4rem;list-style:none;margin:0;padding:0}.assignment-panel li{background:var(--surface);border:1px solid var(--border);font-size:.76rem;font-weight:800;padding:.32rem .5rem}.project-profile-editor{display:grid;gap:.65rem}.project-profile-editor label{display:grid;font-size:.8rem;font-weight:800;gap:.3rem}.project-profile-editor textarea{background:var(--surface);border:1px solid var(--border);box-sizing:border-box;color:var(--text);font:inherit;line-height:1.65;padding:.65rem;resize:vertical;width:100%}.form-actions{align-items:center;display:flex;flex-wrap:wrap;gap:.55rem}.form-actions .quiet-action{align-items:center;display:inline-flex}.profile-card>output{color:var(--muted);font-size:.78rem;min-height:1.1em}.theme-profile-toggle{background:var(--alt);border:1px solid var(--border);color:var(--text);cursor:pointer;font:inherit;font-size:.8rem;font-weight:800;padding:.5rem .7rem}.workspace-grid{align-items:start;display:grid;gap:1rem;grid-template-columns:minmax(0,1fr) minmax(0,1fr);margin-top:1.25rem}.section-heading{align-items:start;display:flex;gap:.75rem;justify-content:space-between}.section-heading h2{font-size:1.1rem;margin:0}.section-heading output{color:var(--muted);font-size:.78rem;max-width:12rem;text-align:right}.personal-note textarea{background:var(--surface);border:1px solid var(--border);box-sizing:border-box;color:var(--text);font:inherit;line-height:1.65;min-height:18rem;padding:.7rem;resize:vertical;width:100%}.note-actions{align-items:center;display:flex;gap:.65rem;justify-content:space-between}.note-actions small{color:var(--muted)}.document-list{display:grid;gap:.5rem}.document-card{background:var(--alt);border-left:3px solid var(--accent);color:var(--text);display:grid;gap:.3rem;padding:.65rem .7rem;text-decoration:none}.document-card:hover{box-shadow:inset 0 0 0 1px var(--accent)}.document-card-top{align-items:center;display:flex;gap:.5rem;justify-content:space-between}.document-card b{font-size:.9rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.document-card small{color:var(--muted);font-size:.74rem}.document-edit-link{color:var(--accent);font-size:.74rem;font-weight:800}.state{border:1px solid var(--border);border-radius:999px;color:var(--muted);font-size:.68rem;font-weight:800;padding:.12rem .35rem;white-space:nowrap}.state-in-review{background:#fff0c6}.state-on-hold{background:#f4e5e7}.state-approved{background:#def4e6}.empty{color:var(--muted);padding:2rem 0;text-align:center}@media(max-width:760px){.personal-workspace{padding:0 .9rem 3rem}.workspace-heading{display:grid}.workspace-heading .primary-action{justify-self:start}.workspace-grid{grid-template-columns:1fr}.profile-card__top{align-items:flex-start}.avatar-preview{flex-basis:5.5rem;font-size:1.5rem;height:5.5rem;width:5.5rem}.note-actions,.section-heading{align-items:start;display:grid}.section-heading output{text-align:left}}
</style>

<script>
  type PersonalDocument={id:string;subject:string;category:string;title:string;status:"draft"|"in-review"|"on-hold"|"approved";updated_at:string;published_at:string|null};
  type ProjectProfileResponse={project?:{id:string;name:string};canReview?:boolean;assignments?:string[];memberProfile?:{display_name?:string;avatar_url?:string;university?:string;year?:string};projectProfile?:{internal_bio?:string};profileChangeRequest?:{status?:string;proposed_internal_bio?:string;review_note?:string};error?:string};
  const initializeProjectWorkspace=()=>{const root=document.querySelector<HTMLElement>("[data-personal-workspace]");if(!root||root.dataset.initialized==="true")return;root.dataset.initialized="true";
    const projectId=root.dataset.project??"atlas";const isAtlas=root.dataset.atlas==="true";const form=root.querySelector<HTMLFormElement>("[data-project-profile-form]")!;const message=root.querySelector<HTMLOutputElement>("[data-profile-message]")!;const approvalLink=root.querySelector<HTMLAnchorElement>("[data-project-approval-link]");const profileName=root.querySelector<HTMLElement>("[data-profile-name]")!;const university=root.querySelector<HTMLElement>("[data-profile-university]")!;const year=root.querySelector<HTMLElement>("[data-profile-year]")!;const assignments=root.querySelector<HTMLElement>("[data-assignments]")!;const preview=root.querySelector<HTMLElement>("[data-avatar-preview]")!;
    const esc=(v:string)=>v.replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#39;"}[c]??c));const read=async<T,>(response:Response)=>{if(!(response.headers.get("content-type")??"").includes("application/json"))throw new Error("認証が切れました。ページを再読み込みしてください。");return await response.json() as T};const formatDate=(value:string)=>new Intl.DateTimeFormat("ja-JP",{dateStyle:"medium",timeStyle:"short"}).format(new Date(value));
    const applyProfile=(data:ProjectProfileResponse)=>{const member=data.memberProfile??{};profileName.textContent=member.display_name?.trim()||"表示名未設定";university.textContent=member.university?.trim()||"未登録";year.textContent=member.year?.trim()||"未登録";const avatar=member.avatar_url??"";preview.style.backgroundImage=avatar?`url(${JSON.stringify(avatar)})`:"";preview.textContent=avatar?"":(member.display_name?.trim().slice(0,1)||"A");assignments.innerHTML=(data.assignments??[]).map(label=>`<li>${esc(label)}</li>`).join("")||"<li>担当未設定</li>";if(approvalLink)approvalLink.hidden=data.canReview!==true;const request=data.profileChangeRequest;const textarea=form.elements.namedItem("internalBio") as HTMLTextAreaElement;textarea.value=request?.status==="pending"?request.proposed_internal_bio??"":data.projectProfile?.internal_bio??"";if(request?.status==="pending")message.value="変更申請は承認待ちです。再保存すると申請内容を更新します。";else if(request?.status==="rejected")message.value=`前回の申請は却下されました。${request.review_note?` ${request.review_note}`:""}`;};
    const loadProfile=async()=>{const response=await fetch(`/api/admin/project-profile?project=${encodeURIComponent(projectId)}`,{credentials:"same-origin",cache:"no-store"});const data=await read<ProjectProfileResponse>(response);if(!response.ok)throw new Error(data.error??"プロジェクト情報を読み込めませんでした。");applyProfile(data)};
    form.addEventListener("submit",async event=>{event.preventDefault();const button=form.querySelector<HTMLButtonElement>("button[type=submit]")!;button.disabled=true;message.value="申請中…";try{const internalBio=(form.elements.namedItem("internalBio") as HTMLTextAreaElement).value;const response=await fetch("/api/admin/project-profile",{method:"PUT",credentials:"same-origin",headers:{"content-type":"application/json"},body:JSON.stringify({projectId,internalBio})});const data=await read<{approvalRequired?:boolean;noChange?:boolean;error?:string}>(response);if(!response.ok)throw new Error(data.error??"変更申請を送れませんでした。");message.value=data.noChange?"承認済みの内容から変更はありません。":isAtlas?"運営事務局へ承認申請を送りました。":"プロジェクトの運営へ承認タスクを送りました。"}catch(error){message.value=error instanceof Error?error.message:"変更申請を送れませんでした。"}finally{button.disabled=false}});
    const toggle=root.querySelector<HTMLButtonElement>("[data-theme-toggle]");const preferencesKey="atlasez-prefs";const readPreferences=()=>{try{return JSON.parse(localStorage.getItem(preferencesKey)??"{}") as Record<string,string>}catch{return {}}};const updateToggle=()=>{const dark=document.documentElement.dataset.prefBg==="dark";if(toggle){toggle.textContent=dark?"☀ ライトモード":"☾ ダークモード";toggle.setAttribute("aria-pressed",String(dark))}};toggle?.addEventListener("click",()=>{const prefs=readPreferences();const dark=document.documentElement.dataset.prefBg!=="dark";document.documentElement.dataset.prefBg=dark?"dark":"";if(dark)prefs.bg="dark";else delete prefs.bg;localStorage.setItem(preferencesKey,JSON.stringify(prefs));updateToggle()});updateToggle();
    const note=root.querySelector<HTMLTextAreaElement>("[data-private-note]");const noteMessage=root.querySelector<HTMLOutputElement>("[data-note-message]");const noteUpdated=root.querySelector<HTMLElement>("[data-note-updated]");const documents=root.querySelector<HTMLElement>("[data-my-documents]");const saveNote=root.querySelector<HTMLButtonElement>("[data-save-note]");
    const loadAtlasWorkspace=async()=>{if(!isAtlas||!note||!noteMessage||!noteUpdated||!documents||!saveNote)return;try{const response=await fetch("/api/admin/personal-workspace",{credentials:"same-origin",cache:"no-store"});const data=await read<{privateNote?:string;privateNoteUpdatedAt?:string|null;documents?:PersonalDocument[];error?:string}>(response);if(!response.ok)throw new Error(data.error??"個人ワークスペースを読み込めませんでした。");note.value=data.privateNote??"";noteUpdated.textContent=data.privateNoteUpdatedAt?`最終保存：${formatDate(data.privateNoteUpdatedAt)}`:"まだ保存されていません";const labels={draft:"下書き","in-review":"フィードバック中","on-hold":"保留",approved:"フィードバック済み"} as const;documents.innerHTML=(data.documents??[]).length?(data.documents??[]).map(item=>`<a class="document-card" href="/admin/editor/?document=${encodeURIComponent(item.id)}"><div class="document-card-top"><b>${esc(item.title||"無題の原稿")}</b><span class="state state-${item.status}">${labels[item.status]}</span></div><small>${esc(item.subject)} / ${esc(item.category)} ・ 最終更新 ${formatDate(item.updated_at)}${item.published_at?" ・ 公開済み":""}</small><span class="document-edit-link" aria-hidden="true">→</span></a>`).join(""):"<p class=\"empty\">自分が作成した原稿はまだありません。</p>"}catch(error){documents.innerHTML=`<p class="empty">${esc(error instanceof Error?error.message:"読み込めませんでした")}</p>`}};
    saveNote?.addEventListener("click",async()=>{if(!note||!noteMessage||!noteUpdated||!saveNote)return;saveNote.disabled=true;noteMessage.value="保存中…";try{const response=await fetch("/api/admin/personal-workspace",{method:"PUT",credentials:"same-origin",headers:{"content-type":"application/json"},body:JSON.stringify({privateNote:note.value})});const data=await read<{updatedAt?:string;error?:string}>(response);if(!response.ok)throw new Error(data.error??"保存できませんでした。");noteUpdated.textContent=data.updatedAt?`最終保存：${formatDate(data.updatedAt)}`:"保存しました";noteMessage.value="保存しました。"}catch(error){noteMessage.value=error instanceof Error?error.message:"保存できませんでした。"}finally{saveNote.disabled=false}});
    void loadProfile().catch(error=>{message.value=error instanceof Error?error.message:"プロジェクト情報を読み込めませんでした。"});void loadAtlasWorkspace();
  };document.addEventListener("astro:page-load",initializeProjectWorkspace);initializeProjectWorkspace();
</script>
