---
import AdminLayout from "../../layouts/AdminLayout.astro";
import AdminNav from "../../components/AdminNav.astro";
import AdminBreadcrumb from "../../components/AdminBreadcrumb.astro";
---

<AdminLayout title="マイページ" description="運営者プロフィールと自分の作業を確認します">
  <main class="personal-workspace" data-personal-workspace>
    <AdminNav current="global" />
    <AdminBreadcrumb items={[{ label: "メンバー用サイト", href: "/admin/portal/" }, { label: "マイページ" }]} />
    <header class="workspace-heading">
      <div><p class="eyebrow">ATLASEZ / メンバー</p><h1>マイページ</h1><p>Atlasez全体のアカウント情報と、参加中のプロジェクトを確認できます。</p></div>
      <a class="primary-action" href="/admin/portal/">Homeへ戻る</a>
    </header>

    <section class="profile-card" aria-labelledby="profile-heading">
      <div class="profile-card__top">
        <div class="avatar-preview" data-avatar-preview aria-hidden="true">A</div>
        <div class="profile-identity">
          <p class="eyebrow">登録情報</p><h2 id="profile-heading" data-profile-name>読み込み中…</h2>
          <div class="profile-facts"><span><b>所属</b><strong data-profile-university>確認中…</strong></span><span><b>学年</b><strong data-profile-year>確認中…</strong></span><span><b>権限・担当</b><strong data-my-subjects>確認中…</strong></span></div>
          <small>表示名・所属・学年・担当分野は運営者・担当分野管理から反映されます。表示名未設定の場合は匿名の自動表示名が表示されます。マイページでは変更できません。</small>
        </div>
      </div>
      <output data-profile-message aria-live="polite"></output>
      <div class="avatar-setting">
        <label>プロフィール画像を選択（PNG・JPEG・WebP、2MB以下）<input data-profile-avatar type="file" accept="image/png,image/jpeg,image/webp" /></label>
        <small>円形プレビューを確認し、必要なら画像をドラッグ・拡大縮小してから保存してください。</small>
      </div>
      <div class="avatar-crop" data-avatar-crop hidden><div class="avatar-crop-stage"><canvas data-avatar-crop-canvas width="260" height="260" aria-label="プロフィール画像の切り抜き範囲"></canvas></div><div class="avatar-crop-controls"><label>表示範囲<input data-avatar-zoom type="range" min="0.25" max="3" step="0.01" value="1" /></label><button type="button" class="quiet-action" data-avatar-reset>位置と倍率をリセット</button></div></div>
      <div class="avatar-actions"><button type="button" class="primary-action" data-save-avatar disabled>プロフィール画像を保存</button><button type="button" class="quiet-action" data-delete-avatar disabled>画像を削除</button></div>
    </section>

    <button type="button" class="theme-profile-toggle" data-theme-toggle aria-pressed="false">☾ ダークモード</button>

    <div class="workspace-grid">
      <section class="personal-note" aria-labelledby="note-heading"><div class="section-heading"><div><p class="eyebrow">本人専用</p><h2 id="note-heading">個人メモ</h2><p>記事案、次に行うこと、個人的な下調べなどを記録できます。</p></div><output data-note-message aria-live="polite"></output></div><textarea data-private-note maxlength="12000" placeholder="例：次は群作用の記事の具体例を追加する。参考文献：…"></textarea><div class="note-actions"><small data-note-updated></small><button type="button" class="primary-action" data-save-note>個人メモを保存</button></div></section>
      <section class="my-documents" aria-labelledby="projects-heading"><div class="section-heading"><div><p class="eyebrow">PROJECTS</p><h2 id="projects-heading">参加中のプロジェクト</h2><p>プロジェクトを選ぶと、そのプロジェクト専用のページを開けます。</p></div></div><div class="document-list" data-my-documents>読み込み中…</div></section>
    </div>
  </main>
</AdminLayout>

<style>
  .personal-workspace{--surface:var(--background-primary);--alt:var(--background-secondary);--border:var(--border-default);--text:var(--text-primary);--muted:var(--text-secondary);--accent:var(--accent-primary);box-sizing:border-box;color:var(--text);margin:0 auto;max-width:1100px;padding:0 1.25rem 4rem}.workspace-heading{align-items:start;border-bottom:1px solid var(--border);display:flex;gap:1rem;justify-content:space-between;padding:2rem 0 1.25rem}.eyebrow{color:var(--accent);font-size:.76rem;font-weight:800;letter-spacing:.08em;margin:0 0 .35rem}.workspace-heading h1{font-size:clamp(1.8rem,4vw,2.35rem);margin:0}.workspace-heading p:last-child,.section-heading p{color:var(--muted);line-height:1.6;margin:.45rem 0 0}.primary-action{background:var(--accent);border:1px solid var(--accent);color:#fff;cursor:pointer;font:inherit;font-size:.84rem;font-weight:800;min-height:2.35rem;padding:.48rem .7rem;text-decoration:none}.quiet-action{background:var(--surface);border:1px solid var(--border);color:var(--text);cursor:pointer;font:inherit;font-size:.8rem;font-weight:700;min-height:2.35rem;padding:.48rem .7rem}.profile-card,.personal-note,.my-documents{border:1px solid var(--border);border-top:2px solid var(--accent);display:grid;gap:.8rem;margin:1.25rem 0;padding:1rem}.profile-card__top{align-items:center;display:flex;gap:1rem}.profile-identity{display:grid;gap:.25rem;min-width:0}.profile-identity h2{font-size:1.3rem;margin:0;overflow-wrap:anywhere}.profile-identity small{color:var(--muted);line-height:1.55}.avatar-preview{align-items:center;background:linear-gradient(145deg,#2d6ea8,#153c66);background-position:center;background-size:cover;border:1px solid var(--border);border-radius:50%;color:#fff;display:flex;flex:0 0 8rem;font-size:2.1rem;font-weight:800;height:8rem;justify-content:center;overflow:hidden;width:8rem}.profile-facts{display:flex;flex-wrap:wrap;gap:.45rem}.profile-facts span{background:var(--alt);border:1px solid var(--border);display:grid;gap:.08rem;min-width:7rem;padding:.35rem .5rem}.profile-facts b{color:var(--muted);font-size:.66rem}.profile-facts strong{font-size:.82rem;overflow-wrap:anywhere}.profile-card>output{color:var(--muted);font-size:.78rem;min-height:1.1em}.avatar-setting{align-items:start;display:grid;gap:.35rem}.avatar-setting label{display:grid;font-size:.8rem;font-weight:800;gap:.3rem}.avatar-setting input{background:var(--surface);border:1px solid var(--border);box-sizing:border-box;color:var(--text);font:inherit;padding:.5rem;width:100%}.avatar-setting small{color:var(--muted);font-size:.72rem}.avatar-crop{align-items:center;background:var(--alt);border:1px solid var(--border);display:flex;gap:1rem;padding:.75rem}.avatar-crop[hidden]{display:none}.avatar-crop-stage{background:linear-gradient(45deg,#dfe7ee 25%,transparent 25%,transparent 75%,#dfe7ee 75%),linear-gradient(45deg,#dfe7ee 25%,transparent 25%,transparent 75%,#dfe7ee 75%);background-position:0 0,8px 8px;background-size:16px 16px;border:2px solid var(--accent);border-radius:50%;height:13rem;overflow:hidden;width:13rem}.avatar-crop-stage canvas{display:block;height:100%;width:100%}.avatar-crop-controls{display:grid;gap:.6rem;min-width:12rem}.avatar-crop-controls label{display:grid;gap:.3rem;font-size:.76rem;font-weight:800}.avatar-crop-controls input{width:100%}.avatar-actions{align-items:center;display:flex;flex-wrap:wrap;gap:.5rem}.avatar-actions button:disabled{cursor:not-allowed;opacity:.55}.theme-profile-toggle{background:var(--alt);border:1px solid var(--border);color:var(--text);cursor:pointer;font:inherit;font-size:.8rem;font-weight:800;padding:.5rem .7rem}.workspace-grid{display:grid;gap:1rem;grid-template-columns:minmax(0,1fr) minmax(0,1fr);margin-top:1.25rem}.section-heading{align-items:start;display:flex;gap:.75rem;justify-content:space-between}.section-heading h2{font-size:1.1rem;margin:0}.section-heading output{color:var(--muted);font-size:.78rem;max-width:12rem;text-align:right}.personal-note textarea{background:var(--surface);border:1px solid var(--border);box-sizing:border-box;color:var(--text);font:inherit;line-height:1.65;min-height:18rem;padding:.7rem;resize:vertical;width:100%}.note-actions{align-items:center;display:flex;gap:.65rem;justify-content:space-between}.note-actions small{color:var(--muted)}.document-list{display:grid;gap:.5rem}.document-card{background:var(--alt);border-left:3px solid var(--accent);display:grid;gap:.3rem;padding:.65rem .7rem}.document-card-top{align-items:center;display:flex;gap:.5rem;justify-content:space-between}.document-card b{font-size:.9rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.document-card small{color:var(--muted);font-size:.74rem}.state{border:1px solid var(--border);border-radius:999px;color:var(--muted);font-size:.68rem;font-weight:800;padding:.12rem .35rem;white-space:nowrap}.state-in-review{background:#fff0c6;border-color:#efd38a;color:#805500}.state-on-hold{background:#f4e5e7;border-color:#dfbbc1;color:#8a3b49}.state-approved{background:#def4e6;border-color:#a8d8b7;color:#267143}.empty{color:var(--muted);padding:2rem 0;text-align:center}@media(max-width:760px){.personal-workspace{padding:0 .9rem 3rem}.workspace-heading{display:grid}.workspace-heading .primary-action{justify-self:start}.workspace-grid{grid-template-columns:1fr}.profile-card__top{align-items:flex-start}.avatar-preview{flex-basis:6rem;font-size:1.7rem;height:6rem;width:6rem}.avatar-crop{align-items:start;display:grid;justify-items:center}.avatar-crop-controls{min-width:0;width:100%}.avatar-actions{display:grid}.avatar-actions button{width:100%}.note-actions{align-items:start;display:grid}.section-heading{display:grid}.section-heading output{text-align:left}}
  .operator-introductions{border:1px solid var(--border);border-top:2px solid var(--accent);display:grid;gap:1rem;margin:1.25rem 0;padding:1rem}.operator-introductions__heading{align-items:center;border-bottom:1px solid var(--border);padding-bottom:.75rem}.operator-introductions__heading .quiet-action{display:inline-flex;align-items:center;text-decoration:none;white-space:nowrap}.operator-introduction-grid{display:grid;gap:.6rem;grid-template-columns:repeat(auto-fill,minmax(17rem,1fr))}.operator-introduction-card{background:var(--alt);border:1px solid var(--border);display:grid;gap:.3rem;padding:.75rem}.operator-introduction-card h3{font-size:.96rem;margin:0}.operator-introduction-affiliation,.operator-introduction-role{color:var(--muted);font-size:.75rem;line-height:1.45;margin:0}.operator-introduction-role{color:var(--accent);font-weight:800}.operator-introduction-card details{border-top:1px solid var(--border);margin-top:.25rem;padding-top:.4rem}.operator-introduction-card summary{color:var(--accent);cursor:pointer;font-size:.72rem;font-weight:800;list-style:none}.operator-introduction-card summary::-webkit-details-marker{display:none}.operator-introduction-card summary::before{content:"＋ ";font-size:.9rem}.operator-introduction-card details[open] summary::before{content:"− ";}.operator-introduction-card details div{display:grid;gap:.25rem;margin-top:.45rem}.operator-introduction-card details p{color:var(--muted);font-size:.72rem;line-height:1.55;margin:0;white-space:pre-wrap;overflow-wrap:anywhere}@media(max-width:760px){.operator-introductions{padding:.8rem}.operator-introductions__heading{align-items:start}.operator-introduction-grid{grid-template-columns:1fr}.operator-introductions__heading .quiet-action{justify-self:start}}
</style>
<style>
  .project-card-link{color:var(--text-primary);text-decoration:none}.project-card-link:hover{border-color:var(--accent-primary)}
</style>

<script>
  type PersonalDocument={id:string;subject:string;category:string;title:string;status:"draft"|"in-review"|"on-hold"|"approved";updated_at:string;published_at:string|null};
  const initializePersonalWorkspace=()=>{const root=document.querySelector<HTMLElement>("[data-personal-workspace]");if(!root||root.dataset.personalWorkspaceInitialized==="true")return;root.dataset.personalWorkspaceInitialized="true";
    const email=root.querySelector<HTMLElement>("[data-workspace-email]");const note=root.querySelector<HTMLTextAreaElement>("[data-private-note]")!;const noteMessage=root.querySelector<HTMLOutputElement>("[data-note-message]")!;const noteUpdated=root.querySelector<HTMLElement>("[data-note-updated]")!;const documents=root.querySelector<HTMLElement>("[data-my-documents]")!;const saveNote=root.querySelector<HTMLButtonElement>("[data-save-note]")!;const message=root.querySelector<HTMLOutputElement>("[data-profile-message]")!;const profileName=root.querySelector<HTMLElement>("[data-profile-name]")!;const university=root.querySelector<HTMLElement>("[data-profile-university]")!;const year=root.querySelector<HTMLElement>("[data-profile-year]")!;const subjects=root.querySelector<HTMLElement>("[data-my-subjects]")!;const avatarFile=root.querySelector<HTMLInputElement>("[data-profile-avatar]")!;const preview=root.querySelector<HTMLElement>("[data-avatar-preview]")!;const crop=root.querySelector<HTMLElement>("[data-avatar-crop]")!;const canvas=root.querySelector<HTMLCanvasElement>("[data-avatar-crop-canvas]")!;const zoom=root.querySelector<HTMLInputElement>("[data-avatar-zoom]")!;const reset=root.querySelector<HTMLButtonElement>("[data-avatar-reset]")!;const saveAvatar=root.querySelector<HTMLButtonElement>("[data-save-avatar]")!;const deleteAvatar=root.querySelector<HTMLButtonElement>("[data-delete-avatar]")!;
    const esc=(v:string)=>v.replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#39;"}[c]??c));const formatDate=(v:string)=>new Intl.DateTimeFormat("ja-JP",{dateStyle:"medium",timeStyle:"short"}).format(new Date(v));const read=async<T,>(r:Response)=>{if(!(r.headers.get("content-type")??"").includes("application/json"))throw new Error("認証が切れました。ページを再読み込みしてください。");return await r.json() as T};
    let image:HTMLImageElement|null=null,dataUrl="",scale=1,offsetX=0,offsetY=0,drag:{x:number;y:number;ox:number;oy:number}|null=null;
    const draw=()=>{if(!image)return;const ctx=canvas.getContext("2d");if(!ctx)return;const size=canvas.width;const base=Math.max(size/image.naturalWidth,size/image.naturalHeight);const s=base*scale;ctx.clearRect(0,0,size,size);ctx.drawImage(image,(size-image.naturalWidth*s)/2+offsetX,(size-image.naturalHeight*s)/2+offsetY,image.naturalWidth*s,image.naturalHeight*s);dataUrl=canvas.toDataURL("image/jpeg",.84);preview.style.backgroundImage=`url(${JSON.stringify(dataUrl)})`;preview.textContent="";saveAvatar.disabled=false;deleteAvatar.disabled=false;};
    const anonymousMemberLabel=(value:string)=>{const normalized=value.trim().toLowerCase();let hash=2166136261;for(const character of normalized){hash^=character.codePointAt(0)??0;hash=Math.imul(hash,16777619);}return String((hash>>>0)%9000+1000);};
    const loadProfile=async()=>{try{const r=await fetch("/api/admin/profile",{credentials:"same-origin",cache:"no-store"});const d=await read<{profile?:{email?:string;display_name?:string;avatar_url?:string;university?:string;year?:string};subjects?:string[];roles?:string[];error?:string}>(r);if(!r.ok)throw new Error(d.error??"プロフィールを読み込めませんでした。");const profileLabel=d.profile?.display_name?.trim();profileName.textContent=profileLabel&&profileLabel!=="表示名未設定"?profileLabel:anonymousMemberLabel(d.profile?.email??"");university.textContent=d.profile?.university?.trim()||"未登録";year.textContent=d.profile?.year?.trim()||"未登録";subjects.textContent=(d.roles?.length?d.roles:d.subjects)?.join("・")||"未設定";dataUrl=d.profile?.avatar_url??"";preview.style.backgroundImage=dataUrl?`url(${JSON.stringify(dataUrl)})`:"";preview.textContent=dataUrl?"":"A";deleteAvatar.disabled=!dataUrl;}catch(e){message.value=e instanceof Error?e.message:"プロフィールを読み込めませんでした。";}};
    const saveAvatarData=async()=>{message.value="保存中…";const r=await fetch("/api/admin/profile",{method:"PUT",credentials:"same-origin",headers:{"content-type":"application/json"},body:JSON.stringify({avatarUrl:dataUrl})});const d=await read<{error?:string}>(r);if(!r.ok)throw new Error(d.error??"プロフィール画像を保存できませんでした。");message.value="プロフィール画像を保存しました。";document.dispatchEvent(new CustomEvent("atlasez-profile-updated",{detail:{avatarUrl:dataUrl}}));};
    avatarFile.addEventListener("change",()=>{const f=avatarFile.files?.[0];if(!f)return;if(f.size>2_000_000){message.value="画像は2MB以下にしてください。";avatarFile.value="";return}const reader=new FileReader();reader.onload=()=>{const next=new Image();next.onload=()=>{image=next;scale=1;offsetX=0;offsetY=0;zoom.value="1";crop.hidden=false;draw();message.value="表示範囲を調整して保存してください。"};next.src=String(reader.result??"")};reader.readAsDataURL(f)});zoom.addEventListener("input",()=>{scale=Number(zoom.value);draw()});reset.addEventListener("click",()=>{scale=1;offsetX=0;offsetY=0;zoom.value="1";draw()});canvas.addEventListener("pointerdown",e=>{if(!image)return;drag={x:e.clientX,y:e.clientY,ox:offsetX,oy:offsetY};canvas.setPointerCapture(e.pointerId)});canvas.addEventListener("pointermove",e=>{if(!drag)return;offsetX=drag.ox+(e.clientX-drag.x)*2;offsetY=drag.oy+(e.clientY-drag.y)*2;draw()});canvas.addEventListener("pointerup",()=>{drag=null});saveAvatar.addEventListener("click",()=>{saveAvatar.disabled=true;void saveAvatarData().catch(e=>{message.value=e instanceof Error?e.message:"保存できませんでした。"}).finally(()=>{saveAvatar.disabled=false})});deleteAvatar.addEventListener("click",()=>{dataUrl="";image=null;crop.hidden=true;avatarFile.value="";preview.style.backgroundImage="";preview.textContent="A";deleteAvatar.disabled=true;void saveAvatarData().catch(e=>{message.value=e instanceof Error?e.message:"削除できませんでした。"})});
    const load=async()=>{try{const r=await fetch("/api/admin/personal-workspace",{credentials:"same-origin",cache:"no-store"});const d=await read<{email?:string;privateNote?:string;privateNoteUpdatedAt?:string|null;documents?:PersonalDocument[];error?:string}>(r);if(!r.ok)throw new Error(d.error??"個人ワークスペースを読み込めませんでした。");if(email&&d.email)email.textContent=d.email;note.value=d.privateNote??"";noteUpdated.textContent=d.privateNoteUpdatedAt?`最終保存：${formatDate(d.privateNoteUpdatedAt)}`:"まだ保存されていません";const labels={draft:"下書き","in-review":"査読中","on-hold":"保留",approved:"査読済み"} as const;documents.innerHTML=(d.documents??[]).length?(d.documents??[]).map(i=>`<article class="document-card"><div class="document-card-top"><b>${esc(i.title||"無題の原稿")}</b><span class="state state-${i.status}">${labels[i.status]}</span></div><small>${esc(i.subject)} / ${esc(i.category)} ・ 最終更新 ${formatDate(i.updated_at)}${i.published_at?" ・ 公開済み":""}</small></article>`).join(""):"<p class=\"empty\">自分が作成した原稿はまだありません。</p>"}catch(e){documents.innerHTML=`<p class="empty">${esc(e instanceof Error?e.message:"読み込めませんでした")}</p>`}};saveNote.addEventListener("click",async()=>{saveNote.disabled=true;noteMessage.value="保存中…";try{const r=await fetch("/api/admin/personal-workspace",{method:"PUT",credentials:"same-origin",headers:{"content-type":"application/json"},body:JSON.stringify({privateNote:note.value})});const d=await read<{updatedAt?:string;error?:string}>(r);if(!r.ok)throw new Error(d.error??"保存できませんでした。");noteUpdated.textContent=d.updatedAt?`最終保存：${formatDate(d.updatedAt)}`:"保存しました";noteMessage.value="保存しました。"}catch(e){noteMessage.value=e instanceof Error?e.message:"保存できませんでした。"}finally{saveNote.disabled=false}});void loadProfile();void load();
  };document.addEventListener("astro:page-load",initializePersonalWorkspace);initializePersonalWorkspace();
</script>
<script>
  (() => {
    const renderMemberProjects = async () => {
      const list = document.querySelector<HTMLElement>('[data-my-documents]');
      if (!list) return;
      try {
        const response = await fetch('/api/admin/personal-workspace', { credentials: 'same-origin', cache: 'no-store' });
        const data = await response.json() as { projects?: Array<{ slug: string; name: string; description?: string | null }> };
        if (!response.ok) return;
        const escape = (value: string) => value.replace(/[&<>"']/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[character] ?? character);
        list.innerHTML = data.projects?.length ? data.projects.map((project) => `<a class="document-card project-card-link" href="${project.slug === 'atlas' ? '/admin/atlas/' : `/admin/projects/${encodeURIComponent(project.slug)}/`}"><div class="document-card-top"><b>${escape(project.name)}</b></div><small>${escape(project.description ?? '')}</small></a>`).join('') : '<p class="empty">参加中のプロジェクトはまだありません。</p>';
      } catch { /* 既存の読み込みエラー表示を優先する */ }
    };
    document.addEventListener('astro:page-load', () => { void renderMemberProjects(); });
    void renderMemberProjects();
  })();
</script>
