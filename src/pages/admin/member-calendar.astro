---
import AdminLayout from "../../layouts/AdminLayout.astro";
---
<AdminLayout title="カレンダー" description="参加中のプロジェクトの日程を横断表示します">
  <main class="member-calendar" data-member-calendar>
    <header><h1>カレンダー</h1></header>
    <section>
      <div class="toolbar"><button type="button" data-prev aria-label="前の月">‹</button><strong data-title>読み込み中…</strong><button type="button" data-next aria-label="次の月">›</button><button type="button" class="settings" data-settings>⚙️ 設定</button></div>
      <div class="project-filters" data-project-filters></div>
      <div class="calendar-grid" data-grid aria-label="参加中のプロジェクトのカレンダー"></div>
      <dialog data-dialog><form method="dialog"><div class="dialog-head"><strong>カレンダー設定</strong><button aria-label="設定を閉じる">×</button></div><label>表示タイムゾーン<input data-timezone list="member-calendar-timezones" value="Asia/Tokyo" placeholder="地域名・都市名で検索" /><small data-timezone-offset></small></label><label>暦<select data-system><option value="gregory">西暦（グレゴリオ暦）</option><option value="japanese">和暦（日本）</option></select></label><div><label for="member-calendar-holiday-search">祝日の地域</label><div class="holiday-chips" data-holiday-chips></div><input id="member-calendar-holiday-search" type="search" data-holiday-search placeholder="国・地域名またはコードで検索して追加" autocomplete="off" /><div class="holiday-options" data-holiday-options></div></div><button value="close">閉じる</button></form></dialog>
      <datalist id="member-calendar-timezones"></datalist>
    </section>
    <section class="agenda"><h2>開催予定</h2><div data-event-list>読み込み中…</div></section>
  </main>
</AdminLayout>
<style>
  .member-calendar{margin:0 auto;max-width:1200px;padding:0 1.25rem 4rem}.member-calendar>header{border-bottom:1px solid var(--border-default);padding:2rem 0 1.25rem}.member-calendar h1{font-size:clamp(1.8rem,4vw,2.35rem);margin:0}.member-calendar>section{margin-top:1.2rem}.toolbar{align-items:center;display:flex;flex-wrap:wrap;gap:.55rem;justify-content:center}.toolbar strong{min-width:12rem;text-align:center}.toolbar button{background:var(--background-primary);border:1px solid var(--border-default);border-radius:.4rem;color:var(--text-primary);cursor:pointer;font:inherit;padding:.4rem .65rem}.toolbar .settings{margin-left:auto}.project-filters{display:flex;flex-wrap:wrap;gap:.4rem;margin:.8rem 0}.project-filters label{align-items:center;background:var(--background-secondary);border:1px solid var(--border-default);display:flex;font-size:.74rem;gap:.3rem;padding:.3rem .5rem}.calendar-grid{background:var(--border-default);border:1px solid var(--border-default);display:grid;gap:1px;grid-template-columns:repeat(7,minmax(0,1fr))}.calendar-cell{background:var(--background-primary);border:0;color:var(--text-primary);min-height:6.7rem;padding:.4rem;text-align:left}.calendar-cell--blank,.calendar-weekday{background:var(--background-secondary);min-height:auto}.calendar-day{display:block;font-size:.76rem;font-weight:800}.calendar-cell--today{box-shadow:inset 0 0 0 3px var(--accent-primary)}.calendar-cell--today .calendar-day{background:var(--accent-primary);border-radius:999px;color:#fff;display:grid;height:1.7rem;place-items:center;width:1.7rem}.calendar-event{border-left:3px solid var(--accent-primary);display:block;font-size:.68rem;margin-top:.25rem;overflow:hidden;padding-left:.3rem;text-overflow:ellipsis;white-space:nowrap}.agenda{border:1px solid var(--border-default);padding:1rem}.agenda h2{font-size:1.1rem;margin:0 0 .75rem}.event-list{display:grid;gap:.7rem;grid-template-columns:repeat(auto-fit,minmax(17rem,1fr))}.event{border:1px solid var(--border-default);display:grid;gap:.45rem;padding:.85rem}.event time,.event .project{color:var(--accent-primary);font-size:.78rem;font-weight:800}.event small{color:var(--text-secondary);white-space:pre-wrap}.availability{display:flex;flex-wrap:wrap;gap:.35rem}.availability button{background:var(--background-primary);border:1px solid var(--border-default);color:var(--text-primary);cursor:pointer;font:inherit;font-size:.72rem;padding:.32rem .45rem}.availability button.is-selected{background:var(--accent-primary);color:#fff}dialog{background:var(--background-primary);border:1px solid var(--border-default);color:var(--text-primary);max-width:34rem;padding:0;width:calc(100% - 2rem)}dialog::backdrop{background:#001a2c66}dialog form{display:grid;gap:.75rem;padding:1rem}dialog label{display:grid;font-size:.8rem;gap:.25rem}dialog input,dialog select{background:var(--background-primary);border:1px solid var(--border-default);box-sizing:border-box;color:var(--text-primary);font:inherit;padding:.45rem;width:100%}.dialog-head{display:flex;justify-content:space-between}.dialog-head button{background:transparent;border:0;color:var(--text-primary);font-size:1.2rem}.holiday-chips{display:flex;flex-wrap:wrap;gap:.35rem;margin:.4rem 0}.holiday-chip{background:var(--background-secondary);border:1px solid var(--border-default);border-radius:999px;font-size:.74rem;padding:.2rem .45rem}.holiday-chip button{background:transparent;border:0;color:inherit;cursor:pointer}.holiday-options{display:grid;gap:.2rem;margin-top:.35rem;max-height:9rem;overflow:auto}.holiday-options button{background:transparent;border:0;color:var(--text-primary);cursor:pointer;padding:.35rem;text-align:left}.empty{color:var(--text-secondary)}@media(max-width:700px){.member-calendar{padding:0 .8rem 3rem}.calendar-cell{min-height:4.8rem}.calendar-event{font-size:0;width:.45rem}.event-list{grid-template-columns:1fr}}
</style>
<script>
  import { formatUtcOffset,getTimeZoneOptions,isValidTimeZone,timeZoneOffsetMinutes,zonedWallTimeToDate } from '../../lib/timezones';
  import { supportedHolidayRegions } from '../../lib/calendar-support';
  type Project={id:string;name:string};type EventRow={id:string;project_id:string;title:string;details?:string;starts_at:string;ends_at?:string|null;timezone:string;availability?:string|null;availabilityCounts?:Record<string,number>};type Data={projects?:Project[];events?:EventRow[];error?:string};
  const initialize=()=>{const root=document.querySelector<HTMLElement>('[data-member-calendar]');if(!root||root.dataset.ready)return;root.dataset.ready='true';const get=<T extends Element>(selector:string)=>root.querySelector<T>(selector)!;const grid=get<HTMLElement>('[data-grid]'),title=get<HTMLElement>('[data-title]'),list=get<HTMLElement>('[data-event-list]'),timezone=get<HTMLInputElement>('[data-timezone]'),system=get<HTMLSelectElement>('[data-system]'),dialog=get<HTMLDialogElement>('[data-dialog]');let data:Data={},month=new Date();month=new Date(month.getFullYear(),month.getMonth(),1);
    const escape=(value:unknown)=>String(value??'').replace(/[&<>"']/g,character=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[character]??character));get<HTMLDataListElement>('#member-calendar-timezones').innerHTML=getTimeZoneOptions().map(option=>`<option value="${escape(option.value)}" label="${escape(option.label)}"></option>`).join('');try{timezone.value=Intl.DateTimeFormat().resolvedOptions().timeZone||'Asia/Tokyo'}catch{}
    const selectedTimezone=()=>isValidTimeZone(timezone.value.trim())?timezone.value.trim():'Asia/Tokyo';const selectedProjects=()=>new Set([...root.querySelectorAll<HTMLInputElement>('[data-project-filter]:checked')].map(input=>input.value));const projectMap=()=>new Map((data.projects??[]).map(project=>[project.id,project.name]));const eventDate=(event:EventRow)=>zonedWallTimeToDate(event.starts_at,event.timezone||'Asia/Tokyo');const key=(date:Date)=>{const parts=new Intl.DateTimeFormat('en-CA',{timeZone:selectedTimezone(),year:'numeric',month:'2-digit',day:'2-digit'}).formatToParts(date);const values=Object.fromEntries(parts.filter(part=>part.type!=='literal').map(part=>[part.type,part.value]));return `${values.year}-${values.month}-${values.day}`};const format=(event:EventRow)=>new Intl.DateTimeFormat('ja-JP',{dateStyle:'full',timeStyle:'short',timeZone:selectedTimezone()}).format(eventDate(event));
    const render=()=>{const allowed=selectedProjects(),events=(data.events??[]).filter(event=>allowed.has(event.project_id)),first=new Date(month.getFullYear(),month.getMonth(),1),last=new Date(month.getFullYear(),month.getMonth()+1,0),today=key(new Date());title.textContent=new Intl.DateTimeFormat(`ja-JP-u-ca-${system.value}`,{year:'numeric',month:'long'}).format(first);const cells=['日','月','火','水','木','金','土'].map(day=>`<span class="calendar-cell calendar-weekday">${day}</span>`);for(let index=0;index<first.getDay();index++)cells.push('<span class="calendar-cell calendar-cell--blank"></span>');for(let day=1;day<=last.getDate();day++){const dayKey=`${month.getFullYear()}-${String(month.getMonth()+1).padStart(2,'0')}-${String(day).padStart(2,'0')}`,dayEvents=events.filter(event=>key(eventDate(event))===dayKey);cells.push(`<div class="calendar-cell${dayKey===today?' calendar-cell--today':''}"${dayKey===today?' aria-current="date"':''}><span class="calendar-day">${day}</span>${dayEvents.map(event=>`<span class="calendar-event">${escape(projectMap().get(event.project_id))}: ${escape(event.title)}</span>`).join('')}</div>`)}grid.innerHTML=cells.join('');const upcoming=events.filter(event=>eventDate(event).getTime()>=Date.now()).sort((a,b)=>eventDate(a).getTime()-eventDate(b).getTime());list.className='event-list';list.innerHTML=upcoming.length?upcoming.map(event=>{const counts=event.availabilityCounts??{};return `<article class="event"><span class="project">${escape(projectMap().get(event.project_id)??event.project_id)}</span><strong>${escape(event.title)}</strong><time>${escape(format(event))}</time>${event.details?`<small>${escape(event.details)}</small>`:''}<span class="availability"><button type="button" data-event="${escape(event.id)}" data-availability="available" class="${event.availability==='available'?'is-selected':''}">参加 ${counts.available??0}</button><button type="button" data-event="${escape(event.id)}" data-availability="maybe" class="${event.availability==='maybe'?'is-selected':''}">未定 ${counts.maybe??0}</button><button type="button" data-event="${escape(event.id)}" data-availability="unavailable" class="${event.availability==='unavailable'?'is-selected':''}">不参加 ${counts.unavailable??0}</button></span></article>`}).join(''):'<p class="empty">開催予定はありません。</p>'};
    const regions=supportedHolidayRegions().map(region=>({code:region.code,label:region.name})),holidaySearch=get<HTMLInputElement>('[data-holiday-search]'),holidayChips=get<HTMLElement>('[data-holiday-chips]'),holidayOptions=get<HTMLElement>('[data-holiday-options]');let holidays=['JP'];const renderHolidays=()=>{holidayChips.innerHTML=holidays.map(code=>`<span class="holiday-chip">${escape(regions.find(region=>region.code===code)?.label??code)}<button type="button" data-remove-holiday="${code}" aria-label="削除">×</button></span>`).join('');const query=holidaySearch.value.trim().toLowerCase();holidayOptions.innerHTML=regions.filter(region=>!holidays.includes(region.code)&&(!query||region.label.toLowerCase().includes(query)||region.code.toLowerCase().includes(query))).map(region=>`<button type="button" data-add-holiday="${region.code}">${region.label}</button>`).join('')||'<small>追加できる地域はありません。</small>'};const updateOffset=()=>get<HTMLElement>('[data-timezone-offset]').textContent=isValidTimeZone(timezone.value.trim())?`現在のオフセット: ${formatUtcOffset(timeZoneOffsetMinutes(timezone.value.trim()))}`:'IANAタイムゾーンを候補から選択してください。';
    const load=async()=>{const response=await fetch('/api/admin/member-calendar',{credentials:'same-origin',cache:'no-store'}),loaded=await response.json() as Data;if(!response.ok)throw new Error(loaded.error??'日程を読み込めませんでした。');data=loaded;get<HTMLElement>('[data-project-filters]').innerHTML=(data.projects??[]).map(project=>`<label><input type="checkbox" data-project-filter value="${escape(project.id)}" checked />${escape(project.name)}</label>`).join('');render()};
    get<HTMLButtonElement>('[data-prev]').addEventListener('click',()=>{month=new Date(month.getFullYear(),month.getMonth()-1,1);render()});get<HTMLButtonElement>('[data-next]').addEventListener('click',()=>{month=new Date(month.getFullYear(),month.getMonth()+1,1);render()});get<HTMLButtonElement>('[data-settings]').addEventListener('click',()=>{renderHolidays();dialog.showModal()});get<HTMLElement>('[data-project-filters]').addEventListener('change',render);timezone.addEventListener('input',()=>{updateOffset();render()});system.addEventListener('change',render);holidaySearch.addEventListener('input',renderHolidays);dialog.addEventListener('click',event=>{const target=event.target as HTMLElement,add=target.closest<HTMLButtonElement>('[data-add-holiday]')?.dataset.addHoliday,remove=target.closest<HTMLButtonElement>('[data-remove-holiday]')?.dataset.removeHoliday;if(add)holidays.push(add);if(remove)holidays=holidays.filter(code=>code!==remove);if(add||remove){holidaySearch.value='';renderHolidays()}});list.addEventListener('click',async event=>{const button=(event.target as HTMLElement).closest<HTMLButtonElement>('[data-availability]');if(!button)return;button.disabled=true;const response=await fetch(`/api/admin/operations/events/${encodeURIComponent(button.dataset.event??'')}/availability`,{method:'PUT',credentials:'same-origin',headers:{'content-type':'application/json'},body:JSON.stringify({availability:button.dataset.availability})});button.disabled=false;if(response.ok)await load()});updateOffset();void load().catch(error=>list.textContent=error instanceof Error?error.message:'読み込めませんでした。')};document.addEventListener('astro:page-load',initialize);initialize();
</script>
