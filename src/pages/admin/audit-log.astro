---
import AdminLayout from "../../layouts/AdminLayout.astro";
---

<AdminLayout title="操作履歴" description="公開・承認・権限変更などの操作履歴">
  <main class="audit-page" data-audit-page>
    <header class="audit-heading">
      <div><h1>操作履歴</h1></div>
      <a href="/admin/atlas/">← 管理トップ</a>
    </header>
    <section class="audit-panel" aria-labelledby="audit-list-title">
      <form class="audit-filters" data-audit-filters role="search">
        <label class="audit-search">検索<input type="search" name="q" placeholder="実行者・対象・内容を検索" autocomplete="off" /></label>
        <label>操作<select name="action"><option value="">すべて</option><option value="article_created">記事を作成</option><option value="article_updated">記事を更新</option><option value="article_approved">記事を承認</option><option value="article_published">記事を公開</option><option value="article_unpublished">記事の公開を取り消し</option><option value="permission_granted">権限を付与</option><option value="permission_replaced">権限を変更</option><option value="permission_revoked">権限を削除</option><option value="member_removed">運営メンバーを削除</option><option value="task_archived">タスクをアーカイブ</option><option value="task_restored">タスクを復元</option></select></label>
        <label>対象<select name="targetType"><option value="">すべて</option><option value="article">記事</option><option value="permission">権限</option><option value="member">メンバー</option><option value="task">タスク</option></select></label>
        <button type="reset" class="audit-reset">条件をリセット</button>
      </form>
      <div class="audit-toolbar"><h2 id="audit-list-title">記録</h2><output data-audit-count aria-live="polite">読み込み中…</output></div>
      <div class="audit-state" data-audit-state role="status" aria-live="polite">読み込み中…</div>
      <div class="audit-list" data-audit-list hidden></div>
      <button type="button" class="audit-next" data-audit-next hidden>次の100件を読み込む</button>
      <button type="button" class="audit-retry" data-audit-retry hidden>再試行</button>
    </section>
    <dialog class="audit-dialog" data-audit-dialog aria-labelledby="audit-dialog-title">
      <form method="dialog" class="dialog-close-form"><button class="dialog-close" aria-label="詳細を閉じる">×</button></form>
      <p class="dialog-kicker" data-dialog-action></p><h2 id="audit-dialog-title" data-dialog-title>操作の詳細</h2>
      <dl class="dialog-meta"><div><dt>実行者</dt><dd data-dialog-actor>—</dd></div><div><dt>日時</dt><dd data-dialog-date>—</dd></div><div><dt>対象</dt><dd data-dialog-target>—</dd></div></dl>
      <p class="dialog-summary" data-dialog-summary></p><pre class="dialog-details" data-dialog-details hidden></pre>
      <div class="dialog-actions"><button type="submit" class="dialog-secondary">閉じる</button></div>
    </dialog>
  </main>
</AdminLayout>

<script>
  const initializeAuditPage = () => {
    const root = document.querySelector<HTMLElement>("[data-audit-page]");
    if (!root || root.dataset.initialized === "true") return;
    root.dataset.initialized = "true";
    const form = root.querySelector<HTMLFormElement>("[data-audit-filters]")!;
    const list = root.querySelector<HTMLElement>("[data-audit-list]")!;
    const state = root.querySelector<HTMLElement>("[data-audit-state]")!;
    const retry = root.querySelector<HTMLButtonElement>("[data-audit-retry]")!;
    const next = root.querySelector<HTMLButtonElement>("[data-audit-next]")!;
    const count = root.querySelector<HTMLOutputElement>("[data-audit-count]")!;
    const dialog = root.querySelector<HTMLDialogElement>("[data-audit-dialog]")!;
    const escape = (value: unknown) => String(value ?? "").replace(/[&<>'"]/g, (character) => ({"&":"&amp;","<":"&lt;",">":"&gt;","'":"&#39;",'"':"&quot;"}[character] ?? character));
    const formatDate = (value: string) => { const date = new Date(value); return Number.isNaN(date.getTime()) ? value : new Intl.DateTimeFormat("ja-JP", { dateStyle: "medium", timeStyle: "short" }).format(date); };
    const targetLabel = (type: string) => ({ article: "記事", permission: "権限", member: "メンバー", task: "タスク" }[type] ?? type);
    let nextCursor = "";
    let loading = false;
    const bindRows = () => list.querySelectorAll<HTMLButtonElement>("[data-audit-entry]").forEach((button) => button.addEventListener("click", () => {
      const entry = JSON.parse(button.dataset.auditEntry ?? "{}");
      root.querySelector<HTMLElement>("[data-dialog-action]")!.textContent = String(entry.actionLabel ?? entry.action ?? "");
      root.querySelector<HTMLElement>("[data-dialog-title]")!.textContent = String(entry.summary ?? "操作の詳細");
      root.querySelector<HTMLElement>("[data-dialog-actor]")!.textContent = String(entry.actor_email ?? "—");
      root.querySelector<HTMLElement>("[data-dialog-date]")!.textContent = formatDate(String(entry.created_at ?? ""));
      root.querySelector<HTMLElement>("[data-dialog-target]")!.textContent = `${targetLabel(String(entry.target_type ?? ""))} · ${String(entry.target_label ?? entry.target_id ?? "—")}`;
      root.querySelector<HTMLElement>("[data-dialog-summary]")!.textContent = String(entry.summary ?? "");
      const details = root.querySelector<HTMLElement>("[data-dialog-details]")!; let parsed: unknown = null; try { parsed = JSON.parse(String(entry.details_json ?? "{}")); } catch { parsed = null; } details.textContent = parsed && typeof parsed === "object" ? JSON.stringify(parsed, null, 2) : ""; details.hidden = !details.textContent;
      if (typeof dialog.showModal === "function") dialog.showModal();
    }));
    const load = async (cursor = "", append = false) => {
      if (loading) return;
      loading = true;
      if (!append) { state.hidden = false; list.hidden = true; retry.hidden = true; next.hidden = true; state.textContent = "読み込み中…"; }
      root.setAttribute("aria-busy", "true");
      next.disabled = true;
      const params = new URLSearchParams();
      new FormData(form).forEach((value, key) => params.set(key, String(value)));
      params.set("limit", "100");
      if (cursor) params.set("cursor", cursor);
      try {
        const response = await fetch(`/api/admin/audit-log?${params}`, { credentials: "same-origin", cache: "no-store" });
        if (!response.ok) throw new Error("操作履歴を読み込めませんでした。");
        const data = await response.json() as { entries?: Array<Record<string, unknown>>; pagination?: { nextCursor?: string | null } };
        const entries = Array.isArray(data.entries) ? data.entries : [];
        const html = entries.map((entry) => `<button type="button" class="audit-row" data-audit-entry='${escape(JSON.stringify(entry))}'><time datetime="${escape(entry.created_at)}">${escape(formatDate(String(entry.created_at ?? "")))}</time><span class="audit-action">${escape(entry.actionLabel ?? entry.action)}</span><span class="audit-copy"><strong>${escape(entry.summary)}</strong><small>${escape(entry.target_label)} · ${escape(entry.actor_email)}</small></span><span class="audit-target">${escape(targetLabel(String(entry.target_type ?? "")))}</span><span class="audit-chevron" aria-hidden="true">›</span></button>`).join("");
        if (append) list.insertAdjacentHTML("beforeend", html); else list.innerHTML = html;
        count.value = `${list.querySelectorAll("[data-audit-entry]").length}件`;
        nextCursor = String(data.pagination?.nextCursor ?? "");
        next.hidden = !nextCursor;
        if (!entries.length && !append) { state.textContent = "操作履歴はまだありません。"; return; }
        state.hidden = true; list.hidden = false;
        bindRows();
      } catch (error) { count.value = "—"; state.textContent = error instanceof Error ? error.message : "操作履歴を読み込めませんでした。"; retry.hidden = false; }
      finally { loading = false; next.disabled = false; root.removeAttribute("aria-busy"); }
    };
    form.addEventListener("input", () => void load()); form.addEventListener("change", () => void load()); form.addEventListener("reset", () => requestAnimationFrame(() => void load())); retry.addEventListener("click", () => void load()); next.addEventListener("click", () => void load(nextCursor, true)); void load();
  };
  document.addEventListener("astro:page-load", initializeAuditPage); initializeAuditPage();
</script>

<style>
  .audit-page{margin:0 auto;max-width:1120px;padding:0 1.25rem 4rem}.audit-heading{align-items:end;border-bottom:1px solid var(--border-default);display:flex;justify-content:space-between;padding:2rem 0 1.15rem}.audit-heading h1{font-size:clamp(1.8rem,4vw,2.45rem);margin:0}.audit-heading a{color:var(--accent-primary);font-size:.8rem;font-weight:800;text-decoration:none;white-space:nowrap}.audit-panel{border:1px solid var(--border-default);margin-top:1.1rem;padding:1rem}.audit-filters{align-items:end;border-bottom:1px solid var(--border-default);display:grid;gap:.6rem;grid-template-columns:minmax(14rem,1fr) 12rem 10rem auto;padding-bottom:1rem}.audit-filters label{color:var(--text-secondary);display:grid;font-size:.72rem;font-weight:800;gap:.3rem}.audit-filters input,.audit-filters select,.audit-reset{background:var(--background-primary);border:1px solid var(--border-default);border-radius:.3rem;color:var(--text-primary);font:inherit;min-height:2.25rem;padding:.42rem .55rem}.audit-reset{cursor:pointer;font-size:.72rem}.audit-reset:hover,.audit-retry:hover,.audit-next:hover{border-color:var(--accent-primary)}.audit-toolbar{align-items:center;display:flex;justify-content:space-between;padding:.9rem 0 .55rem}.audit-toolbar h2{font-size:1rem;margin:0}.audit-toolbar output{color:var(--text-secondary);font-size:.75rem}.audit-state{color:var(--text-secondary);padding:2.5rem;text-align:center}.audit-list{border-top:1px solid var(--border-default)}.audit-row{align-items:center;background:transparent;border:0;border-bottom:1px solid var(--border-default);color:var(--text-primary);cursor:pointer;display:grid;gap:.7rem;grid-template-columns:9rem 9rem minmax(0,1fr) 5rem 1rem;min-height:4.2rem;padding:.62rem .3rem;text-align:left;width:100%}.audit-row:hover{background:var(--background-secondary)}.audit-row time,.audit-target{color:var(--text-secondary);font-size:.72rem}.audit-action{color:var(--accent-primary);font-size:.72rem;font-weight:800}.audit-copy{min-width:0}.audit-copy strong,.audit-copy small{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.audit-copy strong{font-size:.82rem}.audit-copy small{color:var(--text-secondary);font-size:.7rem;margin-top:.2rem}.audit-chevron{color:var(--accent-primary);font-size:1.15rem}.audit-next,.audit-retry{background:transparent;border:1px solid var(--border-default);border-radius:.3rem;color:var(--text-primary);cursor:pointer;display:block;margin:.8rem auto;padding:.45rem .8rem}.audit-next:disabled{cursor:wait;opacity:.6}.audit-dialog{background:var(--background-secondary);border:1px solid var(--border-default);border-radius:.5rem;color:var(--text-primary);max-width:36rem;padding:1.2rem;width:calc(100% - 2rem)}.audit-dialog::backdrop{background:rgb(0 0 0 / .55)}.dialog-close-form{display:flex;justify-content:flex-end}.dialog-close{background:transparent;border:0;color:var(--text-secondary);cursor:pointer;font-size:1.2rem}.dialog-kicker{color:var(--accent-primary);font-size:.72rem;font-weight:800;margin:.1rem 0}.audit-dialog h2{font-size:1.15rem;margin:.35rem 0 .9rem}.dialog-meta{border-bottom:1px solid var(--border-default);border-top:1px solid var(--border-default);display:grid;gap:.6rem;grid-template-columns:repeat(2,1fr);margin:0;padding:.75rem 0}.dialog-meta div{display:grid;gap:.15rem}.dialog-meta dt{color:var(--text-secondary);font-size:.68rem;font-weight:800}.dialog-meta dd{font-size:.76rem;margin:0;overflow-wrap:anywhere}.dialog-summary{font-size:.82rem;line-height:1.65;margin:.9rem 0}.dialog-details{background:var(--background-primary);border:1px solid var(--border-default);font: .7rem/1.5 ui-monospace,SFMono-Regular,Menlo,monospace;max-height:14rem;overflow:auto;padding:.7rem;white-space:pre-wrap}.dialog-actions{display:flex;justify-content:flex-end}.dialog-secondary{background:transparent;border:1px solid var(--border-default);border-radius:.3rem;color:var(--text-secondary);cursor:pointer;padding:.45rem .7rem}@media(max-width:720px){.audit-page{padding:0 .8rem 3rem}.audit-heading{align-items:start;display:grid;gap:.6rem}.audit-filters{grid-template-columns:1fr 1fr}.audit-search{grid-column:1/-1}.audit-row{grid-template-columns:6rem minmax(0,1fr) 1rem}.audit-action{display:none}.audit-target{display:none}}@media(max-width:420px){.audit-filters{grid-template-columns:1fr}.audit-search{grid-column:auto}}
.audit-next[hidden],.audit-retry[hidden]{display:none}
</style>
