---
import AdminLayout from "../../layouts/AdminLayout.astro";
---

<AdminLayout title="メンバー情報の承認" description="メンバー情報とアトラス運営内自己紹介の変更申請を処理します">
  <main class="profile-requests" data-profile-requests>
    <header class="approval-hero">
      <div><p class="approval-eyebrow">運営事務局</p><h1>メンバー情報の承認</h1><p class="approval-lead">共通プロフィールと学習サイト「アトラス」の運営内自己紹介を、ここでまとめて確認・承認できます。</p></div>
      <div class="approval-hero-mark" aria-hidden="true">✓</div>
    </header>
    <section class="approval-toolbar" aria-label="申請一覧の操作">
      <div class="toolbar-heading"><div><p class="approval-eyebrow">承認対象</p><h2>メンバー情報と運営内自己紹介</h2></div><output class="request-count" data-count aria-live="polite">読み込み中…</output></div>
      <div class="status-tabs" role="group" aria-label="申請状態"><button type="button" class="status-tab is-selected" data-status="pending" aria-pressed="true"><span class="status-dot pending-dot" aria-hidden="true"></span>承認待ち</button><button type="button" class="status-tab" data-status="all" aria-pressed="false"><span class="status-dot all-dot" aria-hidden="true"></span>すべて</button></div>
    </section>
    <output class="approval-message" data-message aria-live="polite"></output>
    <div class="request-groups">
      <section class="request-group" aria-labelledby="common-profile-heading"><header class="request-group-heading"><div><p class="approval-eyebrow">共通プロフィール</p><h2 id="common-profile-heading">メンバー情報の変更</h2></div><output class="request-count" data-common-count aria-live="polite">読み込み中…</output></header><div class="request-list" data-list aria-label="メンバー情報変更申請一覧"><p class="loading-state">申請を読み込んでいます…</p></div></section>
      <section class="request-group" aria-labelledby="atlas-profile-heading"><header class="request-group-heading"><div><p class="approval-eyebrow">学習サイト「アトラス」</p><h2 id="atlas-profile-heading">運営内自己紹介の変更</h2></div><output class="request-count" data-atlas-count aria-live="polite">読み込み中…</output></header><div class="request-list" data-atlas-list aria-label="アトラス運営内自己紹介変更申請一覧"><p class="loading-state">申請を読み込んでいます…</p></div></section>
    </div>
  </main>
</AdminLayout>

<style is:global>
  .profile-requests{background:#fff;box-sizing:border-box;color:#17324d;min-height:calc(100vh - 4.15rem);margin:0 auto;max-width:1240px;padding:0 clamp(1rem,4vw,3rem) 5rem}.approval-hero{align-items:center;border-bottom:1px solid #d8e4ed;display:flex;gap:2rem;justify-content:space-between;padding:2.4rem 0 1.8rem}.approval-eyebrow{color:#287daf;font-size:.7rem;font-weight:900;letter-spacing:.1em;margin:0 0 .4rem;text-transform:uppercase}.approval-hero h1{color:#123b5d;font-size:clamp(1.6rem,3vw,2.25rem);letter-spacing:.01em;line-height:1.3;margin:0}.approval-lead{color:#526b7d;font-size:.82rem;line-height:1.7;margin:.55rem 0 0}.approval-hero-mark{align-items:center;background:#e9f4fb;border:1px solid #9bc7df;border-radius:50%;color:#176ea6;display:flex;flex:0 0 3.65rem;font-size:1.9rem;font-weight:900;height:3.65rem;justify-content:center}.approval-toolbar{align-items:end;border-bottom:1px solid #d8e4ed;display:flex;gap:1.5rem;justify-content:space-between;padding:1.35rem 0 1rem}.toolbar-heading{align-items:end;display:flex;gap:1rem}.toolbar-heading h2,.request-group-heading h2{color:#173e60;font-size:1.08rem;margin:0}.request-count{color:#526b7d;font-size:.74rem;font-variant-numeric:tabular-nums;font-weight:800;white-space:nowrap}.status-tabs{display:flex;gap:.45rem}.status-tab{align-items:center;background:#fff;border:1px solid #b8cbd8;border-radius:.28rem;color:#49677c;cursor:pointer;display:inline-flex;font:inherit;font-size:.78rem;font-weight:900;gap:.42rem;min-height:2.45rem;padding:.5rem .85rem;transition:background .15s ease,border-color .15s ease,color .15s ease,box-shadow .15s ease}.status-tab:hover{border-color:#176ea6;color:#176ea6}.status-tab.is-selected{background:#176ea6;border-color:#176ea6;box-shadow:0 .22rem .6rem rgb(23 110 166 / .2);color:#fff}.status-tab:focus-visible{outline:3px solid #8fc7e7;outline-offset:2px}.status-dot{background:currentColor;border-radius:50%;display:inline-block;height:.45rem;width:.45rem}.pending-dot{color:#ed9b35}.status-tab.is-selected .pending-dot{color:#ffe1a9}.all-dot{color:#8ba1ae}.status-tab.is-selected .all-dot{color:#c9e8f8}.approval-message{color:#a24424;display:block;font-size:.76rem;min-height:1.35rem;padding:.75rem 0 0}.request-groups{display:grid;gap:2.25rem}.request-group{min-width:0}.request-group-heading{align-items:end;border-bottom:1px solid #d8e4ed;display:flex;gap:1rem;justify-content:space-between;padding:1.7rem 0 .75rem}.request-list{display:grid;gap:1rem;margin-top:.4rem}.request-card{background:#fff;border:1px solid #cbdde8;border-radius:.45rem;box-shadow:0 .3rem 1rem rgb(22 58 87 / .1);overflow:hidden}.request-card-header{align-items:center;background:#f5f9fc;border-bottom:1px solid #d8e4ed;display:flex;gap:1rem;justify-content:space-between;padding:1rem 1.15rem}.request-person{align-items:center;display:flex;gap:.75rem;min-width:0}.person-avatar{align-items:center;background:#e4f2f9;border:1px solid #94c4dc;border-radius:50%;color:#176ea6;display:flex;flex:0 0 2.75rem;font-size:1.05rem;font-weight:900;height:2.75rem;justify-content:center;overflow:hidden;width:2.75rem}.person-avatar img{display:block;height:100%;object-fit:cover;width:100%}.person-name{color:#173e60;font-size:1.02rem;line-height:1.35;margin:0;overflow-wrap:anywhere}.request-meta{color:#627b8c;font-size:.72rem;line-height:1.5;margin:.2rem 0 0;overflow-wrap:anywhere}.request-status{align-items:center;background:#fff4dd;border:1px solid #efd195;border-radius:999px;color:#8a5b13;display:inline-flex;flex:0 0 auto;font-size:.7rem;font-weight:900;gap:.35rem;padding:.32rem .62rem}.request-status.approved{background:#e7f5ed;border-color:#a9d5bb;color:#247344}.request-status.rejected{background:#fff0ef;border-color:#e7b5b1;color:#a33c34}.request-status::before{background:currentColor;border-radius:50%;content:"";height:.42rem;width:.42rem}.request-summary{align-items:center;background:#fff;border-bottom:1px solid #e5eef3;display:flex;gap:.6rem;padding:.65rem 1.15rem}.request-summary-label{color:#748b9a;font-size:.68rem;font-weight:900;letter-spacing:.05em}.request-summary-value{color:#28536f;font-size:.77rem;font-weight:800}.comparison{display:grid;gap:.8rem;grid-template-columns:repeat(2,minmax(0,1fr));padding:1rem 1.15rem}.info-panel{background:#f8fbfd;border:1px solid #d5e3eb;border-radius:.3rem;min-width:0}.info-panel.proposed{background:#f1f8fc;border-color:#9fc9df}.info-panel-heading{align-items:center;border-bottom:1px solid #d5e3eb;display:flex;justify-content:space-between;padding:.7rem .8rem}.proposed .info-panel-heading{border-bottom-color:#c4deeb}.info-panel-heading h3{color:#315a73;font-size:.78rem;margin:0}.info-panel-heading span{color:#7890a0;font-size:.62rem;font-weight:900;letter-spacing:.08em}.proposed .info-panel-heading span{color:#176ea6}.info-panel dl{display:grid;gap:.52rem;grid-template-columns:minmax(5rem,6.5rem) minmax(0,1fr);margin:0;padding:.8rem}.info-panel dt{color:#6b8291;font-size:.7rem;font-weight:800}.info-panel dd{color:#24475e;font-size:.76rem;line-height:1.55;margin:0;overflow-wrap:anywhere;white-space:pre-wrap}.review-panel{background:#eef7fb;border-top:1px solid #c7dfeb;padding:1rem 1.15rem}.review-heading{align-items:center;display:flex;gap:.7rem;justify-content:space-between}.review-heading h3{color:#173e60;font-size:.86rem;margin:0}.review-heading p{color:#5d7686;font-size:.7rem;margin:0}.review label{color:#49677c;display:grid;font-size:.72rem;font-weight:800;gap:.3rem;margin-top:.7rem}.review-note{background:#fff;border:1px solid #b9cbd8;border-radius:.25rem;color:#17324d;font:inherit;min-height:2.55rem;padding:.55rem .7rem}.review-note:focus{border-color:#176ea6;box-shadow:0 0 0 3px rgb(23 110 166 / .14);outline:0}.review-actions{display:flex;flex-wrap:wrap;gap:.55rem;margin-top:.7rem}.review-actions button{border:1px solid #176ea6;border-radius:.3rem;cursor:pointer;font:inherit;font-size:.8rem;font-weight:900;min-height:2.75rem;padding:.6rem 1.2rem}.approve{background:#176ea6;color:#fff;min-width:8rem}.approve:hover{background:#0e5686}.reject{background:#fff;border-color:#c5655c!important;color:#a33c34}.reject:hover{background:#fff4f2}.processed-note{border-top:1px solid #e5eef3;color:#627b8c;display:block;font-size:.73rem;line-height:1.6;padding:0 1.15rem 1rem}.empty-state,.loading-state{color:#627b8c;background:#fff;border:1px dashed #abc4d2;border-radius:.35rem;margin:.4rem 0 0;padding:2.5rem;text-align:center}@media(max-width:700px){.profile-requests{padding:0 .85rem 3rem}.approval-hero{align-items:flex-start;padding:1.8rem 0 1.35rem}.approval-hero-mark{flex-basis:3rem;height:3rem}.approval-toolbar{align-items:stretch;display:grid;grid-template-columns:1fr;gap:1rem}.toolbar-heading{display:flex;justify-content:space-between}.status-tabs{display:grid;grid-template-columns:1fr 1fr}.status-tab{justify-content:center}.request-group-heading{align-items:start}.request-card-header{align-items:flex-start;display:grid;grid-template-columns:1fr}.request-status{justify-self:start}.comparison{grid-template-columns:1fr;padding:.8rem}.review-panel{padding:.9rem}.request-summary,.request-card-header{padding-left:.85rem;padding-right:.85rem}.info-panel dl{grid-template-columns:5.5rem minmax(0,1fr)}}
</style>

<script>
  import { readAdminApiJson } from "../../lib/admin-api";
  import { renderSafeLinks } from "../../lib/safe-links";
  type RequestRow=Record<string,string|null>;type ReviewKind="common"|"atlas";
  const initialize=()=>{const root=document.querySelector<HTMLElement>("[data-profile-requests]");if(!root||root.dataset.ready)return;root.dataset.ready="true";const list=root.querySelector<HTMLElement>("[data-list]")!,atlasList=root.querySelector<HTMLElement>("[data-atlas-list]")!,message=root.querySelector<HTMLOutputElement>("[data-message]")!,count=root.querySelector<HTMLOutputElement>("[data-count]")!,commonCount=root.querySelector<HTMLOutputElement>("[data-common-count]")!,atlasCount=root.querySelector<HTMLOutputElement>("[data-atlas-count]")!;let status="pending";
    const escape=(value:unknown)=>String(value??"").replace(/[&<>"']/g,character=>({"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#39;"}[character]??character));const statusLabel=(value:string)=>value==="pending"?"承認待ち":value==="approved"?"承認済み":"却下";const format=(value:string)=>{const date=new Date(value);return Number.isNaN(date.getTime())?"日時不明":new Intl.DateTimeFormat("ja-JP",{dateStyle:"medium",timeStyle:"short"}).format(date)};const initial=(value:string)=>value.trim().charAt(0)||"?";
    const avatarMarkup=(row:RequestRow,name:string)=>{const value=String(row.avatar_url??"").trim();const allowed=/^https:\/\//i.test(value)||/^data:image\/(?:png|jpeg|webp);base64,[A-Za-z0-9+/=]+$/i.test(value);return allowed?`<img src="${escape(value)}" alt="" loading="lazy" decoding="async" />`:escape(initial(name))};
    const commonFields=(row:RequestRow,prefix:"current"|"proposed")=>[["氏名",row[`${prefix}_display_name`]], ["所属",row[`${prefix}_university`]], ["学年等",row[`${prefix}_year`]], ["所属区分",row[`${prefix}_affiliation_type`]], ["国・地域",row[`${prefix}_country`]], ["タイムゾーン",row[`${prefix}_timezone`]], ["運営外自己紹介（共通プロフィール）",row[`${prefix}_bio`]]].map(([label,value])=>`<dt>${escape(label)}</dt><dd>${escape(value)||"未登録"}</dd>`).join("");const atlasFields=(row:RequestRow,prefix:"current"|"proposed")=>`<dt>運営内自己紹介（学習サイト「アトラス」）</dt><dd>${renderSafeLinks(String(prefix==="current"?row.current_internal_bio??"":row.proposed_internal_bio??""))||"未登録"}</dd>`;
    const renderCard=(row:RequestRow,kind:ReviewKind)=>{const state=row.status??"pending";const atlas=kind==="atlas";const name=row.proposed_display_name||row.current_display_name||row.display_name||row.email||"氏名未入力";const fields=atlas?atlasFields:commonFields;const action=state==="pending"?`<section class="review-panel"><div class="review-heading"><h3>この申請を処理する</h3><p>内容を確認して選択してください</p></div><div class="review"><label>処理メモ（任意）<input class="review-note" data-note="${escape(row.id)}" maxlength="2000" placeholder="承認・却下の理由や引き継ぎ事項" /></label><div class="review-actions"><button type="button" class="approve" data-review="approve" data-review-kind="${kind}" data-id="${escape(row.id)}">承認する</button><button type="button" class="reject" data-review="reject" data-review-kind="${kind}" data-id="${escape(row.id)}">却下する</button></div></div></section>`:`<small class="processed-note">処理者：${escape(row.reviewed_by)||"不明"}${row.review_note?` ・ ${escape(row.review_note)}`:""}</small>`;return `<article class="request-card"><header class="request-card-header"><div class="request-person"><span class="person-avatar" aria-hidden="true">${avatarMarkup(row,name)}</span><div><p class="approval-eyebrow">${atlas?"運営内自己紹介変更申請":"メンバー情報変更申請"}</p><h2 class="person-name">${escape(name)}</h2><p class="request-meta">${escape(row.email)} ・ 申請日時 ${escape(format(row.submitted_at??""))}</p></div></div><span class="request-status ${state}">${statusLabel(state)}</span></header><div class="request-summary"><span class="request-summary-label">確認ポイント</span><span class="request-summary-value">${atlas?"現在の自己紹介と申請内容の差分":"現在の登録情報と申請内容の差分"}</span></div><div class="comparison"><section class="info-panel"><header class="info-panel-heading"><h3>${atlas?"現在の自己紹介":"現在の登録情報"}</h3><span>BEFORE</span></header><dl>${fields(row,"current")}</dl></section><section class="info-panel proposed"><header class="info-panel-heading"><h3>${atlas?"申請された自己紹介":"申請された情報"}</h3><span>AFTER</span></header><dl>${fields(row,"proposed")}</dl></section></div>${action}</article>`};
    const render=(target:HTMLElement,counter:HTMLOutputElement,rows:RequestRow[],kind:ReviewKind)=>{counter.value=`${rows.length}件`;target.innerHTML=rows.length?rows.map(row=>renderCard(row,kind)).join(""):"<p class=\"empty-state\">この状態の申請はありません。</p>"};
    const load=async()=>{message.value="";const response=await fetch(`/api/admin/profile-change-requests?status=${encodeURIComponent(status)}`,{credentials:"same-origin",cache:"no-store"}),data=await readAdminApiJson<{requests?:RequestRow[];atlasInternalBioRequests?:RequestRow[];error?:string}>(response,"申請を読み込めませんでした。");if(!response.ok)throw new Error(data.error??"申請を読み込めませんでした。");const common=data.requests??[],atlas=data.atlasInternalBioRequests??[];count.value=`${common.length+atlas.length}件`;render(list,commonCount,common,"common");render(atlasList,atlasCount,atlas,"atlas")};root.querySelectorAll<HTMLButtonElement>("[data-status]").forEach(button=>button.addEventListener("click",()=>{status=button.dataset.status??"pending";root.querySelectorAll<HTMLButtonElement>("[data-status]").forEach(item=>{const selected=item===button;item.classList.toggle("is-selected",selected);item.setAttribute("aria-pressed",String(selected))});void load().catch(error=>{message.value=error instanceof Error?error.message:"読み込めませんでした。"})}));
    const handleReview=async(event:Event)=>{const button=(event.target as HTMLElement).closest<HTMLButtonElement>("[data-review]");if(!button)return;button.disabled=true;message.value="処理中…";const id=button.dataset.id??"",kind=button.dataset.reviewKind as ReviewKind,note=(button.closest<HTMLElement>(".request-list")?.querySelector<HTMLInputElement>(`[data-note="${CSS.escape(id)}"]`))?.value??"";const endpoint=kind==="atlas"?`/api/admin/project-profile-requests/${encodeURIComponent(id)}`:`/api/admin/profile-change-requests/${encodeURIComponent(id)}`;try{const response=await fetch(endpoint,{method:"PATCH",credentials:"same-origin",headers:{"content-type":"application/json"},body:JSON.stringify({action:button.dataset.review,reviewNote:note})}),data=await readAdminApiJson<{error?:string}>(response,"申請を処理できませんでした。");if(!response.ok)throw new Error(data.error??"処理できませんでした。");message.value="処理しました。";await load()}catch(error){message.value=error instanceof Error?error.message:"処理できませんでした。";button.disabled=false}};list.addEventListener("click",handleReview);atlasList.addEventListener("click",handleReview);void load().catch(error=>{message.value=error instanceof Error?error.message:"申請を読み込めませんでした。"})};document.addEventListener("astro:page-load",initialize);initialize();
</script>
