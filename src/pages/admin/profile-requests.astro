---
import AdminLayout from "../../layouts/AdminLayout.astro";
---
<AdminLayout title="メンバー情報の承認" description="メンバー情報変更申請を処理します">
  <main class="profile-requests" data-profile-requests>
    <header><h1>メンバー情報の承認</h1></header>
    <div class="filters" role="group" aria-label="申請状態"><button type="button" class="is-selected" data-status="pending">承認待ち</button><button type="button" data-status="all">すべて</button></div>
    <output data-message aria-live="polite"></output>
    <section data-list>読み込み中…</section>
  </main>
</AdminLayout>
<style>
  .profile-requests{margin:0 auto;max-width:1050px;padding:0 1.25rem 4rem}.profile-requests header{border-bottom:1px solid var(--border-default);padding:2rem 0 1.25rem}.profile-requests h1{font-size:clamp(1.8rem,4vw,2.35rem);margin:0}.filters{display:flex;gap:.5rem;margin:1rem 0}.filters button{background:var(--background-primary);border:1px solid var(--border-default);color:var(--text-primary);cursor:pointer;font:inherit;padding:.45rem .7rem}.filters button.is-selected{background:var(--accent-primary);border-color:var(--accent-primary);color:#fff}.profile-requests>output{color:var(--text-secondary);display:block;margin:.6rem 0}.profile-requests section{display:grid;gap:.8rem}.request{border:1px solid var(--border-default);padding:1rem}.request header{align-items:start;border:0;display:flex;gap:1rem;justify-content:space-between;padding:0}.request h2{font-size:1.05rem;margin:0}.request small{color:var(--text-secondary)}.comparison{display:grid;gap:.7rem;grid-template-columns:1fr 1fr;margin:.9rem 0}.comparison>div{background:var(--background-secondary);padding:.75rem}.comparison h3{font-size:.8rem;margin:0 0 .55rem}.comparison dl{display:grid;gap:.35rem;grid-template-columns:6rem 1fr;margin:0}.comparison dt{color:var(--text-secondary);font-size:.76rem}.comparison dd{font-size:.82rem;margin:0;white-space:pre-wrap}.review{align-items:end;display:grid;gap:.7rem;grid-template-columns:1fr auto auto}.review label{display:grid;font-weight:700;gap:.3rem}.review input{background:var(--background-primary);border:1px solid var(--border-default);color:var(--text-primary);font:inherit;padding:.5rem}.review button{border:1px solid var(--accent-primary);cursor:pointer;font:inherit;font-weight:800;padding:.5rem .7rem}.approve{background:var(--accent-primary);color:#fff}.reject{background:var(--background-primary);color:#a53a32}.badge{border:1px solid var(--border-default);font-size:.72rem;padding:.2rem .4rem}.empty{color:var(--text-secondary)}@media(max-width:700px){.profile-requests{padding:0 .8rem 3rem}.comparison{grid-template-columns:1fr}.review{align-items:stretch;grid-template-columns:1fr}.comparison dl{grid-template-columns:5rem 1fr}}
</style>
<script>
  type RequestRow=Record<string,string|null>;
  const initialize=()=>{const root=document.querySelector<HTMLElement>('[data-profile-requests]');if(!root||root.dataset.ready)return;root.dataset.ready='true';const list=root.querySelector<HTMLElement>('[data-list]')!,message=root.querySelector<HTMLOutputElement>('[data-message]')!;let status='pending';
    const escape=(value:unknown)=>String(value??'').replace(/[&<>"']/g,character=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[character]??character));
    const fields=(row:RequestRow,prefix:'current'|'proposed')=>[['氏名',row[`${prefix}_display_name`]],['所属',row[`${prefix}_university`]],['学年等',row[`${prefix}_year`]],['所属区分',row[`${prefix}_affiliation_type`]],['国・地域',row[`${prefix}_country`]],['タイムゾーン',row[`${prefix}_timezone`]],['運営外自己紹介',row[`${prefix}_bio`]]].map(([label,value])=>`<dt>${escape(label)}</dt><dd>${escape(value)||'未登録'}</dd>`).join('');
    const render=(rows:RequestRow[])=>{list.innerHTML=rows.length?rows.map(row=>`<article class="request"><header><div><h2>${escape(row.proposed_display_name)||'氏名未入力'}</h2><small>${escape(row.email)} ・ ${escape(new Date(row.submitted_at??'').toLocaleString('ja-JP'))}</small></div><span class="badge">${row.status==='pending'?'承認待ち':row.status==='approved'?'承認済み':'却下'}</span></header><div class="comparison"><div><h3>現在の登録情報</h3><dl>${fields(row,'current')}</dl></div><div><h3>申請内容</h3><dl>${fields(row,'proposed')}</dl></div></div>${row.status==='pending'?`<div class="review"><label>承認・却下メモ<input data-note="${escape(row.id)}" maxlength="2000" /></label><button type="button" class="approve" data-review="approve" data-id="${escape(row.id)}">承認</button><button type="button" class="reject" data-review="reject" data-id="${escape(row.id)}">却下</button></div>`:`<small>処理者: ${escape(row.reviewed_by)}${row.review_note?` ・ ${escape(row.review_note)}`:''}</small>`}</article>`).join(''):'<p class="empty">対象の申請はありません。</p>'};
    const load=async()=>{message.value='';const response=await fetch(`/api/admin/profile-change-requests?status=${encodeURIComponent(status)}`,{credentials:'same-origin',cache:'no-store'}),data=await response.json() as {requests?:RequestRow[];error?:string};if(!response.ok)throw new Error(data.error??'申請を読み込めませんでした。');render(data.requests??[])};
    root.querySelectorAll<HTMLButtonElement>('[data-status]').forEach(button=>button.addEventListener('click',()=>{status=button.dataset.status??'pending';root.querySelectorAll('[data-status]').forEach(item=>item.classList.toggle('is-selected',item===button));void load().catch(error=>message.value=error instanceof Error?error.message:'読み込めませんでした。')}));
    list.addEventListener('click',async event=>{const button=(event.target as HTMLElement).closest<HTMLButtonElement>('[data-review]');if(!button)return;button.disabled=true;message.value='処理中…';const id=button.dataset.id??'',note=list.querySelector<HTMLInputElement>(`[data-note="${CSS.escape(id)}"]`)?.value??'';const response=await fetch(`/api/admin/profile-change-requests/${encodeURIComponent(id)}`,{method:'PATCH',credentials:'same-origin',headers:{'content-type':'application/json'},body:JSON.stringify({action:button.dataset.review,reviewNote:note})}),data=await response.json() as {error?:string};message.value=response.ok?'処理しました。':data.error??'処理できませんでした。';if(response.ok)await load();else button.disabled=false});
    void load().catch(error=>message.value=error instanceof Error?error.message:'読み込めませんでした。');};
  document.addEventListener('astro:page-load',initialize);initialize();
</script>
