---
import { getCollection } from "astro:content";
import AdminLayout from "../../layouts/AdminLayout.astro";
import AdminRetryNotice from "../../components/admin/AdminRetryNotice.astro";
const subjects = (await getCollection("subjects")).sort((a, b) => a.data.order - b.data.order);
---

<AdminLayout title="ジャンル・役割管理" description="アトラスの分野と担当役割">
  <main class="genre-roles" data-genre-roles>
    <header class="page-heading"><div><h1>ジャンル・役割管理</h1></div><div class="heading-actions"><a href="/admin/manage/?project=atlas">← 管理トップ</a><a class="quiet" href="/admin/permissions/?project=atlas">運営者・担当分野管理</a></div></header>
    <section class="management-tools" aria-label="ジャンルと役割の作成">
      <form data-catalog-form><h2>新しいジャンル／役割を作成</h2><div class="form-row"><label>種類<select name="kind"><option value="genre">ジャンル</option><option value="role">役割</option></select></label><label>ID（英数字とハイフン）<input name="slug" required pattern="[a-z0-9-]+" maxlength="80" placeholder="statistics" /></label><label class="wide">表示名<input name="name" required maxlength="120" placeholder="統計チーム" /></label><label class="wide">説明（任意）<input name="description" maxlength="500" placeholder="担当範囲の説明" /></label><button type="submit">作成</button></div><output data-form-message aria-live="polite"></output></form>
      <form data-assignment-form><h2>メンバーをジャンル／役割へ追加</h2><div class="form-row"><label class="wide">メールアドレス<input type="email" name="email" required maxlength="320" placeholder="member@example.com" /></label><label class="wide">対象<select name="catalogId" data-catalog-select required><option value="">読み込み中…</option></select></label><button type="submit">追加</button></div><output data-assignment-message aria-live="polite"></output></form>
      <form data-taxonomy-form><h2>学習サイトの分野／カテゴリを追加</h2><div class="form-row"><label>種類<select name="kind"><option value="subject">分野</option><option value="category">カテゴリ</option></select></label><label class="taxonomy-subject">対象分野<select name="subject"><option value="">分野を選択</option>{subjects.map((subject) => <option value={subject.data.slug}>{subject.data.name.ja}</option>)}</select></label><label>ID（任意・未入力で自動生成）<input name="slug" pattern="[a-z0-9-]+" maxlength="80" placeholder="未入力なら自動生成" /></label><label class="wide">表示名<input name="name" required maxlength="120" placeholder="例：情報、機械学習" /></label><label class="wide">説明（任意）<input name="description" maxlength="500" placeholder="学習内容の説明" /></label><label>順番<input name="sortOrder" type="number" min="0" max="9999" value="0" /></label><button type="submit">追加</button></div><output data-taxonomy-message aria-live="polite"></output></form>
    </section>
    <section class="legend" aria-label="役割の説明"><span><i class="dot dot--member"></i>分野担当</span><span><i class="dot dot--lead"></i>分野統括（公開フロー）</span><span><i class="dot dot--manager"></i>運営統括</span><span><i class="dot dot--custom"></i>カスタム項目</span></section>
    <section class="subject-grid" aria-label="分野別の役割"><div class="loading" data-content>分野と担当を読み込んでいます…</div></section>
    <section class="custom-section" aria-labelledby="custom-heading"><div class="panel-heading"><h2 id="custom-heading">カスタムジャンル／役割</h2><span data-custom-count>—</span></div><div class="custom-grid" data-custom-content><p class="loading">読み込み中…</p></div></section>
    <section class="taxonomy-section" aria-labelledby="taxonomy-heading"><div class="panel-heading"><div><h2 id="taxonomy-heading">学習サイトの分野／カテゴリ</h2><p class="panel-note">分野ごとのカテゴリを確認し、カードをドラッグして表示順を変更できます。</p></div><span data-taxonomy-count>—</span></div><div class="taxonomy-board" data-taxonomy-content><p class="loading">読み込み中…</p></div></section>
    <AdminRetryNotice />
    <output class="message" data-message aria-live="polite"></output>
  </main>
</AdminLayout>

<style>
  .genre-roles{margin:0 auto;max-width:1250px;padding:0 1.25rem 4rem}.page-heading{align-items:end;border-bottom:1px solid var(--border-default);display:flex;gap:1rem;justify-content:space-between;padding:2rem 0 1.3rem}.eyebrow{color:var(--accent-primary);font-size:.7rem;font-weight:800;letter-spacing:.1em;margin:0}.page-heading h1{font-size:clamp(1.8rem,4vw,2.5rem);margin:.25rem 0 .45rem}.lead{color:var(--text-secondary);line-height:1.7;margin:0}.heading-actions{align-items:flex-end;display:flex;flex-wrap:wrap;gap:.6rem}.heading-actions a{color:var(--accent-primary);font-size:.8rem;font-weight:800;text-decoration:none;white-space:nowrap}.heading-actions .quiet{border:1px solid var(--border-default);color:var(--text-primary);padding:.5rem .7rem}.management-tools{display:grid;gap:.75rem;grid-template-columns:repeat(2,minmax(0,1fr));margin:1.2rem 0}.management-tools form{background:var(--background-secondary);border:1px solid var(--border-default);padding:.9rem}.management-tools h2{font-size:.9rem;margin:0 0 .65rem}.form-row{align-items:end;display:flex;flex-wrap:wrap;gap:.5rem}.form-row label{color:var(--text-secondary);display:grid;font-size:.68rem;font-weight:800;gap:.25rem;min-width:8rem}.form-row label.wide{flex:1 1 11rem}.form-row input,.form-row select{background:var(--background-primary);border:1px solid var(--border-default);color:var(--text-primary);font:inherit;min-height:2.2rem;padding:.4rem .5rem}.form-row button,.action-button{background:var(--accent-primary);border:1px solid var(--accent-primary);color:#fff;cursor:pointer;font:inherit;font-size:.72rem;font-weight:800;min-height:2.2rem;padding:.4rem .65rem}.management-tools output{color:var(--text-secondary);display:block;font-size:.7rem;min-height:1.1rem;padding-top:.45rem}.legend{color:var(--text-secondary);display:flex;flex-wrap:wrap;font-size:.75rem;gap:1rem;margin:1rem 0}.legend span{align-items:center;display:inline-flex;gap:.35rem}.dot{background:var(--text-secondary);border-radius:50%;height:.55rem;width:.55rem}.dot--member{background:#6ba6ff}.dot--lead{background:#ac8cf4}.dot--manager{background:#e8b84a}.dot--custom{background:#67c3ce}.subject-grid,.custom-grid{display:grid;gap:.75rem;grid-template-columns:repeat(auto-fill,minmax(290px,1fr))}.subject-card,.custom-card{background:var(--background-secondary);border:1px solid var(--border-default);display:grid;gap:.65rem;padding:.9rem}.subject-card__heading,.custom-card__heading{align-items:start;display:flex;gap:.5rem;justify-content:space-between}.subject-card h2,.custom-card h3{font-size:1rem;margin:0}.subject-card code,.custom-card code{color:var(--text-secondary);font-size:.68rem}.subject-status{border:1px solid var(--border-default);border-radius:999px;color:var(--text-secondary);font-size:.65rem;padding:.18rem .4rem;white-space:nowrap}.subject-description,.custom-description{color:var(--text-secondary);font-size:.78rem;line-height:1.55;margin:0;min-height:2.4em}.role-list,.custom-people{border-top:1px solid var(--border-default);display:grid;gap:.45rem;padding-top:.6rem}.role-row{align-items:start;display:grid;gap:.45rem;grid-template-columns:6.5rem 1fr}.role-label{align-items:center;color:var(--text-secondary);display:flex;font-size:.7rem;gap:.3rem;padding-top:.2rem}.people,.custom-people-list{display:flex;flex-wrap:wrap;gap:.3rem}.person{align-items:center;background:var(--background-primary);border:1px solid var(--border-default);display:inline-flex;gap:.35rem;padding:.28rem .4rem}.person span{font-size:.7rem}.person button,.custom-card button{background:transparent;border:0;color:var(--accent-primary);cursor:pointer;font-size:.65rem;padding:.1rem}.person--lead{border-color:#ac8cf4;color:#ac8cf4}.person--manager{border-color:#e8b84a;color:#e8b84a}.person-remove{color:#e27676!important}.unassigned,.loading{color:var(--text-muted);font-size:.7rem;padding-top:.25rem}.custom-section{border-top:1px solid var(--border-default);margin-top:2rem;padding-top:1.2rem}.panel-heading{align-items:end;display:flex;justify-content:space-between;margin-bottom:.75rem}.panel-heading h2{font-size:1.15rem;margin:.18rem 0 0}.panel-heading>span{color:var(--text-secondary);font-size:.72rem}.custom-card__meta{color:var(--text-secondary);font-size:.7rem}.custom-card__actions{display:flex;justify-content:space-between}.delete-catalog{color:#e27676!important}.message{color:var(--text-secondary);display:block;font-size:.8rem;min-height:1.2rem;padding-top:.7rem}@media(max-width:760px){.genre-roles{padding:0 .8rem 3rem}.page-heading{align-items:start;display:grid}.management-tools{grid-template-columns:1fr}.subject-grid,.custom-grid{grid-template-columns:1fr}}
</style>

<style is:global>
  /* 動的に生成するカードはAstroのスコープ属性を持たないため、ここだけ明示的に共有CSSを適用する。 */
  .genre-roles .subject-grid,
  .genre-roles .custom-grid {
    align-items: start;
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
  }

  .genre-roles .subject-grid [data-content] {
    display: contents;
  }

  .genre-roles .subject-card,
  .genre-roles .custom-card {
    background: var(--background-secondary);
    border: 1px solid var(--border-default);
    border-radius: 0.35rem;
    display: grid;
    gap: 0.65rem;
    min-width: 0;
    padding: 0.9rem;
  }

  .genre-roles .subject-card__heading,
  .genre-roles .custom-card__heading {
    align-items: start;
    display: flex;
    gap: 0.5rem;
    justify-content: space-between;
    min-width: 0;
  }

  .genre-roles .subject-card h2,
  .genre-roles .custom-card h3 {
    font-size: 1rem;
    margin: 0;
    overflow-wrap: anywhere;
  }

  .genre-roles .subject-card code,
  .genre-roles .custom-card code {
    color: var(--text-secondary);
    display: block;
    font-size: 0.68rem;
    margin-top: 0.2rem;
    overflow-wrap: anywhere;
  }

  .genre-roles .subject-status {
    border: 1px solid var(--border-default);
    border-radius: 999px;
    color: var(--text-secondary);
    flex: 0 0 auto;
    font-size: 0.65rem;
    padding: 0.18rem 0.4rem;
    white-space: nowrap;
  }

  .genre-roles .subject-description,
  .genre-roles .custom-description {
    color: var(--text-secondary);
    font-size: 0.78rem;
    line-height: 1.55;
    margin: 0;
    min-height: 2.4em;
  }

  .genre-roles .role-list,
  .genre-roles .custom-people {
    border-top: 1px solid var(--border-default);
    display: grid;
    gap: 0.45rem;
    padding-top: 0.6rem;
  }

  .genre-roles .role-row {
    align-items: start;
    display: grid;
    gap: 0.45rem;
    grid-template-columns: 6.5rem minmax(0, 1fr);
  }

  .genre-roles .role-label {
    align-items: center;
    color: var(--text-secondary);
    display: flex;
    font-size: 0.7rem;
    gap: 0.3rem;
    padding-top: 0.2rem;
  }

  .genre-roles .people,
  .genre-roles .custom-people-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    min-width: 0;
  }

  .genre-roles .person {
    align-items: center;
    background: var(--background-primary);
    border: 1px solid var(--border-default);
    display: inline-flex;
    gap: 0.35rem;
    max-width: 100%;
    padding: 0.28rem 0.4rem;
  }

  .genre-roles .person span {
    font-size: 0.7rem;
    overflow-wrap: anywhere;
  }

  .genre-roles .person button,
  .genre-roles .custom-card button {
    background: transparent;
    border: 0;
    color: var(--accent-primary);
    cursor: pointer;
    font-size: 0.65rem;
    padding: 0.1rem;
  }

  .genre-roles .person--lead {
    border-color: #ac8cf4;
    color: #ac8cf4;
  }

  .genre-roles .person--manager {
    border-color: #e8b84a;
    color: #e8b84a;
  }

  .genre-roles .person-remove {
    color: #e27676 !important;
  }

  .genre-roles .unassigned,
  .genre-roles .loading {
    color: var(--text-muted);
    font-size: 0.7rem;
    padding-top: 0.25rem;
  }

  .genre-roles .custom-card__meta {
    color: var(--text-secondary);
    font-size: 0.7rem;
  }

  .genre-roles .custom-card__actions {
    display: flex;
    justify-content: space-between;
  }

  .genre-roles .taxonomy-section { border-top: 1px solid var(--border-default); margin-top: 2rem; padding-top: 1.2rem; }
  .genre-roles .panel-note { color: var(--text-secondary); font-size: .72rem; line-height: 1.5; margin: .3rem 0 0; }
  .genre-roles .taxonomy-board { display: grid; gap: .8rem; }
  .genre-roles .taxonomy-lanes { display: grid; gap: .7rem; grid-template-columns: repeat(auto-fit, minmax(21rem, 1fr)); }
  .genre-roles .taxonomy-subjects { display: grid; gap: .55rem; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); }
  .genre-roles .taxonomy-subject-card,
  .genre-roles .taxonomy-lane { background: var(--background-secondary); border: 1px solid var(--border-default); border-radius: .45rem; min-width: 0; }
  .genre-roles .taxonomy-subject-card { display: grid; gap: .5rem; padding: .7rem .8rem; }
  .genre-roles .taxonomy-subject-card[draggable="true"] { cursor: grab; transition: border-color .15s ease, background .15s ease, transform .15s ease; }
  .genre-roles .taxonomy-subject-card[draggable="true"]:hover { background: var(--background-inset); border-color: var(--accent-primary); transform: translateY(-1px); }
  .genre-roles .taxonomy-subject-card[draggable="true"]:active { cursor: grabbing; }
  .genre-roles .taxonomy-subject-card.is-dragging,
  .genre-roles .taxonomy-category.is-dragging { opacity: .45; }
  .genre-roles .taxonomy-subject-card__heading,
  .genre-roles .taxonomy-lane__heading { align-items: center; display: flex; gap: .6rem; justify-content: space-between; min-width: 0; }
  .genre-roles .taxonomy-subject-card__title { align-items: center; display: flex; gap: .45rem; min-width: 0; }
  .genre-roles .taxonomy-drag-handle { color: var(--text-muted); cursor: grab; font-size: .9rem; letter-spacing: -.1em; user-select: none; }
  .genre-roles .taxonomy-subject-card h3,
  .genre-roles .taxonomy-lane h3 { font-size: .92rem; margin: 0; overflow-wrap: anywhere; }
  .genre-roles .taxonomy-subject-card code { color: var(--text-secondary); display: block; font-size: .66rem; margin-top: .15rem; overflow-wrap: anywhere; }
  .genre-roles .taxonomy-lane { overflow: hidden; }
  .genre-roles .taxonomy-lane__heading { border-bottom: 1px solid var(--border-default); padding: .65rem .8rem; }
  .genre-roles .taxonomy-lane__heading > div { min-width: 0; }
  .genre-roles .taxonomy-lane__heading small { color: var(--text-secondary); display: block; font-size: .64rem; margin-top: .15rem; }
  .genre-roles .taxonomy-lane__heading .subject-status { font-size: .6rem; }
  .genre-roles .taxonomy-category-list { display: grid; gap: .4rem; list-style: none; margin: 0; min-height: 2.7rem; padding: .55rem; }
  .genre-roles .taxonomy-category { align-items: center; background: var(--background-primary); border: 1px solid var(--border-default); border-radius: .3rem; display: flex; gap: .5rem; justify-content: space-between; min-width: 0; padding: .45rem .55rem; transition: border-color .15s ease, background .15s ease, transform .15s ease; }
  .genre-roles .taxonomy-category:hover { background: var(--background-inset); border-color: var(--border-strong); }
  .genre-roles .taxonomy-category[draggable="true"] { cursor: grab; }
  .genre-roles .taxonomy-category[draggable="true"]:active { cursor: grabbing; }
  .genre-roles .taxonomy-category.is-drop-target,
  .genre-roles .taxonomy-lane.is-drop-target { border-color: var(--accent-primary); background: color-mix(in srgb, var(--accent-primary) 9%, var(--background-primary)); }
  .genre-roles .taxonomy-category__label { min-width: 0; }
  .genre-roles .taxonomy-category__label strong { color: var(--text-primary); display: block; font-size: .73rem; overflow-wrap: anywhere; }
  .genre-roles .taxonomy-category__label code { color: var(--text-secondary); display: block; font-size: .6rem; margin-top: .12rem; overflow-wrap: anywhere; }
  .genre-roles .taxonomy-category__actions,
  .genre-roles .taxonomy-subject-card__actions { align-items: center; display: inline-flex; flex: 0 0 auto; gap: .15rem; }
  .genre-roles .taxonomy-category__actions button,
  .genre-roles .taxonomy-subject-card__actions button { background: transparent; border: 1px solid transparent; border-radius: .25rem; color: var(--accent-primary); cursor: pointer; font: inherit; font-size: .63rem; padding: .24rem .35rem; }
  .genre-roles .taxonomy-category__actions button:hover,
  .genre-roles .taxonomy-subject-card__actions button:hover { background: var(--background-inset); border-color: var(--border-default); }
  .genre-roles .taxonomy-order-actions { display: inline-flex; gap: .15rem; }
  .genre-roles .taxonomy-order-actions button:disabled { cursor: not-allowed; opacity: .4; }
  .genre-roles .taxonomy-editor { border-top: 1px solid var(--border-default); display: grid; gap: .4rem; margin-top: .4rem; padding-top: .55rem; }
  .genre-roles .taxonomy-editor[hidden] { display: none; }
  .genre-roles .taxonomy-editor label { color: var(--text-secondary); display: grid; font-size: .63rem; gap: .2rem; }
  .genre-roles .taxonomy-editor input { background: var(--background-primary); border: 1px solid var(--border-default); color: var(--text-primary); font: inherit; min-height: 1.9rem; padding: .3rem .4rem; }
  .genre-roles .taxonomy-editor__actions { display: flex; gap: .3rem; }
  .genre-roles .taxonomy-empty { color: var(--text-muted); font-size: .68rem; margin: 0; padding: .45rem .2rem; }
  .genre-roles .taxonomy-card[data-status="archived"],
  .genre-roles .taxonomy-subject-card[data-status="archived"],
  .genre-roles .taxonomy-category[data-status="archived"] { opacity: .72; }

  .genre-roles .delete-catalog {
    color: #e27676 !important;
  }

  @media (max-width: 760px) {
    .genre-roles .subject-grid,
    .genre-roles .custom-grid {
      grid-template-columns: 1fr;
    }

    .genre-roles .role-row {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }

    .genre-roles .taxonomy-subjects { grid-template-columns: 1fr; }
    .genre-roles .taxonomy-lanes { grid-template-columns: 1fr; }
  }
</style>

<script>
  import { createAdminLoadRetry } from "../../scripts/admin-load-retry";
  import { lockAdminForm } from "../../scripts/admin-form-submit-lock";

  type Member = { display_name?: string; email?: string; subjectAssignments?: string[]; workflowSubjects?: string[]; role?: string };
  type GenreResponse = { members?: Member[]; error?: string };
  type Catalog = { id: string; kind: "genre" | "role"; slug: string; name: string; description?: string };
  type Assignment = { catalog_id: string; email: string; display_name?: string };
  type CatalogResponse = { catalog?: Catalog[]; assignments?: Assignment[]; canEdit?: boolean; error?: string };
  type Taxonomy = { id: string; kind: "subject" | "category"; subject_slug: string; slug: string; name: string; description?: string; sort_order?: number; status?: "active" | "archived" };
  const initialize = () => { const root = document.querySelector<HTMLElement>("[data-genre-roles]"); if (!root || root.dataset.ready) return; root.dataset.ready = "true"; const content = root.querySelector<HTMLElement>("[data-content]")!; const customContent = root.querySelector<HTMLElement>("[data-custom-content]")!; const customCount = root.querySelector<HTMLElement>("[data-custom-count]")!; const taxonomyContent = root.querySelector<HTMLElement>("[data-taxonomy-content]")!; const taxonomyCount = root.querySelector<HTMLElement>("[data-taxonomy-count]")!; const catalogSelect = root.querySelector<HTMLSelectElement>("[data-catalog-select]")!; const esc = (value: unknown) => String(value ?? "").replace(/[&<>"']/g, (character) => ({ "&":"&amp;", "<":"&lt;", ">":"&gt;", '"':"&quot;", "'":"&#39;" })[character] ?? character); let genreMembers: Member[] = []; let catalog: Catalog[] = []; let assignments: Assignment[] = []; let taxonomy: Taxonomy[] = [];
    const memberName = (member: Member | Assignment) => member.display_name?.trim() || member.email || "表示名未設定";
    const people = (items: Array<Member | Assignment>, className = "", remove?: (item: Member | Assignment) => string) => items.length ? items.map((item) => `<span class="person ${className}"><span>${esc(memberName(item))}</span>${remove ? `<button type="button" class="person-remove" data-remove-assignment="${esc(remove(item))}" aria-label="${esc(memberName(item))}を削除">削除</button>` : ""}</span>`).join("") : '<span class="unassigned">未割り当て</span>';
    const subjectRows = () => { const rows = new Map<string, { slug: string; name: string; status: string; description: string }>(); Array.from(document.querySelectorAll<HTMLElement>("[data-subject-data]")).forEach((subject) => { const slug = subject.dataset.slug ?? ""; if (slug) rows.set(slug, { slug, name: subject.dataset.name ?? slug, status: subject.dataset.status ?? "公開中", description: subject.dataset.description ?? "" }); }); taxonomy.filter((item) => item.kind === "subject").forEach((item) => { if (!rows.has(item.slug)) rows.set(item.slug, { slug: item.slug, name: item.name, status: item.status === "archived" ? "アーカイブ" : "準備中", description: item.description ?? "" }); }); return [...rows.values()]; };
    const renderTaxonomySubjectOptions = () => { if (!taxonomySubject) return; const current = taxonomySubject.value; const options = subjectRows().filter((subject) => subject.status !== "アーカイブ").map((subject) => `<option value="${esc(subject.slug)}">${esc(subject.name)}${subject.status === "準備中" ? "（準備中）" : ""}</option>`).join(""); taxonomySubject.innerHTML = `<option value="">分野を選択</option>${options}`; taxonomySubject.value = subjectRows().some((subject) => subject.slug === current && subject.status !== "アーカイブ") ? current : ""; };
    const renderCatalogSelect = () => { const system = subjectRows().map((subject) => `<option value="system-member|${esc(subject.slug)}">分野担当：${esc(subject.name)}</option><option value="system-lead|${esc(subject.slug)}">分野統括：${esc(subject.name)}</option>`).join(""); catalogSelect.innerHTML = `<option value="">選択してください</option>${system}${catalog.map((item) => `<option value="${esc(item.id)}">${esc(item.kind === "genre" ? "ジャンル" : "役割")}：${esc(item.name)}</option>`).join("")}`; };
    const renderSubjects = () => { const subjectElements = subjectRows(); content.innerHTML = subjectElements.map((subject) => { const slug = subject.slug; const assigned = genreMembers.filter((member) => (member.subjectAssignments ?? []).includes(slug)); const leads = genreMembers.filter((member) => (member.workflowSubjects ?? []).includes(slug)); const managers = genreMembers.filter((member) => member.role === "manager"); const memberButtons = assigned.map((member) => `<span class="person"><span>${esc(memberName(member))}</span><button type="button" class="person-remove" data-remove-standard="member|${esc(member.email)}|${esc(slug)}">削除</button></span>`).join("") || '<span class="unassigned">未割り当て</span>'; const leadButtons = leads.map((member) => `<span class="person person--lead"><span>${esc(memberName(member))}</span><button type="button" class="person-remove" data-remove-standard="lead|${esc(member.email)}|${esc(slug)}">削除</button></span>`).join("") || '<span class="unassigned">未割り当て</span>'; return `<article class="subject-card"><div class="subject-card__heading"><div><h2>${esc(subject.name)}</h2><code>${esc(slug)}</code></div><span class="subject-status">${esc(subject.status)}</span></div><p class="subject-description">${esc(subject.description)}</p><div class="role-list"><div class="role-row"><span class="role-label"><i class="dot dot--member"></i>分野担当</span><div class="people">${memberButtons}</div></div><div class="role-row"><span class="role-label"><i class="dot dot--lead"></i>分野統括</span><div class="people">${leadButtons}</div></div><div class="role-row"><span class="role-label"><i class="dot dot--manager"></i>運営統括</span><div class="people">${people(managers, "person--manager")}</div></div></div></article>`; }).join("") || '<p class="loading">分野情報がありません。</p>'; };
    const renderCustom = () => { customCount.textContent = `${catalog.length}件`; customContent.innerHTML = catalog.length ? catalog.map((item) => { const itemAssignments = assignments.filter((assignment) => assignment.catalog_id === item.id); return `<article class="custom-card"><div class="custom-card__heading"><div><h3>${esc(item.name)}</h3><code>${esc(item.slug)}</code></div><span class="subject-status">${item.kind === "genre" ? "ジャンル" : "役割"}</span></div><p class="custom-description">${esc(item.description || "説明はまだ登録されていません。")}</p><div class="custom-people"><strong class="custom-card__meta">参加メンバー</strong><div class="custom-people-list">${people(itemAssignments, "", (assignment) => `${item.id}|${assignment.email}`)}</div></div><div class="custom-card__actions"><span class="custom-card__meta">${itemAssignments.length}人</span><button type="button" class="delete-catalog" data-delete-catalog="${esc(item.id)}">項目を削除</button></div></article>`; }).join("") : '<p class="loading">カスタム項目はまだありません。</p>'; };
    const taxonomyGroupKey = (item: Taxonomy) => `${item.kind}:${item.subject_slug}`;
    const taxonomyEntries = () => taxonomy.slice().sort((a, b) => a.kind.localeCompare(b.kind) || a.subject_slug.localeCompare(b.subject_slug) || (Number(a.sort_order ?? 0) - Number(b.sort_order ?? 0)) || a.name.localeCompare(b.name, "ja"));
    const taxonomyEditor = (item: Taxonomy) => `<form class="taxonomy-editor" data-taxonomy-editor="${esc(item.id)}" hidden><label>表示名<input name="name" value="${esc(item.name)}" maxlength="120" required /></label><label>ID<input name="slug" value="${esc(item.slug)}" pattern="[a-z0-9-]+" maxlength="80" required /></label><label>説明<input name="description" value="${esc(item.description ?? "")}" maxlength="500" /></label><div class="taxonomy-editor__actions"><button type="submit" data-save-taxonomy="${esc(item.id)}">保存</button><button type="button" data-cancel-taxonomy="${esc(item.id)}">キャンセル</button></div></form>`;
    const renderTaxonomy = () => {
      const entries = taxonomyEntries();
      const subjectItems = new Map(entries.filter((item) => item.kind === "subject").map((item) => [item.slug, item]));
      const categoriesBySubject = new Map<string, Taxonomy[]>();
      entries.filter((item) => item.kind === "category").forEach((item) => { const list = categoriesBySubject.get(item.subject_slug) ?? []; list.push(item); categoriesBySubject.set(item.subject_slug, list); });
      const visibleSubjects = subjectRows().sort((left, right) => {
        const leftItem = subjectItems.get(left.slug); const rightItem = subjectItems.get(right.slug);
        if (leftItem && rightItem) return (Number(leftItem.sort_order ?? 0) - Number(rightItem.sort_order ?? 0)) || left.name.localeCompare(right.name, "ja");
        if (leftItem) return 1;
        if (rightItem) return -1;
        return left.name.localeCompare(right.name, "ja");
      });
      taxonomyCount.textContent = `${entries.length}件・${visibleSubjects.length}分野`;
      if (!visibleSubjects.length) { taxonomyContent.innerHTML = '<p class="loading">追加した分野・カテゴリはまだありません。</p>'; return; }
      const renderCategory = (item: Taxonomy, position: number, siblings: Taxonomy[]) => `<li class="taxonomy-category taxonomy-card" data-status="${esc(item.status ?? "active")}" data-taxonomy-id="${esc(item.id)}" data-taxonomy-group="${esc(taxonomyGroupKey(item))}" draggable="true"><span class="taxonomy-drag-handle" aria-hidden="true">⠿</span><div class="taxonomy-category__label"><strong>${esc(item.name)}</strong><code>${esc(item.slug)}</code></div><div class="taxonomy-category__actions"><span class="taxonomy-order-actions"><button type="button" data-move-taxonomy="${esc(item.id)}" data-direction="up" aria-label="${esc(item.name)}を上へ" ${position <= 0 ? "disabled" : ""}>↑</button><button type="button" data-move-taxonomy="${esc(item.id)}" data-direction="down" aria-label="${esc(item.name)}を下へ" ${position >= siblings.length - 1 ? "disabled" : ""}>↓</button></span><button type="button" data-edit-taxonomy="${esc(item.id)}">編集</button><button type="button" data-toggle-taxonomy="${esc(item.id)}" data-next-status="${item.status === "archived" ? "restore" : "archive"}">${item.status === "archived" ? "復元" : "アーカイブ"}</button></div>${taxonomyEditor(item)}</li>`;
      taxonomyContent.innerHTML = `<div class="taxonomy-lanes">${visibleSubjects.map((subject) => { const subjectItem = subjectItems.get(subject.slug); const categories = categoriesBySubject.get(subject.slug) ?? []; const subjectSiblings = entries.filter((entry) => entry.kind === "subject"); const subjectPosition = subjectItem ? subjectSiblings.findIndex((entry) => entry.id === subjectItem.id) : -1; const subjectActions = subjectItem ? `<div class="taxonomy-subject-card__actions"><span class="taxonomy-order-actions"><button type="button" data-move-taxonomy="${esc(subjectItem.id)}" data-direction="up" aria-label="${esc(subject.name)}を上へ" ${subjectPosition <= 0 ? "disabled" : ""}>↑</button><button type="button" data-move-taxonomy="${esc(subjectItem.id)}" data-direction="down" aria-label="${esc(subject.name)}を下へ" ${subjectPosition >= subjectSiblings.length - 1 ? "disabled" : ""}>↓</button></span><button type="button" data-edit-taxonomy="${esc(subjectItem.id)}">編集</button><button type="button" data-toggle-taxonomy="${esc(subjectItem.id)}" data-next-status="${subjectItem.status === "archived" ? "restore" : "archive"}">${subjectItem.status === "archived" ? "復元" : "アーカイブ"}</button></div>` : ""; return `<article class="taxonomy-lane${subjectItem ? " taxonomy-subject-card" : ""}" data-taxonomy-lane data-taxonomy-target-group="category:${esc(subject.slug)}" data-status="${subjectItem?.status ?? "active"}" ${subjectItem ? `data-taxonomy-id="${esc(subjectItem.id)}" data-taxonomy-group="subject:" draggable="true"` : ""}><header class="taxonomy-lane__heading"><div class="taxonomy-subject-card__title">${subjectItem ? '<span class="taxonomy-drag-handle" aria-hidden="true">⠿</span>' : ""}<div><h3>${esc(subject.name)}</h3><code>${esc(subject.slug)}</code><small>${subjectItem ? `分野・${subjectItem.status === "archived" ? "アーカイブ" : "公開"}` : "既存の分野"}・カテゴリ ${categories.length}件</small></div></div>${subjectActions}</header>${categories.length ? `<ul class="taxonomy-category-list">${categories.map((item, index) => renderCategory(item, index, categories)).join("")}</ul>` : '<p class="taxonomy-empty">カテゴリをここへドロップ、または上のフォームから追加できます。</p>'}${subjectItem ? taxonomyEditor(subjectItem) : ""}</article>`; }).join("")}</div>`;
    };
    const persistTaxonomyOrder = async (items: Taxonomy[]) => {
      await send("/api/admin/editor/taxonomy", { method: "PATCH", body: JSON.stringify({ action: "reorder", items: items.map((item, index) => ({ id: item.id, sortOrder: index * 10 })) }) });
    };
    const reorderTaxonomy = async (sourceId: string, targetId: string, requestedGroup?: string) => {
      const source = taxonomy.find((item) => item.id === sourceId);
      const target = taxonomy.find((item) => item.id === targetId);
      if (!source || sourceId === targetId) return;
      const sourceGroup = taxonomyGroupKey(source);
      const targetGroup = requestedGroup ?? (target ? taxonomyGroupKey(target) : sourceGroup);
      if (source.kind === "subject" && targetGroup !== "subject:") return;
      if (source.kind === "category" && !targetGroup.startsWith("category:")) return;
      const oldSiblings = taxonomyEntries().filter((item) => taxonomyGroupKey(item) === sourceGroup);
      const nextSiblings = taxonomyEntries().filter((item) => taxonomyGroupKey(item) === targetGroup && item.id !== sourceId);
      const sourceIndex = oldSiblings.findIndex((item) => item.id === sourceId);
      let targetIndex = target ? nextSiblings.findIndex((item) => item.id === target.id) : nextSiblings.length;
      if (sourceGroup === targetGroup && sourceIndex >= 0 && target && targetIndex > sourceIndex) targetIndex -= 1;
      if (sourceIndex < 0 || targetIndex < 0) return;
      oldSiblings.splice(sourceIndex, 1);
      nextSiblings.splice(Math.max(0, targetIndex), 0, source);
      if (sourceGroup !== targetGroup && source.kind === "category") source.subject_slug = targetGroup.slice("category:".length);
      oldSiblings.forEach((item, index) => { item.sort_order = index * 10; });
      nextSiblings.forEach((item, index) => { item.sort_order = index * 10; });
      renderTaxonomy();
      try {
        if (sourceGroup !== targetGroup && source.kind === "category") await send("/api/admin/editor/taxonomy", { method: "PATCH", body: JSON.stringify({ id: source.id, action: "update", name: source.name, slug: source.slug, description: source.description ?? "", subject: source.subject_slug, sortOrder: source.sort_order }) });
        if (oldSiblings.length) await persistTaxonomyOrder(oldSiblings);
        await persistTaxonomyOrder(nextSiblings);
      } catch (error) { await load(); throw error; }
    };
    const moveTaxonomy = async (id: string, direction: "up" | "down") => {
      const entries = taxonomyEntries();
      const item = entries.find((entry) => entry.id === id);
      if (!item) return;
      const siblings = entries.filter((entry) => taxonomyGroupKey(entry) === taxonomyGroupKey(item));
      const position = siblings.findIndex((entry) => entry.id === id);
      const target = siblings[position + (direction === "up" ? -1 : 1)];
      if (target) await reorderTaxonomy(id, target.id);
    };
    let load: () => Promise<void>;
    const retry = createAdminLoadRetry(root, () => load(), "役割情報を読み込めませんでした。");
    load = async () => { retry.begin(); try { const [genreResponse, catalogResponse, taxonomyResponse] = await Promise.all([fetch("/api/admin/genre-overviews?project=atlas", { credentials: "same-origin", cache: "no-store" }), fetch("/api/admin/genre-role-catalog?project=atlas", { credentials: "same-origin", cache: "no-store" }), fetch("/api/admin/editor/taxonomy?project=atlas&includeArchived=1", { credentials: "same-origin", cache: "no-store" })]); const genre = await genreResponse.json() as GenreResponse; const catalogData = await catalogResponse.json() as CatalogResponse; const taxonomyData = await taxonomyResponse.json() as { catalog?: Taxonomy[]; error?: string }; if (!genreResponse.ok) throw new Error(genre.error ?? "担当情報を読み込めませんでした。"); if (!catalogResponse.ok) throw new Error(catalogData.error ?? "カタログを読み込めませんでした。"); if (!taxonomyResponse.ok) throw new Error(taxonomyData.error ?? "分野・カテゴリを読み込めませんでした。"); genreMembers = genre.members ?? []; catalog = catalogData.catalog ?? []; assignments = catalogData.assignments ?? []; taxonomy = taxonomyData.catalog ?? []; renderTaxonomySubjectOptions(); renderCatalogSelect(); renderSubjects(); renderCustom(); renderTaxonomy(); retry.success(); } catch (error) { retry.fail(error); throw error; } };
    const send = async (url: string, options: RequestInit) => { const response = await fetch(url, { ...options, credentials: "same-origin", headers: { "content-type": "application/json", ...(options.headers ?? {}) } }); const data = await response.json().catch(() => ({})); if (!response.ok) throw new Error(data.error ?? "保存できませんでした。"); return data; };
    const taxonomyForm = root.querySelector<HTMLFormElement>("[data-taxonomy-form]");
    const taxonomyKind = taxonomyForm?.elements.namedItem("kind") as HTMLSelectElement | null;
    const taxonomySubject = taxonomyForm?.elements.namedItem("subject") as HTMLSelectElement | null;
    const syncTaxonomySubject = () => { if (!taxonomyKind || !taxonomySubject) return; const isCategory = taxonomyKind.value === "category"; taxonomySubject.disabled = !isCategory; taxonomySubject.required = isCategory; if (!isCategory) taxonomySubject.value = ""; };
    taxonomyKind?.addEventListener("change", syncTaxonomySubject); syncTaxonomySubject();
    taxonomyForm?.addEventListener("submit", async (event) => { event.preventDefault(); const form = event.currentTarget as HTMLFormElement; const output = form.querySelector<HTMLOutputElement>("[data-taxonomy-message]")!; const values = Object.fromEntries(new FormData(form).entries()); const release = lockAdminForm(form, "追加中…"); try { await send("/api/admin/editor/taxonomy", { method: "POST", body: JSON.stringify(values) }); output.textContent = "追加しました。記事編集の目次へ反映されます。"; form.reset(); syncTaxonomySubject(); await load(); } catch (error) { output.textContent = error instanceof Error ? error.message : "追加できませんでした。"; } finally { release(); } });
    root.querySelector<HTMLFormElement>("[data-catalog-form]")?.addEventListener("submit", async (event) => { event.preventDefault(); const form = event.currentTarget as HTMLFormElement; const output = form.querySelector<HTMLOutputElement>("[data-form-message]")!; const values = Object.fromEntries(new FormData(form).entries()); const release = lockAdminForm(form, "作成中…"); try { await send("/api/admin/genre-role-catalog", { method: "POST", body: JSON.stringify(values) }); output.textContent = "作成しました。"; form.reset(); await load(); } catch (error) { output.textContent = error instanceof Error ? error.message : "作成できませんでした。"; } finally { release(); } });
    root.querySelector<HTMLFormElement>("[data-assignment-form]")?.addEventListener("submit", async (event) => { event.preventDefault(); const form = event.currentTarget as HTMLFormElement; const output = form.querySelector<HTMLOutputElement>("[data-assignment-message]")!; const values = Object.fromEntries(new FormData(form).entries()); const [systemKind, systemSlug] = String(values.catalogId ?? "").split("|"); const item = catalog.find((entry) => entry.id === values.catalogId); const release = lockAdminForm(form, "追加中…"); try { if (systemKind === "system-member" && systemSlug) await send("/api/admin/report-admin-permissions", { method: "POST", body: JSON.stringify({ email: values.email, subject: systemSlug }) }); else if (systemKind === "system-lead" && systemSlug) await send("/api/admin/editorial-workflow-roles", { method: "POST", body: JSON.stringify({ email: values.email, role: "subject-coordinator", subjects: [systemSlug] }) }); else if (item) await send("/api/admin/genre-role-catalog/assignments", { method: "POST", body: JSON.stringify({ catalogId: item.id, email: values.email }) }); else throw new Error("対象を選択してください。"); output.textContent = "追加しました。"; form.reset(); await load(); } catch (error) { output.textContent = error instanceof Error ? error.message : "追加できませんでした。"; } finally { release(); } });
    root.addEventListener("click", async (event) => {
      const target = event.target as HTMLElement;
      const removeStandard = target.closest<HTMLElement>("[data-remove-standard]");
      const removeCustom = target.closest<HTMLElement>("[data-remove-assignment]");
      const deleteCatalog = target.closest<HTMLElement>("[data-delete-catalog]");
      const toggleTaxonomy = target.closest<HTMLElement>("[data-toggle-taxonomy]");
      const editTaxonomy = target.closest<HTMLElement>("[data-edit-taxonomy]");
      const moveTaxonomyButton = target.closest<HTMLButtonElement>("[data-move-taxonomy]");
      try {
        if (moveTaxonomyButton) {
          const id = moveTaxonomyButton.dataset.moveTaxonomy;
          const direction = moveTaxonomyButton.dataset.direction;
          if (id && (direction === "up" || direction === "down")) await moveTaxonomy(id, direction);
        } else if (toggleTaxonomy) {
          await send("/api/admin/editor/taxonomy", { method: "PATCH", body: JSON.stringify({ id: toggleTaxonomy.dataset.toggleTaxonomy, action: toggleTaxonomy.dataset.nextStatus }) });
          await load();
        } else if (editTaxonomy) {
          const editor = root.querySelector<HTMLElement>(`[data-taxonomy-editor="${CSS.escape(editTaxonomy.dataset.editTaxonomy ?? "")}"]`);
          if (editor) { editor.hidden = false; editor.querySelector<HTMLInputElement>("input[name=name]")?.focus(); }
        } else if (removeStandard) {
          const [kind, email, slug] = (removeStandard.dataset.removeStandard ?? "").split("|");
          if (kind === "member") await send(`/api/admin/report-admin-permissions?email=${encodeURIComponent(email)}&subject=${encodeURIComponent(slug)}`, { method: "DELETE" });
          else { const query = new URLSearchParams({ email, role: "subject-coordinator", subject: slug }); await send(`/api/admin/editorial-workflow-roles?${query.toString()}`, { method: "DELETE" }); }
          await load();
        } else if (removeCustom) {
          const [catalogId, email] = (removeCustom.dataset.removeAssignment ?? "").split("|");
          await send(`/api/admin/genre-role-catalog/assignments?catalogId=${encodeURIComponent(catalogId)}&email=${encodeURIComponent(email)}`, { method: "DELETE" }); await load();
        } else if (deleteCatalog) {
          if (!confirm("このカスタム項目と割り当てを削除しますか？")) return;
          await send(`/api/admin/genre-role-catalog?id=${encodeURIComponent(deleteCatalog.dataset.deleteCatalog ?? "")}`, { method: "DELETE" }); await load();
        }
      } catch (error) { const message = root.querySelector<HTMLOutputElement>("[data-message]"); if (message) message.value = error instanceof Error ? error.message : "更新できませんでした。"; }
    });
    root.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;
      const cancel = target.closest<HTMLElement>("[data-cancel-taxonomy]");
      if (cancel) { const editor = root.querySelector<HTMLElement>(`[data-taxonomy-editor="${CSS.escape(cancel.dataset.cancelTaxonomy ?? "")}"]`); if (editor) editor.hidden = true; }
    });
    root.addEventListener("submit", async (event) => {
      const editor = (event.target as HTMLElement).closest<HTMLFormElement>("[data-taxonomy-editor]");
      if (!editor) return;
      event.preventDefault();
      const id = editor.dataset.taxonomyEditor ?? "";
      const item = taxonomy.find((entry) => entry.id === id);
      if (!item) return;
      const values = Object.fromEntries(new FormData(editor).entries());
      const button = editor.querySelector<HTMLButtonElement>("[data-save-taxonomy]");
      if (button) button.disabled = true;
      try {
        await send("/api/admin/editor/taxonomy", { method: "PATCH", body: JSON.stringify({ id, action: "update", name: values.name, slug: values.slug, description: values.description, sortOrder: item.sort_order, subject: item.subject_slug }) });
        await load();
      } catch (error) {
        const message = root.querySelector<HTMLOutputElement>("[data-message]");
        if (message) message.value = error instanceof Error ? error.message : "表示名を更新できませんでした。";
        if (button) button.disabled = false;
      }
    });
    let draggedTaxonomyId = "";
    taxonomyContent.addEventListener("dragstart", (event) => {
      const card = (event.target as HTMLElement).closest<HTMLElement>("[data-taxonomy-id]");
      if (!card) return;
      draggedTaxonomyId = card.dataset.taxonomyId ?? "";
      card.classList.add("is-dragging");
      event.dataTransfer?.setData("text/plain", draggedTaxonomyId);
      if (event.dataTransfer) event.dataTransfer.effectAllowed = "move";
    });
    taxonomyContent.addEventListener("dragover", (event) => {
      const card = (event.target as HTMLElement).closest<HTMLElement>("[data-taxonomy-id]");
      const lane = (event.target as HTMLElement).closest<HTMLElement>("[data-taxonomy-lane]");
      if ((!card && !lane) || !draggedTaxonomyId) return;
      const source = taxonomy.find((item) => item.id === draggedTaxonomyId);
      if (!source) return;
      const targetGroup = source.kind === "subject" ? "subject:" : (lane?.dataset.taxonomyTargetGroup ?? card?.dataset.taxonomyGroup ?? "");
      if ((source.kind === "category" && !targetGroup.startsWith("category:")) || (source.kind === "subject" && targetGroup !== "subject:")) return;
      event.preventDefault();
      card?.classList.add("is-drop-target");
      if (lane) lane.classList.add("is-drop-target");
      if (event.dataTransfer) event.dataTransfer.dropEffect = "move";
    });
    taxonomyContent.addEventListener("drop", (event) => {
      const card = (event.target as HTMLElement).closest<HTMLElement>("[data-taxonomy-id]");
      const lane = (event.target as HTMLElement).closest<HTMLElement>("[data-taxonomy-lane]");
      const source = taxonomy.find((item) => item.id === draggedTaxonomyId);
      const targetId = card?.dataset.taxonomyId ?? "";
      if (!draggedTaxonomyId || !source || (!targetId && !lane)) return;
      if (targetId === source.id) return;
      const targetGroup = source.kind === "subject" ? "subject:" : (lane?.dataset.taxonomyTargetGroup ?? card?.dataset.taxonomyGroup ?? "");
      if ((source.kind === "category" && !targetGroup.startsWith("category:")) || (source.kind === "subject" && targetGroup !== "subject:")) return;
      event.preventDefault();
      const sourceId = draggedTaxonomyId;
      draggedTaxonomyId = "";
      void reorderTaxonomy(sourceId, targetId, targetGroup).catch((error) => {
        const message = root.querySelector<HTMLOutputElement>("[data-message]");
        if (message) message.value = error instanceof Error ? error.message : "並び順を更新できませんでした。";
      });
    });
    taxonomyContent.addEventListener("dragleave", (event) => {
      const target = event.target as HTMLElement;
      target.closest<HTMLElement>(".is-drop-target")?.classList.remove("is-drop-target");
    });
    taxonomyContent.addEventListener("dragend", (event) => { (event.target as HTMLElement).closest<HTMLElement>(".is-dragging")?.classList.remove("is-dragging"); root.querySelectorAll<HTMLElement>(".is-drop-target").forEach((item) => item.classList.remove("is-drop-target")); draggedTaxonomyId = ""; });
    void load().catch((error) => { content.innerHTML = `<p class="loading">${esc(error instanceof Error ? error.message : "役割情報を読み込めませんでした。")}</p>`; customContent.innerHTML = ""; });
  }; document.addEventListener("astro:page-load", initialize); initialize();
</script>

{subjects.map((subject) => <span data-subject-data data-slug={subject.data.slug} data-name={subject.data.name.ja} data-status={subject.data.status === "published" ? "公開中" : "準備中"} data-description={subject.data.description.ja} hidden></span>)}
