---
import { getCollection } from "astro:content";
import AdminLayout from "../../layouts/AdminLayout.astro";
const subjects = (await getCollection("subjects")).sort((a, b) => a.data.order - b.data.order);
---

<AdminLayout title="ジャンル・役割管理" description="アトラスの分野と担当役割">
  <main class="genre-roles" data-genre-roles>
    <header class="page-heading"><div><p class="eyebrow">ATLAS / OWNERSHIP</p><h1>ジャンル・役割管理</h1><p class="lead">分野ごとの担当メンバーと、公開フローを担当する統括者を確認できます。</p></div><div class="heading-actions"><a href="/admin/manage/?project=atlas">← 管理トップ</a><a class="quiet" href="/admin/permissions/?project=atlas">権限を編集</a></div></header>
    <section class="legend" aria-label="役割の説明"><span><i class="dot dot--member"></i>分野担当</span><span><i class="dot dot--lead"></i>分野統括（公開フロー）</span><span><i class="dot dot--manager"></i>運営統括</span></section>
    <section class="subject-grid" aria-label="分野別の役割"><div class="loading" data-content>分野と担当を読み込んでいます…</div>{subjects.map((subject) => <span data-subject-data data-slug={subject.data.slug} data-name={subject.data.name.ja} data-status={subject.data.status === "published" ? "公開中" : "準備中"} data-description={subject.data.description.ja} hidden></span>)}</section>
  </main>
</AdminLayout>

<style>
  .genre-roles{margin:0 auto;max-width:1200px;padding:0 1.25rem 4rem}.page-heading{align-items:end;border-bottom:1px solid var(--border-default);display:flex;gap:1rem;justify-content:space-between;padding:2rem 0 1.3rem}.eyebrow{color:var(--accent-primary);font-size:.7rem;font-weight:800;letter-spacing:.1em;margin:0}.page-heading h1{font-size:clamp(1.8rem,4vw,2.5rem);margin:.25rem 0 .45rem}.lead{color:var(--text-secondary);line-height:1.7;margin:0}.heading-actions{align-items:flex-end;display:flex;flex-wrap:wrap;gap:.6rem}.heading-actions a{color:var(--accent-primary);font-size:.8rem;font-weight:800;text-decoration:none;white-space:nowrap}.heading-actions .quiet{border:1px solid var(--border-default);color:var(--text-primary);padding:.5rem .7rem}.legend{color:var(--text-secondary);display:flex;flex-wrap:wrap;font-size:.75rem;gap:1rem;margin:1rem 0}.legend span{align-items:center;display:inline-flex;gap:.35rem}.dot{background:var(--text-secondary);border-radius:50%;height:.55rem;width:.55rem}.dot--member{background:#6ba6ff}.dot--lead{background:#ac8cf4}.dot--manager{background:#e8b84a}.subject-grid{display:grid;gap:.75rem;grid-template-columns:repeat(auto-fill,minmax(280px,1fr))}.subject-card{background:var(--background-secondary);border:1px solid var(--border-default);display:grid;gap:.65rem;padding:.9rem}.subject-card__heading{align-items:start;display:flex;gap:.5rem;justify-content:space-between}.subject-card h2{font-size:1rem;margin:0}.subject-card code{color:var(--text-secondary);font-size:.68rem}.subject-status{border:1px solid var(--border-default);border-radius:999px;color:var(--text-secondary);font-size:.65rem;padding:.18rem .4rem;white-space:nowrap}.subject-description{color:var(--text-secondary);font-size:.78rem;line-height:1.55;margin:0;min-height:2.4em}.role-list{border-top:1px solid var(--border-default);display:grid;gap:.4rem;padding-top:.6rem}.role-row{align-items:start;display:grid;gap:.45rem;grid-template-columns:6.5rem 1fr}.role-label{align-items:center;color:var(--text-secondary);display:flex;font-size:.7rem;gap:.3rem;padding-top:.2rem}.people{display:flex;flex-wrap:wrap;gap:.3rem}.person{background:var(--background-primary);border:1px solid var(--border-default);border-radius:.25rem;font-size:.7rem;padding:.28rem .4rem}.person--lead{border-color:#ac8cf4;color:#ac8cf4}.person--manager{border-color:#e8b84a;color:#e8b84a}.unassigned{color:var(--text-muted);font-size:.7rem;padding-top:.25rem}.loading{color:var(--text-secondary);padding:2rem;text-align:center}@media(max-width:700px){.genre-roles{padding:0 .8rem 3rem}.page-heading{align-items:start;display:grid}.heading-actions{align-items:start}.subject-grid{grid-template-columns:1fr}}
</style>

<script>
  type Member = { display_name?: string; assignments?: string[]; subjectAssignments?: string[]; workflowSubjects?: string[]; role?: string };
  type ResponseData = { members?: Member[]; error?: string };
  const initialize = () => { const root = document.querySelector<HTMLElement>("[data-genre-roles]"); if (!root || root.dataset.ready) return; root.dataset.ready = "true"; const content = root.querySelector<HTMLElement>("[data-content]")!; const subjects = [...document.querySelectorAll<HTMLElement>("[data-subject-data]")]; const esc = (value: unknown) => String(value ?? "").replace(/[&<>"']/g, (character) => ({ "&":"&amp;", "<":"&lt;", ">":"&gt;", '"':"&quot;", "'":"&#39;" })[character] ?? character); void fetch("/api/admin/genre-overviews?project=atlas", { credentials: "same-origin", cache: "no-store" }).then(async (response) => { const data = await response.json() as ResponseData; if (!response.ok) throw new Error(data.error ?? "役割情報を読み込めませんでした。"); const members = data.members ?? []; const memberFor = (subject: string, kind: "member" | "lead") => members.filter((person) => kind === "member" ? (person.subjectAssignments ?? []).includes(subject) : (person.workflowSubjects ?? []).includes(subject)); content.innerHTML = subjects.map((subject) => { const slug = subject.dataset.slug ?? ""; const membersForSubject = memberFor(slug, "member"); const leads = memberFor(slug, "lead"); const managers = members.filter((person) => person.role === "manager"); const people = (items: Member[], className = "") => items.length ? items.map((person) => `<span class="person ${className}">${esc(person.display_name || "表示名未設定")}</span>`).join("") : '<span class="unassigned">未割り当て</span>'; return `<article class="subject-card"><div class="subject-card__heading"><div><h2>${esc(subject.dataset.name)}</h2><code>${esc(slug)}</code></div><span class="subject-status">${esc(subject.dataset.status)}</span></div><p class="subject-description">${esc(subject.dataset.description)}</p><div class="role-list"><div class="role-row"><span class="role-label"><i class="dot dot--member"></i>分野担当</span><div class="people">${people(membersForSubject)}</div></div><div class="role-row"><span class="role-label"><i class="dot dot--lead"></i>分野統括</span><div class="people">${people(leads, "person--lead")}</div></div><div class="role-row"><span class="role-label"><i class="dot dot--manager"></i>運営統括</span><div class="people">${people(managers, "person--manager")}</div></div></div></article>`; }).join(""); }).catch((error) => { content.innerHTML = `<p class="loading">${esc(error instanceof Error ? error.message : "役割情報を読み込めませんでした。")}</p>`; }); };
  document.addEventListener("astro:page-load", initialize); initialize();
</script>
