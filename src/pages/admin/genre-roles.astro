---
import { getCollection } from "astro:content";
import AdminLayout from "../../layouts/AdminLayout.astro";
import AdminRetryNotice from "../../components/admin/AdminRetryNotice.astro";
const subjects = (await getCollection("subjects")).sort((a, b) => a.data.order - b.data.order);
// 旧URLのクエリなしアクセスもジャンル管理へ寄せる。役割管理は /admin/roles/ に分離済み。
const view = "genres";
---

<AdminLayout title={view === "genres" ? "ジャンル管理" : "ジャンル・役割管理"} description="アトラスの分野と担当役割">
  <main class="genre-roles" data-genre-roles data-view={view} data-admin-load-surface data-admin-load-state="loading" aria-busy="true">
    <header class="page-heading"><div><h1 data-genre-page-title>{view === "genres" ? "ジャンル管理" : "ジャンル・役割管理"}</h1></div><div class="heading-actions"><a href="/admin/manage/?project=atlas">← 管理トップ</a><a class="quiet" data-view-link="genres" href="/admin/genre-roles/?project=atlas&view=genres">ジャンル管理</a><a class="quiet" data-view-link="roles" href="/admin/roles/?project=atlas">役割管理</a><a class="quiet" href="/admin/permissions/?project=atlas">権限管理</a></div></header>
    <section class="management-tools" aria-label="ジャンルの作成と担当設定">
      <form data-catalog-form><h2 data-catalog-title>新しいジャンルを作成</h2><input type="hidden" name="kind" value="genre" /><div class="form-row"><label class="wide">表示名<input name="name" required maxlength="120" placeholder="統計" /></label><details class="advanced-field"><summary>詳細設定（内部ID）</summary><label>ID（任意・英数字とハイフン）<input name="slug" pattern="[a-z0-9-]+" maxlength="80" placeholder="未入力なら自動生成" /></label><small>表示名から自動生成します。既存の参照関係がある場合だけ指定してください。</small></details><label class="wide">説明（任意）<input name="description" maxlength="500" placeholder="ジャンルの説明" /></label><button type="submit">作成</button></div><output data-form-message aria-live="polite"></output></form>
      <form data-assignment-form><h2 data-assignment-title>メンバーをジャンルへ追加</h2><div class="form-row"><label class="wide">メールアドレス<input type="email" name="email" required maxlength="320" placeholder="member@example.com" /></label><label class="wide">対象<select name="catalogId" data-catalog-select required><option value="">読み込み中…</option></select></label><button type="submit">追加</button></div><output data-assignment-message aria-live="polite"></output></form>
      <form data-taxonomy-form><h2>学習サイトの分野／カテゴリを追加</h2><div class="form-row"><label>種類<select name="kind"><option value="subject">分野</option><option value="category">カテゴリ</option></select></label><label class="taxonomy-subject">対象分野<select name="subject"><option value="">分野を選択</option>{subjects.map((subject) => <option value={subject.data.slug}>{subject.data.name.ja}</option>)}</select></label><label class="wide">表示名<input name="name" required maxlength="120" placeholder="例：情報、機械学習" /></label><details class="advanced-field"><summary>詳細設定（内部ID）</summary><label>ID（任意・英数字とハイフン）<input name="slug" pattern="[a-z0-9-]+" maxlength="80" placeholder="未入力なら自動生成" /></label><small>表示名から自動生成します。既存の参照関係がある場合だけ指定してください。</small></details><label class="wide">説明（任意）<input name="description" maxlength="500" placeholder="学習内容の説明" /></label><label>順番<input name="sortOrder" type="number" min="0" max="9999" value="0" /></label><button type="submit">追加</button></div><output data-taxonomy-message aria-live="polite"></output></form>
    </section>
    <section class="legend" aria-label="担当の説明"><span><i class="dot dot--member"></i>分野担当</span><span><i class="dot dot--lead"></i>分野統括（公開フロー）</span><span><i class="dot dot--custom"></i>カスタムジャンル</span></section>
    <section class="subject-grid" aria-label="分野別の役割"><div data-content><p class="loading">分野と担当を読み込んでいます…</p></div></section>
    <section class="custom-section" aria-labelledby="custom-heading"><div class="panel-heading"><h2 id="custom-heading" data-custom-title>カスタムジャンル／役割</h2><span data-custom-count>—</span></div><div class="custom-grid" data-custom-content><p class="loading">読み込み中…</p></div></section>
    <section class="taxonomy-section" aria-labelledby="taxonomy-heading"><div class="panel-heading"><div><h2 id="taxonomy-heading">学習サイトの分野／カテゴリ</h2><p class="panel-note">カードをドラッグして分野・カテゴリの順番や所属を変更できます。変更は対象記事の公開PRへ自動で反映されます。</p></div><span data-taxonomy-count>—</span></div><div class="taxonomy-controls"><label class="taxonomy-filter">表示する分野<select data-taxonomy-filter aria-label="表示する分野"><option value="">すべての分野</option></select></label><p class="taxonomy-filter-note">分野を選ぶと、その分野のカテゴリだけ表示します。</p></div><div class="taxonomy-board" data-taxonomy-content><p class="loading">読み込み中…</p></div></section>
    <AdminRetryNotice />
    <output class="message" data-message aria-live="polite"></output>
  </main>
</AdminLayout>

<style>
  .genre-roles{margin:0 auto;max-width:1250px;padding:0 1.25rem 4rem}.page-heading{align-items:end;border-bottom:1px solid var(--border-default);display:flex;gap:1rem;justify-content:space-between;padding:2rem 0 1.3rem}.eyebrow{color:var(--accent-primary);font-size:.7rem;font-weight:800;letter-spacing:.1em;margin:0}.page-heading h1{font-size:clamp(1.8rem,4vw,2.5rem);margin:.25rem 0 .45rem}.lead{color:var(--text-secondary);line-height:1.7;margin:0}.heading-actions{align-items:flex-end;display:flex;flex-wrap:wrap;gap:.6rem}.heading-actions a{color:var(--accent-primary);font-size:.8rem;font-weight:800;text-decoration:none;white-space:nowrap}.heading-actions .quiet{border:1px solid var(--border-default);color:var(--text-primary);padding:.5rem .7rem}.management-tools{display:grid;gap:.75rem;grid-template-columns:repeat(2,minmax(0,1fr));margin:1.2rem 0}.management-tools form{background:var(--background-secondary);border:1px solid var(--border-default);padding:.9rem}.management-tools h2{font-size:.9rem;margin:0 0 .65rem}.form-row{align-items:end;display:flex;flex-wrap:wrap;gap:.5rem}.form-row label{color:var(--text-secondary);display:grid;font-size:.68rem;font-weight:800;gap:.25rem;min-width:8rem}.form-row label.wide{flex:1 1 11rem}.form-row input,.form-row select{background:var(--background-primary);border:1px solid var(--border-default);color:var(--text-primary);font:inherit;min-height:2.2rem;padding:.4rem .5rem}.form-row button,.action-button{background:var(--accent-primary);border:1px solid var(--accent-primary);color:#fff;cursor:pointer;font:inherit;font-size:.72rem;font-weight:800;min-height:2.2rem;padding:.4rem .65rem}.management-tools output{color:var(--text-secondary);display:block;font-size:.7rem;min-height:1.1rem;padding-top:.45rem}.legend{color:var(--text-secondary);display:flex;flex-wrap:wrap;font-size:.75rem;gap:1rem;margin:1rem 0}.legend span{align-items:center;display:inline-flex;gap:.35rem}.dot{background:var(--text-secondary);border-radius:50%;height:.55rem;width:.55rem}.dot--member{background:#6ba6ff}.dot--lead{background:#ac8cf4}.dot--custom{background:#67c3ce}.subject-grid,.custom-grid{display:grid;gap:.75rem;grid-template-columns:repeat(auto-fill,minmax(290px,1fr))}.subject-card,.custom-card{background:var(--background-secondary);border:1px solid var(--border-default);display:grid;gap:.65rem;padding:.9rem}.subject-card__heading,.custom-card__heading{align-items:start;display:flex;gap:.5rem;justify-content:space-between}.subject-card h2,.custom-card h3{font-size:1rem;margin:0}.subject-card code,.custom-card code{color:var(--text-secondary);font-size:.68rem}.subject-status{border:1px solid var(--border-default);border-radius:999px;color:var(--text-secondary);font-size:.65rem;padding:.18rem .4rem;white-space:nowrap}.subject-description,.custom-description{color:var(--text-secondary);font-size:.78rem;line-height:1.55;margin:0;min-height:2.4em}.role-list,.custom-people{border-top:1px solid var(--border-default);display:grid;gap:.45rem;padding-top:.6rem}.role-row{align-items:start;display:grid;gap:.45rem;grid-template-columns:6.5rem 1fr}.role-label{align-items:center;color:var(--text-secondary);display:flex;font-size:.7rem;gap:.3rem;padding-top:.2rem}.people,.custom-people-list{display:flex;flex-wrap:wrap;gap:.3rem}.person{align-items:center;background:var(--background-primary);border:1px solid var(--border-default);display:inline-flex;gap:.35rem;padding:.28rem .4rem}.person span{font-size:.7rem}.person button,.custom-card button{background:transparent;border:0;color:var(--accent-primary);cursor:pointer;font-size:.65rem;padding:.1rem}.person--lead{border-color:#ac8cf4;color:#ac8cf4}.person-remove{color:#e27676!important}.unassigned,.loading{color:var(--text-muted);font-size:.7rem;padding-top:.25rem}.custom-section{border-top:1px solid var(--border-default);margin-top:2rem;padding-top:1.2rem}.panel-heading{align-items:end;display:flex;justify-content:space-between;margin-bottom:.75rem}.panel-heading h2{font-size:1.15rem;margin:.18rem 0 0}.panel-heading>span{color:var(--text-secondary);font-size:.72rem}.custom-card__meta{color:var(--text-secondary);font-size:.7rem}.custom-card__actions{display:flex;justify-content:space-between}.delete-catalog{color:#e27676!important}.message{color:var(--text-secondary);display:block;font-size:.8rem;min-height:1.2rem;padding-top:.7rem}.form-row .advanced-field{align-self:stretch;display:grid;gap:.25rem;min-width:11rem}.form-row .advanced-field summary{color:var(--accent-primary);cursor:pointer;font-size:.68rem;font-weight:800;list-style-position:inside}.form-row .advanced-field label{min-width:0}.form-row .advanced-field small{color:var(--text-secondary);font-size:.62rem;font-weight:400;line-height:1.45;max-width:18rem}@media(max-width:760px){.genre-roles{padding:0 .8rem 3rem}.page-heading{align-items:start;display:grid}.management-tools{grid-template-columns:1fr}.subject-grid,.custom-grid{grid-template-columns:1fr}}
</style>

<style is:global>
  /* 動的に生成するカードはAstroのスコープ属性を持たないため、ここだけ明示的に共有CSSを適用する。 */
  .genre-roles .subject-grid,
  .genre-roles .custom-grid {
    align-items: start;
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
  }

  .genre-roles .subject-grid [data-content] {
    display: contents;
  }

  .genre-roles .subject-card,
  .genre-roles .custom-card {
    background: var(--background-secondary);
    border: 1px solid var(--border-default);
    border-radius: 0.35rem;
    display: grid;
    gap: 0.65rem;
    min-width: 0;
    padding: 0.9rem;
  }

  .genre-roles .subject-card__heading,
  .genre-roles .custom-card__heading {
    align-items: start;
    display: flex;
    gap: 0.5rem;
    justify-content: space-between;
    min-width: 0;
  }

  .genre-roles .subject-card h2,
  .genre-roles .custom-card h3 {
    font-size: 1rem;
    margin: 0;
    overflow-wrap: anywhere;
  }

  .genre-roles .subject-card code,
  .genre-roles .custom-card code {
    color: var(--text-secondary);
    display: block;
    font-size: 0.68rem;
    margin-top: 0.2rem;
    overflow-wrap: anywhere;
  }

  .genre-roles .subject-status {
    border: 1px solid var(--border-default);
    border-radius: 999px;
    color: var(--text-secondary);
    flex: 0 0 auto;
    font-size: 0.65rem;
    padding: 0.18rem 0.4rem;
    white-space: nowrap;
  }

  .genre-roles .subject-description,
  .genre-roles .custom-description {
    color: var(--text-secondary);
    font-size: 0.78rem;
    line-height: 1.55;
    margin: 0;
    min-height: 2.4em;
  }

  .genre-roles .role-list,
  .genre-roles .custom-people {
    border-top: 1px solid var(--border-default);
    display: grid;
    gap: 0.45rem;
    padding-top: 0.6rem;
  }

  .genre-roles .role-row {
    align-items: start;
    display: grid;
    gap: 0.45rem;
    grid-template-columns: 6.5rem minmax(0, 1fr);
  }

  .genre-roles .role-label {
    align-items: center;
    color: var(--text-secondary);
    display: flex;
    font-size: 0.7rem;
    gap: 0.3rem;
    padding-top: 0.2rem;
  }

  .genre-roles .people,
  .genre-roles .custom-people-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    min-width: 0;
  }

  .genre-roles .person {
    align-items: center;
    background: var(--background-primary);
    border: 1px solid var(--border-default);
    display: inline-flex;
    gap: 0.35rem;
    max-width: 100%;
    padding: 0.28rem 0.4rem;
  }

  .genre-roles .person span {
    font-size: 0.7rem;
    overflow-wrap: anywhere;
  }

  .genre-roles .person button,
  .genre-roles .custom-card button {
    background: transparent;
    border: 0;
    color: var(--accent-primary);
    cursor: pointer;
    font-size: 0.65rem;
    padding: 0.1rem;
  }

  .genre-roles .person--lead {
    border-color: #ac8cf4;
    color: #ac8cf4;
  }

  .genre-roles .person-remove {
    color: #e27676 !important;
  }

  .genre-roles .unassigned,
  .genre-roles .loading,
  .genre-roles .empty-state,
  .genre-roles .error-state {
    color: var(--text-muted);
    font-size: 0.7rem;
    padding-top: 0.25rem;
  }

  .genre-roles .custom-card__meta {
    color: var(--text-secondary);
    font-size: 0.7rem;
  }

  .genre-roles .custom-card__actions {
    display: flex;
    justify-content: space-between;
  }

  .genre-roles .custom-card__assignment { align-items: end; border-top: 1px solid var(--border-default); display: grid; gap: .4rem; grid-template-columns: minmax(0, 1fr) auto; padding-top: .6rem; }
  .genre-roles .custom-card__assignment label { color: var(--text-secondary); display: grid; font-size: .65rem; font-weight: 800; gap: .2rem; }
  .genre-roles .custom-card__assignment input { background: var(--background-primary); border: 1px solid var(--border-default); color: var(--text-primary); font: inherit; min-height: 2rem; min-width: 0; padding: .35rem .4rem; }
  .genre-roles .custom-card__assignment button { background: var(--accent-primary); border: 1px solid var(--accent-primary); color: #fff; cursor: pointer; font: inherit; font-size: .67rem; font-weight: 800; min-height: 2rem; padding: .35rem .5rem; }
  .genre-roles .custom-card__assignment button:disabled { cursor: wait; opacity: .65; }
  .genre-roles .custom-card__assignment output { color: var(--text-secondary); font-size: .65rem; grid-column: 1 / -1; min-height: 1rem; }
  @media (max-width: 520px) { .genre-roles .custom-card__assignment { grid-template-columns: 1fr; } }

  .genre-roles .taxonomy-section { border-top: 1px solid var(--border-default); margin-top: 2rem; padding-top: 1.2rem; }
  .genre-roles .panel-note { color: var(--text-secondary); font-size: .72rem; line-height: 1.5; margin: .3rem 0 0; }
  .genre-roles .taxonomy-controls { align-items: end; display: flex; flex-wrap: wrap; gap: .45rem .8rem; justify-content: space-between; margin: .35rem 0 .65rem; }
  .genre-roles .taxonomy-filter { color: var(--text-secondary); display: grid; font-size: .68rem; font-weight: 800; gap: .25rem; min-width: min(100%, 18rem); }
  .genre-roles .taxonomy-filter select { background: var(--background-primary); border: 1px solid var(--border-default); color: var(--text-primary); font: inherit; min-height: 2rem; min-width: 0; padding: .3rem .45rem; }
  .genre-roles .taxonomy-filter-note { color: var(--text-muted); font-size: .68rem; margin: 0 0 .1rem; }
  .genre-roles .taxonomy-board { display: grid; gap: .8rem; }
  .genre-roles .taxonomy-lanes { align-items: start; display: grid; gap: .7rem; grid-template-columns: repeat(auto-fit, minmax(21rem, 1fr)); }
  .genre-roles .taxonomy-subjects { display: grid; gap: .55rem; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); }
  .genre-roles .taxonomy-subject-card,
  .genre-roles .taxonomy-lane { align-content: start; align-self: start; background: var(--background-secondary); border: 1px solid var(--border-default); border-radius: .45rem; min-width: 0; position: relative; }
  .genre-roles .taxonomy-subject-card { display: grid; gap: .5rem; padding: .7rem .8rem; }
  .genre-roles .taxonomy-subject-card[draggable="true"] { cursor: grab; transition: border-color .15s ease, background .15s ease, transform .15s ease; }
  .genre-roles .taxonomy-subject-card[draggable="true"]:hover { background: var(--background-inset); border-color: var(--accent-primary); transform: translateY(-1px); }
  .genre-roles .taxonomy-subject-card[draggable="true"]:active { cursor: grabbing; }
  .genre-roles .taxonomy-subject-card.is-dragging,
  .genre-roles .taxonomy-category.is-dragging { opacity: .45; }
  .genre-roles .taxonomy-subject-card__heading,
  .genre-roles .taxonomy-lane__heading { align-items: flex-start; display: flex; flex-wrap: wrap; gap: .6rem; justify-content: space-between; min-width: 0; }
  .genre-roles .taxonomy-subject-card__title { align-items: center; display: flex; flex: 1 1 12rem; gap: .45rem; min-width: 0; }
  .genre-roles .taxonomy-drag-handle { color: var(--text-muted); cursor: grab; font-size: .9rem; letter-spacing: -.1em; user-select: none; }
  .genre-roles .taxonomy-title-button { background: transparent; border: 0; color: var(--text-primary); cursor: text; display: block; font: inherit; margin: 0; max-width: 100%; min-width: 0; padding: 0; text-align: left; }
  .genre-roles .taxonomy-category > .taxonomy-title-button { flex: 1 1 9rem; min-width: 5rem; }
  .genre-roles .taxonomy-category > .taxonomy-title-button strong { display: block; font-size: .73rem; overflow-wrap: anywhere; }
  .genre-roles .taxonomy-title-button:hover { color: var(--accent-primary); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; }
  .genre-roles .taxonomy-title-button:focus-visible { border-radius: .2rem; outline: 2px solid var(--accent-primary); outline-offset: 3px; }
  .genre-roles .taxonomy-title-button:disabled { color: inherit; cursor: default; text-decoration: none; }
  .genre-roles .taxonomy-subject-card h3,
  .genre-roles .taxonomy-lane h3 { font-size: .92rem; margin: 0; overflow-wrap: anywhere; }
  .genre-roles .taxonomy-subject-card code { color: var(--text-secondary); display: block; font-size: .66rem; margin-top: .15rem; overflow-wrap: anywhere; }
  .genre-roles .taxonomy-lane { overflow: hidden; }
  .genre-roles .taxonomy-lane__heading { border-bottom: 1px solid var(--border-default); padding: .65rem .8rem; }
  .genre-roles .taxonomy-lane__heading > div { min-width: 0; }
  .genre-roles .taxonomy-lane__heading small { color: var(--text-secondary); display: block; font-size: .64rem; margin-top: .15rem; }
  .genre-roles .taxonomy-lane__heading .subject-status { font-size: .6rem; }
  .genre-roles .taxonomy-category-list { display: grid; gap: .4rem; list-style: none; margin: 0; min-height: 2.7rem; padding: .55rem; }
  .genre-roles .taxonomy-category { align-items: start; background: var(--background-primary); border: 1px solid var(--border-default); border-radius: .3rem; display: grid; gap: .2rem .5rem; grid-template-areas: "handle title" "handle label" "handle actions" "handle editor"; grid-template-columns: auto minmax(0, 1fr); justify-content: stretch; min-width: 0; padding: .45rem .55rem; position: relative; transition: border-color .15s ease, background .15s ease, transform .15s ease; }
  .genre-roles .taxonomy-category:hover { background: var(--background-inset); border-color: var(--border-strong); }
  .genre-roles .taxonomy-category[draggable="true"] { cursor: grab; }
  .genre-roles .taxonomy-category[draggable="true"]:active { cursor: grabbing; }
  .genre-roles .taxonomy-category.is-drop-target,
  .genre-roles .taxonomy-lane.is-drop-target { border-color: var(--accent-primary); background: color-mix(in srgb, var(--accent-primary) 9%, var(--background-primary)); }
  .genre-roles .taxonomy-category[data-drop-position="before"]::before,
  .genre-roles .taxonomy-category[data-drop-position="after"]::after,
  .genre-roles .taxonomy-subject-card[data-drop-position="before"]::before,
  .genre-roles .taxonomy-subject-card[data-drop-position="after"]::after { background: var(--accent-primary); border-radius: 999px; content: ""; height: 3px; left: .35rem; position: absolute; right: .35rem; }
  .genre-roles .taxonomy-category[data-drop-position="before"]::before,
  .genre-roles .taxonomy-subject-card[data-drop-position="before"]::before { top: -.25rem; }
  .genre-roles .taxonomy-category[data-drop-position="after"]::after,
  .genre-roles .taxonomy-subject-card[data-drop-position="after"]::after { bottom: -.25rem; }
  .genre-roles .taxonomy-category-list:empty { min-height: 3.5rem; }
  .genre-roles .taxonomy-lane.is-dragging { box-shadow: 0 10px 24px color-mix(in srgb, var(--text-primary) 18%, transparent); transform: scale(1.01); }
  .genre-roles .taxonomy-category.is-dragging { box-shadow: 0 8px 18px color-mix(in srgb, var(--text-primary) 16%, transparent); transform: scale(1.015); }
  .genre-roles .taxonomy-drag-preview { background: var(--background-secondary); border: 1px solid var(--accent-primary); border-radius: .45rem; box-shadow: 0 12px 28px rgb(0 0 0 / 28%); left: -9999px; max-width: 22rem; opacity: .96; padding: .55rem .7rem; pointer-events: none; position: fixed; top: -9999px; width: 18rem; z-index: 9999; }
  .genre-roles .taxonomy-category > .taxonomy-drag-handle { align-self: start; grid-area: handle; padding-top: .1rem; }
  .genre-roles .taxonomy-category > .taxonomy-title-button { flex: none; grid-area: title; min-width: 0; width: 100%; }
  .genre-roles .taxonomy-category__label { align-items: center; display: flex; flex-wrap: wrap; gap: .25rem .45rem; grid-area: label; min-width: 0; }
  .genre-roles .taxonomy-category__label strong { color: var(--text-primary); display: block; font-size: .73rem; overflow-wrap: anywhere; }
  .genre-roles .taxonomy-category__label code { color: var(--text-secondary); display: block; font-size: .6rem; margin-top: .12rem; overflow-wrap: anywhere; }
