<script>
  import { createAdminLoadRetry } from "../../scripts/admin-load-retry";
  import { lockAdminForm } from "../../scripts/admin-form-submit-lock";
  import { readAdminApiJson } from "../../lib/admin-api";

  type Member = { display_name?: string; email?: string; subjectAssignments?: string[]; workflowSubjects?: string[]; role?: string };
  type GenreResponse = { members?: Member[]; error?: string };
  type Catalog = { id: string; kind: "genre" | "role"; slug: string; name: string; description?: string; status?: "active" | "archived" };
  type Assignment = { catalog_id: string; email: string; display_name?: string };
  type CatalogResponse = { catalog?: Catalog[]; assignments?: Assignment[]; canEdit?: boolean; error?: string };
  type Taxonomy = { id: string; kind: "subject" | "category"; subject_slug: string; slug: string; name: string; description?: string; sort_order?: number; status?: "active" | "archived"; publication_status?: "preparing" | "published"; created_by?: string; updated_by?: string; updated_at?: string };
  const initialize = () => { const root = document.querySelector<HTMLElement>("[data-genre-roles]"); if (!root || root.dataset.ready) return; root.dataset.ready = "true"; const genresOnly = new URLSearchParams(window.location.search).get("view") === "genres"; root.dataset.view = genresOnly ? "genres" : "legacy"; const pageTitle = root.querySelector<HTMLElement>("[data-genre-page-title]"); const catalogTitle = root.querySelector<HTMLElement>("[data-catalog-title]"); const assignmentTitle = root.querySelector<HTMLElement>("[data-assignment-title]"); const customTitle = root.querySelector<HTMLElement>("[data-custom-title]"); const viewLinks = root.querySelectorAll<HTMLElement>("[data-view-link]"); if (pageTitle) pageTitle.textContent = genresOnly ? "ジャンル管理" : "ジャンル・役割管理"; if (catalogTitle) catalogTitle.textContent = genresOnly ? "新しいジャンルを作成" : "新しいジャンル／役割を作成"; if (assignmentTitle) assignmentTitle.textContent = genresOnly ? "メンバーをジャンルへ追加" : "メンバーをジャンル／役割へ追加"; if (customTitle) customTitle.textContent = genresOnly ? "カスタムジャンル" : "カスタムジャンル／役割"; viewLinks.forEach((link) => { link.hidden = genresOnly ? link.dataset.viewLink === "genres" : link.dataset.viewLink === "roles"; }); const catalogKind = root.querySelector<HTMLSelectElement>('[data-catalog-form] select[name="kind"]'); if (genresOnly) catalogKind?.querySelector('option[value="role"]')?.remove(); const content = root.querySelector<HTMLElement>("[data-content]")!; const customContent = root.querySelector<HTMLElement>("[data-custom-content]")!; const customCount = root.querySelector<HTMLElement>("[data-custom-count]")!; const taxonomyContent = root.querySelector<HTMLElement>("[data-taxonomy-content]")!; const taxonomyCount = root.querySelector<HTMLElement>("[data-taxonomy-count]")!; const taxonomyFilter = root.querySelector<HTMLSelectElement>("[data-taxonomy-filter]"); const catalogSelect = root.querySelector<HTMLSelectElement>("[data-catalog-select]")!; const esc = (value: unknown) => String(value ?? "").replace(/[&<>"']/g, (character) => ({ "&":"&amp;", "<":"&lt;", ">":"&gt;", '"':"&quot;", "'":"&#39;" })[character] ?? character); let genreMembers: Member[] = []; let catalog: Catalog[] = []; let assignments: Assignment[] = []; let taxonomy: Taxonomy[] = [];
    const memberName = (member: Member | Assignment) => member.display_name?.trim() || member.email || "表示名未設定";
    const people = (items: Array<Member | Assignment>, className = "", remove?: (item: Member | Assignment) => string) => items.length ? items.map((item) => `<span class="person ${className}"><span>${esc(memberName(item))}</span>${remove ? `<button type="button" class="person-remove" data-remove-assignment="${esc(remove(item))}" aria-label="${esc(memberName(item))}を削除">削除</button>` : ""}</span>`).join("") : '<span class="unassigned">未割り当て</span>';
    const subjectRows = () => { const rows = new Map<string, { slug: string; name: string; status: string; description: string }>(); Array.from(document.querySelectorAll<HTMLElement>("[data-subject-data]")).forEach((subject) => { const slug = subject.dataset.slug ?? ""; if (slug) rows.set(slug, { slug, name: subject.dataset.name ?? slug, status: subject.dataset.status ?? "公開中", description: subject.dataset.description ?? "" }); }); taxonomy.filter((item) => item.kind === "subject").forEach((item) => { rows.set(item.slug, { slug: item.slug, name: item.name, status: item.status === "archived" ? "アーカイブ" : item.publication_status === "published" ? "公開中" : "準備中", description: item.description ?? "" }); }); return [...rows.values()]; };
    const renderTaxonomySubjectOptions = () => { if (!taxonomySubject) return; const current = taxonomySubject.value; const options = subjectRows().filter((subject) => subject.status !== "アーカイブ").map((subject) => `<option value="${esc(subject.slug)}">${esc(subject.name)}${subject.status === "準備中" ? "（準備中）" : ""}</option>`).join(""); taxonomySubject.innerHTML = `<option value="">分野を選択</option>${options}`; taxonomySubject.value = subjectRows().some((subject) => subject.slug === current && subject.status !== "アーカイブ") ? current : ""; };
    const readTaxonomyFilter = () => taxonomyFilter?.value || new URLSearchParams(window.location.search).get("taxonomySubject") || "";
    const renderTaxonomyFilter = () => { if (!taxonomyFilter) return; const current = readTaxonomyFilter(); const availableSubjects = subjectRows().filter((subject) => subject.status !== "アーカイブ"); taxonomyFilter.innerHTML = `<option value="">すべての分野</option>${availableSubjects.map((subject) => `<option value="${esc(subject.slug)}">${esc(subject.name)}${subject.status === "準備中" ? "（準備中）" : ""}</option>`).join("")}`; taxonomyFilter.value = availableSubjects.some((subject) => subject.slug === current) ? current : ""; };
    const renderCatalogSelect = () => { const system = subjectRows().map((subject) => `<option value="system-member|${esc(subject.slug)}">分野担当：${esc(subject.name)}</option><option value="system-lead|${esc(subject.slug)}">分野統括：${esc(subject.name)}</option>`).join(""); const customItems = catalog.filter((item) => (!genresOnly || item.kind === "genre") && item.status !== "archived"); catalogSelect.innerHTML = `<option value="">選択してください</option>${system}${customItems.map((item) => `<option value="${esc(item.id)}">${esc(item.kind === "genre" ? "ジャンル" : "役割")}：${esc(item.name)}</option>`).join("")}`; catalogSelect.disabled = false; };
    const renderSubjects = () => { const subjectElements = subjectRows(); content.innerHTML = subjectElements.map((subject) => { const slug = subject.slug; const assigned = genreMembers.filter((member) => (member.subjectAssignments ?? []).includes(slug)); const leads = genreMembers.filter((member) => (member.workflowSubjects ?? []).includes(slug)); const memberButtons = assigned.map((member) => `<span class="person"><span>${esc(memberName(member))}</span><button type="button" class="person-remove" data-remove-standard="member|${esc(member.email)}|${esc(slug)}">削除</button></span>`).join("") || '<span class="unassigned">未割り当て</span>'; const leadButtons = leads.map((member) => `<span class="person person--lead"><span>${esc(memberName(member))}</span><button type="button" class="person-remove" data-remove-standard="lead|${esc(member.email)}|${esc(slug)}">削除</button></span>`).join("") || '<span class="unassigned">未割り当て</span>'; return `<article class="subject-card"><div class="subject-card__heading"><div><h2>${esc(subject.name)}</h2><code>${esc(slug)}</code></div><span class="subject-status">${esc(subject.status)}</span></div><p class="subject-description">${esc(subject.description)}</p><div class="role-list"><div class="role-row"><span class="role-label"><i class="dot dot--member"></i>分野担当</span><div class="people">${memberButtons}</div></div><div class="role-row"><span class="role-label"><i class="dot dot--lead"></i>分野統括</span><div class="people">${leadButtons}</div></div></div></article>`; }).join("") || '<p class="empty-state">分野情報がありません。</p>'; };
    const renderCustom = () => { const visibleCatalog = catalog.filter((item) => !genresOnly || item.kind === "genre"); customCount.textContent = `${visibleCatalog.length}件`; customContent.innerHTML = visibleCatalog.length ? visibleCatalog.map((item) => { const itemAssignments = assignments.filter((assignment) => assignment.catalog_id === item.id); const archived = item.status === "archived"; return `<article class="custom-card${archived ? " custom-card--archived" : ""}" data-custom-id="${esc(item.id)}" data-status="${esc(item.status ?? "active")}"><div class="custom-card__heading"><div><h3>${esc(item.name)}</h3><code>${esc(item.slug)}</code></div><span class="subject-status">${archived ? "アーカイブ" : item.kind === "genre" ? "ジャンル" : "役割"}</span></div><p class="custom-description">${esc(item.description || "説明はまだ登録されていません。")}</p><div class="custom-people"><strong class="custom-card__meta">参加メンバー</strong><div class="custom-people-list">${people(itemAssignments, "", (assignment) => `${item.id}|${assignment.email}`)}</div></div><div class="custom-card__actions"><span class="custom-card__meta">${itemAssignments.length}人</span><span class="custom-card__buttons"><button type="button" class="quiet" data-edit-catalog="${esc(item.id)}">編集</button><button type="button" class="delete-catalog" data-toggle-catalog="${esc(item.id)}" data-next-status="${archived ? "restore" : "archive"}">${archived ? "復元" : "アーカイブ"}</button></span></div><form class="catalog-editor" data-catalog-editor="${esc(item.id)}" hidden><label>表示名<input name="name" value="${esc(item.name)}" maxlength="120" required /></label><details class="advanced-field"><summary>詳細設定（内部ID）</summary><label>ID（任意・英数字とハイフン）<input name="slug" value="${esc(item.slug)}" pattern="[a-z0-9-]+" maxlength="80" /></label><small>参照関係を保つため、通常は変更しません。</small></details><label>説明<input name="description" value="${esc(item.description ?? "")}" maxlength="500" /></label><div><button type="submit">保存</button><button type="button" class="quiet" data-cancel-catalog="${esc(item.id)}">キャンセル</button></div></form></article>`; }).join("") : '<p class="empty-state">カスタム項目はまだありません。</p>'; };
    const attachCustomAssignmentForms = () => { customContent.querySelectorAll<HTMLElement>("[data-custom-id]").forEach((card) => { if (card.querySelector("[data-custom-assignment]")) return; const item = catalog.find((entry) => entry.id === card.dataset.customId); if (!item || item.status === "archived") return; card.querySelector<HTMLElement>(".custom-card__actions")?.insertAdjacentHTML("beforebegin", `<form class="custom-card__assignment" data-custom-assignment="${esc(item.id)}"><label>この${item.kind === "genre" ? "ジャンル" : "役割"}の担当メンバー<input type="email" name="email" required maxlength="320" placeholder="member@example.com" /></label><button type="submit">追加</button><output aria-live="polite"></output></form>`); }); };
    new MutationObserver(attachCustomAssignmentForms).observe(customContent, { childList: true });
    const taxonomyGroupKey = (item: Taxonomy) => `${item.kind}:${item.subject_slug}`;
    const taxonomyEntries = () => taxonomy.slice().sort((a, b) => a.kind.localeCompare(b.kind) || a.subject_slug.localeCompare(b.subject_slug) || (Number(a.sort_order ?? 0) - Number(b.sort_order ?? 0)) || a.name.localeCompare(b.name, "ja"));
    const taxonomyEditor = (item: Taxonomy) => `<form class="taxonomy-editor" data-taxonomy-editor="${esc(item.id)}" hidden><label>表示名<input name="name" value="${esc(item.name)}" maxlength="120" required /></label><details class="advanced-field"><summary>詳細設定（内部ID）</summary><label>ID（任意・英数字とハイフン）<input name="slug" value="${esc(item.slug)}" pattern="[a-z0-9-]+" maxlength="80" /></label><small>参照関係を保つため、通常は変更しません。</small></details><label>説明<input name="description" value="${esc(item.description ?? "")}" maxlength="500" /></label><div class="taxonomy-editor__actions"><button type="submit" data-save-taxonomy="${esc(item.id)}">保存</button><button type="button" data-cancel-taxonomy="${esc(item.id)}">キャンセル</button></div></form>`;
    const taxonomyPublicationAction = (item: Taxonomy) => item.created_by && item.created_by !== "system" ? `<button type="button" data-publish-taxonomy="${esc(item.id)}" data-next-publication="${item.publication_status === "published" ? "unpublish" : "publish"}">${item.publication_status === "published" ? "準備中へ戻す" : "公開準備完了"}</button>` : "";
    const renderTaxonomy = () => {
      const entries = taxonomyEntries();
      const subjectItems = new Map(entries.filter((item) => item.kind === "subject").map((item) => [item.slug, item]));
      const categoriesBySubject = new Map<string, Taxonomy[]>();
      entries.filter((item) => item.kind === "category").forEach((item) => { const list = categoriesBySubject.get(item.subject_slug) ?? []; list.push(item); categoriesBySubject.set(item.subject_slug, list); });
      const allSubjects = subjectRows().sort((left, right) => {
        const leftItem = subjectItems.get(left.slug); const rightItem = subjectItems.get(right.slug);
        if (leftItem && rightItem) return (Number(leftItem.sort_order ?? 0) - Number(rightItem.sort_order ?? 0)) || left.name.localeCompare(right.name, "ja");
        if (leftItem) return 1;
        if (rightItem) return -1;
        return left.name.localeCompare(right.name, "ja");
      });
      const selectedSubject = readTaxonomyFilter();
      const visibleSubjects = allSubjects.filter((subject) => !selectedSubject || subject.slug === selectedSubject);
      const selectedSubjectRow = allSubjects.find((subject) => subject.slug === selectedSubject);
      taxonomyCount.textContent = selectedSubjectRow ? `${selectedSubjectRow.name}・${categoriesBySubject.get(selectedSubjectRow.slug)?.length ?? 0}カテゴリ` : `${entries.length}件・${allSubjects.length}分野`;
      if (!visibleSubjects.length) { taxonomyContent.innerHTML = '<p class="empty-state">追加した分野・カテゴリはまだありません。</p>'; return; }
      const renderCategory = (item: Taxonomy, position: number, siblings: Taxonomy[]) => `<li class="taxonomy-category taxonomy-card" data-status="${esc(item.status ?? "active")}" data-taxonomy-id="${esc(item.id)}" data-taxonomy-group="${esc(taxonomyGroupKey(item))}" draggable="true" aria-grabbed="false" aria-label="${esc(item.name)}。タイトルをクリックして編集。ドラッグしてカテゴリの順番または所属分野を変更"><span class="taxonomy-drag-handle" aria-hidden="true">⠿</span><button type="button" class="taxonomy-title-button" data-inline-edit-taxonomy="${esc(item.id)}" aria-label="${esc(item.name)}の表示名を編集"><strong>${esc(item.name)}</strong></button><div class="taxonomy-category__label"><code>${esc(item.slug)}</code><small>${item.publication_status === "published" ? "公開中" : "準備中"}</small></div><div class="taxonomy-category__actions"><span class="taxonomy-order-actions"><button type="button" data-move-taxonomy="${esc(item.id)}" data-direction="up" aria-label="${esc(item.name)}を上へ" ${position <= 0 ? "disabled" : ""}>↑</button><button type="button" data-move-taxonomy="${esc(item.id)}" data-direction="down" aria-label="${esc(item.name)}を下へ" ${position >= siblings.length - 1 ? "disabled" : ""}>↓</button></span><button type="button" data-edit-taxonomy="${esc(item.id)}">編集</button>${taxonomyPublicationAction(item)}<button type="button" data-toggle-taxonomy="${esc(item.id)}" data-next-status="${item.status === "archived" ? "restore" : "archive"}">${item.status === "archived" ? "復元" : "アーカイブ"}</button></div>${taxonomyEditor(item)}</li>`;
      taxonomyContent.innerHTML = `<div class="taxonomy-lanes">${visibleSubjects.map((subject) => { const subjectItem = subjectItems.get(subject.slug); const categories = categoriesBySubject.get(subject.slug) ?? []; const subjectSiblings = entries.filter((entry) => entry.kind === "subject"); const subjectPosition = subjectItem ? subjectSiblings.findIndex((entry) => entry.id === subjectItem.id) : -1; const subjectStatus = subjectItem?.status === "archived" ? "アーカイブ" : subjectItem?.publication_status === "published" ? "公開中" : "準備中"; const subjectActions = subjectItem ? `<div class="taxonomy-subject-card__actions"><span class="taxonomy-order-actions"><button type="button" data-move-taxonomy="${esc(subjectItem.id)}" data-direction="up" aria-label="${esc(subject.name)}を上へ" ${subjectPosition <= 0 ? "disabled" : ""}>↑</button><button type="button" data-move-taxonomy="${esc(subjectItem.id)}" data-direction="down" aria-label="${esc(subject.name)}を下へ" ${subjectPosition >= subjectSiblings.length - 1 ? "disabled" : ""}>↓</button></span><button type="button" data-edit-taxonomy="${esc(subjectItem.id)}">編集</button>${taxonomyPublicationAction(subjectItem)}<button type="button" data-toggle-taxonomy="${esc(subjectItem.id)}" data-next-status="${subjectItem.status === "archived" ? "restore" : "archive"}">${subjectItem.status === "archived" ? "復元" : "アーカイブ"}</button></div>` : ""; return `<article class="taxonomy-lane${subjectItem ? " taxonomy-subject-card" : ""}" data-taxonomy-lane data-taxonomy-target-group="category:${esc(subject.slug)}" data-status="${esc(subjectItem?.status ?? "active")}" ${subjectItem ? `data-taxonomy-id="${esc(subjectItem.id)}" data-taxonomy-group="subject:" draggable="true" aria-grabbed="false" aria-label="${esc(subject.name)}。タイトルをクリックして編集。ドラッグして分野の順番を変更"` : ""}><header class="taxonomy-lane__heading"><div class="taxonomy-subject-card__title">${subjectItem ? '<span class="taxonomy-drag-handle" aria-hidden="true">⠿</span>' : ""}<div><button type="button" class="taxonomy-title-button" data-inline-edit-taxonomy="${subjectItem ? esc(subjectItem.id) : ""}" ${subjectItem ? `aria-label="${esc(subject.name)}の表示名を編集"` : "disabled"}><h3>${esc(subject.name)}</h3></button><code>${esc(subject.slug)}</code><small>${subjectItem ? `分野・${subjectStatus}` : "既存の分野"}・カテゴリ ${categories.length}件</small></div></div>${subjectActions}</header>${categories.length ? `<ul class="taxonomy-category-list">${categories.map((item, index) => renderCategory(item, index, categories)).join("")}</ul>` : '<p class="taxonomy-empty">カテゴリをここへドロップ、または上のフォームから追加できます。</p>'}${subjectItem ? taxonomyEditor(subjectItem) : ""}</article>`; }).join("")}</div>`;
    };
    const persistTaxonomyOrder = async (items: Taxonomy[]) => {
      await send("/api/admin/editor/taxonomy", { method: "PATCH", body: JSON.stringify({ action: "reorder", items: items.map((item, index) => ({ id: item.id, sortOrder: index * 10 })) }) });
    };
    const reorderTaxonomy = async (sourceId: string, targetId: string, requestedGroup?: string, placement: "before" | "after" = "before") => {
      const source = taxonomy.find((item) => item.id === sourceId);
      const target = taxonomy.find((item) => item.id === targetId);
      if (!source || sourceId === targetId) return;
      const sourceGroup = taxonomyGroupKey(source);
      const targetGroup = requestedGroup ?? (target ? taxonomyGroupKey(target) : sourceGroup);
      if (source.kind === "subject" && targetGroup !== "subject:") return;
      if (source.kind === "category" && !targetGroup.startsWith("category:")) return;
      const oldSiblings = taxonomyEntries().filter((item) => taxonomyGroupKey(item) === sourceGroup);
      const sourceIndex = oldSiblings.findIndex((item) => item.id === sourceId);
      if (sourceIndex < 0) return;
      const nextSiblings = (sourceGroup === targetGroup ? oldSiblings : taxonomyEntries().filter((item) => taxonomyGroupKey(item) === targetGroup))
