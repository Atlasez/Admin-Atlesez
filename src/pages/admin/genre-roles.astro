<script is:inline>
  const legacyView = new URLSearchParams(window.location.search).get("view");
  if (legacyView === "roles") {
    const roleUrl = new URL("/admin/roles/", window.location.origin);
    roleUrl.searchParams.set("project", "atlas");
    window.location.replace(`${roleUrl.pathname}${roleUrl.search}`);
  } else if (legacyView !== "genres") {
    const compatibleUrl = new URL(window.location.href);
    compatibleUrl.searchParams.set("view", "genres");
    window.history.replaceState({}, "", compatibleUrl);
  }
