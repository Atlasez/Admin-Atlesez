---
import "../styles/xai-prototype.css";
import { featuredStories, xaiStories, type XaiStory } from "./news-data";

type Props = { page: string; story?: XaiStory };
const { page, story } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const localPath = (path: string) => `${base}${path}`;

const products = [
  { name: "Chat", href: `${base}/grok/`, note: "Reasoning, search, and voice", tone: "chat" },
  { name: "Build", href: `${base}/build/`, note: "A coding agent for your work", tone: "build" },
  { name: "Bot", href: `${base}/bot/`, note: "Persistent AI teammates", tone: "bot" },
  { name: "Imagine", href: `${base}/api/imagine/`, note: "Images and video", tone: "imagine" },
  { name: "Voice", href: `${base}/voice/`, note: "Natural voice agents", tone: "voice" },
];

const navGroups = [
  { id: "products", label: "Products", links: products },
  {
    id: "solutions",
    label: "Solutions",
    links: [
      { name: "Business", href: "https://x.ai/grok/business", note: "For teams", tone: "" },
      { name: "Government", href: "https://x.ai/grok/government", note: "Public sector", tone: "" },
      { name: "Customer support", href: "https://x.ai/solutions/customer-support", note: "Support operations", tone: "" },
      { name: "Legal", href: "https://x.ai/solutions/legal", note: "Legal teams", tone: "" },
    ],
  },
  {
    id: "developer",
    label: "Developer",
    links: [
      { name: "API", href: `${base}/api/`, note: "One API, every modality", tone: "" },
      { name: "Pricing", href: `${base}/pricing/`, note: "Plans and usage", tone: "" },
      { name: "Documentation", href: "https://docs.x.ai/", note: "Guides and references", tone: "" },
      { name: "Console", href: "https://console.x.ai/", note: "Manage your account", tone: "" },
    ],
  },
  {
    id: "company",
    label: "Company",
    links: [
      { name: "About", href: `${base}/company/`, note: "Our mission", tone: "" },
      { name: "Colossus", href: `${base}/colossus/`, note: "Compute at scale", tone: "" },
      { name: "Careers", href: `${base}/careers/`, note: "Join the team", tone: "" },
      { name: "News", href: `${base}/news/`, note: "Latest updates", tone: "" },
    ],
  },
];

const benefits = [
  ["Competitive compensation", "Competitive cash and equity-based compensation packages to attract top talent."],
  ["Health and wellness", "Comprehensive health insurance including medical, dental, vision, and disability coverage."],
  ["Life and family", "Life and AD&D insurance and fertility benefits to ensure our team's well-being."],
  ["Flexible vacation", "We work hard but avoid burnout. Take time off when you need it."],
  ["Visa sponsorship", "We support international talent with visa sponsorship to join our team."],
  ["401(k) plan", "Retirement savings plan to secure your financial future."],
];

const roles = [
  ["Construction Scheduler - Memphis Southaven, MS", "Memphis, TN", "Infrastructure", "https://job-boards.greenhouse.io/xai/jobs/5242789007"],
  ["Controls Technician - Memphis Southaven, MS", "Memphis, TN", "Infrastructure", "https://job-boards.greenhouse.io/xai/jobs/5225280007"],
  ["Plumbing Technician - Memphis Southaven, MS", "Memphis, TN", "Infrastructure", "https://job-boards.greenhouse.io/xai/jobs/5224741007"],
  ["Fire Protection Technician - Memphis", "Memphis, TN", "Infrastructure", "https://job-boards.greenhouse.io/xai/jobs/5224723007"],
  ["Lead Engineer, Data Center - Memphis", "Memphis, TN", "Infrastructure", "https://job-boards.greenhouse.io/xai/jobs/5214918007"],
  ["Software Engineer - Network (C++)", "Palo Alto, CA · Seattle, WA", "Engineering", "https://job-boards.greenhouse.io/xai/jobs/5179367007"],
];

const apiCode = {
  Python: `import os\nfrom xai_sdk import Client\nfrom xai_sdk.chat import user\n\nclient = Client(api_key=os.getenv("XAI_API_KEY"))\nchat = client.chat.create(model="grok-4.7")\nchat.append(user("Explain quantum computing"))\nresponse = chat.sample()\nprint(response.content)`,
  TypeScript: `import { xai } from "@ai-sdk/xai";\nimport { generateText } from "ai";\n\nconst { text } = await generateText({\n  model: xai("grok-4.7"),\n  prompt: "Explain quantum computing",\n});\nconsole.log(text);`,
  "TypeScript (OpenAI SDK)": `import OpenAI from "openai";\n\nconst client = new OpenAI({\n  apiKey: process.env.XAI_API_KEY,\n  baseURL: "https://api.x.ai/v1",\n});\n\nconst response = await client.chat.completions.create({\n  model: "grok-4.7",\n  messages: [{ role: "user", content: "Explain quantum computing" }],\n});\nconsole.log(response.choices[0].message.content);`,
  cURL: `curl https://api.x.ai/v1/chat/completions \\\n  -H "Authorization: Bearer $XAI_API_KEY" \\\n  -H "Content-Type: application/json" \\\n  -d '{"model":"grok-4.7","messages":[{"role":"user","content":"Explain quantum computing"}]}'`,
};

const plans = {
  Individual: [
    { name: "Free", price: "$0", period: "/ month", description: "Explore Grok with a generous set of everyday limits.", features: ["Web and X search", "Voice conversations", "Connectors", "SOC 2 controls"] },
    { name: "SuperGrok", price: "$30", period: "/ month", description: "More room for advanced models and creative work.", features: ["Grok 4.6 model", "Grok Bot access", "Higher usage limits", "Image and video generation", "Expert mode"] },
    { name: "SuperGrok Plus", price: "$100", period: "/ month", description: "Higher usage, priority access, and 1080p video creation.", features: ["Everything in SuperGrok", "1080p video", "Priority during peak use", "Early feature access", "Expanded usage across products"] },
  ],
  Team: [
    { name: "Business", price: "$30", period: "/ seat / month", description: "A shared workspace for teams building with Grok.", features: ["All Grok models", "Grok Build access", "Seat management", "Consolidated billing", "Role-based access", "Custom data retention"] },
    { name: "Enterprise", price: "Custom", period: "", description: "Advanced controls and support for large organizations.", features: ["Everything in Business", "Single sign-on and SCIM", "Custom access controls", "Dedicated onboarding", "Customer-managed keys", "Dedicated data plane"] },
  ],
  API: [
    { name: "API", price: "Usage-based", period: "", description: "Build with text, voice, vision, image generation, and video.", features: ["All Grok models", "Usage-based billing", "Tool calling and agents", "Live web and X search", "Files and retrieval", "Batch processing"] },
  ],
};

const questions = [
  ["How do I get an API key?", "Create a Console account, then generate a key from the API Keys page."],
  ["Can I use an existing SDK?", "Yes. Use the OpenAI-compatible endpoint and set the base URL to https://api.x.ai/v1."],
  ["How is API usage billed?", "API usage is billed by model and modality. Prepaid credits and enterprise invoicing are available."],
  ["Where are the full model details?", "The developer documentation lists model capabilities, limits, and current pricing."],
];

const milestones = [
  { date: "May 2024", title: "Rapid construction", detail: "Construction starts, gear arriving. Floor, piping, and structure stood up. Power plant online." },
  { date: "June 2024", title: "GPUs start arriving", detail: "First production racks arrive. Datahall 1 power and cooling ready. Two datahalls powered, 50% of GPUs onsite." },
  { date: "July 2024", title: "Bottlenecks and breakthroughs", detail: "Fiber connections holding us up. Power flux issue discovered and resolved. Megapacks stabilize the power plant." },
  { date: "August 2024", title: "25K GPUs delivered weekly", detail: "First 25K used for useful workloads. First job ran across all 4 datahalls." },
  { date: "September 2024", title: "Training begins", detail: "42K-GPU job with elastic training, running across 4 data halls." },
  { date: "January 2025", title: "Grok 3 trained", detail: "Training finished with 80K+ GPUs. 122 days from groundbreak to training." },
  { date: "February 2025", title: "Full scale", detail: "Doubled to 200K GPUs." },
];

const companyPrinciples = [
  ["Reasoning from first principles", "We challenge conventional thinking by breaking down problems to their fundamental truths, grounded in logic and evidence rather than consensus."],
  ["No goal is too ambitious", "We embrace the most challenging obstacles by always pushing the limits of what's possible. We are motivated by what has never been done before."],
  ["Move quickly and fix things", "Rapid development and iteration lets us innovate at breakneck speeds. We're not interested in speed for speed's sake — we're here to solve real problems fast."],
];

const companyStories = [
  ["Grok 4.7", "Our most capable reasoning model.", "https://docs.x.ai/developers/models/grok-4.7", "blue"],
  ["Colossus", "200K GPUs. Built in 122 days.", `${base}/colossus/`, "orange"],
  ["Voice API", "#1 on Big Bench Audio.", `${base}/voice/`, "teal"],
  ["Careers", "Join the team.", `${base}/careers/`, "violet"],
];

const productsByPage: Record<string, { eyebrow: string; title: string; description: string; cta: string; href: string; sections: Array<[string, string, string[]]> }> = {
  grok: {
    eyebrow: "Grok · web, iOS, and Android",
    title: "AI that helps everyone move forward.",
    description: "Chat, search, reason, and create in one assistant, with answers grounded in what is happening now.",
    cta: "Try Grok",
    href: "https://grok.com/?referrer=website",
    sections: [
      ["Chat", "A practical assistant for research, writing, and daily questions.", ["Step-by-step reasoning", "Images, video, and code in a conversation", "Natural voice exchanges"]],
      ["Multi-agent", "Parallel agents investigate difficult questions and bring their work together.", ["Parallel sub-problems", "Inspectable reasoning", "One cited response"]],
      ["Search", "Live web and X results keep answers current.", ["Citations to live sources", "Fresh posts and trends", "Follow-up exploration"]],
      ["Imagine", "Create images and video from prompts or reference material.", ["Text-to-image and video", "Iterative editing", "High-resolution output"]],
    ],
  },
  build: {
    eyebrow: "Grok Build · coding agent",
    title: "Bring Grok to your computer.",
    description: "A coding agent for complex work, with plans, skills, plugins, and parallel subagents in one workflow.",
    cta: "Read the docs",
    href: "https://docs.x.ai/build/overview",
    sections: [
      ["Skills", "Make recurring workflows available when a task calls for them.", ["Project instructions and plugins", "Auto-invocation or slash commands", "Capture a session as a reusable skill"]],
      ["Plan", "Shape a clear approach before changes begin.", ["Review the plan first", "Comment on individual steps", "Inspect every approved change"]],
      ["Plugins", "Share tools and capabilities across a team.", ["Bundle skills, agents, hooks, and MCP", "Install from a marketplace or Git", "Connect common developer tools"]],
      ["Subagents", "Let focused agents research, build, and review in parallel.", ["Independent context windows", "Parallel investigation", "Dedicated worktrees"]],
    ],
  },
  bot: {
    eyebrow: "Grok Bot · persistent AI teammates",
    title: "Meet your next AI teammate.",
    description: "Give a Bot a real task. It can use its own computer, work inside your tools, and return when it needs your input.",
    cta: "Get started",
    href: "https://grok.com/?product=grok-bot",
    sections: [
      ["Message a Bot", "Hand off work in a conversation and stay in the loop as it progresses.", ["Work from desktop or iOS", "Long-running task context", "Approval when it is needed"]],
      ["Work in parallel", "Assign different jobs to several Bots and let them collaborate.", ["Independent tasks", "Shared project context", "Always-on progress"]],
      ["Teach a workflow", "Show a Bot how a routine works once, then let it repeat the steps.", ["Follow along with a task", "Save the routine", "Run it again later"]],
      ["Choose a role", "Explore practical starting points for a team of agents.", ["Sales outreach", "Expense review", "Product and support operations"]],
    ],
  },
  imagine: {
    eyebrow: "Grok Imagine · API",
    title: "From prompt to polished visual.",
    description: "Generate and edit images or create video with one API across visual modalities.",
    cta: "Explore the playground",
    href: "https://console.x.ai/team/default/image?flow=explore",
    sections: [
      ["Video generation", "Turn prompts and reference images into moving scenes.", ["Text-to-video and image-to-video", "Clips up to 15 seconds", "Motion-aware output"]],
      ["Product imagery", "Create new scenes and angles from one reference photo.", ["Stage a product in a new setting", "Change perspective", "Generate multiple variations"]],
      ["Precision edits", "Change selected attributes while preserving the rest of an image.", ["Target color or material", "Iterate on details", "Switch between image and video"]],
      ["Creative restyle", "Explore distinct visual treatments from a common source.", ["Compare before and after", "Move across visual styles", "Keep the source in view"]],
    ],
  },
  voice: {
    eyebrow: "Grok Voice · agent builder beta",
    title: "Voice agents built for real outcomes.",
    description: "Build, tune, and deploy conversational voice agents with fast reasoning and clear controls.",
    cta: "Try it free",
    href: "https://console.x.ai/team/default/voice/agents",
    sections: [
      ["Natural conversation", "A voice experience with real timing and expressive delivery.", ["Responsive turn-taking", "25+ languages", "Browser-based setup"]],
      ["Trained for real calls", "Handle interruptions and resolve a request from start to finish.", ["Look up records", "Take actions during a call", "Transfer to a person"]],
      ["Connect your tools", "Bring existing systems into the conversation flow.", ["Google and Microsoft apps", "Calendar and task tools", "Custom MCP connections"]],
      ["Set guardrails", "Define what an agent can do and when it should hand off.", ["Custom instructions", "Protect sensitive data", "Keep a clear human path"]],
    ],
  },
};

const isHome = page === "home";
const isCompany = page === "company";
const isCareers = page === "careers";
const isNews = page === "news";
const isColossus = page === "colossus";
const isApi = page === "api";
const isPricing = page === "pricing";
const product = productsByPage[page];
const storyPage = page === "article";
const title = story?.title ?? "Grok 4.7";
const description = story?.summary ?? "Public SpaceXAI announcement.";
---

<!doctype html>
<html lang="en" data-theme={isColossus ? "light" : "dark"} data-page={page}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={`${description} Independent local UI prototype inspired by the public SpaceXAI website.`} />
    <meta name="theme-color" content={isColossus ? "#ffffff" : "#080808"} />
    <title>{isHome ? "SpaceXAI" : `${isCompany ? "Company" : isCareers ? "Careers" : isNews ? "News" : isColossus ? "Colossus" : isApi ? "API" : isPricing ? "Pricing" : storyPage ? title : product?.eyebrow.split(" · ")[0] ?? "SpaceXAI"} | SpaceXAI`} — Independent Prototype</title>
  </head>
  <body>
    <div class="xai-prototype" data-site data-page={page}>
      <header class="xai-header">
        <a class="xai-mark" href={localPath("/")} aria-label="SpaceXAI prototype home"><img src={localPath("/brand-mark.svg")} alt="" /></a>
        <nav class="desktop-nav" aria-label="Primary navigation">
          <button type="button" data-desktop-menu="products" aria-expanded="false">Products<span aria-hidden="true">⌄</span></button>
          <button type="button" data-desktop-menu="solutions" aria-expanded="false">Solutions<span aria-hidden="true">⌄</span></button>
          <button type="button" data-desktop-menu="developer" aria-expanded="false">Developer<span aria-hidden="true">⌄</span></button>
          <button type="button" data-desktop-menu="company" aria-expanded="false">Company<span aria-hidden="true">⌄</span></button>
          <a href={localPath("/pricing/")}>Pricing</a>
          <a href={localPath("/news/")}>News</a>
        </nav>
        <div class="desktop-actions">
          <a href="https://x.ai/contact-sales" target="_blank" rel="noreferrer" class="header-sales">Contact Sales</a>
          <a href="https://grok.com/?referrer=website" target="_blank" rel="noreferrer" class="header-trial">Try for free <span aria-hidden="true">⌄</span></a>
        </div>
        <button class="menu-toggle" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="site-menu" data-menu-toggle>
          <span></span><span></span>
        </button>
        <nav class="site-menu" id="site-menu" aria-label="Main navigation" hidden data-site-menu>
          <div class="menu-topline">
            <a class="xai-mark" href={localPath("/")} aria-label="SpaceXAI prototype home"><img src={localPath("/brand-mark.svg")} alt="" /></a>
            <button class="menu-close" type="button" aria-label="Close navigation" data-menu-close>×</button>
          </div>
          <div class="menu-columns">
            <div class="menu-tabs" role="tablist" aria-label="Navigation categories">
              {navGroups.map((group, index) => <button type="button" class:list={["menu-tab", { active: index === 0 }]} role="tab" aria-selected={index === 0 ? "true" : "false"} aria-controls={`menu-${group.id}`} data-menu-tab={group.id}>{group.label}<span>↗</span></button>)}
              <a class="menu-tab" href={`${base}/pricing/`}>Pricing<span>↗</span></a>
              <a class="menu-tab" href={`${base}/news/`}>News<span>↗</span></a>
            </div>
            {navGroups.map((group, index) => <div class="menu-links" id={`menu-${group.id}`} role="tabpanel" aria-label={group.label} hidden={index !== 0} data-menu-panel={group.id}>
              {group.links.map((link) => <a class="menu-link" href={link.href} target={link.href.startsWith("https://") ? "_blank" : undefined} rel={link.href.startsWith("https://") ? "noreferrer" : undefined}>
                <span class="menu-link-mark">{link.tone ? <i class={`product-mark-art ${link.tone}`}></i> : <i class="menu-link-symbol">↗</i>}</span>
                <span><strong>{link.name}</strong><small>{link.note}</small></span><span class="menu-link-arrow">↗</span>
              </a>)}
            </div>)}
            <div class="menu-cta"><a class="button button-light" href="https://grok.com/?referrer=website" target="_blank" rel="noreferrer">Try Grok <span>↗</span></a><a href="https://x.ai/contact" target="_blank" rel="noreferrer">Contact</a><span>·</span><a href="https://x.ai/legal" target="_blank" rel="noreferrer">Legal</a></div>
          </div>
        </nav>
      </header>

      <main>
        {isHome && <>
          <section class="home-hero page-width">
            <a class="announcement" href={`${base}/news/grok-4-7/`}>
              <span class="announcement-tag">New</span><span>Meet Grok 4.7</span><span class="announcement-note">Our new model</span><span class="announcement-arrow">↗</span>
            </a>
            <div class="hero-title-wrap"><h1>Frontier AI models<br class="desktop-break" /> for everything you <span class="hero-verb" data-hero-verb>build</span><span class="hero-period">.</span></h1></div>
            <div class="hero-rule" aria-hidden="true"><span></span><i></i></div>
            <p class="hero-copy">Reasoning, code, voice, images, and video. Trained on the world's largest supercluster.</p>
            <div class="hero-actions"><a class="button button-light" href={`${base}/api/`}>Get API Access <span>›</span></a><a class="button button-dark" href="https://docs.x.ai/" target="_blank" rel="noreferrer">View Documentation</a></div>
            <div class="hero-product-row" aria-label="Explore products">
              {products.map((item) => <a class="hero-product-card" href={item.href}>
                <div class={`product-art ${item.tone}`}>
                  {item.tone === "chat" && <div class="chat-demo"><span class="bubble-user">Why is the sky blue?</span><span class="bubble-answer">Shorter blue wavelengths scatter more off air molecules than longer red ones.</span></div>}
                  {item.tone === "build" && <div class="build-demo"><div class="demo-window-head"><i></i><i></i><i></i><span>projects / main</span></div><div class="demo-code"><b>›</b> Migrate auth from sessions to JWT.<small>▸ read_file src/middleware/auth.ts</small><small>▸ grep "session" src/</small><small class="demo-running">Thinking…</small></div></div>}
                  {item.tone === "imagine" && <div class="imagine-orb"><span></span><i></i></div>}
                  {item.tone === "voice" && <div class="voice-wave" aria-hidden="true">{Array.from({ length: 22 }, (_, i) => <i style={`--bar:${18 + (i * 19 % 68)}px`}></i>)}</div>}
                  {item.tone === "bot" && <div class="bot-face"><i></i><i></i></div>}
                </div>
                <span class="product-card-copy"><strong>{item.name}</strong><span>{item.note}</span></span><span class="product-card-arrow">Explore&nbsp; →</span>
              </a>)}
            </div>
          </section>

          <section class="section-block api-intro page-width" id="api">
            <div class="section-heading-row"><div><p class="eyebrow">For developers</p><h2>One API.<br />Every modality.</h2></div><p class="section-intro">Text, code, voice, images, and video through one unified API. Start building in seconds.</p></div>
            <div class="api-layout">
              <div class="api-stats"><div><strong>1M<span>+</span></strong><small>API calls per day</small></div><div><strong>&lt;200<span>ms</span></strong><small>Median latency</small></div><div><strong>5<span>+</span></strong><small>Model families</small></div><a class="text-link" href={`${base}/api/`}>Explore the API <span>↗</span></a></div>
              <div class="code-panel">
                <div class="code-panel-top"><div class="window-dots"><i></i><i></i><i></i></div><button type="button" class="copy-button" data-copy-code aria-label="Copy code">Copy&nbsp; ⧉</button></div>
                <pre><code data-code-sample>{apiCode.Python}</code></pre>
                <div class="code-tabs" role="tablist" aria-label="Code language">{Object.keys(apiCode).map((name, index) => <button type="button" role="tab" aria-selected={index === 0 ? "true" : "false"} class:list={["code-tab", { active: index === 0 }]} data-code-tab={name} data-code-content={apiCode[name as keyof typeof apiCode]}>{name}</button>)}</div>
              </div>
            </div>
          </section>

          <section class="numbers-section page-width">
            <p class="eyebrow">By the numbers</p><div class="numbers-grid"><div><strong><span data-count="300">300</span><small>M+</small></strong><p>queries processed daily</p></div><div><strong><span data-count="150">150</span><small>K</small></strong><p>GPUs in Colossus</p><a href={`${base}/colossus/`}>Explore Colossus ↗</a></div><div><strong><span data-count="90">90</span></strong><p>days to double the cluster</p><a href={`${base}/colossus/`}>How we built it ↗</a></div></div>
          </section>

          <section class="section-block page-width news-preview">
            <div class="section-heading-row"><div><p class="eyebrow">What we're building</p><h2>Latest news</h2></div><a class="text-link" href={`${base}/news/`}>All posts <span>↗</span></a></div>
            <div class="news-grid">{featuredStories.map((item) => <a class="news-card" href={`${base}/news/${item.slug}/`}>
              <div class={`news-cover tone-${item.tone}`}><span class="cover-label">{item.category}</span><span class="cover-glyph">{item.tone === "orange" ? "BOT" : item.tone === "pink" ? "✳" : item.tone === "teal" ? "◌" : "G"}</span></div>
              <div class="news-meta"><span>{item.category}</span><time>{item.date}</time></div><h3>{item.title}</h3><span class="card-arrow">Read more&nbsp; ↗</span>
            </a>)}</div>
          </section>

          <section class="section-block get-started-section page-width">
            <div class="section-heading-row"><div><p class="eyebrow">Start building</p><h2>Choose how to get started</h2></div><p class="section-intro">Bring Grok into your product or get a team plan with extra support.</p></div>
            <div class="start-grid"><article class="start-card"><p class="eyebrow">Build on your own</p><h3>Start with the API</h3><p>Launch a product with access to the model family and usage-based pricing.</p><ul><li>Access to Grok models</li><li>Usage-based pricing</li><li>Documentation and guides</li><li>Playground in Console</li></ul><a class="button button-light" href={`${base}/api/`}>Start building <span>↗</span></a></article><article class="start-card"><p class="eyebrow">For your team</p><h3>Get extra support</h3><p>Set up custom limits and a support path for your organization.</p><ul><li>Dedicated onboarding</li><li>Custom rate limits</li><li>Monthly invoicing</li><li>SSO and audit logging</li></ul><a class="button button-dark" href="https://x.ai/contact-sales" target="_blank" rel="noreferrer">Contact sales <span>↗</span></a></article></div>
          </section>
        </>}

        {isCompany && <>
          <section class="company-hero page-width">
            <div class="company-intro"><p class="eyebrow">Our mission</p><h1>Accelerate human<br class="desktop-break" /> scientific discovery.</h1><p class="inner-lede">We build AI to understand the universe. Frontier reasoning, real-time voice, and generative media — designed to extend what humanity can know and do.</p><div class="hero-actions"><a class="button button-light" href={`${base}/careers/`}>Join us</a><a class="button button-dark" href="https://x.ai/contact" target="_blank" rel="noreferrer">Contact</a></div></div>
