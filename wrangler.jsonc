{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "atlasez-web-1",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-26",
  "vars": {
    "DISCORD_REPORT_SYNC_URL": "https://atlasez-admin.ukyoukay0.workers.dev/internal/article-report-discord"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "REPORTS",
      "database_name": "atlasez-reports",
      "database_id": "747c7d1d-301a-4aea-ad09-fc37d442d43c",
    },
  ],
}
