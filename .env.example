# サイトの公開URL（プロトコル込み・パスなし）
# GitHub Pages (project site): https://<ユーザー名>.github.io
# 独自ドメイン取得後:          https://atlasez.org
SITE_URL=https://atlasez.github.io

# ベースパス
# GitHub Pages (project site): /<リポジトリ名>
# 独自ドメイン・ユーザーサイト: /
BASE_PATH=/atlasez-web

# 運営参加応募フォームの配信元（管理Workerのオリジン）
# 公式サイトの「応募する」ボタンの飛び先。応募の受け口 /api/apply を持つのは
# 管理Workerだけなので、未設定だと送信が404になる。
# ローカルで npm run dev:admin を併用するとき: http://localhost:8787
ADMIN_ORIGIN=https://atlasez-admin.example.workers.dev

# 1 にすると全ページ noindex ＋ robots.txt が Disallow になる。
# 本番では設定しない。GitHub Pages のミラー配信でのみ使う。
# NOINDEX=1

# ビルド出力先（省略時 ./dist）
# OUT_DIR=./dist

# 秘密情報はビルドでは使わない。Worker側の Secret として Cloudflare に登録する。
#   REPORT_IP_HASH_SALT       学習サイトWorker: 記事報告の送信回数ハッシュのソルト（必須）
#   RESEND_API_KEY            管理Worker: 応募通知メール
#   GOOGLE_OAUTH_CLIENT_SECRET / DISCORD_BOT_TOKEN / TURNSTILE_SECRET_KEY  管理Worker
# 実値は .env へ書かず Cloudflare にだけ保存する（.env はコミットしない）
