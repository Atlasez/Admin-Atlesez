# サイトの公開URL（プロトコル込み・パスなし）
# GitHub Pages (project site): https://<ユーザー名>.github.io
# 独自ドメイン取得後:          https://atlasez.org
SITE_URL=https://atlasez.github.io

# ベースパス
# GitHub Pages (project site): /<リポジトリ名>
# 独自ドメイン・ユーザーサイト: /
BASE_PATH=/atlasez-web

# ビルド出力先（省略時 ./dist）
# OUT_DIR=./dist

# ローカルの秘密情報は `.dev.vars` またはWrangler Secretへ保存し、実値はコミットしない。
# リマインダーメールを有効にする場合は、送信元を必ず自ドメインの検証済みアドレスにする。
RESEND_API_KEY=re_（ローカルのみ）
EMAIL_FROM=Atlasez運営 <noreply@example.com>
# 応募者のDiscord OAuth2連携。Client ID・対象サーバーは公開設定、その他の実値はWrangler Secretに保存し、コミットしない。
# Discord Developer PortalのRedirect URI:
# https://admin.atlasez.org/auth/discord/callback
DISCORD_OAUTH_CLIENT_ID=1537142952210464868
DISCORD_GUILD_ID=1359062450028282017
DISCORD_GUILD_NAME=Atlasez学習サイト運営
DISCORD_OAUTH_CLIENT_SECRET=（ローカルのみ）
# 32バイトのランダム値をbase64または64桁hexで指定する。
DISCORD_OAUTH_TOKEN_ENCRYPTION_KEY=（ローカルのみ）
