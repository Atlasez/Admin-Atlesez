{
  "$schema": "node_modules/wrangler/config-schema.json",
  "account_id": "812021e62fa20465950b61be55dfe064",
  "name": "atlasez-admin",
  "main": "src/admin-worker.ts",
  "compatibility_date": "2026-07-26",
  "preview_urls": true,
  "workers_dev": true,
  "routes": [
    {
      "pattern": "admin.atlasez.org",
      "custom_domain": true,
      "zone_name": "atlasez.org",
    },
  ],
  "vars": {
    "ADMIN_AUTH_MODE": "google-oauth",
    "ADMIN_PUBLIC_ORIGIN": "https://admin.atlasez.org",
    "PUBLIC_ANALYTICS_ORIGIN": "https://atlasez-web-1.ukyoukay0.workers.dev",
    "EMAIL_FROM": "Atlasez運営 <apply@atlasez.org>",
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/*"],
  },
  "d1_databases": [
    {
      "binding": "REPORTS",
      "database_name": "atlasez-reports",
      "database_id": "d5112a62-7ed6-49c8-b6a2-18ee2dbab678",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "EDITORIAL_COLLABORATION",
        "class_name": "EditorialCollaborationRoom",
        "script_name": "atlasez-editorial-collaboration",
      },
    ],
  },
  "triggers": {
    "crons": ["0 * * * *", "*/5 * * * *"],
  },
}
